شروع اللہ سی نام ما یأ سے گھن مہربان، چیر رحمت والا تُھو۔
تمام صفت صرف اللہ سی کأ تھی، کآم یأ بُٹ جہانا سی ساتو والا تُھو۔
گھن مہربان، چیر رحمت والا تُھو
بَدلا سی دی سی مالک تُھو
مھو خاص چھی عبادت کودی، آں خاص تھأ ما مدد نِمادی
تُو مھوئے ݜِݜ پان پشا
تھأ خلگا سی پان کِیزیت تأ انعام کیدُو، نأ تھأ خلگا (سی پان) کِیزیت چھی قہر نازل ہودُو، نأئی گمراہ خلک
الف، لام، میم (مے لفظ سی مراد ما اللہ غورہ جنَدو۔)
أ مھال کتاب تُھو اِس می کی شک نی چھی، ہدایت چھی پرہیزگارا سی کأ۔
(پرہیزگار خلک) سے تھی یأ غیب زید ایمان اَندی، آں نماز قائم کودی، آں کا یأ مھوئے ہأئے دِیدتُو دا تِس ما خرچ کودی،
آں (سے خلک) کآم یأ ایمان اَندی تے وحی زید یأ تھیزید نازل کوا گیژی، آں کامیک یأ تھأ ما مُوش نازل کوا گیژی، آں خاص آخرت زید ہے یقین کودی۔
أ (صفات والا) خلک تنو رَب سی دِیشا ہدایت زید تھی، آں خاص ہے خلک کامیاب تھی۔
بےشکہ کآم خلگے یأ کفر کی، ہِین حق می أ بات ایشان سی چھی یرأ تُو ہأ بھیادُو یا نہ بھیادُو، ہے ایمان نہ اَندی۔
اللہ ہین حی آ زید آں ہین کَن آ زید مہر ݜژادتُو، آں ہین أݜِی آ زید پردہ تُھو۔ آں ہین کأ گھن عذاب تُھو۔
آں خلگا می یام سے تھی بَندی (جِب تے)، "مھوئے ایمان اَنودُو اللہ زید آں آخرت سی دِی زید"، حال أ چھی سے ایمان (حی دے) اَنو والا نی تھی۔
سے دوکہ دیدی (تنو خیال می) اللہ یے آں ایمان والائے، آں (حقیقت می) سے دوکہ نہ دیدی خو تنو اَمن گے، اَسے ہے نہ جنَدی۔
ہین حِی آ می بیماری چھی، دَ اللہ ہین بیماری لا چیری کی، آں ہین کأ سَخ دڑدا سی عذاب تُھو مِسی کأ ہے لوو سوؤدُود۔
آں کے ہأئے بَنا گاو یرأ "دھیرین می اُورانئی نہ کوا"، دَ ہے بَندی "مھو دا سوؤ والا تھی"۔
خبردار! بےشکہ ہے خلک اُوران کار تھی، اَسے ہے نہ جنَدی۔
آں کے یأ ہأئے بَنا گاو یرأ "ایمان آنا کھأکأ دأل خلگے ایمان اَنودُو (یعنی صحابہؓ)" دَ ہے بَندی: "کئی مھو ایمان أنی کھأکأ یأ قَمقَلے ایمان اَنودُو؟" غورتے بُھویا! بےشکہ اَںئی ہے خلک قَمقَل تھی اَسے ہے نہ جنَدی۔
آں کے یأ ہے میلاؤ ہُوئیو ایمان والا سید بَندی: "مھوئے ایمان انودُو"، آں کے ہے تنو شیطان آ سید اَمن گے ہُوئیو بَندی: "مھو دا بےشکہ تھو سید تِھی، بےشکہ مھو دا صرف ٹوقے کوؤ والا تھی"۔
اللہ ہأزید ٹوقے (سی معاملہ) کودُو آں ہأئے مہلت دیدُو یرأ ہے تنو یاغی ہوؤ می اَنٹمأ ترپَن۔
أ سے خلک تھی یأ ہدایت سی بدل می گمراہی مُلأدچی، دَ ہین سودا کی گٹہ نی کی، آں نأئی ہیئے حق سی پان پأد۔
ہین مثال تے ماݜ سی تُھو کی یأ اے آنگا جالُو، دَ کے یأ اِی (آنگا) تِسی چاپ چاپیرہ لوش کی، دَ اللہ ہین (أݜی آ سی) لوش گھراد، آں ہأ أنچیگ آ می چھوئی یرأ ہے کی نہ پَشدی۔
ہے بو تھی چار تھی اَن تھی، دَ (مھیرے حق سی دِشکے) ہے نہ نُوڑدی۔
یا (ہأ منافق آ سی) مثال تے ہاگا سی تُھو یأ مُوژَدُو آسمان سی دیشا، تِمی أنچیک تھی آں گڑَزأ و پڑیق پَڑق تُھو۔ ہے أنگیا سی پِھٹ تنو کنا می ڇوگدی تَندر آ سی وجہ دے مئیک سی بِھیدتے۔ اَسے اللہ کأفر ہر ڈھأرا گیر کیدی۔
نھیو تُھو یرأ أ بجلی ہین أݜِی آ سی لوش گھرے، کے یأ ہے ہین کأ لوش کوژی دَ ہے تِسمی روان ہودی، آں کے یأ ہأزید أنچیک کِیو ہے ایڑی ہودی، آں کو اللہ نیمادوشُوو خامخا ہین کَن و أݜی آ سی طاقت گھرانیندے، بےشکہ اللہ ہر شیئی زید قادر تُھو۔
اے خلک ہانا! تنو تے رَب سی عبادت کوا، یأ تی تھو آں تھوما مُوشیک خلک پیدا کیدی، ہو بھادو تھو پرہیزگار سَوا بژا۔
(رَب سے ذات تُھو) کی یأ تُھن کأ دھیرین تلئی آں آسمان چَت سَواد، آں تُھن کأ آسمان سی دیشا اُو مُوژاد، بھی اِسی ذریعہ دے تُھن رزق سی کأ میوہ نِگھالئ۔ دَ تھلا اللہ سید ییس شریک نہ سَوا، مے حال می یرأ تھو جنَدی۔
آں کو تھو تے کتاب سی بارہ می کی شک می تِھیو کامیک یأ مھوئے تنو بَندہ زید نازل کیدو، دَ اِسی شانے اے سورت تھو ہُم سوأدے آنا، آں اللہ ما سیوا تنو بُٹ مددگار ہاگا، کو تھو سأزبَن تِھیو۔
بھی کو تھوئے مے کام نی کِیو، آں تھو یئید ہُم نو کوبھادی، دَ تے آنگا ما بھیا کامیک سی شَلا انسان و باٹ تھی، آں سے کأفر آ سی کأ تیا کوا گودُو۔
آں ایماندا و نیک عمل کوؤ والائے زیرے دا یرأ بےشکہ ہین کأ مھال باغ تیا تھی کہ تھین ٹین نھید روان تھی۔ کے یأ باغ آ ما ہأئے کھوؤ سی کأ کآں میوہ دیا گاو تھیئے بَننین: "أ سے میوہ تھی ہے مُوش ہُم مھوئے دِیا گئیشی"۔ آں ہأئے ایشان سی رزق دِیا بژنین آں ہین کأ تھید پاکیزہ ڇھی ہونین، آں ہیئے تھید مُدام سی کأ دھرنین۔
بے شکہ اللہ مے بأت می لاش نہ کودُو یرأ کآں مثال بیان کوئے پِھت سی یا پِھت ما ہُم معمولی شیئی سی، دَ کآم خلک یأ ایماندا تھی سے جنَدی یرأ ہے (مثال) حق تھی ہین رَب سی دیشا، آں کآم خلک یأ کأفر تھی سے بَندی یرأ "مے معمولی مثال سی بیان ما اللہ سی کا مطلب چھی؟"، اللہ چیرگن خلک ایدے گمراہ کودُو آں چَیر خلگائے ایدے سیدا پان پشادُو، آں (اے مثال) دے گمراہ نہ کودُو اَسے گناہگا (خلک)،
ہے سے خلک تھی یأ اللہ سید پوخ لوظ کیدے بھی تیس پھرادی، آں ہے تے تعلق چھینہ دی کامیک سی یأ اللہ سَوؤ سی حُکم دِیدتُو، آں ہے دھیرین می فساد کودی، اَںئی ہے خلک خسارہ والا تھی۔
تھو کھأکأ اللہ سید کفر کودی حال أ چھی تھو مئیل اَشیئ بھی تی تھو جینی کی، بھی تی تھوئے مئیک دینین، بھی خاص تِسی دِشکے تھوئے واپس کوا بژنین۔
اللہ سے ذات تُھو یأ تی دھیرین سی بُٹ شیئی تُھن کأ پیدا کی، بھی آسمان سی دِشکے توجہ کی، بھی تھأ سات آسمان برابر کی، آں سے ہر شیئی ما غورا جَنیل تُھو۔
کے یأ چھی ربے ملیکائے بنو یرأ "بےشکہ آ دھیرین می تنو اے نائب سَوادُو"، دَ ملیکائے بنو: "تھو اِس می مھال خلک پیدا کودی یأ تھیئے دھیرین می اُورانئی کونین آں ڙات ڈالنین، حال أ چھی مھو چھی ثنا صفت سَمانے آں پاکی بیان کودی؟"، اللہ بنو: "بےشکہ آ تِس ما جنَدو کا یأ تھو نہ جنَدی"۔
آں تی (اللہ) آدمؑ گے بُٹ نام ڇھیڙأد۔ بھی تیس ملیکائے مُٹھائے کی، بھی بنو: "تھو مھیئے مھأ بُٹ شیئی آ سی نام بَنا، کو تھو سأزبَن تِھیو"۔
ملیکائے بنو: "(اے اللہ) مھو کیش کی علم نہ تُھو اَسے کا یأ تھوئے مھوئے ڇھیڙادتُو۔ بےشکہ تھو علم آں حکمت والا تھی"۔
(اللہ) بنو: "اے آدمؑ! ہأئے مھأ شیئی آ سی نام پشَا"، دَ کے یأ تی ہأئے مھأ نام پشأت تہ اللہ بنو: "کئی مأ تھوئے نہ بنُوشُو یرأ بےشکہ آ آسمان و دھیرین آ سی بِرید بأدے ما جنَدو؟ آں آ تھأ بأدے ما جنَدوُ کا یأ تھو ڈاگا کودی، آں کا یأ تھو بُرادی"
آں کے یأ مھوئے ملیکائے بنو "آدمؑ گے سجدہ کوا" دَ ابلیس ما علاوہ بوڑے سجدہ کی، تی انکار کی آں تکبر کی آں سے کأفر آ ما ہُو۔
آں مھوئے بنو: "اے آدمؑ! تُو و چھی جَوئی جنت می دَھرا، آں تھو دُوئیمو ایزما آرام دے کھا کھیدا تُھن مرضی چِھیو، صرف مے تھام سی کأشکے نہ بژا (نأؤ) دَ تَھلا تھوئے ظألما ما ہونین"۔
دَ بھی شیطان تھأ دُوئیمو تھیدا پَݜلأد، بھی کامے آرام می سے اَشیئ دا تھیدا تھأ نیگھالئی، آں مھوئے بنو: "تھو جنت ما وا، تھوئے ایکدِی آ سی دشمن ہونین، آں تُھن کأ دھیرین می اے وخہ پورے دھرُو آں فائدہ سی گھینو تُھو"۔
بھی آدمؑے تنو پروردگار ما (توبہ سی) دھأک بأت چھیڙئی، (بھی توبہ کی) دَ اللہ تِسی توبہ قبول کی، بےشکہ صرف سے چَیر معاف کوؤ والا گھن مہربان تُھو۔
مھوئے بنو "تھو بُٹ اے جنت ما وا، بھی کو مھی دیشا تھوئے کی ہدایت اوَئیو، دَ کی مھی ہدایت سی تابعداری کِیو تھأزید کی بِھید نہ ہونین نأئی تھیے غمجن ہونین۔
آں کآم خلگے کُفر کی آں مُھن آیات لوو گھنڈئی سے خلک آنگا والا تھی، ہیئے تِسمی مُدام ہونین"۔
اے اسرائیل (یعقوبؐ) سی لَؤ ہانا! مھی تھأ نعمت یاد کوا کامیک یأ مأ تھوئے دِیدتی، آں تھو مھی لوظ پورا کوا، مأ تُھن لوظ پورا کونین، آں صرف مھأما بھیا۔
آں ایمان آنا تے کتاب زید یأ مأ نازل کِیدوُ، ہے سأزبَن بَندوُ تھأ کتابائے یأ تھوکیش تھی، آں اِسی اول انکأری نہ ہوا، آں مھی آیات آ سی بدَل می اَشوڑ قیمت نہ گھینا، آں تھو صرف مھأ ما بھیا۔
آں تھو حق ناحق سید گاڑ نہ کوا، آں نأئی حق بأت بُرا (مے حال می یرأ) تھو جنَدی۔
نِماز قائم کوا آں ذکواۃ دا، آں رکوع کوؤ والا سید رکوع کوا۔
کئی تھو خلگائے غورا سی حُکم دیدی آں تھو اَمن اَموݜا تھلَدی حال أ چھی یرأ تھو کتاب (قرآن) سی تلاوت ہُم کودی؟ کئی تھو (ہیدیک ہُم) نہ جنَدی؟
آں تھو مدد گِھینا صوو ما آں نماز ما، آں بےشکہ ہے بُوکھو تُھو اَسے عاجزی کوؤ والا زید (بُوکھو نُو تُھو)۔
ہے سے خلک تھی کامیک یأ یقین کودی یرأ ہے تنو رَب سید ملاقات کوؤ والا تھی آں بےشکہ ہے تِسی دِشکے نُوڑو والا تھی۔
اے اسرائیل (یعقوبؑ) سی اَولاد! یاد کوا مھی تھأ نعمت کآم یأ مأ تھوزید کیدا، آں کامیک یأ مأ گھنیئی دیدیشی دا بُٹ جہانا زید۔
آں بِھیا تھو تے دِی ما کے یأ اے ماݜ دوئی ماݜ سی کم می نہ ینین کی شیئی می، آں نأئی قبول کوا بژنین ایزما شفاعت، آں نأئی گِھنا بژنین تیزما معاوضہ، آں نأ تھین مدد کوا بژنین۔
آں کے یأ مھوئے تھو بچ کی فرعون سی قوم ما یأ سے تھوئے سخ عذاب دیوؤدُود، ذبح کوؤدُود تُھن جدَک آں چھوؤدُود تُھن سیرأن، آں می می گھین اَزمیخ اَشِئی تُھن رَب سی دیشا۔
آں کے پدا کی دریاب مھوئے تُھن کأ، بھی بچ کی تھو آں غرک کی مھوئے فرعون سی قوم، آں تھو تھأ څاردُود۔
آں (یاد کو) کے یأ مھوئے وعدہ گِھن موسٰیؑ ما دوبیش ڙأدا سی۔ آں تھوئے باس تنو رَب سواد، آں تھو ظألم اَشیئ۔
آں بھی معاف کی مھوئے تھو میزما بعد یرأ تھو شکر نِگھلا۔
آں کے یأ مھوئے کتاب دید موسٰیؑ ئے آں فیصلہ والا قانون یرأ تھو بھی پان پا۔
آں کے موسٰیؑ بنو تنو قوم گے: "اے مھی قومأ! تھوئے ظلم کیدو اَمن زید باس تنو معبود گیݜتے۔ بس توبہ نِگھلا تنو رَب سی دربار می، بھی قتل کوا ایکدی (کآم یأ قصوروار تھی)، بھی أ غورا تُھو تُھن کأ تُھن رَب سی دِشا۔ بھی تُھن توبہ قبول کی، بےشکہ اللہ توبہ قبول کوؤ والا، چَیر زیات رحم کوؤ والا تُھو۔
آں بھی کے یأ تھوئے بنو: "اے موسٰیؑ! بالکل یقین نہ کودی مھو چھی، کھیدیخانہ پورے نہ ڈیڈ مھوئے اللہ مُخامخ"، بھی تندر تھو گأد آں تھو څارودُود۔
بھی تھو جینی کی تُھن مئیک ما بعد یرأ تھو شکر نیگھالا۔
آں چِیژول کی مھوئے تھوزید لڑے آ سی، آں مُوژاد مھوئے تھوزید من آں سلوا، (آں بنو) "کھا پاک شیئی آ ما کامیک یأ مھوئے تھوئے دیدتا"، آں ظلم نی کیشو تھیئے مھو زید، اَسے تھیئے اَمن زید ظلم کی۔
آں کے یأ مھوئے بنو: "لھنگا مے گام گے، کھا میزما کھیدا تھو نیمادِیو، آں لھنگا درے دے سجدہ کوئین، آں بَنا: 'مُھن توبہ'۔ مھو تھو معاف کیئی تُھن خطا آ زید، آں زیات بدلہ دینین نیگی سی کوؤ والائے"۔
بھی بدل کی تھیئے ظألیمے کلیمہ تِسی پوت می کامیک یأ تھأئے بَنا گوشُو، بھی نازل کی تھأ ظألیما زید عذاب آسمان ما تھین نافرمانی سی وجہ دے۔
آں کے یأ اُو نیماد موسٰیؑ تنو قوم سی کأ، مھوئے بنو: "داک دے باٹ سی تنو ہُمسا دے"، بھی روان ہوئی تیزما دواش اوسو، بھی پأنُو ہرے قوم تنو گُوتُھر سی پوت، "کھا پُوا اللہ سی رزق ما آں نہ گئیا دھیرین زید فساد کوؤ والا"۔
آں کے تھوئے بنو: "اے موسٰیؑ! مھو صوو نو کوبھادی اے ٹِگون زید۔ دعا کو مُھن کأ تنو رَب ما، یرأ پیدا کوئے مُھن کأ کامے شیئی یأ دھیرین نِگھالَژی، شاشلوک آں تُرڑی آں گھومو آں مسور آں پلانڇو۔ موسٰیؑ بنو: "کئی تھو گھیندی کا یأ معمولی تُھو، تِسی بدل می کامیک یأ غورا تُھو؟ دَ بَژا اے خار کے بھی ہونین تُھن کأ کامیک یأ تھو نیمادی"۔ آں تَھلا گأ تھأزید ذلت آں متأزی آں سے آختہ ہوئی غضب می اللہ سی دیشا۔ مے وجہ دے کہ سے انکار کوؤدُود اللہ سی آیادا ما، آں قتل کوؤدُود پیغمبر برناحقہ۔ ہے مے وجہ دے نافرمانی کوؤدُود آں حد ما بھار کے نُخودُود۔
بےشکہ کآم خلگے ایمان اَنو آں کآم خلک یہودی تھی آں عیسائی آں آنگا سی عبادت کوؤ والا، (ہیئے ما) کی ہُم ایمان اَنو اللہ سی ذات زید، آں آخرت سی دی زید، آں نیک عمل کی، بھی ہین کأ ہین رَب سی دیشا نأ کی بِھید ہونین تھأزید آں نأ تھیئے غمجن ہونین۔
آں (یاد کوا) کے یأ مھوئے پوخ لوظ گھین تھوما، آں اُوچات کی مھوئے طور سی کھان تُھن ڙید، (میس بیندے یرأ) "گݜا جُختہ کامے ہدایت یأ مھوئے تھوئے دِیدچی دا، آں بھی یاد کوا کا یأ اِسمی تُھو دا، مِسی کأ یرأ تھو دیندار پرہیزگار سَوا بَژا"۔
بھی مِسما بعد تھوئے (لوظ پھیرأدے) مُو نَراد۔ دَ کو نُو ہُوشوو تھوزید فضل اللہ سی آں تِسی رحمت، دَ ہونیندے تھوئے نقصان پوؤ والا آ ما۔
آں بےشکہ جَنیل اَشئ تھو تھأ خلگا سی بارہ می، تھو می کی زیاتئی کیشی لؤ آنگا سی دی سی، بھی بنو مھوئے تھأئے یرأ "ہوا تھو شادو ذلیل!"۔
دَ سوأد مے قصہ مھوئے تھأ خلگا سی کأ عبرت، کآم یأ موجود اَشئی دا آں کآم یأ بعد می یِیوو والا اَشِئی دا، آں أ خونہ تُھو پرہیزگار دیندار آ سی کأ۔
آں (یاد کوا) کے یأ موسیٰؑ تنو قوم گے بنو: "بےشکہ حُکم دیدُو تھوئے اللہ یرأ حلال کوا اے گا"، تھیئے بنو: "کئی تُو پِشاڑے کودُو مھو سید؟" بنو موسٰیؑ: "آ پناہ نیمادو اللہ ما یرأ ہیئی آ جاہل خلگا ما"۔
(تھیئے خلگے) بنو: "دعا کو مُھن کأ تنو رَب ما یرأ بیان کوئے کھال چھی (سے گا)؟"، بنو (موسٰیؑ): "(اللہ) بَندو سے اے گا چھی، نأ ڈھأک چھی آں نأ زوان چھی، درمیانہ چھی، دَ بھی کوا تیز کسی یأ تھوئے حُکم ہودُو"۔
(تھیئے خلگے) بنو: "دعا کو مُھن کأ تنو رَب ما یرأ بیان کوئے مھوئےکھال تُھو تِسی ڙانگ"، (موسٰیؑ) بنو: "بےشکہ اللہ بَندو سے اے گا چھی، غورا چونو تُھو تِسی ڙانگ، خوشحال کودُو څارو والا"۔
تھیئے بنو: "دعا کو تنو رَب ما مُھن کأ یرأ بیان کوئے مھوئے کا قسم سی چھی سے، گیئے شک وا تھلیئیدی مھو، آں بےشکہ کو اللہ نیمادو مھوئے پان پانین"۔
بنو (موسٰیؑ): "بےشکہ اللہ بَندو، سے اے گا چھی، ہلو والا نی چھی یرأ دھیرین ہلے، آں نأ فصل گے اُو دو، بالکل سالم چھی، کی داغ نُو تُھو تِسمی"۔ (بنی اسرائیل) بنو: "مھیرے تأ صحیح بات بینی"، تھیئے تیس ذبح کی، آں معلوم نہ ہوؤدود سے مے کام کوندے دا۔
(تے وَخ یاد کوا) آں کے تھوئے موؤ اے ماݜ، بھی تھوئے ایکدی سید لات کی تِسی بارہ می، آں اللہ یے اَخکارہ کوؤ اَشو کا یأ تھو بُورؤدود تا۔
بھی مھوئے بنو: "داک دا مِسی اے حصہ دے"، مھاموڑ جینی کودُو اللہ مَڑئی، آں پشادُو تھوئے تنو نخ یرأ تھو جَنا۔
بھی سخ ہوئی تُھن حی مِسما بعد، بھی سے باٹ سی شانے تھی یا اِسما ہُم سخ۔ آں بےشکہ بعض باٹ سے ہُم تھی یأ نُوخَدی تھیئے ما یَب، آں بےشکہ بعض تھأمی سے ہُم تھی یرأ پَھلَدی بھی نُخَدُو تھأما اُو، آں بےشکہ بعض تھأمی سے تھی اُلڑدی اللہ سی بِھید تے، آں نُو تُھو اللہ غافلہ کا یأ تھو کودی۔
کئی تھو (مھیرے ہُم ہیئے خلگے ما) طم کودی یرأ ایمان اَننین تُھن بأدیدے، (حال أ چھی) ہأمی اے ڈلہ بُھوژودُود اللہ سی کلام (تورات) ، بھی بدل کوؤدُود تیس تِسی جَنُو ما بعد، آں سے جَنودُود؟
آں کے (یأ ہے خلک) تھأ خلگا سید ایپوت ہوؤدُود کی یأ ایمان اَنوشُو دَ بَنودُود: "مھوئے ہُم ایمان آنودُو"، آں کے یأ جُدا ہؤدُود ایک دوئی سید دَ بنودود: "کئی تھو ہأئے (مسلمانائے) تھأ بأت بندی کامیک یأ اللہ تھوزید کولاؤ کیدی، مِسی کأ ہے تُھن پروردگار سی مُوش تُھن خلاف دلیل سی طور تے پیش کون؟" کئی تھو عقل ما کام نی گھیندی؟
«اَیا ہے نہ جَندی کے بےشکہ اللہ غورہ جَنَدُو کامیک یأ ہے بُرادی دا آں کامیک یأ ہے اَخکارا کودی دا۔
آں زینی خلک تھأمی أمی تھی سے نہ جنَدی کتاب ما، تش اَرمان گھیندے بھیٹ تی، آں سے صرف گُمان کودی۔
دَ تباہی چھی تھأ خلگا سی کأ کآم یأ لیگدی کتاب تنو ہات تے، بھی بَندی: "ہے اللہ سی دِشا تُھو"، مِسی کأ یرأ گِھینن تیما قیمت اَشوڑ دھأک، دَ تباہی چھی ہأسی کأ لیگو سی وجہ دے، آں تباہی چھی ہین کأ کامیک یأ ہے (پیس) گھڑودُود تا۔
آں ہے بَندی: "یئد نہ اَوودُو مھوئے آنگا اَسے دھأگ لیکھیل دی آ سی کأ"، بَن (ہأئے): "کئی تھوئے اللہ ما لوظ گھین تُو یأ بھی یئد نوکودُو اللہ تنو وعدہ سی خلاف ورزی۔ یا تھو بَندی اللہ سی بارا می (تھأ بأت) کامیک یأ تھو نہ جَنَدی دا؟"
کئی نأ! کامے ماݜ گناہ کی آں بھی تِسی گناہ تیس گیر کی، اَںئی ہے خلک تھی دیزوخی، تھیئے تِسمی ہمیشہ ہونین۔
آں سے خلک کی ایمان اَنودو آں نیک عمل کودی، سے خلک جنتی تھی، تھیئے تِسی می ہمیشہ ہونین۔
دَ (یاد کوا تے وَخ) کے یأ مھوئے پوخ لوظ گِھن بَنی اسرائیل ما: (مِسی کأ یرأ) "عبادت یسی نو کونین اللہ ما علاوہ، آں یئی و بوپ سید غورا سلوک کونین، آں تنو آ سید آں یتیم آں مِسکین و غریب آ سید (ہُم غورا سلوک کونین)، آں خلگائے غورہ بأت بَننین، آں نماز گُوزانین آں ذکواۃ دینین"۔ بھی تھوئے مُو نراد، اَسے دھأک تھوئے ما علاوہ، آں تھی تھو مُو نَرؤ والا۔
آں (یاد کوا) کے یأ مھوئے پوخ لوظ گِھن تھوئے ما، (میس بیندے یرأ) "نہ ڈالنین ڙات ایکدوئی سی آں نی نِگھلنین ایکدی تنو شِیرے ما"، بھی اقرار کی تھوئے آں اَشیئی تھو گواہ۔
بھی تھو سے خلک اَشیئی یأ ایکدی موؤدُود، آں اے ڈلہ تھوما تھین شِیرے ما نِگھلُودُود، تھو تھین خلاف گناہ آں زیأتیئی می (تھین دشمن آ سی) مدد کوؤدُود۔ آں کے یأ سے تھوئے قیدی سوا بیش تے ییؤدُود تا تھو فدیہ دیؤدُود (تھین آذاد کوؤ سی کأ)، حال أ چھی یرأ تھوزید ہین نِگھالو سرا حرام کوا گوشُو۔ اَیا تھو منَدی بعض کتاب آں انکار کودی بعض کتاب ما؟ کا سزا چھی تیسی یأ سے مھال کام تھوما کوئے سیوائے مِیما یرأ دُونیئی سی جیدون می شرمندگی ہوئے؛ آں قیامت سی دِیئے واپس کوا بژنین سخ عذاب کے۔ آں نُو تُھو اللہ ناخبرہ کا یأ تھو کودی دا.
ہے سے خلک تھی کی یأ دونیئی سی جیدون گِھین آخرت سی مقابلہ می، کم کوا نہ بژنین ہیئے ما عذاب، آں نأ ہین مدد کوا بژنین۔
آں یقیناً مھوئے موسٰیؑ ئے کتاب دید، آں مھوئے تیس پیش پرلہ پَسی پیغمبر پیئی۔ آں مھوئے مریمؑ سی پو عیسٰیؑ ئے اَخکارا نخ دید، آں مدد کی مھوئے اِسی (جبرائیلؑ سی زریعہ دے) روح پاک تے۔ دَ کئی تھلا کے یأ وؤدُود تھوئے یام رسول تے شیئی سَمانے یأ نہ خوشؤدُود تُھن نفس، دَ اَمن گھن گھنو تھوئے؟ بھی اے ڈلہ تھوئے لوال گھینی آں اے ڈلہ مَئی تھوئے۔
آں (ہے خلک) بَندی: "مُھن حی پردہ می تھی"، نأ! بلکہ لعنت کیژی اللہ ہأزید ہین کفر سی وجہ دے، دَ اَشوڑ خلک ایمان انَدی۔
آں کے یأ اللہ سی دیشا ہأئے کتاب (قرآن) آپ، یأ تھأکیش موجود (آسمانی کتاب) سی تصدیق کوؤ والا تُھو، آں ہے اِیما مُوش کأفرا زید برئی سی دعا نِموؤدُود، بھی کے یأ آپ ہأئے کا یأ ہے پأندُود تا ہیئے انکار کی تیما؛ دَ لعنت چھی اللہ سی کأفر آ زید۔
چَیر لأݜ چھی سے (قیمت) کسی کأ یأ ہیئے اَمن بیگینو، مھأئی ہے تے کتاب ما انکار کودی یأ اللہ نازل کیدو، مے بغض سی وجہ دے یرأ اللہ نازل کودُو تنو فضل دے کیزید یأ سے نیمادو تنو بَنا ما۔ دَ بھی واپس ہوئی ہے اے غضب ما دوئی غضب زید اَختہ ہیدے۔ آں کأفر آ سی کأ عذاب تُھو شوموؤ والا۔
آں کے یأ بَنا گا ہأئے: "ایمان آنا تیزید کا یأ اللہ نازل کیدُو"، بَندی: "مھو ایمان انَدی کا یأ نازل کوا گودُو مھو زید (یعنی تورات زید)"، آں انکار کودی ایما علاوہ (دأل کتاب آ سی)، آں ہے (قرآن) حق تُھو تصدیق کودُو کا یأ ہأکیش تُھو۔ بَن: "تَھلا کو تھو ایمان والا اَشئیو ایما مُوش تھو کئی اللہ سی پیغمبر موؤدُود؟"
آں یقیناً تھوئے موسٰیؑ اخکارہ نَخے سَمانے اَبوشُو۔ تھو (مھال) ظألم اَشیئی بھی تھوئے تیما بعد باس ما خدا سواد، آں تھو اَشئ ظالم (خلک)۔
آں کے یأ مھوئے پوخ لوظ تھوئے ما گھین، آں بھا کی مھوئے تھوزید طور سی کھان، (میس بیندے) "گݜا (جُوخ) کا یأ مھوئے تھوئے دیدتُو آں بُھوژا"، ہیئے بنو: "مھو بُھوژدی آں مھو نافرمانی کودی"، آں تھلا گادو ہین حی آ می بآس سی مینہ، بَن: "تھو ایمان والا تھیو چَیر لأݜ چھی سے بات یأ تھوئے تُھن ایمان اِسی حُکم دیدتُو"۔
بَن (اے پیغمبرؐ!): "کو خلگے ما علاوہ خالص تُھن کأ آخرت سی شِیر اللہ سی کأشکے چھیو تھو مئیک نیما (اللہ ما)۔ کو تھو سأس بَن تھیو"۔
آں ہے یئد ہُم نہ نیما بھادی، مِسی وجہ دے کا یأ ہیئے ہادیدے مُٹھائے پیوؤدُو۔ آں اللہ شید تُھو ظألما ما۔
آں خامخا پانین تأ ہأ بُٹ خلگا ما چیر زیاد جیدون زید حِرص ناک، آں تھأ خلگا ما ہُم یأ سے مشرک تھی۔ تھأمی ایک نیمادو کاش عُمو زر کالے دِیا گیشیوو، حال أ چھی ݲِگ عُمو ایس عذاب ما نہ لھاس بھاژی۔ آں اللہ پشَدو کا یأ ہے کودی۔
بَن: "کآم تُھو جبرائیلؑ سی دشمن؟ یقیناً تی نازل کی (قرآن) چھی حی زید اللہ سی حُکم دے، یأ تصدیق کودُو تھأ کِتاب آ سی کآم یأ ایما مُوش اَئیشی، آں ہدایت چھی آں زیرے چھی مومن آ سی کأ"۔
کآم یأ اللہ سی آں تِسی مُلیکا آ سی آں تِسی پیغمبر آ سی آں جبرئیلؑ و میکائیلؑ سی دشمن تُھو، دَ یقیناً اللہ ہأ کأفر آ سی دشمن تُھو۔
آں یقیناً مھوئے نازل کی تھیزید اخکارہ آیات، آں ہیئے ما نافرمان خلگے ما علاوہ یام انکار نہ کودُو۔
کے یأ ہُم ہیئے وعدہ کی، کئی ہیئے ما اے ڈلہ تیس (نہ) پھیرأد؟ بلکہ زیاد ہأمی ایمان نہ انَدی۔
آں کے یأ آپ ہأئے اے پیغمبر اللہ سی دیشا، کا یأ (آسمانی کتاب) ہأکیش اَشُو دا تِسی تصدیق کوؤ والا، ہأمی اے ڈلہ اللہ سی کتاب پیٹ پأشکے تَھلو، بَنے ہے نہ جَنودُود۔
آں تابعداری کی ہیئے کا یأ بنُودُود ہأئے شیطان سلیمانؑ سی بأچیی می۔ آں کفر سلیمانؑ نی کیشُو، بلکہ شیطان کفر کیشو، سے خلگائے جادو پَشوؤدُود آں کا یأ نازل کوا گوشُو دُو ملیکا ہاروت و ماروت زید بابل سی خار می، آں نہ پشؤدُود ہے (مُلیکا) یسکے بے مے بنو آ یرأ "یقیناً مھو آزمیخ سی کأ تھی، تھو (جادُو ڇھیڙتے) کُفر نہ کوا"، (بھی ہُم) سے ہأ دُو آ کیژا ڇھیڙو کوؤدُود کا یأ جدائی آنودُود تیدے ڇھی و کَھمن سی مِیئے۔ آں ہے ایدے یسکے ہُم اللہ سی حُکم ما بغیر ضرر اَوؤ والا نہ اَشِئی۔ (اَسے) سے ڇھیڙو کوؤدُود کا یأ ضرر اوؤدُود ہأئے آں نأ فائدہ اَوؤدُود ہائے۔ آں یقیناً (سے میس ہُم) جنودُود یرأ کآم یأ ہأ شیئی گِھندُوو نہ تُھو تِھین کأ اخرت می کی حصہ۔ آں خامخا چَیر لاݜ اَشُو کا یأ ہیئے بِگینو تِسی بدل می، کاش کہ ہے جنئی شِیو۔
کو ہیئے ایمان انوشُوو آں بھی پرہیزگاری کیشیو، خامخا ثواب اَشُو اللہ سی دیشا، کاش کہ ہے جنئی شیو۔
اے ایمان والا ہانا! نہ بَنا تھو (اللہ سی پیغمبر کے) "راعِنا" بلکہ بَنا تھو "اُنظرنا" آں بُھوژا۔ آں کأفر آ سی کأ دردناک عذاب تُھو۔
آں نی نیمادی کأفر اہل کتاب ما آں نأئی مشرکینے ما، یأ نازل کوا بژے تھوزید کی خیر سی بات تُھن رَب سی دیشا۔ اَسے اللہ خاص کودُو تنو رحمت سی کأ کیس یأ نیمادوو، آں اللہ گھن فضل والا تُھو۔
کا ہُم منسوخ کی مھوئے آیات یا اَموݜا تھلئ تھأ، انَدی غورہ تھیئے ما یا تھین چھلے، کئی تُو نہ جنَدو یقیناً اللہ ہر شیئی زید وَس لرَدو؟
کئی تو نہ جنَدو یرأ یقیناً اللہ سی بأچیئی چھی آسمان و دھرین آ سی، آں تُھن کأ اللہ ما علاوہ یام دوست نُو تُھو نأئی مددگار؟
یا تھو توَس کوؤ نیمادی تنو پیغمبر ما، کھأکأ یأ میما مُوش توَس کوا گوشُو موسٰیؑ ما؟ آں کی ایمان سی بدل می کُفر اختیار کیو یقیناً سے سیدا پَن ما گمراہ ہُو۔
(اے مسلمانا ہانا!) اہل کتاب ما زیات خلک تھین حی آ می حسد سی وجہ دے نیمادی تھو واپس کأفر کوئن تُھن ایمان ما بعد، حال أ چھی، حق تھأزید واضحہ ہُودو۔ معاف کوا آں مُو نرا کھیدیخانگے یأ اللہ تنو حُکم نہ پیؤدوو۔ یقیناً اللہ ہر شیئی زید وَس لردُو۔
آں نماز گُوزا آں ذکواۃ دا، آں کا یأ تھو نیک عمل مُٹھائے پیدی تنو کأ، تیس تھوئے پانین اللہ کیژا۔ یقیناً اللہ پشَدُو کا یأ تھو کودی۔
ہے بَندی: "یئد ہُم داخل نہ ہونین جنت کے اَسے کآم یأ یہودی تھو یا عیسائی"، ہے ہین لوو آ سی آرمان تھی۔ بَن: "آنا تنو دلیل کو تھو سأس بَن تھیو"۔
(بلکہ نأ) کی یأ اَمن حوالہ کی اللہ ئے، آں سے نیگی کوؤ والا اَشوو، تِسی کأ اَجر تُھو تنو رَب سی دیشا، آں تھأزید کی بِھیت نہ ہونین، نأئی تھیئے غمجن ہونین۔
آں یہودی بَندی: "عیسائی کی شیئی (دین) می نی تھی"، آں عیسائی بَندی: "یہودی کی شیئی می نی تھی"، حال أ چھی ہے (دُوںئیدے) کتاب بَندی۔ ہامُوڑ بےعلمہ (مشرکین) خلک ہُم ہین شانے بأت کودی۔ دَ اللہ قیامت سی دی ہین مِیئے تھأ بأدا سی فیصلہ کونین کامیک می یأ ہے اختلاف کوؤدُود تا۔
آں تی ما گھن ظألم دُوئی کآم تُھو، یأ سے اللہ سی جُمأدے ما کھمَدو یرأ تِسمی اللہ سی نام گھینا بژے، آں تِسی نھوؤ سی کوشش کودُو؟ ہأ خلگائے حق نُو تُھو یرأ سے ہأ جُمأدائے لھنگن اَسے بَھیل بَھیل۔ ہین کأ دونیئی می بےعزتی چھی آں آخرت می (ہُم) گھن عذاب تُھو۔
آں سی نوخین (مشرق) آں سی بڙین (مغرب) صرف اللہ سی تھی۔ دَ کامے دِشکے تھو پشَدیو تے دِشکے اللہ سی مُو تُھو۔ بےشکہ اللہ گھن وسعت والا گھن جَنُو والا تُھو۔
آں أ خلک بَندی: "اللہ (امن گے) پو گادتُو"، سے (اللہ) اِیزما پاک تُھو! بلکہ آسمان آں دھیرین آ سی ہر شیئی تِسی تُھو، ہر شیئی تِسی تابعدار تُھو،
سے آسمان و دھیرین آ سی بَنیاد تھوؤ والا تُھو، آں کے یأ تی کی بأت سی فیصلہ کِیو، دَ سے صرف تیسکے بَندُو "ہو!" دَ سے ہودُو۔
آں بے علمہ خلک بَندی: "اللہ مھوسید کئی بأت نہ کودُو؟ یا مھوئے کآں نَخ کئی نہ ییدُو؟" ہامُوڑ ہین بأت سی شانے ہأما مُوش لھنگیل خلک بات کوؤدود۔ ہین حی اے شان سی تھی۔ بےشکہ مھوئے نَخ اخکارہ کیدی تھأ خلگائے کآم یأ یقین کودی۔
بےشکہ مھوئے حق دیدے تھأ پیوؤدُو (اے پیغمبرؐ!)، مھاموڑ یرأ تُو خلگائے (جنت سی) زیرے دے، آں (دیزوخ ما) بھیا۔ آں تھأما دیزوخی آ سی بارہ می توَس نہ ہونین (یرأ تأ تنو حق ادا کی)۔
یئد ہُم یہودیئے تھأما خوشحال نہ ہونین، آں نأئی عیسائی ئے، کھیدیخانگے تأ تھین مذہب سی تابعداری نی کیو، بَن: "اصل ہدایت تا صرف اللہ سی ہدایت چھی"، آں کو تأ ہین خواہشات آ سی تابعداری کِیو، مِسما بعد (ہُم) یرأ تھیئے علم آپ تُو (وحی سی ذریعہ دے)، دَ تھأ اللہ ما لھاسُو سی کأ یی سأت و مددگار نہ ہونین۔
کآم خلگائے یأ مھوئے کتاب دِیدتُو دا، سے تِسی مھاموڑ تلاوت کودی کھأکأ یأ تلاوت سی حق تُھو، (اصل می) ہے خلک ایزید ایمان انَدی، آں کآم یأ اِسی انکار کودی، دَ اَںئی ہے نقصان می تھی۔
اے اسرائیل سی اولادأ! مھی تھأ نعمت یاد کوا یأ مأ تھوزید کِیدی، آں بےشکہ مأ تھوئے بُٹ دونیئی سی خلگا زید گھن مرتبہ دِیدتُو۔
آں تے دِی ما بِھیا کامے دی یأ اے انسان دوئی انسان گے کی شیئی سی فائدہ نہ دے بھانین، آں نأئی اِیزما کی فدیہ قبول ہونین، آں نأئی اِسی کی سفارشے فائدہ دینین، آں نأئی ہین مدد کوا بژنین۔
آں (یاد کو اے پیغمبرؐ!) کے یأ ابرہیمؑ تِسی پروردگار دھأک بأدا می آزماد، دَ تی تھأ (بأت) پُورا کی، (اللہ) بنو: "بےشکہ آ تھأ خلگا سی امام سَوؤ والا تُھو"، توَس کی: "مھی اولاد ما ہُم؟" اللہ بنو: "مھی لوظ ظألما سی بارہ می نو تُھو"۔
آں (تے وَخ یاد کو) کے یأ مھوئے بیت اللہ خلگائے جمع ہوؤ سی پوت آں اَمن سی پوت سواد۔ آں (اے مومنا ہانا!) تھو مقام ابراہیمؑ ما نماز سی پوت سَوا۔ آں مھوئے لوظ گِھنوشُو ابراہیمؑ و اسماعیلؑ ما یرأ "مھی شِیر غورا صفا ساتا، طواف کوؤ والا آں اعتکاف کوؤ والا آں رکوع سجدہ کوؤ والا آ سی کأ"۔
آں (یاد کو) کے یأ ابرہیمؑ بنو: "اے پروردگار! مے خار اَمن والا سَوا، آں مے خار والائے قِسماقسم میوہ آ سی رزق دے، کآم ہأمی ایمان انَدُو اللہ و آخرت سی دِی زید"، (اللہ) بنو: "آں کآم یأ کُفر کودُو دَ تیسکے مأ دھأک وَخ مزے دینین، بھی مأ تیس دیزوخ سی عذاب کے ݲِھیگتے نئینین، آں سے چَیر لاݜ پوت تُھو"۔
آں (تے وَخ یاد کو) کے یأ ابرہیمؑ بیت اللہ سی بَنیاد بھا کوؤدُود، تیسید اسماعیلؑ ہُم مے (دعا نیموؤدُود) "اے مُھن پروردگار! مھوما مے خذمت قبول کو، بےشکہ تُو ہر ایک سی بُھویو والا، جَنُو والا تُھو۔
اے مُھن پروردگار! آں مھو دُوئیمو تنو پورا فرمان بردار کو، آں مُھن نسل ما ہُم مھالے اُمت پیدا کو یأ سے چھی پورا تابعدار ہوئے، آں مھوئے مُھن عبادت سی طریقہ پَشا، آں مُھن توبہ قبول کو، بےشکہ صرف تُو چَیر توبہ قبول کوؤ والا رحمت والا تُھو۔
اے مُھن پروردگار! آں ہأمی اے پیغمبر پے سے ہأما ہوئے، سے ہین مُوش چھی آیات آ سی تلاوت کوئے، ہأئے کتاب (قرآن) آں حکمت (سنت) سی علم چھیڙے، آں ہین حی پاک کوئے، بےشکہ صرف تُو زوروڑ، حکمت والا تُھو"۔
آں کآم تُھو سے ابراہیمؑ سی دین ما مُو نَرادُو، (تی ماݜ ہونین) کآم یأ اَمن ما قمَعقل سَوادُو؟ حال أ چھی بیشکہ مھوئے تیس دونیئی ما کاروشُو، آں بےشکہ تی آخرت می خامخا نیک (خلک) آ ما ہونین۔
کے یأ تِسی پروردگار تیسکے بنو: "تابعدار ہو"، تی بنو: "آ تابعدار ہُو بُٹ جہان آ سی ساتونکے سی"۔
آں مے بأت سی ابراہیمؑ و یعقوبؑ تنو اولادائے وصیت کی، "اے مھی جدَگا ہانا! بےشکہ اللہ تُھن کأ دین اسلام خوشادتُو، دَ تھو یئد ہُم نہ موا اَسے مے حال می یرأ تھو مسلمان ہوا"۔
کئی تھو موجود اَشئ کا وَخ یأ یعقوبؑ کے مئیک آپ تا؟ کے یأ تی تنو جدَگائے بنو: "تھوئے مھأما پأش کِسی عبادت کونین؟" تھیئے بنو: "مھوئے چھی خُدئی سی عبادت کونین، آں چھی بوب داد ابراہیمؑ و اسماعیلؑ و اسحاقؑ سی خُدئی سی۔ صرف اے خدئی سی (یأ سے اے خدا تُھو)۔ آں مھو صرف تِسی تابعدار تھی"۔
سے اے ٹولگی أشِی بےشکہ سے مُٹھا لھینگی۔ تھأئے سے میلاؤ ہُو کا یأ تھیئے گھڑو، آں تھوئے تی میلاؤ ہونین کا یأ تھو گھڑَدی۔ آں تھوما تھین عمل سی کی توَس نہ ہونین۔
آں (یہودی و عیسائی) بَندی: "یہودی یا نصرانی ہوا، تھوئے ہدایت پانین"، ہأئے بَن: (نأ) بلکہ ابراہیمؑ سی دین (کسی یأ مھو تابعداری کودی)، کآم یأ بُٹ دین چھیدے خالص دین اسلام می اَشُو، آں سے شِرک کوؤ والا ما نہ اَشُو۔
تھو بَنا: "مھوئے اللہ زید ایمان اَنودُو، آں تے کلام زید ہُم، کامیک یأ مھوزید نازل کوا گودُو، آں کا یأ ابراہیمؑ و اسمعیلؑ و اسحاقؑ و یعقوبؑ آں تھین اولادی آ زید نازل کوا گودُو، آں تیزید ہُم کا یأ موسٰیؑ و عیسٰیؑ ئے دِیا گوشُو، آں کا یأ دأل پیغمبرآئے تھأئے تھین رَب سی دِشا دِیا گوشُو، مھو ہأ پیغمبر آ سی ایکدی آ می کی فرق نہ کودی، مھو صرف تے اللہ سی تابعدار تھی"۔
بھی کے یأ ہیئے مھاموڑ ایمان اَنو کھاموڑ یأ تھوئے آنودُو دا، ہیئے ہدایت پانین؛ آں کے ہیئے مُو نَراد، تَھلا ہے دشمنی وا گئی، بس مھیرے اللہ چھی کأ ہأئے پورا ہونین۔ آں سے ہر بات بُھویو والا، جَنُو والا تُھو۔
(اے مسلمانا ہانا بَنا یرأ "مھو دا) اللہ تنو ڙانگ می ڙانگئیدی، آں کآم تُھو سے اللہ ما (ہُم) غورا ڙانگدو، آں مھو صرف تِسی عبادت کودی"۔
ہأئے بَن: "تھو کئی مھوسید اللہ سی بارہ می پݜَژَدی، (حال أ چھی) سے مُھن ہُم رَب تُھو آں تُھن ہُم رَب تُھو؟ (أ دوئی بات چھی کہ) مھوئے مُھن عمل پکار ییدی، آں تھوئے تُھن عمل پکار ییدی۔ آں مھو خالص تِسی کأ (عمل کوؤ والا) تھی"۔
کئی تھو (میس) بَندی یرأ بےشکہ ابراہیمؑ و اسماعیلؑ و اسحاقؑ و یعقوبؑ آں تھین اولأدی یہودی اَشئ یا نصرانی؟ ہأئے بَنا "تھو چَیر جنَدی کو اللہ؟" آں تِسما گھن ظألم کآم تُھو کآم یأ تے گواہی بُورادو کامیک یأ ایزکیش چھی اللہ سی دیشا؟ آں اللہ تھین تے عمل ما بے خبر نہ تُھو، کامیک یأ تھو کودی۔
سے اے اُمّت أشی بےشکہ سے لھینگی، ہأئے سے میلاؤ ہُو کا یأ تھیئے گھڑُو، آں تھوئے تی میلاؤ ہونین کا یأ تھو گھڑدی، آں تھوما تھین عمل سی کی توَس نہ ہونین۔
مھیرے بھی قَمقل خلگے بَننین: "ہأ (مسلمان) کا شیئے ہین تے قبیل ما گئأد، کامیک زید یأ ہے مُوش اَشِئی؟" تھو بَنا: "سی نوخین (مشرق) آں سی بژین (مغرب) صرف اللہ سی تھی، تی کیس نیمادو، سیدا پَن سی ہدایت دیدو"۔
اَںئی ہامُوڑ مھوئے تھو مئیمو سی اُمت سیوأدچی، مِسی کأ تھو خلگا زید گواہ ہوا، آں رسولؐ تھوزید گواہ ہوئے۔ آں کامے قبیل زید یأ تُو مُوش اَشُو تیس مھوئے صرف مے بأت سی کأ مقرر کِشی کہ مھو پیشی کآم رسولؐ سی تابعداری کودُو، آں کآم تنو کِھن آ زید واپس نُڑودُو، آں أ بات (قبیل سی بدل کوؤ) چَیر بوکھے أشی، اَسے تھأ خلگائے (آسان أشی) کآمائے یأ اللہ ہدایت دیدیشی۔ آں اللہ مھاموڑ نہ تُھو کے تُھن ایمان ضائع کوے۔ بےشکہ اللہ خلگا زید چَیر مہربان، رحم کوؤ والا تُھو۔
اے پیغمبرؐ!) مھو تُھن مُو اے موآ آسمان سی دِشکے نُڑوا پَشَدی، دَ مھوئے خامخا تھأ مھال اے قبیل سی دِشکے پِشانین یرأ تھو تیس خوشادی۔ دَ مھیرے تُو تنو مُو مسجد حرام سی دِشکے نَرا۔ آں (اے مسلمانا ہانا!) تھو کھید یأ ہوئیو تنو مُو اِسی دِشکے نَرا۔ آں بےشکہ کامے خلگائے کتاب دیا گودُو سے غورہ جنَدی یرأ بےشکہ أ (قبیل سی بدلی) حق بات چھی ہین رَب سی دِشا۔ آں اللہ ہین عملے ما بےخبر نُو تُھو۔
آں کآم خلگائے کتاب دیا گودُو، کو تھوئے تھأئے ہَر اے نَخ گِھیندے اَئیو بھی ہُم سے تُھن قبیل سی تابعداری نہ کودی۔ آں نأئی تھو تھین قبیل سی تابعداری کودی۔ آں نأئی ہأمی یام ایکدی آ سی قبیل سی تابعداری کودی۔ کامے علم یأ تھیئے (وحی سی شکل می) آپ تُو تِس ما بعد ہُم کو تأ ہین خواہشات آ سی تابعداری کیو تَھلا تھوئے خامخا ظألیما می لیکھا بژنین۔
کامے خلگائے مھوئے کتاب دِیدتُو سے ایس مھاموڑ پأندی کھأکأ یأ سے تنو جدک پأندی۔ آں بےشکہ ہأمی اے ڈلہ خامخا جیندے حق بُوراژی۔
حق تُھن پروردگار سی دِشا تُھو، دَ یئد ہُم شَکی آ می نہ ہوا۔
آں ہر اے ڈلہ سی ایک دیش چھی، تِسی دِشکے سے مُو کودی۔ تھو ایکدی ما خیر سی کما می مُٹھیدی ہوا۔ کھید ہُم تھو ہُوئیو اللہ تھو بُٹ ایپوت کیدے آننین۔ بے شکہ اللہ ہر شیئی زید وَس لَردُو۔
آں تھو کھیدا ہُم نیگھأدو (سفر سی کأ)، دَ تنو مُو مسجد حرام سی دِشکے نرا، آں بےشکہ أ بات چھی پروردگار سی دیشا حق چھی، آں اللہ تُھن عملے ما بے خبر نہ تُھو۔
آں تھو کھیدا ہُم نیگھأدو دَ تنو مُو مسجد حرام سی دِشکے نرا، آں تھو (مسلمان ہانا) کھید ہُم ہُوئیو تنو مُو اِسی دِشکے نرا، مِسی کأ خلگائے تُھن خلاف اعتراض سی موقع میلاؤ نہ ہوئے، ہاں کآم یأ ہأمی ظألم تِھیدا تھو ہأما نہ بِھیا، آں صرف مھأما بِھیا۔ آں مِسی کأ یرأ آ تھوزید تنو نعمت پورا کئی، آں تھو ہدایت حاصل کوا۔
(أ انعام مھاموڑ تُھو) کھأکأ مھوئے تھو ما اے رسول تھو می پیوؤدُو، سے تُھن مُوش مُھن آیت آ سی تلاوت کودُو، آں تھو پاک کودُو آں تھوئے کتاب (قرآن) آں ہُوشاتوب سی بأت (حدیث) ڇھیڙادُو، آں تھوئے تھأ بأت ڇھیڙادُو کآم یأ تھو مُوش نہ جَنودُود۔
دَ تھو مھأ یاد ساتا، مأ تھو یاد ساتنین۔ آں تھو مھی شکر نِگھالا آں مھی ناشکری نہ کوا۔
اے ایمان والا ہانا! صوو آں نماز ما مدد گھینا، بےشکہ اللہ صوو کوؤ والا سید تُھو۔
آں تھو تے ماݜ کے مئیل نہ بَنا کامیک یأ اللہ سی پَن می ما گادُو، بلکہ سے جَن تھی، اَسے تھو نہ جنَدی۔
آں مھوئے خامخا تھو آزمانین، کآں (دشمن سی) بِھیت آں بِݜیدے، آں مال و جان سی نقصان دے، آں میوہ (سی کمی کیدے)، اَسے صوو کوؤ والائے زیرے دے،
ہے سے خلک تھی ہأئے کے کآں غم اَوَئیو بَندی "بےشکہ مھو صرف اللہ سی تھی، آں بےشکہ مھوئے صرف تِسی ڈھأر کے واپس نُڑنین"۔
ہے سے خلک تھی ہأزید ہین رَب سی دیشا خاص مہربانی و رحمت تھی۔ آں اَںئی ہے خلک ہدایت زید تھی ( ݜِݜ پَن زید تھی)۔
بےشکہ صفا و مروہ اللہ سی نَخے ما تھی۔ دَ کآم بیت اللہ سی حج یا عمرہ کودُو دَ تیزید (دوںئی آ سی) طواف کوؤ می کی گناہ نہ تُھو۔ آں کآم تنو خوشألی دے اے خیر سی کام کودُو دَ بےشکہ اللہ گھن قدرمَند جَنُو والا تُھو۔
بےشکہ کآم خلک مُھن اَخکارہ دلیل آں ہدایت بُرادی، مِسما بعد یرأ مھوئے ہأ بأت کتاب سی خلگائے اَخکارہ بیان کیدی، ہأزید اللہ لعنت کودُو آں لعنت کوؤ والا ہُم ہأزید لعنت کودی،
سیوائے تھأ خلگے ما، کی یأ توبہ نِگھألی آں تنو عمل صحیح کی، آں (کا یأ بُوروؤدود تا تیس) اخکارہ بیان کی۔ دَ مأ ہال خلگا سی توبہ قبول کونین، آں آ گھن بوگوشو والا مہربان ذات تُھو۔
بےشکہ کآم خلگے (حق بُورأدے) کُفر کی، آں بھی کأفر مُوئی، ہأ خلگا زید اللہ سی آں ملیکا آ سی آں بُٹ انسان آ سی لعنت چھی،
ہیئے مُدام سی کأ اِسمی ہونین۔ نأ ہأ کیژا عذاب اِپھیڑی کوا بژنین، آں نأئی ہأئے دوئی وَخ (سی مہلت) دیا بژنین۔
آں تُھن خدا اے خدا تُھو۔ تیس ما علاوہ یام خدا نُو تُھو، سے گھن مہربان چَیر رحمت والا تُھو۔
بےشکہ آسمان و دھیرین آ سی پیدا کوؤ می، آں ڙأد و دِی سی بدلی می، آں تے کِشتی می کے یأ سے دریاب می خلگائے فائدہ سی شیئی گھیندے روان چھی، آں تے اُو می کامیک یأ اللہ آسمان ما موژاد، بھی تی تے دھیرین جینی کی تِسی مئیک ما بعد، آں اے دھیرین می ہر قسم سی زیناور خور کی، آں بیلیئی سی پِشُو می، آں تھأ ہاگا آ می کامیک یأ آسمان و دھیرین سی مئیمو می (حُکم سی) پابند تھی، (ہأ بُٹ بأدا می) یقیناً عقل والا آ سی کأ چَیر نَخ تھی۔
آں خلگا می یام سے ہُم تھی، یأ سے اللہ ما علاوہ دأل خُدئی (شریک) گݜَدی۔ ہے تھأسید مھاموڑ مینہ کودی کھأکأ اللہ سید مینہ کوؤ پکار تُھو۔ آں (دُوئی دِشکے) ایماندا خلک اللہ سید مینہ سی کوؤ می چَیر سخ ہودی۔ آں ارمان، کو أ ظألم خلک جَنئی شِیو، آں ہیئے (دُونیئی می) کآں عذاب ڈیڈوُشوو یرأ بُٹ طاقت صرف اللہ سی تھی، آں مِسما یرأ بےشکہ اللہ (آخرت می) سخ عذاب دِیوؤ والا ہونین۔
(تے عذاب سی وَخ می) کے یأ تھیئے خلگے بیزار ہونین تنو تابعدارے ما، کِھین یأ بات مَنا بَیودُود، آں ہیئے عذاب پَشنین آں ہین تعلقاتے پھورنین،
آں تھین تابعدار خلگے بَننین: "آرمان کو مُھن اے پیرا (دُونیئی ئے) واپسی ہِیشیو دَ مھوئے ہُم ہأ ما مھاموڑ بیزار ہونیندے کھأکأ یأ ہے مھوما بیزار ہوئیدیدا"، ہامُوڑ اللہ ہأئے ہین عمل پشانین ہأزید افسوس سی کأ۔ آں مھیرے ہے دیزوخ سی آنگا ما نُوخو والا نی تھی۔
اے خلک ہانا! دھیرین سی رزق می حلال پاک شیئی کھا آں شیطان سی قدم آ زید نی تِلا۔ بےشکہ سے صرف تُھن اَخلکارا دشمن تُھو۔
ہے (شیطان) تھوئے صرف لاݜ آں بےحیائی سی حُکم دیدُو، آں (مے بأت سی) یرأ اللہ سی بارہ می تھأ بأت کوا کا یأ تھو نہ جنَدی۔
آں کے یأ ہأئے (کأفرائے) بَنا گاو یرأ "تےکتاب سی تابعداری کوا کامیک یأ اللہ نازل کیدُو"، سے بَندی: "نأ، بلکہ مھو تھأ بأدا سی تابعداری کودی کامیک زید مھوئے تنو باپ داد پأتتی"۔ کئی؟ (بھی ہُم ہیئے تابعداری کونین) کو ہین بوپ داد (دین سی) کی شیئی ما نہ جنَدُودو، آں نأئی (آسمانی) ہدایت زید اَشیئو؟
آں کأفر آ سی مثال تے ماݜ سی تُھو سے تھأ (څاروئی آ ئے) ہاگادُو سے ہاگَوؤ و ڇأڑ ما علاوہ کی نہ بُھوژدیو؛ ہے کأفر بو تھی چار تھی اَن تھی، دَ ہے کی نہ جنَدی۔
اے ایمان والا ہانا! تے پاک رزق ما کھا کامیک یأ مأ تھوئے دیدچی، آں اللہ سی شکر نِگھلا، کو سأزکے تھو صرف تِسی عبادت کودِیو۔
بےشکہ (اللہ) تھوزید حرام کیدی، مُردا و ڙات آں ڈھوک سی ماس آں سے څاروئی کیزید (حلال کوؤ سی وَخ می) اللہ ما علاوہ دُوئی کِسی نام گِھیناگاو۔ کو یام مجبور ہُو، مے حال می یرأ مزہ گھینو والا نہ ہوئے، آں نأئی (ضرورت سی) حد ما مُٹھائے بَژو والا ہوئے، دَ ایزید کی گناہ نُو تُھو۔ بے شکہ اللہ چَیر بوگوشُو والا چَیر مہربان تُھو۔
بےشکہ کآم خلک اللہ سی نازل کویل کتاب بُرادی، آں اِسی بدل می اَشوڑ قیمت گھینَدی، ہے خلک تنو ڈھے آنگا ما علاوہ کی شیئیدے ڈک نہ کودی۔ آں نأئی قیامت سی دِیے اللہ ہأزید بأت کونین، آں نأئی ہأ پاک کونین۔ آں خاص ہین کأ دردناک عذاب تُھو۔
آں ہے سے خلک تھی کی یأ ہدایت سی بدل می گمراہی مُل گِھینچی، آں گناہ بوگوشُو سی بدل می عذاب۔ دَ ہیئے کھیدیک اِزغم نین دیزوخ سی آنگا!
أ مے وجہ دے ہُو یرأ اللہ حق زید کتاب نازل کیدُو، آں بےشکہ کآم خلک کتاب سی بارہ می خلاف کودی سے تنو ضد می چَیر دُھو گئیدی۔
نیگی صرف أ نی چھی یرأ تھو تنو مُو سی نُوخین (مشرق) آں سی بژین (مغرب) سی دِشکے نَرا۔ ہاں نیگی أ چھی یرأ: خلک ایمان آنن اللہ زید، آں آخرت سی دِی زید، آں مُلیکا آ زید، آں کتاب و پیغمبر آ زید، آں اللہ سی مینا می مال دَن، رشتہ دارائے آں شوروڑ و غریبائے، آں مسافِر و نِمَؤ والائے، آں غلام آ سی آزاد کوؤ می، آں نماز قائم کوئن آں ذکواۃ دَن، آں یئد یزیت لوظ کِیو تنو لوظ پورا کوؤ والا ہوئن، آں تنگی و سختی می آں لات سی وخ می صوو کوؤ والا ہوئن، اَںئی ہے خلک سأزبَن تھی، آں اَںئی ہے خلک نیک تھی۔
اے ایمان والا ہانا! تھوزید (قصداً قتل سی مقدمہ می) مئیل سی بدل گِھینُو فرض کوا گودُو؛ آزاد ماݜ آزاد سی بدل می، آں غلام غلام سی بدل می، آں جَوئی جَوئی سی بدل می (ما بژنین)۔ بھی کے ایسکے (قاتل گے) اِسی بھئی (مئیل سی وارث) سی دِشا کی شیئی (قصاص) معاف کوا گاو دَ غورہ رواج سی طریقہ دے دیت سی مطالبہ کوئن، آں (قاتل) ایسکے دیت غورہ طریقہ دے دو، أ تھوئے تُھن رَب سی دِشا اَسأنی و مہربانی چھی، بھی کو ایزما بعد یی زیأتیئی کیو دَ خاص تیسکے دردناک عذاب ہونین۔
آں اے عقل سی کھمَن ہانا! تُھن کأ (مئیل سی) بدل سی گھینو می جیدون تُھو، اُمید تُھو تھوئے بچ ہونین۔
تھوزید فرض کوا گودُو یرأ کے تھومی یسکے مئیک آبو، کو امَن ما پأشکے کی مال چھیئیو وصیت کوئے رواج سی مطابق، تنو یَیئی و بوب آں تنو رشتہ دار آ سی کأ - أ ہر پرہیزگار زید حق تُھو۔
بھی کی اے وصیت اِسی بُھویو ما بعد بدل کی، دَ اِسی گناہ صرف تھأ خلگا زید ہونین، کآم یأ ایس بدل کودی، بےشکہ اللہ چَیر بُھویو والا، جَنُو والا تُھو۔
ہاں، کو کی وصیت کوؤ والا سی دِشا (بے زایا) ڈھأر گݜو یا حق کھوؤ سی بِھیت کی، بھی تی ہِین (وارث آ سی) مِیئے صلح کی، دَ ایزید کی گناہ نہ تُھو، بےشکہ اللہ گَھن بوگوشُو والا مہربان تُھو۔
اے ایمان والا ہانا! تھوزید ڙوز فرض کوا گئیدی، کھأکأ یأ تھوما مُوشِک خلگا زید فرض کوا گئیشی، مِسی کأ تھو تقوی دار سَوا بژَا۔
(ڙوزا سی) لیکھیل دی تھی۔ بھی کو تھومی یام ناژور اَشُو یا سفر می اَشُو، دَ ہے دأل دی آ می اے لیک پورا کوئے۔ آں کآم خلک (ڙوز آ سی) طاقت لرَہ دی (اَسے ڙوز نہ تھا دی) تھأزید فدیہ سی دیؤ می اے غریب کے گیل سی دیؤ تُھو۔ اِسما علاوہ کو یام تنو خوشألی دے کی نیگی کودُو دَ سے تِسی کأ چَیر غورا تُھو۔ اَسے تُھن ڙوز آ سی تھوؤ تُھن کأ چَیر غورہ تُھو، کو تھو جَنیئو۔
ڙوزماہ سے (ماہ) تُھو کِس می یأ قرآن (شریف) نازل کوا گودُو، ہے خلگا سی کأ پورا ہدایت چھی، آں ہدایت سی اخکارہ نَخے سمانے فرق کودُو حق و ناحق سی مِیئے۔ دَ تھومی یی مے ماہ (سی یُن) ڈیڈو سے اے ماہ سی ڙوز تھَئے؛ آں کو یام ناژور اَشُو یا سفر می اَشُوو دَ ہے دأل دِی آ می اے لیک پورا کوئے۔ اللہ تھوزید أسانی کوؤ نیمادُو، آں تھوزید تنگی نہ نیمادو، آں مِسی کأ کہ تھو (ڙوز آ سی) لیک پورا کوا، آں مِسی کأ یرأ تھو اللہ سی گھینیئی بیان کوا یأ تی تھوئے ہدایت دید؛ آں مِسی کأ تھو شکر نِگھلا۔
آں کے مھی بَندائے تھوکیژا مھی بارہ می توَس کِیو، دَ (ہأئے بَنا) بےشکہ آ چَیر نھیو تُھو۔ آ دعا کوؤ والا سی ڇاڑ قبول کودُو کے یأ سے مھیئے ہاگؤسأدو۔ دَ ہأئے پکار تُھو ہے مھی حُکم پورا کوئن، آں مھیزید پوخ یقین کوئن، دَ ہیئے ݜِݜ پَن زید یے نین۔
تُھن کأ ڙوز آ سی ڙأدا می تنو ڇِھی آ سی کأشکے بَیو حلال کوا گودُو۔ ہے تُھن کأ کوژو تھی آں تھو ہین کأ کوژو تھی۔ اللہ ئے پتہ أشِی یرأ بےشکہ تھو اَمن زید (بریت) خیانت کوؤدُود، دَ تی تُھن توبہ قبول کی، (دَ تی تھوزید مہربانی کی) آں تُھن گناہ معاف کی۔ مھیرے تھو ہین کأشکے بَژا، آں کائی اللہ تُھن کأ لِگُودُو تھو تیس بِرڑا۔ آں کھاؤ پُوا تھیدیخانہ پورے کے ڙات سی اُوژل لُن تھوئے کِݜن لُن ما اَخکارہ جُدا ہوئے۔ بھی ڙأدا پورے ڙوس پورا کوا۔ آں تھو تنو ڇِھی آ سی کأشکے نہ بَژا مے حال می کہ تھو جُمأدا می اعتکاف می ہُویو۔ أ اللہ سی سیم (حد) تھی، دَ تھو ہأئے نھیئی نہ ہوا۔ مھاموڑ اللہ خلگائے تنو آیت اَخلکارہ بیان کودُو، ہوبھادُو ہے پرہیزگار سَوا بژَن۔
آں تھو ایکدی سی مال اَمن می ناحق طریقہ دے نہ کھا، آں نأئی ایس حاکم آ سی کأشکے (رشوت سی طور تے) مِسی کأ نَیا یرأ تھو خلگا سی مال آ ما اے حصہ ظلم دے کھا، مے حال می یرأ تھو جَندی۔
خلک تھوکیژا نَم ماہ سی یُن آ سی بارہ می توَس کودی (کئی کم زیاد ہوژی)۔ ہأئے بَن: "ہے خلگا سی معاملات آں صحیح وَخ سی معلوم کوؤ سی کأ تھی"۔ آں أ نیگی نی چھی یرأ تھو شیرائے پیشِم دِشا یا، بلکہ ہاں نیگی أ چھی یرأ انسان پرہیزگار ہوئے۔ آں شیرائے تھین در آ دے یا۔ آں اللہ ما بِھیا، ہوبھادو تھو کامیاب ہوا۔
آں تھو اللہ سی پَن می تھأ خلگا سید لات کوا کآم یأ تھوسید لات کودی، اَسے زیأتیئی نہ کوا۔ بے شکہ اللہ زیأتیئی کوؤ والا نہ خوشادُو۔
آں ہأ خلک ما، کھید ہأ تھوئے پأدو، آں ہأ تھیدا نِگھالا کھیدا ہیئے تھو نیگھالیئشی، آں فتنہ و فساد موؤ ما ہُم چَیر لاݜ (شیئی) تُھو۔ آں ہأزید مسجد حرام سی کأش کے لات نہ کوا، کھیدیخانہ پورے ہیئے تھوسید تھید لات شروع نی کِیو۔ بھی کو ہے تھوسید تھید پَݜأدو تھلا ہأ ما، اَںئی ہاموڑ کأفر آ سی بدلہ تُھو۔
بھی کو سے قلار ہوئیو، تَھلا اللہ گھن بوگوشُو والا، چَیر مہربان تُھو۔
آں تھو ہأسید لات کوا، مھیدا پورے یأ کی فتنہ و فساد نہ دَھرے، آں دین صرف اللہ سی ہوئے۔ بھی کو ہے قلار ہوئیو، تَھلا ظألما ما علاوہ یزیت زیأتیئی روا نی چھی۔
عزت مند ماہ سی بدَل عزت مند ماہ تُھو، آں (بُٹ) عزت مند شیئی آ سی ہُم بدل گِھنا بژنین۔ دَ کی تھوزید زیاتیئی کیو تھو ہُم تیزید زیاتیئی کوا، کھأل زیاتیئی تھیئے تھوزید کیو۔ آں اللہ ما بھیا آں غورہ جَنا یرأ بےشکہ اللہ پرہیزگار آ سید تُھو۔
آں اللہ سی پَن می مال خرچ کوا، آں تنو اَمن تنو ہادیدے بربادی ئے نہ تَھلا۔ آں غورا کوا اللہ غورا کوؤ والا خوشادُو۔
حج و عمرہ اللہ سی کأ پورا پورا کوا۔ بھی کو تھو کھما گئیو، کامے قربأنی آسان ہِیو تیس کوا۔ آں تنو ݜا نہ نھیاڑا تھیدیخانہ پورے یأ قربأنی تنو پوت کے آوے۔ بھی کو یام تھومی بیمار اَشُو یا کو ݜا می کی تکلیف اَشُو (آں مُوش ݜا نھأڑُوو) دَ تِسی بدل می ڙوز تھئے یا صدقہ یا قربانی کوے۔ بھی کے یأ تھو اَمن می ہُوئیو (آں حج ما مُوش مکہ ئے گئیو) دَ کآم یأ حج آ پورے عمرہ سی کوؤ سی فائدہ گھینَدُوو، تَھلا سے قربانی کوے، کامیک یأ آسان ہِیو۔ بھی کو یأ قربأنی نہ پأدو (کو یِسی قربأنی سی وَس نہ چھیو) تَھلا ڇا ڙوز تھیئے حج سی دی آ می، آں سات (ڙوز) کے یأ تھو (شِیرائے) واپس ہوئیو۔ أ دش (ڙوز) پورا ہُوئی۔ أ حُکم تھأ خلگا سی کأ تھو کِسی کلاݜ مسجد حرام سی کأش نہ دھرَدی۔ آں اللہ ما بھیا آں غورا جَنا یرأ بےشکہ اللہ سخ سزا دیوؤ والا تُھو۔
حج سی دھأک مقرر ماہ تھی؛ بھی کی یأ مھأ ماء آ می (احرام گھیندے) اَمن زید حج لازم کیو، دَ حج می نأ کی شہوانی عمل (جوَئی سید تعلق) کونین، نأئی گناہ، نأئی لات۔ آں تھو کامے غورہ کام کودی اللہ تیزما شِید ہودُو۔ (حج سی سفر می) پَن سی خرچہ اَمن سید گھینا، آں بہترین خرچہ پرہیزگأری چھی۔ آں اے عقل سی کھمَن ہانا! صرف مھأ ما بھیا۔
تھوزید کی گناہ نُو تُھو، کو تھو تنو رَب سی فضل بیرَڑدی (حج می تجارت یا میزدی کیدے)، بھی کے یأ تھو عرفات ما واپس روان ہُوئیو، دَ مشعر حرام (مزدلفہ) می اللہ سی ذکر کوا۔ آں مھاموڑ ذکر کوا کھامُوڑ یأ تی تھوئے پَشادتُو، آں بےشکہ ایزما مُوش تھو بے خبر خلگا ما اَشِئ۔
بھی تھو اَںئی تھیدا واپس روان ہوا کھیدا (دیأل) خلک واپس روان ہودی، آں اللہ ما معافی نیما۔ بےشکہ اللہ گَھن بوگوشُو والا چَیر مہربان تُھو۔
بھی کے یأ تھوئے حج سی رُکن پورا کِیو، مھاموڑ اللہ یاد کوا کھأکأ یأ تھو تنو باپ داد یاد کوؤدُود، یا تیما ہُم چَیر زیاد (یاد کوا)، دَ خلگا می یام مھال ہُم تھی سے (تنو دعا می) بَندی: "اے مُھن پروردگار! مھوئے دُونیئی می دے"، آں آخرت می ہین کی حصہ نُو تُھو۔
آں ہأمی یام سے تھی سے بَندی: "اے مُھن پروردگار! مھوئے دُونیئی می غورہ دے، آں آخرت می ہُم غورا دے، آں مھو آنگا سی عذاب ما بچ کو"۔
اَںئی ہأ خلگائے ہین گھڑیل عمل ما حصہ میلاؤ ہونین، آں اللہ دستی حساب کوؤ والا تُھو۔
آں اللہ یاد کوا دھأک لیکھیل دی آ می۔ دَ (منٰی می تھو ہُوئیو) کی تأدی کیدے دو دِی آ می گاو تیزید کی گناہ نُو تُھو؛ آں کآم ہِسار ہُوو (اے دی سی کأ) تیزید ہُم کی گناہ نُو تُھو۔ أ بأت تِسی کأ تھی کآم پرہیزگاری کودُو۔ آں اللہ ما بھیا، آں یقین کوا بےشکہ تھوئے خاص تِسی کأشکے جمع کوا بژنین۔
آں خلگا می سے ہُم تُھو یأ تِسی بأت دُونیئی سی جیدون می تھیئے مزہ دیدی، آں سے اللہ گواہ سَوادُو تنو حی سی بأدا زید، حالانکہ سے سَخ پَݜژاڑ تُھو۔
آں کے یأ سے نِڑتے بژدو، مِسی کأ دھیرین می دھأنئی دیدُو یرأ اِیزمی فساد کیئی، آں بُھوما سی فصل آں زیناور آ سی نسل تباہ کیئ؛ حال أ چھی اللہ (دھیرین زید) فساد نہ خوشادُو؛
آں کے یأ ایسکے بَنا گاو یرأ اللہ ما بِھی، ایسی ضِد ایس لائی گناہ ئے تیا کوئی۔ دَ اِسی کأ دیزوخ پورا چھی، آں کا لاݜ پوت تُھو سے دھرُو سی۔
آں خلگا می یام سے تھی یرأ اللہ سی خوشال کوؤ سی کأ تنو جیدُون سی سودا کودی۔ آں اللہ تنو بَن آ زید گھن مہربان تُھو۔
اے ایمان والا ہانا! پورا پورا اسلام گے لَھنگا، آں شیطان سی قدم آ پأش پأش نی تِلا۔ یقین کوا سے تُھن اخکارہ دشمن تُھو۔
بھی ہُم کو تھو اخکارہ دلیل آ سی ییؤ ما پأش پَݜَلیو، تَھلا یقین کوا یرأ بےشکہ اللہ زوروڑ حکمت والا تُھو۔
اَیا أ (کأفر ایمان اَنو سی کأ) صرف مے بأت سی انتظار کودی یرأ اللہ ہاگا سی چیژول آ می ہین مُوش کے یو، آں مُلیکا ہُم (ہون) آں بُٹ قصہ ختم ہوئے؟ آں بُٹ معاملات صرف اللہ سی دِشکے نُڑا بژَدی۔
توَس کو بَنی اسرائیل ما مھوئے کھیدیک واضحہ نَخ ہأئے دید۔ آں کی یأ اللہ سی نعمت میلاؤ ہوؤ ما بعد بدل کِیو، بےشکہ اللہ سخ عذاب دیوؤ والا تُھو۔
شیژیئی کوا گودُو کأفر آ سی کأ دُونیئی سی جیدون، آں سے پِشاڑے کودی تھین کیئے یأ ایمان اَنودو۔ اَسے کآم یأ پرہیزگار تھی تھیئے قیامت سی دی تھین ڙید ہونین۔ آں اللہ بے حسابہ رزق دیدُو کیس کے یأ نِمؤسأدو۔
(اول می) بُٹ خلک اے دین زید اَشِئی؛ بھی (کے یأ ہأمی اختلاف ہُو دا) اللہ زیرے دیؤ والا آں بھیؤ والا پیغمبر پیئی، آں ہأزید حق کتاب نازل کی، مِسی کأ یرأ ہے خلگا سی مِیئے تھأ بأدا سی فیصلہ کوئے یأ کِس می ہے اختلاف کوؤدُود۔ آں اِسمی تھیئے خلگے اختلاف کی کیسکے یأ کتاب دیا گوشُو، روخانہ دلائل اَوؤ ما بعد ہُم صرف ایکدی سید ضد سی وجہ دے ہیئے اِسمی اختلاف کی۔ بھی کآم خلگے یأ ایمان اَنوشو اللہ تنو حکم دے تھأئے حق بأت سی ہدایت دید، کس می ہیئے اختلاف کِیشُو۔ آں اللہ کیسکے نِمادُوو سیدا پَن سی ہدایت دیدُو ۔
کئی تھو مے گمان کودی یرأ جنت کے تھوئے ہأئیمو لھنگنین، حال أ چھی مھیرے تھوزید لا سے حالات نہ اَئیدی، کامیک یأ تھو ما مُوشک لھنگیل خلگا زید اَئیشی دا؟ تھأزید تنگی آں سختی اَئی، آں سے جھڑقا گئی، مھیدا پورے یرأ رسول آں ایمان والائے بنو: "کے ینین اللہ سی مدد؟" خبردار! بےشکہ اللہ سی مدد نھیو چھی!
(خلک) تھأما توَس کودی (اے پیغمبرؐ!)، ہے کا خرچ کوئن؟ بَن: "کائی خرچ کودی تھو مال ما، (تِسمی) یئی و بوب سی کأ آں رشتہ دار آ سی کأ آں یتیم آں مِسکین آں مُسافر آ سی حق تُھو۔ آں کا نیگی یأ تھو کودی دا، بےشکہ اللہ تیزما پوھہ تُھو"۔
تھوزید جہاد فرض کوا گودُو، آں سے اِی تُھن کأ بُوکھو تُھو۔ آں ہوبھادُو تھو نہ خوشادی اے شیئی آں سے غورہ تُھو تُھن کأ، آں ہوبھادُو تھو خوشادی اے شیئی آں سے لاݜ ہوئے تُھن کأ۔ آں اللہ جندُو آں تھو نہ جنَدی۔
(خلک) توَس کودی تھأما عزت مند ماہ سی بارہ می، یرأ اِسمی لات کوؤ کھال تُھو۔ بَن: "اِسمی لات کوؤ گھن گناہ تُھو، اَسے خلک خُدئی سی پَن ما منع کوؤ، تِسما انکار کوؤ، مسجد حرام ما کھمو، اِسمی دَھرُو والا اِسما نِیگھالُو، اللہ سی نیز می اِس ما ہُم گھن (گناہ) تُھو۔ آں فتنہ موؤ ما ہُم گھن (گناہ) تُھو"۔ آں ہیئے تھوسید لات کوا ینین تھیدیخانہ پورے کو ہین وَس پیلیو تھو تنو دین ما گئأنین۔ آں کآم یأ تھوما تنو دین ما واپس ہُوو آں کأفر مُوو تھین دُونیئی و آخرت سی اعمال برباد ہونین، آں سے خلک دیزوخی تھی؛ ہیئے اِسمی مُوآ ہونین۔
بےشکہ کامے خلگے ایمان اَنو، آں کی یأ ہجرت کی آں جہاد کی اللہ سی پَن می، اَںئی ہے خلک امیدوار تھی اللہ سی رحمت سی۔ آں اللہ بوگوشُو والا تُھو آں رحم کوؤ والا تُھو۔
(خلک) توَس کودی تھأما شراب آں جوأری سی بارہ می۔ بَن: "اِسمی گھن گناہ تُھو آں فائدہ (ہُم دھأک) تُھو خلگا سی کأ۔ اَسے گناہ ہأ دُوںئی آ سی چَیر گھن تُھو ہین فائدہ ما"۔ آں ہے توَس کودی تھأما کا خرچ کیئی اللہ سی پَن می۔ بَن: "کائی زیات تُھو (تُھن ضرورت ما)"۔ اَںئی ہامُوڑ بیان کودُو اللہ تُھن کأ آیات، مِسی کأ تھو پِھگر کوا
(پِھگر کوا) دونئی و آخرت می۔ آں ہے توَس کودی تھأما یتیم آ سی بارہ می۔ بَن: "ہین اصلاح کوؤ غورہ تُھو۔ آں کو تھو شریک ہودی ہأسید دَ ہے تُھن بَھئی تھی۔ آں اللہ پأنَدو تباہ کوؤ والا اصلاح کوؤ والا ما۔ آں کو نِمادوشُوو اللہ خامخا تھو تکلیف می تھلنین دے۔ بےشکہ اللہ غالب تُھو حکمت والا"۔
آں نکاح نہ کوا مشرک جوئی آ سید، کھیدیخانگے ایمان نہ آنودوو۔ آں گُلأم مومن چَیر غورہ چھی مشرک جَوئی ما، کو سے (چیر ہُم) تُھن خوش چِھیو۔ آں نکاح نہ کوا مشرک ماݜ آ سید کھیدیخانگے ایمان نہ آنودوو۔ آں ایماندا غلام چَیر غورہ تُھو مشرک ما، کو ہے (چیر ہُم) تھیئے غورہ معلوم ہودُوو۔ ہے خلک نِمادی آنگا سی دِشکے، آں اللہ ہاگادُو جنت سی دِشکے، آں بوگوشو سی دِشکے تنو حُکم دے۔ آں سے بیان کودُو آیات خلگا سی کأ، مِسی کأ ہے خونا گھینن۔
(خلک) توَس کودی تھأما ماہواری سی بارہ می۔ بَن: "ہے پلیتی چھی، ڈھأر کے ہوا تھو جوئی آ ما ماہواری سی حالت می۔ آں نھیئی نہ ہوا کھیدیخانگے ہے پاک (نہ) ہوئیدیو۔ کے یأ پاک ہوئیو ہے بھی ہین کأن گے بژا، کھأکأ یأ اللہ حکم کِیدُو تھوئے۔ بےشکہ اللہ خوشادُو توبہ کوؤ والا، آں خوشادُو تھأ خلک یأ اَمن پاک ساتَدی"۔
تُھن ڇھی تُھن کأ بُھوم تھی، دَ تھو تنو بُھومائے کھأکأ نِمادیو بژا، آں موٹھائے پیا تھو (نیگی) تنو کأ۔ آں بِھیا اللہ ما، آں اَمن جَنا، بےشکہ تھوئے ملاقات کونین تیسید۔ آں زیرے دا ایمان والائے۔
آں اللہ (سی نام) تنو قسم آ سی کأ بھان نہ سَوا، بنے تھو نیگی سی کأ آں پرہیزگأری آں خلگا سی مِیئے روغہ کوؤ ما قلار ہوا دا۔ آں اللہ بُھویو والا، پوھہ تُھو۔
اللہ تھو تُھن ہأئیمُو قسمہ می نہ گݜَدُو، اَسے تُھن تھأ قسمہ می تھو گݜَدو کا یأ تھو حی سی ارداہ دے کھادی دا۔ آں اللہ بوگوشُو والا، صوو والا تُھو۔
کآم خلگے یأ تنو ڇھی آ سی کأش کے نہ بژوُ سی قسم کھوؤدُوو، تھین کأ چؤ ماہ آ سی نیٹا تُھو، دَ ہے تنو قسم پھرأدے واپس ہُوئیو بےشکہ اللہ بوگوشُو والا مہربان تُھو۔
کو ہیئے طلاق سی پوخ ارادہ کیژیو بےشکہ اللہ بُھویُو والا پوھہ تُھو۔
آں چھوئیل جوئی ڇا ماواری آ پورے اَمن (بیوا ما) کَھمن، آں جائز نہ تُھو ہین کأ یأ بُورن کا یأ پیدا کیدو اللہ ہین ڈھے آ می، کو ایمان لردی اللہ زید آں آخرت سی دی زید۔ آں تھین کھمن زیات حقدار تھی ہین واپس اَنو سی، مے مُودا می کو ارادہ لرَدی ہے اصلاح سی۔ آں ڇِھی آ سی (ماݜ آ زید) تھامُو حق تُھو غورہ طریقہ دے کھأکأ یأ (ماݜ آ سی) ڇِھی آ زید حق تُھو۔ آں ماݜ آ سی کأ ہأزید درجہ (بھا) تُھو۔ آں اللہ زوروڑ تُھو حکمت والا۔
طلاق دُو پَیرائے (ہوؤ پکار) تُھو۔ بھی (یا دا) اَمن سید ساتُو تُھو غورہ طریقہ دے، یائی چھوؤ تُھو شِیژو طریقہ دے۔ آں تُھن کأ جائز نُو تُھو تھوئے کا دیدتُو دا تھأئے تیس تھأما (طلاق سی بدل می واپس) گھینا، ہاں کو دُوںئیدے بھیدی یرأ اللہ سی (پشیل) سیم قائم نہ سات بھانین (تے حالت می واپس گھینا)۔ بھی کی گناہ نُو تُھو تھأزید کو تھوئے أ بھیت چھی یرأ ہیئے اللہ سی (پشیل) حد آ می نہ دَھر بھانین۔ تِسمی ڇھی معاوضہ دو (اَمن لھاسُو سی کأ)، ہے اللہ سی (پشیل) سیم تھی اِسمی زیاتیئی نہ کوا۔ آں کی یأ زیاتیئی کیو اللہ سی سیم آ می، ہے خلک خاص ظألم تھی۔
بھی کے (یأ ڇُوئی) طلاق دید ایسکے، تَھلا تِسما بعد تی (جوَئی) تِسی کأ حلال نہ ہونین، کھیدیخانگے نکاح نہ کیدُوو دُوئی (کھمن) سید۔ بھی کے تی ہُم طلاق دیدو تھلا کی گناہ نہ تُھو تھأ دُوںئی آ زید یرأ ایکدیئے واپس ہودیو، (ہاں مھیرے) کو ہأئے یقین اَشُو کہ ہیئے دوںئے اللہ سی حدُود قائم ساتنین۔ آں ہے اللہ سی سیم (حدود) تھی، بیان کودُو سے تھأ خلگا سی کأ یأ سے جنَدی۔
آں کے یأ تھوئے ڇھی آئے طلاق دید، بھی سے تنو عدت کے آوئیو، دَ تھأ ساتہ غورہ طریقہ دے یا چھوا غورہ طریقہ دے، آں تھو ہین تینگی کوؤ سی کأ نہ کھما یرأ ہأزید سختی کوا۔ آں کی یأ مھاموڑ کی دَ تی ظلم کی اَمن زید۔ آں اللہ سی آیادے ما ٹوقے نہ سَوا۔ آں اَمن زید اللہ سی نعمت یاد کوا، آں تھوزید کتاب آں حکمت سی کامے بأت یأ تِیما تُھن نصیحت سی کأ نازل کوا گئیدی دا، تھأ (یاد کوا)۔ آں بِھیا اللہ ما، آں اَمن جَنا، بےشکہ اللہ ہر شیئی زید پوھہ تُھو جَنُو والا تُھو۔
آں کے یأ تھوئے جَوئی آ ئے طلاق دید، آں سے تنو عدت (سی ختم ہوؤ) گے اَوئیو، تھأ مے بأت ما نہ کھما یرأ سے تنو مُوشوک کھمن آ سید (دُووار) نکاح کوئن، مے شرطے دے یأ سے ایک دوئی ما راضی ہوئیدی۔ مھأ بأدا سی نصیحت تھو می تھأ خلگائے کوا بَژئی کآم یأ اللہ آں آخرت سی دی زید ایمان لرَدی۔ اَںئی أ تُھن کأ چیرے شیژو آں پاکیزہ طریقہ تُھو، اللہ ئے پتہ چھی آں تھوئے پتہ نی چھی۔
آں یئی تنو لَؤ آ زید دُو کال پورا ڇھی پَیئن، (ہے معیاد تھین کأ تُھو) کآم یأ ڇھی پیؤ سی مُدا پورا کوؤ نِمادی۔ آں بوب زید واجب تُھو یرأ سے غورہ طریقہ دے ہأ (یئی آ سی) کھوؤ و جامہ سی خرچہ بھا کوئے۔ یسکے ہُم تِسی وَس ما زیات تکلیف دیا نہ بژے۔ نأ دا یئی تنو لَؤ سی وجہ دے تینگی کوا بژے، نأئی باپ تنو لَؤ سی وجہ دے۔ آں اَںئی ہأل(ذمہ واری) وارث زید ہُم چھی۔ بھی لَؤ سی (یئی و باپ) ایک دوئی سی رضا دے آں مشورہ دے (دو کالہ سی لھنگُو ما مُوش) ڇھی چھوؤ نیموؤسأدو اِسی ہُم تھوزید کی گناہ نُو تُھو۔ آں کو تھوئے میس نیماد یرأ تنو لَوائے (دوئی جَوی سی) ڇھی پیوؤسأدو تھوزید بھی ہُم کی گناہ نُو تُھو، البتہ تھوئے کامیک میزدی مقرر کی شیدا تیس غورہ طریقہ دے دا۔ آں اللہ ما بھیا آں غورا کیدے اَمن شیدا یرأ اللہ تُھن ٹول کَم غورا کیدے پَشَدُو۔
آں تھوما کآم خلک مُوئی آں تنو ڇھی چھیدے گئیو، دَ سے ڇھی دَش دِی و چَؤ ماہ اَمن (بیوا ما) کھمَن۔ بھی کے یأ سے تنو (عدت سی) میعاد کے اَوئیو، تھیئے تنو بارہ می کا ہُم کام (مثلاً دھویم نکاح) قاعدہ سی مطابق کِیو تھوزید کی گناہ نُو تُھو۔ آں کا ہُم تھو کوؤسأدو اللہ تیما پورا پورا شِید تُھو۔
آں (عدت سی دوران) کو تھوئے ہأ جَوئی آئے اِشارہ دے نکاح سی پیغام دِت، یائی حی می بورأدے ساتوو تھوزید کی گناہ نُو تُھو۔ اللہ ئے پتہ چھی یرأ تُھن حی می تھین خیال ینین۔ اَسے نکاح سی بیریت وعدہ نہ کوا، تے وخا پورے یأ مناسب طریقہ دے بات نی ہیژیو۔ آں نکاح سی بأت سی تے ساعدا پورے پوخ کوؤ سی ارداہ ہُم نہ کوا کھیدیخانگے عدت سی مقرر کوئیل مُدا تنو معیاد کے نہ اَوؤدُوو۔ آں یاد ساتا کائی تُھن حی آ می تُھوو اللہ ئے تِسی غورا کیدے پتہ چھی، بس تیما بِھیت کوا یا۔ آں یاد ساتا یرأ اللہ چَیر بوگوشُو والا چَیر برداشت کوؤ والا تُھو۔
آں تھوزید مے بأت می ہُم کی گناہ نُو تُھو یرأ تھو تھأ جَوَئی آ ئے طلاق دا یأ تھوئے مھیدیخانا پورے ہات نھیئی نی کیدو، یا تھین کأ مَہر مقرر نی کیدو۔ آں (مھال صورت می) تھأئے کآں ڈالی دا، مالدا ماݜ تنو حیثیت سی مطابق آں غریب تنو حیثیت سی مطابق غورا طریقہ دے ڈالی دو، ہے نیک خلگا زید لازمی حق تُھو۔
آں کو تھوئے تھأئے طلاق دِید تھأئے ہاتھ نھیئی کوؤ ما مُوش، آں تِھین کأ (نکاح سی ساعت می) مہر مقرر کِیشو تِسی اَر دیوؤ (واجب تُھو)، اَسے کو تھیئے جَوئیے رعایت کِیو (آں کو اَر سی ہُم مطالبہ نی کیو)، یا سے (کھمان) کسی ہاتھ می نکاح سی گان چھی سے رعایت کوئے (آں پورا مہر دو). آں کو تھوئے رعایت کِیو ہے بات تقوی ئے چیرے نھیو چھی۔ آں ایک دوئی زید احسان سی کوؤ نہ آموݜا۔ کا عمل یأ تھو کودی دا اللہ یقیناً تیس پشَدو۔
بُٹ نِماز آ سی پورا پورا خیال کوا، آں ( خاص طور تے) مئیمو سی نماز سی، آں اللہ سی مُوش ادبے دے فرمانبردار ہیدے اِڑی ہوا۔
آں کو تھوئے دشمن سی بِھیت ہِیو اِڑی ہویل یا سورلی سی حالت می (نماز گوزا)۔ بھی کے یأ تھو اَمن گے ہوئیو اللہ سی ذکر مھاموڑ کوا کھأکأ یأ تی تھوئے ڇِھیڙادتُو، کِما یأ تھو مُوش شید نہ اَشِئی۔
آں تھومی کامے خلک موئی آں تنو پأشکے ڇھی چھوئی، دَ سے تنو ڇِھی آ سی حق می مے وصیت کیدے بَژن یرأ اے کال آ پورے سے (میراث ما خرچہ گھینو سی) فائدا گِھنن، آں تھأ (کھمن سی شِیر ما) نِگھالا نہ بژنین۔ ہاں کو سے أمینے نِگھأت دَ تنو حق می قاعدا سی مطابق سے کا کام ہُم کوؤ سأدو تھوزید تِمی کی گناہ نہ ہونین۔ آں اللہ اقتدار والا ہُم تُھو آں حِکمت والا ہُم۔
آں طلاق دئیل ڇِھی آ ئے قاعدا سی مطابق فائدہ سی دیؤ متقی آ زید تھین حق تُھو۔
اللہ تنو احکامات اَںئی ہامُوڑ وضاحت دیدے تھوئے بیان کودُو، مِسی کأ یرأ تھو عقل ما کام گھنا۔
تھیئے تھأ خلگا سی حال معلوم نہ ہوژی کآم یأ تنو شِیرے ما مئیک ما بچ ہوؤ سی کا نِگھأدیشی آں سے ذر آ سی لیک می اَشِئی؟ بس اللہ تھأئے بنو مُوا، بھی تھأ جینی کی، حقیقت أ چھی یرأ اللہ خلگا زید چَیر فضل کوؤ والا تُھو اَسے اکثر خلک شکر نو کودی۔
آں اللہ سی پن می لات کوا، آں یقین کوا یِرأ اللہ غورا کیدے بُھویو والا، آں غورا کیدے شِید تُھو۔
کآم تُھو یأ اللہ ئے غورا قرض دو، مھامھو یرأ سے تیس تِسی کأ چیرگن چیری کوئے؟ آں اللہ تَنگی اَندُو، آں اَںئی سے فراخی اَندُو، آں اَںئی تِسی دِشکے تھوئے واپس نَژا بژنین۔
کئی، تھیئے موسیٰؑ ما بعد بَنی اسرائیل سی ٹولگی سی تے واقعہ سی پتہ نہ گھیڑی، کے یأ تھیئے تنو اے نبی ئے بنُوشُو یرأ "مھو زید اے باچا مقرر کو مِسی کأ یرأ مھو اللہ سی پَن می لات کیئی؟"، نبی بنو: "ہوبھادُو تھوزید لات فرض ہِیو تھو لات نہ کوا؟"، تھیئے بنو: "مھوئے کژَل ہیژی یرأ مھو اللہ سی پَن می لات نہ کیئی، حال أ چھی یرأ مھو تنو شِیرے ما نِگھالا گئیدی، آں تنو لَؤے ما دِھی کوا گئیدی؟"، بھی کے یأ تھأزید لات فرض کوا گأ دا، تھیئے ما دھأک خلک چھیدے دأل ٹول پِٹ کیدے ڈیئی، آں اللہ ظألیمے ما غورا کیدے شِید تُھو۔
آں تھین نبی تھأئے بنو: "اللہ تُھن کأ طالوت باچا سیوأدے پیوؤدُو"، تھیئے بنو: "ایسکے مھوزید بأچیئی سی حق کھیدا آپ؟ مھو اِسی مقابلہ می بأچیئی سی چیرے حقدا تھی، ایسکے دا مال سی زیات والے ہُم دِیا نہ گیژی؟"، تی (نبی) بنو: "اللہ ایسکے تھوزید گھینیئی دیدے کارودُو، آں ایسکے علم آں بدن می (تھوما) زیات گھناچا دِیدتُو۔ آں اللہ تنو بأچیئی کیسکے نیموؤسأدو دیدُو۔ آں اللہ فراخی والا آں گھن علم لَرو والا تُھو"۔
آں تھأئے تھین نبی (میس ہُم) بنُوشُو یرأ: "طالوت سی بأچیئی سی نَخ أ تھو یرأ تھوئے تی صندوق (واپس) ینین کامیک می یأ تُھن پروردگار سی دِشا (حِی آ سی) دَمہ چھی، آں موسیؑ و ہارونؑ سی چھویل شیئیے ما کآں دھریل شیئی ہُم تھی، تیس (صندوق) مُلیکائے گِھندے ینین۔ اِسمی تُھن کأ گھن نَخ تُھو کو تھو ایماندا تِھیو"۔
تَھلا کے یأ طالوت لخکر سید روان ہُو دا، تی بنو: "اللہ اے نھید سی ذریعہ دے تُھن امتحان گِھنُو والا تُھو۔ کامے ماݜ تے نھید ما اُو پُوو تی مھی ماݜ نہ ہونین، آں کی ایس نہ چکُھوو تی مھی ماݜ ہونین، اَسے کو یی أمیل ڈک کیدے پُوو (تیزید کی جرم نُو تُھو)۔" بھی (أ ہو کہ) تھیئے ما دھأک خلگے ما علاوہ دأل ٹولے تے نھید ما اُو پُو۔ بھی طالوت آں ایمان لَرو والا نھید تے لھنگئی، دَ تھیئے خلگے (کی یأ طالوت سی حُکم نہ مَنوشُو) بنو: "آش جالوت آں تِسی لشکر سی مھو می مقابلہ سی کی طاقت نی چھی"۔ (اَسے) کامے خلگا سی مے بأت زید ایمان اَشُو یرأ سے اللہ سید میلاؤ ہوؤ والا تھی، تھیئے بنو: "اکثر لیؤ ٹولگی اللہ سی حُکم دے گھین ٹولگی آ زید زوروڑ اَئیدی۔ آں اللہ تھأ خلگا سی سأت تُھو کآم یأ صوو ما کام گِھینَدی"۔
آں کے یأ خلک جالوت آں تِسی لخکر کے مُخامخ اَئی دا تھیئے بنو: "اے مُھن پروردگار! مھو زید صوو مُوژا، آں مُھن جَنگ کٹھین کو، آں مُھن اے کأفر قوم سی مقابلہ می مدد کو"۔
بس تھیئے اللہ سی حُکم دے تھأئے لَرَئی دِید، آں داؤدؑ جالوت موؤ، آں اللہ تیسکے بأچئی آں ہُشاتوپ دِید، آں کھیدیک اللہ نِیماد تا، تے علم تیسکے دید۔ آں کو اللہ یام خلگا سی ذریعہ دے دأل خلک دِھی نی کِشیو دھیرین می چَیر فساد ہونیندے، خو اللہ ٹول جھان آ زید فضل کوؤ والا تُھو۔
ہے اللہ سی آیت تھی یأ مھو چھی مُوش صحیح صحیح بیندے بُھوژادی۔ آں تو بےشکہ تھأ پیغمبر آ می تُھو یأ سے رسول سوأدے پیا گئیدی۔
أ پیغمبر یأ پیا گئیدی دا، گھینیئی دِیدچی مھوئے اے پیغمبر کے دُوئی زید۔ زینی (رسول) ہأمی سے تھی کی بأت کیدی اللہ سید، آں زینی تھأمی (سے تھی) تھین درجہ اُچات کیدی۔ آں مھوئے مریمؑ سی پو عیسٰیؑ ئے معجزہ دیدتُو، آں مھوئے تِسی روح القدوس تے مدد کیژی۔ آں کو اللہ نیمادوشُوو ہیئے ما پیأش سی خلگے روخانہ دلائل ییؤ ما بعد ایکدوئی سید لات نو کونیندے۔ اَسے تھیئے اختلاف کی، زینی تھأمی سے اَشِئی یرأ ایمان اَنو آں زینی تھأمی کأفر ہوئی۔ آں کو اللہ نیمادوشُوو ہیئے ایکدوئی سید لات نہ کونیندے، اَسے اللہ تیس کودُو کا یأ سے نیمادُو۔
اے ایمان والا ہانا! خرچ کوا اللہ سی پَن می تے مال ما کامیک یأ مھوئے تھوئے دیدچی دا، (مے کام کوا) تھوزید تے دی سی ییؤ ما مُوش، کے نأ گھینُو بِگینُو ہونین، آں نأ یاری دوستی ہونین، آں نأ سفارش ہونین۔ آں اَںئی سے ظألم تھی کآم یأ کأفر تھی۔
اللہ سے تُھو، تیما علاوہ دُوئی یام خُدا نُو تُھو، سے (ہمیشہ ہمیشہ سی کأ) جَن تُھو، آں ٹول (کائنات سی) سَمبال کوؤ والا تُھو۔ تیس کے نأ گِھیل یےیی نأ نین یےیی۔ (ہر کی) تِسی تُھو کا یأ آسمانا می تُھو آں کا یأ دھیرین می تُھو۔ تِسی اجازت ما بغیر کآم تُھو یأ تیسکے یسی سفارش کوئے؟ سے جنَدو کا یأ ہین مُوش ہودُو دا آں کا یأ ہین پأش ہودُو دا، آں سے احاطہ نو کوبھادی کی شیئی سی تِسی علم ما بغیر، اَسے کا یأ سے نیمادُو دا۔ تِسی کرسی آسمان آں دھیرین گیر کیدی، آں ہأ دُوںئی آ زید نظر ساتُو تیس کے کی بُوکھو نُو تُھو۔ آں سے چَیر گھن اُچات درجہ سی ذات تُھو۔
دین سی اَندرے کی زبردستی نی چھی۔ بےشکہ ہدایت اَخکارہ چھی گمراہی ما۔ دَ کی یأ شیطان سی انکار کیدے اللہ زید ایمان اَنُو، دَ بے شکہ تی مھال مضبوط کُنڈا گات یأ تِسی پھورُو نُو تُھو۔ آں اللہ بُھوژو والا، جَنُو والا تُھو۔
اللہ تھأ خلگا سی سأت تُھو کی یأ ایمان اَنو۔ سے تھأ نیگھالَدُو أنٹأم ما لوش سی دِیش کے۔ آں کآم یأ کأفر تھی دَ سے سأت تھی شیطان سی۔ سے (شیطان) تھأ نیگھالَدُو لوش ما أنٹأم سی دِش کے۔ ہُم أ خلک تھی آنگا سی اندرے دھرو والا؛ ہیئے تِسی اَندرے ہَمیشہ ہونین۔
کئی تأ تے ماݜ کے خیال کیشُو کآم یأ مارَزا کوؤدود ابراہیمؑ سید تِسی رَب سی بارہ می، کیسکے یأ اللہ بأچیئی دیدیشی دا؟ کے یأ ابراہیمؑ بنو: "مھی رَب تا سے تُھو کآم یأ جینی کودُو آں مادُو"، دَ تی بنو: "آ (ہُم) جینی کودُو آں مادُو"، دَ تیسکے ابراہیمؑ بنو: "بےشکہ اللہ سی نُوخین ما سی نِگھالَدُو تُو ایس سی بژین ما نگھال"، دَ سے کأفر ایزید ہاک پاک ہیدے گا، آں اللہ ظألم خلگائے پان نہ پشادُو۔
یا تے ماݜ (سی مثال) یأ سے اے گام دے گا، سے (گام) لار گوشُو تنو چَتا زید، دَ تی بنو: "اللہ مھأ ہین مئیک ما بعد کھأکأ جینی کونین؟" بھی اللہ تیس کے مئیک دید پاںئی بیش کالہ سی کأ؛ بھی (اللہ تیس دُوآر) جینی کی۔ بنو: "کھیدیک مودہ تَھلُو تأ؟" تی (ماݜ) بنو: "اے دی سی مُودہ تَھلُو یائی دی سی دھأک حصہ"۔ اللہ بنو: "تأ پاںئی بیش کال مُودہ لنگھاد۔ بھی بُو تنو ٹِگون گے آں تنو اُوئے؛ اِسخا نہ ہوئی دی (وخ سی لھنگو دے)، آں تنو گھودوئے بُو؛ اِسی کأ یرأ مھوئے تھأما خلگائے (عبرت سی) نَخ سَوانین۔ آں بُو اِسی ہَر آ ئے، کھأکأ ہأ بھی مھو ایپود کودی، تیزید ماس (سی کوژو) لھیادی"۔ بھی کے یأ تیسکے واضحہ ہُوو تی بنو: "آ جَنودُو، آں بےشکہ اللہ ہر شیئی زید قدرت لردُو"۔
آں کے یأ ابرہیمؑ بنو: "اے مھی پروردگار! مھیئے پَشا دا تُو کھأکأ مئیل جینی کودُو؟" (اللہ) بنو: "کئی چھی یقین نُو تُھو؟" تی بنو: "کئی نأ، اَسے مھی حی تسلی ہوئے"، (اللہ) بنو: "تَھلا گݜ چَؤ پیݜین، بھی تھأ امن سید آشنا کو۔ بھی (ذبح کوؤ ما بعد) ہر کھن زید تھیئے ما اے ٹوٹا تھا؛ بھی آواز دے، دَ تھیئے چھی دِشکے دھأئیں دین یے نین۔ دَ بھی پوھہ ہو یرأ بےشکہ اللہ غالب تُھو، حکمت والا تُھو"۔
کآم خلک یأ اللہ سی پَندے تنو پَیس پَھرادی، تھین (مال سی) مثال اے کُل سی تھُو یأ تیما سات ݜِݜ نُخَن؛ آں ہر اے ݜِݜ پاںئی بیش کُل گݜے۔ آں اللہ کِس کے نیمؤسأدو (تِسی مال) چَیری کودُو۔ آں اللہ کولاؤ کوؤ والا، جَنُو والا تُھو۔
کآم خلک یأ اللہ سی پَندے تنو پَیس پَھرادی، بھی پَھرؤ آ بعد نأ (یزید) مُلازہ گئیادی نأئی کی زَلل آوادی، تھین اَجر تھین پروردگار کیش تُھو، تھأئے نأ کی بِھیت ہونین نأئی تھیئے غمجن ہونین۔
نرم بات کوؤ آں معافی سی کوؤ غورہ تُھو تے صدقہ ما یأ تیزما بعد خپا کوؤ ہُوو، آں اللہ بے پرواہ آں صوو کوؤ والا تُھو۔
اے مومن ہانا! خراب نہ کوا تنو صدقہ یادوؤ دے آں تکلیف سی اَوؤ دے، تے ماݜ سی چھلے یأ خرچ کودو تنو مال خلگا سی پَشوؤ سی کأ، آں نأ ایمان اَندو اللہ زید آں نأئی اخرت سی دی زید۔ بھی تِسی مثال (أ تُھو یأ) اے پِشیل چأل زید سُم تُھو، تیزید تیز ھاگا موژے، بھی کوئے تیس بالکل صفا۔ نہ گھین بھادی کی ثواب تے شیئی ما کا یأ کیدا۔ آں اللہ ہدایت نہ کودُو کأفر قوم گے۔
آں کآم خلک یأ تنو مال اللہ سی رضا سی کأ آں تنو حی آ سی پیگی کوؤ سی کأ خرچ کودی، تھین مثال مھامُوڑ تُھو یأ اے باغ اُچات پوت زید تُھو، تیزید تیز آگھا ہُوو تی دُوگُن میوہ دینین۔ آں کو تیز آگھا نُو ہُوو صرف پرخہ ہُم تِسی کأ پورا چھی۔ تھو کا یأ کودی اللہ تیس څارَدُو۔
کئی تھوما یام مھامُو خوشادُو یرأ تِسی خُرما و دَݜ سی اے باغ ہوئے، تِسی ٹین نھید ڈلَن آں تِسی کأ تیمی ہر قسم سی میوہ ہوئن؟ آں تیزید ڈھگاچا یو، آں لؤ تِسی لا کمزور ہون، بھی (اچانک) آنگا سی اے طوفان دے سے دھیژتے پُھش ہوئے۔ اللہ مھامُوڑ تُھن کأ تنو آیات کولاؤ کولاؤ بیان کودُو یرأ تھو پِھگر کوا۔
اے ایمان والا ہانا! تھو صدقہ کوا صفا شیئیے ما کا یأ تھوئے گھڑودُو، آں تے مال ما کا یأ نِگھالُودو مھوئے تُھن کأ دھیرین ما۔ آں مھال بیکار شیئی سی خرچ کوؤ سی اِرادہ نہ کوا یرأ (تیس تھوئے یی دیدو) تھوئے أمیدے تیس نی گِھنین اَسے أݜی بان کیدے۔ تھو جَنا یرأ بےشکہ اللہ بےپرواہ، صفت سی لائق تُھو۔
شیطان تھو غریبی ما بھیادُو، آں تھوئے بےحیائی سی حُکم کودُو، آں اللہ تھوسید تنو دِشا مغفرت سی وعدہ کودُو آں تنو فضل سی۔ آں اللہ فراخی سی مالک تُھو، جَنُو والا تُھو۔
(اللہ) کیسکے نیمادُوو حِکمت دیدُو، آں کیسکے حِکمت دِیدو بےشکہ تیسکے چیرگن خیر دیا گا۔ آں خونا صرف عقل سی کَھمن قبول کودی۔
آں کائی تھو دیؤسأدو خیر ما یا تھوئے کی نذر مَنوو، بےشکہ اللہ جنَدُو تیزما۔ آں ظألیما سی یام ہُم مددگار نُو تُھو۔
کو تھو ڈاگا خیر دیدی دَ ہُم غورہ بات چھی؛ آں کو بیریت فقیرائے دیدی دَ ہے تُھن کأ چیرے غورہ تُھو، آں (اللہ ایدے) تھوئے ما تُھن زینی گناہ دھوگو کونین۔ آں کائی تھو کودی دا اللہ (غورا) شید تُھو۔
تھوزید (اے پیغمبرؐ!) تھین ہدایت سی ذمہ واری نی چھی، اَسے اللہ کیسکے نیمؤسأدو ہدایت دیدُو۔ آں کائی تھو دیدی دا مال ما دَ تیس تھو تنو کأ کودی، آں تھو خرچ نو کودی اَسے اللہ سی رضا بیرڑُو سی کأ۔ آں کائی تھو خرچ کودی تنو مال ما تھوئے پورا بدل دیا بژنین، آں تھوزید ظلم کوا نہ بژنین۔
(مال سی خرچ کوؤ) تھأ فقیر آ سی کأ (پکار تُھو کآم یأ) گیر کوا گئیدی اللہ سی پَن می (آں) دھیرین زید سفر سی کوؤ سی طاقت نہ لرَدی۔ سوال ما بچ ہوؤ سی وجہ دے ناواقف (خلک) تھأزید مالدا ہوؤ سی گمان کودی، دَ تھأ تھین موئے ما پأن بھادی۔ سے سوال نوکودی خلگا ما جیئی ہیدے۔ دَ کائی مال ما تھو دِیدی دا بھی بےشکہ اللہ تِسما جَنُو والا تُھو۔
سے خلک یأ صدقہ کودی تنو مال ڙأت کے آں دِیے، بُریل آں ڈاگا - تھین کأ اَجر بھی تھین رَب سی دیشا تُھو، آں تھأزید بِھیت نی چھی، آں نأ تھیئے غمجن ہونین۔
کآم خلک یأ سُود کھادی، تھیئے (قیامت سی دی) تے ماݜ سی شانے اُشنین کیس یأ شیطان تنو ہات ݜژأدے لیونئی کیدُو۔ کئیکہ ہے بَندُود "بےشکہ تجارت (ہُم خو) سود سی شانے تُھو"، حال أ چھی یرأ سوداگری اللہ حلال کِژی آں سُود حرام کیدُو۔ دَ تھلا کِس کے نصیحت اَوئی تنو رَب سی دیشا آں سے (سُود ما) منع ہُوو بھی کائی مُوش ہُودا سے تِسی کأ تُھو، آں تِسی معاملہ اللہ ئے حوالہ ہی۔ آں کآم (خلگے) بھی (سود گھین یا سود) کی، دَ سے دیزوخی تھی، تھیئے تھید مدام سی کأ ہونین۔
اللہ سود برباد کودُو آں صدقہ چیری کودُو، آں اللہ ناشکرا گناہگا (ماݜ) نوخوشادُو۔
بےشکہ سے خلک کی یأ ایمان اَنو آں نیک عمل کی آں نماز گُوزاد آں ذکواۃ دِید، تھین کأ تھین اَجر تھین رَب کیش تُھو، آں تھأزید کی بِھیت نی چھی آں نأئی تھیئے غمگین ہونین۔
اے ایمان والا ہانا! اللہ ما بھیا، آں کائی سود (خلگا زید) دھرودُوو تیس چھوا، کو تھو ایمان والا تِھیو۔
بھی کو تھوئے مے کام نی کیو تَھلا اللہ سید آں تِسی رسولؐ سید لات کے تیا ہوا۔ آں کو تھو توبہ گا ہوئیو بھی تُھن کأ تُھن اصل رقم (تُھن حق) تُھو، نأ تھوئے ظلم کونین، آں نأ تھوزید ظلم کوا بژنین۔
آں کو یام ہاتتانگ تُھو دَ تَھلا مہلت دیؤ پکار تُھو تیسکے ہات سی آزاد ہوؤ آ پورے۔ آں کو تھوئے بوگوشُوو دَ (چیرے) غورہ تُھو تُھن کأ، کو جَنُو والا تِھیو۔
آں بھیا تے دی ما کے یأ تھوئے اللہ ئے واپس کوا بژنین۔ (تے دی) ہر ماݜ کے پورا پورا دیا بژنین کا یأ تی کیدُوو، آں تھأزید زیاتئی کوا نہ بژنین۔
اے ایمان والا ہانا! کو تھو ایکدی سید قرض سی بارہ می مقرر نیٹا آ پورے معاملہ کودیو تیس لیک می آنا۔ آں پکار تُھو یرأ لیگُو والا تُھن مِیئے انصاف تے لیگے۔ آں لیگُو والا لیگُو ما انکار نہ کوئے۔ کھاموڑ یأ اللہ تیسکے (لِیگُو) پشادتُو تھامُوڑ سے لیگے۔ آں بھی اِملا کوئے سے ماݜ کیزید یأ قرض تُھوو۔ آں اللہ ما بھئیے یأ تِسی پروردگار تُھو، آں (لیگُو می) کی ہُم کم نہ کوئے تیس ما۔ بھی کو سے ماݜ کیزید قرض تُھو دا بے عقل یا کمزور تُھوو یا طاقت نہ لردُو اِملا سی بنو سی، دَ اِملا بَنے تِسی ولی انصاف تے۔ آں گواہ گݜا دُو تنو ماݜ آ ما۔ بھی کو نہ اَشِئیو دُو ماݜ دَ اے ماݜ آں دو جوَئی ہون تھأ خلگا ما یأ تھو تھأزید راضی تِھیو گواہ ما، مِسی کأ یرأ اَموݜا گاو دَ دُوئی تیسکے یاد کوئے۔ آں انکأری نہ ہوئے سے گواہ کامے وَخ می تھأ نیمأدو۔ آں لیگُو می سستی نہ کوا کو سے معاملہ لیؤ چھی کو گھین چِھیو تِسی نیٹہ آ پورے۔ تُھن أ کام چَیر انصاف سی تُھو اللہ سی نیز می، آں صحیح ساتُو والا تُھو تُھن گواہی سی کأ، آں چَیر نھیو تُھو مِسی کأ تھو شک می نہ ہوا۔ ہاں کو أ تجارت نقد لین دین سی چھیو تُھن مِیئے دَ اِسی نی لیگُو می تھوزید کی گناہ تُھو۔ آں گواہ گݜا کو تھو (ایکدی می) سودا کودیو۔ آں نأ تکلیف دیا بژے لیگُو والائے آں نأ گواہ ئے۔ آں کو تھوئے مھاموڑ کِیدُوو بھی بےشکہ ہے گناہ تھو تھوزید۔ آں بھیا اللہ ما۔ آں اللہ تھو جَنادُو۔ آں اللہ ہر شیئی ما جَنُو والا تُھو۔
آں کو تھو سفر می تھی آں نہ پات تھوئے لیگو والا، دَ بوتا سی شیئی قبضہ می دا۔ بھی کو تھوئے اِتبار کی تھوئے می (ایک) دوئی زید، تَھلا پکار تُھو کیزید اِتبار کوا گادُو دا سے اَمانت دو، آں بھیئے اللہ ما یأ سے رَب تُھو۔ آں تھو گواہی نہ بُرا، آں کی یأ گواہی بُورأدو بےشکہ تِسی حی گناہگا تُھو۔ آں اللہ کا یأ تھو کودی دا تِیما غورہ جَنُو والا تُھو۔
(ہر کی) اللہ سی تُھو، کا یأ آسمانا می تُھو آں کائی دھیرینے تُھو۔ آں کا تھو اخکارہ کودی کامیک یأ تُھن حی آ می تُھو یا بُرادی تھو، اللہ تھوزید تِسی بارہ می حساب کونین۔ بھی معاف کونین تیس کیسکے یأ نیمادو، آں عذاب دینین کیس کے نیمادو۔ آں اللہ ہر شیئی زید قدرت لَرُو والا تُھو۔
رسولؑ ایمان اَنو کا یأ نازل کوا گا تیزید تِسی رَب سی دیشا، آں (تیسیت) ٹول مومینے ہُم۔ ہر ایک ایمان اَنودُو اللہ زید آں تِسی مُلیکا آ زید آں تِسی کتاب آ زید آں تِسی پیغمبر آ زید، (میس بنین): "مھو فرق نہ کودی ایک می ہُم تِسی رسولا می"، آں تھیئے بنو: "مھوئے بُود آں مھوئے منُو۔ اے مُھن پروردگار! مھو بوگوشُو نیمادی تھأما، آں چھی دِشکے واپس بَژو تُھو"۔
اللہ یسکے ہُم تِسی طاقت ما زیاد ذمہ واری نے دیدُو۔ کی کا (نیک عمل) کِیو تِسی فائدہ تیسکے تُھو، آں کا ہُم خزا عمل کِیو تِسی نقصان تیسکے تُھو۔ "اے مُھن پروردگار! مھوما کی اَموݜا گاو مھو تیمی نہ گݜ، اے مُھن پروردگار! مھو زید تھال بوج نہ تَھل کھاموڑ یأ تأ مھوما موشِک خلگا زید تَھلُوشُو، اے مُھن پروردگار! نہ تھا مُھن ݜا زید تے شیئی کامیک سی یأ طاقت نی چھی تِسی اُوݜو سی۔ معافی کو مھوئے آں بگوش مھو، آں رحم کو مھوزید۔ تُو مُھن مالک تُھو، کأفر آ سی مقابلہ می مھوئے بَرئی دے"۔
الف، لام، میم (اللہ عالم مھأ حروف آ سی مراد ما)
اللہ (سے ذات تُھو) تِسما علاوہ یام معبود نو تُھو، سے ہمیشہ جَن تُھو ٹول کائنات سی سمبھال کوؤ والا تُھو۔
(اللہ) نازل کیدُو تھوزید کتاب (قرآن مجید) حق زید، سے (قرآن مجید) یأ تصدیق کوؤ والا تُھو مُوٹِھک کتابا سی، آں (اللہ) نازل کیدی تورٰۃ و انجیل۔
(قرآن مجید) ما مُوش (تورٰۃ و انجیل) خلگا سی کأ ہدایت سی ذریعہ آشیئی، آں (اللہ) نازل کی فرقان (حق و ناحق سی مِیئے فرق کوؤ والا قرآن مجید)، یقیناً کامے خلگے اللہ سی آیادا سی انکار کیدُو تِھن کأ سخت عذاب تُھو، آں اللہ زبردست بَدل گھینو والا تُھو۔
«یقیناً اللہ ما کی شیئی ہُم بُوریل نو تُھو، نأ دھیرین می نأئی آسمان می۔
(اللہ) سے ذات تُھو یأ سے (یئی سی) ڈھے می کھأکأ یأ نیموؤسأدو تُھن شکل سَوادو، تیما علاوہ یام ہُم معبود نو تُھو سے زبردست حکمت والا تُھو۔
(اے پیغمبرؐ! اللہ) سے ذات تُھو کہ تی نازل کیدُو تھوزید کتاب، (اے کتاب) سی یام آیت پوخ تھی، تھأزید کتاب سی اصل بنیاد تُھو، آں یام آیت متشابہ تھی (گانگُوڑا تھی؟؟)، بہرحال کامے خلگا سی سینہ می کولاچا تُھو دا سے تابعداری کودی متشابہ (آیات آ سی)، تاکہ سے فتنہ پیدا کوئن، آں ہأ آیادا سی (غلط) تاویل کوئن، حالانکہ ہأ متشابہ آیادا سی صحیح مطلب اللہ یےمعلوم چھی، آں کامے خلک یأ علم می پختہ تھی دا سے بنَدی مھوئے ایمان اَنودُو ایزیت، أ ٹول مُھن رب سی دِشا تُھو، آں نصیحت حاصل نو کودی سیوائے عقل مند خلگا ما۔
اے مُھن پروردگار! کے یأ تأ مھوئے ہدایت کی تیما بعد کیلی نو کو مُھن حی، آں مھوئے عطا کو تُنو دِشا رحمت، بےشکہ تُو ٹولے ما چیر دیؤ والا تُھو۔
اے مُھن پروردگار! بےشک تو جمع کوؤ والا تُھو مھال دِیے کامے دی می یأ کی شک نی چھی دا، بےشکہ اللہ وعدہ خلافی نہ کودُو۔
یقیناً کامے خلک یأ کأفر تھی دا (تے دی) بالکل فائدہ نہ دینین تھأئے تھین مال آں نأ تِھن اولاد اللہ سی مقابلہ می، آں مھیئے خلگے آنگا سی شَلا سَوا بژنین۔
ہین معاملہ تھاموڑ ہونین کھأکأ معاملہ آل فرعون آں آل فرعون ما مُوش خلگا سی أشیدا تھیئے مُھن (اللہ سی کتاب سی) آیات لووال گھنیئ شی، بھی اللہ ہأ گأت (عذاب می) تِھن گناہ آ سی وجہ دے، آں اللہ سی عذاب چیر سخت تُھو۔
(اے پیغمبرؐ) تھو بنا کأفرائے چیر جلد تھوئے مغلوب (لرَئ) ہونین، آں تھوئے جمع کوا بژنین دیزوخ سی دِشکے، آں سے چیر لاݜ پوت تُھو۔
یقیناً تُھن کأ اے نَخ تُھو مھأ دو ڈلہ آ می، کے یأ تھیئے ایکدُو آ سید مقابلہ کیشی دا، ہأمی اے ڈلہ اللہ سی پَن دے لات کوؤدُود، آں دھوئم ڈلہ کأفر آ سی أشی، سے کأفر تُنو أݜی می تنُو اَمن دوگُن پشودُود تھأ (مسلمانے) ما، آں اللہ کیس کے نیموؤسأدو تنو مددیدے بَرئی دیدُو، بے شک مِسمی عبرت چھی پشو والا سی کأ۔
خلگائے شِیژو کوا گودُو خواہشات آ سی مینہ، جوَئی آں لَؤ آں اُوژل زر لَگُھور زر سی ڈھیری، آں نخ ݜژیل گھو آں څاروئی آں بُھوم، أ صرف دونیئی سی سامان تُھو، آں شیِژو دھرُو سی پوت تہ اللہ کیش تُھو۔
تھو بنا (اے پیغمبرؐ!) کہ: آ تھوئے بینی کامے شیئی یأ مھأ ٹولے ما غورا تھی دا؟ تھأ خلگا سی کأ کآم یأ پرہیزگار تھی دا، تھین رب سی خوائے باغ تھی، تِھین ٹیندے نھید جاری تھی ہمیشہ سی کأ، آں پاک صاف شیئی تھی، آں اللہ سی رضا مندی چھی، آں اللہ تُنو بندہ پَشو والا تُھو۔
(اللہ سی خاص بندہ سے تھی) کہ سے بنَدی: اے مُھن پروردگار! بےشک مھوئے ایمان اَنودُو، پس تو مُھن کأ معاف کو مُھن گناہ، آں مُھن حفاظت کو آنگا ما۔
(أ خلک) گھن صوو کوؤ والا، آں سأز بنو والا، آں عبادت گزار، آں ( اللہ سی پَن می) خرچ کوؤ والا، آں پَدبأل سی وخ می معافی نِموؤ والا تھی۔
اللہ أمیدے مے بأت سی گواہی دیدچی کہ تیما علاوہ یام عبادت سی لائق نُو تُھو، آں فرشتہ آں علم والا خلک یأ انصاف زیت قائم تھی، سے ہُم گواہی دیدی کہ تِس ما علاوہ یام ہُم معبود نو تُھو، سے غالب حکمت والا تُھو۔
یقیناً دین اللہ سی نیز می صرف اسلام تُھو، آں اختلاف نہ کیشو اہل کتاب اَسے کے یأ تھأئے علم حاصل ہُو دا، صرف ایک دوئی سی ضد سی وجہ دے، آں کی ہُم اللہ سی آیادا سی انکار کِیو (تِسکے مے بات یاد ساتو پکار چھی) کہ بےشکہ اللہ جلد حساب گھینُو والا تُھو۔
کو بھی ہُم ہے تھیسیت لات کوؤسأدو، تھو بنا کہ مأ آں کی یأ مھی اتباع کِیدا، مھوئے اللہ سی کأ اسلام اَنودُو، آں تھو بنا کِتاب والائے آں ان پڑھ خلگائے، کہ کئی تھو ہُم (اللہ یے) تسلیم ہوئیدی؟ کو ہیئے یأ اسلام اَنُوو بھی دا ہأئے ہدایت میلاؤ ہی، آں کو ہیئے یأ مُو نُڑادو پس تھزیت (اے نبیؐ) صرف پیغام سی اَوؤ اَشو، آں اللہ تُنو بندہ پشُو والا تُھو۔
بےشک سے خلک کآم یأ انکار کودی اللہ سی آیادا سی، آں ناحق پیغمبر قتل کودی، آں تھأ خلک ہُم قتل کودی کآم یأ انصاف سی حکم دیدی، دَ ہأئے دردناک عذاب سی زیرے دے۔
أ سے خلک تھی کِسی یأ عمل ضائع ہوئی دی دونیئی و آخرت می، آں ہین کأ یی ہُم مددگار نہ ہونین۔
کئی تھوئے تھأ خلگا سی دِشکے توجہ نہ کیدُو کیسکے یأ کتاب ما دھأگ شاندہ حصہ دیا گوشُو دا؟ ہأئے اللہ سی کتاب سی دِشکے دعوت دیا بژُودود میلائی سے تُھن مِیئے فیصلہ کوئن، بھی ہُم اے ڈلہ ہیئے ما بود نُڑادے دھأر کے ہی۔
میس ہے (مِسی کأ کوؤدود کہ) ہیئے بنُودود، "دھأک دِیے ما علاوہ آنگا یئت ہُم مھوزیت نہ گھڑبھادُو"، ہأ دوکا وا تھلیئی دی ہین دین سے معاملہ می تھیئے بأدے کامے بأت یأ تھیئے اَمنا سوأدتی دا۔
تھلا تے وخ تِھین کا حال ہونین کے یأ ہأ مھوئے جمع کِیو؟ تے دی یأ کِس می کی شک نی چھی، آں ہر انسان گے پورا پورا دِیا بژنین کا یأ تی گھڑودُو، آں تھأزید کی ہُم زیاتیئی کوا نہ بژنین۔
تھو بنا! اے اللہ! اے بأچیئی سی مالک! تُو کیسکے نیمؤسأدو بأچیئی دیدُو، آں کیس کیژا نیمؤسأدو بأچیئی گھیندُو، آں کیسکے تُو نیمؤسأدو عزت دیدُو، آں کیس تُو نیمؤسأدو ذلیل کودُو، ٹول خیر چھی ہات می تُھو، آں بےشک تُو ہر شیئی زید قادر تُھو۔
تُو ڙات دی می داخل کودُو، آں دی ڙأت می داخل کودُو، آں تُو بےجان ما جاندار پیدا کودُو، آں جاندار ما بےجان پیدا کودُو، آں کیسکے ہُم نیمؤسأدو بےحساب رزق دیدُو۔
مومِنائے پکار تُھو مومنے ما علاوہ دألا سیت سأتویلی نو کوئن، آں کی ہامُو کیو تِسی اللہ سیت کی تعلق نہ ہونین، ہاں کو تُنو حفاظت سی کأ کی طریقہ کیو (ہے جائز تُھو) آں اللہ تھو تُنو (عذاب) ما بھیادُو، آں اللہ سی دیشکے ٹولائے بژو تُھو۔
تھو بنا (اے پیغمبرؐ!) کہ تُھن حی آ می کا ہُم تُھو دا، کو تھو ایس بُورا یا ظاہر کوا، اَسے اللہ تیس جندُو، آں اللہ یے دا تِسی ہُم علم تُھو کا یأ آسمانا می تُھو آں کا دھیرین می تُھو، آں اللہ ہرے شیئی زید قدرت لردُو۔
(آں تے دی ہُم یاد ساتا!) کامے دی یأ ہر انسان کا ہُم غورا عمل کیشو تیس تُنو مُشکے موجود پانین، آں کا لاݜ عمل کیدُوو ( تیس ہُم تُنو مشکے پانین) تَھلا بھی انسان اَرمان کونین کہ کاش اِسی و اِسی (لاݜ سی) مِیئے کو چیر گھین فاصلہ أشِیو (کا غورا ہو نیندے)، آں اللہ تھو اَمن ما بھیادُو، آں اللہ تُنو بندہ آ زید چیر زیاد مہربان تُھو۔
(اے پیغمبرؐ!) تھو بنا کو تھو اللہ سیت مینہ کودِیو بھی مھی تابعداری کوا، آں اللہ ہُم تھوسیت مینہ کونین، آں تُھن گناہ ہُم معاف کونین، آں اللہ معاف کوؤ والا مہربان تُھو۔
(اے پیغمبرؐ! خلگائے) تھو بنا: کہ تھو تابعداری کوا اللہ آں اللہ سی رسول سی، بھی ہُم کو تھیئے مُو نرادو تھلا یاد ساتا یقیناً اللہ مینہ نہ کودو کأفرا سیت۔
یقیناً اللہ آدمؑ و نوحؑ آں ابراہیم ؑ سی ٹوَر آں عمران سی ٹوَر خوشأدے گھینیئی دیدچی ٹول جہان آ زید۔
(ہأمی) بعض بعضا سی اولاد اَشیئ، آں اللہ بُھویو والا آں جنُو والا تُھو۔
(یاد کوا) کے یأ عمران سی جوئی دعا کی "اے مھی پروردگار! بےشک مأ نذر منودُو کہ مھی ڈم می کا تُھو دا ایس ما ہر کم ما آذاد کیدے صرف چھی کأ وقف کونین، مھی مے نذر قبول کو، یقیناً تُو (دعا) بُھویو والا آں ہر کم ما جنُو والا تُھو۔
بھی کے تِسی سیرأن پیدا ہی دا، تی بنو: اے مھی پروردگار! مھی دا سیرأن پیدا ہی آ، حالانکہ اللہ یے غورہ علم اَشو کہ اِسی کا پئیدا ہُودو، آں پو سیرأن سی شانے نہ ہودُو، آں مأ اِسی نام مریم تھؤدو، آں بےشک آ ایس شیطان مردود ما حفاظت سی کأ چھی پناہ مے دیژی۔
پس مریم ؑ سی ربے بہترین طریقہ دے ایس قبول کی، آں ایس شِیژو طریقہ دے ڙیݜی، آں ذکریاؑ اِسی کفیل سوا گا، ذکریاؑ کے ہُم مریمؑ سی عبادت خانہ می داخل ہوؤدُود تِسی خوائے رزق موجود ہوؤدُود، (اے دی) ذکریاؑ توَس کی: اے بی بی مریمؑ! أ رزق چھی خوائے کھیدا ییژی؟ مریمؑ جواب دید: ہے رزق اللہ سی دِشا ییژی، آں بےشک اللہ کیسکے ہُم نیمؤسأدو بےحسابہ رزق دیدُو۔
تھلا ذکریاؑ تُنو رب ما دعا نیماد: (دعا می میس) بنُو: "مھی پروردگار مھیئے عطا کو تُنو دِشا نیک صالح اولاد، بےشکہ تو دعا بُھویو والا تُھو"۔
فرشتہ آواز دِید تیس کے (ذکریاؑ یے)، کے یأ سے عبادت خانہ می ایڑی ہیدے نماز گوزؤدود، "بےشک اللہ تھیئے زیرے دیدُو یحیٰؑ سی، کہ تی اللہ سی کلیمہ سی تصدیق کوؤ والا آں سردار ہونین، خواہش پرست نہ ہونین، آں نبی ہونین نیکوکارے ما۔
(ذکریاؑ) بنُو: اے مھی پرودگار! مھی پو کھأکأ ہونین، حالانکہ آ ڈھیگی ہودُو، آں مھی جَوئ شأن چھی؟ تیس کے جواب دیا گا: "اَںئی مھاموڑ ہونین، اللہ کا نیمؤسأدو تیس کودو"۔
(ذکریا)ؑ بنُو: اے مھی پروردگار! تھلا مھیئے اے نخ مقرر کو، اللہ جواب دید کہ چھی کأ نخ أ تُھو کہ تأ اشارائے ما علاوہ ڇا دی یسیت ہُم بأت نہ کونین، تُنو رب سی چیر چیر ذکر کو آں ڙاد نأشاما تسبیح بنایے۔
آں (بھی سے وخ آپ) کہ یأ فرشتائے بنُو: اے مریمؑ! بےشکہ اللہ تھأ خوشأدچی، آں تھیئے پاکیزگی عطا کیژی، آں تھأ ٹول جہان سی جَویا زیت خوشأدچی۔
اے مریمؑ! تُنو رب سی تابعدار ہو، آں سجدہ کو، آں رکوع کوؤ والا سیت تو ہُم رکوع کو۔
(اے پیغمبرؐ!) أ غیب سی خبر تھی، کامیک یأ مھو تُھن دِشکے وحی کودی، آں تھو نہ اَشیئ ہین خوائے کہ یأ سے (تیل آ سی پوت) تنُو قلم تھلودُود، مے بأت سی فیصلہ سی کأ یرأ ہأمی کی مریمؑ سی کفالت کونین، آں تھو تے ساعدہ ہُم نہ اَشیئ کے یأ سے ایکدی آ سیت لات کوؤدود تا۔
(تے ساعت ہُم یاد کو) کے یأ مُلیگے مریمؑ گے بنُو: "بےشک اللہ تھیئے تُنو اے کلمہ سی (خاص پو سی پیدائش سی) زیرے دیدُو، تِسی نام مسیح عیسیؑ بن مریم ہونین، تی دُونیئی و آخرت می مرتبہ والا آں (اللہ یے) نھیو خلگے ما ہونین۔
آں تی بأت کونین خلگا سیت (ییئی سی) مُو مے آں گھین اُمو می ہُم، آں تی نیک خلگے ما ہونین۔
(مریمؑ) بنُو: "اے مھی پروردگار! مھی پو کھأکأ ہوبھادُو کئی کہ مھیئے یی انسان ہُم ہاتھ نہ دیدتُو" (اللہ) بنُو: اللہ اَںئی مھاموڑ پیدا کودُو کیس یے نیمؤسأدو، کے یأ سے (اللہ) کی کم سی کوؤ سی فیصلہ کوؤسأدو صرف مھیدیک بنہ دُو کہ ہو سے کام ہودُو۔
آں تی (اللہ) تیس کے (عیسیؑ یے) کتاب و حکمت آں تورات و انجیل سی تعلیم دینین۔
آں تیس رسول سیوأدے پے نین بنی اسرائیل سی دِشکے، (آں تی (عیسیٰؑ) تھائے بننین کہ) یقیناً آ آپ تُو تُھن خوائے تُھن رب سی نَخے سمانے، کہ بےشک آ پیدا کودو تُھن کأ سُم ما چیریڑ سی شکل، بھی آ تِس می پُھوک دیدُو، سے سوا بژژی اللہ سی حکم زید جأن چیریڑ، آ ساپ کودُو اَن آں ڈَپ، آں آ جینی کودُو مئیل اللہ سی حکم دے، آں آ تھوئے خبر دیدُو کا یأ تھو کھادی دا، آں کا یأ تھو جمع کودی دا تُنو شیرا می، یقیناً مِس می نشانی چھی تُھن کأ کو تھو مومن تھیو۔
آں تصدیق کوؤ والا تُھو کا یأ مھأ ما مُوش نازل ہودُو دا تورات ما، آں مِسی کأ یأ حلال کیئی تُھن کأ کا شیئی یأ تھوزید حرام اَشیئ دا، آں مأ تُھن کأشکے اے نَخ اَنودُو تُھن رب سی دِشا، پس تھو اللہ ما بھیا آں مھی بات مَنا۔
یقیناً اللہ مھی آں تُھن ہُم رب تُھو، بھی تھو تِسی عبادت کوا آں اَںئی أ سیدا پان چھی۔
بھی یأ کے عیسٰیؑ معلوم کی تِھن (بنی اسرائیل آ سی) کفر تھلا بنُو: "کی مھی مدد کونین اللہ سی کأ (اللہ سی دین سی بارا می)"، بنو حواری یے: "مھو مددگار تھی اللہ سی (دین سی)، مھوئے ایمان اَنودُو اللہ زید، آں تھو گواہ ہوا کہ یقیناً مھو فرمانبردار مسلمان تھی"۔
(بھی حواری یے رب سی بارگاہ می مے دعا کی) اے مُھن پروردگار! مھوئے ایمان اَنودُو کا یأ تأ نازل کیدُو دا، آں مھوئے تابعداری کیژی رسول سی، پس مھو لِگا تھأ خلگا می کآم یأ (حق سی) گواہی دیدی۔
آں بھی تھیئے مُکر کی، آں اللہ ہُم تدبیر کی، آں اللہ بہترین تدبیر کوؤ والا تُھو۔
کے یأ اللہ بنُو: اے عیسٰیؑ! آ تھیئے چھی وخ زیت مئیک دیؤ والا تُھو، آں (مھیرے) تھأ تُنو دِشکے اُچات کوؤ والا تُھو، آں آ تھأ پاک کوؤ والا تُھو تھأ خلگا ما کی یأ کفر کیدُو دا، آں کی یأ چھی تابعداری کِیژی تھأ آ غالب کوؤ والا تُھو کأفرا زیت قیامت سی دی آ پورے، بھی تھو ٹولائے مھی کأشکے ییؤ تُھو، بھی مأ تُھن مِیئے فیصلہ کونین، کا شیئی می یأ تھو اختلاف کوؤدود تا۔
پس کامے خلگے یأ کفر کیدُو دا مأ تھأئے سخت ترین عذاب دینین، دُونیئی و آخرت می، آں تِھن کأ یی ہُم نو ہونین مدد کوؤ والا۔
اَسے کی یأ ایمان اَنُودو آں نیک اعمال کیدی تھأئے اللہ تِھن پورا پورا اجر دینین، آں اللہ ظالم آ زید مینہ نہ کودُو۔
میس مھو تلاوت کودی تھیئے آیادے ما، مھأ خبرا سی بارہ می آں حکمت سی نصیحت سی بارہ می۔
یقیناً عیسٰیؑ سی مثال اللہ سے نیز می آدمؑ سی شانے تُھو، تیس (آدمؑ) پیدا کیدُو سُم ما، بھی اللہ بنُو کہ "سَوا بش!"، پَس سے سَوا گا۔
حق چھی رب سی دِشا تُھو، شک کوؤ والا آ ما نہ ہو۔
تھوئے کامے (عیسٰیؑ سی واقعہ سی) صحیح علم میلاؤ ہُودو دا، اِس ما بعد ہُم یام تھوسیت بحث مباحثہ کوؤسأدو تھو (اے پیغمبرؐ!) تھأئے بنا کہ یا! مھو تُنو لَوائے ہاگئی تھو تُنو لَوائے ہاگا، مھو تُنو جَوئی آئے ہاگئی تھو تُنو جَوئی آئے ہاگا، مھو تُنو خلگائے ہاگئی تھو تُنو خلگائے ہاگا، بھی مھو (بُٹ اللہ سی بارگاہ می) دعا کیئی، آں اللہ سی لعنت پیئی لووالا زید۔
بےشک أ سأس قصہ چھی آں اللہ ما علاوہ یام ہُم معبود نہ تُھو آں بےشک اللہ غالب حکمت والا تُھو۔
بھی ہُم کو مھیئے خلگے (عیسائی یے) اللہ ما مُو نرادو دَ اللہ غورہ پأنَدو فساد کوؤ والا۔
تھو بنا: اے اہل کتاب! تھو یا تے بأت سی دِش کامے بات یہ مُھن آں تُھن مِیئے مشترک چھی، (سے بات أ چھی) کہ مھو اللہ ما علاوہ یِسی ہُم عبادت نہ کیئی، آں نأئی تیسیت یام شریک کیئی، آں نأئی مھوئے ما یام یِس رب سَوے اللہ ما علاوہ، بھی ہُم کو سے ڈیئی او بھی تھو بنا "تھو گواہ ہوا بےشک مھو مسلمان تھی"۔
اے کتاب والا ہانا! تھو کئی ابراہیمؑ سی بارا می بحث کودی؟ حالانکہ تورات آں انجیل تیس ما بعد نازل ہوئیدی، کئی تھو نہ جنہ دی؟
کامے بارہ می تھوئے یأ دھأگ علم اَشو دا، تیس می دا تھوئے بحث و مباحثہ کی، اَسے کامے بأت سی تھوئے علم نہ اَشو دا تیس می تھو کئی بحث کودی؟ آں اللہ غورہ جنہ دُو آں تھو نہ جنہ دی۔
نأ دا ابراہیمؑ یہودی اَشو نأئی نصرانی (عیسائی)، اَسے سے سیدا سیدا مسلمان اَشو، آں سے مُشرگے ما نہ اَشو۔
بےشک ٹولے ما زیاد نھیو ابراہیمؑ گے سے خلک تھی کی یأ تِھن تابعداری کیژی، آں أ نبیؐ آں کی یأ ایمان اَنودُو دا (ہے ہُم ابراہیمؑ گے نھیو تھی) آں اللہ ایمان والا سی سأت تُھو۔
آں (مسلمانا ہانا!) اہل کتاب ما ایک ڈلہ میس نِماژی کہ کاش تھو گمراہ ہوأدے، حالانکہ سے اَمن ما علاوہ دوئی یام ہُم گمراہ نہ کوبھادی، اَسے تھأئے احساس ہُم نو تُھو۔
اے کتاب والا ہانا! تھو کئی کفر کودی اللہ سی آیات دا ما؟ حالانکہ تھو گواہ ہُم تھی (کہ ہے حق و سأز تھی)۔
اے اہل کتاب! تھو کئی حق و باطل (ایکدوئی سیت) گڈ وڈ کودی، آں تھو کئی حق بُرادی غورا جیندے ہُم؟
آں اہل کتاب ما اے ڈلہ بنَہ ژی کہ تھو ایمان آنا تے کلام زید کامیک یأ مسلمانا زید نازل ہودُو دا، دی سی شروع می آں نأشاما انکار کوا، آں ہوبھادُو ہے (مسلمان) ہُم تُنو دین ما نُڑن۔
آں تھو بات نہ منا سوائے تھأ خلگا ما کی یأ تُھن دین سی تابعداری کیژی دا، تھو بنا (اے پیغمبرؐ!) کہ بےشک ہدایت تا حقیقت می اللہ سی ہدایت چھی، یرأ ہر کیںس کے سے میلاؤ ہوئے کھال یأ تھوئے میلاؤ ہُوشو دا، یا سے تھوزید غالب یو تُھن رب سی مُشکے، تھو بنا اے پیغمبرؐ! کہ بےشک بُٹ فضل اللہ سی ہات می تُھو، سے کیس کہ ہُم نیمادُوو گھینیئی دیدُو، آں اللہ چیر وسعت والا آں ہر شیئی سی علم والا تُھو۔
اللہ) خاص کودو تُنو رحمت زید کیس نیموؤسأدو، آں اللہ چیر گھن فضل والا تُھو۔
آں کتاب والا آ ما یام مھال تھی یرأ کو تھوئے تھأزید اے ڈھیری مال سی ہُم تھیئی و تھیئے تیس تھوئے ادا کونین، آں یام تھأمی مھال تھی کو تھوئے اے دینار ہُم تھأکیش امانتی تھوؤو تھیئے تیس ہُم تھوئے نہ دینین، سوائے مِسما کہ تھو ایڑی ہوئی تِھن ݜا زیت، ہے مے کام مِسی کأ کودی کہ ہے بنہ دی أمی (عرب سی غیر یہودی) سی مھوزید کی پان نی چھی (کی گناہ نُو تُھو)، آں سے اللہ زید لَوو سوادی، (مے بات) جیندے ہُم (کہ مھو غلط تھی)۔
(کئی گناہ و گݜو نہ تُھو؟ بلکہ) کآم ہُم وعدہ پورا کوؤسأدو آں پرہیزگاری کیو بےشک اللہ مینہ ساتدُو پرہیزگارا سیت۔
یقیناً کامے خلک یأ اللہ سی وعدہ آں تُنو قسم بِگینَدی کم قیمت سی بدلہ می، تِھین کأ آخرت می کی ہُم حصہ نہ تُھو، آں اللہ قیامت سی دِیے نأ ہأسیت بات کونین، آں نأئی تِھن دِشکے بونین، آں نأئی تھأ پاک کونین، آں تِھن کأ دردناک عذاب ہونین۔
آں بےشکہ ہأمی (اہل کتاب) می اے ڈلہ مھال ہُم چھی کہ سے تُنو جِب کیلی ویلی کیدے کتاب (تورات) بنَدی، مِسی کأ کہ تھو گمان کوا کہ ہے کتاب ما تُھو، حالانکہ سے کتاب ما نو ہودُو، آں سے بندی أ سوَخ اللہ سی دِشا تُھو، آں حالانکہ ہے اللہ سی دِشا نو تُھو، آں سے جیندے بھی ہُم اللہ زید لَوو سَوادی۔
آں اے انسان سی کام أ نو تُھو، کہ تیسکے اللہ کتاب یا حکمت یا نبوت دو، آں سے خلگائے بنے تھو اللہ ما علاوہ مھی بَن سَوا بژا، بلکہ تی دا میس بن نین کہ تھو خاص اللہ والا سَوا بژا، (تے کتاب سی مطابق) کامے کتاب یأ تھو ڇھڙادی آں ڇھڙدی دا۔
آں نأئی (أ کی انسان سی کام تُھو) کہ سے حکم دو تھوئے کہ تھو مُلیکا آں پیغامبرا ما خدا سَوا، کئی سے تھوئے کفر اختیار کوؤ سی حکم دیدی تُھن مسلمان ہوؤ ما بعد؟
آں (مھأ اہل کتابائے تے وخ ہُم یاد کوا) کے یأ اللہ وعدہ گِھن تُنو پیغمبرے ما، یرأ کو مأ تھوئے کتاب آں حکمت دِید، بھی تِسما بعد تُھن خوائے پیغمبر آپ، آں سے پیغمبر تے کتاب سی ہُم تصدیق کودُو کامے کتاب یأ تھوکیش تھو دا، تھوئے تیزیت ضرور ایمان آننین، آں ضرور تِسی مدد کونین، اللہ توَس کی: کہ "کئی تھوئے اقرار کی؟ آں تھوئے مھی وعدہ می زمہ واری گِھن؟" (تھیئے ٹول پیغمبرائے) بنو کہ "ہاں مھوئےاقرار کی" (اس ما بعد) اللہ بنُو: "تھو گواہ ہوا، آں آ ہُم تھوسیت گواہ تُھو"۔
مِسما بعد کی ہُم ہدایت ما مُو نُڑادو بس اَںئی ہیئے خلگے نافرمان ہونین۔
کئی سے اللہ سی دین ما علاوہ دوئی دین بِیراڑدی؟ حالانکہ اللہ سی فرمابردار تھی کا ہُم دھیرینے آں آسمانا می تُھو دا، خوشألی دے آں (یا) ناخوشی دے، آں تِسی دِشکے ہأ بُٹ واپس کوا بژنین۔
(اے پیغمبرؐ!) تھو بنا کہ: مأ ایمان اَنودُو اللہ زید آں کا یأ تی نازل کیدُو دا مھوزید، آں کا یأ نازل کیدُو ابراہیمؑ آں اسماعیلؑ آں اسحقؑ آں یعقوبؑ آں تِسی اولاد زید (مھو تیزیت ہُم ایمان اَندی)، آں مھو تیزیت ہُم ایمان اَندی کا یأ تی (اللہ) موسٰیؑ و عیسٰیؑ آں دأل پیغامبرائے دیدتُو دا، مھو تِھن مِیئے کی ہُم فرق نہ کودی، آں ہُم تِسی (اللہ سی) مھو فرمانبردار تھی۔
آں کی ہُم اسلام ما علاوہ دوئی دین اختیار کِیو تیس یئت ہُم قبول نہ کونین، آں تی آخرت می نقصان والا ہونین۔
اللہ کھأکأ ہدایت دینین تے قوم گے کی یأ ایمان ما بعد کفر اختیار کیدا؟ حالانکہ ہیئے مے بأت سی گواہی ہُم دیدچی کہ بےشک أ رسول برحق تُھو، آں ہأئے کولاؤ روخانہ نشانی ہُم أئیشی، آں اللہ ظألم قوم گے ہدایت نہ دیدُو۔
أ ہأ خلگا سی بدل چھی کہ بےشک ہأزیت لعنت چھی اللہ آں مُلیگا سی آں ٹول خلگا سی۔
ہمیشہ ہمیشہ سی کأ اس می ہونین، نأ ہیئے ما عذاب کم کوا بژنین آں نأئی ہأئے مہلت دیا بژنین۔
سیوائے تھأ خلگے ما کی یأ توبہ کی مِسما بعد، آں تھیئے نیک اعمال کی، پس بےشکہ اللہ بوگوشُو والا مہربان تُھو۔
بےشک سے خلک کی یأ کفر اختیار کیدُو ایمان ما بعد، بھی سے تُنو کفر می ہُم مُٹھائے گئی، تِھن توبہ یئت ہُم قبول نہ ہونین، ہے خلک گمراہ ہوئیدی۔
یقیناً کامے خلک یأ کأفر تھی، آں کفر سی حالت مے موئیو، یئت تھیئے ما ایک سی ہُم قبول نہ کونین (نجات حاصل کوؤ سی کأ)، سے کو دھیرین ڈک کیدے سونا ہُم دیؤسأدو فدیہ سی طور تے، ہأ خلگا سی کأ دردناک عذاب ہونین، آں ہین کأ یی ہُم نہ ہونین مدد کوؤ والا۔
یئت ہُم تھو نہ اَوابھادی نیگی یے تے وخا پورے یأ تھوئے خرچہ نی کی (اللہ سی کأ) تے مال ما یأ سے تھوئے خوش چِھیو، آں کا ہُم تھو خرچہ کودی دا، اللہ تِسما ضرور جَنَدو۔
کھوؤ سی ٹول شیئی حلال اَشیئ بنی اسرائیل سی کأ، سیوائے تیما یأ اسرائیل (یعقوبؑ) حرام کیشی اَمن زید، تورات سی نازل ہووُ ما مُوش، بَن (اے پیغمبرؐ!) تھو آنا تورات بھی تِسی تلاوت کوا، کو تھو سأس بَن تِھیو۔
بھی یی ہُم اللہ زید لَوو سَواد ایزما بعد دَ ہے ٹول ظالم تھی۔
بَن (اے پیغمبرؐ!) اللہ سأس بنَدو، دَ تھو ابراہیمؑ سی دین مَنا سے پاک دین سی منُو والا اَشُو، آں سے شرک والائے ما نہ اَشو۔
حقیقت می اول شیر یأ سَوا گأشی خلگا سی کأ سے مکہ می چھی، برکت والا آں ہدایت چھی ٹول جہانا سی کأ۔
اِیزمی کولاؤ نشأنی تھی، ابراہیمؑ سی پوت تُھو آں کآم ہُم اِیزمی داخل ہُوو سے اَمن می ہودُو، آں اللہ سی کأ خلگا زید بیت اللہ سی حج فرض تُھو، کِسی یأ وَس چِھیو اِسی دِشکے پَن سی کوؤ سی، آں کو یی انکار کِیو اللہ بےپرواہ تُھو ٹول جہانا ما۔
بَن (اے پیغمبرؐ!) اے کتاب والا ہانا! تھو کئی انکار کودی اللہ سی آیادا سی؟ حالانکہ اللہ گواہ تُھو تھأ کما سی یأ تھو کودی دا۔
بَن (اے پیغمبرؐ) اے کتاب والا ہانا! تھو کئی منع کودی اللہ سی پَن ما (تھأ خلک) کی یأ ایمان اَنودُو؟ تھو بیرَڑدی اِسمی کولاچا، حالانکہ تھو گواہ تھی، آں نو تھو اللہ بےخبر تھیئے کمے ما یأ تھو کودی دا۔
اے سے خلک کی یأ ایمان اَنودُو! کو تھوئے مینی تے ڈلہ سی یأ کتاب تھائے دیا گودُو، دَ تھیئے تھو نُڑانین تُھن ایمان ما بعد کفر کے۔
آں تھو کھأکأ انکار کودی، (میس پیشتے ہُم کہ) تھوزیت اللہ سی آیات بنا بَیدی، آں تھو می تِسی رسول ہُم تُھو؟ آں کیس یأ اللہ مضبوط کِیو دَ خامخا ہدایت دیا گأ تیس کے سیدھا پَن سی دِشکے۔
اے سے خلک ہانا یأ تھیئے ایمان اَنودُو! اللہ ما بِھیا کھأکأ یأ تیما بِھیو سی حق تُھو، آں تھو ہڑو نہ موا خو مسلمانی سی حالت می۔
آں جوخ گݜا اللہ سی ݜیݜ ٹولے دے آں (ایکدی ما) جُدا نہ ہوا، آں یاد کوا تنُو اَمن زیت اللہ سی نعمت کے یأ تھو دشمن اَشیئ دا، بھی تُھن حِی آ می مینہ تھوؤ، بھی تھو بھئی بھئی ہوئی تِسی سی فضل دے، آں تھو آنگا سی کُوئی سی دھیر زیت اَشیئ، دَ مأ تھو اِیزما پِھگأت، اَںئی ہامُوڑ بنَدو اللہ تُھن کأ تُنو آیات کہ تھو ہدایت زیت ہوا۔
آں تھو می اے ڈلہ سی ہوؤ پکار تُھو کہ سے نیمے غورہ سی دِشکے، آں حکم کوئے غورہ کما سی، آں منع کوے لاݜ کما ما، آں اَںئی ہے خلک کامیاب تھی۔
آں تھو نہ ہوا تھأ خلگا سی شانے کی یأ جدائی أنی آں اختلاف اَنو تیما بعد کہ اَئی تھأئے کولاؤ نشانی، آں ہین کأ گھن عذاب تُھو۔
تے دی اُوژیلی ہونین چیرگن بودے، آں کِݜینی ہونین چیرگن بودے، دَ سے خلک یأ کِݜینی ہوئی تِھین بود (تھأئے بنا بژنین) کئی تھوئے کفر کی تُنو ایمان ما بعد؟ دَ تھو چکھا عذاب مِسی کأ کہ تھو انکار کوؤدُود۔
آں (دُوئی دِشکے) سے خلک یأ اُوژیلی تھین بود دَ سے اللہ سی رحمت می تھی، تھیئے اِسمی مُدام ہونین۔
أ اللہ سی آیات تھی، مھو ہأ تھیئے ٹیک ٹیک بُھوژادی، آں اللہ بُٹ جہان زیت کی ظلم کوؤ نہ خوشادُو۔
آں اللہ سی کأ تھی سے ہر کی یأ آسمانا می تھی آں سے دھیرینے تھی، آں اللہ سی دِشکے ٹول کم واپس یے دی۔
تھو غورہ اُمت چھی، پیدا کوا گئیدی خلگا سی کأ، تھو خونہ کودی غورہ کم سی، آں منع کودی لاݜ کم ما، آں تھو ایمان اَندی اللہ زیت، آں کہ ایمان اَنوشوو کتاب والائے دَ غورہ ہونین دے تِھن کأ، تھأمی یام ایمان والا تھی اَسے چیر تھأمی گنہگار تھی۔
یئت ہُم سے تھوئے نقصان نہ اَوابھادی خو جِیب تے، آں کو تھیئے تھوسیت لات کیو دَ ڈاک پأشکے پِشأدے ڈے نین، بھی تھین مدد کوا نہ بژنین۔
تھأزیت بےعزتی سی ٹاپا ݜژا گودُو سے کھیت یأ تھیو، خو اللہ سی اقرار می آں خلگا سی اقرار می، آں أپ اللہ سی غصہ تھأزیت، آں تھلا گأ تھأزیت محتاجی، مِسی کأ سے انکار کوؤدود اللہ سی آیادا سی، آں ناحق نبی موؤدود، مِسی کأ تھیئے نافرمانی کی آں چیر مُٹھائے گئی۔
سے ایشان سی نی تھی، کتاب والائے ما اے جماعت (حق زیت) ایڑی ہوئل چھی، سے بندی اللہ سی آیات ڙأت می، آں سے سجدہ کودی۔
(ہے خلک) ایمان اَندی اللہ زیت آں آخرت سی دی زیت، آں خونہ کودی غورہ کم سی، آں منع کودی لاݜ کما ما، آں ایکدوئی سیت سألی کودی غورہ کما می، آں ہے خلک نیک تھی۔
آں کآم یأ غورہ کودی دا دَ یئت ہُم تِسی ناقدری نو ہونین، آں اللہ پرہیزگار غورہ پأنَدو۔
آں کامے خلگے کفر کیدُو دا یئت ہُم کم نہ ینین تھأئے تِھن مال آں نأئی تھین اولاد، اللہ سی مقابلہ می کی شیئی، آں سے آنگا والا تھی۔
کا یأ سے مے دُونیئی سی جیدون می خرچہ کودی دا، تِسی مثال تے سخ شیدیل ہوا سی تُھو، یأ سے اَوے اے قوم سی بُھوم گے، کی یأ ظلم کیدُو اَمن زیت، بھی سے تیس برباد کوے، آں تھأزیت اللہ ظلم نی کی، خو سے اَمن زیت أمیدے ظلم کودی۔
اے ایمان والا ہانا! تھو نہ سَوا بھیدُو (رازدار) تُنوئے ما علاوہ، سے تھوئے نقصان اَوؤ ما علاوہ دُوئی کی نہ کودی، ہین اَرمان تُھو تھوئے تکلیف اَوے، ہین دشمینی تِھن أںئے ما اَخکارہ چھی، آں کا یأ بوریل تُھو تِھن حی می سے چیر زیاد تُھو، مھوئے کم سی بأت تھوئے بیان کی، کو تھوئے عقل ما کام گھینو۔
بُھویا! تھو دا سے تھی کہ مینہ کودی تھأسیت، آں سے تھوسیت مینہ نہ کودی، آں تھو بُٹ کتاب منَدی، آں سے یئت تھوسیت میلاؤ ہُویو بندی مھوئے (قرآن زیت) ایمان آنودو، آں یئت اَون سیت ہُوئیو تھوپیش قار تے تنُو أنگی چوَدی، بَن (اے پیغمبرؐ!) مردہ ہوا تُنو قار می! اللہ غورہ جنُو والا تُھو حی آ سی بُوریل بأدے ما۔
کہ ٔ تھوئے کی غورہ شیئی اَوؤو تھأئے لاݜ گھڑَدو، آں کے تھوئے کی سختی اَوَئیو سے ایزید خوشال ہودی، آں کو تھوئے صوو ما کام گھینو آں (اللہ ما) بِھیو دَ تھین چال تھوئے کی نقصان نہ اَوابھادی، بے شکہ ہے کا کودی دا اللہ تیس گیر کوؤ والا تُھو۔
آں (تے وخ یاد کو) کے یأ تو ڙات سی ساعت می تنُو شیر ما نیختے مسلمان بَھیؤدُود تا (لات سی) پوت زیت لات سی کأ، آں اللہ بُھویو والا جَنو والا تُھو۔
کے یأ دُو ڈلا تھوئے ما حی ڈیگوؤ می اَشیئی کہ (تھیئے لات) بئیلانین، آں (حالانکہ) اللہ تھین سأت اَشو، آں مومنائے اللہ زیت توکل پکار چھی۔
آں بے شک اللہ تُھن مدد کی بدر سی لات می، حالانکہ تھو کمزور اَشیئ، دَ اللہ ما بھیا، ہوبھادُو تھو شکر نیگھالا۔
(یاد کو تے وخ) یأ تُو مومنائے بَنودود، کہ "کئی پورا نہ ہونین تُھن کأ کہ تُھن رب ڇا زر مُلیک (آسمان ما) نازل کوئے تُھن مدد سی کأ؟"
ہاں کو تھوئے حی مضبوط ساتو، آں (اللہ ما) بِھیو، آں کأفرے تھوزیت جوش تے حملہ کِیو، دَ اللہ پائیں زر نخ کویل مُلیک تُھن مدد سی کأ پینین۔
آں نہ سوأت چی ایس اللہ خو زیرے تُھن کأ، آں مِسی کأ کہ بےغم ہوئن تُھن حی ایدے، آں نی چھی کومک خو اللہ سی ڈھأرا، سے زوروڑ تھو حکمت والا تُھو۔
(اللہ) ایس مِسی کأ کی کہ کأفرا سی اے ڈلہ ہلاک یا ہأ ذلیل و مغلوب کوئے کہ (کھأکأ اَئیشی تھامو) ناکام واپس بژَن۔
(اے پیغمبرؐ!) مے کم زیت چھی کی اختیار نو تُھو، (مھیرے دو صورت تھی) یا اللہ ہین حال زیت مہربانی کوئے یا ہائے عذاب دو، کئیکہ ہے ظالم خلک تھی۔
آں اللہ سی کأ تھی کا یأ آسمانا می تُھو آں کا یأ دھیرین می تُھو، بوگوشَدُو کیسکے نیمؤسأدو، آں عذاب دیدو یِسکے نیمؤسأدو، آں اللہ بوگوشُو والا مہربان تُھو۔
اے ایمان والا ہانا! تھو سود نہ کھا دگنأدے چیری کیدے، آں اللہ ما بِھیا، مِسی کأ تھو کامیاب ہوا۔
آں اَمن پھیگا تے آنگا ما یأ تِیا کوا گودُو کأفرا سی کأ۔
آں بات منا اللہ و رسول سی، کہ تھوزیت رحم کوا بژے۔
آں دھأںئی دا تُنو رب سی معافی سی دِشکے، آں تے جنت سی دِشکے تِسی بِھزیناچا آسمانو دھیرین سی برابر تُھو، تِیا کوا گیژی سے پرہیزگارا سی کأ۔
سے خرچہ کودی (اللہ سی پَن می) خوشألی می آں تنگی می، آں سے تنُو قار زیت قابو کودی، آں معاف کوؤ والا تھی خلگا سی قصور، آں اللہ خوشادو نیک کم کوؤ والا۔
آں سے خلک یأ لاݜ کام کیو یا اَمن زیت ظلم کیو اللہ یاد کودی، بھی نِمادی معافی تُنو گناہ آ سی، آں کآم معاف کوبھادو گناہ اللہ ما علاوہ؟ آں سے جیندے ہُم تنُو کویل کما زیت نی پھڙدی۔
أ سے خلک تھی تِھین بدل معافی چھی تِھین رب سی دِشا، آں باغ تھی روان ہودی تِھین ٹیندے نھید، یأ تھیئے اِسمی ہمیشہ ہمیشہ ہونین، آں غورہ کم کوؤ والا سی بدل چیر غورہ چھی۔
حقیقت می تھوما مُوش چیر واقعات لھنگئیدی، دَ دھیرین می گئیا، آں بُوا کا نتیجہ ہی لووالا سی۔
أ بیان تُھو خلگا سی کأ، آں ہدایت چھی آں خونہ تُھو پرہیزگارا سی کأ۔
آں حی نہ ڈیگا آں نائی غم کوا، آں تھوئے غالب (زوروڑ) ہونین کہ تھو ایمان والا تِھیو۔
کو تھوئے (لرئی سی) تکلیف اَوؤدُوو ہال تکلیف (دأل) خلگائے ہُم اَوؤدُو، آں أ (اَزمیخ سی) دی تھی مھو خلگا سی مِیئے ادل بدل کوا یدی، آں مِسی کأ یرأ اللہ تھأ خلک پأنے سے ایمان اَندی، آں تھوما (یام خلک) گواہ سَوے، آں اللہ ظألم نہ خوشادُو۔
آں مِسی کأ یرأ اللہ ایمان والا پاک کوئے، آں کأفر ہاڙے۔
کئی تُھن أ خیال تُھو تُھوئے جنت کے (ہأئیمُو) لھنگنین، آں مھیرے دا لا اللہ تُھن اَزمیخ نی کیژی تھوما کآم جہاد کودُو آں کآم (تھوما) صوو کوؤ والا تھی؟
آں تھو دا أمیدے مئک کے مُخامُخ ہوؤ ما مُوش (شہادت سی مئک سی) ارمان کوؤدُود، مھیرے تھوئے ایس ڈیڈ، آں تھو (تنُو أݜیئے) پشُودُود۔
آں نو تُھو محمدؐ خو اے پیغامبر، ایما مُوش چیر پیغامبر لھنگئیدی، کو سے مُو یا ما گاو دَ کئی تھوئے پتکے نُڑنین تُنو کھِنا زیت؟ آں کآم یأ پتکے نُڑوو تُنو کھینا زیت دَ یئت ہُم تکلیف نہ اوابھادی اللہ یے کی شیئی سی، آں شیرتے بدلہ دینین اللہ شکر نیگھالُو والائے۔
آں اے انسان سی اختیار می نُو تُھو یأ تیسکے اللہ سی حکم ما بغیر اے مقرر وخ می مئک یو، آں کآم یأ ارادہ کوؤ سأدو دُونیئی سی ثواب سی، دَ مھوئے دینین تیسکے اِیزما، آں کآم یأ ارادہ کوؤسأدو آخرت سی ثواب سی دَ مھوئے دینین تیسکے اِیزما، آں شیرتے بَدل دینین شکر نیگھالُو والائے۔
آں کھدیک کھیدیک پیغمبر لھنگئیدی تھأسیت ایپوت ہیدے اللہ والائے (کفار آ سیت) لات کی، تھأئے اللہ سی پَن دے کا تکلیف اَوئیدی دا تِسی وجہ دے نأ تھیئے حی ڈیگات، نأ کمزور ہوئی آں نأئی تھیئے اون لار تھلُو، آں اللہ صوو کوؤ والا (خلک) خوشادُو۔
آں تھین دُوئی کی بات نہ أشی خو تھیئے میس بنُو یرأ "اے مُھن پروردگار! معاف کو مھوئے مُھن گناہ آں مُھن کما می مُھن زیأتیئی، آں مضبوط کو مُھن کُھو، آں کومک کو مُھن کأفر قوم سی مقابلہ می"۔
دَ اللہ تھأئے دُونیئی سی ثواب دید آں آخرت سی ہُم غورہ ثواب دید، آں اللہ نیک عمل کوؤ والا خوشادُو۔
اے ایمان والا ہانا! کو تھوئے کأفرا سی بات مینیو دَ ہیئے تھو واپس کونین تُنو کِھنا زیت (کفر سی دِشکے)، دَ تھوئے واپس ہونین خسارہ سی حالت می۔
نأ، اللہ تُھن کومک کوؤ والا تُھو، آں سے چیر غورہ کومک کوؤ والا تُھو۔
کامے خلگے یأ انکار کیدُو چیر شیرتے مھوئے تِھن حِی آ می رعب تھلنین، کئیکہ تھیئے اللہ سیت مھال شرک کی یأ تِسی بارہ می اللہ کی دلیل نے پیؤشُو، آں تِھن ٹھیکانا (دیزوخ سی) آنگا تُھو، آں سے چیر لاݜ پوت تُھو ظالما سی کأ۔
آں اللہ سأس کیدے پشأد تھوئے تُنو وعدہ کے یأ تھو تھأ (کفار) چھینُودود اللہ سی حکم دے، مھیدا پورے کہ بھی تھوئے سستی کی کم می، آں حکم سی بارہ می اختلاف کی، آں کے یأ اللہ تھوئے تُھن خوشیل شیئی پشاد تا تھوئے (تنُو امیر سی) حکم نہ منُو، تھوئے می یام سے اَشیئی یأ دُونیئی نیمؤدود آں یام سے اَشیئی یأ آخرت نیمؤدود، بھی اللہ دھوگو کی تھو تھیئے ما یأ تھو اَزموئے، دَ مھیرے تی تھو معاف کیدی، آں اللہ فضل کوؤ والا تُھو مومن آ زیت۔
آں (یاد کوا تے وخ) کے یأ تھو (کھن وا) بھائے اُوخاییؤدود، یس کے گئیدے نُو بُودود، آں اللہ سی رسول تھوئے تُھن پأشا ہاگؤدود، دَ اللہ تھوئے غم زیت غم دید، مِسی کأ (تھوئے اَئیندہ سی کأ سوق ہوئے یرأ) تھو غمجن نہ ہوا تیزیت یأ تُھن ہادا گادُو، آں نأ تے تکلیف زیت یأ تھوزیت آپتُو، آں اللہ شید تُھو تیما یأ تھو کودی دا۔
بھی مے غم ما بعد تی (اللہ) تھوزیت سکون نازل کی، اے نین (سی شکل می) یأ تھومی دھأک خلگا زیت أبیشی، آں اے ڈلہ سے أشی کیسکے تنُو اَمن سی غم أشی، سے خلک اللہ سی بارہ می ناحق مھال گمان کوؤدود یأ سے جہالت سی (وَخ سی) خیالات اَشیئی، سے بنُودود "کئی مھوئے ہُم کی اختیار تُھو؟" بَن کہ اختیار تہ بُٹ اللہ سی تُھو، ہے خلک تنُو حی آ می تھأ بأت بُرادی یأ چھی مُوشکے اَخکارہ نہ کودی، بندی: مھوئے کی اختیار ہُوشوو مھوئے مھید ما نہ بژنیندے، بَن کہ: تھو کو تنُو شیرا می ہُم ہُوئیشیو کسی یأ مئک لیگیل اَشُوو تھیئے بھار کے نیختے قتل گاہ آ ئے بژنیندے، ہے بُٹ مِسی کأ یرأ کا یأ تُھن سینہ آ می تُھو اللہ تیز آزومے، آں کا یأ تُھن حی آ می تُھو دا تِسی مَل پاک کوے، آں اللہ کا یأ سینہ آ می تُھو دا تی ما شید تُھو۔
بے شک سے خلک یأ سے واپس ہُوئی تھوما دو لخکرا سی جنگُو سی دی، یقیناً تھأ پݜَلأت شیطان تھین زینی کما سی وجہ دے یأ تھیئے کیشی دا، آں بےشک اللہ تھأ معاف کی تھیئے ما، بےشک اللہ معاف کوؤ والا تُھو برداشت والا تُھو۔
اے ایمان والا ہانا! تھو نہ ہوا کأفرا سی شانے، آں تھین مسلمان بھئی کے اللہ سی پَن می سفر کی یا جہاد سی کأ نیگھأد (آں مُویو) دَ تھین بارہ می بنَدی کو ہے مھوسیت دھرئیشیو ہیئے نأ مونیندے آں نأئی ما بژنیندے، ہأ بأدا سی مقصد أ چھی کہ اللہ ہین حی آ می افسوس پیدا کوے، آں جیدون و مئیک تہ اللہ دیدُو، آں اللہ تھأ عمل یأ تھو کودی دا پشُو والا تُھو۔
آں کو تھو قتل ہوئیو اللہ سی پَن می یا موئیو، بھی ہُم مغفرت ہونین اللہ سی دِشا (سے) غورہ چھی تیما یأ سے جمع کودُود تا۔
آں کو تھو موئیو یا قتل ہوئیو دَ خامخا اللہ سی دِشکے جمع کوا بژنین۔
دَ أ اللہ سی رحمت سی وجہ أشی کہ تُو تھین کأ نرم ہُو، آں کو تُو سخت ہُوشوو آں سخت حی والا، دَ خامخا تھیئے (تھأ ما) اِتکے مِتکے ہونین دے، تھأ معاف کو آں تھین بوگوشُو سی کأ دعا کو، آں مشورہ کو تھأسیت کما می، بھی کے یأ پوخ ارادہ کیو دَ اللہ زیت توکل کو، بےشک اللہ توکل کوؤ والا خوشادُو۔
کو اللہ تُھن کومک کِیو یام تھوزیت زوروڑ نو ہوبھادُو، آں کو تی تھو چھوئیو کآم تُھو سے تُھن مدد کوئے ایما بعد؟ آں مومنائے پکار تُھو اللہ زیت توکل کوئن۔
أ نو ہوبھادُو یرأ اے نبی خیانت کوے، آں کی خیانت کیو تی قیامت سی دی تے شیئی گِھندے یینین کا یأ خیانت کیدوو، بھی ہر ماݜ کے تِسی کوئیل کم سی پورا پورا بدل میلاؤ ہونین، آں یزیت کی ظلم نہ ہونین۔
أ لخہ کھأکأ ہوبھادُو یرأ اے ماݜ یأ سے اللہ سی رضامندی سی تابعداری کودُو، تے ماݜ سی شانے ہوئے کآم یأ اللہ سی قار گِھندے آپتُوو، آں تِسی آخری دھرُو سی پوت دیزوخ تُھوو، آں سے چیر لاݜ پوت تُھوو؟ (متبادل ترجمہ) کئی کی یأ (ہمیشہ) اللہ سی رضامندی سی تابعداری کیژیو تِسی شانے ہوئے یأ سے اللہ سی قار گِھندے واپس ہودُوو، آں تِسی آخری دھرُو سی پوت دیزوخ تُھوو؟ آں سے چیر لاݜ پوت تُھو۔
ہے اللہ سی نیز می (خلگا سی) درجہ تھی، آں اللہ پشُو والا تُھو کا عمل یأ تھو کودی دا۔
یقیناً اللہ مومنا زیت احسان کی یرأ تھین مِیئے تھیئے ما اے پیغامبر پیؤ، کآم یأ تِسی آیات تھأئے بُھوژادُو، تھأ پاک صاپ کودُو، آں تھأئے کتاب و حکمت ڇِھیڙادُو، حالانکہ ایما مُوش ہے خلک کولأؤ گمراہی می بژیل اَشیئی۔
کے یأ تھوئے مھال مصیبت اَوئی یأ تِسی دُوگین مصیبت تھوئے دشمن گے أوأدیشی، تھلا تھو میس بنوسأد کہ أ مصیبت کھیدا أپچی؟ تھو بنا (اے پیغمبرؐ!) ہے مصیبت تُھن تُنو اعمالا سی وجہ دے چھی، یقیناً اللہ ہر شیئی زید قادر تُھو۔
آں کامے مصیبت یأ تھوئے دُوںئی ڈلا آ سی جنگُو سی دی اَوئیشی دا، اللہ سی حکم دے اَوئیشی، مِسی کأ یرأ اللہ مومن معلوم کوے،
آں منافق ہُم معلوم کوے، کے یأ تھأئے بناگا کہ تھو یا آں جہاد کوا اللہ سی پَن دے، یا کأفرا سی حملہ کھما، دَ تھیئے بنُو کہ مھوئے جہاد سی بارہ می معلوم اَشوو مھوئے خامخا تھوسیت سأد ہونیندے، آں ہے تے دی ایمان ما زیاد کفر کے نھیو اَشیئ، ہے تنُو أں دے تے بات کودی یأ ہین حی آ می کی ہُم نو تُھو، آں کا ہُم ہے بُرادی دا اللہ یے غورا علم تُھو تِسی بارہ می۔
ہے (منأفق) سے خلک تھی یأ تُنو تھأ بھیا سی بارہ می بنُو کآم یأ (شہید ہوئی دا) کہ: کو ہیئے ہُم مُھن بات بیدی شیو ہے ما نہ بژنیندے، تھو بنا (اے پیغمبرؐ!) کو تھو سأزبن تِھیو اَمن ما مئک دھوگو کوا تَھلا۔
آں کامے خلک اللہ سی پَن می (جہاد می) ما گئیدی دا تھأ مئیل حساب نہ کوا، بلکہ سے جَن تھی تُنو رب سی خوا می، آں تھأئے رزق میلاؤ ہوا ییژی،
کا ہُم تھائے اللہ تُنو فضل دے دیدتُو دا سے تِسمی خوشال تھی، آں کامے خلک یأ پأشا تھی دا آں ہأزید میلاؤ نُو ہودی دا ہے تھأ سی بارہ می ہُم خوشألی کودی، کہ تھأئے ہُم نأ کی بھیت ہونین نأئی کی غم ہونین۔
سے اللہ سی انعام و فضل زید خوشألی کودی آں یقیناً اللہ مومنین آ سی اَجر ضائع نہ کودُو۔
کی یأ زخم میلاؤ ہوؤ سی باوجود اللہ و اللہ سی رسول سی حکم قبول کیدُو، آں کامے خلک یأ تھیئے نیک اعمال کیدی دا، آں گنائے ما اَمن ساتُو دا، ہین کأ چیر گھن اَجر تُھو۔
سے خلک یأ تھائے خلگے بنُو دا یرأ یقیناً کأفرے تُھن کأ (لخکر) جمع کیژی، تھیئے ما بِھیا (مے بأت تے) تِھین ایمان دوئی ہُم چیری ہُو، آں ہیئے بنُو مُھن کأ اللہ کافی تُھو، آں سے بہترین کام سوؤ والا تُھو۔
بھی سے اللہ سی انعام و فضل زید واپس ہوئی، آں تھأئے کی ہُم نقصان نہ آوؤ، آں ہیئے اللہ سی رضامندی سی تابعداری کی، آں اللہ چیر گھن فضل کوؤ والا تُھو۔
یقیناً أ دا شیطان تُھو یأ سے تھو بھیادُو تنُو سأدا ما، اِیزما نہ بِھیا، بلکہ مھأ ما بِھیا، کو تھو مومن تھیو۔
آں تھو غمجن نہ ہوا تھأ خلگا سی کأ کآم یأ کفر می جلدی کودی دا، ہے اللہ سی کی ہُم نقصان نہ کودی، اللہ میس نیمادو کہ آخرت می ہین کی ہُم حصہ نہ ہوئے، آں ہین کأ چیر گھن عذاب تِیا تُھو۔
کامے خلگے ایمان سی بدل می کفر اختیار کیدُو دا، ہے یئت ہُم اللہ یے کی ہُم نقصان نہ آوا بھادی، آں ہین کأ سَخ عذاب ہونین۔
آں کأم یأ کأفر تھی دا سے مے گمان نہ کوئن کہ مھوئے ہأئے کامے مہلت دیدچی دا ہے ہین کأ غورا چھی، بلکہ مھو ہائے مہلت مِسی کأ دیدی کہ ہے گناہ می زیادتی کوئن، آں ہین کأ ذلیل کوؤ والا عذاب ہونین۔
اللہ مومن مے حالت می نو چھودُو کامے حالت می تھو تھی دا، کھیدیخانہ پورے اللہ ناپاک خلک پاک خلگے ما جدا نی کیدیو، آں اللہ تھوئے غیب سی بأت ہُم نہ کودُو، ہاں اَسے تُنو پیغامبرے ما (کآم ہُم) نیمؤسأدو تیس (مے کم سی کأ) خوشادُو، دَ تھو اللہ آں اللہ سی رسولا زید ایمان اَنا، کو تھوئے ایمان اَنو آں گنائے ما امن پِھگادو دَ تُھن کأ چیر گھن اَجر ہونین۔
کامے خلک یأ تے (مال سی دیؤ) ما بخل کودی کامے مال تھأئے اللہ تنُو فضل دے دیدچی دا، سے خیال کودی کہ ہے تھین کأ بہتر تُھو، حالانکہ ہے تھین کأ لاݜ تُھو، چیر جلد کامے مال می ہے بخل کوؤدُود تا تِسما زنزیر سوأدے قیامت سی دِیئے تِھین ماڑ وا تھلا بژنین، آسمان و دھیرین سی وارث اللہ تُھو، آں اللہ شید تُھو کامے عمل تھو کودی دا۔
یقیناً اللہ تھأ خلگا سی بات بیدچی کآم یأ میس بنَدی کہ "اللہ غریب تُھو آں مھو مالدار تھی" مھو ہین ہأ بأت (ہین اعمال نامہ می) لیگدی، آں ہیئے ناحق پیغمبر قتل کیدی، آں مھوئے بنین کہ چکھا عذاب دھژُو سی۔
أ تھأ کما سی سزا چھی کا یأ تُھن ہادے مُوش پیؤشُو دا، آں یقیناً اللہ تُنو بندہ آ زید ظلم کوؤ والا نُو تُھو۔
أ سے خلک تھی کہ ہے بندی اللہ مھوئے ما مے وعدہ گِھن چی کہ: اے پیغامبر زید ہُم تے وخہ پورے ایمان نہ آنا کھیدیخانگے تی مھوئے مھال قربأنی نہ أنیژیو کامے قربانی یأ آنگا کھئے، (اے پیغمبرؐ) تُو بَن (ہأئے) پیغامبر مھأما مُوش تھوئے اَئیشی واضحہ نخے سمانے، آں تھأ نخ ہُم کامے نخا سی یأ تھوئے بنُوشُو، کو تھو سأسبَن تِھیو تَھلا تھوئے تھأ کئی موئیشی؟
(اے پیغمبرؐ) کو ہے تھأ لووال گھنَدیو (ہے کی نیم بات نی چھی) ہیئے تھأما مُوش ہُم پیغامبر لووال گھنیئشی، (تھأ پیغامبر) کی یأ واضحہ نخ (صحیفہ) آں پاݜ آں روخانہ کتاب اَنیئشی دا۔
ہر سا والائے مئک سی خوند چکھو تُھو، آں یقیناً تھوئے تُھن عملا سی پورا پورا بدل دیا بژنین قیامت سی دِیے، آں کآم ہُم دیزوخ ما بچ کوا گا آں جنت می داخل کوا گا دَ یقیناً سے کامیاب ہُو، آں دُونیئی سی أ جیدُون (جنت سی مقابلہ می) دوکا سی سامان ما علاوہ کی ہُم نُو تُھو۔
(اے ایمان والا ہانا!) تُھن ضرور امتحان گِھنا بژنین تُھن مال و جان می، آں تھوئے اہل کتاب آں مشرکینا ما چیرگن تکلیف سی بأت بُھوش نین، کو تھوئے صوو کی آں گُنائے ما پرہیز کِیو أ چیرگن ہمت سی کم تھی۔
(یہودیائے تے وخ اَموݜا تھلو پکار نُو تُھو) آں کے یأ اللہ اہل کتاب ما وعدہ گھینیشی کہ تھو ضرور بیان کوا مے کتاب خلگائے، آں اے کتاب سی کی بات نُو بُورا (اسے) ہیئے اے کتاب ڈاک سی پأشکے تھلُو، آں ہیئے اِسی بدل می دھأک شانہ قیمت گِھن، آں چیر لاݜ تُھو کا یأ ہے مُل گِھنَدی دا۔
تھو یئت ہُم گمان نہ کوا تھأ خلگا سی بارہ می کی یأ لاݜ کم کیدی دا سے تیزیت خوشال ہودی، آں سے خوشادی کامے غورہ کم تھیئے نی کیدی دا تیزیت تِھن صفت کوا بژے، پس تھو گمان نہ کوا کہ تھیئے عذاب ما بچ ہونین، بلکہ ہین کأ دردناک عذاب ہونین۔
آں اللہ سی کأ چھی آسمان و دھیرین سی بأچیئی، آں اللہ ہر شیئی زید قادر تُھو۔
بےشک آسمانو دھیرین سی پیدا کوؤ می آں ڙأت و دی سی ادلی بدلی می نَخ تھی عقل سی کھمنا سی کأ۔
سے خلک یأ اللہ یےدادی ایڑی ہوئیل آں بھژیل آں ہوبیل، آں سے غوروفکر کودی آسمانا سی آں دھیرین سی پیدائش زیت، (آں میس بندی) اے مُھن پروردگار! تأ مھأ بے فائدے پیدا نی کیدی، (اے مُھن پروردگار!) تُو ہر عیب ما پاک تُھو، پس مھو آنگا سی عذاب ما بچ کو۔
اے مھُن پروردگار! یقیناً تھوئے کام ہُم آنگا می داخل کی سے ناکام و ذلیل ہُو، آں ظألما سی یی ہُم مددگار نہ ہونین۔
اے مُھن پروردگار! بےشک مھوئے تے آواز بُد کی یأ ایمان سی دِشکے آواز دیدُوشو دا کہ "تھو ایمان آنا تُنو رب زید" پس مھوئے ایمان اَنو، اے مُھن پروردگار! مھوئے مُھن گناہ معاف کو، آں ختم کو مھوما مُھن لاݜ کم، آں مھوئے نیک خلگا سیت مئک نصیب کو۔
اے مُھن پروردگار! آں مھوئے ہر تے نعمت نصیب کو کسی یأ تھوئے تُنو پیغمبرا سی ذریعہ دے مھوسیت وعدہ کیژی دا، بے شک تھو وعدہ خلاف نی تھی۔
بھی تھین پروردگار تھین دعا قبول کی، (آں بنُو کہ) "بےشک مأ تھوما یِسی عمل ضائع نو کونین، تھو ماݜ تھی کو جوئی تھیو، تھو ٹول ایکدیئے ما تھی، دَ تھلا کآم خلگے یأ ہجرت کی، آں کآم یأ تھین شیرے ما نِگھالا گئیدی دا، آں کآم یأ تھأئے مھی پَن می تکلیف دیا گودُو دا، آں کآم یأ تھیئے (دین اسلام سی کأ) لات کی آں ما گئی دا، مأ خامخا ختم کونین تھیئے ما تھین لاݜ کَم، آں مأ تھأ ضرور داخل کونین مھال باغا می کھین ٹینگے یأ اُو سی یَب بژنین، می ٹول اللہ سی دِشا بدل ہونین، آں اللہ کیش بہترین بدل تُھو۔
(اے پیغمبرؐ!) خارا می کأفرا سی اِتکے مِتکےگُو تھوئے دوکا نہ دو۔
(أ دُونیئی سی) دھأک شاندا مزہ چھی، بھی ہین ٹھکانہ دیزوخ تُھو، آں سے چیر لاݜ پوت تُھو۔
اَسے کامے خلک یأ تُنو رب ما بھیدی دا تِھن کأ مھال باغ تھی کہ تھین ٹینگے اُو سی یَب ہونین، تھیئے تیزمی ہمیشہ ہونین، أ میلأݜتوب تُھو اللہ سی دِشا، آں کا ہُم اللہ کیش تُھو دا سے غورہ تُھو نیک خلگا سی کأ۔
آں اہل کتاب می یام مھال تھی کہ سے اللہ زید آں کا یأ تھوزید نازل ہُودو دا، آں کا یأ تھأزید نازل ہُودُو دا تیزیت ایمان اَندی، آں اللہ سی مُشکے عاجزی کودی، آں اللہ سی آیادا زیت اَشُوڑ قیمت نی گھینَدی، اَںئی أ خلک تھی کہ ہین کأ ہِین اَجر ہین پروردگار کیش تُھو، بےشکہ اللہ شیرتے حساب گھینُو والا تُھو۔
اے سے خلگا ہانا کی یأ ایمان اَنُودُو! (کأفرا سی مقابلہ می) صوو کوا، آں ٹینگ اِڑی ہوا، آں (مقابلہ سی کأ) ڈاک گھنا، آں اللہ ما بھیا، طم تُھو تھو کامیاب ہوا۔
اے خلک ہانا! تُنو رب ما بھیا، کی یأ تھو اے ماݜ (آدمؑ) ما پیدا کی، آں اَںئی تِس ما تِسی ڇھی پیدا کی، آں ہأ دُوںئے ما چیر ڇھی آں ماݜ (دوُںئمو) خور کی، آں اللہ ما بھیا کسی واسطہ دیدے تھو ایکدیئے ما تُنو حق نیمادی، آں رشتہ داری آ سی (حق ضائع کوؤ ما) بھیا، یقین ساتا اللہ تُھن نگرانی کوا یے دُو۔
آں یتیمائے تِھن مال دا، آں (تِھن) غورہ مال (تُنو) لاݜ مال سیت نہ بدلا، آں تھین (یتیم آ سی) مال تُنو مال سیت میلاؤ کیدے نہ کھا، یقیناً ہے گھن گُناہ تُھو۔
آں کو تھوئے أ بھیت أشی لخہ تھوئے یتیما سی بارہ می انصاف نہ کو بھانین (دَ ہین پوت) دأل جوَئی آ سیت نکاح کوا، کامیک یأ تھوئے خوش ہُوئیو، دُو دُو ڇا ڇا آں چؤ چؤ (آ سیت)، آں کو تھوئے أ بھیت ہی لخہ تھو (مھأ ڇھی آ سی درمیان) انصاف نو کو بھادی دَ تھو صرف اے نکاح کوا، یا تھأ گُلأم آ سیت یأ سے تُھن قبضہ می تھیو، مے (طریقہ) می زیاد امکان تُھو تھوئے ناانصافی نو کونین۔
آں جوئی آ ئے تِھن مہر خوشحألی دے دا، ہاں کو سے اِسی اے حصہ خوشحألی دے چھودی دَ تھو بھی تیس خوشحألی آں مزے دے کھا۔
آں ناپوہا (یتیمائے) تِھن تے مال حوالہ نہ کوا کامیک یأ اللہ تُھن کأ جیدون سی زریعہ سوأدچی، ہاں ایما (اے مال ما ہأزیت) کھیا آں لھیا، آں ہأزیت مناسب انداز می بات کوا۔
آں یتیم آزوما، تھیدیخانگے یأ سے نکاح سی قابل اُموئے اَوَن، کہ تھوئے ڈیڈ تھأمی مھیرے پوہا أبچی دَ تِھن مال تھأئے حوالہ کوا، آں ہین گھینی ہوؤ سی بھیدے ہین مال فضول خرچی کیدے آں شیر شیرتے نہ کھا، آں (یتیم آ سی گھنا می) کآم مالدا ہُوو تیس کے پکار تُھو اَمن (یتیم سی مال ما) ساتے، آں کآم أمیدے غریب ہُوو سے ایس مناسب طریقہ دے کھئے، بھی کے تھو تھأئے تِھن مال دیؤسأدو دَ ایزید گواہ سوا، آں اللہ حساب گھینو سی کأ پورا تُھو۔
ماݜا سی کأ ہُم تے مال می حصہ تُھو کامیک یأ ییئ و بوپ یا نھیو رشتہ دارے چھیئی، آں ڇھی آ سی کأ ہُم تے مال می حصہ تُھو کامیک یأ ییئ و بوپ یا نھیو رشتہ دارے چھیئی، ہے مال (میراث) اَشوڑ چی یا زیاد ہے (اللہ سی دِشا) مقرر حصہ تُھو۔
آں (میراث سی) تقسیم سی وخ می (غیر وارث) رشتہ دار آں یتیم آں مسکین خلک اَیو دَ تھأئے ہُم تِس ما کآں دا، آں تھأسیت مناسب طریقہ دے بات کوا۔
آں (یتیما سی مال می گڑبڑ ما) بھیت پکار چھی تھأ خلگائے کو اَمن ما بعد کمزور اولاد چھؤو دَ تِھن دِشکے کھیدیک فکرمند ہونین، اِسی کأ اللہ ما بھیا آں سیدا سیدا بات کوا۔
کآم خلک یتیم آ سی مال ناحق کھادی دا سے تُنو ڈھے آ می آنگا ڈک کودی، آں چیر شیرتے تھیئے جلیل آنگا می داخل ہونین۔
اللہ تُھن اولاد سی بارا می تھوئے پوخ حکم دیدُو، ماݜ سی حصہ دو ڇھی آ سی برابر تُھو، آں کو (صرف) جوَئی ہُوئیو دو یا دُوئے ما زیاد، تَھلا مئیل کا چھوؤدو دا تِسی ڇا آ می دُو ڈے میلاؤ ہونین، آں کو صرف اے ڇھی چھیو تیس کے اَر ڈے میلاؤ ہونین، آں مئیل سی ییئی و بوپ ما ہر ایک کے (کا یأ دھرُو دا تِسی) ݜوم ڈے میلاؤ ہونین، شرط أ چھی کہ مئیل سی اولاد ہُوو، آں کو تِسی اولاد نہ اَشو آں تِسی یئی و باپ تِسی وارث اَشیئو تَھلا تِسی یئی ڇُوئی ڈے سی حقدا ہونین، ہاں کو تِسی چیر بھئی اَشیئو تِسی یئی ئے ݜوم ڈے میلاؤ ہونین، (می بُٹ تقسیم) تے وصیت زید عمل کوؤ ما بعد ہونین کامیک یأ مئیل کیژیو، یا کی قرض تُھوو تِسی ادا کوؤ ما بعد، تھوئے مے بأت سی صفا صفا علم نو تُھو یرأ تُھن بوپ آں جدگے ما تھوئے فائدہ اَوؤ سی لحاظ تے تھوئے زیات کآم نھیو تُھو، أ دا اللہ سی مقرر کوئل ڈے تھی، یقین کوا یرأ اللہ علم سی ہُم مالک تُھو حکمت سی ہُم مالک تُھو۔
آں تُھن ڇھی ئے کا ہُم چھوو تِسی اَر حصہ تُھن تُھو، شرط أ چھی ہن کی ہُم اولاد (جَن) نُو ہُوو، آں کو ہین اولاد ہُوو تَھلا تے وصیت زید عمل کوؤ ما بعد کامیک یأ تھیئے کیژیو، آں تھین قرض سی اَدا کوؤ ما بعد تھوئے چھویل سی چوٹھوم حصہ میلاؤ ہونین، آں تھوئے کا چھیدے گئیو تِسی چوٹھوم تھأ (ڇھی آ) سی تُھو مے شرطیدے لخہ تُھن کی ہُم اولاد (جَن) نہ ہُوو، آں کو تُھن کی اولاد ہُوو تَھلا تے وصیت زید عمل کوؤ ما بعد کامیک تھوئے کیژیو، آں تُھن قرض ادا کوؤ ما بعد تھأئے تُھن چھوئیل سی اٹھم حصہ میلاؤ ہونین، آں کو سے ماݜ یا ڇھی کسی میراث تقسیم کودی دا مھال ہوئے یأ تِسی نأ یئی و باپ جَن ہُوئیو نائی اولاد آں تِسی اے بھا یا اے شُو جَن ہُوئیو، تَھلا تھأمی ہر ایک ݜوم حصہ سی حقدا ہونین، آں کو سے (بھا و شُو) اِس ما زیاد ہوئیو تَھلا تھیئے ٹولے ڇُوئی حصہ می شریک ہونین کامے وصیت کیژیو تیزید عمل کوؤ ما بعد آں مئیل زید کامے قرض تُھو دا تِسی ادا کوؤ ما بعد، شرط أ چھی (وصیت یا قرض سی اقرار تے) تی یسکے نقصان نہ اَوادوشُوو، أ بُٹ اللہ سی حکم تُھو، آں اللہ ہر بأت ما جنُو والا ہُشا تُھو۔
أ اللہ سی مقرر کوئل حد تھی، آں کی اللہ آں تِسی رسولؐ سی بات مینیو تیس (اللہ) مھال باغا می داخل کونین یأ تِسی ٹینگے نھیدے روان ہونین، مھال خلگے مھأ (باغا) می ہمیشہ دھرنین، آں أ اے زبردست کامیابی چھی۔
آں کامے ماݜ اللہ آں تِسی رسولؐ سی نافرمانی کی آں تِسی مقرر کوئل حدے ما مُٹھائے گا و تیس اللہ دیزوخ میں داخل کونین، تِسی می تی ہمیشہ دھرنین، آں تیسکے مھال عذاب ہونین یأ تی ذلیل کیدے چھونین۔
تُھن ڇھی آ می یی بدکاری کیو تھأزید تنو آ ما چؤ گواہ سَوا، کہ تھیئے (تھین بدکاری سی) شیدی دیدو تَھلا تھأ ڇھی شیرا می کھما تھیدیگا پورے یأ تھأزید مئیک یو یا اللہ تھین کأ دُوئی کآں پان نگھلے۔
آں کو تھوئے می دُو ماݜے غلط کام کیو، تھأئے تکلیف دَا، بھی کے تھیئے توبہ کیدے تنو اصلاح کیو تَھلا تھأ معاف کوا، یقیناً اللہ توبہ قبول کوؤ والا گھن مہربان تُھو۔
اللہ تھأ خلگا سی توبہ قبول کوؤ سی ذمہ واری گھین چی کآم یأ ناپوہی می کی لاݜ کودی بھی شرتے توبہ کودی، دَ اِسی کأ اللہ تِھین توبہ قبول کودو، آں اللہ ہر بات غورہ جنُو والا تُھو حکمت والا تُھو۔
توبہ سی قبولیت تھین کأ نی چھی کآم یأ لاݜ کَم کوا ییدی، مھیدیگا پورے تھأمی ایک زید مئیک سی وخ اَوؤو سے بندُو مأ مھیرے توبہ کی، نأئی تھأ خلگا سی کأ (توبہ چھی) یأ سے کفر سی حالت می مودی، مھال خلگا سی کأ مھوئے عذاب تیا کیدے چھوؤدُو۔
اے ایمان والا ہانا! تُھن کأ أ حلال نو تُھو یرأ تھو ڇھی آ سی زور تے مالک سوا بژا، آں تھأ مے غرضے دے بندیوان نہ کوا لخا تھوئے کا تھأئے دِت تُو دا تھیئے ما واپس گھینا، ہاں کو تھیئے ڈاگا بے حیائی سی کام شروع کیو (دَ تھلا تھو کوبھادی)، آں تھأسیت شیژو طریقہ دے جیدُون تَھلا، کو تھو تھأ نو خوشادیو دَ ہوبھادُو تھو اے شیئی نو خوشا آں اللہ تِس می تُھن کأ چیر گن خیر تھوؤدُو۔
آں کو تھو اے ڇھی سی پوت دھویم ڇھی سیت نکاح کوؤ نِموؤسأدو، آں تھوئے تھأما ایک کے ڈھیری مال سی ہم دِت چیو، تیما کی ہم واپس نی گھینا، کئی تھو بہتان ݜژأدے آں کولاؤ گناہ کیدے تھیئے ما تِھن مَہر واپس گھیندی؟
آں آخر تھو (تے مہر) کھأکأ واپس گھندی، حالانکہ تھو ایکدیئے مھیدیک نھیئی ہوئیدی، آں تھیئے تھو ما مھیدیک پوخ وعدہ گھینچی؟
آں تھأ ڇھی آ سیت نکاح نہ کوا کامے (ڇھی آ) سیت تُھن بوپ (کی ہُم وخ) نکاح کیدُو، ہاں کا مُوش ہُودُوو (سے ہودُو)، أ عمل چیر بےحیائی سی آں کریکا سی (عمل) آں لاݜ طریقہ تُھو۔
تھو زید حرام کوا گئیدی تُھن یئی آں تُھن سیرأن آں تُھن شی آں تُھن پھأپ آں تُھن مأش آں تُھن بھادی آں تُھھن خوری آں تُھن سے یئی یأ تھوئے ڇھی دیتو دا، آں تُھن رضاعی شی آں تُھن ڇھی آ سی یئی (پَش) آں تُھن پرورش میں دھریل تُھن ڇھی سی سیرأن (پرکٹی) یأ سے تُھن تھأ ڇھی آ ما تھی کامیگا زید تھوئے خلوت کیدوُ دا، آں کو تھوئے تھأزید خلوت نی کیدُوو (آں ہأئے طلاق دیدتُو یا سے موئی دی و) دَ تھوزید (تِھن سیرأن آ زید نکاح کوؤ می) کی گناہ نُو تُھو، آں تُھن تنُو جدگا سی ڇھی ہُم تھوزید حرام تھی، آں أ بات ہُم حرام چھی یرأ تھو دُو شی اے نکاح می جمع کوا، البتہ کا یأ مُوش ہودُو سے ہودُو، بیشک اللہ گھن معاف کوؤ والا گھن مہربان تُھو۔
آں دألا سی نکاح والا جوَئی (تھوزید حرام تھی) اَسے سے گُلأم کامیک تُھن تھی دا، اللہ مھأ احکام تھوزید فرض کیدی، آں تِسما علاوہ تُھن کأ تُھن ڇھی حلال کوا گئیدی لخا تُنو مال سی بدل می بِیرڑا (آں تُنو نکاح می آنا) ، مے شرطیدے یأ تھو ہأزید باقاعدہ نکاح کوا، صرف شہوت پورا کوؤ مقصد نہ ہوئے، دَ بھی تھوئے کامے ڇھیئے ما فائدہ گھینو تھأئے تِھن مقرر ہوئیل مہر ادا کوا، البتہ مقرر کوؤ ما بعد تھو ایکدی می (کی کمی زیادتی) زید راضی ہوئیو تِس می تھوئے کی گناہ نُو تُھو، بےشک اللہ جنو والا آں حکمت والا تُھو۔
آں تھوئے می کآم یأ مے بأت سی طاقت نہ لردُو لخا سے مسلمان ڇھی آ سیت نکاح کوئے دَ تھأ گُلأما سیت نکاح کوئے کآم یأ تُھن ملکیت می تھی، آں اللہ ئے تُھن ایمان سی حالت غورہ معلوم چھی، تھو ٹول ایکدوئے ما ایشان سی تھی، دَ تھو تھأ گُلأم آ سیت تِھن مالک آ سی اجازدیدے نکاح کوا، آں دستور سی مطابق تِھن مہر تھأئے دا، شرط أ چھی تھأسیت نکاح سی رشتہ کیدے تھأ دامن سَوا، نأ سے صرف شہوت سی پورا کوؤ سی کأ کی (ناجائز) کام کوئن آں نأئی بیریت آشنائی پیدا کوئن، بھی کے یأ تھیئے نکاح ما بعد بے حیائی سی کام کیو تھأزید تے سزا سی اَر ہونین کامیک یأ آزاد چھی آ سی کأ مقرر چھی، أ بُٹ (یعنی گُلأم آ سیت نکاح) تھوئے مأ تھأ خلگا سی کأ تُھو کیس کے یأ (نکاح کوؤ سی صورت می) گناہ آ میں اَختہ ہوؤ سی بھیت چھیو، آں کو تھوئے صوو کیو ہے تُھن کأ چیر غورہ تُھو آں اللہ چیر بوگوشُو والا چیر مہربان تُھو۔
اللہ نیمادُو تُھن کأ (احکام) ڈاگا کوئے، آں کامے نیک خلک تھوما مُوش آشیئی دا تھو تِھن طریقہ دے اَنے، آں تھوزید (رحمت سَمانے) توجہ کوے، اللہ جنو والا حکمت والا تُھو۔
اللہ دا نیمادُو لخہ تُھن دِشکے توجہ کوے، آں کامے خلک تُنو خواہشات آ سی پأش کے ݜژدی دا سے نیمادی تھو سیدا پن ما تیمدے پھائے بژا۔
اللہ دا نیمادو لخا تھوزید آسانی سی معاملہ ہوے، آں انسان کمزور پیدا کوا گودو۔
اے ایمان والا ہانا! تھو ایکدی آ سی مال تنو آ می ناحق طریقہ دے نہ کھا، اَسے خو کہ ایکدی آ سی رضامندی دے کی تجارت چھیو (سے جائز چھی)، آں تنُو اَمن نہ ما، یقین کوا اللہ تھوزید چیر مہربانہ تُھو۔
آں کی ظلم و زیاتئی ما کام گینو، دَ مھوئے تیس چیر شیرتے آنگا وا تھلنین، آں أ بات اللہ سی کأ چیر آسان چھی۔
کہ تھوئے گھن گھن گناہے ما اَمن بچ کیو کی ما تھو منع کوا گئیدی دا، تُھن لَؤ گناہ مھوئے تھو ما دھگو کونین، آں تھو اے عزت سی پوت می داخل کونین۔
آں کامے شیئی آ می مھوئے تھوئے ایگدی آ زید فضیلت دیتچی دا تھو تیس پیش نو کومُوژا، ماݜے کا غورہ کام کیو تھأئے تیما حصہ میلاؤ ہونین، آں ڇھیئے کا غورہ کام کیو تھأئے تیما حصہ میلاؤ ہونین، آں اللہ ما تِسی فضل نیما، یقیناً اللہ ہر شیئی پیانُو والا تُھو۔
آں مھوئے ہر تے مال سی وارث مقرر کیدی کامیک یأ یئی و بوپ یا نھیو رشتہ دارے چھیدے گئیو، آں کامے خلگا آ سیت تھوئے کی وعدہ کیژیو تھأئے تِھن حصہ دا، یقیناً اللہ ہر شیئی زید گواہ تُھو۔
ماݜ ڇھی آ زید نگران تھی، مے وجہ دے لخہ اللہ ہأئے ایکدوئی زید فضیلت دیدچی، آں ماݜ تُنو مال ݜژادی، دَ نیک ڇھی دا فرمان بردار ہودی، ماݜ سی غیر موجودگی می اللہ سی دیل حفاظت می (تُھن حق آ سی) حفاظت کودی، کامے ڇھی آ سی بأت نہ منو سی تھوئے بھیت ہیو اول دا تھأئے نصحیت کوا، (کہ اِسما کام سوا نہ گا) بھی ہُوبو سی پوت می تِھن بشترہ زأنی کوا، (کہ بھی ہُم تھیئے نصیحت نی گھینو) بھی تھأ کڈا، بھی کو تھیئے تُھن بات مینیو تھین خلاف کی بھان نی بیرڑا، یقین کوا اللہ چیر اُچات آں چیر گھن تُھو۔
کو تھوئے ڇھی و کھمن می بے اتفاقی سی بھیت ہیو (دَ ہین میئے فیصلہ سی کأ) اے انصاف والا ماݜ سی ٹوَر ما آں اے انصاف والا جوَئی سی ٹوَر ما مقرر کوا، کہ سے دُوںئیمو روغہ کوؤ نیمؤسأدو اللہ ہأ دُوںیاں سی میئے روغہ اَننین، یقینا اللہ ہر شیئی ما جنیل آں ہر بأت سی خبر ساتو والا تُھو۔
اللہ سی عبادت کوا، آں تیزید کی ہُم شریک نہ کوا، آں یئی و بوپ زید غورا سلوک کوا، (اَںئی ہاموڑ) نھیو رشتہ دار آ زید، آں یتیم آ زید، آں مسکین آ زید، آں رشتہ دار گھأنڈی آ زید، آں پراگ گھأنڈی آ زید، آں اُشود بھیو والا آ زید، آں مسافر آ زید، آں گُلام آ زید ہُم (غورا سلوک کوا)، یقیناً اللہ لوئی کوؤ والا قُتنگار نہ خوشادُو۔
مھال خلک (ہُم) یأ أمیدے ہُم شُم توب کودی آں خلگائے ہُم شُم توب سی حکم دیدی، آں اللہ تُنو فضل دے ہائے کا دیدتو دا تیز بُورادی، آں مھوئے مھال ناشکرا سی کأ ذلیل کوؤ والا عذاب تیا کیدُو۔
آں (سے خلک ہُم اللہ ئے خوش نی تھی) کآم یأ خلگائے پشوؤ سی کأ تُنو مال پھرادی، آں نأ اللہ زید ایمان اَندی آں نأئی قیامت سی دی زید، آں شیطان کسی سأت سوا گاو سے چیر لاݜ سأت تُھو۔
آں ہأئے کا نقصان ہونین دے کو ہیئے اللہ زید آں قیامت سی دی زید ایمان انوشُوو، آں کا اللہ ہأئے دیدتو دا تیما (نیک کما می) خرچ کشوو؟ آں اللہ ئے ہین حال سی غورہ پتہ چھی۔
آں اللہ اے پِھٹ ہُم یزید ظلم نو کودُو، آں یی کی نیگی کیو تیس تیسکے چیری کودُو، آں تُنو دِشا تیسکے چیر گھن ثواب دیدُو۔
بھی ہین کا حال ہونین کے یأ مھوئے ہر اُمت می اے گواہ اَننین، آں (اے پیغمبرؐ) مھوئے تھأ ہأ خلگا سی خلاف گواہ سوأدے حاضر کونین؟
کامے خلگے یأ نہ منوشُو آں رسولؐ سی نافرمانی کیشو تے دی ہیئے مے بات نیمانین یرأ اَرمان! أ دھیرین مھوزید ہوار کوا گیشیو، آں ہیئے اللہ ما کی بات ہُم نُو بُورا بھانین۔
اے ایمان والا ہانا! کے تھو نشہ سی حالت می ہُوئیو نماز کے نھیئی ہُم نہ ہوا تھیدیگا پورے یأ یأ تھو کا بندیو تیس جَنا، آں جنابت سی حالت می کھیدیخانگے غسل نی کیدُوو (نماز کے نھیئی نہ ہوا)، اَسے کو تھو مسأفر ہوئیو (آں اُو میلاؤ نُو ہوو تَھلا تیمُم کیدے نماز گُوزا بھادی) آں کو تھو بیمار تھی یا سفر می ہُوئیو یا تھومی یام بھار کیدے آپتُوو، یا تھو ڇھی آ ئے نھیئی ہوئیدیو، بھی کو تھوئے اُو میلاؤ نُوہوو تَھلا تھو سُم دے تیمم کوا، یقیناً اللہ چیر معاف کوؤ والا آں بوگوشُو والا تُھو۔
کامے خلگائے یأ کتاب (تورات سی علم) ما اے حصہ دیا گوشُو دا تھوئے تھأ نی ڈیڈ؟ سے (کا طریقہ دے) گمراہی مُل گھندی، آں نمادی لخہ تھو ہُم سیدا پَن ما دُھو ہوا۔
اللہ تُھن دشمن غورہ پأندُو، آں اللہ خیال کوؤ والا پورا تُھو، آں مدد کوؤ سی کأ ہُم کافی تُھو۔
یہودی آ می یام خلک سے تھی سے (تورات سی) الفاظ تِھن تُنو پودے ما بدل کودی، آں بندی "مھوئے بُود آں مھوئے نہ منو"ُ (سمعنا و عصینا) آں "تُو بُھوش آں تھیئے کی ہُم بُھوژا نہ بژے" (وَاسمع غیر مسمع)، آں "مھوئے بُو" (راعنا) بندی، دین گے پیگو دیؤ سی کأ تُنو جِب کیلی ویلی کیدے، حالانکہ کو ہیئے میس بنوشُوو "مھوئے بُود آں مھوئے منُو" آں "تو بُھوش" (سمعنا و اطعنا و اسمع) آں "مُھن دِشکے بُو" (انظرنا) دَ ہین کأ چیر غورہ ہونیندے آں سیدا بات ہونیندے، اَسے ہین کفر سی وجہ سے اللہ ہأزید لعنت کیژی، اسی کأ صرف دھأک خلگے ما علاوہ دأل ایمان نہ اَندی۔
اے سے خلگا ہانا کیس کے یأ کتاب دیا گوشُو! کا (قرآن) مھوئے نازل کیدو دا تیزید ایمان اَنا، کامیک یأ تھوکیش موجود کتاب سی تصدیق کودُو، می ما مُوش کہ مھو بوت نھأدے پأشکے پِشئی، یا مھو ہأزید مھال لعنت کیئی کھأکأ مھوئے سَبت والا زید لعنت کِشی دا، آں اللہ سی ہر حکم دا حال می پُورا ہودُو۔
یقیناً اللہ مے بات معاف نو کودُو لخا تیزید یام شریک کوا بژے، آں ایما علاوہ دأل ٹول بأت کیسکے نیمؤسأدو معاف کودُو، آں کآم اللہ زید شریک سوادُو دا تی چیر گھن اے لووو سواد۔
کئی تأ تھأ خلک نی ڈیڈ کآم یأ اَمن گے چیر پاکیزہ بنودُود؟ حال أ چھی پاکیزگی دا اللہ یس کے نیمؤسأدو تیس کے دیدُو۔
څارا دا کھأکأ ہے اللہ زید لوو سَوادی، اَخکارہ گناہ سی کأ أ بات کافی چھی۔
کئی تھوئے تھأ خلک نی ڈیڈ تھأئے کتاب (تورات سی علم ما) اے حصہ دیا گوشُو، سے کھأکأ بُھود آں شیطان آ سی تصدیق کودی، آں کأفر آ سی بارہ می بندی ہے مسلمانے ما زیاد سیدا پن دے تھی؟
اَںئی ہے سے خلک تھی کیزید اللہ لعنت کیژی دا، آں کامے خلگا زید اللہ لعنت کیژی دا تأ تِھن کأ کی مدد کوؤ والا نہ پانین۔
کئی تھأئے اللہ سی حکومت سی کی حصہ میلاؤ ہودُو؟ کو ہے بات ہیشیو دَ تھیئے خلگائے کجُور سی أنی سی پھلیل حصہ سی برابر ہُم نہ دینین دے۔
یأ سے خلگا زید مے بأت سی کأ حسد کودی لخا اللہ تھأئے تُنو فضل ما (کئی) دیدتُو؟ مھوئے ابراہیمؑ سی آل گے کتاب آں حکمت دیدیشی آں تھأئے گھین بأچیئی دیدیشی۔
دَ تھأمی یامے دا تیزید ایمان اَنو، آں یامے تیما مُو گاد، آں دیزوخ پووڑیل آنگا سی شکل می ہین کأ کافی چھی۔
کامے خلگے یأ مُھن آیاد آ سی انکار کیدُو دا مھوئے تھأ چیر شیرتے آنگا می داخل کونین، کے ہین چَمے دھیش دھیش تے پژنین دا مھوئے تِسی بدل می تھأئے دھوئم چام دینین مِسی کأ سے عذاب سی خوند چکھن، یقیناً اللہ زوروڑ ہُم تُھو حکمت والا ہُم تُھو۔
کامے خلگے یأ ایمان اَنو آں نیک اعمال کی، شیرتے مھوئے تھأ مھال جنت آ می داخل کونین یأ تِھن ٹیندے نھید بژنین، تھیئے مُدام مُدام سی کأ تھأمی دھرنین، تھید تِھن کأ پاکیزہ ڇھیئے ہونین، آں مھوئے تھأ پِڈ اوݜا می داخل کونین۔
(مسلمانا ہانا!) اللہ تھوئے حکم دیدو لخا امانات تِھن حقدا آ ئے واپس آوا، آں یأ تھو خلگا سی مِیئے فیصلہ کوؤ سأدو انصاف سمانے فیصلہ کوا، یقینا اللہ تھوئے کامے نصیحت کودُو دا سے چیر شیژے چھی، یقیناً اللہ ہر بات بُھویو آں پشُو والا تُھو۔
اے ایمان والا ہانا! اللہ آں تِسی رسولؐ سی بات منا، آں تھومی کآم یأ اختیار والا تھی دا (تِھن ہُم)، بھی کو تُھن مِیئے کی بأت می اختلاف ہُوو دَ کو تھو واقعی اللہ آں آخرت سی دی زید ایمان اَندیو، دَ تیس اللہ آں تِسی رسولؐ گے حوالہ کوا، أ طریقہ چیر غورا تُھو آں انجام سی اعتبار تے چیر شِژو تُھو۔
(اے پیغمبرؐ!) کئی تأ نی ڈیڈ تھأ خلک کآم یأ مے دعویٰ کودی دا لخا سے تے کتاب (قرآن) زید ہُم ایمان اَندی کامیک یأ تھیزید نازل کوا گودُو آں تیزید ہُم کامیک یأ تھأ ما مُوش نازل کوا گودُو، اَسے حالت تِھن أ چھی سے تُنو مقدمہ فیصلہ سی کأ طاغوت (شیطان) سی کأشکے نیوُ نیمادی؟ حالانکہ تھأئے أ حکم کوا گوشُو لخہ سے تِسی انکار کوئن، آں شیطان نیمادو لخا ہأ چیر دُھو سی گمراہی می اَختہ کوے۔
آں کے ہأئے بنا بژدُو لخہ تے حکم سی دِشکے یا کامیک یأ اللہ نازل کیدُو دا آں رسولؐ سی دِشکے دَ تأ منافقین پشنین سے تھأ ما پُورا مُو نرادی۔
بھی تے وخ تِھن کا حالت سوا بژژی کے یأ تِھن تُنو ہادا سی عملا سی وجہ دے ہأئے کی مصیت اَویو؟ تے وَخ سے اللہ سی قسم کھأدے چھی کأشکے ییدی یرأ مُھن مقصد غوراتوت آں ایکدوئی زید میلاؤ کوو ما علاوہ کی نہ آشو۔
أ سے (خلک) تھی یأ ہین حی آ سی ٹول بأت اللہ غورہ جندُو، اسی کأ تُو ہیئے ما امن نانگارہ کو، آں ہأئے نصیحت کو، آں تھأئے تِھن بارہ می مھال بأت بن یأ سے حی آ می وؤ والا ہوئن۔
آں مھوئے اے رسول ہُم مِیما علاوہ دوئی کی مقصد سی کأ نے پیودُو یأ اللہ سی حکم دے تِسی بات منا بژے، آں کے یأ ہیئے خلگے تُنو امن زید ظلم کشو دا، کہ تے وخ چھی کأشکے ییدے اللہ ما معافی نیمأدیشیو، آں رسولؐ ہُم تِھن کأ معافی سی دعا کیشوو دَ تھیئے اللہ چیر گھن معاف کوؤ والا آں چیر رحم کوؤ والا پانیندے۔
نأ (اے پیغمبرؐ!) چھی رب سی قسم، أ خلک تے وخا پورے کامل ایمان والا نو ہوبھادی کھیدیگا پورے سے تھأ تُنو لاد آ می فیصلہ کوؤ والا نہ سَوَن، بھی تھوئے کا فیصلہ کیو تِسی بارہ می تُنو حی آ می کی تنگی محسوس نہ کوئن، آں پورا طریقہ دے قبول کوَئن۔
آں کو مھوئے تھأزید مے بات فرض کیشیو لخا تَھو اَمن أمینے ما، یا تُنو شیرے ما نُخا، دَ ہأمی دھأک خلگے ما علاوہ یی ہُم ایزید عمل نو کونیندے، آں کامے بأت سی ہأئے نصیحت کوا بژژی دا کہ ہیئے تیزید عمل کیشُوو دَ تِھن کأ چیر غورا ہونیندے، آں زیاد ہین ایمان مضبوط کوؤ والا ہونیندے۔
آں کو ہیئے ہامُو کیشُوو مھوئے تُنو دِشا تھأئے گھن اجر دینین دے۔
آں مھوئے خامخا ہأ سیدا پَن دے اَوانین دے۔
آں کی اللہ آں تِسی رسولؐ سی بات مینیو تھیئے تھأ خلگا سیت ہونین کیزید اللہ انعام کیدُو دا، یعنی پیغامبر، سأزبَن (خلک)، شہید آں نیک خلک، آں ہے کھیدیک غورا سأت تھی۔
أ اللہ سی دِشا گھینیئی چھی، آں تِسی کأ اللہ جنو والا کافی تُھو۔
اے ایمان والا ہانا! (دشمن سی مقابلہ می) تُنو حفاطت سی سامان امن کیش تھا، بھی جدا جدا ڈلہ آ سی شکل می (جہاد سی کأ نُخا) یأ تھو ٹول ایپوت نُخا۔
آں تھومی یقیناً یامے مھال ہُم ہونین یأ (جہاد کے بژوئے) سستی پشانین، بھی کے (جہاد سی دوران) تھوئے کی مصیت اَوئیو بنین لخہ اللہ مھیزید چیر گھن انعام کی یأ آ ہأسیت موجود نا اَشُو۔
آں کو اللہ سی دِشا تھوئے کی فضل (فتح یأ مال غنیمت) اَوؤو دَ تی خامخا بنین لخہ مھاموڑ یأ تُھن آں تِھن ایکدوئی زید کی سأتویلی نأ أشی، افسوس کو آ ہُم تھأزید ہوشُوو مأ چیر گھن کامیابی پانین دے۔
اِسی کأ اللہ سی پَن دے سے خلک لات کون کی یأ دُونیئی سی جیدون آخرت سی مقابلہ می بگینوُو، آں کی اللہ سی پَن دے لات کی، بھی کو سے ما گا یا تی (لات) گھیڑیو (ہرصورت می) مھوئے تھائے چیر گھن ثواب دینن۔
(اے مسلمان ہانا!) آں تھوئے کژل ہیژی لخا تھو اللہ سی پن دے آں تھأ کمزور ماݜ و ڇھی آں لؤ آ سی کأ لات نو کودی؟ کآم یأ مے دعا کودی "اے اللہ مھو مے گام ما نیگھل کِسی خلک ظلم کودی دا، آں مھوئے تُنو دِشا کآم سأت سوا، آں مُھن کأ تُنو ڈھأرا اے مدد کوؤ والا سوا"۔
کامے خلگے ایمان انودُو دا سے اللہ سی پَن دے لات کودی، آں کآم خلک کأفر تھی دا سے شیطان سی پن دے لات کودی، دَ (اے مسلمان ہانا!) تھو شیطان سی سأدا زید لات کوا، (یادکوا) شیطان سی چال حقیقت می چیر کمزور تُھو۔
کئی تأ تھأ خلک نی ڈیڈ کیس کے یأ (مکہ سی زندگی می) بنا بژُودود لخہ تُنو ہاتھ گݜا (لات نہ کوا) آں نماز قائم کوا آں ذکواۃ دا، بھی کے ہأزید لات فرض کوا گأ دا تھأمی اے ڈلہ (دشمن) خلگے ما مھال بھیوسأت کامے بھیت یأ اللہ ما پکار چھی دا، یا تیما ہُم زیاد بھیوسأت، تھیئے بنُو: اے مُھن پروردگار! تأ مھوزید لات کئی فرض کی؟ آں تأ مھوئے دھأک وخ دُوئی مہلت کئی نی دید؟ بَن لخا دُونیئی سی فائدہ دا چیر کم تُھو، آں کامے ماݜ اللہ ما بھیت اختیار کیو تِسی کأ آخرت چیر زیاد غورہ چھی، آں تھوزید اے لُون سیم برابر ہُم ظلم کوا نہ بژنین۔
تھو کھید ہُم ہوئیو (اے نہ اے دی) مئیک تھوئے ینین، کہ تھو چیر ہُم پوخ قلعہ آ می کئی نہ دھردیو، آں کو تھأئے (منافق آ ئے) کی غوارہ اَوؤو سے بندی ہے اللہ سی دِشا تُھو، آں کو تھأسیت کی لاݜ ہُوو دَ ہے بندی ہے چھی وجہ دے ہُو، تُو بَن (اے پیغمبرؐ!) ہر کام اللہ سی دِشا ہودُو، آں ہأ خلگائے کژل ہیژی لخا ہے کئی بأت جنُو سی نھیئی ہُم نو ہودی؟
تھوئے کا ہُم غورہ اَوودُو دا سے صرف اللہ سی دِشا ہودُو، آں تھوئے کا ہُم لاݜ اَوودُو دا سے تُھن تُنو وجہ دے ہودُو، آں (اے پیغمبرؐ!) مھوئے تھأ خلگا سی کأشکے رسولؐ سوأدے پیؤدُو آں اللہ (مے بأت می) گواہی دیؤ سی کأ پورا تُھو۔
کی رسولؐ سی بات مینیو تی اللہ سی بات مینی، آں کی (اطاعت ما) مُو نرادو (اے پیغمبرؐ!) مھوئے تھأ ہأزید ذمہ وار سوا دے نے پیؤدُو۔
آں أ (منافق خلک چھی مُوش تہ) مَنُو سی بات کودی، کے ہے چھی کیأشا بھا ہیدے گئیو ہأمی دھأک خلک چھی بیادا سی خلاف ڙأت کے مشورہ کودی، اللہ تھأ بُٹ لیگدُو، اِسی کأ تو ہین پروا نو کو، آں اللہ زید بھروسہ کو، آں اللہ تُھن سأتویلی سی کأ بالکل پورا تُھو۔
کئی ہے خلک قرآن می پِھگر ما کام نی گھیندی؟ کو أ (قرآن) اللہ ما علاوہ دُوئی یسی دِشا ہُوشوو تھیئے مِس می چیر گھن اختلاف پانین دے۔
آں کے تھأئے کی بات اَمن یا بھیت سی اَوئیو ہے خلک تیس (بغیر تحقیق ما مُٹھائے) خور کودی، کو تھیئے تے (بات) رسولؐ آں تنُو اختیارمند خلگائے اَوأدیشیو دَ تھأمی کامے جنو والا خلک اشیئی دا تھیئے تِسی حقیقت معلوم کونین دے، آں کو (مسلمان ہانا!) اللہ سی فضل آں تِسی رحمت تھوزید نی ہیشیو دھأک خلگےما علاوہ ٹولے شیطان سی پأشکے ݜژنین دے۔
اِسی کأ (اے پیغمبرؐ!) تو اللہ سی پَن می لات کو، تھیزید تُنو اَمن ما علاوہ دُوئی یسی ذمہ واری نی چھی، ہاں، مومنائے (جہاد سی) وئینا کوا یے، کی دُھو نُو تُھو اللہ کأفر آ سی (لات سی) زور پھرانین، آں اللہ سی زور ٹولے ما زیات سخت آں تِسی سزا چیر زیاد سخت چھی۔
کامے ماݜ کی غورا (کم سی) سفارش کودُو دَ تیسکے تیما حصہ میلاؤ ہونین، آں کآم یأ لاݜ (کم سی) سفارش کودُو دا تیس کے تیما حصہ میلاؤ ہونین، آں اللہ ہر شیئی یے بُو والا تُھو۔
آں کو تھوئے اے ماݜ سلام دیدو تھو تیسکے تیما غورا طریقہ دے جواب دا، یا (کم از کم) اَںئی تھال الفاظا دے تھأئے جواب دا، بےشک اللہ ہر شیئی سی حساب گھینو والا تُھو۔
اللہ سے ذات تُھو یأ تیما علاوہ یام ہُم عبادت سی لائق نُو تُھو، تی خامخا تھو قیامت سی دی جمع کونین (ایگأڑ کونین؟)، تِسی (قیامت سی) ییؤ می کی شک نی چھی، آں اللہ ما زیات کسی بات سأس ہو بھاژی؟
بھی تھوئے کژَل ہی منأفق آ سی بارا می تُھن دُو ڈلہ سوا گیئدی؟ اللہ ہأ لار تھلیئیدی (کوندھلأ تھلیئیدی) ہِن بدعملی آ سی وجہ دے، کئی تھو تھأئے پان پشؤ نیمادی کیس یأ اللہ گمراہ کیدُو دا؟ آں کیما یأ اللہ پان ہژیأت چی دا تِسی کأ تأ یئت پان نہ پانین۔
سے دا اَرمان کودی تھو ہُم اِنکار کوا کھاموڑ یأ تھیئے اِنکار کیدُو دا، بھی تھو بُٹ اے شان سی سوا بژا، بس ہیئے ما تنُو سأت نہ سَوا کھیدیخانا پورے تھیئے اللہ سی پَن می ہجرت نی کیژیو، بھی کو تھیئے مُو نرادو ہأ گݜا آں کھیدی ہأ پأدو قتل کوا، آں ہأمی یام تنُو سأت نہ سَوا آں نأئی مددگار۔
ہاں سے (خلک مے حکم ما آذاد تھی) یأ تھأ خلگا سیت میلاؤ ہوئیو یأ تُھن آں تِھن مِیئے (لات نہ کوؤ سی) کی لوظ تُھوو، یا (سے خلک) تھوئے اَئیو کسی حی آ می تھوسیت لات کوؤ نُو تُھو نأئی تنُو قوم سیت لات کوؤ تُھو، آں کو اللہ نیمادُوشوو ہأ تھوزیت مسلّط کونین دے (زوروڑ کونین دے/ڙیت کونین دے؟) بھی ہیئے تھوسیت ضرور لات کونین دے، بھی کو سے تھوئے ما اَمن ڈھأر کے کیدے تھوسیت لات نہ کودیو آں تھوسیت روغہ سی بات کودیو دَ اللہ تھوئے ہأسیت لات کوؤ سی کی حق نی دیدتُو۔
مھیرے تھوئے میلاؤ ہونین دأل خلک، سے نیمادی یرأ سے تھوئے ما اَمن می دھرَن، آں تُنو قوم ما اَمن می دھرن، (اَسے) کے ہُم سے واپس کوا گئیو فساد سی دیشکے دَ سے تِسمی موتھلأ لار بژدی، کہ سے تھوئے ما اے دیشکے نُو ہوئیو آں نأ تھوسیت روغہ کوؤسأدو، آں نأئی تُنو ہات کھموُسأد لات کوؤ ما، دَ ہأ ہُم گݜا آں کھیدی تھوئے ہأ پأدو ما، ہے اَںئی سے خلک تھی تھین خلاف مھوئے (لات کوؤ سی کأ) تھوئے کولاؤ اجازت دیدچی۔
آں اے مسلمان گے جائز نُو تُھو یأ دُوئی مسلمان قتل کوئے، اَسے غلطی دے (یا شک می)، آن کی اے مسلمان غلطی دے (یا شک می) قتل کیو دَ سے اے مسلمان غلام آزاد کوئے، آں خون بہا ادا کوئے تِسی وارث آئے، ہاں کو مئیل سی وارث تیس معاف کودیو، بھی کو سے آشو تے قوم ما یأ سے تُھن دشمن تھی آں سے (أمیدے) یی مسلمان تُھوو، بھی آزاد کوئے اے مسلمان غلام، آں کو مئیل آشو تھأ خلگا ما کہ تُھن آں تِھن ایک دوئی می لوظ اَشو دا خون بہا سی ادا کوؤ تُھو تِسی وارث آ ئے آں مسلمان غلام آزاد کوئے، بھی کو غلام نہ پادو سے ڙوز تھئے دوماہ سی ایک دی پیش، أ توبہ تُھو اللہ سی دِشا، آں اللہ تُھو چیر علم والا حکمت والا
آں کی اے مسلمان قصداً موؤ، تِسی سزا دیزوخ چھی، تیمی تی مُوآ دھرنین، آں تیزید اللہ سی غضب آں لعنت چھی، آں تِسی کأ سخت عذاب تیا کیدُو۔
اے ایمان والا ہانا! کے تھو سفر کوؤ سأدو اللہ سی پَن می (جہاد سی کأ) دَ تحقیق کوا، آں کی تھوئے (اطاعت سی) سلام کیو دُونیئی سی سامان سی کأ تیس کے میس نہ بنا تُو مسلمان نُو تُھو دا، اللہ کیش غنیمت سی چیر سامان تُھو، تھو ہُم خو ایما مُوش ہامُوڑ آشیئی، بھی اللہ تھوزیت احسان کی، دَ تھو ضرور تحقیق کوا، بےشک اللہ کا تھو کودی دا تیما شِد تُھو۔
مومنا می معذوری ما بغیر (شیرا می) بھیُو والا آں اللہ سی پَن می تنُو مال آں تنُو اَمن سمانے جہاد کوو والا اے شان سی نی تھی، تُنو مال آں تُنو اَمن سمانے جہاد کوؤ والائے اللہ (شیرا می) بھیُو والائے درجہ آ می فضیلت دیدچی، دُوںیاسیت اللہ سی غورا وعدہ چھی، (اَسے) اللہ جہاد کوؤ والائے بھیوُ والا آ زیت گھن اجر سی گھینیئی دیدچی۔
تھین کأ تِسی سی دِشا گھن درجہ تھی، آں مغفرت آں رحمت چھی، آں اللہ چیر بوگوشُو والا رحم والا تُھو۔
کامے خلگے یأ تنُو اَمن سیت ظلم کیشو، آں تے حال می مُلیکا روح قبض کوؤ سی کأ اَئیدا توَس کی: "تھو کا حال می اَشیئی؟" تھیئے بنُو: "مھو دھیرین می کمزور آں مجبور اَشیئی" مُلیکائے بنُو: "کئی اللہ سی دھیرین فراخہ نے أشی تھو ہجرت کوا دے؟" دَ ہے سے خلک تھی تھین پوت دیزوخ تُھو، آں سے چیر لاݜ پوت تُھو۔
سیوائے تھأ ماݜ جوَئی آں لؤے ما (تھین می انجام نہ ہونین) کآم یأ واقعی بے وسہ اَشیئی آں تھین نُخو کی پان نہ أشی۔
بس ہأ خلگا سی کأ اُمید تُھو کہ اللہ ہأ بگوش نین، آں اللہ معاف کوؤ والا بگوشُو والا تُھو۔
آں کی یأ ہجرت کی اللہ سی پَن می، تی کولاؤ دھرین پانین آں فراخی، آں کآم یأ نوخودُو تُنو شیرا ہجرت کوئین اللہ آں تِسی رسول سی دیشکے، بھی مئیک تیسکے آبو تِسی اَجر اللہ کیش تُھو، آں اللہ چیر بگوشُو والا رحم والا تُھو۔
آں کے تھو دھیرین زیت سفر کوؤسأدو آں تھوئے مے بأت سی بھیت ہیو یرأ کأفرے تھو تینگی کونین دَ تھوزیت میمی کی گناہ نُو تُھو یأ نماز می قصر کوا، بےشک کأفر تُھن اخکارہ دشمن تھی۔
آں (اے پیغمبرؐ!) کے تُو ہین مِیئے موجود تُھو، آں تھوئے شروع کیدو ہین کأ نماز، دَ مسلمانا سی اے ڈلہ تھوسیت (پکار تُھو) ایڑی ہوئے، آں تنُو ہتھیار اَمن سیت گھینے، بھی کے تھیئے سجدہ کیو تُھن پأشکے ایڑی ہوئے، آں بھی دوئی ڈلہ کی یأ لا نماز نہ گُوزات تُو سے مُٹھائے یو، آں سے بھی تھوسیت نماز گُوزے، آں سے تنُو اَمن سیت تُنو بچاؤ سی سامان آں ہتھیار گھِنن، سے خلک یأ کافر تھی نیمادی کہ تھو تنُو ہتھیار آں سامان ما غافل ہوا، دَ سے ایک دم تھوزیت حملہ کوئن، کو آگھا سی وجہ دے تھوئے تکلیف تُھو یا تھو بیمار تھی دَ تھوزیت کی گُناہ نُو تُھو یرأ تھو تنُو ہتھیار کأن گے تھأدے چھوا، ہاں تنُو بچاؤ سی سامان اَمن سیت گھینا، بےشک اللہ تیا کیدے چھوؤدُو کأفرا سی کأ رسوا کوؤ والا عذاب۔
بھی کے تھوئے نماز پورا کیو (ہر حالت می) اللہ یاد کوا، ایڑی ہویل بھژیل آں ڈھار تھلیل، بھی کہ تھوئے تسلی ہیو نماز پورا گُوزا، بےشک نماز مسلمانا زیت وخے دے فرض تُھو۔
آں تھو ہأ خلگا سی سمالُو می کمزوری نہ پَشا، کو تھوئے تکلیف اَوودُوو ہأئے ہُم ہامُو تکلیف اَوودُو، آں تھو اللہ ما کا شیئی سی اُمید لردی دا تِسی ہے اُمید نہ لردی، آں اللہ علم والا حکمت والا تُھو۔
بےشک مھوئے مے کتاب حق سمانے تھیزیت نازل کیدو، مِسی کأ تو فیصلہ کو خلک سی مِیئے کا یأ تھیئے اللہ پشادتُو دا، آں خیانت کوؤ والا سی طرف دار نہ ہو۔
آں مغفرت نیما اللہ ما بےشک اللہ چیر بگوشُو والا رحم والا تُھو ۔
آں تُو لات نہ کو تھأ خلک سی دِشا کآم یأ خیانت کودی تنُو امن سیت، بےشک اللہ نہ خوشادو کآم یأ خیانت گر گناہگا تُھو۔
سے انسان آ ما تنُو (خیانت) بُرادی اَسے اللہ ما نُو بُرادی، حال أ چھی سے (اللہ) ڙأت کے ہأسیت تُھو کے یأ سے مشورہ کودی تھأ بأدا سی کا یأ اللہ نہ خوشادُو، آں ہے کا کودی دا اللہ تے بُٹ سی چاپیرا تُھو۔
بُوادا! تھو سے خلک تھی کی یأ لات کی تِھن دِشا دونیئی سی جیدون می، دَ قیامت سی دی ہین دِشا اللہ سیت کی لات کونین؟ یا ہین حمایت کوؤ والا کی ہونین؟
آں کی یأ لاݜ کام کی یا ظلم کی اَمن زیت، بھی اللہ ما معافی نیمأد دَ تی پانین اللہ چیر بوگوشُو والا رحم والا۔
آں کآم یأ گناہ کودُو، بےشک سے گناہ کودُو تُنو اَمن زیت، آں اللہ چیر علم والا حکمت والا تُھو۔
آں کام یأ غلطی یا گناہ کودو بھی سے ݜیادو تیسی کسی بے گناہ زیت نہ کی بےشک تھلو تُنو کا ناریت بہتان آں گناہ احکارہ۔
آں کو اللہ سی فضل آں تِسی رحمت تھوزیت نی ہیشیو ہأمی اے ٹولی دا پوخ ارادہ کیشی یرآ تھیکیژا پان ہاڙژے، (اصل می) ہے اَمن ما سیوا دُوئی یِسی پان نہ ہڙابھؤدُود، آں تھیئے کی نقصان نہ اَووبھوؤدُود، آں اللہ نازل کیدو تھوئے زیت کتاب آں حکمت، آں ڇھیڙادتُو تھوئے کا یأ تھو نہ جنودُود، آں اللہ سی فضل تھوزیت چیر تُھو۔
خلگا سی اکثر بیریت بأدا می خیر سی کی بات نہ ہوژی، ہاں کو یام صدقہ یا نیگی یا خلگا سی میِئے روغہ جوڑا سی کی بات کوؤسأدو (سے غورا بات چھی)، کامے ماݜ اللہ سی رضا سی کأ مھال کام کوؤسأدو مھوئے تیسکے گھن اَجر دینین۔
آں کامے ماݜ تنُو مُشکے اخکارہ ہدایت معلوم ہوؤ ما بعد ہُم رسولؐ سی مخالفت کوؤسأت، آں مسلمان آ سی پَن ما علاوہ دُوَئی پَن دے تِلوسأدو مھوئے تیس اَںئی تے پَن زیت چھونین کامے پان یأ تی گأدچی دا، آں تیس دیزوخ وا تھلنین، سے چیر لاݜ پوت تُھو۔
بےشک اللہ مے بات معاف نہ کودُو یأ تِسیت یام شریک کوا ہژے، ایما علاوہ ہر کی معاف ہوبھادُو کیس یأ سے نیمؤسأدو، آں کآم یأ اللہ سیت یس شریک کودو سے گمراہی می چیر دُھو گادُو۔
ہے اللہ چھیدے یِس ما نیمادی دا سے جوَئی بُھوت تھی، آں کیس کے ہاگادی دا سے باغی شیطان تُھو۔
تیزیت اللہ لعنت کیدُو آں تی (اللہ ئے میس) بنُودو "مأ چھی بنے ما اے ڈے ضرور گھننین"۔
"آں مأ ہأ گمراہ کونین، آں ہأئے طم دینین، آں مأ ہأئے حُکم دینین دَ ہیئے زیناوَرا سی کن پھالنین، آں مأ ہأئے حکم دینین دَ ہیئے اللہ سی پیدا کویل شیئی نھانین، دَ کامے ماݜ اللہ سی پوت شیطان ما دوست سَوات تہ تی اخکارہ نقصان کی۔
سے ہأسیت وعدہ کودُو، آں تھأئے طم دیدُو، اَسے سے کا وعدہ کودُو دا سے دوکا ما علاوہ کی نہ ہودُو۔
ہے سے خلک تھی یأ تِھن پوت دیزوخ تُھو، آں ہأئے تیما ڈیؤ سی کی پان نہ ہونین۔
آں سے خلک کی یأ ایمان آنو آں نیک عمل کی تھأ مھوئے مھال باغا می داخل کونین تھین ٹین نھید بژنین، آں تھیئے تھیت ہمیشہ ہمیشہ سی کأ ہونین، أ اللہ سی سأزأل وعدہ چھی آں اللہ ما زیات تنُو بأت می کآم سأزأل ہوبھادُو؟
نأ تُھن اَرمان آ سی بات چھی نأئی کتاب سی خلگا سی اَرمان، کی ہُم لاݜ کیو تیس کے تِسی بدل میلاؤ ہونین، آں تیسکے اللہ سی مقابلہ می نأ سأت میلاؤ ہونین نأئی مددگار۔
آں کی نیک عمل کیو، سے ماݜ تُھو کو جوَئی چھی، آں سے ایمان سی حال می تُھوو، دَ ہیئے خلگے جنت می داخل ہونین، آں تھأسیت کجُور سی أنی سی ڇِک سیم ہُم زأتیئی نہ ہونین۔
آں تے ماݜ ما غورہ کسی دین ہونین، کی یأ اَون اللہ ئے حوالہ کی، آں سے نیگی زیت اِڑی ہوئیل ہُم ہُوو، آں حی سی صدق تے ابراہیمؑ سی طریقہ دے تِلوُو، تے ابراہیمؑ سی طریقہ دے کیس یأ اللہ تنُو خاص سأت سَوادُوشُو۔
آں (ہر کی) اللہ سی تُھو، کا آسمانا می تُھو آں کائی دھیرین می تُھو، آں ہر شیئی سی چاپیرہ اللہ سی باچیئی چھی۔
آں ہے تھو ما توَس کودی جوَئی آ سی بارہ می، تھو بنا اللہ حکم دیدُو تھوئے ہِن بارہ می، آں کھأکأ یأ تھوئے بنا بژدُو قرآن می تھأ یتیم سیرأن آ سی بارہ می کیس کے یأ تھو تھین مقرر کویل حق نہ دیدی، آں تھو تھأ سیت نکاح کوؤ ہُم نیمادی، آں تھأ غریب جدگا سی بارہ می (اللہ تھوئے حکم دیدُو)، آں مے بارہ کہ تھو ایڑی ہوا یتیما سی معاملہ می انصاف زیت، آں کا نیگی یأ تھو کودی دا اللہ تیما غورہ شِید تُھو۔
آں کو جوَئی یے تُنو کھمن ما سختی یا بے پرواہی سی بھیت ہیو، دَ دُوں زیت کی گناہ نہ تُھو کہ سے جوڑا کوئن ایک دوئی سیت، آں جوڑوخ غورہ بات چھی، آں (انسان سی) نفس می دا لالچ تھئیل چھی، آں کا تھوئے نیگی کی آں پرہیزگاری کیو دَ بےشک کا عمل یأ تھو کودی دا تیما اللہ غورہ شِید تُھو۔
آں تھو یئت نہ جوَئی آ سی مِیئے برابری نہ کوبھادی، تھو کو چیر ہُم نیمؤسأدو، بس بُٹ پِھگر ایک سی دِشکے نہ کوا مھامُو یأ (ہوا می) لھمیل، کو تھوئے اَمن ٹِک کی آں (اللہ ما) بِھیئی دَ بےشک اللہ چیر بگوشُو والا رحم والا تُھو۔
آں کو ہے ایکدُوئی ما جدا ہوئیو دَ اللہ غنی کونین ہر ایک تُنو فضل دے، آں اللہ فراخی والا حکمت والا تُھو۔
آں اللہ سی تُھو کا یأ آسمانا می تُھو آں کا یأ دھیرین می تُھو، آں مھوئے حکم دیدُوشو تھأئے کیس کے یأ کتاب دیا گوشُو تھوئے ما مُوش آں تھوئے ہُم، کہ بھیا اللہ ما، آں کو تھوئے انکار کیو دَ بےشکہ اللہ سی تُھو کا یأ آسمان آ می تُھو آں کا یأ دھیرین می تُھو، آں اللہ چیر بے نیاز صفت سی قابل تُھو۔
آں (ہر کی) اللہ سی تُھو کا یأ آسمان آ می تُھو آں کائی دھیرین می تُھو، آں اللہ کم آ سی سَوؤ سی کأ کافی تُھو۔
آں کو تی نیمادو اے خلگا ہانا! تھو بُٹ دُونیئی ما نئی نین آں دأل (تُھن پوت) آنین، آں اللہ مے بأت زیت قادر تُھو۔
کآم یأ دُونیئی سی ثواب نیمادُوو اللہ کیش دُونیئی و آخرت سی (دُوںیا سی) ثواب تُھو، آں اللہ (ہر بأت سی) بُھویو والا پشو والا تُھو۔
اے سے خلک ہانا کی یأ ایمان اَنودُو، انصاف قائم کوؤ والا سَوا بژا، گواہ ہوا اللہ سی کأ، کو سے گواہی تُھن خلاف چھی یا تُھن یئی و بوپ آں رشتہ دار آ سی (خلاف)، کہ چرے سے مالدا تُھو یا غریب، دَ اللہ دُوںیائے نھیو تُھو، بس تھو تابعداری نہ کوا نفسانی خواہش سی یرأ تھو دُھو ہوا (حق ما)، آں کو تھوئے (گواہی می) گڑبڑ کی یا ڈھأر کے ہُوئی، دَ بےشکہ اللہ غورہ شِید تُھو کا یأ تھو کودی دا۔
اے ایمان والا ہانا! ایمان آنا اللہ و تِسی رسول زیت، آں تے کتاب زیت کامیک یأ نازل کیدُو تُنو رسول زیت، آں تے کتاب زیت کامیک یأ نازل کیدو ایما مُوش، آں کآم یأ انکار کودُو اللہ ما آں تِسی فرشتائے ما آں تِسی کتابے ما آں تِسی رسولے ما آں آخرت سی دی ما، سے گمراہ ہودُو چیر دُھو سی گمراہی می۔
بےشکہ سے خلک کی یأ ایمان اَنو، بھی کفر کی، بھی ایمان اَنو، بھی کفر کی، بھی زیاد ہوئی کفر می، اللہ تھأ معاف نہ کونین، آں نأئی ہأئے پان پشانین۔
زیرے دے منأفقآئے کہ ہین کأ سخت عذاب تیا تُھو۔
کآم (منأفق) یأ مسلمان چھیدے کأفرے ما دوست سَوادی، کئی ہے ہین کأش کے عزت بیرڈی؟ بےشکہ عزت تہ بُڑ اللہ سی چھی۔
آں تی تھوئے کتاب می (مے حکم) نازل کیدو یرأ کے تھوئے بُد یأ اللہ سی آیادا ما اِنکار کوا بژدُو، آں تِسی پِشاڑے کوا بژژی، دَ ہأسیت تھیدیخانا پورے نہ بھیا یأ سے دأل بأدا می نہ ݜأدو، (ہاموڑ نی کیو) تَھلا تھوئے ہُم ہین شانے ہونین، بےشکہ اللہ بُٹ منأفق آں کأفر جمع کوؤ والا تُھو دیزوخ می۔
(أ منأفق خلک) سے تھی یأ تُھن انتظار می بھژیل تھی، کو اللہ سی دِشا تھوئے برئ ہیو تھوئے بننین: "کئی مھو نہ آشیئ تھوسیت؟" آں کو کأفرآئے برئ ہیو بننین: "کئی مھو تھوسیت لات نہ کوبھؤدُود؟ آں مھوئے تھو مسلمانا ما بچ نہ کی؟" بس اللہ تُھن و ہین مِیئے فیصلہ قیامت سی دی کونین، آں اللہ کأفرآئے مسلمانا سی مقابلہ می کی پان نے دینین۔
بےشک أ منأفق اللہ سیت چَھل کودی، (حالانکہ) سے ہأسیت چَھل کودُو، آں کے سے نماز کے ایڑی ہُوئیو کُسین ایڑی ہودی، خلگائے پشؤ سی کأ، آں سے اللہ یاد نہ کودی اَسے چیر کم۔
(ہے کفر و ایمان سی مِیئے) حیرانگی می بھژیل تھی، نأ اِتکےسی تھی آں نأ پتکے سی تھی، آں اللہ یأ کیس گمراہ کودُو دا تِسی ہدایت سی کأ تھوئے پان یئت نہ پانین۔
اے ایمان والا ہانا! مسلمان چھیدے کأفر تنُو سأت نہ سَوا، کئی تھو نیمادی یرأ اللہ یے تُھن خلاف (عذاب سی کأ) کولاؤ وجہ میلاؤ ہوئے؟
بےشکہ منافق (خلگے) دیزوخ سی ٹولا ما ٹین سی درجہ می ہونین، آں تأ ہین کأ یام مددگار نہ پانین۔
اَسے کی یأ ہأمی توبہ نیگھألیو، آں تنُو اصلاح کی، آں اللہ سیت اَمن مضبوطی دے گات، آں تنُو دین اللہ سی کأ خالص کیو، دَ بھی ہیئے خلگے مومنا سیت شامل ہونین، آں اللہ مومنائے گھن اَجر دینین۔
کژَل کونین اللہ تھوئے عذاب دیدے، کہ تھوئے شکر نِگھلو آں ایمان اَنُوو؟ آں اللہ چیرگن قدردان علم والا تُھو۔
اللہ لأݜ بأت ڇأڑیدے کوؤ نہ خوشادُو، اَسے کیزیت یأ ظلم ہودُوو، آں اللہ بُھویو والا جنُو والا تُھو۔
کو تھو نیگی اخکارہ کودی یا تیس بُرادی، یا کآں بدی معاف کودی، دَ اللہ چیر معاف کوؤ والا تُھو (حالانکہ سزا سی دیؤ زیت) قدرت لرُو والا تُھو۔
بےشکہ سے خلک یأ انکاری اللہ سی آں تِسی پیغمبرا سی، آں اللہ آں تِسی رسول آ سی میِئے فرق کوؤ نیمادی، آں بندی مھو زینی آ زیت ایمان اَندی آں زینی آ زیت ایمان نہ اَندی، ہے کفر و ایمان سی مِیئے اے پان نیگھالُو نیمادی۔
ہے خلک پوخ کأفر تھی، آں مھوئے کأفرا سی کأ ذلیل کوؤ والا عذاب تیا کیدُو۔
آں سے خلک کی یأ اللہ زیت آں تِسی پیغمبرا زیت ایمان اَنو، آں تھین مِیئے فرق نی کی، دَ ہے سے خلک تھی مھوئے جلد ہأئے ہین بدل دینین، آں بےشک اللہ بگوشُو والا رحم کوؤ والا تُھو۔
کتاب سی خلگے تھیئے بننین تُو آسمان ما تھأزیت کتاب نازل کو، تھیئے موسیٰؑ یے ایما ہُم گھین بأت سی بنُوشو، تھیئے بنُوشو تُو مھوئے اللہ اخکارہ پشا، تھین نافرمانی سی وجہ دے ہأ اے تندر گأت، بھی تھیئے باس ما معبود سَوات، مِما بعد کہ ہأئے اخکارہ دلیل اَئیشی، بھی ہُم مھوئے ہأ معاف کی، بھی مھوئے موسی یے اخکارہ اقتدار دید۔
آں مھوئے طور (سی کھان) ہأزیت اِڑی کیدے ہأ ما اقرار گھن، آں مھوئے بنوشُو (خار سی) دروازیدے سجدہ کوئین (عاجزی دے) لھنگا، آں مھوئے بنوشو ہأئے کہ زیأتیئی نہ کوا لؤ آنگا سی دی (سبت کے)، آں مھوئے ہأما پوخ لوظ گھین۔
دَ تھلا ہین لوظ پھرؤ سی وجہ دے آں مے وجہ دے یرأ ہیئے اللہ سی آیادے ما انکار کی، آں پیغمبر ناحق موئی، آں میس ہُم بنُو کہ مُھن حی آ زیت پردہ تُھو، حالانکہ اصل می ہین کفر سی وجہ دے اللہ ہین حی آ زیت مہر ݜژات، کھأئیمُو ہے چیر کم ایمان اَندی۔
ہیئے تنُو کفر سی وجہ دے آں تنُو بأدیدے مریمؑ زیت گھن بہتان ݜژات۔
آں ہین مے بأدیدے یرأ "مھوئے مریمؑ سی پو عیسیٰؑ موؤشُو"، اللہ سی رسول، حالانکہ ہیئے تیس نہ موؤشُو آں نأئی تیس صلیب زیت اُگھلوشُو، اَسے ہین غلط فہمی أشی، حقیقت می کی یأ اے بارہ می اختلاف کیدُو دا سے شک وا گئیدی، گمان سی تابعداری کوؤ ما علاوہ تھأ کیش کی علم نُو تُھو، یقیناً تھیئے (یہودیئے) تیس نہ موؤشُو۔
بلکہ اللہ تیس تنُو دِشکے اُچات کیشُو، آں اللہ غالب حکمت والا تُھو۔
آں اہل کتاب ما یی مھال نو ہونین یأ تی تنُو مئیک ما مُوش مے بأت زیت (یعنی حضرت عیسیؑ سی سأسبن ہوؤ زیت) ایمان نہ اَننین، آں قیامت سی دی تی تھأ زیت گواہ ہونین۔
بس یہودی آ سی ظلم سی وجہ دے مھوئے تھأزیت تھأ پاک شیئی ہُم حرام کی کآم یأ تھأزیت مُوش حلال اَشیئی دا، آں مے وجہ دے یأ سے خلک اللہ سی پَن ما چیر منع کوؤدُود۔
آں سے سود گینودُود حالانکہ تیما سے منع کوا گئیشی، آں خلگا سی مال ناجائز طریقہ دے کھوؤدُود، آں ہأمی یام کأفر تھی دا تھین کأ مھوئے سخت عذاب تیا کیدُو۔
اَسے کآم یأ علم می پوخ تھی ہأمی، آں مومن تھی، سے تے (کلام) زیت ہُم ایمان اَندی کا یأ تھیزیت نازل کوا گودُو، آں تیزیت ہُم کا یأ تھأ ما مُوش نازل ہودُو، آں صفت سی قابل تھی سے خلک یأ نماز قائم کودی، ذکواۃ دیدی، آں ایمان اَندی اللہ آں آخرت سی دی زیت، ہے سے خلک تھی جلد مھوئے ہأئے گھین بدل دینین۔
بےشک مھوئے وحی کیژی تھوزیت، کھاموڑ مھوئے وحی کیشی نوحؑ زیت، آں تیما بعد سی پیغمبرا زیت، آں مھوئے وحی کیژی ابراہیمؑ آں اسماعیلؑ آں اسحاقؑ آں یعقوبؑ آں تھین اولاد زیت آں عیسیٰؑ آں ایوبؑ آں یونسؑ آں ھارونؑ آں سلیمانؑ زیت، آں مھوئے داؤدؑ کے زبور دیدوشُو۔
آں چیر رسول تھی تھین حال مھوئے تھوئے مُوش بیان کیژی، آں چیر رسول تھی تھین حال تھوئے بیان نی کیژی، آں موسیٰؑ سیت اللہ مخامخ بأت کیشی۔
(ہے بُٹ) پیغمبر (جنت سی) زیرے دیؤ والا آں (دیزوخ ما) بھیٔو والا پیا گئیشی، مِسی کأ یرأ پیغمبرا سی پیؤ ما بعد خلگا کیش اللہ سی مُشکے کی عذر نہ ہوئے، آں اللہ چیر زبردست حکمت والا تُھو۔
اَسے اللہ کا یأ تھیزیت نازل کیدُو دا تِسی گواہی دیدُو، یرأ تی ایس تنُو علم دے نازل کیدُو، آں مُلیکا (ہُم) گواہی دیدی، آں گواہی سی کأ اللہ پورا تُھو۔
بےشک کآم خلک کفر کودی، آں اللہ سی پَن ما منع کودی، بےشک سے گمراہی می چیر دُھو گئیدی۔
بےشک کآم خلگے انکار کی آں ظلم کی اللہ ہأ معاف کوؤ والا نُو تُھو، آں نأئی تھأئے کی پان پَشؤ والا تُھو۔
اَسے صرف جہنم سی پان تیمی ہیئے ہمیشہ ہمیشہ کأ دھرنین، آں أ اللہ سی کأ آسان کام تُھو۔
اے خلگا ہانا! تھوئے رسولؐ حق دین گِھیندے تُھن رب سی دِشا اَپ تُو، بس ایمان اَنا ہے تُھن کأ غورہ تُھو، آں کو تھوئے اِنکار کیو (میس جَنا یرأ) بےشک ہر کی اللہ سی تُھو، کا یأ آسمانا می تُھو آں کا یأ دھیرین می تُھو، آں اللہ علم والا حکمت والا تُھو۔
اے کتاب سی خلگا ہانا! حد ما نہ لھنگا تُنو دین می، آں نہ بنا اللہ سی شان می حق ما علاوہ کی بات، بےشک مسیح عیسیؑ مریم سی پو صرف اللہ سی رسول اَشُو، آں تِسی کلام، تیس تی اَوادوشُو مریمؑ گے، آں اے رُوح چھی تِسی دِشا، بس ایمان آنا اللہ آں تیسی رسولا زیت، آں (اے خدئی یے) ڇا نہ بنا، قلار ہوا (تنُو غلط عقیدہ ما)، بہتر تُھو تُھن کأ، بےشک اللہ دا ایک تُھو عبادت سی لائق، سے مے بأت ما پاک تُھو یأ تِسی کی اولاد ہوئے دا، تِسی تُھو کا یأ آسمانا می تُھو آں کا یا دھیرین می تُھو، آں اللہ کافی تُھو کام سَوؤ والا۔
مسیحؐ یئت شرم نی کی مے بأت می یأ سے اللہ سی بَن تُھو، آں نأئی اللہ یے نھیو مُلیگے (مے بأت می شرم کی)، آں کآم یأ شرم کودُو تِسی بندگی ما آں لوئی کودُو، بس (اللہ) جلد جمع کونین تھأ ٹول تُنو کأشکے۔
دَ بھی کآم خلگے ایمان اَنُو آں غورہ عمل کییو تھأئے پورا پورا اَجر دینین، آں تنُو فضل دے تیما ہُم زیاد دینین، دھرئی سے خلک کی یأ شوم کی (بندگی ما) آں لوئی کی دَ ہأئے سخت عذاب دینین، آں تھیئے اللہ ما علاوہ نہ پانین تنُو کأ کی دوست نأ مددگار۔
اے خلگا ہانا! بےشکہ تھوئے تُھن رب سی دِشا اخکارہ دلیل أپ چی، آں تُھن دِشکے اے روخانہ لوش نازل کیدُو۔
دَ کآم خلگے ایمان اَنُو اللہ زیت آں تیس جُوختہ گات، اللہ تھأ تنُو فضل آں رحمت می داخل کونین، آں تھأئے تنُو اَمن گے اوؤ سی کأ سیدا پان پشانین۔
(اے پیغمبرؐ!) خلک تھأ ما توس کودی، بَن: اللہ تھوئے کلالہ سی بارہ می حکم دیدو، کو یام میرات (بے اولادا) مُو تھوئے ما، آں تِسی اے شُو ہیو، تیس کے تِسی میراث ما اَر (ڈے) میلاؤ ہونین، آں کو شُو بے اولادا مُوئیو بھَئی گے تِسی میراث میلاؤ ہونین، آں کو مئیل سی میراثی دُو شی تھیو، دَ تھیئے میراث سی ڇا آ ما دُو ڈے آ سی حقدا ہونین، آں کو چیر شی و بھئی ہُوئیو دَ جوَئی آ سی ایگُن آں ماݜ آ سی دُو گُن ڈے ہونین، اللہ تُھن کأ احکام کولاؤ کودُو تاکہ تھو گمراہ نہ ہوا، آں ہر شیئی سی پُورا علم لردُو۔
اے ایمان والا ہانا! تُنو وعدہ پورا کوا، تُھن کأ څاروَئی جائز کوا گئیدی، علاوہ تِما تھین حکم مُٹھائے تھوئے بنا بژنین، اَسے کے تھو احرام سی حالت مے ہُوئیو نأجی جائز نہ گھنڈا، بے شک اللہ ئے کا غورا معلوم‌ ہُوؤ تے حُکم دیدوُ۔
اے ایمان والا ہانا! اللہ سی نَخا سی بےحرمتی نہ کوا، نأئی حرمت والا ما سی (بے حرمتی کوا)، نأئی حرم سی اندرے قربانی سی څاروئیا سی (بے حرمتی کوا)، نأئی تھأ څاروئیا سی کِسی ماڑ وا گڑن تَھلا گودو (پیانُو سی کأ)، نأئی بیت اللہ سی دِشکے بژو والا خلگا سی، سے تُنو رَب سی خوشألی آں فضل نِمادی (بے حرمتی کوا)، آں کے تھو احرام ما فارغ ہُوئیو بھی تھو نأجی کو بھادی، آں کآم قوم سی دشمن تُھو مے بأت زید راضی نہ کوئے یرأ تھو تھأ زید زیأتیئی کوا، صرف مے وجہ دے یرأ تھیئے تھوزید اللہ ما (اللہ سی‌شیر ما) تھو کَھمِئیشی، آں تھو ایک دُوئی سید تعاون کوا، نیگی سی کما ‌می آں پرہیزگاری سی کما می، آں مدد نہ کوا ایک دوئی سی گناہ آں لاݜ کما می، آں اللہ ما بھیا، بے شک اللہ سَخ عذاب دیوؤ والا تُھو۔
تھوزید حرام کوا گئیدی، مُردا څاروئی ڙاد آں خنزیر سی ماس، آں سے څاروئی یرأ تھأزید اللہ سی نام ‌ما علاوہ نام گِھنا گودُو، آں سے څاروَئی یرأ سے مری چیووُ دے ما گودوُ، آں سے څاروَئی کامیک یأ زخم سی وجہ دے (مُودُو)، آں سے څاروَئی یأ سے اُوڑولُودے (مُودُو)، آں سے څاروَئی یرأ سے ݜینگ سی وجہ دے مُودُو، آں سے څاروَئی تھأ لیووُئے مأدے کھئیدیو، سیوائے سے څاروَئی کامیک یأ تھوئے ذبح کِیدیو (جائز تھی)، آں سے څاروَئی ہُم حرام تھی کآم یأ بُت خانہ می ذبح کوا گئیدیو، آں أ بات ہُم تُھن کأ حرام چھی یرأ تھو جوأری سی تیر دے (ماس وغیرہ تقسیم کوا)، أ تُھن کأ سخ گُناہ تُھو، آش کأفر تُھن دین ما نااُمیدہ ہوئیدی، بس تھو تھیئے ما نہ بھیا آں مھأ ما بھیا، آژوک دیے مأ تُھن کأ تُھن دین مکمل کی، آں مأ پُورا کی تھوزید تنُو نعمت، آں مأ خوشاد تُھن کأ دین اسلام، آں بھی کامے ماݜ بِݜ سی وجہ دے بالکل مجبور ہُوو (سے مھأ حرام شیئے ما دھأگ کھا بھادُو) شرط أ چھی یرأ سے گُناہ سی شوق تے نہ کوے، بے شک اللہ چیرگن معاف کوؤ والا آں گھن مہربان تُھو۔
(اے پیغمبرؑ!) خلک تھأما توَس کودی کآم کآم شیئی تھین کأ حلال تھی، بَن ہأئے یرأ پاک شیئ تُھن کأ حلال تھی، آں نأجی سی زیناوَر تھأ تھوئے دامئیودی، تھأ تھو نأجی سی کأ پیدی، آں کامے علم تھوئے اللہ دیدتُو تِسی مطابق تھین تربیت کوا کہ مھال نأجی سی زیناوَر تھوئے نأجی گیݜتے آنے و سے تُھن کأ (حلال تھی) تیس کھا، نأجی سی زیناور آ زید (نأجی پیؤ سی وَخ می) اللہ سی نام گِھنا، آں اللہ ما بِھیا بے شک اللہ چیر جلد حساب کوؤ والا تُھو۔
آش تُھن کأ (ٹول) پاک شیئی حلال کوا گئیدی، آں کیسکے یأ کتاب دیا گودو دا تھین کھوؤ ہُم تھوزید حلال تُھو، آں تُھن کھوؤ تھأزید حلال تُھو۔ آں مومن آ سی صفا جَوئی آں کیسکے یأ تھوما موش کتاب دیا گودو دا تھین صفا جَوئی ہُم (بیوا سی کأ حلال تھی)، کو تھوئے تھأئے تھین مہر دِیدو نکاح سی ارادہ دے، نہ کہ بدکاری سی ارادہ دے، یا (بِرید) یأری (سی ارادہ دے)۔ آں کی ہُم ایمان (سی بأدا) ما انکار کِیو تِسی عمل ضائع ہُو، آں آخرت می تی تاوانی خلگا می ہونین۔
اے ایمان والا ہانا! تھو کے نماز کے بھا ہُویو تُنو بود دھوا، آں تُنو ہات ٹِھیا پورے (دھوا)، آں تُنو ݜا سی مَسح کوا، آں تُنو کُھو ݜئی آ پورے دھوا، آں کو تھو جُنابت می آشِیو غسل کوا، آں کو تھو ناژور آشِیو یا دُھو سفر می آشِیو یا تھوئے ما یام قضائی حاجت ما (مُݜ کیدے) آبوشوو یا تھوئےتونو جَوئی آ سید ہُوشوو آں تھوئے اُو میلاؤ نُو ہوو تَھلا پاک سُم دے تیمم کوا، آں تے سُم دے تُنو مُو آ سی آں ہادا سی مَسح کوا، اللہ تھوئے کی بُوکھیئی نو کودوُ، اَسے اللہ نیمادو یرأ سے تھو پاک ساتے، آں تھوزید تُنو نعمت پُورا کوئے، مِسی کأ یرأ تھو اللہ سی شکر نِگھلا۔
آں اللہ تھوزید کامے احسان کیدی دا تھأ یاد کوا، آں تے وعدہ ہُم یاد کوا کامے (وعدہ) یأ تھوئے ما گِھن چی، کے یأ تھوئے بنُوشو (اسلام سی دعوت) مھوئے بِیت آں قبول کی، اللہ ما بِھیا، اللہ حِیا سی بأدے ما شِید تُھو۔
اے ایمان والا ہانا! اللہ سی حقوق قائم کوؤ والا آں انصاف سی گواہی دیوؤ والا ہوا، آں اے قوم سی دشمنی تھو می بأت زید راضی نہ کوئے یرأ تھو انصاف نہ کوا، تھو انصاف کوا ہے پرہیزگاری سی بات چھی، آں اللہ ما بِھیا، بے شک اللہ تُھن اعمالے ما واقف تُھو۔
کامے خلگے ایمان اَنُو آں نیک عمل کی تھأسیت اللہ وعدہ کِیژی بوگوشُو سی آں گھن اَجر سی۔
آں کامے خلگے کفر کِیدو آں مُھن آیات لَوو گھنڈی دی سے خلک جہنمی تھی۔
اے ایمان والا ہانا! اللہ سی تھأ نعمت یاد کوا کامے نعمت یأ تھوزید کِیدی دا، کے یأ دھأک خلگے تھوزید حملہ سی ارادہ کی دَ اللہ تھو تے حملہ ما بچ کی، آں اللہ ما بِھیا، آں مسلمانائے پکار تُھو یرأ سے اللہ زید بھروسہ کون۔
آں بے شک اللہ بنی اسرائیل ما وعدہ گِھن، آں تِما مھوئے دوآش سردار مقرر کی آں اللہ بنُو (اے بنی اسرائیل) آ تھوسیت تُھو، آں کو تھوئے نماز قائم کی زکواۃ دید آں مھی پیغمبرا زید ایمان اَنو آں تِھن مدد کی آں اللہ ئے قرض دید (اللہ سی پَن می مال خرچ کی)، دَ یقین کوا مأ تُھن گناہ معاف کونین، آں مأ تھو مھال باغا می داخل کونین تھین مِیدے نھید بژنین، اِما بعد ہُم کو یی کُفر سی پان اختیار کیو بے شک سے سِدا پَن ما خطا ہُو۔
تِھن وعدہ خلافی سی وجہ دے تھأ مھوئے لعنتی کی، آں تِھن حی مھوئے سخ کی، سے (کتاب سی) الفاظ تُنو اصلی پوت ما بدل کوؤسأد، آں تھأئےکا نصیحت کوا گیشِدا تِسی گھن حصہ تھیئے اَموݜا تھلُو، آں دھأک خلگے ما علاوہ ہین خیانت سی تھیئے اطلاع ہوا ینین، دَ (اے پیغمبرؐ) تو ہأ معاف کو، ہین پروا نہ سات، بےشک اللہ احسان کوؤ والا خوشادوُ۔
آں سے خلک کآم یأ بنَدی مھو نصارٰی تھی مھوئے تھأما ہُم وعدہ گِھنیشی، دَ تھیئے ہُم نصیحت سی گھن حصہ اَموݜا تھلُو کامے نصیحت یأ تھأئےکوا گیشی، دَ مھوئے تِھن ایکدی می دشمنی أنی آں بُغض پیدا کی، آں چیر جلد اللہ تھأئے بَننین کا یأ سے کوؤدُودتا۔
اے کتاب والا ہانا! بےشک مُھن رسول تُھن کأشکے اَپ تُو، کتاب ما تھأ چیر بأت تھوئے واضح بیان کودوُ کامیک یأ تھو بورؤدُودتا، آں چیر بأت معاف ہُم کودوُ، بےشک اللہ سی ڈھأرا تھوئے لوش آپ تُو آں واضح کتاب ہُم آپ تُو۔
تِسی ذریعہ دے اللہ تھأ خلگائے سلامتی سی پَن پشادوُ کآم یأ تِسی رضامندی سی طلبگار تُھو، آں سے (اللہ) تُنو ارادہ دے تھأ خلک أنچیک ما نِھگلدوُ لوش سی ڈھأر کے، آں تھأئے سِدا پان پشادو۔
بےشک تھیئے خلگے مے بات بیندے کفر کی یرأ اللہ مسیحؑ مریمؑ سی پو تُھو، (اے پیغمبرؐ!) تو بَن: "تھلا کآم اللہ کَھم بھادو کو تی عیسٰیؑ مریمؑ سی پو، آں تِسی یئی آں بُٹ دونیئی سی خلک ہلاک کیو؟"، آں اللہ سی حکومت چھی آسمان آ زید آں دھیرین زید، آں ہأ دوُںئی آ سی مِیئے کا تُھوو، سے کا نیمادُوو تیس پیدا کودوُ، سے ہر شیئی زید وَس لردو۔
آں یھودی و نصارٰی بَندی مھو اللہ سی جدک تھیا، آں تِسی نازبین آں خوشیل تِھیا، (اے پیغمبرؐ) ہأئے بن تھلا اللہ تُھن گناہا سی وجہ دے تھوئے عذاب کئی دیدوُ، بلکہ اللہ دأل کھال انسان پیدا کیدیو تھو ہُم تھال انسان تھی، یام اللہ نِمادوُو بُوگوشَدو آں یامائے سزا دیدوُ، آسمان آں دھیرین آں کا ہین مِیئے تُھو ٹولا زید اللہ سی حکومت چھی، آں تِسی دِشکے واپس بَژو تُھو۔
اے کتاب والا ہانا! بےشک تُھن کأشکے مُھن پیغمبرؐ آپ تُو، سے اللہ سی حُکم تھوئے واضح واضحہ بیان کودوُ حالانکہ دأل پیغمبرا سی یِیوؤ بان ہُودو، بھی تھو میس نہ بنا یرأ مُھن کأشکے نأ زیرے دیؤ والا آپ تُو نأئی بِھیوؤ والا، بُوا تُھن کأشکے اَگا زیرے والا آں بِھیوؤ والا آپ تُو، آں اللہ ہر شیئی زید قادر تُھو۔
(تے وخ یاد کوا) کے یأ موسٰیؑ تُنو قوم گے بنُو اے قوم! اللہ تعالٰی سی تھأ انعامات یاد کوا کامیک یأ تی تھوزید کِیدی، کے یأ تھوئے ما پیغمبر پیدا کی، آں تھو ما باچا سوأد، تھوئے تھأ شیئی دید کا شیئی یأ دونیئی می دوئی یِسکے نی دیدیشی۔
اے مھی قوم! مے مقدس دھرین می داخل ہوا کامیک یأ اللہ تُھن کأ لگیژی ، آں پِڑ گأدے نہ ڈیآ، نأؤ تاوان دے واپس ہونین۔
کئیدا اے موسٰیؑ! ہیت تا چیر ناڑاما خلک تِھی، مھو یئیت ہُم ہیتکے داخل نہ ہودی کِھیدیخانہ پورے ہے تھیدا نی نِگھأدتِیو، ہاں کو سے تھیدا نِگھأدو مھوئے تَھلا داخل ہونین۔
(مے موقع زید) اللہ ما بِھیو والا دو جَنے بنُوکامیک زید یأ اللہ انعام کِشو دا، کئیدا دشمن زید درواز سی ڈھأرا داخل ہوا، کے یأ تھو داخل ہُوئیو تھوئے غالب ہونین، آں اللہ زید توکل کوا کو تھو سأزیدے مسلمان تِھیو۔
سے کئیدا اے موسٰیؑ! مھو ہیتکے یئیت ہُم داخل نہ ہودی کھیدیخانہ پورے ہے ہیت موجود تِھیو، تُو و چھی خدا بیشتے لات کوا مھودا مھید بَھئیل تھی۔
موسٰیؑ کئیدا اے خدایا! مِھی دا تُنو اَمن زید آں تُنو بَھئی ما علاوہ دوئی یزیت وَس نہ پیلئی، بَس مُھن آں نافرمان قوم سی درمیان فیصلہ کو۔
اللہ بنُو أ دھرین ہأزید دوبیش کالے پورے حرام چھی، ہیئے دھیرین می خواروزار گئینین، بَس تو ہأ نافرمان خلگا سی کأ اَمن خپا نہ کو۔
(اے پیغمبرؐ!) مھأ خلگائے آدمؑ سی دُو جَدک آ سی سأس قصہ بُھوژا، کے یأ ہیئے دُوںئے (اَمن اللہ یے) قربان کی، ایک ما (قربأنی) قبول کوا گأ اَسے دُوئی ما قبول کوا نہ گأ۔ (ایگے دوئی گے بنُو) کئیدا: "مأ تھأ مانین"۔ تی (جواب می) بنو: "بیشک اللہ صرف متقی خلک آ سی عمل قبول کودوُ"۔
کو تأ مھی مئیک سی کأ تُنو ہات بھا کِیو آ دا یئت ہُم تنُو ہات بھا نہ کودو چھی مئیک سی کأ، آ تمام جہانا سی بادشاہ ما بِھیدو۔
آ دا میس نِمادو یرأ تُو مھی آں تُنو گناہ تُنو ذمہ گِھن، آں جہنمیا می شامل ہو، آں اَئی أ ظالِما سی سزا چھی۔
بس تِسی حی تیس تُنو بھئی سی مئیک زید راضی کی، تی تیس موؤ، دَ سے ہُو تاوان والا آ می۔
دَ اللہ اے کاگ پیوؤ، سے دھیرین کھرݜُوسأد، یرأ سے تِسکے پشے سے تُنو بھئی سی بدن کھامُوڑ بورے، کئیدا: ہَئی افسوس آ مے کاگ ما ہُم کم ہُو یرأ آ تُنو بھئی سی بدن دا بُورئیدے، سے چیرگن پشیمان ہُو۔
اے وجہ دے مھوئے اسرائیل سی اولاد کے مے فرمان لِکتے دید یرأ یی ہُم اے انسان موؤ بغیر قصاص ما یا (بغیر) دھیرین می فساد ما، تی مھامُوڑ یأ دونیئی سی ٹول خلک مَئی، آں یی اے انسان بچ کی تی مھامُوڑ یأ ٹول دونیئی سی خلک بچ کی۔ بےشک ہین کأشکے مُھن پیغمبر واضح دلیل گِھندے اَئی، بھی ہُم اِما بعد ہیئے ما چیر خلک دھیرین زید ظلم و زیاتیئی کوؤ والا تھی۔
کامے خلک اللہ و تِسی رسولؐ سید لات کودی آں دھرین می فساد خور کودی بےشک تھین سزا أ چھی یأ سے ما بژَن یا پھانسی کوا بژَن یا تھین ہات آں کُھو ادَل بدَل چھینا بژَن یا دھیرین ما ݜگا بژَن، أ دا ہین دونیئی می ذلت چھی، آں ہین کأ آخرت می چیر گھن سزا مقرر چھی۔
اَسے کآم خلگے تُھن گݜو ما مُوش توبہ گا کیدا (تھأ چھوا)، آں مے بات یاد کوا یرأ اللہ چیر معاف کوؤ والا آں بوگوشُو والا تُھو۔
اے ایمان والا ہانا! اللہ ما بِھیا آں تِسی رضا سی گِھنُو سی ذریعہ بِرڑا، آں تِسی کأ جہاد کوا، مِسی کأ تھو کامیاب ہوا۔
بےشک کامے خلگے کفر اختیار کِدو کہ ہأکیش دونیئی سی بُٹ شیئی ہوئی آں ہیدیک دُوئی ہُم ہوئیو، تاکہ سے ہأ شیئی دیدے قیامت سی دی سی عذاب ما اَمن بچ کون، ہیئے ما قبول کوا نہ بژنین، آں ہأئے چیرگن عذاب دِیا بژنین۔
ہین خواہش ہونین یرأ مھو مے آنگا ما نِخیدے اَسے ہیئے یئت ہُم نہ نُخ بھانین، آں ہین کأ مُدأمی عذاب ہونین۔
چو ماݜ آں چو جَوئی ہِین دوُںئیا سی ہات چِھنا، ہین جرم سی بدَل می کامیک یأ ہیئے کِدو، ہے اللہ سی ڈھأرا سزا چھی، آں اللہ غالب تُھو حکمت والا تُھو۔
بھی ہُم کی تُنو ظلم ما بعد توبہ کیوو آں اللہ سید صلح کیوو (تِسی کأ بہتر تُھو)، آں بےشک اللہ تِسی توبہ قبول کودوُ، آں بےشک اللہ زیات بوگوشُو والا تُھو آں چیر زیات رحم والا تُھو۔
کئی تھیئے پتہ نی چھی یرأ اللہ سی بأچیئی آسمانا زید ہُم چھی آں دھرینا زید ہُم چھی، سے تُنو مرضی دے یام بوگوشَدو آں یامائے عذاب دیدو، اللہ سی ہر شیئی زید قابو تُھو۔
اے پیغمبرؐ! أ خلک تھأ یئت خپا نہ کون کامیک یأ کفر سی ڈھأرکے چیر تیزی دے روان تھی، ہأ می سے خلک ہُم تھی کآم یأ تُنو جِب تے بنَدی مھوئے ایمان اَنو، اَسے ہیئے حی دے ایمان نہ اَنودوُ، یا تھأمی یہودی تھی کآم یأ لَووآ سی کأ بُھوژدی، آں دأل خلگا سی کأ (جاسوسی) سی طور تے بُھوژدی کآم یأ چھی کأشکے حاضر نہ ہودی، سے الفاظ تُنو پودے ما بَدلادی آں بَندی کو تھوئے مے حکم دِیدو تَھلا قبول کوا، آں کو مے حکم نہ دِیدو تَھلا اِما اَمن بچ کوا، کامے انسان یأ اللہ گمراہ کِیدوُ دا تِسی (ہدایت سی کأ) چھی کی اختیار نہ تُھو، (اللہ سی دربار می) ہے سے خلک تھی اللہ ہین حِیا سی پاک کوؤ سی ہاڈو ارادہ نی کیژی، ہین کأ دونیئی می ذلت آں رسوائی چھی آں آخرت می گھن عذاب تُھو۔
ہے خلک لوو (خور کوؤ سی کأ) بُھوژدی آں ہے حرام خور تھی، دَ ہے چھی کأشکے اَئیو ہین مِیئے فیصلہ کو یا ہین دِشکے ہاڈو نُو بُو (تھیئے اختیار تُھو)، آں کو تأ ہین دِشکے نُو بُوو چھی سرہ کی نقصان نہ ہونین، آں کو فیصلہ کوؤسأدو ہین درمیان می انصاف سی فیصلہ کو، کئی کہ اللہ انصاف کوؤ والا خوشادوُ۔
آں ہے خلک تھأ منصف کھأکأ سَوَن حالانکہ ہأکیش تورات ہُم تُھو، تِمی اللہ سی حکم موجود تُھو، بھی ہُم ہے فیصلہ نہ مَنَدی، حقیقت أ چھی ہے ہاڈو ایمان نہ اَندی۔
بےشک مھوئے تورات نازل کِشو، تِمی ہدایت آں لوش اَشو، اللہ سی پیغمبرؑ آں تھین اتباع کوؤ والا یہودیائے اے کتاب سی مطابق حکم دیوؤدود، یہودیا سی بزرگ آں علماء ہُم (تھأئے حکم دیوؤدود)، کئی کہ تِھین حفاظت می اللہ سی کتاب دِیا گوشُو (کئی کہ تھائےاللہ سی کتاب یاد اَشُو)، سے تیزید گواہ ہُم اَشِیئی، (دَ اے یہودی ہانا!) تھو خلگا ما نہ بِھیا، مھأ ما بِھیا، اللہ سی آیات دھأگ اشوڑ پیسے دے نہ بِگینا، آں کآم یأ اللہ سی نازل کویل کتاب سی مطابق فیصلہ نہ کودی سے کأفر تھی۔
مھوئے تے کتاب می یہودیا زید حکم فرض کِشو یرأ ماݜ سی پوت ماݜ تُھو (ما بژنین)، أݜی سی بدَل می أݜی چھی، نَتکول سی بدَل می نَتکول تُھو، کن سی بدَل می کان تُھو، دَن سی بدَل می دان تُھو آں زخم سی بدَل می زخم تُھو، آں بھی ہُم کی معاف کِیو سے تِسی گناہ سی بوگوشُو سی سوَب سوا بژدوُ، آں کی یأ اللہ سی نازل کویل حکم سی مطابق فیصلہ نہ کِیو سے خلک ظالم تھی۔
آں ہیئے ما بعد تِھن پَن دے مھوئے عیسٰی مریمؑ سی پو پِیوؤ، سے تے کتاب یعنی تورات تِما مُوش کامیک یأ نازل ہوشُودا تِسی ہُم تصدیق کوؤدود، آں مھوئے تِسکے انجیل ہُم دِیدوشُو تِمی ہدایت أشی آں لوش اَشُو، سے اَمن ما مُوش تورات سی ہُم تصدیق کوؤدود، آں سے (کتاب) پرہیزگارا سی کأ نصیحت أشی۔
انجیل والائے پکار اَشو سے تِسی مطابق فیصلہ کوندے کامے احکامات یأ اللہ نازل کِشیدا، کی یأ اللہ سی نازل کویل احکامات آ سی مطابق فیصلہ نی کِیو سے نا فرمان تھی۔
(اے پیغمبرؐ!) مھوئے تھیزید حق سی کتاب نازل کیدو، سے اَمن ما مُوشِک کِتاب آ سی ہُم تصدیق کودُو، آں تھین حفاظت ہُم کودوُ۔ بَس (اے پیغمبرؐ!) تُو تھین مِیئے تِسی مطابق فیصلہ کو کا یأ اللہ نازل کیدو، آں کامے حق بات یأ چھی کأشکے أپچی دا تیس چھیدے ہین خواہش آ سی مطابق فیصلہ نہ کو۔ تھومی ہرے قوم گے مھوئے شریعت آں خاص پان مقرر کیژی۔ کو اللہ یأ خوشوؤدُودو تھوما اے قوم سوانین دے (اَسے تِسکے مھامُو خوش اَشُو) یرأ تُھن امتحان گِھنے کا شیئی یأ تھوئے دِیدتو دا؛ بس تھو نیگی می ایک دوئی سید مقابلہ کوا۔ اللہ سی دِشکے تھوئے ٹولے واپس ینین، بھی تی تھوئے تھأ شیئی آ سی بارہ می بَننین کامے شیئی آ سی کأ تھو ایک دوئی زید اختلاف کوؤدود۔
آں (بات أ چھی یرأ) اللہ کا احکامات نازل کِیدی دا ہین مِیئے تھین مطابق فیصلہ کو، ہین خواہش آ پیش نہ بَش، آں ہیئے ما اَمن بچ کو، مھامُو نأئی اللہ سی نازل کویل بعض احکامات آ ما ہے تھأ نھرَن، ہاں کو ہے بھی ہُم بات نہ منُوسأدو تَھلا جَن یرأ اللہ ہین بعض گناہ آ سی وجہ دے ہأئے سزا دیدوُ، آں بےشک خلگا می چیر مھال تھی سے نافرمان تھی۔
کئی ہے جاہلیت سی زُومان سی فیصلہ خوشادی؟ آں یقین والا آ سی کأ اللہ ما علاوہ کسی فیصلہ غورا ہو بھائی؟
اے ایمان والا ہانا! یہودی و نصارٰی سید دوستی نہ کوا، ہے ایکدوئی سی سأت تھی، تھو می یی ہُم ہأسید دوستی کِیو بس تَھلا سے ہین سأت تُھو، بےشک اللہ ظالم خلگائے ہدایت سی پان نہ پَشادوُ۔
کامے خلگا سی حی می بیماری چھی دَ تھأ تأ پشنین سے تھین (یہودی آ سی) ڈھأرکے چیر دھأںئی دیل بژدی، بَندی مھو یئت کی مصیبت می گیر نہ ہیئی، چیر جلد اللہ مسلمانائے فتح دینین یا تُنو ڈھأرا دوئی کآں فیصلہ کونین، بھی ہیئے (منافق خلگے) تھأ بأدا زید چیر زیات پشیمان ہونین کامیک یأ ہیئے تُنو حِیا می بُرأدتی دا۔
آں (تے وَخ) ایمان والائے بننین: "أ سے خلک تھی کیئے یأ اللہ سی سَخ قسم کھوئیشی یرأ ہے تُھن سأت تھی؟" ہأ خلگا سی ٹول عمل ضائع ہوئیدی، آں ہے أمیدے دوئی ہُم ناکام ہوئیدی۔
اے ایمان والا ہانا! تھو ما کآم تُنو دین چھیدے ڈیوو، اللہ مھال قوم آننین یأ اللہ تھأسید مینہ کونین آں تھیئے اللہ سید مینہ کونین، تھیئے مسلمان آ زید چیر غورا ہونین آں کأفر آ زید تھیئے چیر لاݜ ہونین، تھیئے اللہ سی پَن می جہاد کونین، آں ملامت کوؤ والا سی ملامت ما تھئیے نی بِھی نین، أ سے اللہ سی فضل تُھو؛ بھی سے کا خوشادوُو سے تِیسکے دیدو؛ اللہ چیر گھن علم والا تُھو۔
(اے مسلمان ہانا!) تُھن سأت تا اللہ آں اللہ سی رسول تُھو، آں سے مسلمان ( تُھن سأت تھی) کآم یأ نماز قائم کودی زکواۃ دیدی آں اللہ سی (دربار می) عاجزی اختیار کودی۔
آں کی ہُم اللہ آں تِسی رسول آں مسلمان آسید دوستی کیژیو (ہے اللہ سی ڈَلا چھی)، آں (یاد ساتا کہ) اللہ سی ڈَلا غالب ہونین۔
اے ایمان والا ہانا! کامے خلگائے تھو ما مُوش کتاب دِیاگودوُ دا (یعنی یہود و نصارٰی) تھأ آں کأفر تُنو دوست نہ سَوا، کئیکہ ہیئے خلگے تُھن دین پَورے پِشاڑے کِژی، آں اللہ ما بِھیا کو تھو (سأسکے) مسلمان تِھیو۔
آں کے تھو نِماز سی کأ آواز دیدی دا سے مے (بأت) پورے ہُم پِشاڑے کودی، وجہ اِسی أ چھی یرأ ہے بے عقلا قوم تُھو۔
(اے پیغمبرؐ ہأئے) بَن اے کتاب والا! مھو تُھن کئی لاݜ ݜَژدی علاوہ میما یرأ مھوئے اللہ زید ایمان اَنودوُ آں تے کتاب زید ایمان اَنودوُ کامیک یأ مھوزید نازل ہودوُ آں تھأ کتابا زید ہُم ایمان اَنودوُ کامیک یأ مھوئے ما مُوش نازل ہوئیدی، دراصل بات أ چھی تھو می اکثر خلک نافرمان تھی۔
(اے پیغمبرؐ) بَن آ تھوئے بینی تھأ خلگا سی بارہ می کسی انجام اللہ سی نِز می چیر لاݜ تُھو؟ أ سے خلک تھی کامیگازیت اللہ لعنت کِیو، آں تھأزید قہر ہُودو، آں تھیئے ما یام شادو سَوأد یامے ما خنزیر سوأد، آں تھیئے شیطان سی عبادت کی، ہأ خلگا سی دھروُ سی چیر لاݜ پوت تُھو، آں سے سِدا پَن ما چیر دُھو تھی۔
آں کے یأ سے (خلک) تُھن کأشکے یدیدا بنَدی مھوئے ایمان اَنودوُ، حالانکہ ہیئے کفر گِھندے اَئیشی آں ہیئے کُفر گِھندے نِگھأدتی، کامے بات ہے بُرادیدا اللہ تیس غورا پأنَدو۔
ہأمی چیر خلک تأ پشنین سے گناہ و ظلم زیاتئی سی کوؤ می آں حرام مال سی کھوؤ می ایکدی ما مُٹھیدی ہودی، ہے ایس چیر لاݜ کام کودی۔
ہین مَلان آں بزرگ ہأ گناہ سی بأدے ما آں حرام کھوؤ ما منع کئی نہ کودی؟ کی شک نی چھی ہے سخ لاݜ کودی۔
یہودی کئیدا اللہ سی ہات گھنڈیل تُھو (یعنی اللہ بخیل تُھو) حالانکہ ہات تا ہین گھنڈیل تھی، مے بأد سی بَنودے ہأزید لعنت کوا گیژی، بلکہ اللہ سی دُوںئی ہات کولاؤ تھی، تُنو مرضی دے سے خرچ کودوُ، آں کامے کتاب اللہ سی دِشا پیغمبرؐ زید نازل ہودوُدا تِسی وجہ دے ہأ خلگا سی سرکشی آں کُفر دوئی ہُم چیری ہونین، آں مھوئے ہأ خلگا سی مِیئے دشمنی آں بغض پیدا کِیدوُ قیامت سی دِیا پورے، کھیدیگی ہیئے لات سی آنگا پووڑادو اللہ تیس نِشادو، آں ہے دھرین می فساد خور کوؤ سی کوشش کودی، اللہ یئیت ہُم فسادی خلک نہ خوشادو۔
آں کو کتاب والائے ایمان اَنوشُوو، آں اللہ ما بِھت کِشیو، مھوئے ہین گناہ معاف کونیندے، آں نعمدا سی باغا می ہأ داخل کونیندے۔
ہاں کو ہیئے تورات آں انجیل آں کا ہین رَب سی ڈھأرا ہأزید نازل ہُوشودا تیس قایم ساتوشُوو ہأئے ڙیدا آسمان سی ڈھأرا ہُم رزق میلاؤ ہونیندے آں ہین کُھوا سی ٹینا ہُم ہأئے رزق ملاؤ ہونیندے، ہأ خلگا می اے ڈَلا منأسب چھی، اَسے تھأمی اکثر خلک لاݜ کَم کُوؤ والا تھی۔
اے پیغمبرؐ! کا تھیزید نازل ہودوُدا چھی رَب سی ڈھأرا تیس خلگائے آوا، آں کو تأ ہامُوڑ نی کِیوو تَھلا تأ سرہ اللہ سی پیغام نہ اَواد، لاݜ خلگے ما اللہ چھی حفاظت کودوُ، یقین کو اللہ کأفرائے سرہ ہدایت نہ دیدوُ۔
(اے پیغمبرؐ) بنا اے کتاب والا ہانا! تھو سرہ کی شیئی می نہ تھی کھیدیخانا پورے تھوئے تورات آں انجیل آں کا یأ تُھن رَب سی ڈھأرا تھوزید نازل ہودوُ دا تیس قایم نہ کیدوُو، تھیزید کامے وحی نازل ہِژی دا اِسی وجہ دے ہیئے ما چیر خلگے کفر آں سرکشی می مُٹھائے بژنین، دَ تھلا تُو ہأ خلگا سی بارا می سرہ اَمن پریشان نہ کو۔
بے شک مسلمان تھی کو یہودی تھی کو صابی تھی کو عیسائی تھی؛ ہیئے اللہ آں آخرت سی دِی زید ایمان اَنوو آں نیک عمل کِیو تھلا ہیئے نأ یئد بِھی نین نأئی ہیئے غمجن ہونین۔
بےشک مھوئے بنی اسرائیل ما غورا پوخ وعدہ گِھنیشی، آں ہین دِشکے مھوئے جھان پیغمبر پیئشی، کے ہُم اے پیغمبر ہین دِشکے ہین مرضی سی خلاف حکم گِھندے اَپ تا ہیئے یام پیغمبر لَوال گھنیئی آں یامی ہیئے موئی۔
آں تھیئے مے گمان کی یرأ اِسی سَرا توَس نہ ہونین (سزا نہ ہونین)، تھیئے اَمن ما اَن آں بو سَواد، بھی اللہ ہین توبہ قبول کی بُودا بھی تھیئے ما چیر خلگے اَمن ما اَن آں بو سَواد، حالانکہ اللہ ہین اعمال غورا پَشدوُ کا یأ ہے کودِیدا۔
ہیئے خلگے یقینا کفر اختیار کی کامیگے بنو یرأ مریم سی پو عیسٰیؑ خدا تُھو، حالانکہ عیسٰیؑ یہودائے میس بنودُود "اے بنی اسرائیل! خُدئی سی عبادت کوا، سے مھی ہُم رَب تُھو آں تُھن ہُم رَب تُھو" بےشک کی ہُم اللہ سید شِرک کِیو تیزیت اللہ جنت حرام کیژی آں تِسی ٹھکانہ دیزوخ سی آنگا تُھو، آں ظالم خلگا سی یی ہُم مددگار نہ ہونین۔
بےشک تھئیے خلگے کفر کی کآم یأ بنَدی اللہ ڇآ می ایک تُھو، حالانکہ اے خدا ما علاوہ سَرہ یام خدا نُو تُھو، کامے بأت یأ ہے کودیدا کہ اِما ہے نُو نوڑِئیو کامے خلک یأ ہأمی کأفر تھیدا تھأئے چیر گھن عذاب میلاؤ ہونین۔
دَ کئی ہیئے خلگے اللہ سی (موشکے) توبہ نہ کونین، آں تیما معافی نی نیمانین؟ اللہ دا چیر بوگوشُو والا آں رحم کوؤ والا تُھو۔
مریمؑ سی پو مسیحؑ صرف اللہ سی اے رسول تُھو، تیما مُوش ہُم چیر پیغمبر لھنگئیدی، آں تِسی یئی چیر سأس بَن أشی، ہے دوُںئیدے (عام خلک آ سی شانے) گیل کھوودُود، بُو، کھال اخکارہ بأت ہأئے مھو کودی، بھی بُو، ہے کھأدے اَنٹمأ نیا بژدی!
(اے پیغمبرؐ) بَن ھأئے تھو اللہ چھیدے مھال شیئیا سی عبادت کودی یرأ سے تھوئے نأ نقصان اَوا بھادی نأئی فائدہ؟ آں اللہ بُھیو والا آں جَنو والا تُھو۔
(اے پیغمبرؐ) بَن اے کتاب والا ہانا! تُنو دین می ناحق حد ما نہ ںُوخا، آں نأئی تھأ خلگا سی خواہشات آ زید چَلا کامیک یأ مُوش ما گمراہ ہوئیدی، چیرگن خلک ہیئے دأل گمراہ کیدی، آں أمیدے ہُم سِدا پَن ما پݜَلیئدی۔
بنی اسرائیل می کامے خلگے کفر اختیار کیدو تھأزید لعنت کوا گیژی، داودؑ آں عیسٰیؑ بن مریمؑ سی جِب تے، کئیکہ ہے خلک نافرمانی کوؤدود آں حد ما مُٹھائے بَیودُود۔
سے کامے لاݜ کام کوؤدُود تا تِما ایکدی منع نہ کوؤدُود، یقیناً ہین أ کام چیر لاݜ اَشُو۔
ہأمی اکثر خلک تأ پشنین یرأ سے کأفرا زید دوستی کودی، بےشک ہیئے کا اَمن گے مُٹھائے (آخرت کے) پیودوُ دا سے چیر لاݜ تُھو، آں (تِسی وجہ دے) اللہ تھیئے ما خپا ہُودو، آں تھیئے ہمیشہ عذاب می ہونین۔
ہاں آں کہ ہے خلک اللہ زید آں تِسی نبیؐ زید ایمان ساتودود آں کا یأ پیغمبرؐ زید نازل ہُودو دا تیزیت ہُم ایمان ساتودود تَھلا ہیئے کأفر خلگا سید دوستی نہ کونین دے، اَسے ہأمی چیر خلک نافرمان تھی۔
(اے پیغمبرؐ) ایمان والا آ زید دشمنی می ٹولے ما زیاد سَخ تھئیے یہودی آں مشرکین معلوم ہونین، آں ایمان والا آ زید دوستی می تھیئے ٹولے ما زیات غورا تھیئے خلگے معلوم ہونین کآم یأ بندی مھو نصارٰیٰ تھی، اِسی وجہ أ چھی یرأ ہأ خلگا می عالم آں پیر فقیر خلک موجود تھی، آں دوئی وجہ أ چھی ہے خلک تکبر نہ کودی۔
آں کے ہُم ہے خلک پیغمبرؐ زید نازل ہوئیل کلام بُھویدی دا تأ پشنین ہِین أݜیئے ما آݜ ڈلَدی، کئی کے ہیئے حق بات پأنی، آں بنَدی پروردگار مھوئے ایمان اَنُو، بَس مُھن (نام) حق سی گواہی دیوؤ والا آ می لِک۔
(آں سے بَندی) آخر کئی مھو اللہ زید آں کا حق بات یأ أپ چی تیزیت ایمان نہ أنی، بھی ہُم مھو طم سأتی یرأ اللہ مھو نیک خلگا می شامل کونین؟
دَ اللہ ہِین مے بأد سی بنُودے ہأئے جنت می محل دینین، تِھین ٹیندے (اُو سی) کآن روان ہونین، ہیئے خلگے جنت می ہمیشہ مقیم ہونین، اَںئی أ بدلہ چھی نیک خلگا سی۔
آں کامے خلگے کفر سی پان اختیار کیژی آں مُھن آیات لوال گھنئیدی، اَںئی ہے خلک جھنم سی لائق تھی۔
اے ایمان والا ہانا! کامے پاک شیئی اللہ تھوزید حلال (جائز) کیدی دا تھأ اَمن زید حرام نہ کوا، آں حد ما مُٹھائے ڇاپ نہ دا، بےشک اللہ حد ما مُٹھائے ڇاپ دیو والا نہ خوشادوُ۔
آں اللہ تھوئے کا روزی دیدچی دا تِما پاک آں حلال شیئی کھا، آں کامے اللہ زید تھوئے ایمان آنودو دا تِما بِھیا۔
ہأئیمُو قسما سی دا اللہ تھوئے ما توَس نہ کودوُ خو کامے قسم تھوئے سأزکے کَھیو (تِھین توَس تھوما ہونین) اے قسم سی پَھرؤ سی کفارہ دَش غریبائے درمیانہ گیل سی کِھیوو تُھو، کامے گیل تھو تُنو شیروالائے کھیادی دا، یا تھأئے کوژو آ سی دیؤ، یا اے غلام سی آزاد کوؤ، آں کِس کیش ہے شیئی نہ اَشِیو تَھلا سے ڇا ڙوز تھیئے، آں أ تُھن قسما سی کفارہ چھی، کے ہُم تھوئے قسم کھؤو تُنو قسما سی حفاظت کوا، آں ہامُوڑ اللہ تھوئے تُنو آیأت واضح بیان کودوُ مِسی کأ تھو شکر ادا کوا۔
اے ایمان والا ہانا! بےشک شراب، جوأری، بت پرستی پال سی نِگھالُو خزا شیطانی کَم تھی، ہیئے ما اَمن ساتا یرأ تھو کامیاب ہوا۔
شیطان دا خوشادوُ یرأ شراب آں جوأری سی وجہ دے تُھن ایکدی سید دشمنی آں بغض پیدا کوے، آں تھو اللہ سی ذکر ما آں نماز ما منع کوے، دَ بھی تھوئے (ہأ لاݜ کما ما) اَمن ساتنین؟
آں اللہ سی اطاعت کوا آں اللہ سی رسولؐ سی اطاعت کوا، آں خبردار ہوا، آں کہ بھی ہُم تھوئے بات نہ مینی، جَنا یرأ مُھن رسول سی ذمہ داری صرف صفا حکم سی آوؤ تُھو۔
کامے خلگے ایمان آنودوُ آں نیک عمل کیدی تھیئے (مُوش کا حرام) شیئی کھئیدی دا تھین وجہ دے تھأزید کی گناہ نہ تُھو، اَسے (شرط أ چھی یرأ) بھی سی کأ تقویٰ اختیار کی آں ایمان زید اِڑی ہوئیل ہوئی آں نیک عمل کی، بھی ہُم، آئندہ سی کأ تقوی اختیار کی آں ایمان زید اِڑی ہوئیل ہُوئی، بھی ہُم پرہیزگاری اختیار کی آں نیگی کی، اللہ نیگی کوؤ والا خلک خوشادو۔
اے ایمان والا ہانا! اللہ نأجی سی بارہ می ضرور تُھن اَزمیخ کونین کا (نأجی) یأ تُھن ہات آں تیر سی مُشکے ینین دا، تاکہ اللہ بوئے یرأ تِما کام بھیدوُ تِسی پشُو ما بغیر، اِما بعد کہ بھی ہُم یی زأتیئی کِیو تِسی کأ سخ تکلیف دیوؤ والا عذاب ہونین۔
اے ایمان والا ہانا! کے یأ تھو احرام سی حالت می ہُوئیو نأجی سی زیناور نہ ما؛ آں (بھی ہُم) تھوما یی تے (زیناور) قصداً مؤو دَ تِسی جرمانہ قربأنی سی زیناورے ما تے زیناور سیم (اے زیناور ہونین) یأ تی مؤدو دا، (کھأکأ یأ) فیصلہ کیو تھوما دو منصفے یرأ کعبہ یے نیئدے (اللہ سی نام دے) قربأنی کوئے؛ یا کفارہ سی پوت (تِسی قیمت سیم) غریبائے گیل کھئے، یا تِسی برابر ڙوز تھئے، مِسی کأ سے تنو کویل سی بدل چکھے، کا یأ ہودا تیس اللہ معاف کی، آں بھی ہُم کی دوآر اے کام کیو اللہ تیسکے بدل می سزا دینین، آں اللہ ٹولے ما زوروڑ آں سزا دیؤ والا تُھو۔
تُھن کأ سمندر سی (اُو سی) نأجی جائز کوا گیژی، مِسی کأ یرأ تھوئے آں دأل مسافرائے فائدہ ہوئے، آں احرام سی حالت می تھوزید دھرین سی نأجی ناجائز کوا گیژی، آں تے اللہ ما بِھیا کسی کأشکے تھوئے ٹولے سَرَڑا بیشتے مُٹھائے ہونین۔
کعبہ خُدئی امن و عزت سی شیر (آں) خلگا سی کأ اَمن سی ذریعہ سَواد تُو، آں حرمت والا ماہ، شُگران سی څاروئی آں تھین ماڑ می گڑن ہُم (اَمن سی ذریعہ سَوادتُو)، ہے ٹول مے وجہ دے یرأ تھوئے معلوم ہوئے کہ اللہ دھرین و آسمان سی اَندرے کائی تُھوو تِما واقف تُھو، آں اللہ ئے ہر شیئی سی علم تُھو۔
(اے خلک ہانا!) جَنا اللہ سخ عذاب ہُم دیدوُ آں بے شک اللہ بوگوشُو والا آں رحم کوؤ والا تُھو۔
پیغمبرؐ سی ذمہ واری دا صرف اللہ سی سوال جواب سی اَوؤ تُھو، آں اللہ ئے معلوم تُھو کا کم تھو ڈاگہ کودی آں کا تھو بِرید کودی۔
(اے پیغمبرؐ) بَن یرأ خزا شیئی آں پاک شیئی برابر نوہو بھادی، اگرچہ خزا شیئیا سی کثرت تھوئےغورا معلوم ہوئے، اے عقل والا ہانا! اللہ ما بِھیا مِسی کأئی تھو کامیاب ہوا۔
اے ایمان والا ہانا! مھال شیئیا سی سَرہ توَس نہ کوا یرأ سے تھوئے اخکارا ہُوئیو تھوئے تھیئے لاݜ معلوم ہونین، ہاں کہ قرآن سی نازل ہوؤ سی وَخ می تھوئے تھین بارہ می توَس کِیو تھوئے تھیئے شیئی ئے پشا بژنین، اللہ پُورأن بأت تھوئے معاف کی، بےشک اللہ چیرگن بوگوشُو والا آں برداشت والا تُھو۔
یقیناً تھو ما مُوش ہُم اے قوم ہال بأدا سی بارہ می توَس کِشو (کے یأ سے بأد تھأئے واضح ہوئی دا) سے تِما انکأری ہوئی۔
اللہ کی (څاروَئی بُھودا سی نام دے) نہ کیدی (یابَنے) نأ دا بحیرہ نأ سائبا نأ وصیلہ آں نأئی حام، اَسے کی یأ کفر کیدو سے اللہ زید لوو سی تومَت ݜژادی، آں ہأمی زیاد (خلک) قمہ قل تھی۔
آں کے ہُم ہأ خلگائے بنُو "اللہ سی نازل کویل احکاما سی دِشکے آں رسولؐ سی دِشکے یا" دا ہے بنَدی مھوئے مُھن بوب داد سی طریقہ (دین) کافی تُھو، حالانکہ ہین بوب داد کی شیئیا نہ جَنودُود نأئی تھأئے سِدا یعنی ہدایت سی پان معلوم أشی۔
اے ایمان والا ہانا! تُنو پِھگر کوا، کہ تھو أمیدے ہدایت زید ہُویو گمراہ خلگے تھوئے سرہ نقصان نہ آوا بھانین، تھوئے ٹولے اللہ سی ڈھأر کے واپس بژنین، تَھلا تی تھوئے بننین تھو کا عمل کوؤدود۔
اے ایمان والا ہانا! تھو می یام کو مئیک کے نھیئی ہُوو (جئیداد سی بارہ می) وصیت سی کوؤ سی وَخ می تھوما دو دیانت دار گواہ آ سی ہوؤ پکار تُھو، یا کو تھو یئد سفر می ہُویو (آں کو تھوئےمسلمان گواہ میلاؤ نہ ہویو) تھوئے مئیک سی مصیبت آبو تھید دُو غیر (مسلمان) ماݜ گواہ سَوا بھادی، ہاں کو بھی ہُم تھوئے ہین بارا می شک ہِیو ہأ گواہ نماز آ بعد دھأگ حِسار کوا، سے اللہ سی قسم کَھن یرأ مھو مے گواہی سی بدَل می کی مالی فائدہ گِھنو نہ خوشادی، کو معاملہ مُھن تُنو رشتہ دار سی بارا می کئی نہ ہوئے، آں اللہ مھوزید کامے گواہی سی ذمہ داری تھیئی دا تیس مھوئے نہ بُورانین، نیاؤ مھوئے گناہگا خلگا می ہونین۔
ہاں بھی ہُم کو بعد می پتہ گھیڑی یرأ تھیئے دو گواہے (لوو سَوأدے) گناہ کی دَ (مئیل سی) خلگے ما دأل دو ماݜ گواہی سی کأ منتخب ہون، آں سے دُوںئیدے قَسم کَھن یرأ "مُھن گواہی ہین گواہی ما زیاد سأز چھی، آں مھوئے کی زیاتیئی نہ کیژی، نیاؤ بیشکہ مھوئے ظألم خلک آ ما ہونین"۔
أ چیر غورا طریقہ تُھو، اِسی وجہ دے ہیئے ٹِک ٹِک گواہی دینین، یا سے بھیے یرأ ہین قسم ہُم نامنطور نہ ہوئے، تھأ دألا سی قسما سی چھلے، آں اللہ ما بھیا آں تِسی حکم غور تے بُھویا، آں اللہ نافرمان خلگائے یئت ہُم ہدایت نہ دیدوُ۔
(تے دی یاد کو) کامے دی یأ اللہ ٹول پیغمبرؐ جمع کیدے تھیئے ما توَس کونین یرأ تھوئے کا جواب دِیا گوشُو، تھیئے بننین مھوئے کی علم نہ تُھو، بےشک غیب سی بأدے ما تو غورا واقف تُھو۔
کے یأ اللہ بننین اے مریمؑ سی پو عیسٰی! مھی تھأ نعمت یاد کو کامیک یأ مأ تھأ و چھی ییئ زید کِشی دا، کے یأ جبریلؑ سی ذریعہ دے مأ چھی مدد کِیدا تُو خلگا زید زانگُو می ہُم بأت کوؤدُود آں زوأنی می ہُم، آں مأ تھیئے کتاب و حکمت آں تورات و انجیل سی تعلیم دِید، آں تُو مھی حُکم دے سُوم ما پیݜین سی شکل سوؤدود آں بھی تِیوا پُھوک دیودُود، سے مھی حکم دے روغ مروغ پیݜین سَوا بَیودُود، آں تُو مھی حکم دے اَن آں ڈپ صاپ کوؤدُود، آں تُو مھی حکم دے مئیل جینی کوؤدود، آں تے وَخ یاد کو کے یأ بنی اسرائیل (سی زیأتیئی) ما تھأ بچ کی، تُو تِھن کأشکے واضح دلیل گھیندے آپ تا تھأمی کامے خلگے یأ کفر کِشُو سے کئیدا أ دا اے اَخکارا جادو تُھوا۔
(آں تے وخ یاد کو) کے یأ مأ حواریا سی حی می مے بات تھیلی "مھزیت آں مھی رسول زید ایمان آنا" دَ سے کئیدا "مھوئے ایمان اَنُو تُو گواہ ہو مھو مسلمان ہوئی"۔
(یاد کو تے وَخ) کے یأ حواری کئیدا "اے مریمؑ سی پو عیسٰی! کئی چھی رَب آسمان ما مھوزید گیل و ٹیگون سی اے دَرستخان وال بھادو؟" دَ عیسٰیؑ کئیدا "اللہ ما بِھیا، سأزیدے کو تھوئے ایمان آنودُوو" ۔
دَ سے خلک کئیدا "مھو صرف مِسی کأ بنَدی یرأ مھوئے دَرستخان ما گیل کھیادا مُھن تسلی ہوئے آں مھو پِیشی دا تأ واقعی مھوئے سأز بات بینیئی، آں مے بأت زید مھو گواہ ہُم ہیئی"۔
دَ مریم ؑ سی پو عیسٰیؑ کئیدا "اے مھی خدایا! مھوزید آسمان ما اے دَرستخان نازل کو، مِسی کأ یرأ سے مُھن اول آں آخری خلگا سی کأ خوشحالی سی ذریعہ سَوا بژے، آں سے چھی ڈھأرا اے نشانی ہوئے، آں مھوئے رزق دے بےشک تو چیر غورا رزق دیؤ والا تُھو"۔
دَ اللہ کئیدا: "خا، مأ تھوزید ضرور نازل کونین، آں کہ تِما بعد بھی ہُم کی نافرمانی کِیو مأ تِسکے مھال سزا دینین یأ مے دونیئی می مأ تھال سزا یِسکے نہ دِیدچی"۔
کے یأ اللہ بننین: "اے مریم سی پو عیسٰیؑ! کئی تأ خلگائے بنوشُو یرأ خُدئی ما علاوہ مھأ و مھی یئی ما خدا سَوا؟" (تی) بننین "تُو چیرگھن پاک ذات تُھو، مھی کا جرأت چھی آ تے بات بینی تِسی بنُو سی مھی سَرا حق نہ تُھو، ہاں کہ مأ ہامُوڑ بنوشُو تھیئے معلوم ہونیندے، مھی حی سی راز تھیئے معلوم تھی، آں چھی حی سی راز مھیئے سَرا پتہ نی چھی، بےشک تو غیب سی بأدے ما غورا واقف تُھو"۔
مأ دا خلگائے صرف تھأ بأت کِشی کسی تأ مھیئے حکم دِیدوشُو، یرأ اللہ سی عبادت کوا، سے مھی ہُم رَب تُھو آں تُھن ہُم، آں کھیدیخانا پورے آ ہأمی موجود آشُو مأ ہین نگرانی ہُم کی، بھی کے یأ تأ مھأ دونیئی ما بھا کیدا ہے چھی نگرانی می اَشیئی، بےشک تو ہر شیئی ما واقف تُھو۔
کو تأ ہأئے عذاب دِیدو دَ ہے ہُم چھی بَن تھی، آں کو تأ ہأ معاف کیو تُو زوروڑ آں ہرکی جَنُو والا تُھو۔
اللہ بننین: "أ سے دی تُھو یأ سأزالائے تھین سأس سی فائدہ ہونین، تِھین کأ سے باغ تھی یأ کِسی ٹیندے نھید بژدی، مھید ہیئے مُدأمی ہونین، اللہ ہأما راضی تُھو آں ہے اللہ ما راضی تھی، آں أ گھین کامیابی چھی"۔
بُٹ آسمان آ می آں دھیرین می آں کا یأ ہین مِیئے تُھوو تھین بأچیئی اللہ سی چھی، آں سے ہر شیئی زید پورا طاقت لَردُو۔
ٹول صفت اللہ سی تھی کی یأ دھرین و آسمان پیدا کی آں أنچک و لوش سوأت، بھی ہُم سے خلک کی یأ کفر کِیدو سے دیأل خُدئی تنُو پروردگار سی برابر گھنَدی۔
أ سے ذات تُھو کی یأ تھو اَݜ سُم ما پیدا کی، بھی (تُھن زندگی سی) اے نیٹا مقرر کی، آں (دوُار جینی کوؤ سی) اے مقرر نیٹا ہُم تیس کیش تُھو، بھی ہُم تھو شک وا گئیدی۔
آں أ سے اللہ تُھو آسمانا می ہُم آں دھیرین می ہُم، سے تُھن بُریل (رازے) ما ہُم شِت تُھو، آں تُھن اخکارہ حالے ما ہُم شِت تُھو، آں کا عمل یأ تھو کودی تھیئے ما ہُم شِت تُھو۔
آں (کأفرا سی حال دا أ چھی کہ) تِھن مُوشکے کو اللہ سی نَخے ما اے نَخ یئت أبو سے تِما مُو نوڑادی۔
دَ کے یأ تھین کأشکے حق اَپ تا تھیئے تیس لَوو گھنوُ، تَھلا تھأئے جلد تے بأت سی خبر اَوونین کامے بأت پیش سے پِشاڑے کوا یؤدُود۔
کئی ہیئے نی ڈِیڈ کہ مھوئے کھیدیک قوم ہیئے ما مُوش ہلاک کیدی؟ تھأئے مھوئے دھیرین زید تے طاقت (اقتدار) دیدیشی کامیک یأ مھوئے تھوئے نی دِدچی، مھوئے تھأ زید آسمان ما غورا ہاگا موژات، آں مھوئے تِھن قدما سی ٹین نھید جاری کی، اَسے بھی مھوئے تھأ تھین گناہ سی وجہ دے ہلاک کی، آں تھیئے ما بعد مھوئے دأل نسل پیدا کی۔
آں کو مھوئے تھأزیت قاغذ زید لیگیل اے کتاب ہُم نازل کِشوُو بھی تھیئے تزید تنُو ہات گیأدے ہُم بونیندے، دَ کامے خلگے کفر کیدو تھیئے بھی ہُم میس بَن نیندے "ہے دا اخکارا جادو ما علاوہ کی نُو تھو"۔
آں سے خلک میس بنَدی کہ ایزید (پیغمبرؐ زید) مُلیکا کئی نازل کوا نہ گا؟ حالانکہ کو مھوئے کی مُلیکا نازل کیشوؤ تَھلا دا بات لھأدیشی، بھی ہأئے کی مہلت میلاؤ نہ ہونیندے۔
آں کو مھو یئت مُلیکا ما پیغمبر سوؤدُودو تَھلا ہُم مھوئے تیس کآں ماݜ (سی شکل می) سَوانیندے، آں ہأ مھوئے بھی ہُم تے شک وا تَھل نیندے کامیک می یأ ہے مھیرے بَژیل تھی۔
آں (اے پیغمبؐر) حقیقت أ چھی کہ تھأ ما مُوش ہُم چیرگن رسولا پیش پشاڑے کوا گئیشی، اَسے نتیجہ أ ہی کہ تھأ می یأ کامے خلگے پِشاڑے کِشی تھأ اَںئی تی شیئیے (عذاب) ییدے گیر کی کامے شیئی پورے سے پِشاڑے کوؤدُود۔
(تھأ کأفرائے) بَنا دھیرین می دھأگ گئادا بھی بوا کہ (پیغمبرؐ) لوال گھنو والا سی کا حال ہی؟۔
(تھیئے ما) توَس کو کہ: دھیرین و آسمانا می یأ کا تُھو دا سے کسی تُھو؟ (بھی کو تھیئے جواب نی دیدوُ تُو أمیدے) بَن کہ اللہ سی تُھو، تی رحمت تنُو اَمن زید واجب کی، تی (اللہ) تھو ٹول خامخا قیامت سی دی ایپوت کونین، تِمی کی شک نی چھی، اَسے کامے خلگے تنُو کأ نقصان سی سودا کیدا سے (مے حقیقت زید) ایمان نہ اَندی۔
آں دی و ڙأت می کامے مخلوقات دھردی دا سے ٹول تِسی قبضہ می تھی، آں سے ہر (بأت) سی بُھویو والا ہر (شیئی ما) شِت تُھو۔
(اے پیغمبرؐؐ) تُو بَن: آ اللہ ما علاوہ دُوئی کیس تنُو ڙݜاندَر سَوئی؟ (سے اللہ کآم یأ) دھیرین و آسمان سی پیدا کوؤ والا تُھو، سے (یأ ہریک زیت)کھیادو آں (یِما) نہ کھادوُ؟ (اے پیغمبرؐؐ) تُو بَن کہ مھیئے أ حکم دیا گودوُ کہ آ ٹول (خلگے) ما اول تابعدار سَوا بِژی،" آں تُو مُشرگا می یئیت ہُم شامل نو ہو"۔
(اے پیغمبرؐؐ) تُو بَن: کو مأ تنُو رَب سی نافرمانی کِیو مھیئے اے چیر گھن دی سی عذاب سی بِھت چھی۔
کِس ما ہُم تے دی سی (سے عذاب) دھگو کوا گا و تیزید اللہ سی گھن رحم ہونین، آں اَںئی ہے اخکارا گٹا چھی۔
آں کو اللہ تھیئے کی تکلیف آوادو اَںئی تِما علاوہ (تے تکلیف) سی دھگو کوؤ والا یام نُو تُھو، آں کو تی تھیئے کی خیر اَوادو سے ہر شیئی زیت قدرت ساتدوُ۔
اںَئی سے (اللہ) تنُو بَنا زید پورا پورا اختیار لَردوُ، آں سے حِکمت والا ہُم تُھو، آں (ہر شیئی ما) پُورا شِد تُھو۔
تُو بَن (اے پیغمبرؐؐ) کامے شیئی (کی بأت سی گواہی سی دِیو سی کأ) ٹولے ما اُچات تُھو؟ بَن: اللہ آں (اَںئی سے) مھی و تُھن مِیئے گواہ تُھو، آں أ قرآن مھیزیت مِسی کأ وحی کوا گودوُ تاکہ آ اِسی زریعہ دے تھو ہُم بھیئی آں تھأ ٹول ہُم کِسی کأ أ قرآن اَوؤدوُ،کئی تھو واقعی مے گواہی دے بھادی کہ اللہ زیت دأل خدا ہُم (شریک) تھی؟ (اے پیغمبرؐؐ) تُو بَن: آ دا مھال گواہی نہ دیدوُ، بَن کہ سے دا صرف اے خدا تُھو آ کامیک کامیک شیئی تھو تِسی خُدیئی می شریک کودی دا آ تھأ ٹولے ما بیزار تُھو۔
کامے خلگائے مھوئے کتاب دیدتُو سے تیس (نبی صلی اللہ علیہ وسلم) مھامُو پأنَدی کھأکأ یأ سے تنُو لَؤ پأندی، آں (بھی ہُم) سے خلک کی یأ تنُو اَمن نقصان وا تھلُدو دا سے ایمان نہ اَندی۔
آں تے ماݜ ما گھن ظألم کی ہونین یأ اللہ زید بہتان ݜیادوُ یا اللہ سی آیت لَوو گھنَدوُ، یقین کو کہ ظألم خلک کامیاب نہ ہو بھادی۔
آں تے دی (یادکو) کے یأ مھوئے ہأ بُٹ ایپوت کونین، بھی کامے خلگے شِرک کیدوُ تھیئے ما توَس کونین: کھیت تھی تُھن سے خُدا کسی بارا میں یأ تھو مے دعوی کوؤدُود کہ ہے خُدیئی می اللہ سی شریک تھی؟
تے وَخا تھأکیش کی بھان نہ ہونین سوائے می ما کہ تھیئے بننین کہ اللہ سی قسم یأ مُھن پروردگار تُھو مھو دا مشرک نہ اَشِیئی۔
بُو! ہے تنُو خیلاف کھأکأ لوو سَوادی، آں کامے (لَوو آ سی خُدا) ہیئے سوأدیشی دا سے ہیئے ما ہأڙأت۔
آں ہیئے ما یام خلک مھال تھی کآم یأ (ظاہرا) چھی بأدائے غور تے کان تھادی، اَسے مھوئے تھین حِیا زیت مھال پردہ تھلئیدی کہ سے تِما نہ جَندی، آں تِھن کَن بوکِیدی، آں کو تھیئے بُٹ نیخانا ڈِیڈو سے بھی ہُم تھأزیت ایمان نہ اَندی، حتیٰ کہ ہے چھی کأشکے لات سی کوؤ گے اَئیو ہے کأفر خلک مھامُو بنَدی کہ ا ٔ(قرآن) دا مُوشک خلگا سی قِصائے ما علاوہ دوئی کی نُو تُھو۔
آں ہے دأل ہُم اِسما (قرآن ما) منع کودی آں أمینے ہُم اِما دُھو دَھرَدی، آں ہے تنُو اَمن ما علاوہ دوئی یِس ہلاکت وا نہ تَھلدی، اَسے ہأئے احساس نُو تُھو۔
آں کو تأ تے ساعت ڈیڈو یأ ہأ دیزوخ زیت اِڑی کونین (تی چیر بِھت سی ساعت ہونین): ہیئے بننین: اے کاش! مھو واپس (دونیئی گے) پیا گئیشیو، تاکہ مے گونا مھو تنُو پروردگار سی نشأنی لَوو نہ گھینی، آں مھو مومنا می لِگا بیژی۔
نأ، بلکہ اصل میں تی شیئی ئے (آخیرَدے) تِھن مُوشکے کوولاؤ ہیدے یینن، کامیک یأ ہے مُوش برُؤدود، آں کو ہأ واقعی واپس پییٔو ہیئے دھویم گونا ہُم اَںئی تھأ کم کونین کامےکَمے ما ہأ منع کیشی، آں یقینا ہے پوخ لوال تھی۔
ہے دا مھامُو بنَدی کہ کائی چھیو اَںئی أ دونئی چھی، آں مھوئے مئک ما بعد دوبارہ جینی نہ ہونین۔
آں کو تأ تے ساعت ڈِیڈ کا ساعدا ہأ تنُو رَب کے اِڑی کوا گئیو، دَ تی (اللہ) بننین: کئی أ (دھویم جیدون) حق نُو تُھو؟ تھیئے بننین: بے شک مُھن رَب سی قسم! اللہ بننین: دَ بھی چکھا عذاب سی مزہ، کئی کہ تھو کفر کوؤدود۔
حقیقت أ چھی کہ سے خلک چیر گھین خسارہ می تھی کی یأ اللہ سیت ملاقات لَوو گھنوُ، حتٰی کہ قیامدے اچانک یِدے تِھن مُوشکے اِڑی ہونین، ہیئے بننین ہائے افسوس! مھوئے مے (قیامت) سی بارہ می چیر کوتاہی کِشی، آں تھیئے تے ساعدا تنُو گناہا سی بار تنُو ڈاگا زید گِھنیل ہونین، (بس) خبردار ہو کہ چیر لاݜ بار تُھو یأ ہے اُچات کودی۔
آں دونیئی سی جیدون دا سوائے نڑو و تماشا ما دُوئی کی نُو تُھو، آں یقینا کآم یأ تقویٰ اختیار کودی تِھن کأ آخرت سی شِیر چیرے غورا چھی، دَ کئی تھو ہیدیک ہُم عقل نہ لَردی؟
(اےرسول!) مھوئے غورا کیدے معلوم تُھو کہ ہأ خلگا سی ہأ بأدیدے تھیئے خپگان اوودوُ، کئیکہ ہے اصل میں تھأ لووال نہ گھنَدی، بلکہ ہے ظألم اللہ سی آیادے ما انکار کودی۔
آں حقیقت چھی کہ تھأما مُوش چیرگن رسول لووال گھنا گیٔدی، بھی کامے طریقہ دے سے لووال گھنا گئیشی آں تھأئے تکلیف دیا گوشُو تھیئے تیزیت صوو کی، حتیٰ کہ مُھن مدد تھأئے اَوئی، آں یام ہُم اللہ سی بأت بدلؤ والا نُو تُھو، آں مُوشک پیغمبرا سی بعض واقعات تا تھیئے اَوَیئدی۔
آں کو ہأ خلگا سی مُو نوڑؤ تھزیت چیر بُوکھو تُھوو، کو کوبھادُوو دھیرین سی اندر کے (بیوُ سی کأ) کآں اے سُرنگ یا آسمان گے (اُخو سی کأ) کآں شِل بھیرڑ، دَ تَھلا ہأئے (ہِن نِمیل معجزہ) گِھندے یے، آں کو اللہ نِموؤدُودو ہأ ٹول ہدایت زیت جمع کونیندے، لہذا (بس) تُو یئت ہُم جاہلا می شامل نو ہو۔
بات تا اَںئی سے خلک مَنَدی کآم یأ (حی دے) بأت کے کان تھادی، آں مڑیٔ دا اللہ قَوَر ما بھاکونین، بھی ہیئے اَںئی تِسی دِش کے واپس کوا بژنین۔
آں ہے خلک بنَدی (کو أ پیغمبر تُھوو) ایزیت اِسی پرودگار سی ڈھیارا کآں اے نیخانہ کئی نازل نہ ہُو؟ تُو (ہأئے) بَن کہ اللہ بے شک مے بأت زیت قادر تھو کہ سے نشأنی نازل کوئے لیکن ہأ می اکثر خلک (اِسی انجام)ماشِت نی تھی۔
آں دھیرین می کھیدیک څاروَئی گئیدی، آں کھیدیک پیݜِن تنُو پشألیدے شِیش دیدی، سے ٹول مخلوقا سی تُھن چَھلے قسم تھی، مھوئے کتاب (لوح محفوظ) می کی شیئی نہ چھوؤدُو، بھی ہأ ٹول ہِن پروردگار سی ڈھیارکے جمع کیدے نَیا بژنین۔
آں کامے خلک مُھن آیت لَوو گھنَدی سے أنچیگا می (پِش پِشتے) چأری و بو ہوئیدی، اللہ کیس نِمادُوو (تِسی ضد سی وجہ دے) گمراہی وا تھلَدوُ، آں کیس نِمادُوو سِدا پَن دے ݜژادُو۔
ہأ (کأفرائے) بَن: کو تھو سأزبَن تھی دَ میس بَنا کہ تھوزیت کو اللہ سی عذاب آبو یا تھوزیت قیامت آبو تھوئے اللہ ما علاوہ دُوئی کیس کے ہگانین؟
بلکہ تھوئے اَںئی تیس کے ہگانین، بھی یأ کامے مصیبت سی کأ تھوئے تیس کے ہگادتُو دا، کو سے نِمادُوو تی تیس دھوگو کونین، آں کامیک (خدا) تھو اللہ سیت شریک کودی دا (تے ساعدا) تھوئے تھأ (خدا) اَموݜا تھل نین۔
آں (اے پیغمبرؐ) تھأما مُوش مھوئے چیرگن قومائے (پیغمبر) پیئدی، بھی مھوئے (ہِن نافرمانیا سی سَر تے) تھأ سختیا می آں تکلیفا می گأت، مِسی کأ سے عاجزی کوئن۔
بھی کئی تھیئے عاجزی اختیار نی کی کے یأ مُھن سختی تھأئے أپ؟ بلکہ تِھن حی دا دُوئی ہُم ٹیگیئی ہُوئی آں کا یأ سے کوؤدُود تا شیطان تھأ جَنأدِیشی کے اَںئی ہے چیر زبردست کم تھی۔
بھی تھأئے کامے نصیحت کوا گیشی دا کے یأ تھیئے تیس اَموݜا تھیلیدا مھوئے تھأزیت ہر نعمت سی درواز کولاؤ کی، حتیٰ کہ کامے نعمت یأ تھأئے دیاگئیشی دا یأ سے تھأ نعمدا زید اُسُڑوسأت تا مھوئے اچانک تھأ (تنُو عذاب می) گأت، تِسی نتیجہ می سے بالکل مایوس ہُوئی۔
بس کامے خلگے ظلم کِشو تِھن بیخ نِگھالا گا، آں بُٹ تعریف و صفت اللہ سے تھی یأ ٹول جہانا سی پروردگار تُھو۔
(اے پیغبمرؐ تُو ہأئے) بَن: مھیئے بنادا کو اللہ تُھن بُھویو سی طاقت آں أݜی تھوکیژا گِھنو آں تُھن حِیا زیت مہر ݜیادو دَ اللہ ما علاوہ کامے خدا تُھو یأ تُھن مھأ شیئی تھوئے واپس کوئے؟ تُو بُو! مھو کھال کھال طریقائیدے دلیل بیان کودی، بھی ہُم ہے خلک مو نوڑادی۔
(اے پیغمبرؑ تُو) بَن: تھو بنا دا! کو اللہ سی عذاب تھو پیش اچانک آپ یا اعلان کیدے، دویں صورتا می ظالٔما ما علاوہ دوئی یی ہلاک ہونین؟
مھو پیغبمر صرف مِسی کأ پیدی کہ سے (نیگی آ زید) زیرے دو آں (نافرمانی آ زید اللہ سی عذاب ما) بھیئن، بس کامے خلگے ایمان آنو آں تنُو اصلاح کی تھأزیت نأ کی بِھت ہونین نأئی تھیئے غمگین ہونین۔
آں کامے خلگے مُھن آیت لَوو گھنیٔ، تھأئے تِھن نافرمانی آ سی وجہ دے عذاب اَوونین۔
(اے پیغبمرؐ!) تُو بَن! آں تھوئے مِسی نہ بندوُ کہ مھیکیش اللہ سی خزان تھی، نأئی آ غیب سی (پورا) علم لردو، آں نأئی آں تھوئے میس بندوُ کہ آ مُلیکا تُھو، آ دا صرف تے وحی سی اتباع کودُو کامیک مھیزیت نازل ہوئی، بَن یرأ اے اَن و پشُو والا یئت برابر ہوبھادی؟ دَ تھو بھی ہُم غور نہ کودی؟
آں (اے پیغمبرؐ) تو مے وحی سی زریعہ دے تھأ خلک خبردار کو کآم یأ مے بأت سی بِھت لردی کہ تھأ تُھن پروردگار سی کأشکے مھالے حالت می جمع کیدے آننین کہ اللہ ما سوا تِھن نأ یی مددگار ہونین نأئی یی سفارشی ہونین، تاکہ سے خلک تقویٰ اختیار کوئن۔
آں تُو تھأ خلک نہ ݜگا کآم یأ ڙادو نأشاما تنُو رَب سی رضا سی پوؤ سی کأ تیس کے ہگادی، ہن حساب می یأ کامے عمل تھی دا تھین اے عمل سی ذمہ واری ہُم تھزیت نی چھی، آں چھی حساب میں یأ کامے عمل تھی دا تھأ می ہُم اے عمل سی ذمہ واری تھأزیت نی چھی یأ تِسی وجہ دے تو تھأ بھار کے نِگھال آں ظألما مے شامل ہو۔
آں مھامُوڑ مھوئے یام خلک یام خلگا سی زریعہ دے امتحان وا تھلیئدی تاکہ سے میس بنَن کہ "سے خلک أ تھی کآم یأ اللہ مھو ٹول چھیدے احسان سی کوؤ سی کأ کاریئدی؟"، کئی اللہ تنُو شکرگزار بندہ دألے ما زیاد نہ پأندو؟
آں کے یأ چھی کأن گے سے خلک اَئیو کی یأ مُھن اَیادا زیت ایمان اَنودُو تھأئے بَن تھوزیت سلامتیا ہوئے، تُھن رَبے تنُو امن زیت رحمت سی معاملہ لازم کیژی یرأ کو تھو می یِما کی لاݜ کام ناپوہی می ہُوو آں تِما بعد تی توبہ کی آں تنُو اصلاح کِیو اللہ چیر بوَگوشُو والا چیر مہرَبان تُھو۔
آں اَںئی ہامُو مھو نشانی تفصیل دے بیان کودی تاکہ گناہگا آ سی پان واضح ہیدے اخکارہ ہوئے۔
(اےپیغمبرؐ) بَن کہ تھو یأ اللہ ما علاوہ کامیک (لوو آ سی خُدئی آ ئے) ہگادی دا تِھن عبادت ما آ منع کوا گودوُ، بَن کہ آ تھُن خواہشا سی اتباع نہ کوبھادو، کو مأ ہامُوڑ کِیو مأ گمرا ہونین، آں مھی لیک ہدایت پَوؤ والا خلگا می نہ ہونین۔
بَن کہ بےشک آ تنُو رَب سی ڈھأرا اے واضحا دلیل زیت قائم تُھو، آں تھوئے تیس لَوو گھنُودوُ، کامے شیئی سی تھو جلدی یِیوؤ سی مطالبہ کودی دا سے مھیکیش نُو تُھو، حکم اللہ ما علاوہ یِسی ہُم نہ چَلَدوُ، سے حق بات بیان کودُو آں ہُم سےٹولےما غورا فیصلہ کوؤ والا تُھو۔
بَن کہ: کامے شیئی سی تھو تأدی کودی دا سے کو مھیکیش ہوشُوؤ مھی و تُھن میئے فیصلہ ہو نِندے، آں اللہ ظألم خلک چیر غورا پأندو۔
آں ہُم تیس کیش غیب سی کنجی تھی، تِسما علاوہ تھیئے ما یام شِد نُو تُھو، آں دھیرین و سمندر می یأ کائی تُھوو سے تِما واقف تُھو، آں (تھام سی) اے پاݜ ہُم لار گاو تیس کے تِسی علم ہودوُ، آں دھیرین سی أنچیگا می کائی کُل یا کائی شُگیل یا اَݜ شیئی مھال نُو تُھو یأ اے کولاؤ (واضحا) کتاب می لیگیل نُو ہوئے۔
آں اَںئی سے تُھو یأ ڙأت کے (نِین می) تُھن روح (اے حدا پورے) قبض کودُو آں دِیے تھو کا یأ کودیو تِما سے غورا کیدے شِد ہودوُ، بھی (تے نم دی) می تھوئے جیدوُن دیدوُ تاکہ (تھُن اُمو سی) مقررہ نیٹا پورا ہوئے، بھی اَںئی تِسی کأشکے تھوئے واپس ہیدے بَیو تُھو، بھی (تَھلا) تی تھوئے بَن نین یرأ تھو کا کا کوؤدود۔
آں اَںئی سے تنُو بنا زید پورا پورا اختیار لَردوُ، آں تُھن کأ نگران (مُلیکا) پیدوُ، مھیدیگا پورے یأ کے تھو می کِسی مئیک سی وَخ آبو مُھن پئیل مُلیکا تِسی سا گھنَدی آں سے اے پِھڑ ہُم لَم لیٹ نہ کودی۔
بھی (قیامت سی دی) ٹول اللہ سی دِش کے واپس کوا بیَدی یأ تِھن حقیقی مالک تُھو، یاد سات! حکم اَںئی تسی چلَدوُ آں سے ٹولا ما زیاد جلدی حساب گِھنوُ والا تُھو۔
بَن: کآم تھو دھیرین و سمندر سی أنچگا ما بچ کودُو کے یأ تھو تیس کے زأری دے آں بِریت بِریت ہگادی، (آں میس بَنَدی) کو خُدئی مھو مے مصیبت ما بچ کِیو مھوئے خامخا تِسی شکرگزار بنا می شامل ہونین؟
بَن: اللہ تھو اے مصیبت ما ہُم بچ کودُو آں ہر دوئی تکلیف ما ہُم، بھی ہُم تھو شِرک کودی!
بَن کہ: سے مے بأت زیت پورا پورا قدرت لَردو کہ تھو زیت عذاب تُھن ڙیدا پے یا تُھن کُھواسی ٹینا (نگھالے)، یا تھو جُدا جُدا ٹولگیا می تقیسم کیدے ایک دُوئی سیت جنگے، آں تھوئے ایکدی آ سی طاقت سی مزا چکھے، بُو مھو کھال کھال طریقائے دے (تنُو) نشأنی واضحا کودی تاکہ ہے دھیأک جنوُ ما کام گِھنن۔
آں (اے پیغمبرؐ) چھی قوم (قرآن) لَوو گھنَدوُ حالانکہ أ سأز تُھو، دَ بَن کہ مھیئے تُھن زمہ واری دیا نہ گیژی۔
ہر واقعہ (خبر) سی اے نیٹا مقرر تُھو، آں جلد تھوئے (ہرکی) معلوم ہونین۔
آں کہ تُو تھأ خلک پَشوسأت کام یأ مُھن آیادائے لاݜ بنوُ می لگیا تھی دَ تُو تھیئےما جُدا ہو، کھیدیخانا پورے سے دوئی اے بأت می مخشول نہ ہوئیدی آں کو شیطان تھیئے (مے بات) آموݜا تھیلیو دَ (یاد یِیو ما بعد) یئیت ہُم ظالم خلگا سیت نہ بھئی۔
آں تِھن کھاتہ می کامیک عمل تھی دا پرہیزگارا زیت تِھن (تھأ عملا سی) کی زمہ واری نی چھی، البتہ نصیحت سی کوؤ تُھن کام تُھو، ہو بھادوُ سے ہُم (مھال بأدے ما) پرہیز کوئن۔
آں تھأ (خلک) چھوکی یأ تنُو دین ما نڑو و تماشہ سَوأت تُو، آں کآم یأ دُونیئی سی جیدُونے دوکا وا تھلیٔدی، آں مے (قرآن) سی زریعہ دے (خلگائے) نصیحت کوا یے، تاکہ مھامُو نہ ہوئے کہ اے ماݜ تنُو اعمالا سی سَر تے مھامُو گݜا بژے کہ اللہ (سی عذاب) ما بچ کوؤ سی کأ اللہ ما علاوہ نأ یام تِسی مدد کوؤ والا سَوا بژے نأئی یام سفارش کوؤ والا، آں کو سے تنُو (رہائی سےکأ) ہر قسم سی فدیہ ہُم پیش کوؤ نِمے دَ تِما سے قبول کوا نہ بژے، بس اَںئی ہے سے خلک تھی یأ تنُو عملا سی سَر تے گݜا گیٔدی، چونکہ تھیئے کفر اختیار کِشو دَ ہِین پوُ سی کأ خُڑوگیل اُو آں اے تکلیف دیوؤ والا عذاب (تیا) تُھو۔
(اے پیغمبرؐ!) ہأئے بَن:کئی مھو اللہ چھیدے مھال شیئیائے ہَگئی یأ مھوئے فائدہ دے بھادی نأئی نقصان؟ آں یأ اللہ مھوئے ہدایت دیدچی اِما بعد ہُم مھو تنُو کُھوئے دے واپس نِٹری؟ آں تے ماݜ سی چھلے ہیئی کیس یأ شیطانے ڇھوأدے بیابان گے نُودو؟ آں سے یی حیران ہیدے سرگردانا پِشدوُ، تِسی یام سأت تیس ساپ پَن گے ہگادی کہ مُھن کأشکے یے؟ دَ بَن کہ اللہ سی دئیل ہدایت اصل ہدایت چھی، آں مھوئے أ حکم دیا گودوُ کہ مھو ٹول جہانا سی رَب سی تابعدار ہیئی۔
آں (أ حکم دیا گودوُ) کہ: نماز قائم کوا، آں تِسی (نافرمانی) ما بِھیا، آں اَںئی سے تُھو کسی دِشکے تھو ٹول جمع کیدے نئی نین۔
آں اَںئی سے تُھو یأ دھیرین و آسمان برحق پیدا کیدی آں تے دیے تی (قیامت کے) بَن نین ہو تی ہونین تِسی بات حق چھی، آں کامیک دی (بیشل بھا بئی نین) تے دی بأچیئی اَںئی تِسی ہونین، سے بریت آں اخکارہ ہر شیئی ما واقف تُھو، آں اَںئی سے حکمت والا تُھو آں پورا پورا (ہر شیئی ما) شِد تُھو۔
آں (تے ساعت سی بأت بُھوش) کے یأ ابراہیم تنُو بوپ اَذر کے بنوشُو کہ تأ بُھودے ما خدا سیوأدے بھیڑتُو آں پَشدوُ کہ تُوو چھی قوم سی خلک واضحا گمراہی می تھی۔
آں اَںئی ہامُوڑ مھو ابراہیم گے آسمانو دھیرینا سی بأچیئی سی نظارہ پشوؤدُود، آں مقصد أ أشی کہ سے کامل یقین لَرو والآ می سَوا بژے۔
بس کے تیزیت ڙأت سی أنچک أپ تا تی اے تا ڈیڈ، سے بنوُسأت ہے مھی رَب تُھو، بھی کے سے گا دا تی بنوُ کہ آ بَیو والا نو خوشادوُ۔
بھی کے یأ تی یُن بڑقُوآ ڈیڈ تا بنوُ کہ: ہے مھی رَب تُھو، اَسے کے یأ سے گأ دا سے بنوسأت: کو مھی رَبےمھیئے ہدایت نی دیدیشیو یقینًا مأ گمراہا می شامل ہونین دے۔
بھی کے یأ تی سی پلگُوا ڈیڈ تا بنوُ کہ ہے مھی رَب تُھو، ہے چیرے گھن تُھو، بھی کے یأ سے گأ دا تی بنوُ کہ: اے مھی قوم سی خلگا ہانا! کامے کامے شیئی یأ تھو اللہ سی خُدیئی می شریک گھنَدی آ تھأ ٹولے ما بیزار تُھو۔
مأ دا حی سی اخلاص تے تنُو مُو تے ذات سی ڈھأر کے کیدوُ کی یأ آسمانو دھیرین پیدا کیدی، آں آ شِرک کوؤ والآ می نُو تُھو۔
آں بھی تِسی قوم تیسیت مارَزا شروع کی، ابراہیمؑ (تھأئے) بنوُ: تھو مھیزیت اللہ سی بارا می مارَزا کودی حالانکہ تی مھیئے ہدایت دیتچی؟ آں کامے شیئی یأ تھو اللہ سیت شریک گھنَدی آ تھیئے ما نہ بھیدوُ، ہاں مھی پروردگار کو مھیئے (کی نقصان) دِیو سأدو، مھی پرورگار سی علم ہر شیئی سی چاپیرا تُھو، دَ تھو بھی ہُم کی خونا قبول نو کودی؟
آں آ تھأ شیئیے ما کئی بِھی کامیک یأ تھوئے اللہ زید شریک گھنیئدی؟ حالانکہ تھو تھأ شیئی اللہ سی شریک منو ما نہ بھیدی کامیگا سی بارہ می یأ اللہ تھوزید کی دلیل ہُم نازل نی کیدُو، مھیرے کو تھوکیش کی علم تُھوو بَنا دا مھو دُوںیاں می کآم زیات اَمن (نہ بِھیو) سی مستحق تھو؟
(حقیقت تا أچھی) کہ کامے خلگے ایمان اَنودوُ آں تھیئے تنُو ایمان می ظلم سی اے پِھڑ سی ہُم ملاوٹ نی کیژی، امن و سکون دا بس تھین حق تُھو، آں اَںئی سے تھی یأ سِدا پَن گے اَویل تھی۔
آں ہے مُھن سے کامیاب دلیل أشی یأ مھوئے ابراھیمؑ گے تیسی قوم سی مقابلہ می دِیدیشی، مھو کسی نِمؤسأدو درجہ اُچات کودی، بےشک چھی رَب سی حکمت ہُم گھین چھی آ علم ہُم کامل تُھو۔
آں مھوئے ابراہیمؑ گے اسحاقؐ (سی چھلے پو) آں یعقوبؑ (سی چھلے نوسَئی) دِت، آں نوحؑ گے مھوئے مُوشما ہدایت دیدی شی، آں تِسی اولأدی می داودؑ، سیلمانؑ، ایوبؑ، یوسفؑ، موسیؑ آں ہارونؑ گے ہُم، آں اَںئی ہامُو مھو نیک کم کوؤ والائے بدلہ دیدی۔
آں زکریاؑ، یحییٰؑ، عیسیؑ آں الیاسؑ کے (ہُم ہدایت دیدیشی)، ہے ٹول نیک خلگا می اَشیی۔
آں اسماعیلؑ آں الیسعؑ آں یونسؑ آں لوطؑ کے (ہُم)، آں مھوئے ہأ ٹولائے دُونیئی جہان سی خلگا زید فضیلت دِیدیشی۔
آں تِھن بوب داد آں تِھن بھیا می ہُم چیرائے (ہدایت دیدیشی)، آں مھوئے ہأ ٹول کأرتے سِدا پَن گے أوأدیشی۔
ہے اللہ سی دیئل ہدایت چھی، اِسی زریعہ دے سے تنُو بندہ آ می کیس کے نِمادوُو ہدایت دیدوُ، آں کو تھیئے شِرک کِشیو تِھن ٹول (نیک) عمل ضایع ہونین دے۔
ہے خلک اَشیی کیس کے یأ مھوئے کتاب حکمت آں نبوت دیدیشی، کو أ (عرَب سی) خلک مے(نبوت) ما انکأری ہُوئیو (کی پروا نوکو کئیکہ) اِسی مَنو سی کأ مھوئے مھال خلک مقرر کِیدی یأ اِسی مُنکر نی تھی۔
ہے سے خلک اَشیئی کیس کے یأ اللہ ہدایت دیدیشی، بَس (اے پیغمبؐر) تُو ہُم اَںئی تِھن پَن دے تِل، (اے پیغمبرؐ! تُو مخالفین آئے) بَن کہ آ تھو ما مے دعوت سی سَرتے کی معاوضہ نی نِمادُو، ہےدا صرف و صرف دُونیئی جہان سی ٹول خلگا سی کأ اے نصیحت چھی۔
آں ہیئے (کأفرے) کے میس بنوُ دا کہ اللہ کی انسان زیت کی شیئی نازل نی کِیدوُ دَ تھیئے اللہ سی صحیح قدر نی کی، تُو تھأئے بَن: تے کتاب کی نازل کِشو یأ موسٰیؑ گِھندے آبوشُو؟ آں سے خلگا سی کأ لوش آں ہدایت اَشُو، آں کا یأ تھوئے مختلف قاغزا سی شکل می تھؤشُو تھأ می (دھأگ) تھو اخکارا کودی آں چیرگن یی تھو بُرادی، آں (تِھن ذریعہ دے) تھوئے تھأ بأدا سی تعلیم دیا گوشُو کامے بأدے ما نأ تھو شِد اَشیئی نأ تُھن باپ داد، (اے پیغمبرؐ تُو أمیدے) بَن تے کتاب اللہ نازل کِشُو، بھی تھأ چھو دا سے تنُو فالتو بأدا می نڑن۔
آں أ چیر برکت والا کتاب تُھو یأ مھوئے نازل کِیدو، مُوشِک آسمانی ہدایت آ سی تصدیق کوؤ والا تُھو، تاکہ تُو اِسی ذریعہ دے گاما سی مرکز (یعنی مکہ) آں تِسی چاپ چاپیرا دَھرو والا خلک خبردار کو، آں کامیک خلک یأ آخرت زیت ایمان لردی سے ایزیت ہُم ایمان لردی، آں سے تنُو نماز سی پُورا پُورا حفاظت کودی۔
آں تے ماݜ ما گھن ظألم کی ہونین کآم یأ اللہ سی ذات زید لَوو سَوادوُ یا میس بنے کہ مھیئے وحی کوا گیژی، حالانکہ تیس کے کی وحی کوا نہ گیژی، آں اَںئی ہامُوڑ سے میس بنے کہ مأ ہُم ہال کلام نازل کونین کھأکأ یا اللہ نازل کِیدوُ، آں کو تُو تے ساعت پَشودُودو (چیر بِھت سی منظر پَش نِندے) کے ظالم خلگے مَئک سی سختیا می گرفتار ہونین، آں مُلیکائے تنُو ہاتھ خور کوئین بَننین: تنُو سا نِگھالا! آش تھوئے ذلت سی عذاب دیا بژنین مِسی کأ کہ تھو اللہ سی ذات زید لَوو بأت تھؤدُود، آں مِسی کأ کہ تھو تِسی نَخا سی خیلاف قُتنگأری پَشؤدُود۔
(بھی قیامت سی دی اللہ تھأئے بَننین) تھو مُھن کأشکے مھامو اَمن سیت اَئیدی کھأکأ یأ مھوئے تھو اَول پَیرا پیدا کیشی، آں کا یأ مَھوئے تھوئے دِیدوشُو تیس ٹول تھوئے تنُو پأشکے چھیدے اَئیدی، آں مھوئےدا تُھن سے سفارشی یئت نظر نہ ییدی کِھن بارا می تھوئے أ دعویٰ أشی کہ سے تُھن معاملات آ سی طے کوؤ می مُھن شریک تھی، یقینًا تھأسیت تُھن ٹول تعلقات ختم ہوئیدی، آں کامیک (خدا) اِسی بارا مے تھوئے چیر گُمان اَشُو دا سے تھوکیژا ہأڙأت تی۔
بے شک اللہ کُل سی آں أنی سی پھالُو والا تُھو، سے جَن شیئی مَئیل شَیئیے ما نِگھالَدوُ، آں ہُم سے مَئیل شیئی جَن شیئیے مانِگھالُو والا تُھو، خلک ہانا! سے اللہ تُھو، بھی تھو کھأدے پَتکیزأ ریوان کی دی؟
سے (ڙأت سی أنچک پھألدے) ڙات سی نِگھلو والا تُھو آں تی ڙات سکون سی اے ساعت سوأت چی، آں سی و یُن اے حساب سی پابند، أ ٹول تے ذات سی منصوبہ بندی چھی کسی اقتدار ہُم کامل تُھو آں علم ہُم کامل تُھو۔
آں اَںئی تی تُھن کأ تا سوأت تی، تاکہ تھو تِھن ذریعہ دے خشکی آں دریاب سی أنچگا می پَن معلوم کوا، مھوئے ٹول نشانی پَشأت (خو) تھأ خلگائے کآم یأ علم ما کام گھنَدی۔
اَںئی سے (اللہ) تُھو کی یأ تھو ٹول اے سا ما پیدا کیدی، بھی (ہر انسان سی کأ) چیر دَھرو والا پوت (یعنی دُونیئی) چھی، آں ایک امانتی تھوؤ سی پوت (قوَر) تُھو، مھوئے ٹول نشانی کولاؤ کےکیدے پشأت (خو) تھأ خلگائے کام یأ پوہا ما کام گھنَدی۔
آں (اللہ) اَںئی سے تُھو کی یأ تُھن کأ آسمان ما ہاگا مُوژات، بھی تِسی زریعہ دے مھوئے ہر قسم سی تیغ نگھالیئی، آں تھأ تیغےما مھوئے سبزی پیدا کی، تھیئے ما مھوئے ڙیتکُولأل کُل نِگھالیئدی، آں کھجور سی تھام ما میوا سی چِگ نُخودی یأ (میوا سی بوجھ تے) لھما بژدی، آں مھوئے دَݜ سی باغ ݜیأت، آں زیتون و آنار یأ ایک دوئی زید گھڑدی ہُم آں ایک دوئی ما جدا جدا ہُم ہودی، کے یأ ہے تھام میوا دیدی دَ میوآئے آں تِھن پَژوُ سی حالت کے غور تے بُو، ہأ ٹول شیا می گھن نیخانا تھی (اَسے) تھأ خلگا سی کأ کآم یأ ایمان اَندی۔
آں خلگے پَیر اللہ سیت خُدیئی می شریک کی حالانکہ اللہ تھأ پیدا کیدی، آں بغیر علم ما تِسی کأ جدک و سیرأن سَوأت، حالانکہ اللہ سی بارا می یأ کامیک بأت ہے کودی اللہ تھیئے ما پاک و اُچات تُھو۔
سے دا آسمانو دھیرن سی سَوؤ والا تُھو تِسی پو کھأکأ ہو بھادو، حالانکہ تِسی ڇھی نی چھی، تی ہرکی پیدا کیدوُ آں سے ہر ہر شیئی سی پُورا پُورا علم لَرَدوُ۔
(خلک ہانا!) سے تُھو اللہ یأ تُھن پروردگار تُھو! تِما علاوہ یام ہُم معبود نُو تُھو، سے ہر شیئی سی پیدا کوؤ والا تُھو، بس تِسی عبادت کوا آں سے ہر شیئی سی نگرأنی کوؤ والا تُھو۔
نظر تِسی اِحاطا نہ کو بھادی آں سے ٹول نظَرا سی اِحاطا کودُو، آں سے چیر باریکیے ما شِد آں (ہر شیٔ ما) شِت تُھو۔
تھوئے تُھن رَب سی دِشا ہدایت سی ثبوت اَئیدی، مھیرے کامے ماݜ أݜی کولاؤ کیدے ہأئے بُدوو تی اَمن گے فائدا اَوانین، آں کامے ماݜ أنڈی ہوؤ تی تنُو نقصان کونین، آ تُھن نگرأنی کوؤ والا نُو تُھو۔
اَںئی مھامُوڑ مھو آیت مختلف طریقائدے بار بار واضحا کودی، آں (مِسی کأ کودی) تاکہ ہے مھامو بَنن کہ تأ (ایس کیںس ما) ڇِھڙودُو، آں کامے خلک علم ما کام گھنَدی تِھن کأ مھو حق واضحا کیئی۔
(اے ہیغمبرؐ) تھینریت چھی رَب سی دِشا کامے وحی یأ أپچی دا تِسی تُو تابعداری کو، تِما علاوہ دُوئی یام معبود نُو تُھو آں مُشرکے ما بےپروا ہو۔
کو اللہ نِمادوشُوو ہیئے (خلگے) شِرک نوکونِندے، نأ مھوئے تھأ ہن حفاظت زید مقرر کیدو نأئی تو ہِن کما سی ذمہ وار تُھو۔
(مسلمان ہانا!) کِس کے یأ أ خلک اللہ ما علاوہ ڇأڑ کودی دا تھو ہأئے کی لاݜ نہ بنا، (تِسی نتیجا می) ہیئے خلگے جہالت می حد ما نِختے اللہ ئے لاݜ بَننین، اَںئی ہامُو مھوئے ہر ٹولگی سی عمل تِھن نظرا می شِیژیئی کِیدو، بھی ہأ ٹولائے ہِن رَب سی دِشکے واپس بَژو تُھو، تَھلا تی تھأئے بَننین کہ سےکا کا عمل کوؤدُود۔
آں ہیئے خلگے اللہ سی سَخ قَسم کَھئی (کئیدا) کو ہِین کأشکے واقعی کی نشأنی أبو یقینًا ہیئے ضرور تیزیت ایمان آننین، تُو (ہأئے) بَن کہ ٹول نشانی اللہ سی قبضہ می تھی، آں (اے مسلمان ہانا!) تھوئےکا پتہ کو سے نشانی اَئی ہُم و ہیئے ایمان نہ اَنین۔
آں مھو ہِن حی آں نظر (حق ما) نُڑادی کھأکأ یأ ہیئے اول گونا (قرآن) زیت ایمان نہ انوشُو، آں مھو ہأ اے حالت می چھودی تاکہ ہے تنُو نافرمانی می گئیَن۔
آں کو مھوئے ہأپیش مُلیکا ہُم پیئیشیو، آں مَڑئی ہأسیت بأت کؤدُودو، آں مھوئے ہِن نِمیل ہر شیئی اَخکارہ ہین مُشکے أندے تھوؤشُوو ہے بھی ہُم ایمان اَنو والا نا اَشیئی ہاں کو اللہ نِمادُوشُوو، اَسے ہأ می اکثر خلک جہالت سی بأت کودی۔
آں اَںئی ہاموڑ مھوئے ہر نبی سی کأ کآم نہ کآم دشمن پیدا کیشُو، انسانو پیرا ما شیطان قسم سی خلک، آں تاکہ کامے خلک آخرت زیت ایمان نہ لردی تِھن حی ہأ (چِک چِک) بأدا سی دِشکے غورا مائل ہوئے آں سے تھأ می مغشول ہون، آں ٹول تھأ حرکت کوئن کامیک سے کوؤ والا اَشیئی۔
(اے پیغمبرؐ ! توہائے بَن )آں اللہ ما علاوہ دویٔ کام فیصلہ کوؤ والا سویٔ ؟ حالانکہ اَیٔ تی دا تُھن دِشکے مے کتاب نازل کیدے پیودو یأ کیمی ٹول معاملات آ سی تفصیل تھو ۔آں کامیک خلگآئے مھوئے مُوش کتاب دیدوشو تھأئے یقین دے پتہ شی کہ ہے چھی پروردگار سی دیشا حق گِھندے نازل ہودو ۔بس تو شک کوؤ والا ما ہرگز نہ ہو۔
آں کو تو دھیرین مے دھروں والا سی اکثریت سی منوسأدو تھیئے تھأ اللہ سی پَن ما گمراہ کونین
آں چھی رَب سی کلام سأس و انصاف می کامل تُھو، تِسی بأدا سی یام بدلَؤ والا نُو تُھو، سے ہر بات بُھویو والا ہر بأت ما شِد تُھو۔
آں کو تُو دھیرین می دَھرُو والا سی اکثریت سی منوُسأدو تھیئے تھأ اللہ سی پَن ما گمرا کونین، سے دا وہم و گُمان ما علاوہ دوئی کی شیئی سی پأشکے نہ بژدی، آں تِھن کام سیوائے خیالی اندازہ آ سی ݜژؤ ما دوئی کی نُو تُھو۔
یقین کو چھی رَب غورا شِد تُھو تھأ خلگے ما کآم یأ تِسی پَن ما ہڙَیدی، آں سے تھیئے ما ہُم غورا کیدے شِد تُھو کآم یأ صحیح پَن زید تھی۔
بس ہر تے (حلال زیناور) ما کھا کیزیت یأ اللہ سی نام گِھنا گودوُ، کو تھو واقعی تِسی آیادا زیت ایمان لَردیو۔
آں تھوئے کژَل چھی کہ تھو (تھأ زیناورے ما) نہ کھادی کامیگا زید یأ اللہ سی نام بَنا گودوُ؟ حالانکہ تی تھوئے تھأ شیئی تفصیل دے پشأت تی کامیک یأ تی تھوزیت (عام حالاتا می) حرام کیدی، البتہ کامیگا سی کھوؤ زیت تھو بالکل مجبور ہُویو (تِھن بقدر ضرورت اجازت ہوئی) آں چیرگن خلک علم سی بُنیادتے نأ (بلکہ صرف) تنُو خواہشا سی بنیادتے دأل خلک گمراہ کودی بےشک چھی رَب حد ما لھنگو والا غورا پأندو۔
آں تھو اَخکارا آں بُریل (باطنی) دوںئی قِسما سی گناہ چھوا، یقیناً کامے خلک گناہ مُل گِھندیدا تھأئے جلد تھأ ٹول جُرما سی سزا میلاؤ ہونین کامیک یأ سے کؤودود۔
آں کامے زیناور زیت اللہ سی نام گِھنا نہ گاو تِما نہ کھا، ہامُوڑ کوؤ سخت گناہ تُھو، آں شیطان تنُو سأت ڇھوادی تاکہ سے تھوسیت بحث کوئن، آں کو تھوئے تِھن بات مینیو تھوئے یقیناً مُشرک ہونین۔
(آں تھو بنادا!) کامے ماݜ میٔل ہُو، بھی مھوئے تِسکے جیدون دید، آں تِسکے اے لوش دید تسی سَر تے سے خلگا می پشَدُو، ہے تے ماݜ سی چَھلے ہو بھادُو کامیک یأ أنچیگا می گیر ہوئے آں تھیئے ما ہاڈو نہ نُخ بَھئیے؟ اَںئی ہامُوڑ کأفرائے تِھن کم شِژو کوا گئیدی۔
آں اَںئی ہامُوڑ مھوئے ہرگام می تھیت سی گھن مجرمائے مے موقع دیت تُو کہ سے تِمی (مسلمانا سی) خلاف سازش کوئن، آں سے کامے سازش یأ کودی دا سے دوئی یِسی نأ بلکہ ہُم تِھن تنُو خیلاف ہودی، حالانکہ تھأئے تِسی احساس نُو ہودُو۔
آں کو ہأئے (مکہ والائے) قرآن سی کی آیت أبو ہے بَندی کہ مھوئے یئت ہُم ایمان نہ اَننین کھیدیخانا پورے مھوئے تے شیئ دیا نہ گودؤُ کامیک یأ اللہ سی پیغیمرائے دیا گوشُو، اللہ ئے غورا پتہ چھی کہ سے تنُو پیغمبری کیس کے دیدوُ، کامے خلگے مھال مجرمانہ بأت کِدیدا تِھن کأ اللہ کیش بےعزتی آں سخت عذاب ہونین۔
بس کامے ماݜ کے اللہ ہدایت سی دیؤ سی فیصلہ کِیو تِسی سینہ اسلام سی کأ کوولاؤ کودُو، آں کامیک سی گمراہ کوؤ سی اِرادہ کِیو تِسی حی تینگی کودُو، مھامُوڑ یأ سے زورأ آسمان گے اُخدُو، اَںئی ہامُوڑ اللہ کفر سی گندگی تھأ خلگا زیت مسلط کودُو کآم یأ ایمان نہ اَندی۔
آں ہے (اسلام) چھی پروردگار سی (پشَیل) سِدا پان چھی، کامے خلک یأ خونا قبول کودی تھأئے مھوئے (مے پَن سی) نَخ کولاؤ کولاؤ کیدے بیان کیدی۔
تِھن رَب کیش سلامتیا سی شِیر اَںئی ہأ خلگا سی کأ چھی، آں کامے عمل یأ سے کودی دا تِھن سَرتے سے اَمینے تِھن ساتو والا تُھو۔
آں (تے دی سی خیال کوا) کامے دی اللہ تھأ ٹول گیݜتے جمع کونین، آں (شیطان پیرائے بَننین) اے پیرا ہانا! تھوئے انسان چیر زیاد گمراہ کیدی، آں انسانا می کامیک تِھن سأت ہونین تھیئے بَننین: اے مُھن پروردگار! مھوئے ایکدوئی ما چیر مزے گِھن تی، آں مھیرے تنُو تے نیٹائے اَوئیدی یا تأ مھوئے مقرر کِیشو، اللہ بَننین: (مھیرے) اَنگا تُھن پوت تھو کِمی یأ تھوئے ہُمیشہ دَھرنین اَسے اللہ کو دُوئی کی نِمادو، یقین کو یرأ چھی رَب سی حکمت ہُم کامل چھی آں علم ہُم۔
آں اَںئی ہامُوڑ مھو ظألم تِھن کویل عملا سی وجہ دے ایک دوئی زیت مسلط کو دی۔
اے انسانو پَیرا سی ٹولگی! کئی تُھن کأشکے اَںئی تھو ما سے پیغمبر نہ اَیٔشی کآم یأ تھوئے مھی آیت بیندے بُھویوؤدُود؟ آں تھو تے دی سی مُخا سی کوؤ ما خبردار کوؤدود کامے دی یأ آش تُھن مُوشکے تُھو؟ تھیئے بَننین: (آش) مھوئے أمینے تنُو خلاف گواہی دیدچی کہ (واقعی مُھن کأشکے پیغمبر اَیٔشی آں مھوئے تھأ لوال گھنیئشی)، آں (درحقیقت) تھأ دونیئی سی جیدونے دوکا وا تھلیٔشی آں (مھیرے) تھیئے تنُو خلاف أمینے گواہی دیت یرأ سے کأفر اَشیئی۔
ہے (پیغمبرا سی سلسلہ) مِسی کأ أشی کہ ہے بات چھی رَب سی خوش نأ أشی سے گاما سی زیادتیئی سی وجہ دے تھأ مے حال می برباد کوئے کہ تے گام سی خلک غافلا ہوئن۔
آں ہر قسم سی خلگائے زأن زأنی درجہ تِھن اعمالا سی حساب تے میلاؤ ہودی کامیک یأ تھیئے کیدی دا، آں کامے عمل یأ سے کودی دا تھیئےما چھی رَب غافلا نُو تُھو۔
آں چھی رَب ہَر کی ما پورا تُھو رحمت والا تُھو، کو تی نِمادو تھو ٹول (دُونیئی ما) بھا کوئے آں تھو ما بعد کیس یأ نِمادو تُھن پوت آنے، کھأکأ یأ تی تھو دأل خلگا سی نسل ما پیدا کِشی۔
یقین کوا کہ کامے شیئی سی تھوسیت وعدہ کوا بژئی تیس کے ہر حال می ییؤ تُھو، آں تھو تیس (اللہ) عاجز نہ کو بھادی۔
(اے پیغمبرؐ! تُو ہأئے) بَن: اے مھی قوم سی خلک ہانا! تھو تنُو پوت (تنُو طریقہ دے) عمل کوا آ (تنُو طریقہ دے) عمل کودُو، بھی جلد تھوئے معلوم ہونین کہ مے دونیئی سی انجام کسی حق می نوخودُو؟ بےشک ظالم خلک کامیاب نہ ہو دی۔
آں اللہ یأ کامیک فصل و څاروئی پیدا کیدی دا ہیئے خلگے ہأمی اللہ سی بس اے حصہ مقرر کیِدُو، بس سے تنُو خیال دے مھامُو بَندی کہ أ حصہ دا اللہ سی تُھو آں أ حصہ ئی مُھن تھأ خدئی آ سی کآم یأ مھو اللہ سیت خُدیئی می شریک کودی، بھی کامیک حصہ یأ تِھن تھأ شریک آ سی ہودو سے دا یئت ہُم اللہ ئے نہ آودوُ آں کامیک حصہ یأ اللہ سی ہودوُ دا سے تِھن تھأ خدیٔ آ ئے آودو، مھال لأݜ لأݜ بأت تھی یأ تھیئے طے کیدی۔
آں اَںئی ہامُوڑ چیرگن مشرکا سی خیالا می تِھن خُدئی ئے تِھن اولاد سی موؤ شیژیئی کیدوُ، تاکہ سے تھأ (مشرک) تباہ کوئے آں تاکہ تھأئے تِھن دین سی معاملہ می شک پیدا کوئے آں کو اللہ نِمادُوشوو نو تھیئے ہامُوڑ نہ کو بھانیندے، بس ہأ آں ہےکامیک غلط بأت سوادی اَںئی ہاموڑ چھو۔
آں سے بندی کہ: مھأ څاروَئی و فصلا زیت پابندی ݜژیل چھی سے تنُو خیال دے میسں بندی کہ ہأ یام ہُم نہ کھا بھادو سواۓ تھیئےما کآم یأ مھوئے نِمادو، آں یام څاروئی مھال تھی کہ تِھن پِٹ حرام کواگیژی آں یام څاروَئی آ سی بارا می اللہ زیت تہمت ݜژادی کہ ہأزیت اللہ سی نام نہ بندی، چیر جلد اللہ ہأئے ہِن الزام و تہمتا سی بدلہ دینین۔
آں سے بندی کہ: نأ څاروَئی آ سی ڈھے آ می کامیک بچئی تھی دا سے خالص مُھن ماݜا سی کأ تھی آں مُھن جُوئی آ زیت حرام تھی، آں کو سے بچئی مئیل پیدا ہوو تِمی ماݜ و جوئی دوںیٔمو شریک تھی، کا بأت یأ ہے سَوادی دا اللہ چیر جلد ہأئے پورا بدلہ دینین، یقینَا سے حکمت سی ہُم مالک تُھو آں علم سی ہُم۔
حقیقت أ چھی کہ سے خلک گھن خسارا می تھی کی یأ تنُو اولاد بغیر کا علمی وجہ دے صرف قمقلتوب تے موؤدوُ، آں اللہ یأ کامے رزق تھأئے دیدوشُو تیس اللہ زیت بہتان ݜژأدے حرام کیدو، سے یقینَا گمرا ہ ہوئیدی، آں یئت ہُم ہدایت والا سوا نہ گئیدی۔
اللہ سے تُھو کی یأ باغات پیدا کیدی، یام تھأمی (جھال والا تھی) کومکے دے بھائیے اُگھالا بژدی آں یام ئی بغیر کومک ما اُچات ہودی، آں تھامو فصل کسی یأ خون جدا جدا تھی آں زیتون او انار یأ ایک دوئی سی شانے تھی آں ایک دوئی ما جدا جدا ہُم تھی، کے یأ مھیئے تھامے میوا دیدوُ دَ ہِن میوا ما کھا، آں کے یأ ہِن لُنو سی دی آبو اللہ سی حق ادا کوا، آں فضول خرچی نہ کوا، یاد لرا سے (اللہ) فضول خرچا خلک نہ خوشادوُ۔
آں څاروئیا می اللہ تھأ زیناور ہُم پیدا کیدی یأ بار گھنَدی آں تھأ زیناور ہُم یأ دھیرین زیت ݜژیل ہودی، اللہ تھوئے کامے رزق دیدتُو تِما کھا آں شیطان سی نقش قدمے دے نی تِلا، یقین کوا سے تُھن کأ اے واضحا دشمن تُھو۔
(څاروئیا سی) آٹھ جوڑا پیدا کیدی، دُو قسم (نر و مادہ) مِنڈھالا سی نسل ما آں دو شَما سی نسل ما، ہیئے ما توَس کوا کئی اللہ دوُںئی نر حرام کیدی؟ یا تے بچئی (حرام کیدوُ) کامیک یأ دوُںئی نَسلا سی ڈھے مے ہوؤ؟ کو تھو سأس بَن تِھیو کآں اے علمی بنیاد تے مھیئے جواب دا۔
اَںئی ہامُوڑ اُخا سی ہُم (اللہ) دو قسم (نر و مادہ) پیدا کیدی، آں گیئیا سی ہُم دو قسم، ہأئے بَن اللہ دوُںئی نرحرام کیدی یا دوُںئی مادہ؟ یا تے بچئی یأ دوُںئی نسلا سی مادا سی ڈھے م ہوؤ؟ کئی تھو تے ساعدا حاضر اَشیئی کے اللہ تھوئے اِسی حکم دیدوُ شو؟ (کو نا اَشیئی) دَ بھی تے ماݜ ما گھن ظالم کی ہونین یأ اللہ سی ذات زید لَوو سَوادوُ صرف مے وجہ دے یرأ خلک بغیر کآں اے علمی بنیاد ما گمرا کوئے؟ حقیقت أ چھی کہ اللہ ظالم خلک ہدایت کے نہ اَوادوُ۔
(اے پیغمبرؐ ہأئے) بَن کامے وحی یأ مھیزیت نازل ہیژی تیمی دا آ کی شییٔ مھال نہ پادوُ یأ تِسی کھوؤ والا سی کأ حرام ہوئے، مگر کو سے مُردا ہوو یا ڈلُو والا ڙات ہوئے یا خنزیر سی ماس ہوئے، کیٔکہ سے ناپاک تُھو یائی مھال کآں گناہ سی زیناور ہوئے یأ تزیت اللہ ما علاوہ دوئی کسی نام گِھنا گودوُو، ہاں کامے ماݜ (مھأ شیئیا می کامے شیئی سی کھوؤ زید) مجبور ہُوو مے شرطے دے کہ سے خون سی گِھنو سی کأ ہامو نہ کوئے یا ضرورت سی حد ما نہ نُوخے، دَ بےشک اللہ چیر بوگوشُو والا آں گھن مہرَبان تُھو۔
آں یہودی آ زیت مھوئے ہر نوک والا زیناور حرام کِشُو، آں گیئیا سی آں چھألا سی بدنے ما تِھین مے (چرَبی) حرام کیدوُ البتہ کامیک یأ تِھین ڈاگ زیت یا اندرا می ݜژیل ہُوو یا کآں اے ہَر (ہڈی) زید مِلیل ہُوو سے حرام کویل مے ما مستثنٰی اَشُو، میس مھوئے تھأئے تِھن سرکشی سی سزا دیدی شی، آں پورا یقین سات کہ مھو سأزبَن تھی۔
بھی ہُم کو أ (کافر) تھأ لوال گھندِیو تو بَن! تُھن پروردگار چیر گھین رحمت والا تُھو آں تِسی عذاب مجرمے ما دھو کوا نہ بش بھادوُ۔
آں کامے خلگے شِرک کیدو تھیئے میس بَننین کہ: کو اللہ نِمادوُشوو مھوئے شرک نہ کونین دے مُھن بوپ دادے آں نأئی مھوئے کی شیئی حرام کونین دے، ہیئے ما مُوشک خلگے ہُم (پیغمبر) اَںئی ہاموڑ لوال گھنئیشی حتٰی کہ تھیئے مُھن عذاب سی مزہ چکھو، تُو ہأئے بَن کہ تھوکیش کی علم تُھو یأ تیس تھو مُھن مُشکے پیش کوا؟ تھو دا کامے شیئی سی پأشکے تِلدیدا سے گمان ما علاوہ دوئی کی نو تُھو، آں تھودا صرف وہُم سی بنیاد تے اندازہ ݜژادی۔
(اے پیغمبرؐ !) ہأئے بَن کہ: ہال دلیل دا صرف اللہ سی ہوژی یأ (حی آ ئے) آوؤ والا ہوژی، بس کو تی نِمادوُشوو تی تھو ٹول (زورأ) ہدایت کے ان نیندے۔
ہائے بَن: کہ تنُو تھأ گواہ پیش کوا کآم یأ مے گواہی دو کہ اللہ مھأ شیٔ حرام کیدی، بھی کو ہیئے أمینے گواہی دید ہامُو تو ہأ زیت گواہی می شریک نہ ہو، آں ہأ خلگا سی خواہشا زیت نہ چل کی یأ مُھن آیت لَوو گھنیئدی آں کآم یأ آخرت زید ایمان نہ لردی آں کآم یأ (دأل) خُدیئی می تنُو پروردگار سی برابر گھنَدی۔
ہأئے بَن کہ : یا آ تھوئے پڑھاؤ کیدے بُھویئی کہ تُھن پروردگار حقیقت مے تھوزیت کامے بأت حرام کیدی، سے أ تھی کہ تھو تیزیت یس شریک نہ کوا، آں ییئی و بوپ زیت غورا سلوک کوا، آں غریبی سی وجہ دے تنُو لَؤ نہ ما، مھوئے تھوئے ہُم رزق دینین آں تھأئے ہُم، آں بےحیائی سی کما سی کأشکے ہُم نھیئی نہ ہوا، کو سے بےحیائی اَخکارا چھی آں کو بُریل۔ آں کامے نفس کے یأ اللہ حرمت دِت چِیو تیس کآں اے حق وجہ ما بغیر نہ ما، خلک ہانا! أ سے بأت تھی کِسی یأ اللہ تاکید کیدوُ تاکہ تھو جَنا۔
آں یتیم کھیدیخانا پورے پوخ عموئے نہ اَوؤدوُو تِسی مال گے نھیئی نہ ہو اَسے مھالے طریقہ دے کامیک یأ تِسی حق می غورا تُھوو، آں ناپ تول انصاف تے پورا پورا کوا، اللہ یس کے ہُم تِسی طاقت ما چیر تکلیف نہ دیدوُ، آں کے یأ کی بات کوؤسأدو انصاف ما کام گِھنا کو سے تنُو سَکا کئی نہ ہودُو، آں اللہ سی وعدا پورا کوا، خلک ہانا! أ سے بأت تھی کسی یأ اللہ تاکید کیدوُ تاکہ تھو خونا حاصل کوا۔
(آں اے پیغمبرؐ ہائےمیس ہُم بَن کہ) أ مھی سِدا سِدا پان چھی بس اِزیت تِلا آں دأل پنے ما قلار ہوا، نأو تھیئے تھو اللہ سی پَن ما جُدا کونین، خلک ہانا! أ بأت تھی کِسی اللہ تاکید کیدو تاکہ تھو پرہیزگار سَوا بژا۔
بھی مھوئے موسٰیؑ ئے کتاب دیدوُشو، تِسی مقصد أ أشی کہ نیک خلگا زیت اللہ سی نعمت پورا ہوئے، آں ہر شیئی سی تفصیل بیان کوا بژے، آں سے (خلگا) سی کأ پان پَشوؤ آں رحمت سی ذریعہ سوا بژے، تاکہ سے (آخرت می) تنُو پروردگار سیت میلاؤ ہوؤ زیت ایمان اَنے۔
آں أ برکت والا کتاب تھو یأ مھوئے نازل کیدو۔ بس اِسی پیروی کوا آں تقویٰ اختیار کوا تاکہ تھوزیت رحمت ہوئے۔
(مے کتاب مھوِئے کھأئیمو نازل کی کہ) تھو میس نہ بنا یرأ کہ کتاب تا مھو ما مُوش دو ڈلا (یہود و نصارٰی) زیت نازل کوا گوشُو، آں کا یأ سے پڑھاؤ کوؤدُود تا مھو تِما بےخبر اَشیئی۔
یا تھو میس نہ بنا:کو کتاب مھوزیت نازل ہُوشوو مھوئے ہأئے (یہود و نصاریٰ) ما یقینًا چیرے ہدایت یافتہ ہونیندے، بس تھوئے تُھن پروردگار سی ڈھأرا اے واضحا دلیل آں ہدایت و رحمت سی سامان اَپ، مھیرے تِما گھن ظالم کی ہونین کآم یأ اللہ سی آیت لَوو گھنَدوُ آں تھیئے ما مُو نرادوُ، کامے خلک یأ مُھن آیادے ما مُو نَرادی مھوئے تھأئے چیر گھن عذاب دینین، کئی کہ سے مُوا مُو نَرا ییدی۔
أ مِما علاوہ دُوئی کا بأت سی انتظار کودی کہ ہِن کأشکے مُلیکا یَن یا چھی پروردگار أمینے یو یا چھی پروردگار سی کآں نَخ یو؟ (حالانکہ) کامے دی چھی رَب سی کی نشأنی أبو تے دی مھالے ماݜ سی ایمان فائدہ نے دینین کی یأ مُوش ما ایمان نہ اَنودُوو یا کی تنُو ایمان دے کی نیک عمل نہ گھڑودُوو، (بس ہأئے) بَن کہ تھو انتظار کوا مھو ہُم انتظار کودی۔
(اے پیغمبرؐ!) یقین کو یرأ کامے خلگے تنُو دین می فرقہ بازی کیژی آں ڈَلا آ می تقسیم ہوئیدی ہأزیت چھی کی تعلق نُو تھو، ہِن معاملہ دا اللہ ئے حوالہ چھی بھی تی تھأئے بَننین کہ ہے کا کا کوؤدُود۔
کامے ماݜ اے نیگی گِھندے آبو تیس کے تھال دَش نیگی آ سی ثواب تُھو، آں کامے ماݜ اے بَدی گِھندے آبو تیس کے صرف تے اے بدی سی سزا دیا بژنین آں تھأزیت کی ظلم نہ ہونین۔
(اے پیغمبرؐ!) بَن کہ پروردگار مھأ اے سِدا پن دے ݜژادتُو یأ کولاچا ما پاک دین تُھو، (یعنی) ابراھیمؑ سی دین کی یأ حی سی اخلاص تے تنُو مُو اللہ سی دِشکے کِشو، آں سے شرک کوؤ والا ما نہ اَشُو۔
بَن کہ: بے شک مھی نماز مھی عبادت مھی جیدون آں مھی مئک ٹول اللہ سی کأ تھی یأ ٹول جہاناں سی پرودرگار تُھو۔
تِسی یام ہُم شریک نُو تُھو، مھیئے اَںئی اے بأت سی حکم ہُودوُ آں آ تِسی ٹولے ما اول مَنُو والا تُھو۔
بَن کہ: کئی آ اللہ ما علاوہ دُوئی خدا بِریڑی حالانکہ سے ہر شیئی سی مالک تھو؟ آں کامے انسان کا عمل کودُوو تِسی گٹا آں نقصان دوئی یِسی نأ بلکہ اَںئی تیزیت تُھو، آں اے بَھئی بھاکوؤ والا دوئی سی بار اُچات نو کونین، بھی تُھن پروردگار سی دِشکے تھوئے ٹولائے واپس ییؤ تُھو، تے ساعدا تی تھوئے تھأ ٹول بأت پَشانین کامیک می تھو اختلاف کوؤدُود۔
آں ہُم تی تھو دھیرین می ایک دُوئی سی میرأثی سَوأت آں تھو می یام خلک دأل خلگے ما درجہ می بھاکی تاکہ سے تھو تھأ نعمتا می آزمے کامے نعمت یأ تھوئے دیدتی، بےشک چھی رَب جلدی سزا دیو والا تُھو، آں بےشک سے چیر بوگوشُو والا چیر مہربان تُھو۔
الف لام میم صاد
أ کتاب (قرآن پاک) نازل کوا گودو تھیزید، دَ چھی حی تینگی نہ ہوئے ایما، مِسی کأ تو ایدے خلک بھیا (اللہ سی عذاب ما)، آں أ (کتاب) مومن آ سی کأ خونہ تُھو۔
تھو تنو پروردگار سی ڈھأرا نازل کویل کتاب سی تابعداری کوا، آں اللہ ما علاوہ دأل سأدا سی بأت کے کان نہ تھا، تھو ما چیر اَشوڑ (خلک) خونہ گھیندی۔
آں چیر گام مھوئے تباہ کی، آں تھأزید مُھن عذاب ڙأت کے ہُوویل می آپ، یا پیشی آ ہُوویل می۔
دَ ہین کی ڇاٹ نہ أشی کے یأ ہأزید مُھن عذاب آپ تہ، اَسے ہیئے بنودود بیشکہ مھو ظالم تھی۔
دَ مھوئے خامخا توَس کونین تھأ خلگا ما یأ تھأئے پیغمبر پیا گئیشی، آں خامخا توَس کونین مھوئے پیغمبرے ما۔
دَ بھی مھوئے بیان کونین ہأئے ٹول حالات (تنو) علم سی ذریعہ دے، آں (تے وخہ) مھو غیب نہ اَشئ۔
آں عمل آ سی تول (لیکھو( سی دی )قیامت( برحق تُھو، دَ کسی) نیک عمل آ سی( تول ائگی ہُوو ہیئے خلگے کامیاب ہونین۔
آں کِسی )نیک عمل آ سی) تول اِپھڑی ہُوو دَ ہے سے خلک تھی ہیئے تنو اَمن تاوان میں تھلودُو، کئیکہ ہے مُھن آیادا سید ناانصافی کوؤدود۔
آں بیشکہ مھوئے تھوئے دھیرین زید دھرو سی پوت دِیدتُو، آں ایزید تُھن کأ جیدون سی سامان سوادتو، چیر کم خلک تھوئے ما شکر نِگھالدی۔
بے شکہ مھوئے تھو پیدا کی، بھی تُھن جُثہ سَواد، بھی مھوئے مُلیگائے بَنو: "تھو سجدہ کوا آدم گے"، دَ ہیئے سجدہ کی بے ابلیس ما، ہے نا آشو سجدہ کوؤ والا آ می۔
(اللہ) بنو: "تھأ کا شیئی یے کھمو سجدہ سی کوؤ ما، کے یأ مأ تھیئے حکم دیدتا؟" بنو (ابلیس): "آ اے ( آدمؑ) ما غورہ تُھو، تأ مھأ پیدا کیدو آنگا ما، آں ایس تأ پَیدا کیدو سُم ما"۔
بنو (اللہ): "تو وائے وو مے پوت ما، چھی کی حق نہ آشو یأ تو مھید تکبر کوأدے، نوخ بے شکہ تو ذلیل خلگا ما تُھو!"۔
بنو (شیطان): "مھیئے مُہلت دے تے دِیا پورے یأ خلگے (قَورے ما) دوآر اُوشا بژنین"۔
بنو (اللہ): "بے شکہ تو تھیئے ما ہُو کیسکے یأ مُہلت دِیا گأ"۔
بنُو (شیطان):" دَ مے وجہ دے یأ تأ مھأ گمراہ کی، خامخا مأ (ہُم) بَھئ نین ہأئے چھی سِدا پَن زید"؛
"بھی مأ یے نین ہأئے ہین مُشیم دیشا آں ہین پیشیم دیشا، آں ہین سووین دیشا آں ہین أوین دیشا، آں تأ ہأما زیاد شکر نِگھالو والا نہ پانین"۔
بَنو (اللہ): "نُوخ مے پوت ما ذلیلہ ہوئیل رٹیل، البتہ کی یأ چھی تابعداری کیو، ہأما مأ جہنم پُن نین تھو ٹولا ما"۔
"آں اے آدمؑ! دھرا تو و چھی جَوَی جنت می، آں کھا تھو دوںئیدے کامے پوت ما تھو نیمادیو، آں نھیئ نہ ہوا مے تھام گے، نیأؤ تھوئے ظألما ما ہونین!"۔
دَ وسوسہ تھیلی ہأ دُونئائے شیطان، میلائی ڈاگہ کوئے ہین شرمگاہ ہأئے، کامیک یأ بُوریل آشِئ، آں بنو ہأ دُوںئائے (شیطان): "تھو تُھن پروردگار نہ کھمئیدی مے تھام ما، اَسے مِسی کأ یرأ ہوا تھو مُلیک، یائی تھو ہوا مُدام دھرو والا"۔
آں قسم کھوؤ اِی (شیطان) ہأ دونیائے: "بے شکہ آ تھو دُونیائے خونہ کوؤ والا تُھو"۔
دَ تی (شیطان) ہأ دُونئیدے دوکا کیدے راضی کی، دَ کے یأ ہیئے دوںئے تے تھام سی میوا چھکو دا، ڈاگا ہوئی ہأئے ہین شرمگاہ، آں ہے دوںئیدے تنو شرمگاہ آ زید جنت سی پاݜ تَھوؤسأد، آں آواز کی ہأئے ہین پروردگار: "کئی مأ منع نی کیشی تھو دونئیدے مے تھام ما، آن مأ نہ بنوشو یأ شیطان تھو دُوںئی آ سی اخکارہ دشمن تُھو؟"۔
ہیئے دُونئے بنو: "اے مھن پروردگار! مھوئے تُنو امن زید زأتیئی کیژی، آں کو تأ مھو نہ بگوشیئ آں مھوزید رحم نی کیو مھوئے ہونین تأوانی آ ما"۔
بنو (اللہ): "تھو وائے وا (جنت ما)، بعض تھوئے ما بعض آ سی دشمن ہونین، آں تھُن کأ دھیرین زید دھرُو سی پوت آں جیدون سی سامان ہونین اے وخہ پورے"۔
بنو (اللہ): "مے دھیرین زید تھوئے جیدون لھنگانین، آں ایمی تھوئے مونین، آں اِی ما تھو نِگھالا بژنین"۔
"اے آدمؑ سی اولاد! یقیناً مھوئے پیدا کیدی تُھن کأ کوژو، مِسی کأ ہے بورن تُھن شرمگاہ، آں ہے شیژواچا ہُم تُھو، اَسے پرھیزگاری سی کوژو چیر غورہ تھی، أ اللہ سی نیخانا تھی مِسی کأ ہے (خلک) خونہ گِھنن۔
اے آدم ؑ سی اولاد! شیطان تھو یئت خطا نہ کوئے،کھامو تی نِگھالی تُھن یئی و باپ (آدمؑ و حوا) جنت ما، ہین کوژو نِگھالئی یرأ ہین سَتر ہأئے اَخکارا ہوئے۔ بیشک پَشَدو سے تھو، سے آں تِسی قوم، مھال پوت ما یأ تھو نہ پَشَدی تھأ۔ بیشک مھوئے شیطان تھأ خلگا سی سأت سوأد یأ سے ایمان نہ آنَدی۔
آں کے یأ ہے بے شرمی سی کام کودی، ہے بَنَدی، مھوئے تَنو باپ داد (گھن) پأدیشی ایزید، آں اللہ مھوئے اِسی حکم دِیدُوشو۔ تو بَن (اے مھی پیغمبرؐ!) "بیشک اللہ حُکم نہ دیدو بے شرمی سی۔ آیا تھو اللہ زید تھأ بأت تھادی یأ تھو نہ جَنَدی؟"
تو بَن (اے پیغمبرؐ!): "مھی پروردگار مھیئے انصاف سی کوؤ سی حکم دِیدتو، آں (مے حکم دیدتو کہ) تھو تنو مُو ہر نماز سی وخا مخامخ کوا (بیت اللہ سی ڈھأر کے)، آں تیسکے ہاگا اخلاص کوؤ والا ہیدے تیسکے ہاگوؤ می، کھاموڑ یأ تی تھو اول پَیدا کیدی، ہاموڑ دُوآر پیدا کونین (مئک ما پأش)۔
(تھوما) اے ڈلہ ئے تی ہدایت دِیدیشی، آں دھوئیم ڈلہ زید گمراہی ثابت ہی۔ بیشکہ ہیئے اللہ ما علاوہ شیطان دوست سوأدیشی، آں ہے گمان کودی یرأ ہے ہدایت زید تھی۔
اے آدمؑ سی اولاد! ہر نماز سی پوت می تنو شیژواچا سی سامان (کوژو بدن زید) لھا، آں کھا و پُوا اَسے فالتو خرچہ نہ کوا۔ بیشکہ اللہ فالتو خرچہ کوؤ والا نہ خوشادو۔
تو بن (اے پیغمبرؐ!): "کی حرام کیدو اللہ سی شیژواچا، یأ تی تنو بندہ آسی کأ پیدا کیدو آں پاکیزہ رزق؟" تو بَن (اے پیغمبرؐ!) "أ تھأ خلگا سی کأ تُھو یأ تھیئے ایمان اَنودو دونیئی سی جیدون می، (آں) قیامت سی دی دا خاص ہین کأ ہونین"۔ ہاموڑ مھو بیان کودی آیأت تھأ خلگائے یأ سے جندی۔
توُ بن (اے پیغمبرؐ!): "بیشکہ حرام کیدی مھی پروردگار بے حیائی سی بأت، یأ سے ڈاگہ تھی اِیزمی آں یا سے بیرید تھی، آں گناہ سی کم آں ناحق سی ظلم، آں میس یأ تھو شِرک کوا اللہ سید، تیس یأ نازل نی کیدو اِیزید کی دلیل، آں میس یأ تھو بنا اللہ زید تھأ بأت یأ تھو نہ جَندی"۔
آں ہرے اُمت سی کأ اے نیٹہ (مقرر) تُھو؛ دَ کے یأ ہین نیٹہ آبو ہیئے بھی ایزما نأ اے ساعت پَدئے ہونین آں نأئی مُٹھائے۔
اے آدمؑ سی اولاد! کو اَئی تھوئے پیغمبر تھوما، یأ سے بیان کوؤدود تھوئے مھی آیات، دَ کی یأ پرہیزگأری کی آں تُنو لاڙاچا دھگو کی، دَ نہ ہونین ہأزید کی بھِیت آں نأئی ہیئے غمجن ہونین۔
آں کآم خلگے لوؤ گھنئی مھی آیات، آں قتنگأری کی ہیئے ما، ہے خلک دیزوخی تھی، ہیئے ایزمی مُوآ سی کأ ہونین۔
دَ کآم تُھو تے ماݜ ما گھن ظألم یأ سے سَوادو اللہ زید لَوو یا لووال گھنَدُو تِسی آیات؟ ہأ خلگائے ہین نصیب می کھیدیک (رزق) لگیل چھی دا تی اَوونین، تھیدیگا پورے یأ یےنین ہأئے مُھن مُلیگے ہین روح نِگھالُو سی کأ، دَ بننین ہائے: "کھید تھی سے (تُھن خدا) یأ تھو تھأئے ہاگوؤدود اللہ ما علاوہ؟ ہیئے بننین: "سے ہأڙأدتی مھوئے ما"، آں ہیئے شیدی دینین تُنو اَمن زید یرأ ہے کأفر اَشِیئ۔
اللہ حکم کونین لھنگا دیزوخ کے تھأ اُمتہ سید یأ لھنگئیشی تھو ما موش، پیرا ما آں انسانا ما۔ کے یأ لھنگنین اے ڈلہ تی لعنت کونین تُنو ہال دوئی ڈلہ زید، دَ کے یأ جمع ہونین دیزوخ می ٹولے دَ بَننین پیشیم ڈلہ مُشیم ڈلہ سی حق می: "اے مُھن پروردگار! ہیئے مھو گمراہ کِیشی، دَ تو ہأئے دُوگُن آنگا سی عذاب دے"، بننین (اللہ): "تُھو ہر ایک سی کأ دُوگن عذاب تُھو اَسے تھو نہ جندی"۔
آں بننین مشیم ڈلہ پیشیم ڈلہ ئے: "نی چھی تُھن کأ مُھن ڙید کی غوراوالے، دَ چَکھا عذاب تھأ عمل آ سی وجہ دے یأ تھو کوؤدود"۔
بیشکہ کآم خلگے لوو گھنیئ مُھن آیات آں مشروٹی دے مُو نُڑاد تھیئے ما، تھین کأ آسمان سی درواز پدا کوا نہ بژنین، آں تھیئے جنت کے نہ لھنگنین، تے وخہ پورے یأ اُخ نہ لھنگودو پیڑ سی ڈونگ دے، آں ہاموڑ مھو بدل دیدی مجرم آ یے۔
ہین کأ دیزوخ (می آنگا) سی تُولی آں ہین ڙید (تے آنگا سی) لھیب ہونین، آں ہاموڑ مھو بدل دیدی ظألما یے۔
آں کآم خلگے ایمان آنو آں نیک عمل کی، مھو تکلیف نہ دیدی اے نفس کے اَسے تِسی توآن سی برابر، ہے خلک جنّتی تھی، ہیئے ایزمی مُوآ ہونین۔
آں مھوئے دھوگو کونین کامیک یأ ہین سینہ آ می بغض آشو، روان ہونین ہین ٹیندے (اُو سی) کآن، آں ہیئے بن نین: "ٹول صفت تے اللہ سی کأ تھی کی یأ مھوئے مے پان پشأد؛ آں نہ اَشئی مھو مے پان پوؤ والا کو اللہ مھو مے پَن دے روان نی کِشیوو۔ بے شک اَئیشی مُھن پروردگار سی پیغمبر حق دین سمانے"، آں ہأئے آواز کوا بژنین: "أ جنت چھی، تھو اِسی وارث سَوا گئیدی تھأ (نیک) عمل آ سی وجہ دے یأ تھوئے (دونیئی) می کیشی"۔
آں آواز کونین جنتی یے دیزوخیائے یأ "مھوئے دا پاد کا یأ مُھن پروردگار مھوسید وعدہ کیشی سأس۔ دَ کئی تھوئے ہُم پاد کا یأ تھُن پروردگار تھوسید وعدہ کیشی سأس؟" دَ ہیئے بن نین "ہاں"۔ دَ بھی آواز کونین اے آواز کوؤ والا ہین مِیئے "اللہ سی لعنت چھی ظألما زید!"۔
ہے (ظألم خلک سے آشی) یأ منع کوؤدود خلک اللہ سی پن ما، آں لوٹَوؤدود ایزمی کولاچا، آں ہے آخرت ما انکار کوؤدود۔
آں ہین مِیئے پردہ ہونین، آں اعراف (جنت و دوزخ سی مِیئے دیوال) زید یام خلگے ہونین، ہیئے ہأ پأننین ہین نخے دے، آں ہیئے (اعراف والا) آواز کونین جنتی آئے "اے تھوزید سلامتی ہوئے!" ہیئے (اعراف والا) جنت می لا داخل نہ ہونین خو اِسی طم کونین۔
آں کے یأ (اعراف والا) نرانین تنو أݜی دیزوخی آ سی ڈھأر کے، دَ ہیئے بننین: "اے مُھن پروردگار! مھو ایپوت نہ کو ظألم خلگا سید"۔
آں آواز کونین اعراف والائے (دیزوخی) ماݜ آئے، ہیئے تھأ پأننین تھین نخے ما، ہیئے بنین: "کی فائدہ نہ دید تھوئے تُھن ڈلہ آں تُھن مشروٹی سی کوؤ"۔
"کئی أ (جنتی) سے خلک نہ تھی یأ تھو قسم کھوؤدود ہأئے اللہ نہ آوانین کی رحمت؟" (ہأئے دا بنا گا) "لھنگا جنت کے، تھید نہ ہونین تھوئے کی بھیت آں نأئی تھوئے غمجن ہونین"۔
آں آواز کونین دیزوخی یے جنتی آئے "اے ڈالا مھوزید دھأک اُو، یائی تے کھوؤ سی شیئی یأ اللہ تھوئے دیدتُو" تھیئے (جنتی یے) بننین: "بے شک ہأ دوںئیدے اللہ حرام کیدی کأفر آزید"۔
ہے سے خلک تھی یأ تھیئے تنو دین ما نَڑو آں تماشا سَوادوشو، دونیئی سی جیدونے ہأزید چھل کوأد۔ (اللہ بننین) "دَ کھامو ہیئے خلگے آژوک دی (قیامت) سی ییو اَموݜوشو، آں انکأری ہوؤدود مُھن آیادے ما، ہامو آش مھوئے ہأ اموݜا تھل نین"۔
آں مھوئے پیودو ہأئے اے کتاب، مھوئے تیس تفصیل دے بیان کیدو تُنو علم ما، ہدایت آں رحمت چھی مومن خلگا سی کأ۔
کئی ہے تِسی انجام ما علاوہ دوئی کی ہُم کُوٹھادی؟ کامے دی سے انجام آپ (کِسی یأ أ کتاب خبر دیدو دا) دَ بن نین تھیئے خلگے کی آموݜوشو ایز موش ما، "بے شکہ اَئیشی مُھن رب سی پیغمبر حق بأت زید۔ دَ تھلا مُھن یام سفارشی تُھو یأ مُھن کأ سفارش کوئے؟ یا مھوئے (دونیئی گے) بھی واپس پیا بژنین (مِسی کأ) کامے عمل مھو کوؤدود تا تھین پوت (نیک) عمل کیئی؟ بیشکہ ہیئے خلگے تُنو نقصان کی، آں ہاڙش نین ہأما تی یأ ہے اَمنا (لوو) سَوؤدود۔
بیشکہ تُھن رب اللہ تُھو، یأ تی پیدا کیدی آسمان و دھیرین ݜو دِی آ می، بھی قائم ہودو عرش زید۔ سے پردہ تھَلَدو ڙأت سی دی زید، ہے (ڙات) پأش ییژی تیزی دے دی زید، آں سی آں یُن آں تاء پابند تھی تِسی حکم سی۔ شید ہوا! ٹول مخلوق تِسی چھی، آں تِسی حکم چَلَدو، آں سے چیر برکت والا تُھو، رب تُھو ٹول جَہان آ سی۔
تھو ہاگا تُنو پروردگار کے عاجزی دے آں بِیرید بیرید، بے شکہ سے نہ خوشادو حد ما نخو والا۔
آں فساد نہ کوا دھیرین زید اِسی سوؤ ما بعد؛ آں ہاگا تُنو پروردگار کے بھیت تے آں طم دے، بے شک اللہ سی رحمت نھیو چھی نیک خلگائے۔
آں اللہ سے ذات تُھو یأ سے پیدو بیلأئی زِیرے (سمانے) تُنو رحمت (ہاگا) ما مُوش، مھیدا پورے، یأ کے ہے بھا کودی اِءگی اِءگی لڑے، دَ بھی مھو ہأ پیدی اے شوگیل گام گے، بھی مھو مُوژادی اِیزما اُو (ہاگا)، بھی اُو ما نیگھالدی ہر قسم سی میوا، ہاموڑ جینی کونین مھوئے مئیل، مِسی کأ تھو خونہ گھینا۔
آں آباد دھیرین نیِگھالژی تُنو نِیلا تُنو رب سی حکم دے آں کامے دھرین یأ خراب ہی و سے نہ نِگھالژی آسے بیکارہ شیئی مھاموٹ مھو باربار بیان کودی آیات تے قوم گے یأ سے شکر نِگھالَدی۔
بے شک مھوئے پیؤشو نوحؑ تِسی قوم گے، دَ تی بنو: "اے مھی قوم! تھو عبادت کوا اللہ سی؛ نہ تُھو تُھن دوئی خدا تیس ما سیوا؛ بے شک آ بھیدو تھوزید گھن دی سی عذاب ما"۔
دَ تِسی قوم سی گھنے بنو: "بے شکہ مھو تھأ پَشدی ڈاگا گمراہی می"۔
(نوحؑ) بنو: "اے مھی قوم! مھأمی کی گمراہی نی چھی، اَسے آ رسول تُھو ٹول جہان آ سی پروردگار سی دِشا"۔
آ آوادو تھوئے تُنو پروردگار سی سوالجواب، آں خونہ کودو تھوئے، آں آ جَندو اللہ سی دِشا تیسما یأ تھو نہ جَنَدی۔
"کئی تھو مے (بأت) زید حان تھی یأ أپ تُھوئے تُھن رب سی دِشا نصیحت اے ماݜ زید تھوئے ما، مِسی کأ سے تھو بھیے آں تھو پرھیزگار سَوا بژا، آں میلائی تھوزید رحم کوا بژے؟"۔
دَ ہیئے خلگے تیس (نوحؑ) لَوال گَھنو، دَ مھوئے خلاصی دید تیسکے آں تھأ خلگائے یأ تیسید کِشتی می (سور) اَشئ، آں مھوئے ڈوب کی تھأ خلک یأ مُھن آیات لَوال گھنئیشی؛ کی شک نی چھی سے خلک اَن اَشئ۔
آں مھوئے قوم عاد کے تھین بھا ھودؑ پیوشو، دَ تی بنو: "اے مھی قوم! تھو اللہ سی عبادت کوا، نہ تُھو تیسما سیوا دُوئی خدا، دَ کئی تھو (اللہ ما) نہ بھیدی؟"۔
دَ بنو گھنے تِسی قوم سی، کآم خلگے یأ کفر کیشو "بے شک مھو تھأ قمعقل توب می پَشَدی، آں بے شک مھو تھزید لَووال آسی گمان کودی"۔
تی (ہودؑ) بنو: "اے مھی قومأ! مھأمی نہ تُھو کی قمعقل توب اَسے آ تمام جہان آ سی پروردگار سی دِشا رسول تُھو"۔
"آ تھوئے تُنو پروردگار سی سوالجواب اَوادُو، آں تُھن کأ خونہ کوؤ والا آں امانتدا تُھو"۔
کئی تھو مے (بأت) زید حان تھی یرأ تھوئے تُھن پروردگار سی دِشا خونہ أپ تھوئے ما اے ماݜ زید، مِسی کأ یرأ تھو بھیے؟ آں یاد کوا یرأ تی تھو اَستازے (جانشین) سَوأد قوم نوحؑ ما پأش، آں تھوئے بدن سی گھینیئی دید، دَ یاد کوا اللہ سی نعمت، مِسی کأ تھو کامیاب ہوا۔
تھیئے بنو: "کئی تو مھوئے مِسی کأ آپ تُو یرأ مھو عبادت کیئی اَمن سید اللہ سی، آں مھو تھأ (معبود) چھیئی یأ تھین عبادت مُھن بوپ داد کوؤدود؟ کو تو سأزال تُھوو مھوزید تےعذاب آن کامیک ما یأ تو مھو بھیادُو"۔
(ھودؑ) بنو: "بے شکہ مقرر ہودُو تھوزید عذاب آں قہر تُھن رب سی دِشا۔ کئی تھو لات کودی مھیسید، تھأ ناما (بت) سی کأ یأ تھئیدی تھوئے آں تُھن بوپ دادے، نازل نی کیدو اللہ تیزید کی دلیل؟ دَ (اللہ سی فیصلہ سی) تھو ہُم کُوٹھا، آ ہُم تھوسید کُوٹھادو"۔
دَ مھوئے نجات دید تیس (ھودؑ) کےآں تھأ خلگائے یأ تیسید اَشئ تُنو دِشا رحمدیدے، آں مھوئے چھنیئی نأء تھأ خلگا سی یأ سے لووال گھنودود مُھن آیات، آں نہ اَشئ سے ایمان آنو والا۔
آں پیؤ مھوئے قوم ثمود کے تھین بھا صالحؑ، دَ تی بنو: "اے مھی قوم! تھو عبادت کوا اللہ سی؛ تُھن کأ تیس ما علاوہ دوئی یام خُدا نہ تُھو۔ آپ تو تھوئے اخکارہ دلیل تُھن رب سی دِشا۔ أ اُخأن چھی اللہ سی تُھن کأ اے نخ، دَ ایس چھوا دَ ہے چَیئے اللہ سی دھیرین زید، آں تُنو ہات نھیئی نہ کوا ایس کے لأݜ نیت تے، مھاموڑ نأ گݜے تھو اے شُل پووڑوؤ والا عذاب۔
آں یاد کوا کے یأ تی (اللہ) تھو نائب سَوأد قوم عاد ما بعد، آں آباد کی تھو دھیرین زید، یأ تھو سَوادی ہَوار دھیرین زید محل، آں کَھرَݜَدی کھن آ می شِیر۔ دَ یاد کوا اللہ سی نعمت آں نہ گئیا دھیرین زید فساد کوؤ والا۔
بنو تِسی قوم ما تھیئے گھنے یأ سے مشروٹی پشؤدود تھأ خلگائے یأ سے کمزور گھنا بژودود، (آں) تھیئے ایمان اَنوشو ہأئے ما: "کئی تھو (مے بأت ما) جَندی أ صالحؑ اللہ سی دِشا پیل پیغمبر تھو؟"۔ دَ تھیئے بنو: "بے شکہ مھو تھأ بأدا زید یأ ہے تھأزید پیا گودو، ایمان اَنو والا تھی"۔
بنو تھیئے کبرجن خلگے "بے شک مھو تھیئے بأدے ما یأ تھو تھأزید ایمان اَندی انکاری تھی"۔
دَ ہیئے اُخأن (سی بَھݜ چھیندے) مَئی آں نافرمانی کی تُنو رب سی حکم ما، آں ہیئے بنو "اے صالحؑ! کو تو پیغمبرے ما تُھوو، آن مھوزید تے عذاب یأ تو تِسما مھو بھیادو"۔
دَ گأد ہأ بُھومیلے آں ہے تُنو شِیر آ می موتھأل بژیل ہُوئی۔
دَ تی (صالحؑ) ہأما مُو نراد آں بنو: "اے مھی قوم! بے شک مأ تھوئے تُنو رب سی سوالجواب اَوادوشو آں تھوئے خونہ کیشو، اَسے تھو خونہ کوؤ والا نہ خوشَؤدود"۔
آں (مھوئے پیؤشو) لوطؑ، کے یأ تی تُنو قوم گے بنو: "کئی تھو تے قپیہا کام کودی یأ تیس تھوما موش یی ہُم نی کیدو، ٹول جہان آ سی خلگا می؟،
بے شک تھو تُنو خواہش پورا کوؤ سی کأ جَوئی چھیدے ماڙا سی کأنگے بَژدی، بلکہ تھو اے حد ما نوخو والا قوم تُھو"۔
آں نا آشو تِسی قوم کیش کی جواب اَسے تھیئے بنو: "ہأ نِگھالا تُنو گام ما، بے شکہ ہے خلک امن چیر پاک گھندی"۔
دَ مھوئے بچ کی تیس آں تِسی شِیر والا، بے تِسی جَوئی ما؛ سے پأشکے دھرو والا ما أشی۔
آں مھوئے تھأزید (بیڑیل آ سی) آگھا موژاد۔ دَ تُو بو کھال اَشُو انجام مُجرم آ سی!
آں مھوئے مدین (سی خلگائے پیؤشو) تھین بھا شعیبؑ۔ تی بنو: "اے مھی قومأ! اللہ سی عبادت کوا؛ تُھن کأ تِس ما علاوہ دُوئی یام خدا نہ تُھو۔ تُھن پروردگار سی دِشا تھوئے اخکارہ دلیل آپ تو۔ تھو پورا کوا ناپ تول آں کم نہ کوا خلگائے تھین شیئی۔ آں دھیرین زید فساد نہ کوا اِسی سوؤ ما بعد۔ أ کام تُھن کأ غورہ تُھو، کو تھو ایمان اَنو والا تھی۔
آں تھو نہ بَھیا ہرے پَن زید، تھو بھیادی آں کھمدی اللہ سی پَن ما، تھأ خلک یأ تھیئے ایمان آنودُو تیزید، آں تھو بیرَڑدی اے پَن می کولاچا۔ آں یاد کوا، کے یأ تھو آشوڑ اَشئ دا تی (اللہ) تھو چیری کی۔ آں بوا کھال آشو انجام فساد کوؤ والا آ سی۔
آں اے ٹل تھوئے ما تُھو، تی ایمان اَنودو تے سوالجواب زید یأ مھیزید پیا گودو، آں دھویم ٹلے ایمان نہ اَنودو۔ دَ تھلا تھو گزارا کوا تے وخہ پورے کے یأ اللہ مُھن مِیئے فیصلہ کویے، آں سے غورہ فیصلہ کوؤ والا تُھو"۔
(قوم سی) گھنے بنو، کآم یأ کبرجن اَشئ تِسی قوم ما، "اے شعیبؑ! خامخا مھوئے تھأ نگھالنین تُنو گام ما، آں تھأ خلک کی یأ تھیزید ایمان اَنودو، یا تھوئے واپس ہونین مُھن دین گے"۔ دَ تی (شعیبؑ) بنُو "کو مھو تُھن دین نو خوشادی بھی ہُم؟"
"بے شک مھوئے سَوانین اللہ زید لَوو کو مھو واپس ہوئی تُھن دین می، تِس ما بعد یأ اللہ مھو بچ کیدی اِسما، آں جائز نہ تُھو مُھن کأ یأ مھو واپس ہوئی ایسکے، اَسے کو اللہ نیمادُو یأ سے مُھن رب تُھو۔ گیر کِیدو مُھن پروردگار ہر شیئی تُنو علم می۔ اللہ زید مھو توکل کودی۔ اے مُھن پروردگار! تو حق سی فیصلہ کو مُھن آں مُھن قوم سی مِیئے، آں تو ٹولے ما غورہ فیصلہ کوؤ والا تُھو"۔
آں بنو تھین قوم سی گھنے یأ سے کأفر اَشئ: "کو تھوئے بات مینی شعیبؑ سی، دَ بے شکہ تھوئے ہونین تأوأنی خلک"۔
دَ گأد ہأ بھومیلے، آں ہے خلک تُنو شیر آ می موتھأل بژیل دَھرئی۔
کامے خلگے یأ شعیبؑ لووال گَھنوشو، سے خلک یابَنے یئد ہُم مے گام می نہ دھرئیشی؛ کامے خلگے یأ شعیب لووال گھنوشوؑ، سے خلک تاوانی اَشئ۔
دَ مُو نراد (شعیبؑ) ہأئے ما آں بنو: "اے مھی قوم! بے شکہ مأ تھوئے آواد تُنو رب سی جواب، آں خونہ کی تھوئے، دَ آ کھأکأ افسوس کیئی کأفر قوم زید؟"
مھامُو نہ ہودُو یرأ مھوئے اے گام کے پیغمبر پیوؤدو آں تھیت سی خلک سختہ آں تکلیف می نہ گأدتی، مِسی کأ ہے عاجزی کون۔
بھی مھوئے بدل کی سختہ سی پوت راحتہ، مھدیگا پورے یأ ہے غورہ چیری ہوئی (آں مالدہ ہوئی) آں ہیئے بنو: "بےشکہ مُھن بوپ داد کے (ہُم) مھاموڑ سختہ آں راحتہ أبیشی"، بھی مھوئے ہأ ناڅاپا گأد، آں ہے شید نہ اَشئ۔
کو ہیئے گام والائے ایمان آنوشُو آں پرہیزگار ہوئیشی، دَ مھوے ہأزید پدا کونیندے برکت آسمان ما آں دھیرین ما، اَسے ہیئے لوو گھنئ (پیغمبر)، دَ مھوئے ہأ گأد ہین عمل آ سی سزا می۔
دَ کئی گام سی خلگے اَمن می بے غمہ ہونیندے یأ ہأزید مُھن عذاب ڙأت کے اَپ آں ہے ہوبیل اَشئ؟
یا گام سی خلگے اَمن می بے غمہ ہونیندے مُھن عذاب ما یأ څاخ سی وخ می آپ آں ہے نَڑودود؟
اَیا ہے بےغمہ اَشئ اللہ سی تدبیر ما؟ دَ بے غمہ نہ ہودی اللہ سی تدبیر ما اَسے تاوأنی خلک۔
اَیا ظاہر نہ ہودُو تھأ خلگائے یأ سے وارث سَوا گئیدی دھیرین سی تِسی (پران) دھرو والا ما پأش، یا کو مھوئے نیمادو آوانین مھوئے ہأئے (عذاب) ہین گناہ سی وجہ دے؟ آں مھو ٹاپا ݜژادی ہین حِی آ زید، دَ ہے بات نہ بُھوژدی۔
أ سے گام تھی (اے محمدؐ!) مھو بیان کودی تھیئے ہین حالات۔ بے شکہ اَئیشی ہأئے ہین پیغمبر ڈاگا دلیل آ سمانے، اَسے نہ اَشئ ہے خلک ایمان آنو والا، مِسی کأ ہیئے مِسما مُوش (پیغمبر) لَوال گھنئشی۔ مھاموڑ اللہ کأفِر آ سی حی آ زید ٹاپا ݜژادو۔
آں مھوئے نہ پادوشو زیاد خلگا سی کأ لوظ سی پورا کوؤ۔ آں بے شک مھوئے پأدیشی زیاد خلک ہأما نافرمان۔
بھی ہیئے ما پأش مھوئے پیو موسٰیؑ تُنو معجزہ آ سمانے فرعون آں تِسی سردارائے، دَ ہیئے ناانصافی کی تھأ معجزا سید، دَ تو بُو کھأکأ آشو انجام فساد کوؤ والا سی!
آں موسٰیؑ بنو: "اے فرعونأ! آ جہان آ سی پروردگار سی دِشا پیغمبر تُھو
منأسب چھی مھی کأ آ نہ بینی اللہ سی بارہ می اَسے حق بات، بے شک مأ آنودو تھوئے ڈاگا دلیل تُھن رب سی دِشا، دَ تُو مھیسید چھو بنی اسرائیل"۔
بنو (فرعون): "کو تأ کی معجزہ اَنودُوو دَ تیس پَشا (مھوئے) کو تو سأس بنو والا تُھوو"۔
دَ تی (موسیٰؑ) تھیلی تُنو ہَمسا، دَ ناڅاپا (تے ساعد می) سے اژدہا سَواگأ اخکارہ۔
آں تی نِگھالُو تُنو ہات (کشال ما) دَ سے اُوژَل بڑقاٹ اَشو پَشُو والائے۔
بنو سردارے فرعون سی قوم ما "بے شک أ جنأل جادوگر تُھو
ہے نیمادُو یأ تھو نِگھالے تُھن دھیرین ما (تنو جادو دے)، دَ تھو کا حکم کودی؟"
تھیئے بَنو: "مہلت دے ایس کے آں اِسی بھئی گے، آں پے خار آ می جادوگر جمع کوؤ والا
ہے اَنن ٹول جنأل جادوگر"۔
آں فرعون گے جادوگر اَئی۔ ہیئے بنو: "بے شک مُھن کأ ہوئے بدلہ کو مھو غالب ہوئیو"۔
بنو (فرعون): "ہاں، آں بے شک تھوئے (مھی) نھیو خلگا می ہونین"۔
بنو (جادوگرے): "اے موسٰی یا تو (جادو سی شئی) تَھل یا مھو تِھیلی"۔
بنو (موسٰیؑ) "تھو تھلا!"، دَ کے یأ ہیئے تَھلئ (تنو جادو سی سامان)، دَ جادو کی خلگا سی أݜی آ زید، آں ہأزید بھیت أنی، آں چیر گھن جادو پَشاد۔
آں مھوئے وحی کی موسٰیؑ یے "تُو تھل تُنو ہَمسا!"، دَ تے سادیمُو (جان سوا بیشتے) تی نُوگُولئ تھأ شیئی یأ ہیئے سَوأدیشی۔
دَ ثابت ہو سأز، آں لووال ہُو سے یأ ہے کوؤدُود۔
دَ ہأئے (فرعون آں تیسی قوم گے) لرئی ہی تے پوت می، آں نُڑئی ہے شومیل۔
آں لار گئی جادوگر (اللہ یے) سجدہ می۔
تھیئے بنو: "مھوئے ایمان آنودُو بُٹ جہان آ سی پروردگار زید
یأ پروردگار تُھو موسٰیؑ و ھارونؑ سی"۔
بنو فرعون: "تھوئے ایزید مھی اجازت ما مُوش ایمان آنو۔ بیشکہ أ اے چَھل چھی تھو ایس مے خار می کودی، مِسی کأ یرأ تھو نگھالا اِسی دَھرو والا اِیزما۔ د چیر شیرتے تھوئے معلوم ہونین!
مأ تُھن ہادو کُھو اَدل بدل چِھن نین؛ بھی تھو ٹول پانسی زید اُوگھالنین"۔
تھیئے (جادوگرے) بنو: "بےشکہ مھو تُنو پروردگار سی دِشکے واپس بَژو والا تھی۔
آں ایِزما علاوہ تھزید مُھن کا بات لھیڙأ گھیڑیژی کہ مُھن پروردگار سی آیات مھوئے اَئی دا مھوئے ایمان آنو۔ اے مُھن پروردگار! تو ڈال مھوزید صوو، آں وفات کو مھو مسلمان"۔
آں بنو سردارے فرعون سی قوم ما: "کئی تو چھودو موسٰیؑ آں تِسی قوم (بنی اسرائیل) یأ سے فساد کوئن دھیرین زید آں چھون تھأ و چھی خدا؟" بنو (فرعون): "مھوئے مانین ہین جدک آں جین چھونین ہین سیرأن؛ آں یقیناً مھو ہأزید زوروڑ تھی"۔
موسٰیؑ تُنو قوم گے بنو: "تھو اللہ ما مدد نیما آں صوو کوا، بے شک دھیرین اللہ سی چھی، سے تُنو بنے ما اِسی وارث سَوادُو کآم یأ تی نیمادو۔ آں (غورہ) انجام پرہیزگار آ سی کأ تُھو"۔
بَنو (بنی اسرائیل): "چھی یِیؤ ما مُوش مھوئے تکلیف دِیا گوشو، آں چھی یِیو ما پأش ہُم"۔ بنو (موسٰیؑ): "طم تُھو تُھن پروردگار تُھن دشمن تباہ کونین۔ آں تھو دھیرین زید نائب سوانین، آں بھی تی بونین یأ تھو کھأکأ عمل کودی"۔
آں بے شکہ مھوئے گأدیشی فرعون سی خلک سوکڑہ می، آں میوہ آ سی نقصان می، مِسی کأ ہے خونا قبول کون۔
کے ہأزید خوشألی ییوؤدود ہے بَنودود "أ مُھن (حق) تُھو"۔ آں کے یأ ہأئے سختی آوؤدود ہے اِسپوراچا گھنودوت موسٰیؑ آں تِسی سأدا سی۔ خبردار! بے شک ہین بدنصیبی اللہ سی دِشا مقرر چھی، اَسے زیاد خلک ہأما نہ جَندی۔
آں ہے بَنودود: "کے یأ تو انَدو مھوئے کی نَخ، مِسی کأ کہ تو جادو کو مھوزید تیدے، دَ مھو نہ تھی تھأزید ایمان آنو والا"۔
دَ مھوئے ہأزید پیئی طوفان آں شلاک آں جِھیں آں مناک آں ڙات، بدل بدل نَخ، اَسے ہیئے لوئی کِیشی آں ہے اَشئ مجرم خلک۔
آں کے یأ ہأزید عذاب ییؤدود تہ ہے بنَودود: "اے موسٰیؑ! تو مُھن کأ تُنو پروردگار ما دعا نیما، کھاموڑ یأ تی تھیسید وعدہ کیژی۔کے تأ مھوما عذاب دھوگو کیو مھوئے خامخا تھزید ایمان اَننین، آں خامخا مھوئے تھیسید بنی اسرائیل بژوئے چھونین۔"
اَسے کے مھو ہیئے ما عذاب دھوگو کوؤدود یأ ہیئے اَوونین مقرر وخ کے، دَ ہے تُنو لوظ پھرؤدود۔
دَ مھوئے ہیئے ما بدل گھین، آں ہأ غرک کی دریاب می مِسی کأ ہے لوو گھنودود مُھن آیات، آں ہے تھیئے ما بے پرواہ اَشئ۔
آں سےقوم یأ کمزور حساب کوا بژودود، مھوئے تھأ وارث سَوأد سی نوخین (مشرق) آں سی بژین (مغرب) سی دھیرین سی، یأ تِسمی مھوئے برکت تھیلیشی۔ آں پورا ہی ہے شیژے وعدہ چھی رب سی بنی اسرائیل سید، میلائی ہیئے صوو کیشو۔ آں مھوئے تباہ کی کا یأ فرعون آں تِسی قوم سوَؤدود (محل آں باغ) یأ ہے منا آ زید تھلودود۔
آں مھوئے لنگھأد بنی اسرائیل دریاب ما؛ دَ ہے مھال اے قوم زید اَئی یأ سے عبادت کوؤدود تُنو بُھودا سی۔ دَ ہیئے (بنی اسرائیل) بنو: "اے موسٰیؑ! تو مھوئے اے خدا (معبود) سَوا ہین خدئ آ سی شانے"، (موسٰیؑ) بنو: "بے شک تھو جاہل خلک تھی۔
بے شک أ تباہ ہوؤ والا تُھو، ہین (بت پرستی سی کام) کامیک میں ہے لگیا تھی۔ آں ناحق تُھو سے عمل کامیک یأ ہے کودی"۔
(موسٰیؑ) بنو: "کئی آ اللہ ما علاوہ تھوئے دأل خدا بوئی؟ آں حال أ چھی یرأ تی (اللہ) تھوئے مے زُومان سی ٹول مخلوق آ زید غورا والے دیدچی"۔
آں یاد کوا کے یأ مھوئے تھو لھاسئ فرعون سی قوم ما، یأ سے تھوئے سخ عذاب آوؤدود؛ موؤدود تُھن جَدک آں جین چھوؤدود تُھن سیرأن۔ آں مِس می گھین اَزمیخ أشی تُھن پروردگار سی دِشا۔
آں مھوئے وعدہ کی موسٰیؑ سید دَش ڙأدو بیش آ سی، آں پورا کی تھأسید (ٹل کیدے دأل) دش ڙأت؛ دَ تِسی پروردگار سی نیٹا پورا ہُو دوبیش ڙأت آ سی۔ آں بنو موسٰیؑ تَنو بھئی ہارونؑ گے "تو مھی نائب ہو مھی قوم زید، آں کم ساپ کو آں فسادی آ سی پن دے نہ بَش"۔
آں کے یأ موسٰیؑ مُھن تھئیل نیٹا یے آپ، آں بأت کی تیسید تِسی پروردگار، بنو (موسٰیؑ) "اے مھی پروردگار! تو اَمن پَشا مھیئے آ چھی دیدن کیئی"، بنو (اللہ) "تو یید ہُم مھأ نہ پش بھادو اَسے تو کھن گے بُو؛ کو ہے ٹینگ دھرو تنو پوت زید دَ تأ ہُم مھأ پشنین"۔ دَ کے یأ تِسی پروردگار نور تھلو کَھن زید دَ تیس پِھٹ پِھٹ کی، آں موسٰیؑ بے ہوش ہیدے لار گا۔ بھی کے یأ سے ہوش می آپ تہ تی بنو: "چھی کأ پاکی چھی! آ تھیئے توبہ نِگھالدو، آں آ ٹولے ما اول ایمان آنو والا تُھو"۔
بنو (اللہ): "اے موسٰیؑ! بے شک مأ خوشادتو تھأ (بُٹ) خلگا ما تُنو پیغمبری آں بأدا سی کوؤ سی کأ، دَ گِھن تیس کامیک یأ مأ دِیدتو تھیئے آں ہو شکر نیگھالو والا ما۔
آں مھوئے لِگیشی تیس کے چیویل آ می ہر قسم نصیحت، آں ہر (ضروری) شیئی سی تفصیل؛ "دَ گݜ ہأ جُختہ (عمل کو)، آں تُنو قوم گے حکم دے یأ سے گݜن (عمل کون) ایس غورہ طریقہ دے، چیر شیرتے مأ تھوے نافرمان آ سی شِیر پشانین"۔
مأ تُنو آیادے ما نَرانین تھأ خلک یأ سے ناحق دھیرین زید قتنگأری کودی، کو ہیئے ٹول معجزہ ڈیڈ ہے بھی ہُم ایمان نہ اَنَدی ایزید۔ آں کو ہیئے پان ڈیڈ ہدایت سی دَ ہے نہ گݜَدی تیس بژو سی کأ، آں کو ہیئے ڈیڈ پان گمراہی سی دَ ہے گݜَدی تیس بژو سی کأ، مِسی کأ ہیئے مُھن آیات لووال گھنیئشی آں تھیئے ما بےپرواہ اَشئ۔
آں کامے خلک یأ مُھن آیأت آں آخرت سی ییؤ ما اِنکاری ہوئیشی تھین عملے ضائع ہونین؛ کئی ہے خلک کھال عمل کوؤدود تہ اَںئی تھال ہأئے بدلا دیا نہ بژے؟
آں موسٰیؑ سی قوم تِسی (بژو ما) پأش تُنو کالئی ما باس سَواد؛ سے اے وجود اَشو تِس ما گو سی آواز نُخُودود۔ آیا ہے خلک نہ پَشودُود یأ سے بأت نہ کو بھوؤدود ہأسید، آں نائی ہأئے کی پان پشا بھوؤدود؟ ہیئے تیس (خدا) سوادوشو آں ہے خلک ظالم اَشئ۔
آں کے یأ ہے خلک مے عمل ما شوما گئی آں ہیئے ڈیڈ یأ ہے گمراہ ہوئیدی، دَ ہیئے بنو: "کو مھو زید رحم نی کی مُھن پروردگار آں مھو نو بگوشئی دَ خامخا مھوئے تأوأنی (خلگے) ما ہونین"۔
آں کے یأ موسٰیؑ تُنو قوم گے غصہ می خپگان کوئین واپس آپ تہ تی بنو: "تھوئے مھی (بژو) ما پأش کھیدیک سخ لاݜ کام کیدو۔ کئی تھوئے تأدی کی تُنو پروردگار سی حکم ما؟" آں تی چیویل لار تھلئ آں تُنو بھئی سی ݜا سی بال گیݜتے تُونو ڈھأر کے ݲِھگئی۔ بنو (ہارونؑ) "اے مھی یئی سی پوأ! بےشکہ قوم مھأ کمزور گھنُوشُو، آں نھیو اَشو ہے مأ مَن دے۔ دَ تو نہ ہزا مھیزید دشمن، آں مھأ ظالم قوم سید حساب نہ کو"۔
بَنو (موسٰیؑ): "اے مھی پروردگار! تو مھأ و مھی بھا معاف کو، آں مھو تُنو رحمت کے لھنگا آں تو ٹولا ما زیاد رحم کوؤ والا تُھو"۔
بے شک کامے خلگے سَوادوشُو باس ما تنو خدا، ہأئے ہین رب سی دِشا غضب آوونین، آں دونیئی سی جیدون می شوم، آں مھو لَوو سوؤ والائے ہاموڑ سزا دیدی
آں کی یأ لاݜ عمل کیدے بھی تیزما پأش توبہ کی آں ایمان اَنو، بے شک چھی پروردگار تیزما پأش بُگوشو والا مہربان تُھو۔
آں کے یأ موسٰیؑ سی قار لھاد تہ تی اُوچات کی چیوَیل (تورات سی)؛ آں تِسی لِیگیل (مضمون) آ می خونا آں رحمت أشی، تھأ خلگا سی کأ یأ سے بھیدی تنو پروردگار ما۔
آں کارِیئی موسٰیؑ تنو قوم ما دش ماݜ و ڇبیش مُھن مقرر کوئیل نیٹا سی کأ۔ بھی کے یأ ہأ گأد بھومیلے دَ بُنو (موسٰیؑ) "اے مھی پروردگار! کو تُو نِموؤدُودو تأ میزما مُوش ہأ مانیندے آں مھأ (ہُم)۔ اَیا تُو مھو مادو تے کم سی بدل می یأ تیس قَمَقل خلگے کیدو مھوئے ما؟ أ نی چھی اَسے چھی (دِشا) اَزمیخ، تُو گمراہ کودو اِسی وجہ دے کآم یأ تأ نِمادو آں ہدایت دِیدو کیسکے یأ تأ نِمأدو۔ تُو مُھن کم سوؤ والا تُھو؛ دَ تُو مھو بوگوش آں مھوزید رحم کو، آں تو غورہ رحم کوؤ والا تُھو۔
تو مُھن کأ مے دونیئی سی نیگی لیک آں آخرت سی ہُم۔ بے شک مھو نُوڑدی تھیئے"۔ بنو (اللہ) "آ تُنو عذاب آوادو تیسکے یأ مأ نیمادو، آں مھی رحمت ہر شیئی زید خور چھی، دَ مأ ایس لیگنین تھأ خلگا می یأ سے پرہیزگأری کودی آں دیدی ذکواۃ، آں تھأ خلگائے یأ سے مُھن آیادا زید ایمان آنَدی"۔
کامے خلک بات بھوژدی تے پیغمبر سی یأ سے أمی تُھو، یأ تِسی ذِکر ہے پادی لیگیل اَمن سید تورات و انجیل می، سے ہأئے حکم دیدو غورہ کم آ سی، آں کھمدُو ہأ لاݜ کمے ما، آں حلال کودو ہین کأ پاک شیئی، آں حرام کودو ہأزید ناپاک شیئی، آں دھوگو کودو ہأما ہین بُوکھو حکم آں سخ سزا کامیک یأ ہأزید أشی۔ دَ کامے خلگے یأ ایمان اَنودُو تیزید، آں سأتویلی کودی تِسی، آں مدد کودی تِسی، آں تابعداری کودی تے لوش سی یأ سے نازل کوا گودو تیزید؛ اَںئی ہے خلک تھی یأ تھیئے کامیاب ہونین۔
تُو بن (اے پیغمبرؐ!): "اے خلگا ہانا! بے شک آ رسول تُھو تھو ٹولا سی کأ اللہ سی، تے اللہ سی یأ تِسی بأچیئی چھی آسمان آ سی آں دھیرین سی۔ تیس چھیدے نہ تُھو دوئی یام عبادت سی لیق؛ سے جینی کودو آں مادو۔ دَ تھو ایمان آنا اللہ زید آں تِسی رسول زید یأ سے رسول أمی تُھو، سے ایمان لردُو اللہ آں تِسی کلام زید آں تِسی تابعداری کوا مِسی کأ تھو ہدایت پا"۔
آں موسٰیؑ سی قوم می اے ڈلہ چھی یأ سے حق پان پشاژی آں حق ایدے انصاف کوژی۔
آں مھوئے ہأ دواش تابین آ می بھوگوئیشی زأن زأنی ڈلہ آ می، آں مھوئے وحی کی موسٰیؑ یے، کے یأ تی اُو نیماد تُنو قوم سی کأ، "تو داک دے ہمسا دے باٹ زید"، دَ روان ہوئی تیزما دواش اُس، بے شکہ ہر تابین پأنودود تُنو اُو سی پوت۔ آں مھوئے چیژول کیشو ہأزید آگھا سی، آں مھوئے نازل کیشی ہأزید من و سلوی، (میس بیندے یرأ) "تھو کھا پاک شیئی، تھأ یأ مھوئے تھوئے دیدتی"، آں مھوئے ہأزید ظلم نی کیشو اَسے ہے خلک تُنو اَمن زید ظلم کوؤدود۔
آں کے یأ ہأئے بنا گا "تھو مے خار می دھرا، آں کھا اِیزما کھیدا یأ تھو نیمادی، آں بنا (اے اللہ) تُو مھو معاف کو، آں لھنگا خار سی دروازیدے اللہ یے سجدہ کوئین؛ دَ مھوئے بوگوشنین تھوئے تُھن گناہ، آں مھوئے زیاد بدلہ دینین نیگی کوؤ والائے"۔
دَ بدل کی بات ہأمی تھیئے خلگے یأ سے ظلم کوؤدود، تیس چھیدے کا یأ تھأئے بنا گوشو، دَ مھوئے ہأزید آسمان سی دِشا عذاب پیؤ، مِسی کأ ہے ظلم کوؤدود۔
آں تُو ہأما تے گام سی بارہ مے تَوس کو یأ دریاب سی غاڑے می آباد اَشُو، کے یأ ہے خلک حد ما نُخودود لؤ آنگا سی دی؛ کے یأ لؤ آنگا سی دی (سبات) ہوؤدود ہأئے ماش (ڈاگا) اُوچات ہوئین ییوؤدود، آں کے یأ لؤ آنگا سی دی نہ ہوؤدود دَ ماش نہ ییودود۔ مھاموڑ مھوئے ہأزید اَزمیخ کی میلائی سے خلک نافرمان اَشئ۔
آں کے اے ڈلہ ہأما (دُوئی ڈلہ یے) بنو: "تھو کئی خونا کودی تے قوم گے یأ اللہ ہلاک کوؤوالا تُھو تھأ، یائی سخ عذاب دیؤ والا تُھو تھأئے؟"، تھیئے بنو: "مھو (خونا) مِسی کأ کودی یأ چھی پروردگار سی مُشکے تنو عذر کیئ، آں مِسی کأ بچ ہون (ہے خلک) گناہ ما"۔
دَ کے یأ ہیئے تے خونا اَموݜو یأ ہأئے کوا گوشو دا، مھوئے خلاصی دید تھأ خلگائے یأ سے ہأ کھمودود لاݜ ما، آں مھوئے ظألم خلک سخ عذاب می گأد، مِسی کأ ہے نافرمانی کوؤدود۔
دَ کے یأ ہیئے بغاوت کی تیزما یأ ہے کھما گئیشی، دَ مھوئے بنو ہأئے: "تھو سَوا بژا شادو ذلیلہ!"۔
آں (یاد کو) کے یأ اعلان کی چھی پروردگار یأ خامخا پینین ہأ (بنی اسرائیل آ) زید، قیامت سی دِی آ پورے، تھأ خلک یأ تھأئے آوانین سخ عذاب۔ بے شک چھی پروردگار شیرتے عذاب دیوؤ والا تُھو؛ آں بے شک سے بوگوشُو والا آں رحم کوؤ والا (ہُم) تُھو۔
آں مھوئے ہأ دھیرین زید ڈلہ ڈلہ آ می بَھگوئی۔ یام ہأمی نیک تھی آں یام ہأمی اِیزما علاوہ تھی (یعنی بدکار تھی) آں مھوئے ہین اَزمیخ کی غورہ آں لاش تے، مِسی کأ ہے واپس ہون (نافرمانی) ما۔
دَ پئیدا ہُوئی ہأما پأش لاݜ خلک، تھیئے گِھن کتاب میراث می، سے گھینَدی مال می ذلیل دونیئی سی، آں سے بَندی "مھوئے خامخا بوگوشا بژنین"۔ آں کے یأ أپ ہأئے مال ہاموڑ دوئی، دَ تیس (ہُم) گھیندی۔ کئی گھینا نہ گوشو ہأما پوخ لوظ کِتاب (تورات) می، یأ ہیئے نہ بننین اللہ سی بارہ می اَسے حق بات، آں پڑاؤ کیدے ہیئے تھأ احکام یأ سے تے کتاب میں اَشئی؟ آں آخرت سی شِیر چیر غورہ چھی تھأ خلگا سی کأ یأ سے اللہ ما بھیدی۔ کئی تھو عقل ما کام نی گھیندی؟
آں کامے خلک کتاب (قرآن) زید عمل کودی، آں نماز گُوزادی، بے شک مھو ضائع نہ کودی اَجر نیگی کوؤ والا سی۔
آں کے یأ مھوئے اُچات کی کھان ہین (بنی اسرائیل سی) ڙید یابنے سے چَتری أشی، آں ہیئے یقین کی یأ أ کھان لار بَیوُ والا تُھو ہأزید، (آں اللہ بنو) "گݜا جُختہ تھو تیس یأ مھوئے دیدتُو تھوئے، آں یاد کوا تھأ یأ مے کتاب می تھی، مِسی کأ یأ تھو پرہیزگار ہوا"۔
آں کے یأ نیگھالِئی چھی پروردگار بنأدم آ سی ڈاگ آ ما ہین اولاد، آں ہأ گواہ سیوأد تُنو اَمن زید، (بنو ہأئے) "کئی آ تُھن رب نہ تھو؟" تھیئے بنو "ہاں کئی نأ، مھو گواہی دیدی"۔ مِسی کأ تھو نہ بنا قیامت سی دی "بے شکہ مھو ایِزما بے خبر اَشئ"۔
یا تھو میس نہ بنا یرأ "مُھن بوب دادے شرک کیشی میِزما مُوش، آں مھو دا ہین اولاد اَشئی ہأما پأش، دَ تھلا تُو مھو ہلاک کودو تے کم سی وجہ دے یأ تیس کیشو باطل پرست خلگے؟"
آں مھو تُنو آیات مِسی کأ کولاؤ کولاؤ (اُولأدے؟) بیان کودی یأ ہے خلک حق سی دِش کے واپس ہون۔
تو ہأئے تے ماݜ سی خبر بیان کو یأ دیدیشی تیسکے مھوئے تنو آیادا (سی پوہا)، بھی سے نِگھاد (تھأزید عمل سی کوؤ ما) دَ تِسی پأشکے شیطان ݜاد، دَ ہُو سے گمراہ آ ما۔
کو مھوئے نیمادوشوو تِسی مرتبہ بھا کونیندے مھأ (آیات آ سی وجہ) دے، اَسے سے مائلہ ہُو دونیئی سی دِشکے آں تُنو خواہش پیش گا۔ دَ تِسی مثال کوژُو سی شانے تُھو؛ کو تیزید حملہ کی دَ جیب نیگھلَدو، آں کو تیس چھوؤ دَ بھی (ہُم) جیب نِگھلَدُو۔ أ مثال تے قوم سی تُھو یأ سے لَووال گھنَدُو مُھن آیات۔ دَ تو بیان کو مھأ واقعات مِسی کأ ہے پِھگر کوئن۔
چیر لاݜ مثال تُھو تھأ خلک آ سی یأ سے لَوو گھنَدی مُھن آیات، آں سے تُنو اَمن زید ظلم کودی۔
کیسکے یأ اللہ ہدایت کی دَ سے خلک سِدا پان پَوؤ والا تھی، آں کآم یأ گمراہ کوا گئی دَ سے خلک تاوانی تھی۔
آں بے شک مھوئے انسان آ می آں پَیر آ می چیر خلک دیزوخ سی کأ پَیئدا کیدی۔ تِھین مھال حی تھی سے نہ جنَدی تھیئے دے؛ آں تھین مھال أݜی تھی سے نہ پشَدی تھیئے دے؛ آں تِھین مھال کَن تھی سے نُو بُھژدی تھیئے دے؛ ہے خلک څاروئی آ سی شانے تھی، نأ، ہے تھیئے ما ہُم زیاد بے پَنا تھی۔ ہے خلک بے پرواہ تھی (یأ بأت کے کان نہ تھادی؟؟)۔
آں اللہ سی کأ تھی نام شیژو شیژو، دَ یاد کوا اللہ تھیئے دے۔ آں چھوا تھأ خلک یأ سے کولاچا نِگھلَدی تِسی ناما می، چیر شیرتے سزا دِیا بژنین ہأئے تھأ کم آ سی وجہ دے یأ ہے کوؤدود۔
آں اے ڈلہ چھی تھأ خلگا می یأ مھوئے پیدا کِیدی، سے حق سی دِش کے پان پشادی آں اِسی مطابق انصاف کودی۔
آں کامے خلگے مُھن آیات لووال گھنئیدی دَ مھوئے ہأ مھاموڑ دما دما سید گݜنین یأ ہیئے جن نین ہُم نأ۔
آں آ ڈھیل دِیدو ہأئے، بے شک مھی تدبیر چیر سخ تُھو۔
کئی ہے خلک پِھگر نہ کودی؟ ہین سأت (محمدؐ) زید کی لیونتوب نہ تُھو۔ ہے نہ تُھو اَسے ڈاگا بھیؤ والا۔
کئی ہے بودی نأ آسمان آں دھیرین سی بأچیئی، آں (تھأ می) یأ پیدا کیدی اللہ ہر اے شیئی، آں مے بأت می یأ نھیو اَپ تُو ہین نیٹا؟ دَ کامے بأت (زید قرآن) ما بعد ہے خلک ایمان اَندی؟
کامے ماݜ اللہ گمراہ کیو تیسکے یام ہدایت کوؤ والا نہ تُھو۔ آں اللہ ہأ خلک ہین سرتیزی می أنٹما ترَپو یے چھودو۔
(اے پیغمبرؐ!) ہے خلک تھأما قیامت سی بارہ می تَوس کودی یرأ کے تُھو تِسی ییؤ؟ تو بن: "بے شکہ تِسی علم مھی پروردگار کیش تُھو، آں تی ایس اِسی وخ زید اخکارہ کونین۔ چیر ایگی حادثہ ہونین آسمانا می آں دھیرین می۔ آں تی نأڅأپی تھوزید یےنین"۔ ہے تھأما مھاموڑ توَس کودی یابنے تو ایس (قیامت) بیرَڑدو۔ تو بَن: "اِسی علم دا صرف اللہ کیش تُھو، اَسے زیاد خلک نہ جنَدی"۔
تو بَن: "آ تنُو کأ گٹہ آں تاوان سی مالک نہ تُھو، اَسے کا یأ اللہ نیمادو۔ آں کو آ جَنودود غیب سی علم ما دَ خامخا مأ چیر گٹہ بھا کونیندے، آں مھیئے کی تکلیف نہ اَوونیندے۔ آ دا خبردأری والا آں زیرے دیوؤ والا تُھو تے قوم سی کأ یأ ایمان اَندی"۔
(اللہ) سے ذات تُھو کی یأ تھو پیدا کِیدی اے نفس (آدمؑ) ما، آں پیدا کی تِسما تِسی بی بی (حواؑ) مِسی کأ ہے تیسید آرام پَئے۔ دَ بھی کے یأ ہے (ماݜ) نھیؤ ہُو جوَئی گے، دَ سے (جوئی) ڈھے یے گأ اُپھٹ بَین (حمل) دے، دَ ہے گیؤدُود تِسمانے۔ دَ بھی کے یأ سے ایگی ہی تے حمل دے، دَ ہیئے دُوںئے عرضی کی اللہ یے، یأ ہین رب تُھو: "کو تأ مھوئے روغ بَچئی دِیدو مھوئے چھی شکر نِگھلو والا ما ہونین"۔
دَ کے یأ ہأئے روغ (بچئی) دید دَ ہیئے اللہ سید شریک سَوأد تِسمی یأ ہائے دِیدوشُو۔ اُوچات تُھو اللہ تِسما یأ ہے سوادی تیسید شریک!
اَیا ہے تھأ شریک سوادی یأ سے کی شیئی پیدا نو کوبھادی آں أمیدے پیدا ہوئیل تھی؟
آں نأ ہین مدد سی طاقت لَردی، آں نأئی تُنو اَمن سی مدد کوبھادی۔
آں کو تھو ہأ سِدا پن گے اَنوسأدو، ہیئے نہ مننین تُھن بَنو۔ تُھن کأ برابر تُھو یأ تو ہأئے ہاگادی یا غلے ہودی۔
(مشرک ہانا!) بیشک کیسکے یأ تھو ہاگادی اللہ چھیدے، سے تُھن شانے بَن (بندہ) تھی۔ تھلا تھو تھأئے ہاگا دا پکار تُھو سے تھوئے جواب دَن، کو تھو سأزال تھیو۔
اَیا ہین کُھو تھی یأ تھیئیدے ہے تِلو کون؟ یا ہین ہات تھی یأ تھیئیدے ہے گݜو کون؟ یا ہین أݜی تھی یأ تھیئیدے ہے پَشو کون؟ یا ہین کَن تھی یأ تھیئیدے ہے بُھوژو کون؟ تو بَن (اے پیغمبرؐ!) "تھو ہاگا تُنو معبودائے، بھی تدبیر کوا مھی خلاف، آں مھیئے مہلت نہ دا۔
بے شک مھی مددگار اللہ تُھو، سے ذات یأ تی نازل کیدو کتاب (قرآن)؛ آں سے ٹول نیک خلک آ سی مددگار تُھو۔
آں کامے خلگائے یأ تھو ہاگادی اللہ چھیدے، سے تُھن مدد سی توان نہ لَردی، آں نأئی سے تُنو اَمن سی مدد کوبھادی"۔
آں کو تھوئے ہأ سِدا پَن سی دِش کے ہاگأدو ہے نو بُھوژدی، آں تأ پشنین ہأئے ہے چھی دِش کے بُودی اَسے ہے نہ پشَدی۔
(اے پیغمبرؐ!) تو بخانہ گݜ (تنو عادت سوا)، آں نیگی سی حکم دے، آں جاھل خلگا ما مُو نرا۔
آں کو شیطان سی ڈھأرا چھی حی می کی وسوسہ پئیدا ہیو دَ اللہ سی پناہ نیما۔ بے شک اللہ بُھوژُو والا آں جَنو والا تُھو۔
کآم خلک یأ نیک تھی، کے یأ ہأئے شیطان سی ڈھأرا وسوسہ اَوَئیو، سے (اللہ) یاد کودی، تھلا سے (حی سی أݜیئے دے) صفا پَشدی۔
آں تھین (شیطان آ سی) بھئی ہأ ݲِھیگدی گمراہی سی دِش کے، بھی ہے کی کمی نہ کودی۔
آں کو تو ہأئے معجزہ مُٹھائے نہ کودو دَ ہے بنَدی "تأ کئی معجزہ تُنو اَمنا مُٹھائے نی کی؟" تو بَن (اے پیغمبرؐ!) "بے شک آ تابعداری کودُو تِسی یأ وحی کوا بژژی مھیئے مھی رب سی دِشا۔ أ (قرآن) دلیل تُھو تُھن رب سی دِشا، آں ہدایت و رحمت چھی تھأ خلگا سی کأ یأ سے ایمان اَنَدی"۔
آں کے قرآن بنا بژوسأدو تھلا تھو کان تھا تیسکے آں غلے ہوا، مِسی کأ یأ تھوزید رحم کوا بژے۔
آں یاد کو تُنو پروردگار تُنو حی می، عاجزی دے آں بِھیت تے، اُوچات آواز ما بغیر ڙات می آں جِھیم می، آں نو ہو غفلت کوؤ والا ما۔
بے شک کامے (مُلیک) یأ چھی رب کے نھیو تھی سے کِبر نہ کودی اللہ سی عبادت ما، آں تِسی پاکی بیان کودی، آں خاص تیسکے سجدہ کودی۔
(اے پیغمبرؐ) ہے خلک تھأما مال غنیمت سی بارا می توَس کودی، تُو بَن مال غنیمت خاص اللہ آں رسول سی چھی، پس تھو اللہ ما بھیا آں ایکدی سیت تعلقات غورا ساتہ، آں تابعداری کوا اللہ آں تِسی رسول سی، کو تھو ایمان والا تِھیو۔
بے شکہ ایمان والا سے خلق تھی کے یأ اللہ یاد کوا گاو تھین حی بھیدی، آں کے یأ تھأئے تلاوت کوا گأو تِسی آیادا سی سے ہین ایمان چیری کودی، آں ہے تُنو زب زید بھروسہ کودی،
کآم یأ نماز سی پابندی کودی آں تھأ شیئی آ ما خرچ کودی کا یأ مھوئے تھأئے دیدتُو۔
خاص ہے خلق سأس بنأ ایمان والا تھی، ہین کأ درجہ تھی ہین پروردگار سی دِشا آں بگوشو تُھو آں عزت سی روزی چھی۔
اے پیغمبرؐ) کھأکأ یأ چھی پروردگار تھأ چھی شیرا نِھگالُوشو حق سمانے (جہاد سی کأ) آں بےشکہ اے ڈلہ ایمان والا سی نہ خوشوؤدود۔
ہے خلک تھیسیت لات کؤدوُد حق بأت می تِسی اخکارا ہوؤ ما بعد، یابنے ہے ݜگا بژدی مئیک سی دِشکے آں ہے څارَدی۔
آں کے یأ اللہ وعدہ کؤدوُد تھوسیت دو ڈلہ آ ما ایک سی یرأ تی تُھن قابو می یینین، آں تھو نِمؤدوُد بے وَسلا ڈلہ تُھن کأ ہوئے، آں اللہ نِمؤدود یرأ حق ثابت کیئی تُنو حکم دے، آں چھینی کأفرا سی نا،
یرأ ثابت کوئے سأس آں ختم کوئے لوو، اگرچہ مجرم خلک نہ خوشادی۔
کے تھو فریاد کوؤدُود تُنو پروردگار کے دَ تی تُھن دعا قبول کی، یرأ مأ تُھن امداد کونین اے زر مُلیک ایکدی پیش پیدے۔
آں نہ سَوات مے امداد اللہ مگر تُھن زیرے سی کأ، آں مطمئن ہوئے حی تُھن، آں نی چھی مدد مگر صرف اللہ سی دِشا بیشکہ اللہ زبردست حکمت والا تُھو۔
کے یأ (اللہ) تھو زیت تُنو دِشا امن سی کأ (نین سی) گِھیل أنی، آں آسمان ما تھو زیت اُو مُوژاد تاکہ تھو پاک کوئے آں دھوگو کوئے تھوما شیطان سی پلیتی، آں مضبوط کوئے تُھن حی، آں کُو کوئے تُھن قدم۔
کے یأ وحی کی چھی پروردگار مُلیکائے یرأ آ تھو سیت تُھو، پس مضبوط کوا تھأ خلک کی یأ ایمان آنودُو، آ سمدستی کأفرا سی حی وا رعب تھیلی، دَ تھو چونجو آ سی ڙیت داک دا، آں ہین أنگیا سی ہر ہر بان سی داک دا۔
أ کھیاؤ یرأ ہیئے خلاف ورزی کِیشی اللہ و تِسی رسول سی، آں کی اللہ و تِسی رسول سی خلاف ورزی کیو بےشکہ اللہ سخت عذاب دیؤ والا تُھو۔
أ (تُھن عذاب تُھو) تَھلا چکھا تھو ایس، آں یقینًا کأفرا سی کأ دیزوخ سی عذاب تُھو۔
اے ایمان والا ہنا! کے یأ تھو لات سی کأ مُخامخ ہوؤسأت کأفرا سیت (جہاد می) تھلا ہین دِشکے پیٹھ نہ کوا۔
آں کی تے دی ہین دِشکے تُنو پیٹھ نرأد، اَسے واپس نوڑو سی کأ یا پناہ گھینو سی کأ اے ڈلہ سی دِشکے، دَ بےشکہ آوؤ ہے اللہ سی غضب کے، آں اِسی پوت دیزوخ تُھو، آں سے چیر لاݜ پوت تُھو۔
پس تھوئے ہأ نہ مَئی اَسے اللہ ہأ مَئی، آں تأ نہ تَھلوشُو کے یأ تَھلُو دا (میٹھ سیگل) بے شک اللہ تَھلوشُو، آں مِسی کأ یرأ اللہ آزومیخ کوئے مومنا سی تُنو دِشا غورا ازومیخ، بے شک اللہ بُھویو والا جنُو والا تُھو۔
أ (بات چھی کہ) بے شکہ اللہ کمزور کودوُد کأفرا سی چَھل۔
کہ تھو گٹہ نِمادی دَ بے شکہ اَوَئی تھوئے گٹہ، کہ تھوئے اَوَن کھمُوو دَ ای چیر غورا ہونین تُھن کأ، کہ تھو واپس ہُوئیو (نافرمانی کیدے) دَ مھوئے ہُم واپس ہونین (عذاب دینین)، آں یئت فائدہ نہ دینین تھوئے کی شیئی سی تُھن ڈلائے اگر کہ چیر زیاد ہوئے، آں اللہ یقینا ایمان والا آ سی سأت تُھو۔
اے ایمان والا ہنا! حکم مَنا اللہ سی آں تِسی پیغمبرؐ سی، آں مُو نُو نُوڑا تِما، آں تھو غورا کیدے بُھویَدی۔
آں تھو نہ ہوا تھأ خلگا سی چھلے کآم یأ بَندی مھوئے بُوت حالانکہ سے نہ بُھویدی۔
بے شکہ اللہ سی نیز می لاݜ زیناور سے تھی کآم یأ بو تھی چار تھی سے (خلک) کآم یأ نہ جنَدی۔
کہ اللہ ئے ہأ می کی غوراتوب معلوم ہُوشُوو خامخا ہأئے بُھویانیندے، آں کہ ہأئے بھُویادوشُو ہُم دَ ہیئے بوت نُوڑانیندے، آں ہے تھی بوت نُوڑوؤ والا۔
اے ایمان والا ہنا! تھو حکم قبول کوا اللہ آں تِسی رسول سی، کے یأ ڇاڑ کِیو تھوئے تے دین سی دِشکے کا یأ تھو جینی کودُو، آں جَنا تھو بے شکہ اللہ حائل ہودُو ماݜ آں تِسی حی سی درمیان، آں یقیناً تھوئے تِسی دِشکے جمع کوا بشنین۔
آں اَون بچ کوا تے عذاب ما یأ تی صرف تھو می ظألمائے نہ آوانین، آں جَنا تھو بےشکہ اللہ سخت عذاب دیؤ والا تُھو۔
آں یاد کوا کے یأ تھو دھرینے اَشُوڑ (آں) کمزور حساب ہوؤدود، تھو بِھیؤدود مے بات ما ییرأ خلگے تھو ڈیاینین، بھی تی پوت دید تھوئے، آں طاقت دید تھوئے تُنو مدد دے، آں رزق دید تھوئے پاک شیئیے ما، ییرأ تھو شکر ادا نِگھالا۔
اے ایمان والا ہنا! خیانت نہ کوا اللہ و رسولؐ سیت، آں خیانت نہ کوا ایکدیا سی امانات آ می، آں تھو غورا جنادی۔
آں تھو (مے بأت ما) جنا بےشکہ تُھن مال آں تُھن اولاد اَزومیخ تُھو، آں بےشکہ اللہ کیش گھن اَجر تُھو۔
اے ایمان والا ہنا! کہ تھو اللہ ما بِھیو تی تُھن کأ حق و باطل سی درمیان فرق سوا نین، آں دھگو کونین تھو ما تُھن گناہ آں تھو بگوشنین، آں اللہ گھن فضل والا تُھو۔
آں کے یأ کافر خلک چَھل کوؤدُود چھی خلاف یرأ سے تھأ بان کوئن یا تھأ مَئن یا تھأ وطن ما نِگھالن آں ہے چھل کوودود آں اللہ ہم ہین جواب می تدبیر کوؤدود، آں اللہ ٹولے ما غورا تدبیر کوؤ والا تُھو۔
آں کے یأ تلاوت کووا بَژدی ہأئے مُھن آیات دَ ہے بَندی مھوئے بیدتی، کہ مھو نِمؤسأدو مھو ہُم ہِن چَھلے (کلام) بینی، نی چھی ہے مگر صرف قصہ پخوانی خلگا سی۔
آں کے یأ بنو ہیئے اے اللہ! کہ تُھو أ (اسلام) سأس (دین) چھی دِشا، دَ مُوژا مُھن ڙیت آسمان ما باٹ یا آن مھو زیت دردناک عذاب۔
آں اللہ عذاب نہ دیدوُ ہأئے کے یأ تُو ہأ می موجود ہُوو، آں اللہ عذاب نہ دیدو ہأئے کے یأ ہے استغفار بنُوسأدو۔
آں کا وجہ چھی ہین کأ یرأ اللہ ہأئے عذاب نے دینین، حالانکہ ہے خلک مسجد حرام ما بان کودی آں نأئی ہے اِسی واگدا تھی؟ نی تھی واگدا اِسی مگر صرف پرہیزگار خلک، اَسے چیر خلک ہأ می نہ جنَدی۔
آں بیت اللہ سی کأشکے ہین نماز کا تُھو بَس ݜُوںئیاں سی دیؤ آں چأ آ سی دیؤ، دَ مھیرے چَکھا تھو عذاب تے وجہ دے یأ تھو کُفر کوؤدود۔
بے شک کامے خلگے یأ کفر کِیدُو سے تُنو مال مِسی کأ خرچ کودی یرأ خلک بان کوئن ہے اللہ سی پَن ما، پَس چیر دستی خرچ کونین ہیئے اے مال (اَسے) بھی تی ہین افسوس سی سوَب ہونین، بھی ہیئے مغلوب کوا بژنین، آں کامے خلک یأ کأفر تھی ہیئے دیزوخ سی دِشکے جمع کوا بژنین،
مِسی کأ یرأ اللہ جُدا کوے ناپاک پاک ما، آں بھی ناپاک شیئی ایکدی سی ڙیت تَھئے، بھی ہأ ٹولا سی اے ڈھیری سَوأدے بھی تے ڈھیری دیزوخ کے تَھلے، اَںئی ہےخلک تاوان می تھی۔
بَن (اے پیغمبرؐ) تھأ خلگائے کآم یأ کأفر تھی، کہ ہے قلار ہوئیو ہیئے بگوشا بژنین (تھأ گناہ آ سی کأ) کآم یأ مُوش کِیدی دا، آں کہ بھی ہُم ہیئے نافرمانی کِیو دَ مُوشِک خلگا سی طریقہ (ہین أݜی آ سی مُوش) گادُو۔
آں تھو لات کوا ہأسیت تھیدیخانا پورے کے یأ فتنہ ختم نی ہیو آں ٹول دین اللہ سی کأ خاص نُو ہُودوو، کو ہے قلار ہوئی دَ بےشکہ اللہ پشُو والا تُھو تھأ اعمالا سی کامیک یأ ہے کودی۔
کہ ہیئے بوت نَرات دَ جنا کہ بےشکہ اللہ تُھن سأت تُھو، ٹولے ما غورا سأت آں غورا مدد کوؤ والا۔
آں جَنا تھو بےشکہ کا شیئی تھوئے مال غنیمت می گِھنتُوو اللہ سی کأ تِسمی پینجم حصہ تُھو، آں پیغمبرؐ سی کأ، آں نسبی آ سی کأ، آں یتیما سی کأ، آں مسکین آ سی کأ، آں مسأفرا سی کأ، کہ تھوئے ایمان اَنودُو اللہ زیت، آں تے کتاب زیت یأ نازل کِیدو مھوئے تُنو بندہ زیت حق آں باطل می فیصلہ سی دی، کامے دی اے پوت اَئی دُو لخکر، آں اللہ ہر شیئی زیت قدرت والا تُھو۔
کے یأ تھو نھیو دِشکے اَشِئی آں ہے دُھو دِشکے اَشِئی، آں قافلہ تھو ما ٹین گے أشی، کہ تھوئے ایکدی سیت وعدہ کِشیو اختلاف کونیندے تھوئے وعدہ می، اَسے پورا کوؤدُود اللہ اے کام سے ہوؤ والا اَشُو، یرأ ہلاک ہوئے کآم یأ ہلاک ہُودا دلیل دے، آں جن دھرے کآم یأ جن دھردُو دلیل دے، آں بےشکہ اللہ بُھویو والا جنو والا تُھو۔
یاد کو کے یأ اللہ ہأ تھیئے چھی نین می اَشُوٹ پشأد، کہ اللہ ہأ تھیئے چَیر پَشأدیشیو خامخا تھوئے حی ڈیگانیندے، آں خامخا اختلاف کونیندے تھوئے اے کَم می، اَسے اللہ بچ ساتِئی، بے شکہ سے حی سی بیادیدے جَندُو۔
آں کے یأ سے پشؤدُود تھوئے ہأ اَشُوڑ تُھن أݜی آ می کے یأ تھو مُخامخ ہُوئیدا، آں اَشُوڑ اخکارا کی تھو تھین أݜی آ می، یرأ پورا کوئے اللہ تے کام سے ہوؤ والا تُھو، آں اللہ سی دِشکے ٹول کَمے واپس کوا بژنین۔
اے ایمان والا ہانا! کے یأ مُخامخ ہوؤسأت تھو اے ڈلہ سیت دَ مضبوط ہوا تھو آں اللہ چَیر چَیر یاد کوا، مِسی کأ یرأ تھو کامیاب ہوا۔
آں حکم منا اللہ سی آں تِسی پیغمبر سی آں ایکدی آ سیت لات نہ کوا نأو تھوئے کیمزیری ہونین آں تُھن رعب بشنین، آں صوو کوا بےشکہ اللہ صوو کوؤ والا سیت تُھو۔
آں تھأ خلگا سی چَھلے نہ ہوا کآم یأ تُنو شیرے ما غرور تے نِگھأت آں خلگائے اَون پَشؤدود، آں بان کؤدود خلک اللہ سی پن ما، آں اللہ ہین کما سی احاطہ کوؤ والا تُھو۔
آں کے یأ ہین کأ شیطان ہین اعمال شیژیئی کی دَ تی بنُو یام ہُم خلگے ما تھو زیت آج غالب نہ بے بھادُو، آں بےشکہ آں مدد کوؤ والا تُھو تُھن، بھی کے یأ مُخامخ ہُوئی دا دُو ڈلہ دَ سے واپس ہُو تُنو کِھین آ زیت آں تی بنُو: بے شکہ آ بری تُھو تھوئے ما، بے شکہ آں پشدوُ کا یأ تھو نہ پشَدی، بےشکہ آ اللہ ما بھیدوُ، آں اللہ سخت عذاب دیؤ والا تُھو۔
کے یأ منافق (خلگے) بنُو آں تھیئے خلگے کامیگا سی حی آ می مرض چھی (کئیدا) قُتنگاری کیدی ہأ ہین دین، آں کی توکل کیو اللہ زیت دَ بے شکہ اللہ چیر زبردست حکمت والا تُھو۔
آں کہ تأ ڈیڈ کے یأ مُلیک کأفرا سی روح نِگھالَدی، سے داک دیدی ہین بودا سی آں ہین ڈاگا سی، (آں بنَدی سے) چکھا تھو دھژؤ والا عذاب۔
أ تے عمل سی وجہ دے تُھو کامیک یأ تھوئے تُنو ہادیدے مُوش پیؤشُو، آں اللہ تُنو بندہ آ زیت ظلم کوؤ والا نُو تُھو۔
ہین حالت فرعون سی قوم سی چھلے چھی، آں تھأ خلقگا سی چَھلے چھی کامیک یأ ہیئے ما مُوش اَشیئی، تھیئے اللہ سی آیادے ما انکار کیشو، تھأ اللہ تھین گناہ آ می گأت، بے شکہ اللہ چیر طاقت والا سخت عذاب والا تُھو۔
ہے کھیاؤ بے شک اللہ یئت تے نعمت سی بدل کوؤ والا نہ تُھو کامیک یأ اے قوم زیت کیو، کھیدیخانا پورے ہیئے أمیدے تُنو عمل بدل نہ کیو، آں یقینا اللہ بِھوژُو والا جنوُ والا تُھو۔
ہین حال فرعون سی قوم سی شانے چھی، آں تھأ خلگا سی شانے کآم یأ ہیئے ما مُوش اَشیئی، ہیئے لوو سی نسبت کی تُنو پروردگار سی آیات آ سی دِشکے، دَ بھی ہلاک کی مھوئے ہأ ہین گناہ آ سی وجہ دے، آں مھوئے غرک کی فرعون سی قوم، آں ہے بُٹ ظلم کوؤ والا اَشیئی۔
بے شکہ جَن شیئی آ می چیر زیات لاݜ شیئی اللہ سی نیز می سےخلق تھی کی یأ کُفر کِیدوُ، پس ہے ایمان نہ اَنَدی۔
ہے سے خلک تھی تأ ہیئے ما وعدہ گھین چی، بھی ہے پَھرادی تُنو وعدہ ہر پیرا، آں ہے نہ بھیدی (اللہ ما)
دَ تأ ہأ لات می پأدو ݜگا ہین زریعہ کآم خلک یأ بعد والا تھی، مِسی کأ یرأ نصیحت حاصل کوئن۔
کو تُو بھیدو اے قوم سی لوظ پَھرؤ ما دَ خبر دے ہأئے (لوظ سی ختم کوؤ سی) یرأ دُوںیدے برابر ہوئن، اللہ لوظ پھرؤ والا نہ خوشادُو۔
آں گمان نہ کوئن کأفر خلک یرأ ہے مُوٹھائے گئی، بے شکہ ہے مھو کمزور نہ کو بھادی۔
آں تھو ہین کأ طاقت تیا کوا کھیدیک تُھن وس می چھیو، آں تھأ گھو یرأ تھو تھأدے بھیادی اللہ سی دشمن آں تُنو دشمن، آں ہیئے ما علاوہ دأل خلک تھأ تھو نہ پأندی اللہ تھأ پأندو، آں کا یأ تھو خرچ کودی کآں شیئیے ما اللہ سی پَن می تِسی پورا پورا بدلہ دیا بژنین تھویئے، آں تھو زیت ظلم نہ ہونین۔
آں کو ہے راضی ہوئی روغہ یے دَ تھو ہُم راضی ہوا اے دِشکے، آں اللہ زیت بھروسہ کوا، بےشکہ سے ہو بات بُھویو والاجنو والا تُھو۔
کو ہیئے ارادہ کی یرأ تھیئے دوکا دَن دَ بے شکہ چھی کأ اللہ کافی تُھو، اللہ سے ذات تُھو یأ تھأ مضبوط کی تنو مدد دیدے آں ایمان والائے دے۔
آں مینہ تھلُو ہین حیئے وا، کو تأ کا یأ دھیرینے تُھو تیس بُٹ خرچ کیشو بھی ہُم مینہ نہ تَھل بھانیندے ہین حیئے وا، اَسے اللہ مینہ تھلُو ہین می، بے شکہ سے چیر زبردست حکمت والا تُھو۔
اے نبیؐ! کافی تُھو چھی کأ اللہ آں سے ایمان والا کآم یأ چھی تابعداری کودی۔
اے نبیؐ! ترغیب دے مسلمانائے جہاد سی، کو تھوئے ما بیش جَن صوو کوؤ والا اَشیئو تھیئے غالب ہونین دو سو جَنا زیت، کہ تھوئے ما پاںئی بیش جَن اَشیو دَ تھیئےغالب ہونین زر تھأ جَن آ زیت کآم یأ کأفر تھی، کھأؤ ہے مھال قوم تُھو سے نہ جنَدی.
مھیرے اِپھیڑی کی اللہ (بوجھ) تھوئے ما، آں اللہ ئے پتہ چھی یرأ بے شک تھو می کمزورتیا چھی، پس کو اَشیئی تھو می پاںئی بیش جَن صوو کوؤ والا دَ ہیئے غالب ہونین دو سو آ زیت، کو تھوئے ما زر جَن اَشیئی دَ ہیئے غالب ہونین دُو زر جَنا زیت اللہ سی حکم دے، آں اللہ صوو کوؤ والا سیت تُھو۔
نبی ئے مناسب نہ تُھو یرأ تیس کیش قیدی ہون کھیدیخانہ پورے دھیرینے (دشمنا سی) غورا ڙات نہ ڈالودُوو، تھو دُونیئی سی مال نِمادی آں اللہ آخرت نِمادُو، آں اللہ چیر زبردست حِکمت والا تُھو۔
کو اللہ سی لیگیل (حکم) مُوش ما مقدر نہ اَشُوو دَ کا یأ تھوئے (فدیہ) گھِنتُو تِسی بدل میں خامخا تھوئےگھن عذاب اَوونیندے۔
پس کھا تھو تِیما کامیک یأ تھوئے مال غنمیت می گھین دا سے حلال پاک مال چھی، آں بھیا اللہ ما، بے شک اللہ بگوشو والا رحم کوؤ والا تُھو۔
اے پیغمبرؐ! بَن تھأ قیدی آ ئے کامیک یأ تُھن ہات می تھی، کو اللہ ئے معلوم ہو یرأ تُھن حی آ می خیر تُھو دَ تھوئے چیر غورا (مال) دینین تِما کامیک یأ تھوئے ما گھینا گأئی، آں معاف کونین تھو، آں اللہ بگوشو والا رحم کوؤ والا تُھو۔
کو ہیئے ارادہ کیژی تھیسیت خیانت سی کوؤ سی دَ ہیئے مُوش اللہ سیت (ہُم) خیانت کیژی، پس (اللہ) دید تھوئے ہین ڙیت طاقت، آں اللہ جنوُ والا حِکمت والا تُھو۔
بے شک سے خلک کھیئے یأ ایمان اَنو آں ہجرت کی آں جہاد کی تُنو مال دے آں تُنو بدنے دے اللہ سی پَن می، آں سے خلک کھیئے یأ پناہ دید آں مدد کی، ہے ٹول خلک ایکدی آ سی سیأت تھی، آں سے خلک کھیئے ایمان اَنُو آں ہجرت نہ کی دَ تھأسیت تُھن کی رشتہ داری سی تعلق نُو تُھو کھیدیخانہ پورے ہیئے ہجرت نی کیوؤ،کو تھیئے تھو ما دین سی بارہ می مدد نِمأدو دَ تھو زیت (تھین) مدد کوؤ فرض تُھو، خو تے قوم سی خلاف نا یأ تُھن آں تھین درمیان معاہدہ چھی، آں اللہ پَشدُو کا کام یأ تھو کودی۔
آں کامے خلک یأ کأفر تھی دا سے ایکدی آ سی سأت تھی، کو تھوئے مھأ زیت عمل نہ کیو دھیرین زیت گھین فتنہ آں گھن فساد ہونین۔
آں سے خلک کھیئے یأ ایمان اَنو آں ہجرت کی آں جہاد کی اللہ سی پَن می آں سے خلک کامیگے پناہ دید آں مدد کی اَںئی ہے خلک سأزبین سی ایمان والا تھی، ہین کأ بگوشو آں عزت سی رزق چھی۔
آں کامے خلگے بعد می ایمان اَنو آں ہجرت کی آں تھو سیت ایپوت جہاد کی دَ سے خلک ہُم تھو سیت تھی، آں نھیو رشتہ دار اللہ سی کتاب می ایکدی آ سی زیات حقدار تھی، بے شک اللہ ہر شیئی غورا پیأنو والا تُھو۔
اللہ آں تِسی رسولؐ سی دِشا بے زاری سی اعلان تُھو، تھأ ٹول مشرک آ سی خلاف کیسیت یأ تھوئے معاہدہ کیشو۔
اِسی کأ (اے مشرک ہانا!) تھوئے چؤ مائے پورے اِجازت چھی لخا تھو (عرب سی) دھیرین زید آزاد گئیا، آں مے بات یاد ساتا، تھو اللہ کمزور نو کوبھادی، آں مے بات ہُم لخہ اللہ کأفر ذلیل کوؤٔ والا تُھو۔
أ اے اعلان تُھو، اللہ آں تِسی رسولؐ سی دِشا، ٹول انسان آ سی کأ حج اکبر سی دِیئے، کہ اللہ مشرکین (آ سیت معاہدہ) ما ہات اُوچات کی آں تِسی رسولؐ ہُم، مھیرے کو تھوئے توبہ کی، دَ می تُھن کأ چیر غورہ ہونین، کو تھوئے (مھیرے ہُم) تنو مُو نڑادو، دَ یاد ساتا تھو اللہ کمزور نو کوبھادی۔ آں کأفر آئے اے تکلیف دیؤ والا عذاب سی زیرے دا،
سیوائے تھأ مشرکین آ ما کیزید تُھن معاہدہ أشی، بھی ہیئے خلگے تھوسید وعدہ می کی کمی نی کی آں تُھن خلاف یِسی مدد ہُم نی کی۔ دَ ہأزید ہویل معاہدہ سی نیٹہ پورا کوا، یقیناً اللہ احتیاط کوؤٔ والا خوشادو۔
بھی کے یأ حُرمت والا ما لھنگئیو دَ تھأ مشرک (کامیگے تھوزید وعدہ خلافی کیشی دا) کھید ہُم پأدو ما، آں تھأ گݜا، تھأ گیر کوا، آں تھین گݜو سی کأ بَھیا ہر بیریت پوت زید۔ ہاں کو تھیئے توبہ کی آں نیماز قائم کی، آں ذکوٰۃ دید، دَ ہین پان چھوا، یقیناً اللہ چیر بوگوشو والا گھن مہربان تُھو۔
آں کو مشرگے ما یام تھأما پناہ نیمؤسأدو دَ تیسکے تے وخ آ پورے پناہ دے یأ سے اللہ سی کلام بُھوژے، بھی تیس تِسی اَمن سی پوت آ پورے آوا، میس اِسی کأ یرأ ہے مھال خلک تھی یأ ہأئے پتہ نی چھی۔
ہأ مشرک آ سیت اللہ آں تِسی رسولؐ سی لوظ کھأکأ دھر بھادو (کامیگے وعدہ پھیرأدتا)؟ البتہ کامے خلگا سیت تھوئے مسجد حرام گے نھیو لِیگیل کیدا، کھیدیخانگے سے تھوزید سیدا دھرئیو، تھو ہُم تھأزید سیدا دھرا، یقیناً اللہ پرہیزگار خلک خوشادو۔
(اَسے دأل مشرک آ زید) لیگیل کھأکأ دھربھاژی؟ آں ہین حال أ چھی یرأ کو یئت تھوزید زوروڑ اَئیو دَ تُھن معاملہ می نأ دا کی عزیزویلی سی خیال کودی آں نأئی کی لیگیل سی۔ ہے تھو تنو أں سی بأدیدے خوشحال کوؤٔ نیمادی، حالانکہ ہین حی نہ مندی، آں ہأمی چیر خلک نافرمان تھی۔
ہیئے اللہ سی آیادا سی بدل می (دُونیئی سی) دھأک قیمت گھینو خوشاد، آں تِسی نتیجہ می خلک اللہ سی پَن ما کھمئیدی، یقیناً کا کم یأ ہیئے کیدیدا چیر لاݜ تھی۔
ہے اے مومن سی معاملہ می کی رشتہ داری سی یا لیگیل سی خیال نو کودی، آں اَںئی ہے خلک تھی کامیک یأ حد ما نُخیل تھی۔
بھی کو ہیئے تووا کی آں نیماز قائم کی، آں ذکواۃ دید، دَ ہے تُھن دینی بھئی تھی، آں مھو تنو آیادا سی تفصیل تھأ خلگا سی کأ بیان کودی کآم یأ جنو نیمادیو۔
آں کو سے تنو وعدہ ما بعد تنو قسم پھرؤسأدو، آں تُھن دین گے لاݜ بنوسأدو، دَ مھال کفر سی گھن آ سیت لات کوا، کئیکہ ہے مھال خلک تھی یأ ہین قسم آ سی کی حقیقت نی چھی۔ اُمید تُھو یرأ سے قلار ہوئن۔
کئی تھوئے تھأ خلگا سیت لات نو کونین کی یأ تنو قسم پھیرأد، آں رسولؐ سی نگھلو سی ارادہ کی، آں تھوزید زأتیئی می ہے موش ہوئی؟ کئی تھو ہیئے ما بھیدی؟ اللہ مے بأت سی زیاد حق لردو یأ تھو تیما بھیا، کو تھو مومن تھیو۔
تھأزید لات کوا، لخہ اللہ تُھن ہادیدے تھأئے سزا دو آں تھأ ذلیل کوے، آں تھین خلاف تُھن مدد کوے، آں مومن آ سی حی شیدیلی کوے،
آں سے (اللہ) ہین حی آ سی قار دھگو کوے، آں کسی نیمؤسادو توبہ قبول کوے، آں اللہ جنو والا آں حکمت والا تُھو۔
کئی تھوئے مے خیال کیدو لخہ تھوئے مھاموڑ چھوا بژنین، حالانکہ مھیرے دا اللہ میس اخکارہ نی کیدو یرأ تھوئے ما کآم خلک جہاد کودی، آں اللہ، تِسی رسولؐ آں مومنے ما علاوہ دوئی یام تنو حی سی رازدا نہ سوادی؟ آں تھو کا کودی دا اللہ تِسما شید تُھو۔
مشرک مے بأت سی لائق نی تھی لخا سے اللہ سی شیر آباد کوئن، حالانکہ سے أمیدے تنو کفر سی گواہ سوا گئیدی، ہأ خلگا سی دا عمل ضائع ہوئیدی، دیزوخ سی آنگا می ہیئے موا دھرنین۔
اللہ سی شیر تا اَںئی سے آباد کودو،کی یأ اللہ آں قیامت سی دی زید ایمان اَنو، آں نیماز قائم کی، آں ذکوٰۃ اداکی، آں اللہ ما علاوہ یس ما نی بھیو، اَںئی ہأ خلگے ما اُمید تُھو یأ ہے ہدایت پئن۔
کئی تھوئے حأجی آئے اُو پیؤ آں مسجد حرام سی آباد کوؤٔ تے ماݜ سی (اعمال آ سی) برابر گھنودو کی یأ اللہ زید آں قیامت سی دی زید ایمان اَنو، آں کی یأ اللہ سی پَن دے جہاد کی؟ اللہ سی نیز می ہے ٹول برابر نہ ہو بھادی، آں اللہ ظألم خلگائے ہدایت نے دیدو۔
کامے خلگے ایمان اَنودو آں اللہ سی پَن دے ہجرت کیژی آں تنو مال و جان دے جہاد کیدُو، تھین درجہ اللہ سی نیز می چیر زیاد تُھو، آں اَںئی ہے خلک تھی یأ کامیاب ہوؤ والا تھی۔
ہین پروردگار ہأئے تنو دِشا رحمت سی آں خوشحألی سی آں مھال باغا سی زیرے دیدو کِس می مُوآ سی نعمت تھی،
تھید تھیئے مُوآ دھرنین، یقیناً سے اللہ تُھو یأ تیس کیش گھن اَجر موجود تُھو۔
اے ایمان والا ہانا! کو تُھن بوپ آں بَھئیے ہُم ایمان سی مقابلہ می کفر خوشادو تھأ تنو گھن نہ سَوا، کامے خلگے ہأ تنو گھن سیوأدو تھیئے ظألم ہونین۔
(اے پیغمبرؐٔ! مسلمانائے) بَن کہ: تُھن باپ، تُھن جدک، تُھن بھئی، تُھن ڇھی، آں تُھن خاندان، آں تے مال یأ تھوئے گھیڑیژیدا، آں تے تجارت یأ تِسی نقصان سی تھوئے خطرہ چھی، آں تُھن دھرو سی پوت یأ تھوئے چیر خوش تُھو، اللہ آں تِسی رسولؐ آں تِسی پَن دے جہاد کوؤٔ ما زیاد خوش تُھوو، دَ انتظار کوا، مھیدیگا پورے یأ اللہ تنو فیصلہ کوے، آں اللہ نافرمان خلگائے ہدایت نہ دیدو۔
بیشکہ اللہ چیر پود آ می تُھن مدد کیژی، (خاص کر) حنین سی دی کے یأ تُھن زیادوالے تھو غرہ کیشی، دَ تی زیادوالے تھوئے کی شیئی سی فائدہ نہ دید، آں دھیرین تھوزید تنو فراخی سمانے تینگی ہی، بھی تھو پیٹھ گأدے واپس نُڑئی۔
بھی اللہ تنو پیغمبرؐ زید آں ایماندار آزید سکون نازل کی، آں مھال لشکر والیئ کہ تھوئے تھأ نی ڈیڈ، آں کأفرائے عذاب دید، آں اَںئی أ کأفر آ سی بدل تُھو۔
بھی اللہ اِسما بعد کیسکے نیمادو توبہ نصیب کودو، آں اللہ گھن بوگوشُو والا مہربان تُھو۔
اے ایمان والا ہانا! بیشکہ مشرک خلک تا اے ناپاکی چھی، دَ تھلا ہے ایݜوک کال آ بعد مسجد حرام گے نھیئی ہُم نہ ہوئن، آں (مسلمانا ہانا!) کو تھوئے غریبی سی بھیت چھیو، دَ اللہ تھو تنو فضل دے مالدأری کونین، کو تی نیمادو، بیشکہ اللہ جنو والا حکمت والا تُھو۔
تھأ خلگا سید لات کوا کآم یأ اللہ زید ایمان نہ اَندی، نأئی آخرت سی دی زید، آں نائی تھأ شیئی حرام گھنَدی کا یأ اللہ و تِسی رسولؐ حرام کیدی، آں نائی حق دین تنو دین گھندی، تھیئے ما کیس کے یأ کتاب دیا گوشُو، تھیدیخانگے یأ سے عاجز ہیدے تنو ہات تے جزیہ دَن۔
آں یہودی بندی عزیرؑ اللہ سی پو تُھو، آں عیسائی بندی مسیحؑ اللہ سی پو تُھو، أ ہین تنو أں سی سویل بأت تھی، ہے تھأ خلگا سی شانے بأت کودی کامے ہأما مُوش کفر کیشو، اللہ ہأ مُردا کوئے! کھأکأ (حق ما) گئا بژدی۔
ہیئے تنو مَلان و پیرے ما خُدئ سیوأدتی اللہ ما علاوہ، آں مریمؑ سی پو (عیسٰیؑ ہُم)، حالانکہ ہأئے صرف مے بأت سی حکم دیا گاشو کہ ہے اے خدئ سی عبادت کوئن، نو تُھو یام عبادت سی لائق اللہ ما علاوہ، سے ہین شرک سی بأدے ما پاک تُھو۔
ہے اللہ سی لوش تنو أں سی پُھوگے دے نِشؤ نیمادی، آں اللہ یے تنو لوش سی پورا کوؤٔ ما علاوہ ہر بات نامنظور چھی، اَسے کأفر نہ خوشادی۔
اللہ اَںئی سے ذات تُھو یأ تی تنو رسول گے ہدایت آں سأز دین دیدے پیؤ، تاکہ سے اے دین دأل بوٹ دین آ زید اُوچات کوئے، اَسے مشرک خلک نہ خوشادی۔
اے ایماندار ہانا! بیشکہ چیر (یہودی) ربی آں (عیسائی) راہب مھال تھی یأ سے خلگا سی مال ناحق طریقہ دے کھادی، آں خلک اللہ سی پَن ما کھمدی، آں کآم خلک یأ لگھور زر و اُوژل زر سیریڑتے تھادی، آں تیس اللہ سی پَن می خرچ نہ کودی، دَ ہائے دردناک عذاب سی "زیرے" دے۔
کامے دی یأ (دولت) دیزوخ سی آنگا می توا بژنین، بھی تیدے ہین تال و ڈھأر آں ڈاگ داغا بژنین، (ہائے بنا بژنین) أ تُھن سے پیس چھی کیس یأ تھوئے تنو امن گے سیریڑتے تھیئی شی، مھیرے تے خزان سی مزا چکھا، کامیک یأ تھو سیریڑتے تھؤدود۔
بیشکہ ما آ سی لیک اللہ سی نیز می دواش چھی، اللہ سی کتاب می تے دی ما شروع تھی یأ تی آسمان و دھیرین پیدا کیدی، تھأمی چؤ عزت مند (ما) تھی، اَںئی أ روغ دین چھی، تھلا تھو ہأ ما آ می اَمن زید ظلم زأتیئی نہ کوا (لات کیدے)، آں تھو بُٹ مشرکا سیت مھاموڑ لات کوا کھاکأ سے تھو بوڑا سید لات کودی، آں تھو جنا کہ بیشکہ اللہ پرہیزگار آ سی سأت تُھو۔
بیشکہ ماء آ سی مُٹھائے پتکے کوؤٔ کفر می زیادوالے چھی، ایدے کأفر خلک گمراہ کوا بژدی، ہے اے کال ایس حلال کودی آں اے کال ایس حرام کودی، مِسی کأ یرأ ہے تھأ ماء آ سی لیک پورا کوئن کامیک یأ اللہ حرام کیدی، دَ بھی ہے اَمن گے حلال کوئن کا بات یأ اللہ حرام کیژی دا، ہین لاݜ کم ہائے شیژو کوا گئیدی، آں اللہ کأفر خلگائے غورا پان نہ پشادُو۔
اے ایمان والا ہانا! تھوئے کژل ہیژی یرأ کا ساعدا تھوئے بنا گاو کہ اللہ سی پَن می نُوخا دَ تھو دھیرین سی دِشکے زور کودی؟ کئی تھو آخرت سی مقابلہ می دونیئی سی جیدون زید خوشحال ہُوئیدی؟ (یاد ساتا!) دونیئی سی جیدون سی سامان آخرت سی مقابلہ می کی نو تُھو مگر اَشوڑ۔
کو تھو (جہاد سی کأ) نی نیگھأدو، دَ تی (اللہ) تھوئے چیر سخ (دردناک) سزا دینین، آں تُھن پوت دُوئی قوم اَننین، آں تھوئے تھأئے کی نقصان نہ اَوابھانین، آں اللہ ہر شیئی زید وَس لردُو۔
آں کو تھوئے اِسی (پیغمبرؐ سی) مدد نی کی (اِسی کی نقصان نہ ہودو) بیشکہ اللہ اِسی مدد تے وخا می کیشی کا ساعدا یأ ایس کأفرے (مکہ ما) نیگھالوشو، مے حال می کہ ہے دو جَن آ می دھویم اَشو، کا ساعدا یأ ہے دُوئیمو اے خاص بھیل می اَشیئ، کے یأ ہے تنو سأت کے بنودود "غم نہ کو بیشکہ اللہ مھو سید تُھو"، بھی اللہ ایزید تنو سکون نازل کی، آں مھال لخکرے دے اِسی مدد کی کہ تھوئے تھأ نی ڈیڈ، آں تی کأفر آ سی بات وا کی، آں بات تا صرف اللہ سی بھا ہوژی، آں اللہ زوروڑ حکمت والا تُھو۔
(جہاد سی کأ) نوخا، تھو اُوپُھٹ تھی آں کو اُوگو، آں تھو تنو مال آں جان دے اللہ سی پَن می جہاد کوا، أ تُھن کأ چیر غورا تُھو کو تھو جنَدیو۔
(منأفق آ سی کأ) کو آسانی دے میلاؤ ہوؤ والا مال ہیشی، یا آسان شانا سفر ہوشوو دَ خامخا ہیئے تھیسیت سأت ہونیندے، اَسے (تبوک سی) ݲِگ سفر ہین کأ چیر سخ اَشُو، آں مھیرے (تنو نہ ییؤ سی کأ) ہیئے خُدئ سی قسم کھانین کہ: "مُھن وَس أشیو مھوئے خامخا تھوسید نُوخنیندے" ہے اَمن برباد کودی، آں اللہ یے پتہ چھی کہ بیشکہ ہے لووال تھی۔
(اے پیغمبرؐ!) اللہ تھأ معاف کیدو، (اَسے) تأ ہأئے کئی اِجازت دید تے وخا پورے یأ تھیئے سأزبن خلک اخکارہ ہوندے، آں لووال خلک پیانأ بژندے۔
کآم خلک یأ اللہ و آخرت سی دی زید ایمان اَندی ہے تھیکیژا تنو مال آں تنو جان دے جہاد سی نہ کوؤٔ سی توَس نہ کودی، آں اللہ پرہیزگار خلگے ما جنیل تُھو۔
بیشکہ تھیکیژا سے خلک توَس کودی یأ اللہ و آخرت سی دی زید ایمان نہ اَندی، آں تھین حی شک کودی، تھلا سے لا تنو شک می پیݜائیدی اَٹالا تھی۔
آں کو ہین نُخو سی نیت أشیو دَ ہیئے خامخا کآں نہ کآں تیاری کونیندے، اَسے اللہ ہین اُوشو (جہاد سی کأ) نہ خوشاد، دَ ہأ پأشکے دھرأد آں بنا گا کہ تھو (عذر سی وجہ دے) بَھئیل آ سید بَھیا۔
کو ہے تھوسید نیگھأدیدیشی ہُم ہیئے تھیئے کی چیری نہ کونیندے اُورانئی ما علاوہ، آں تھو می لانجا پیدا کوؤٔ سی کأ تُھن صف آسی اَندرے دھأںئی دینیندے، آں تھومی یام تھین بأدا یے چیرے کان تھادی، آں اللہ یے ظألم آ سی پتہ چھی۔
مِسما موش ہُم مھیئے خلگے لانجا آ سی بیرڑو سی کوشش کیشی، آں تھیئے نقصان اَوؤ سی کأ چیر کم اَونأ سُونأ کیدی، تھدیخانگے یأ حق اَوؤ آں اللہ سی دین اخکارہ ہُو، آں ہے نہ خوشودُود۔
آں ہأمی ایک سے تُھو یأ بندو: "مھیئے اجازت دے (دھرو سی) آں مھأ فتنہ ما سات"، غور تے بُھویا فتنہ می ہے بئیل تھی، آں بیشکہ دیزوخ ہأ کأفر چاپ چاپیرہ گݜو والا چھی۔
آں کو تھوئے کآں غورہ ہُوو سے ہأزید لاݜ گھڑدو، آں کو تھوئے کی مصیبت اَوئیو ہے بندی: "مھوئے دا تنو کام موش ما کیشو"، آں ہے خوشحال ہیدے نڑدی۔
(اے پیغمبرؐ!) تُو بَن کہ: مھوئے کی تکلیف یئت ہُم نہ اَوودو، مگر کا یأ اللہ مُھن کأ لیگودو، سے مُھن کأم سَوا تُھو، آں صرف اللہ زید پکار تُھو پوخ ایمان والا بھروسہ کوئن۔
بَن کہ: تھو مُھن کأ صرف دو غورہ بأدے ما ایک سی انتظار کودی (شہادت یا مئیک)، آں مھو تُھن مے بأت سی انتظار کودی کہ اللہ تھوئے تنو دیشا سزا دو یا مُھن ہادا، تھلا تھو انتظار کوا مھو ہُم تھوسید انتظار کوؤٔ والا تھی۔
بَن کہ: تھو تنو مال خوشحالی دے چندہ می خرچ کوا یا خپگان دے، یئت ہُم تھوما قبول کوا نہ بژنین، بیشکہ تھو گناہ گاہ خلک تھی۔
آں ہأ مے بأت ما نہ کھمئیدی کہ ہین خیر خیرات قبول کوا بژے مگر می بأدے کہ یقیناً ہیئے اللہ و تِسی رسول زید کفر کیدو، آں نماز کے ییدی مگر سستی کوئن، آں نائی تنو مال خرچ کودی اَسے خفا ہیدے۔
دَ ہین مال آں اولاد تھأ تعجب وا نہ تھلے، بیشکہ اللہ نیمادو کہ ہأئے ہیئے دے دونیئی سی جیدُون می سزا دو، آں ہین ساء نخوئے مے حال می کہ ہے کأفر ہوئن۔
آں ہے خُدئی سی قسم کھادی کہ بیشکہ ہے خامخا تھوما تھی، آں ہے تھوما نی تھی، اَسے ہے بھیاڑ خلک تھی۔
کو ہیئے کی بیریؤ سی پوت یا بھیل یا دھیرین می ڈونگ پادوشوو، دَ ہیئے دھأںئی دیل تھیت کے بژنیندے۔
آں ہأ (منأفقا) می یام سے تھی تھیزید صدقہ (سی بھوگوؤ) می الزام ݜیادی، بھی کو ہأئے دیا گاو ہے خوشحال ہودی، آں کو ہأئے دیا نہ گاو تھلا ہے خپا ہودی۔
کا غورہ اَٰشو کو ہے خوشحال ہوئیشیو، تھأ شیئی آ زید کا یأ اللہ و تِسی رسولؐ ہأئے دیدوشُو، آں میس بنندے: "مھن کأ اللہ پورا تُھو، چیر جلد اللہ آں تِسی رسولؐ مھوئے تنو فضل ما دینین، بیشکہ مُھن حی سی شوق اللہ سی دِشکے تُھو"۔
بیشکہ صدقہ حق تُھو، محتاج آ سی، آں غریب آ سی، آں کآم یأ ہین سڑرو زید مقرر تھی، آں تھأ خلگا سی کآم آ سی حی گھنا بژدی، آں چنجو آ سی (گلام) لھاسو می، آں قرضدارے آ سی مدد می، آں اللہ سی پَن می، آں مسأفر آ سی مدد می خرچ کوا بژے، أ اللہ سی دیشا اے فرض تُھو، آں اللہ پوھہ حکمت والا تُھو۔
آں ہأ (منأفق آ می) یام پیغمبرؐ کے تکلیف آوادی، آں بندی "ہے کان تُھو" (ہر کیںسی بأت بُھوژدو) ہأئے بَن: ہے تُھن کأ ہرے غورہ بأت سی کان تُھو، ہے اللہ زید ایمان اَندو، آں ایماندار آ (سی بأد) زید یقین کودو، آں تھومی ایمان والا آ سی کأ رحمت چھی، آں کآم خلک یأ اللہ سی رسول گے تکلیف دیدی، ہین کأ دردناک عذاب تُھو۔
ہے تُھن موش خُدئی سی قسم کھادی کہ تھو جاشے، آں اللہ آں تِسی رسولؐ مے بأت سی چیرے حقدار تھی کہ ہے تھأ جاشے، کو ہے سأز کے ایمان والا تھیو۔
کئی ہأئے پتہ نی چھی، بیشکہ کی یأ اللہ و تِسی رسولؐ زید دشمنی کیو دَ یقیناً تِسی کأ دیزوخ سی آنگا تُھو، اَںئی تِسمی مدام ہونین، أ چیر گھین شرم چھی۔
ہے منأفق خلک مے بأت ما بھیدی کہ ہأزید (مسلمان آ زید) یئت مھال سورت نازل کوا نہ بژے سے ہأئے ہین (منأفق آ سی) حی آ سی بأد آ سی خبر دو، تھو بنا کہ تھو پشاڑے کوا، بیشکہ اللہ تھأ بأد آ سی اخکارہ کوؤٔ والا تُھو کِسما یأ تھو بھیدی۔
آں کو تأ ہأئے ما توَس کی دَ خامخا ہیئے بننین: "بیشکہ مھو دا گپ شپ دیؤدود، آں نڑودود" ہأئے بَن: کئی تھو اللہ زید، آں تِسی آیت و تِسی رسولؐ زید پشاڑے کودی؟
بھان نہ کوا! بیشکہ تھوئے تنو ایمان ما پأش کفر کیدو، کو مھوئے تُھن اے ٹل بوگوشوو ہُم خامخا دوئی ٹل گے سزا دینین، کئی کہ سے جرم دار تھی۔
منأفق ماݜ آں منأفق جوَئی بوڑ ایکدی آ سی شانے تھی، ہے لاݜ سی حکم کودی، آں غورہ بأدے ما کھمدی، آں تنو ہات چیودی (مال سی خرچ کوؤٔ می) ہیئے اللہ اَموݜا تھلودو، دَ اللہ ہأ اَموݜا تھلئ، بیشکہ اَںئی ہے منأفق نافرمانا تھی۔
اللہ منأفق ماݜ آں منأفق جوئی، آں بوڑ کأفر آ سیت دیزوخ سی آنگا سی لوز کیدو، ہیئے مُدام سی کأ تِسمی ہونین، ہے (دیزوخ) ہین کأ پورا چھی، آں اللہ ہأ لعنت کیدی (رحمت ما دھی کیدی)، آں ہین کأ مدام سی عذاب ہونین۔
(تھو منأفق) تھأ خلگا سی شانے تھی، یأ تھوما موش لھنگئیدی، سے زور می تھوما چیر تکڑا أشئی، آں مال و اولاد می تھوکیژا چیر زیاد اَشئی، تھیئے تنو وأر سی خوند گھین، بھی تھوئے ہُم تنو وأر سی خوند گھین، کھأکأ یأ تھوما موشک خلگے تنو وأر سی خون گھینوشو، آں تھو ہُم تھأل بیکارہ بأد آ می مشغول ہوئی کھأکأ یأ سے مشغول ہُوئیشی، ہأ خلگا سی عمل دُونیئی می آں آخرت می برباد ہُویدی، آں اںَئی ہے خلک تاوانی تھی۔
کئی ہأئے (منأفقائے) تھأ خلگا سی خبر نہ أپ چی، کآم یأ ہأما موش اَشیئی؟ نوحؑ سی قوم، آں عادی و ثمودی، آں ابراہیمؑ سی قوم، آں مدین سی خلک، آں اَونأ کویل گام، ہأئے ہین پیغمبرے اخکارہ بأت گھیندے اَئیشی، بھی أ اللہ سی کام نہ اَشو کہ ہأزید ظلم کویدے، اَسے ہے اَمیدی اَمن زید ظلم کؤدود۔
ایمان والا ماݜ آں ایمان والا جوئی، ہے ایکدی آ سی مددگار تھی، ہے غورہ سی حکم کودی آں لاݜ ما کھمدی، آں اللہ و تِسی رسولؐ سی تابعداری کودی، ہأ خلگا زید چیر جلد اللہ تنو رحم کونین، بیشکہ اللہ زوروڑ حکمت والا تُھو۔
اللہ ایمان والا ماݜ آں ایمان والا جوئی آ زید تھأ باغ آ سی لوز کیدو، کآم آ سی ٹیندے کانے بژنین، ہیئے تِسمی مُدأمی دھرنین، آں صفا شیر آ سی مُدام دھرو سی باغ آ می، آں اللہ سی خوشحالی بوڑے ما گھین چھی، آں أ چیر گھین کامیابی چھی۔
اے پیغمبرؐ! کأفر آں منأفق خلگا سید جہاد کو، آں ہأسید سختی کو، ہین دھرو سی پوت دیزوخ چھی، آں سے چیر لاݜ پوت تُھو۔
ہے خُدئ سی قسم کھادی کہ ہیئے بات نے بینیژی، حالانکہ ہیئے کفر سی بات بینیژی، آں تنو مسلمأنی ما پأش ہیئے کفر کیدو، آں ہیئے پوخ نیت کیشی تے شیئی سی یأ ہیئے نہ کوبھوؤ، آں ہے لاݜ نہ گھندی مگر مے بات کہ اللہ و تِسی رسولؐ ہأ تنو فصل دے مالدا کیدی، تھلا کو ہیئے توبہ کیو اَںئی ہین کأ چیرے غورا ہونین، آں کو ہیئے مو نڑادو تھلا اللہ ہأئے دونیئی می آں آخرت می دردناک عذاب دینین، آں نہ ہونین ہین کأ نأ سأت آں نأئی کی مدد کوؤٔ والا۔
آں ہأمی یامے اللہ سید لوز کیشو یرأ کو تی تنو فضل ما مھوئے دیدو مھوئے خامخا صدقہ کونین، آں خامخا مھوئے نیک خلگا می شامل ہونین۔
بھی کے یأ تی ہأئے تنو فضل ما دیدتا ہیئے تیمی شُمتوب کی، آں بوت نڑا دے گئی (اَمن ناگارہ کی)۔
دَ (اللہ) ہین حی آ می منافقت تے دی آ پورے تھیلی، کا دی یأ ہیئے (اللہ) سید میلاؤ ہونین، مے وجہ دے کہ ہیئے اللہ سید کا یأ لوز کیشو تِسی خلاف ورزی کی، آں مے وجہ دے کہ ہے لوو سَوؤدود۔
کئی ہے نہ جنودود کہ بیشکہ اللہ ہین حی آ سی رازے ما آں ہین بیریت جرگہ آ ما شِد ہودو؟ آں میزما کہ بیشکہ اللہ بیریت بأت آ سی چیر گھن جنو والا تُھو۔
(أ سے منأفق تھی) کآم یأ تھأ ایماندار آ زید الزام ݜژادی کآم یأ تنو حی سی خوشحألی دے صدقہ کودی، آں تھأ خلگا زید ہُم کآم یأ تنو میزدی ما علاوہ کی نہ پادی، دَ ہے تھأ زید پشاڑے کودی، آں اللہ ہأزید پشاڑے کودو، آں ہین کأ اے دردناک عذاب تُھو۔
تُو ہین کأ (اللہ ما) معافی نیما یا ہین کأ معافی نہ نیما، کو تُو ہین کأ دَش پیرا و ڇبیشے ہُم معافی نیماو بھی ہُم اللہ ہأ یئت نہ بگوشدو، أ مِسی کأ کہ ہیئے اللہ و تِسی رسولؐ زید کفر کیدو، آں اللہ گناہگاہ خلک ہدایت کے نہ اَوادُو۔
پدیئے دھریل خلک تنو بھیو زید خوشحال ہُوئی، اللہ سی رسولؐ سی مخالفت سی وجہ دے، آں ہیئے اللہ سی پَن می تنو مالے دے آں تنو نفس تے جہاد سی کوؤٔ نہ خوشاد، آں ہیئے (ایکدیئے) بنو: "مے تأو می نو نُخوا" ہأئے بَن "دیزوخ سی آنگا چیرے تات تُھو" ، اَرمان کو ہے جنئ شیو۔
دَ ہے (دُونیئی می) دھأک ہَزن، آں بھی (آخرت می) چیر ڙینگن، أ تِسی بدل تُھو کا یأ ہے گھڑودود۔
(اے پیغمبرؐ!) بھی کو اللہ تھأ ہأمی اے ٹل سی کأشکے نڑأدے آنوو، آں سے تھوما (جہاد می) نُخو سی اجازت نیمؤسأدو، دَ ہأئے بَن کہ: "تھوئے مھیرے مھیسیت یئت ہُم نو نُخ بھانین، نائی تھوئے یئت مھی سأتویلی می دشمن سید لات کوبھانین، تھوئے مُشیم پیرا بھیو خوشادوشو، دَ مھیرے ہُم تھو دھریل آ سید بَھیا"۔
آں ہأمی کآم مُوو، ہیئے ما ایک سی ہُم یئت زیناز سی نماز نوگوزا، آں نأئی ہین قوَر زید ایڑی ہو، ہیئے اللہ و تِسی رسولؐ سید کفر کیدو، آں ہے گناہگاری سی حالت می مُوئیدی۔
آں ہین مال و اولاد تھو تعجب وا نہ تھلے، بیشکہ اللہ مے بات نیمادو کہ ہأئے دُونیئی می ہیئے دے سزا دو، آں کفر سی حالت می ہین سا نُخے۔
آں کے یأ اے سورت نازل کوا گأو، یأ تِسمی أ حکم ہُوو کہ تھو اللہ زید ایمان اَنا، آں تِسی رسولؐ سی سأتویلی می جہاد کوا، دَ ہأ (منأفق آ) می وَس سی کھمن تھوما (دھرو سی) اجازت نیمادی، آں بندی: "مھو چھوا مھو ہُم دھریل آ سید ہیئی"۔
ہے خلک پدیئے دھریل جوئی آ سید ہوؤ خوشادی، آں ہین حی آ زید مُہر ݜژا گادُو، دَ ہے نہ جندی۔
اَسے رسولؐ آں سے خلک کی یأ تیسیت ایمان آنودو، تنو مال آں تنو نفس تے جہاد کی، اَںئی ہأ خلگا سی کأ بوڑ غوراتوب تُھو، آں اَںئی ہے خلک کامیاب تھی۔
اللہ ہین کأ مھال باغ تیا کیدی یأ تھن ٹیندے کآن ڈل نین، ہیئے تِسمی مُدام ہونین، أ چیر گھین کامیابی چھی۔
آں ڈھأر سی خلگا می یام عذر سی کوؤٔ سی کأ اَئی، کہ تھأئے (جہاد ما دھرُو سی) اجازت دیا بژے، آں (اَںئی ہامُو) سے خلک (ہُم) بھیٹ کی یأ اللہ و تِسی رسولؐ سید لوو سوادُوشو، کآم خلگے یأ ہامی کفر کیدو، شیرتے ہأئے دردناک عذاب اَوونین۔
کمزور خلگا زید (جہاد می نہ بژو می) کی گناہ نو تُھو، آں نأئی ناژور آ زید، آں نائی تھأ لاچار آ زید کہ سے خرچ کوؤٔ سی کأ کی نہ پادی، یأ سے اللہ و تِسی رسول سی کأ اخلاص کوؤٔ والا ہُوئیو، غورہ نیک خلگا زید کی پورے نو تُھو، آں اللہ گھن بوگوشو والا مہربان تُھو۔
آں نأ تھأ خلگا زید (کی گناہ تُھو) کآم یأ تُھن کأشکے اَئیشی کہ تھو تھأئے سورلی برابر کوا، تھوئے بنو: "آ کی سورلی نہ پادو کہ آ تھو تیسکے اُوگھألی"، سے مے حال می نڑیئی کہ تھین أݜی آ می آش ڈلودود، مے غم می کہ سے تنو خرچ کوؤٔ سی کأ کی نہ پادی۔
بیشکہ تھأ خلگا زید پورے تُھو کہ سے تھوما (دھروُ سی) اجازت نیمادی، حالانکہ سے مالدار تھی آں پدیئے دھرو والا جوئی آ سید ہوو خوشادی، آں اللہ ہین حی آ زید مُہر ݜژادتو، دَ ہے نہ جندی۔
ہیئے خلگے (منافقین) تُھن موشکے عذر تھانین، کے یأ تھو ہین کأشکے (تبوک ما) نڑتے اَئیو، ہأئے بَنا کہ "عذر نہ سوا، مھو تُھن بأت زید کی یقین نہ کو دی، بیشکہ اللہ تُھن حال آ ما مھو شیدأدتی، آں مُٹھائے ہُم اللہ آں تِسی رسولؐ تُھن کم بونین، بھی تھوئے نُڑا بژنین تے ذات سی دِشکے، یأ سے بریت و ڈاگا سی جنو والا تُھو، بھی تی تھو تُھن تے کم ما شیدانین کا یأ تھو کوؤٔدود۔
ہیئے تُھن موشکے خدئی سی قسم کھانین، کھالے ساعدا یأ تھو ہین کأشکے نڑتے گئیو، تاکہ تھو ہأ ما اَمن نانگارا کوا، تھلا تھو ہأئے ما اَمن نانگارا کوا، بیشکہ ہے گند چھی، ہین پوت دیزوخ تُھو، کا یأ ہے گٹہ کؤدود تہ تِسی بدل تُھو۔
ہے تھوئے قسم کھادی کہ تھو ہأما خوشحال ہوا، بھی کو تھو ہأما خوشحال (ہُم) ہُوئیو دَ بیشکہ اللہ مھال گناگا خلگے ما خوشحال نہ ہودو۔
ڈھأروش (بانڈچی) خلک کفر آں منافقت می چیر سخ تھی، آں مے بأت سی چیرے لائق تھی کہ نہ جنیل دھرن تھأ احکامے ما کامیک یأ اللہ تنو رسولؐ زید نازل کیدی، آں اللہ علم و حکمت والا ذات تُھو۔
آں یام ڈھأروش (بانڈیچی) سے تھی کہ (اللہ سی نام دے) خرچ کویل مال تاوان گھندی، آں تھو زید مصیبت آ سی پشو سی انتظار کودی، (حقیقت می) لأݜ مصیبت ہأزید أبچی، آں اللہ بُھویو والا پوھہ ذات تُھو ۔
آں یام ڈھأروش (بانڈیچی) سے تھی کآم یأ اللہ و آخرت سی دی زید ایمان اَندی، آں تنو خرچ کویل مال اللہ سی دربار می نھیئی ہوؤ سی آں پیغمبرؐ سی دعا آ سی گھینو سی زریعہ گھندی، دَ (تِسی کأ) اللہ ہأ تنو رحمت می داخل کونین، بیشکہ اللہ معاف کوؤٔ والا مہربان تُھو۔
مہاجرین آں انصار آ می اول اولا ایمان اَنو والا، آں کآم خلگے یأ غورہ طریقہ دے ہین تابعداری کی، اللہ ہأ ما راضی ہُو آں ہے ہُم اللہ ما راضی ہُوئی، آں ہین کأ مھال باغ تیا کیدی کہ تھین ٹین نھید روان ہونین، تھید ہیئے مُدام سی کأ دھرنین، أ چیر گھین کامیابی چھی۔
آں تُھن چاپ چاپیرہ بانڈیچی آ می یام منافق تھی، آں مدینہ والا ہُم منافقت زید جختہ ایڑی ہویل تھی، تھو ہأ نہ پیأندی، صرف مھو ہأ پیأندی، دَ تِسی مھوئے ہأئے دو پیرائے عذاب دینین، بھی ہیئے گھن عذاب سی دِشکے نُڑا بڙنین۔
آں یام خلک سے تھی تھیئے تنو گناہ آ سی اقرار کیدو، تھیئے گاڑباڑ عمل کیدی، کی غورہ کی لاݜ، ہوبھائی کہ اللہ ہین توبہ قبول کوئے، بیشکہ اللہ گھن بوگوشو والا مہربان تُھو۔
اے پیغمبرؐ ہین مالے ما صدقہ وصول کو، کہ تیدے ہین بھار آں اَندر پاک کو، آں ہین کأ خیر سی دعا کو، تُھن دُعا ہین حی آ سی کأ دَما چھی، آں اللہ ہر کی بُھویو والا پوھہ تُھو۔
کئی ہأئے پتہ نی چھی کہ بیشکہ صرف اللہ تُنو بَن آ سی توبہ قبول کودو، اور خیر قبول کودو، آں صرف اللہ توبہ قبول کوؤٔ والا گھن مہربان تُھو؟
ہأئے بَن: تھو تنو عمل کوا یا، مھیرے اللہ تُھن کم پشنین، آں تِسی پیغمبرؐے آں ایماندارے ہُم، آں تھوئے چیر جلد نُڑا بڙنین تے ذات سی دِشکے یأ سے بیریت و ڈاگہ آ ما جنو والا تُھو، بھی تی تھو تُھن تھأ کم آ ما شیدانین کامیک یأ تھو کؤدود۔
آں یام خلک دَھرا گئیدی اللہ سی حکم آ پورے، یا ہأئے عذاب دینین، آں یا ہین توبہ قبول کونین، آں اللہ گھن پوھہ حکمت والا تُھو۔
(آں یام خلک) سے تھی تھیئے اے جُمات سوأدچی مسلمان آئے نقصان اَوؤ سی کأ آں کفر سی کأ آں مسلمان آ می جدائی تھلو سی کأ، آں مے بأت سی کیا کہ ہے مورچہ ہوئے تھأ خلگائے سی کأ کآم یأ موش ما اللہ و تِسی رسولؐ سید لات می تھی، آں ہیئے خامخا قسم کھانین کہ مھوئے صرف غورہ سی نیت کیشی، آں اللہ گواہی دیدو کہ بیشکہ اَںئی ہے لووال تھی۔
(اے پیغمبرؐ) تو تے جُمات می (نماز سی کأ) یئیت ایڑی نہ ہو، بیشکہ کامے جمات سی باٹ اول دی ما پرہیزگاری زید تھاگودوو سے مے بأت سی زیاد حقدا چھی کہ تو تِسمی (نماز سی کأ) ایڑی ہو، اِسمی مھال خلک تھی سے تنو کأ پاکی خوشادی، آں اللہ (ہُم) پاکی والا خلک خوشادو۔
کئی تھلا اے ماݜ، تی تنو آبادی سی بنیاد اللہ سی بھیت آں تِسی خوشحألی زید تھؤدوو، ہے چیر غورہ تھو یا سے ماݜ یأ کی تنو آبادی سی بنیاد اے کھاݜ سی ڈیگو والا (اوپرا) دَھر زید تھوؤدو، بھی سے تی سمان دیزوزخ سی آنگائے لار بژے؟ آں اللہ ظألم خلگائے روغ پان نہ پشادو۔
کامے آبادی یأ ہیئے سیوأدیشی دا، تی مدام ہین حی آ می اے شک دھرانین، مگر أ کہ ہین حی ٹوٹا ٹوٹا ہون، آں اللہ جنو والا حکمت والا تُھو۔
بیشکہ اللہ ایماندارے ما ہین تنو امن آں مال مے بأت سی بدل می مُل گھنتی کہ بیشکہ ہین کأ جنت ہونین، ہے اللہ سی پَن دے جنگہ دی، بھی دأل ما دی آں أمیدے ہُم ما بژدی، أ اللہ سی اے سأس وعدہ چھی، تورات می انجیل می آں قرآں می ہُم (اِسی ذکر تُھو)، آں سے کآم تھو یأ اللہ ما ہُم زیاد تنو لوظ پورا کودو؟ تھلا تھو تنو مے سودا زید خوشحال ہوا، کامیک یأ تھوئے (اللہ سید) کیدو، آں أ چیر گھین کامیابی چھی۔
(أ کامیاب سوداگر کآم تھی؟) توبہ سی کوؤ والا، اللہ سی عبادت کوؤ والا، تِسی صفت بیان کوؤ والا، ڙوز تھوؤ والا، رکوع کوؤ والا، سجدہ کوؤ والا، غورہ بأد آ سی حکم دیؤ والا، آں لاݜ ما کھمو والا، آں اللہ سی تھئیل سیم آ سی ساتو والا تھی، آں (اے پیغمبرؐ!) تھو ہأ ایماندار آئے زیرے دا۔
پیغمبرؐ آں ایماندار آئے أ بات پکار نی چھی کہ سے مشرکین آسی کأ اللہ ما معافی نیمن، اگرکہ سے تنو اخپلوان تِھیو، مے بأت ما پأش کہ ہائے أ بات اخکارہ ہی کہ ہے بیشکہ دیزوخی تھی۔
آں ابراہیمؑ سی تنو بوب سی کأ معافی نیموؤ صرف تے لوظ سی وجہ دی اَشو کامیک یأ تی تیسید کیشو، بھی کے یأ تیسکے أ بات اخکارہ ہی کہ بیشکہ ہے اللہ سی دشمن تُھوو سے تِسما دستبردار ہُو، بیشکہ ابراہیمؑ چیر نرم حی والا، برداشت والا اَشو۔
آں اللہ مھاموڑ نو تُھو کہ اے قوم گے ہدایت دیدے بھی تھأ گمراہ کوے، کھدیخانگے ہائے تھأ بأت نے پیشأتیو کیما یأ ہیئے اَمن ساتنین، بیشکہ اللہ یے ہر شیئی سی پتہ چھی۔
بیشکہ اللہ سی قبضہ می آسمان آ سی و دھیرین آ سی بأچیئی چھی، سے جیدون دیدو آں مئیک ہُم، آں تُھن کأ اللہ ما علاوہ یام دوست و مددگار نوتُھو۔
بیشکہ اللہ رحمت سی نظر کی پیغمبرؐ زید آں مہاجرین و انصار آ زید، کھیئے یأ بوکُھو ساعد می تِسی تابعداری کی، مِسما پأش کہ ہأمی اے فریق سی حی کیلی ہوؤے نھیئی ہُوئیشی، بھی اللہ تھأزید رحم سی نظر کی، بیشکہ سے ہین کأ گھن مہربان رحم کوؤ والا تُھو۔
آں تھأ ڇا آزید ہُم (اللہ رحمت سی نظر کی) کھین فیصلہ یأ دھرا گیشی، تھیدا پورے کہ دھیرین ہأزید تینگی ہی تنو فراخی سی باوجود، آں ہأزید تنو اَمن ہُم تینگی ہُو، آں سے ہُم جَنئ کہ اللہ سی پناہ ما بغیر تِسی (عذاب ما) لھسو سی کی پوت نوتُھو، بھی اللہ تھأزید رحم کی، تاکہ بھی سے توبہ کوئن، بیشکہ اللہ چیر توبہ قبول کوؤ والا مہربان تُھو۔
اے ایمان والا ہانا! اللہ ما بھیا، آں سأزبَن آ سید سأتویلی کوا۔
مدینہ والائے آں ہین ڈھأر سی بانڈیچی آئے(جائز) نہ اَشو کہ اللہ سی رسولؐ ما (سأتویلی می) پأشکے دھرندے، آں نأئی تنو اَمن تِسما غورا گھیندے تیما بے غمہ ہوندے، أ مے وجہ دے کہ اللہ سی پَن دے کے ہأ (مجاہدین آئے) تیݜ آں ٹھمو آں بیݜ اللہ تعالی سی پن می، آں نائی ھے تے پان چمگدی کہ تیدی کافر قھاراری، آں نائی ھے دشمن ما کی کامیابی پا دی، مگر تسی بدل کی ھأئی اے غورہ عمل لیگا بجدو، بیشکہ اللہ تعالی غورہ خلگا سی اجر بے کارہ نکودو۔
آں (مھاموڑ) کا یأ ہے لؤ و گھن خرچہ کودی، آں ہے اے کُو ما (دُوئی دِشکے) لھنگدی، اَسے ہے بُٹ ہین (عمل نامہ می) لِگا بژدو، مِسی کأ کہ اللہ ہین عمل آ سی چیر غورہ بدل دو۔
آں مناسب نوتُھو کہ ایماندا بوڑ (خُدئی سی پَندے) اے پوت نُخندے، دَ کئی ہر تابین ما اے ڈلا نی نیگھأد کہ سے دین سی پوھہ ڇھیڙیدے، آں کے یأ واپس اَئیشیو تنو خلک بھیئندے، ہوبھائی ہے (گناہ آ ما) اَمن ساتندے؟
اے ایمان والا ہانا! تنو نھیو کأفر آ سید لات کوا، آں سے بنے تُھن اندرے سختی پَشن، آں اَمن جَنا کہ بیشکہ اللہ پرہیزگار آسید تُھو۔
آں کے یأ اے سورت نازل کوا گأو دَ ہأمی یام (منأفق مسلمان آئے) بندی "مے سورت تے تھو می کسی ایمان چیری ہُو؟" (اِسی جواب أ تُھو) دَ کی یأ ایمان اَنودو واقعی می سورت یے تھین ایمان چیری کیدو، آں سے (ایزید) خوشحال تھی۔
آں کآم خلگا سی حی می ناژورتیا تُھو، دَ می سُورتے ہین گند زیت دُوئی گند چیری کی، آں ہیئے کفر سی حالت می مونین۔
آں ہے نہ پشدی کہ بیشکہ ہے ہر کال اے پیرا یا دو پیرائے آزما بژدی؟ بھی نأ ہے توبہ کودی آں نأئی نصیحت گھیندی۔
آں کا ساعدا اے سورت نازل کوا گأو، ہأمی یام ایکدیائے څاردی، (بھی اشارہ آمی بندی) "تھو یام پشدو دا نأ؟"، بھی نِڑتے تھیدا بژدی، اللہ ہین حی (حق ما) نڑأدتی، کئی کہ بیشکہ ہے نہ جنأل خلک تھی۔
(اے خلگا ہانا!) بیشکہ تُھن کأشکے اے رسولؐ اَپتُو سے تھوما تُھو، تیزید تُھن ہر تکلیف بوکھو ہودو، سے تُھن کامیابی سی کأ چیر زیاد خواہش مند تُھو، ایماندار آ سی کأ حی سی نرم آں مہربان تُھو۔
بھی ہُم کو ہیئے مُو نرادو (اے پیغمبرؐ!) تُو بَن کہ: "مھیئے اللہ پورا تُھو، نوتُھو یام معبود اللہ ما سیوا، صرف تیزید مأ بھروسہ کی، سے گھن عرش سی کھمان تُھو"۔
الر، ہے تے کتاب سی آیات تھی کامیک یأ حکمت ما ڈک تُھو۔
کئی ہأ خلگا سی کأ تعجب سی بات چھی کہ مھوئے اَںئی تھیئے ما اے ماݜ زید وحی نازل کیژی یرأ: "خلک (اللہ سی خلاف ورزی ما) بھیا، آں کامے خلگے یأ ایمان اَنودُو تھأئے زیرے دے، یرأ تھین رب سی نیز می تھین گھن مقام تُھو؟ دَ کأفرے بنُو کہ ہے دا صَفا جادوگر تُھو۔
حقیقت أ چھی کہ تُھن پروردگار اللہ تُھو، کی یأ بُٹ آسمان و دھیرین ݜو دِی آ می پیدا کی، بھی تی عرش زید مھامو استواء کی کہ سے ہر شیئی سی انتظام کودُو، یام ہُم تِسی اجازت ما بغیر (تِسی موش) یِسی سفارش کوؤ والا نو تُھو، اَںئی اللہ تُھو تھُن پروردگار! بس تِسی عبادت کوا، کئی تھو بھی ہُم پِھگر نہ کودی؟
اَںئی تِسی ڈھأر کے تھو ٹولأئے واپس بیو تُھو، ہے اللہ سی سأز وعدہ چھی، یقینًا ٹول مخلوق اول می ہُم سے پیدا کودو آں دُوآر ہُم تی پیدا کونین، میلائی کی یأ ایمان انُودو آں نیک عمل کیدی تھأئے انصاف تے تِسی بدل دو، آں کی یأ کفر کیدوو تھین کأ خوڑوگیل اُو پُو سی کأ تُھو، آں دڑ دیؤ والا عذاب تُھو، کئیکہ سے حق سی انکار کوؤدود۔
آں اللہ سے تُھو کی یأ سی ما لوش سَواد، آں یُن نور سَوأد، آں تِسی (سفرسی) کأ منزل مقرر کی، میلائی تھو کال آ سی لیک آں (ما آ سی) حساب معلوم کوا، اللہ مے ہر کی بغیر کی مقصد ما پیدا نی کیدُو، سے مھأ آیات تھأ خلگا سی کأ صفا صفا بیان کودُو کآم یأ پوہا لرَدی۔
حقیقت أ چھی کہ ڙأت و دی سے موݜ پأش ییؤ می، آں کا یأ اللہ آسمان و دھیرین می پیدا کیدُو تیمی، تھأ خلگا سی کأ گھن نَخ تھی کھین حی آ می یأ (اللہ سی) بِھیت چھی۔
آں کآم یأ مھوسیت (آخرت می) میلاؤ ہوؤ سی کی طمع نہ لَردی، آں دُونیئی سی جیدون می مخشول آں اَںئی تزید راضی ہوئیدی، آں کآم یأ مُھن نخے ما غافل تھی۔
تھین دھرو سی پوت تھین عَملا سی سر تے دیزوخ تُھو۔
(دُوئی ڈھأر کے) کامے خلگے یأ ایمان اَنودُو، آں کیئے غورا عمل کیدی، تھین ایمان سی وجہ دے تھین پروردگار تھأ تے پوت کے اَوانین یأ نعمتے ما ڈک باغا می تھین ٹین کآن بثرینن۔
تے (داخل ہوؤ سی سادا) تھین چأڑے می ہونین کہ: "اے اللہ! چھی ذات ہر عیب ما پاک چھی"، آں ایکدوئی سیت خیرسیت بنُو سی کأ کامے ٹِگیل تھیئے بننین دا تی سلام ہونین، آں تھین آخری چاڑ می ہونین، "بُٹ صفت اللہ سی تھی یأ بُٹ جہان آ سی پروردگار تُھو"۔
آں کو اللہ (تھأ کافر) خلگائے شر (یعنی عذاب) سی دیؤ می ہُم ہیدیک جلدی کِشیو کھیدیک یأ سے خیر سی نیموؤ می جلدی کودی، دَ تھین مہلت ختم کوا بژنیندے، بس کآم خلک مھوسیت (آخرت می) میلاؤ ہوؤ سی طمع نہ لَردی، مھو تھأ تھین حال زید چھودی، میلائی سے تُنو نافرمانی می سرگردان گئین۔
آں کے یأ انسان گے کی تکلیف اَوؤو سے بَھئییل و بَئیل و اِڑی ہویل (ہر حالت می) مھوئے چأڑ کودُو، آں بھی کے یأ مھو تِسی تکلیف دھوگو کودی دا مھاموڑ اِشتے بژدُو یأ یئیت اِسکے اَویل کی تکلیف می مھوئے نہ ہاگادوشُو، کآم خلک حد ما لھنگدی تھأئے تھین (لاݜ) کم اَںئی ہاموڑ غورہ معلوم ہودی۔
آں مھوئے تھوما موش (جھان) قوم تے موقع زید ہلاک کی کے یأ تھیئے ظلم کِشو، آں تھین پیغمبرے تھین کأشکے واضحا دلائل گھیندے اَئیشی، آں سے ایمان اَنُو والا نہ اَشیئی، ہال مجرم خلگائے مھو اَںئی ہال بدل دیدی۔
بھی تیما بعد مھوئے دھیرین می تھو جانشین سوأدتی، میلائی مھو پیشی کہ تھو کھال عمل کودی۔
آں سے خلک کآم یأ (آخرت می) مھوسیت میلاؤ ہوؤ سی طمع نہ لردی، کے یأ تھین موش مُھن آیت بنا بژدی، حالانکہ سے بالکل واضحا ہودی، دَ سے میس بندی کہ: "میس نأ، بلکہ دوئی اے قرآن گھیندے یے، یائی اِیمی بدلون آن"، (اے پیغمبرؑ!) تھأئے بَن کہ: مھیئے أ حق نہ اَوودُو کہ آ اِسمی تنو ڈھأرا کی بدلون أنی، آ دا دوئی کی شیئی سی نأ بلکہ صرف تے وحی سے پیروی کودو کامیک یأ مھیزید نازل کوا بژئی، کو یئیت مأ تنو رب سی نافرمأنی کیو، مھیئے اے سخ دی سی عذاب سی بھیت چھی۔
بن کہ: کو اللہ نیمادوشوو مأ مے قرآن تُھن موش نہ بننین دے، آں نأئی اللہ تھو ایما واقف کونیندے، آخر اِیما موش ہُم مأ اے أمو تھوسیت لھنگأدچی، کئی بھی ہُم تھو عقل ما کام نی گھندی؟۔
بھی تے ماݜ ما گھن ظالم دوئی کی ہونین کآم یأ اللہ زید بہتان ݜژادُو، یا تِسی آیت لوو گھنڈدُو؟ یقین سات کہ مجرم خلک کامیابی نہ پادی۔
آں ہے خلک اللہ چھیدے ہأ (لوو آ سی خدا آ) سی عبادت کودی کآم یأ ہائے نأ کی نقصان دے بھادی نأئی کی فائیدہ دے بھادی، آں بندی کہ ہے اللہ سی کأن مُھن سفارشی تھی، (اے پیغمبرؑ! ہیائے) بَن کہ: تھو اللہ ئے تے شیئی سی خبر دیدی کامیک سی یأ کی وجود اللہ سی علم می نو تُھو، نأ آسمانا می نأئی دھیرین می؟ اللہ ہأ شرک سی بأدے ما بالکل پاک آں چیر اُچات تُھو۔
آں (شروع می) بُٹ انسان دوئی کی دین سی نأ بلکہ صرف اے دین سی قائل اَشیئی، بھی بعد می تھیئے ایکدی می اختلاف کیدے جُدا جُدا ہوئی، آں کو چھی پروردگار سی ڈھأرا اے بات موش ما طے نی ہیشیو کامے معاملہ می ہے خلک اختلاف کودی دا اِسی فیصلہ (دُونیئی می) کوا بژنیندے۔
آں أ خلک کئیدا: مے نبی زید اِسی رب سی دشا کی نشأنی کئی نازل کوا نہ گیژی؟ دَ (اے پیغمبرؑ! تو جواب می) بن کہ: غیب سی بأت تہ صرف اللہ سی اختیار می تھی، بس بھی انتظار کوا، آں ہُم تھوسیت انتظار کودی۔
آں انسان آ سی حال أ چھی کہ کے یأ ہائے ییل تکلیف ما بعد مھو ہأئے رحمت سی مزا چکھادی دَ سے فوراً مُھن آیات آ سی بارا مے چالبازی شروع کودی، بن کہ: اللہ ایمائے موش چال چلا بھادُو، یقینًا مُھن فرشتہ تُھن بُٹ چالبازی لیگدی۔
سے اللہ تُھو یأ تھوزید دھیرینے آں سمندر می سفر کوادُو، حتی کہ کے یأ تھو کِشی آئے اُخدی، آں ہے کشتی خلک گھیندے شیژے بیلیئی سیت اُو دے تِلَدی، آں خلک اے بأت زید خوشحال ہودی، دَ اچانک اے تیز طوفانی بیلائی ییژی، آں ہر دِشا تھأزید چپہ بھا ہودی، آں سے میس گمان کودی کہ سے ہر دِشا گیر ہوئیدی، دَ تے سادا سے خلوص تے صرف اللہ زید یقین کیدے صرف تیس کے ہاگادی، (آں بندی کہ یا اللہ!) کو تأ مھو (مے مصیت ما بچ کیو مھوئے خامخا شکرگزار خلگا می شامل ہونین۔
اَسے کے یأ اللہ تھأ بچ کودو دَ فوراً سے دھیرین می ناحق سرکشی کوؤآ شروع ہودی، خلگا ہانا! تُھن أ سرکشی حقیقت می اَںئی تُھن خلاف ہوئی، مھیرے دُونیئی سی جیدون سی مزا گھینا، آخر تھوئے اَںئی مُھن کأشکے واپس ییؤ تُھو، تے سادا مھوئے بَننین کہ تھو کا کوؤدُود۔
دُونیئی سی جیدون سی مثال دَ کآں مھال شانہ تُھو یأ مھوئے آسمان ما اُو مُوژات، تِسی وجہ دے نَین دھیرین ما نُخو والا سے گیا ہُو کامیک یأ انسان و څاروئی کھادی، حتٰی کہ کے یأ دھیرینے سنگھار کیدے شیژیئی ہی، آں تِسی مالکے مے گمان کی کہ بس ہے مھیرے پورا پورا مُھن قابو می چھی، دَ کامے دِیئے یأ ڙأت کے مُھن حکم آپ، آں مھوئے تیس لُونیل صفا کویل دھیرین می مھاموڑ بدل کی یأ بأل سے ہاڑو أشی نأ، اَںئی ہاموڑ مھو نشأنی تھأ خلگا سی کأ صفا صفا بیان کودی کآم یأ پِھگر ما کام گھیندی۔
آں اللہ خلگائے سلامتی سی شیر سی دِشکے دعوت دیدُو، آں کیس نیمادو سیدا پَن گے آوادُو۔
کی یأ غورہ کم کیدی، بہترین حالت تھین کأ چھی، آں تیما ہُم زیاد چیر کآں! آں نأ دا تھین بودے کِݜینی ہونین نأئی ذلت سی اثر تھأزید یینین، سے جنت سی باشندہ تھی، تھیئے تیمی مُدام دھیرین۔
آں کامے خلگے گناہ آ سی سودا کیدُو، تھین لاݜ کما سی بدل تھال (لاݜ) ہونین، تھأزید ذلت خور ہونین، اللہ (سی عذاب) ما تھین بچ کوؤ والا یی نہ ہونین، مھاموڑ معلوم ہونین یا تھین بودا زید أنچگیل ڙأت سی پردہ تھلا گئیدی، سے دیزوخ سی باشندہ تھی، تھیئے تیمی مُدام دھرنین۔
آں (یاد ساتا) تے دی کے یأ مھوئے تھأ بُٹ سرڑنین، بھی کی یأ شرک کیشو، تھأئے بننین کہ: "دھأک تنو پودا زید اِڑی ہوا، تھو ہُم آں کآم یأ تھوئے اللہ سی شریک سوأدی شی!"، بھی تھین مِیئے کامے رشتہ أشی دا تیس مھوئے ختم کونین، آں تھین تھیئے شریگے بننین کہ: "تھو مُھن عبادت تہ نہ کوؤدُود،
مُھن و تُھن مِیئے اللہ شیدی سی کأ پورا تُھو (کہ) مھو تُھن عبادت ما ہاڈو شِید نہ اَشیئی"۔
ہر ماݜ مُٹھا کا ہُم کِیشوو، تے موقع زید تی أمیدے تِسی تحقیق کونین، آں بُٹ اللہ سی دِشکے واپس کوا بژنین، کآم یأ تھین حقیقی مالک تُھو، آں کامے لوو یأ تھیئے سوادیشی تھیئے تھیئے ما غیب ہونین۔
(اے پیغمبرؑ! ہأ مشرکآئے بَن) کہ: کآم تُھو یأ تھوئے آسمان و دھیرین ما رزق آوادُو؟ یا کآم تُھو یأ سے پشو و بُھویو سی طاقت آ سی مالک تھو؟ آں کآم تُھو یأ مئیل ما جَن نگھالدُو آں جَنے ما مئیل نگھالدو؟ آں کآم تُھو یأ ہر کم سی انتظام کودو؟ دَ ہیئے خلگے بننین کہ: اللہ! دَ ہأئے بَن: کئی بھی ہُم تھو اللہ ما نہ بَھیدی؟
بھی دا خلگا ہانا! اَںئی سے اللہ تھو یأ تُھن برحق رَب تُھو۔ بھی حق سی کولاؤ ہوؤ ما بعد گمرہی ما علاوہ دوئی کا دھرو؟ اِسی باوجود کی تھو کھأدے اُلٹا ریوان کیدی؟۔
اَںئی ہاموڑ کامے خلگے نافرمانی سی پان گأدچی، تھین بارا مے اللہ سی آیات سأز ہوئی کہ تھیئے ایمان نہ آننین۔
بن کہ کآم یأ تھو اللہ سیت شریک گھندی تھأمی یام مھال تُھو یأ مخلوق اول گونا پیدا کوے، بھی (تھین مئیک ما بعد) تھأ دھویم گونا ہُم پیدا کوئے؟ بَن کہ سے اللہ تُھو یأ مخلوق اول پیرا پیدا کیدو، بھی (تھین مئیک ما بعد) دووآر بھی پیدا کونین، آخر کآم تھو موتھلأ گھیندے بژدو؟۔
بن کہ: کآم یأ تھو اللہ سیت شریک منَدی، تھأمی یام مھال تھو یأ تھوئے حق سی پان پَشے؟ بن کہ: اللہ حق سی پان پشادُو، مھیرے بن کہ: کآم حق سی پان پشادُوو سے مے بأت سی زیاد حقدا تُھو کہ تِسی بات منا بژے، یا سے (زیاد حقدا تُھو) کیس کے یأ أمیدے پان معلوم نہ ہوژی کھیدیخانگے دوئی یی پان نہ پشأدچیو؟ آخر تھوئے کژل ہیژی؟ تھو کھأل فیصلہ کودی؟
آں (حقیقت أ چھی کہ) ہأ (مشرکے) ما اکثر خلک دوئی کی شیئی سی نأ بلکہ صرف وہم و اندازہ آ سی پأشکے تیلدی، آں أ بات یقینی چھی کہ حق سی معاملہ می وہم و اندازہ کی کام نہ دیدی، یقین کو کہ کا یأ أ خلک کودی اللہ یے اِسی پورا پورا علم تُھو۔
آں أ قرآن مھال نو تُھو کہ ایس اللہ نازل نی کیدو بلکہ کیںئے تُنو دِشا سوادتُو، بلکہ ہے تھأ بأدا سی تصدیق کودُو کآم یأ اِسما موش اَئیدی، آں اللہ کامے بأت (لوحِ محفوظ می) لِکتے چھوئیدی، تھین تفصیل بیان کودو، اِسمی ہاڈو شک سی گنجائش نی چھی، ہے تے ذات سی دِشا تُھو کآم یأ ٹول جہانا سی رب تُھو۔
کئی ہے بھی ہُم بنَدی کہ پیغمبرے میس تنُو دِشا سوادتُو؟ بَن: تھلا تھو ہُم ہال اے سورت (تنُو دِشا سیوأدے) آنا، آں (اِسمی مدد سی کأ) اللہ ما علاوہ کیس یی نیمادیو نیما، کو تھو سأزال تھیو۔
بات اصل می أ چھی کہ کامے بأت کے یأ ہے تُنو علم دے نہ اَوئیو تے بات ہیئے لوو گھینی، آں لا تِسی انجام ہُم ہین مُشکے نہ اَبوشُو، اَںئی ہاموڑ کامے خلک یأ ہیئے ما موش لھنگئیدی تھیئے ہُم (تنو پیغمبر) لوو گھنیئشی، بس تو بُو کہ تھأ ظألم آ سی انجام کھال ہوشُو؟
آں ہأمی یام مھال تھی یأ تھیئے ایزید (قرآن زید) ایمان اَننین، آں یام مھال تھی کہ تھیئے ایزید ایمان نہ اَننین، آں چھی پروردگار کے فسادی غورا کیدے معلوم تھی۔
آں (اے پیغمبر!) تو ہیئے تھأ لووال گھنوو تو بَن کہ: "مھی عمل مھی کأ تُھو آں تُھن عمل تُھن کأ تُھو، کامے کم آ کودُوو تُھن ذمہ واری تھوزید نی چھی، آں کامے کم تھو کودی تِسی ذمہ واری مھیزید نی چھی۔
آں تھأمی یام مھال ہُم تھی یأ چھی بأت (ظاہری) کان تھأدے بھویدی (اَسے حی می حق سی طلب نہ لَردی) دَ تَھلا تو بو آ ئے بُھویادو، کو سے (ہاڈو) جنَدی ہُم نأ او؟
آں تھأمی یام مھال تھی یأ چھی دِشکے څاردی، (اَسے حی می انصاف نہ لردی کھأئیمُو اَن تھی) دَ تَھلا تو اَن آ ئے پان پشادُو، کو سے کی ہُم نہ پشدَی او؟
یقیناً اللہ خلگا زید اے ذرا ہُم ظلم نہ کودُو، اَسے انسان تھی یأ أمیدے تُنو اَمن زید ظلم کودی۔
آں کامے دی اللہ تھأ (حشر سی میدان می) جمع کونین، دَ تھأئے مھاموڑ معلوم ہونین یأ سے (دونیئی می یا قوَر می) دی سی اے ساعت ما چیر نہ دھرئیدی، (کھیائیمو) تھیئے ایکدی پیأننین، حقیقت أ چھی کہ خلگے چیر تاوان سی سودا کیدُو، یأ اللہ سیت (آخرت می) ملاقات سی کوؤ لوو گھنُودو، آں کآم یأ سیدا پن زید نہ اَئیشی۔
آں (اے پیغمبرؑ!) کامے بأدا سی مھوئے تھأئے (کأفرائے) دھمکی دیدچی، کو تھأمی کی بات مھوئے تھیئے (چھی جیدون می) پشأت، یأئی (تیما موش) تھیئے مئیک دید، ہر حال می تھأئے آخر می مُھن دِشکے واپس ییؤ تُھو، بھی (أ دا ظاہر بات چھی کہ) کا ہُم ہے کودی دا، اللہ ہأزید پورا پورا گواہ تُھو۔
آں ہر اُمت سی اے رسول تُھو، بھی کے یأ سے رسول آبو تھین فیصلہ پورا انصاف تے کوا بژژی، آں تھأزید ظلم کوا نہ بژدُو۔
آں ہے (کأفر) بندی کہ: کو تھو سأزبن تھیو (اللہ سی دِشا عذاب سی) می وعدہ کے پورا ہونین؟
(اے پیغمبرؑ!) ہأئے بَن کہ: آ دا تُنو ذات کے ہُم کی نقصان سی دیؤ سی اختیار نہ لردُو، نأئی فائدہ سی دیؤ سی، اَسے کھیدیک یأ اللہ نیمادو، ہر اے اُمت سی اے وَخ مقرر تُھو، بس کے یأ تھین سے وَخ پورا ہُوو تیما نأ اے ساعت پأشکے ہوبھادو نأئی موٹھیدی ہوبھادو۔
بَن کہ: مھیئے بنا دا! کو اللہ سی عذاب تھوزید ڙأت سی ساعدا آپ یأئی دی سی ساعدا دَ اِیمی مھال کا اے شیئی تُھو یأ تیس ییوؤ سی أ مجرم خلک تأدی کودی؟
دَ کے یأ سے عذاب اَبو تھوئے تیس مَن نین؟ (تھلا تھوئے می بأدے بنا بژنین کہ) مھیرے تھوئے منو؟ حالانکہ اَںئی تھوزید اِسی چیر تأدی أشی۔
بھی ظألمائے بنا بژنین کہ: مھیرے مُدامی عذاب سی مزا چکھا، تھوتے دوئی کی شیئی سی ہُم نأ بلکہ صرف تھأ گناہ آ سی بدل دیا بژدُو کامیک یأ تھو کوؤدُود۔
آں ہے خلک تھیکیژا توَس کودی کہ ہے (آخرت سی عذاب) واقعی سأز تھو؟ تو بن کہ: مھی پروردگار سی قسم! ہے بالکل سأز تُھو، آں تھو (اللہ عاجر نہ کوبھادی(۔
آں کی کی یأ ظلم کیدو، کو تیس کیش دھیرین سی ٹول دولت ہُم ہیو، تی تُنو بچ کوؤ سی کأ تیس ٹول دینین، آں کے یأ تھیئے عذاب ڈیڈو، تھیئے تُنو پشیمانتیا بُرؤ نیمانین، آں تھین فیصلہ انصاف تے ہونین، کی ظلم نہ ہونین۔
یاد ساتا کہ آسمانا می آں دھیرین می کائی تُھوو اللہ سی تُھو، یاد ساتا کہ اللہ سی وعدہ سأز چھی خو اکثر خلگائے پتہ نی چھی۔
اَںئی سے جینی کودو آں اَںئی سے مادُو، آں اَںئی تِسی دِش کے تھو ٹول واپس نیا بژنین۔
خلگا ہانا! تُھن کأشکے مھال اے شیئی آپتُو یأ چھی پروردگار سی ڈھأرا اے خونہ تُھو، آں حی آ سی بیمأری آ سی کأ شفا تُھو، آں ایمان والا سی کأ ہدایت آں رحمت چھی۔
(اے پیغمبرؑ!) بَن کہ: أ ہر کی اللہ سی فضل او رحمت تے ہودُو، بس اَںئی اِندے ہأئے خوشألی پکار چھی، ہے تے تمام مال ما چیر غورا تُھو کامیک یأ ہے جمع کیدے تھادی۔
بن کہ: بنا دا اللہ یأ تُھن کأ کامے رزق نازل کیشو، تھوئے تُنو دِشا تھأمی (یام شیئی) حلال و حرام کی! ہیئے ما توَس کو کہ: اللہ تھوئے اِسی اجازت دیدیشی کو تھو اللہ زید لوو آ سی تہمت تھادی؟
آں کامے خلک یأ اللہ زید بہتان تھادی قیامت سی بارا می تھین کا گمان تُھو؟ اِسمی شک نی چھی کہ اللہ انسان آ زید فضل کوؤ والا تُھو، اَسے ہأمی اکثر خلک شُکر نہ کودی۔
آں (اے پیغمبرؑ!) تو کامے حالت می یی ہُوو، آں قرآن سی کامے حصہ سی ہُم تلاوت کودُوو، آں (اے خلگا ہانا!) تھو کامے کام یأ کودی، تھو مُھن نظر می ہودی، کے یأ تھو تے کم می مخشول ہودی، آں چھی پروردگار ما اے ذرا سیم شیئی ہُم بُریل نو تُھو، نأ دھیرین می نأئی آسمان می، نأ تیما لؤ نأئی گھن، اَسے اے واضحا کتاب می لگیل تُھو۔ (مھال کی شیئی نو تھو یأ سے اے واضحا کتاب می لگیل نو تُھو)
یاد سات! کآم یأ اللہ سی دوست (سأت) تھی، نأ دا تھأئے کی بھیت ہونین، نأئی تھیئے غمجن ہونین۔
ہے سے خلک تھی کی یأ ایمان اَنودو آں اللہ ما بھیدی۔
تھین کأ زیرے چھی دُونیئی سی جیدون می ہُم آں آخرت می ہُم، (آں) اللہ سی بأت کی بدل نہ ہودی، اَںئی ہے چیر گھین کامیابی چھی۔
آں (اے پیغمبرؑ!) ہین بأت تھأ خپا نہ کوئن، یقینًا بُٹ اقتدار اللہ سی تُھو، سے ہر بات بُھویو والا ہر شیئی ما شِید تُھو۔
یاد ساتا! کا جَن شیئی یأ آسمانا می تھی، آں کا یأ دھیرین می تھی، سے بُٹ اللہ سی تھی، آں کآم یأ اللہ ما سوا دیألائے ہاگادی، سے کی اللہ سی (حقیقی) شرکأ اسی پیروی نہ کودی سے دوئی کی شئی سی نئا بلکہ صرف گمان سی پیروی کودی ہن کام سوائے تش انداز آ سی ݜیوؤ ما دوئی کی نو تھو۔
(اللہ) سے تُھو کی یأ تُھن کأ ڙات سَوأد، مِسی کأ یرأ تھو تِمی آرام کوا، آں دی تُھن کأ مھال سَواد یرأ تھو پشُو سی قابل ہوا، یقینًا اِس می تھأ خلگا سی کأ نخ تھی کآم یأ غور تے بُھویدی۔
(زینی) خلگ بندی اللہ سی اولأدی چھی، پاک چھی تِسی ذات! سے کی شیئی سی مُتاز نو تُھو، آسمانو دھیرین می کائی تُھوو سے تِسی تُھو، تھوکیش مے بأت سی کی ثبوت تُھو، کئی، تھو اللہ سی ذات زید تے بات تھادی کسی یأ تھوئے کی علم نو تُھو؟
بَن کہ: کآم خلک اللہ سی ذات زید بہتان ݜژادی تھیئے کامیاب نہ ہونین۔
(تھین کأ) دُونیئی می بس اے دھأک شانا مزہ چھی، بھی مُھن دِش کے تھین واپس چھی، بھی کامے کفر یأ سے کوؤدود تہ تِسی بدل می مھوئے تھأئے سخ عذاب سی مزا چکھانین۔
آں اے (پیغمبرؐ!) ہأئے نوحؑ سی قصا بُھویا، کے یأ تی تُنو قوم گے بنُوشو کہ: اے مھی قوم سی خلگا ہانا! کو تھوئے مھی (تھوسیت) دھرو آں اللہ سی آیادا سی ذریعا دے نصیحت سی کوؤ لاݜ معلوم ہودُوو، مأ دا اللہ زید بھروسا کیدو، بس تھو تُن تُنو شریک مِلأ دے (مھی خلاف) تُنو تدبیر غورا کی کوا، بھی تُھن تدبیر تُھن حی آ می کی شک و شبہ آں کی بُریل بأت سی ذریعہ سوا نہ بژے، بھی مھی خلاف کائی کودیو کوا، آں مھیئے کی مہلت نہ دا۔
بھی ہُم کو تھوئے مُو نُڑیل ساتوو، مأ کی مے (تبلیغ) سی سَرتے تھوما میزدی دا نہ نیمأدچی! مھی میزدی سی ذمہ اللہ گھینچی، آں مھیئے أ حکم دیا گودُو کہ آ فرمان بردار خلگا می شامل ہیئی۔
بھی تھیئے خلگے نوحؑ لووال گھنُو، بس مھوئے نوحؑ، آں کآم خلک یأ تیسیت کشتی می اَشیئی، تھأ بچ کی، آں تھأ کأفر آ سی پوت دھیرین می آباد کی، آں تھأ خلک کی یأ مُھن نشانی لوو گھنئیشی، تھأ (طوفان می) غرک کی، بس مھیرے بُو کہ کامے خلک یأ خبردار کوا گئیشی دا تھین انجام کھال ہُو؟۔
تیما بعد مھوئے (دأل) پیغمبر تھین تُن تُنو قوم آ سی ڈھأر کے پیئ، سے تھین کأنگے صفا صفا دلیل گھیندے اَئی، اَسے تھیئے خلگے کامے بات اول گونا لَوو گھینیشی، تِسی بھی ہُم نہ مینی،کامے خلک حد ما لھنگئیدی تھین حی آ زید مھو اَںئی ہاموڑ مہر ݜژادی۔
تیما بعد مھوئے موسیٰؑ و ہارونؑ فرعون آں تِسی سردارا سی کأشکے تُنو نَخ دیدے پیئی، دَ تھیئے کِبر ما کام گھین، آں سے مجرم خلک اَشیئی۔
دَ کے یأ تھین کأشکے مُھن ڈھأرا حق سی پیغام آپ تہ تھیئے بنُو کہ: أ خامخا صفا صفا جادو تُھو۔
موسیٰؑ بنُو: تھو حق سی بارا می ہأل بات بندی یأ سے تُھن کأنگے اَپتُو؟ کئی ہے کی جادو تھو؟ حالانکہ جادوگر یئت کامیاب نہ ہودی۔
تھیئے بنُو: تھو مُھن کأنگے مِسی کأ اَئیدی کہ تھو مھو تھأ طور طریقہ آ ما دھی کوا کامیگا زید مھوئے تنُو بوپ داد ڈیڈیشی؟ آں مے دھیرین می تُھن دُو آ سی گھینیئی قائم ہوئے؟ مھو دا تُھن دو آ سی بات مُنو والا نی تھی۔
آں فرعون (تُنو نوکرائے) بنُو: کھیدیک ماہر جادوگر تھی تھأ گھیندے مھی کأشکے یا۔
دَ کے یأ جادوگر اَئی، موسیٰؑ تھأئے بنُو تَھلا کائی تھو تھلَدیو۔
بھی کے یأ تھیئے (تُنو لھأڑ و کھے) تھلیئی (آں سے جن سَوا بیشتے تِلین نظر ییؤسأد) دَ موسی علیہ السلام بنُو کہ: میسں کا یأ تھوئے پشادتُو دا ہے جادو تُھو، اللہ ایس مھیرے تَس نَس کونین، اللہ فسادی آ سی کام سَوؤ گے نہ دیدو۔
آں اللہ حق تُنو حکم دے سأز کودُو، کو مجرم خلک چیر لاݜ گھنن۔
بھی موسٰیؑ زید دوئی یی نأ خو تِسی تُنو قوم سی زینی زوانے فرعون آں تُنو سردارے ما بھین بھین ایمان اَنُو کہ مھاموڑ نأئی فرعون تھأئے تکلیف اَوے، آں یقینًا فرعون دھیرین زید چیر زوروڑ اَشو، آں سے حد ما لھنگُو والا خلگے ما اَشو۔
آں موسٰیؑ بنُو: اے مھی قومأ! کو تھوئے واقعی اللہ زید ایمان اَنودُوو اَںئی تیزید بھروسہ کوا، کو تھو مَنُو والا تھیو۔
مے بأت زید تھیئے بنُو: ہُم اللہ زید مھوئے بھروسہ کیدو، اے مُھن پروردگار مھو ہأ ظألم خلگا سی ہات تے اَزمیخ وا نہ تَھل۔
آں تُنو رحمتے دے مھو کأفر خلگے ما بچ کو۔
آں مھوئے موسٰیؑ و تِسی بھئی گے وحی کی کہ: "تھو دُوئیمو تُنو قوم مصر سی شیرا می آباد کوا، آں تُنو شیرے ما نماز سی پوت سوا، آں (مھامُوڑ) نماز قائم کو، آں ایماندا آ ئے زیرے دا"۔
آں موسٰیؑ بنُو: "اے مُھن پروردگار! تأ فرعون آں تِسی سردارائے دُونیئی سی جیدون می چیر سمبالَخ و مال و دولت دیدچی، اے مُھن پروردگار! اِسی نتیجہ أ نوُخوژی کہ سے خلک چھی پَن ما گمراہ کودی، اے مُھن پروردگار! تھین مال و دولت تَس نَس کو، آں ہین حی مھال سخ کو یرأ ہے تے وخہ پورے ایمان نہ اَنن یأ ہیئے دردناک عذاب تنُو أݜیئیے دے نی ڈیڈتُوو"۔
(اللہ) بنُو: "تُھن دعا قبول کوا گودُو، مھیرے تھو دُوئیمو پوخ اِڑی ہوا، آں تھأ خلگا سی پَن دے بھیت تے نی تِلا کآم یأ (حقیقت ما) ناواقف تھی"۔
آں مھوئے بنی اِسرائیل سمندرے دے لھنگات، دَ فرعون و تِسی لخکر ہُم ظلم و زیاتیئی سی نیت تے تھین پأش پأش گئی، حتٰی کہ کے یأ سے ڈوب ہوؤسأت تا تی بنُو: "مأ مے بات مینی کہ کامے خُدئی زید بنی اسرائیل ایمان اَندُو تیما علاوہ دوئی یام خدا نو تُھو، آں آ ہم منو والا آ می شامل ہودُو"۔
(جواب دیاگا) کہ: "مھیرے (ایمان اَندُو)؟ حالانکہ اِیما موش نافرمانی کوؤدود، آں مُوآ فساد کوؤدود"۔
بس آش مھوئے چھی (صرف) بدن بچ کونین، مِسی کأ تو تھأما بعد سی خلگا سی کأ عبرت سَوا بش، آں یقیناً چیرگن خلک مُھن نشانی آ ما غافل تھی۔
آں مھوئے بنی اِسرائیل مھال شانا اے پوت می آباد کی یأ حقیقت می آباد ہوؤ سی لائق اَشو، آں تھأئے پاک شیئیے ما رزق دید، بھی تھیئے (حق دین سی بارا می) تے ساعدا پورے کی اختلاف نی کی کھیدیخانگے تھین کأشکے علم نہ آپ، یقین کو کامے بأدا می سے اختلاف کوؤدُود تھین فیصلہ چھی پروردگار قیامت سی دی کونین۔
دَ (اے پیغمبرؑ!) کو (بفرض محال) تھیئے مے کلام می اے پِھٹ ہُم کی شک چھی، کیس یأ مھوئے تھیزید نازل کیدُو، دَ تھأ خلگے ما توَس کو کآم یأ تھیکیژا موش تے (آسمانی) کتاب پڑھاؤ کودی، یقین کو، کہ چھی ڈھأر کے چھی پروردگار سی دِشا حق اَپتُو، بس تو یئت ہُم شک والا آ می شامل نہ ہو۔
آں نأئی تھأ خلگا می یئت شامل ہو کیئے یأ اللہ سی آیت لوو گھنئیدی، نأو تأ تھأ خلگا می شامل ہونین کی یأ تاوان سی بیا کیئی۔
بےشک کآم خلگا سی بارا می چھی پروردگار سی بات ثابت ہیئی، تھیئے ایمان نہ اَننین۔
کو تھین موشکے ہر قسم سی نشانی کئی نہ یو، کھیدیخانگے تھیئے تکلیف دیؤ والا عذاب تنُو أشیئے دے نی ڈیڈتُوو۔
دَ مھال اے گام یئت کئی نہ ہُو کہ تی ایمان آنو آں تِسی ایمان تیسکے فائدہ دید؟ البتہ یونسؑ سی قوم ہال آشو؛ کے یأ تھئے ایمان اَنو دا مھوئے دونیئی سی جیدون میں بےعزتی سی عذاب تھیئے ما بھا کی، آں تھأ اے مُدا آ پورے جیدون ما خوند سی گھینوئے چھوئی۔
آں کو چھی پروردگار نیمادوشُوو دھیرین زید جوند تھلو والا بُٹ خلگے ایمان اَننین دے، دَ کئی تأ خلگا زید زور کونین، مِسی کأ سے بُٹ مومن سَوا بیَن؟
آں اے انسان سی کأ ہُم أ ممکن نو تُھو کہ سے اللہ سی اجازت ما بغیر ایمان اَنے، آں کامے خلک عقل ما کام نی گھیندی اللہ تھأزید گندگی مسلط کودُو۔
(اے پیغمبرؐ!) ہأئے بَن کہ دھأک بُوادا، آسمان آ می آں دھیرین می کا کا شیئی تھی؟ اَسے کامے خلک یأ ایمان نہ آندی تھین کأ (دھیرین و آسمان می خور ہوئیل) نَخ آں شیدؤ والا (پیغمبر) کی فائیدا سی نہ ہودی۔
دَ کئی ہے خلک (ایمان اَنو سی کأ) میما علاوہ کامے بأت سی طمع تھی کہ ہے ہُم تھال دی پَشن کھال یأ تھیئے ما موشوک خلکے ڈیڈیشی؟ بَن: دَ تھو طمع بھیا، آں ہُم تھوسیت طمع بَھیَدُو۔
بھی (کے یأ عذاب ییدُو) مھو تنو پیغمبر آں تھأ خلک کآم یأ ایمان آندی، تھیا بچ کودی، اَںئی ہاموڑ مھوئے مے بأت سی ذمہ واری گھینچی کہ مھو بُٹ مومن آ ئے ہُم نجات دَئی۔
(اے پیغمبرؑ!) ہأئے بَن کہ اے خلگا ہانا! کو تھو مھی دین سی بارا مے کئی شک وا گئیدیو دَ (بُھویا کہ) تھو اللہ ما علاوہ کسی کسی عبادت کودی دا آں تھین عبادت نہ کودُو، بلکہ آ تے اللہ سی عبادت کودُو یأ تُھن سا گھیندُو، آں مھیئے أ حکم دیا گودُو کہ آ مومن آ می ہیئی۔
آں (مھیئے) میسں (بنا گودُو) کہ تنو مُو حی سی اخلاص تے مے دین سی ڈھأر کے کویل سات، آں یئت ہُم تھأ خلگا می شامل نہ ہو کآم یأ اللہ سیت دوئی کیںئس شریک کودی۔
آں اللہ چھیدے مھال کآں (لوو آ سی خُدئ آ ئے) نہ ہاگا کآم یأ تھیئےنأ کی فائیدا دے بھادُو نائی نقصان، بھی ہُم کو تأ (بفرض محال) ہاموڑ کیو تأ ظألمے ما ہونین۔
آں کو تھیئے اللہ کی تکلیف دیدو، تیما علاوہ دوئی یام نو تُھو یأ سے تیس تھأما دھگو کوئے، آں کو تی تھیزید کی خیگڑا سی ارادہ کیو یام ہُم تِسی فضل سی مُو نو نُڑا بھادُو، سے تنُو فضل تنُو بندہ آ می کیس کے نیمادُوو آوادُو، آں سے چیر بوگوشو والا گھن مہربان تُھو۔
(اے پیغمبرؑ!) بَن کہ: خلگا ہانا! تُھن پروردگار سی ڈھأرا تُھن کأشکے حق آپتُو، مھیرے کامے ماݜ ہدایت سی پان گأدو تی تنُو کأ گݜنین، آں کی گمرائی گأدو تِسی نقصان اَںئی تیسکے اَوونین، آں آ تُھن کما سی ذمہ وار نو تُھو۔
آں کامے وحی یأ تُھن دِشکے پیا بژژی تیس پیش بَیا، آں صوو ما کام گھینا، کھیدیخانگے اللہ کی فیصلہ نہ کیدُوو، آں سے ٹولے ما غورا فیصلہ کوؤ والا تُھو۔
الف، لام، را، أ سے کتاب تُھو تِسی آیات (دلائلے دے) مضبوط کوا گئیدی، بھی تے ذات سی دِشا ہأ تفصیل دے بیان کوا گئیدی کآم یأ حکمت والا آں ہر بأت ما باخبر تُھو۔
(أ کتاب پیغمبر کے حکم دیدوُ کہ خلگائے بَن) اللہ تعالی ما علاوہ یسی عبادت نہ کوا، آ تِسی دِشا تھو بَھیو والا آں زیرے دیؤ والا تُھو۔
آں ہے ہدایت دیدُو کہ تھو تنُو پروردگار ما گناہا سی معامی نِما، بھی تِسی دِش کے رجوع کوا، تی تھوئے اے مقرر وخا پورے (زندگی ما) مزہ گِھنُو سی موقع دینین، آں کامے ماݜ یأ زیات عمل کی تیس کے تنُو دِشا زیات اجر دینین، آں کو تھوئے مُو نراد دَ آ بھیدُو تھوزیت گھن دی سی عذاب ما۔
اللہ تعالی سی کأشکے تھوئے واپس بژوُ تُھو، آں سے ہر شیئی زیت پُورا قدرت لَردوُ۔
بُودا أ (کأفر) خلک تنُو سینا اللہ ما بیریو سی کأ تاؤ کودی، یاد ساتا کے یأ ہے تنُو اَمن زیت کوژو تھیلدے اَمن بُورادی تَھلا ہُم اللہ تِھن بِیریت آں ڈاگا بأدے ما جَنَدوُ، سے دا سینا می بیرت رازے ما شیِت تُھو۔
آں دھیرین زیت گئیو والا یام جاندار مھال نہ تُھو یأ تِسی رزق سی ذمہ واری اللہ تعالی تنُو ذمہ زیت نی گِھن چی، سے تِسی مستقل ٹھکانا ما ہُم شِیت تُھو، آں عارضی ٹھکانا ما ہُم شِیت تُھو، ہرے بات اے واضحہ کتاب می لِگیل چھی۔
أ اللہ تعالی سی ذات تُھو کی یأ آسمان آں دھیرین ݜو دِیا می پیدا کی، تِسی عرش اُو زیت اَشوُ، میلائی تھوزیت اَزمیخ کوے کہ عمل سی اعتبار تے کآم چیر غورہ تُھو، آں کو تأ بنُو تھوئے خلگے مَئیگ ما بعد دُوآر جینی ہونین دَ کأفر خلگے بننین أ دا ڈاگا جادُو تُھو۔
آں کو مھوئے مھأ خلگے ما دھأک وَخ سی کأ عذاب پَدئے کی دَ ہیئے بننین آخر کا شیئیے مے عذاب کَھمُودوُ، خبردار کامے دی سے عذاب آپ دَ ہأ ما نُوڑو والا نہ ہونین، آں کامے شیئی سی ہے پِشاڑے سَوادی تی ہأ گیر کونین۔
آں کے یأ مھو انسان گے تنُو دِشا رحمت سی مزہ چکھادی آں بھی تیس اِما واپس گِھندی دَ ہے مایوس آں ناشکرا سَوا بژدُو۔
آں کو ایس کے کی تکلیف ما بعد مھوئے نعمدا سی مزہ چکھادی دَ بنَدو ٹول سختی مھأ ما دُھو ہوئی، (اے وخ می) ہے خوشالہ آں فخر کوؤ والا ہودُو۔
ہاں اَسے کآم (خلک) یأ صوو ما کام گِھندی آں نیک عمل کودی اَںئی سے (خلک) تھی یأ ہأئے مغفرت آں گھن اَجر نصیب ہونین۔
بھی (اے پیغمبر) کامے وحی تھیزیت نازل کوا بژژی کئی أ ممکن تُھو تُو تِسی کی حصہ چھو؟ آں تیدے چھی حی تینگی ہوئے؟ کئی کہ ہے خلک بَنَدی ایزیت (محمد صلی اللہ علیہ و آلیہ وسلم زیت) کی خزان کئی نازل نہ ہُو، یا کی مُلیک کئی ایسیت نہ آپ؟ تُو دَ صرف اے بھیؤ والا تُھو آں سے دَ اللہ تُھو یأ ہر شیئی زیت مکمل اختیار لَردوُ۔
کئی ہے خلک مھامُو بنَدی کہ مے وحی می (پیغمبرے) تنُو دِشا سَوأدچی؟ (اے پیغمبر ہأئے) بَن بھی دَ تھو ہُم مھال سَویل دَش سورت سَوأدے اَنا، آں (مے کم سی مدد سی کأ) اللہ ما علاوہ کیس ہُم نِمادیو تیس نِما کو تھو سیال تھیو۔
اِزما بعد کو ہے تُھن بات قبول نہ کودی دَ (اے خلگاہانا) یقین کوا أ وحی صرف اللہ سی علم ما وأدچی، آں اللہ ما سیوا یام ہُم عبادت سی لائق نہ تُھو، دَ کئی مھیرے تھو فرمانبردار سَوا بَیدی؟
کامے خلک یأ دُونیئی سی زندگی آں تِسی شیوژواچا سی نیمؤ والا تھی مھو تھین عملا سی بدَل مے دُونیئی می دیدی آں اِزما ہأسیت کی کمی کوا نہ بژژی۔
ہے مھال خلک تھی ہین کأ آخرت می دیزوخ ما علاوہ کی نہ تُھو، آں (دُونیئی می) ہے کا کِشو تی ٹول بیکارہ ہونین، آں کامے عمل ہیئے کِشوُ تی ٹول ضایع ہونین۔
تھو بنادا سے ماݜ (تِسی برابر کھأ ہوبھادُو) سے تنُو رَب سی دِشا یئیل روخانہ ہدایت (قرآن کریم) زیت قائم تُھو، تِسی پأشکے تِسی حقانیت سی ثبوت أمینے اِزمی آپ تُو، آں اِزما مُوش موسیٰ سی کتاب ہُم (اِسی حق زید ہوؤ سی ثبوت تُھو) سے خلگا سی کأ قابل اتباع آں رحمت سی باعث اَشُو۔ مھال خلک مے (قرآن) زیت ایمان اَندی، آں ہأ ڈلآ می کامے ماݜ اِزما انکار کی دَ دیزوخ تِسی دھروُ سی پوت تُھو، لہذا مے (قرآن سی) بارہ می شک نہ کوا، یقیناً أ حق تُھو ہے تُھن پرودگار سی دِشا اَپ تُو، اَسے اکثر خلک ایمان نہ اَندی۔
آں تے ماݜ ما گھن ظالم کی ہونین سے اللہ زیت لوو سَوے؟ مھال خلگا سی تنُو رب سی کأشکے پیشی ہونین، آں گواہی دیوؤ والائے بننین أ سے خلک تھی ہیئے تنُو پروردگار زیت لوو سَوأدیشی، خبردار مھال ظالما زیت اللہ سی لعنت چھی۔
کآم یأ اللہ سی پَن ما دأل خلک کھمَدی آں اِسی (پَن می) کولا بِیرڑدی، آں سے آخرت ما ہُم انکار کودی۔
مھال خلک دھیرین زیت اللہ ما ییت ہُم بچ نہ ہوبھادی آں اللہ تعالی ما سیوا یام ہین مددگار نہ ہوبھادُو، ہأئے دُوگُن عذاب دیا بژنین، ہے نأ (حق) بھوژ بھادی آں نأئی پَش بھادی۔
ہے سے خلک تھی یأ ہیئے تنُو کأ خسارہ سی سودا کیدو آں کامے معبود یأ ہیئے سیوأدتی ہأئے تھین کی بِلیگا میلاؤ نہ ہونین۔
خامخا ہے سے خلک تھی ہیئے آخرت می ٹولے ما زیات نقصان بھا کونین۔
(دوُئی دِشکے) کامے خلگے ایمان انُودُو آں نیک عمل کودی آں سے تنُو پروردگار گے عاجزی کودی ہے خلک جنت والا تھی، ہیئے تِس می ہمیشہ ہونین۔
ہأ دو فرقا (کأفر و مومن) سی مثال مھامُو تُھو یأ ایک اَن آں بو تُھو، آں ایک پَشُو والا آں بُھوژو والا تُھو، کئی ہے دُوںئیدے اے شان سی ہوبھادی؟ کئی تھو بھی ہُم عبرت نہ گِھندی؟
آں مھوئے نوحؑ تِسی قوم سی دِش کے مے پیغام دیدے پیؤشُو کہ آ تھو مے بأت ما صفا صفا خبردار کوؤ والا تُھو۔
کہ اللہ تعالی ما علاوہ دُوئی یِسی عبادت نہ کوا، یقین کوا آ تُھن بارہ می اے دردناک عذاب سی دی ما بھیدوُ۔
ایزیت تِسی قوم سی تھیئے گھنے بنُو یأ کی کُفر کِشوُ کئیدا مھو دا تھأمی دوُئی کی بات نہ پَشدی کہ تُو دَ مُھن شانے اے انسان تُھو، آں مھو میس ہُم پَشدی کہ صرف سے خلک چھی منُو والا تھی کآم یأ مھومی ٹولا ما کم درجہ سی خلک تھی، آں سے ہُم ظاہری رائے دے، آں مھو تھأمی مھال کی بات نہ پَشدی تِسی وجہ دے تھیئے مھوزیت کی فضیلت ہو، بلکہ مُھن خیال أ تُھو کہ تھو ٹول لووال تھی۔
تی بنُو اے مھی قومأ مھیئے بنادا کو آ تنُو پروردگار سی دِشا پئیل اے واضحہ ہدایت زیت اڑی ہوئیل تُھو، آں تی مھیئے خاص تنُو دِشا رحمت دیدچی، بھی تیس تھو نہ پَشدی، دَ کئی ایس مھو تھوزیت زبردستی دے مَنئی، حالانکہ تھو ایس نہ خوشادی۔
آں اے مھی قوم! آ اے (تبلیغ) زیت تھوما کی مال نہ نِمادُو مھی اَجر اللہ ما علاوہ دوُئی یزیت نہ تُھو، آں کامے خلگے ایمان اَنودوُ آ تھأ نہ ݜگابھادُو، ہأ ٹولائے اللہ سیت میلاؤ ہوؤ تُھو، اَسے آ دا مَیس پَشدُو یأ تھو مھال خلک تھی تھو جہالت سی بأت کودی۔
آں اے مھی قوم! کو آ ہأ ݜگئی دَ کی مھأ اللہ (سی گرفت) ما لھاس نین؟ کئی تھو بھی ہُم نصیحت نہ گِھنَدی؟
آں آ تھوئے میس نہ بنَدوُ یأ مھی قبضہ می اللہ سی خزان تھی، نأ آ غیب سی ٹول بأت جَندُو، آں نأ آ تھوئے میس بَندُو کہ آ فرشتہ تُھو آں کامے خلک یأ تُھن أݜی اُپھوٹ گھنڈَی تھین بارہ می آ میس نہ بَن بھادُو یأ اللہ ہأئے کی نعمت نہ دینین، ہین حی می کا تُھو تیس ما اللہ جَندُو، کو مأ تھین بارہ می کی مھال بات کی دَ مأ ظألما ما ہونین۔
ہیئے بنُو اے نوحؑ! تأ مھوسیت بحث کیدوُ آں چیر بحث کیدوُ، دَ کو تُو سأزال تُھو دَ آن تے (عذاب) کامیک سی یأ تُو مھوئے دھمکی دیدوُ۔
نُوح بنُو: تیس تا اللہ تعالی تھوزیت اَننین کو تی نِمادو، آں تھو تیس بے بس نہ کو بھادی۔
آں کو آ تُھن خیرخواہی کوؤ نِمَئی دَ مھی خیرخواہی تے صورت می تُھن کی کام نہ ینین کے یأ اللہ (تُھن ضد سی وجہ دے) تُھن گمراہ کوؤ سی ارادہ کی، سے تُھن پروردگار تُھو آں تِسی کأشکے تھو واپس نژا بژنین۔
کئی (عرب سی أ کأفر) خلک بنَدی أ (محمد صلی اللہ علیہ و سلّم) مے قرآن اَمنا سَوادتُو؟ (اے پیغمبر) بَن کو ایس مأ اَمنا سَوادتُو دَ مھی جرم سی سزا مھیزیت ہونین، آں کامے جرم یأ تھو کودی آ تِسی ذمہ وار نہ تُھو۔
آں نوح گے وحی پیا گأ، چھی قوم می کامے خلگے مھیدیگا پورے ایمان اَنودُو تھیئے ما علاوہ دوُئی یی ایمان نہ اَننین، لہذا ہے خلک کامے کام کودی تُو تیزت اَمن خپا نہ کو۔
آں مُھن نگرانی می آں مُھن وحی سی مدددے کشتی سَوا، آں کامے خلک ظالم سَواگئیدی تِھن بارہ می مھیسیت بات نہ کو، تھیئے مھیرے غرک ہونین۔
دَ سے کشتی سوؤسأت، آں کے یأ تِسی قوم سی سردار تِسی کأشکے بژودُود دَ تیس پیش پِشاڑے کؤدُود، دَ نوحؑ بنُو کہ تھو مھوزیت ہزدی دَ کھأکأ یأ تھو ہزدی دَ ہامُو مھوئے ہُم تھوزیت ہزنین۔
چیر جلد تھوئے پتہ گھڑنین یأ کیزت سے عذاب ییدو تی تیس رسوا کیدے چھونین، آں کیزیت ہمیشہ سی عذاب ییدُو۔
مھیدیگا پورے کے یأ مُھن حکم آپ آں تانو خُوڑوگُو دَ مھوئے (نوحّ گے) بنُو مے کشتی می ہر قسم سی زیناورے ما دُو دُو جوڑا سور کو، آں چھی شِیر والائے ما یأ کِسی بارہ می بنا گودُو (کہ تھیئے کفر سی وجہ دے غرک ہونین) تھأ چھیدے دأل ہُم سور کو، آں کھیدیک خلگے ایمان اَنودوُ تھأ ہُم (اَمن سیت گِھن)، آں سے چیر آشوڑ خلک اَشیئی تھیئے تیسیت ایمان آنُوشو۔
آں (نوحؑ ہأ ٹولائے) بنُو مے کِشتی می سور ہوا، اِسی بَیو ہُم اللہ سی نام دے تُھو آں اِسی اِڑی ہوؤ ہُم اللہ سی نام دے تُھو، یقین کوا مھی پروردگار چیر بوگوشو والا آں گھن مہربان تُھو۔
آں سے کِشتی کھنا سی شانے موجا سی میئے روان أشی، آں نوحؑ تنُو پوئے آواز کی سے کِشتی ما اے کنارہ می اَشو کہ اے مھی پوُڙو! مھو سیت سور ہو آں کأفرا سیت شامل نہ ہو۔
تی بنُو، مأ مھیرے کآں کھن سی پناہ گِھن نین، تی مھأ اُو ما بچ کونین، نوحؑ بنُو آش اللہ سی حکم ما یام یس بچ نہ کو بھادُو، سیوائے تِس ما یأ کیزیت تی رحم کی، اِسما بعد ہین درمیان می اے چپہ اُوچات ہُو آں سے ہُم ڈوب ہوئیل خلگا می شامل ہُو۔
آں حکم ہُو کہ اے دھیرینے تنُو اُو نُوگل، آں اے آسمانأ اِڑی ہو، دَ اُو شُک آں کام ختم ہُو، آں کِشتی جودی سی کَھن زیت اِڑی ہی، آں بناگا: بربادی چھی ظألم قوم سی کأ۔
آں نوح تنُو پروردگار کے ہاگاد آں بنُو: اے مھی پروردگار! مھی پو مھی شِیر والآ می تُھو، آں یقینا چھی وعدہ سأس چھی، آں تُو ٹولے ما بہتر حاکم تُھو۔
(اللہ تعالی) بنُو: اے نوحؑ یقین کو ہے چھی شِیر والآ می نُو تُھو، تِسی عمل غورا نہ تُھو، مھأ ما مھال شیئی نی نِما یأ تِسی تھیئے علم نُو تُھوو، آ تھیئے نصیحت کودو کہ تُو نادان خلگے می شامل نہ ہو۔
نوحؑ بنُو: اے مھی پروردگار آ چھی پناہ نِمادُو مے بأت ما یرأ آئندہ سی کأ آ تھأ ما تے شیئی نی نِمَئی یأ تِسی مھیئے علم نہ ہُوو، آں کو تأ مھی مغفرت نی کی آں مھیزیت رحم نی کی دَ مأ تھأ خلگا می شامل ہونین کامیک یأ برباد ہوئیدی۔
حُکم ہُو اے نوحؑ مھیرے (کشتی ما) وو، مُھن دِشا تھأ سلامتی آں برکت گِھندے کآم یأ چھی کأ ہُم تھی آں تھیسیت کھیدیک خلک تھی تھین کأ ہُم تھی، آں یام قوم مھال تھی تھأئے مھوئے (دوُنیئی می) مزہ گِھنو سی موقع دینین، بھی ہأئے مُھن دِشا دردناک عذاب آوونین۔
(اے پیغمبر) أ غیب سی دھأک بأت تھی، تھأ مھو تھیئے وحی سی زریعہ دے بَندی، مھیئے بأدے ما مھیدا مُوش نأ تُو جنودوُد آں نأ چھی قوم جنودوُد، لہذا صوو ما کام گِھن، آں آخری انجام پرہیزگارا سی حق می ہونین۔
آں قوم عاد کے مھوئے تِھین بھا ھودؑ پیغمبر سیوأدے پیوؤشُو دَ تی بنُو: اے مھی قوم اللہ سی عبادت کوا، تِس ما علاوہ یام معبود نہ تُھو، تُھن حقیقت مِسما علاوہ دُوئی کی نی چھی کہ تھوئے لوو آ سی بأت سیوأد تی۔
اے مھی قوم! آ تھو ما مِسی (تبلیغ) سی کی اُجرت نی نِمادُو، مھی اَجر دُوئی یی نأ بلکہ تی ذات تنُو ذمہ گِھن تُو کی یأ مھأ پیدا کِیدو، کئی تھو بھی ہُم عقل ما کام نی گِھنَدی؟
اے مھی قوم! تنُو پروردگار ما تنُو گناہا سی معافی نِما، بھی تِسی دِش کے نُڑا، تی تھوزیت آسمان سی دِشا شڑاق سی آگھا مُوژانین، آں تُھن اِشتُو طاقت سیت دوُئی طاقت چیری کونین، آں تھو مجرم سَوا بیشتے مُو نہ نَرا۔
ہیئے بنُو اے ھودؑ! تأ مھوئے کی روخانہ دلیل نہ اَنودوُ، آں مھو تنُو خدا صرف چھی بنُودے چھوؤ والا نہ تھی، آں نأئی مھو چھی بأت زیت ایمان اَنو والا تھی۔
مھو دا مِس ما علاوہ دوُئی کہ نہ بَندی کہ مُھن خدآ ما کیںئے تھیئے نقصان اَوادتُو، ھودؑ بنُو: آ اللہ تعالی گواہ سَوادُو آں تھو ہُم گواہ ہوا کہ تھو اللہ ما سیوا کیس کیس تیسیست خدائی می شریک گھنڈدی آ تِسما بری تُھو۔
(مھیرے) تھو ٹول میلاؤ ہیدے مھی خلاف تدبیر کوا آں مھیئے کی مہلت نہ دا۔
مأ دا اللہ زیت بھروسہ کیژی، سے مھی ہُم پروردگار تُھو آں تُھن ہُم پروردگار تُھو، دھیرین زیت گئیو والا کی جاندار مھال نہ تُھو یأ تِسی تَندئی اللہ سی قبضہ می نہ تُھو، یقینا مھی پروردگار سِدا پَن زیت تُھو۔
بھی ہُم کو تھو مُو نَرادی دَ کامے سوال جواب دیدے آ تُھن کأشکے پیا گوشو مأ تیس تھوئے آوادتُو، آں (تُھن کفر سی وجہ دے) مھی پروردگار تُھن پوت دُوئی قوم مھیت آباد کونین، آں تھو تیس کے کی نقصان نہ آوابھادی، یقینا مھی پروردگار ہر شیئی زیت نظر ساتُو والا تُھو۔
آں (آخرکار) یأ مُھن حکم آپ تا مھوئے تنُو رحمت سی زریعہ دے ھودؑ آں کامے خلگے یأ تِزیت ایمان اَنوشو تھأ بچ کی آں ہأئے مھوئے اے سَخ عذاب ما نجات دِید۔
أ اَشِئی قوم عاد سی خلک، تھیئے تنُو پروردگار سی نَخے ما انکار کِشوُ، آں تِسی پیغمبرا سی نافرمانی کِشی آں ہر تے ماݜ سی حکم مَنوشُو سے جابر آں حق سی دشمن اَشو۔
آں (تِسی نتیجہ أ ہی کہ) مے دُونیئی می ہُم لعنت ہأ پیش ݜأت آں قیامت سی دی ہُم (ݜژنین)، یاد ساتا قوم عاد تنُو پروردگار سیت کفر سی معاملہ کِشی، یاد ساتا بربادی عاد سی کأ چھی سے ھودؑ سی قوم اَشُو۔
آں قوم ثمود سی کأشکے مھوئے تھین بھا صالحؑ پیغمبر سیوأدے پیوؤشو دَ تی بنُو اے مھی قوم! اللہ تعالی سی عبادت کوا، تِس ما علاوہ یام تُھن معبود نہ تُھو، تی تھو دھیرین ما پیدا کی آں اِسمی تھو آباد کی، لہذا تِسما تنُو گناہا سی معافی نِما، بھی تِسی دِشکے نُڑا، یقین کوا مھی رَب تھوئے نھیو ہُم تُھو، دعا قبول کوؤ والا ہُم تُھو۔
تھیئے بنُو اے صالحؑ! اِسما مُوش تا تُو مُھن مِیئے مھامُوڑ دَھرودُو کہ تھأ ما مُھن گھن اُمید اَشِیئی، کامے (بُھودا) سی عبادت یأ مُھن باپ داد کوؤدود کئی تُو مھو تھین عبادت ما کھمَدُو؟ کامے بأت سی یأ تُو مھیئے دعوت دیدو تِسی بارا می مھو گھین شک می بیشتے پریشان ہوئیدی۔
(صالحؑ) بنُو اے مھی قوم! مھیئے بنادا آ کو تنُو پروردگار سی دِشا یئل اے روخانا ہدایت سیت اِڑی ہوئیل تُھو، آں تی تنُو دِشا اے رحمت (یعنی نبوت) دِیدچی، بھی ہُم کو آ تِسی نافرمانی کودوُ دَ کی مھأ تِسی (پکڑ ما) بچ کونین؟ لہذا تھو (مھی فرائضے ما مھأ کھیم دے) بربادی ما علاوہ دوئی مھیئے کا دیدی؟
آں اے مھی قوم! أ اللہ سی اُوخأن تُھن کأ اے نشانی چھی، لہذا ایس آذاد چھوا کہ ہے اللہ سی دھیرین می کھیت نِماژیو تھیت چے، آں ایس کے کی تکلیف نہ آوا، نأو اے نھیو عذاب تھو گݜ نین۔
بھی مھامُو ہُو کہ ہیئے تے اُوخأن مَئی دَ صالحؑ بنُو: تھو تنُو شِیرا می ڇا دی دُوئی مزے کوا (اِسما پأش عذاب یینین آں) أ مھال وعدہ چھی ہے لَوو نی چھی۔
بھی کے یأ مُھن حکم آپ تا مھوئے صالحؑ آں تیسیت یأ کی ایمان اَنوشو تھأئے تنُو خاص رحمت سی زریعہ دے نجات دِید آں تے دی سی رسوائی ما بچ کی، یقینا چھی پروردگار گھن قوت والا گھن اختیار سی مالک تُھو۔
آں کامے خلگے ظلم سی پان اختیار کِشی تھأ اے گھین چیگأئے گأد، تِسی نتیجہ می سے تنُو شِیرا می موتھأل بژیل اَشیئی۔
مھامُو یأ ہے خلک تھیت ہڈوُ دھرئیشی نأ، یاد ساتا قوم ثمود تنُو رَب سیت کفر سی معاملہ کِشی، یاد ساتا بربادی قوم ثمود سی کأ أشی۔
آں مُھن مُلیک (انسانی شکل میں) ابراہیم سی کأشکے (پو سی پیدا ہوؤ سی) زیرے گِھندے اَئی، تھیئے سلام کی دَ ابراہیم (ہُم جواب می) سلام کی، بھی ہیدیک ساعت نہ گوشو دَ ابراہیم (میلأشتوپ سی کأ) لِھگیری کوئیل باس گِھندے آنو۔
اَسے تی ڈِیڈ تا ہین ہات تے باس سی دِشکے مُٹھائے نہ ہودی (یعنی گیل نہ کھادی) دَ تی تھأ ناشینا گھیندے ہأ ما بِھت محسوس کی، دَ مُلیگے بنُو تُو بھی نأ، مھو دا قوم لوطؑ سی کأش کے پیا گئیدی۔
ابراہیمؑ سی جوَئی اِڑی ہوئیل أشی، سے ہیزی، دَ مھوئے تیس کے (دُوآر) اسحاقؑ سی آں اسحاقؑ ما پأش یعقوبؑ سی پیدائش سی زیرے دِید۔
دَ تی بنُو، ہائے مھی کم بختیئے! کئی مأ لَؤ جیانین؟ آ ڈھیگی ہیژی آں أ مھی کھمان تُھو ہے ہُم ڈھیگی ہُودو، واقعی أ دَ چیر عجیبا بات چھی۔
(مُلیگے) بنُو: کئی تُو اللہ سی حُکم زیت تعجب کوژی؟ تُھن مھال مقدس شِیر والآ زیت تا اللہ سی رحمت آں برکت تھی، یقینا سے (اللہ) ہر تعریف سی مستحق آں گھن شان والا تُھو۔
بھی کے یأ ابراہیمؑ ما سے بِھت دھو ہی، آں تیسکے زیرے میلاؤ ہی، دَ تی مھوسیت (مُھن مُلیگا سیت) لوطؑ سی قوم سی بارا می مارَزا شروع کی۔
یقینا ابراہیمؑ چیر برداشت والا نرم دل آں اللہ سی دِشکے نُڑو والا اَشو۔
(مُھن مُلیگے تیسکے بنُو) اے ابراہیم! مے بات چھو، یقین کو چھی رَب سی حکم آپ تُو، آں ہأ خلگا زیت مھال عذاب ینین یأ تیس یام واپس نہ کو بھادُو۔
آں کے یأ مُھن ملیک لوطؑ سی کأشکے اَئیدا سے ہین وجہ دے بِھیؤ، تِسی حی پریشان ہُو، آں سے بنُوسأت: آش سی دی چیر سَخ تُھو۔
آں تِسی قوم سی خلک تِسی کأشکے دھأںئیدیل اَئی، آں سے مُوش ما لاݜ کَم کوؤدُود، (لوطؑ) بنُو: اے مھی قوم سی خلگاہانا! أ مھی (قوم سی) سیرأن موجود تھی، ہے تُھن کأ زیات پاکیزہ تھی، دَ تھو اللہ ما بھیا آں مھی میلأݜا سی بارہ می مھأ شرمندہ نہ کوا، کئی تھو می یام غورا ماݜ نہ تُھو؟
تھیئے بنُو: تھیئے معلوم تُھو کہ چھی (قوم سی) سیرأنا می مُھن کی مطلب نی چھی، آں تُو جَندوُ کہ مھو کا نِمادی۔
(لوطؑ) بنُو: کاش مھیسیت تُھن مقابلہ سی کی طاقت ہوئیدے، یا آ کآں مضبوط سہارا سی پناہ گِھنیدے۔
(دَ مُلیگے) بنُو: اے لوطؑ! مھو چھی پروردگار سی پئیل فرشتہ تھی، أ (کأفر) خلک یئیت ہُم تھوئے نہ اَبو بھادی، لہذا تُو ڙأت سی کآں حصہ می شِیر والا گِھندے مے گام ما ریوان ہو، آں تھو می یام ہُم پَتکے نِڑتے نہ بوئے، ہاں اَسے چھی جوَئی (تھوسیت نہ بژنین) تِزیت ہُم سے مصیبت ییؤ والا چھی کامیک یأ دأل خلگا زیت یَنین، یقین کو ہأزیت عذاب ییؤ سی کأ ڙات سی وَخ مقرر تُھو، کئی ڙات بیخی نھیو نہ تُھو؟
بھی کے یأ مُھن حکم اَپ تا مھوئے تے دھیرین سی ڙیت سی حصہ ٹین سی حصہ می بدَل کی، آں ہأزیت پژیل سُم سی بیڑیل پرلہ پَسی مُوڙأت۔
تھأ (بیڑیلا) زیت چھی رَب سی دِشا نَخ ݜژیل اَشِیئی، آں ہے (سزا) ظألمے ما کی دُھو نی چھی۔
آں مدین سی دِشکے تھین بھا شعیب (پیغمبر سیوأدے پیؤ)، دَ تی بنُو اے مھی قوم! اللہ سی عبادت کوا، تِسما علاوہ تُھن یام معبود نہ تُھو، آں ناپ تول می کمی نہ کوا، آ پَشدوُ تھو خلک خوشالہ تھی، (اَسے) مھیئے تھوزیت مھال عذاب سی بھِت چھی تی تھو چؤ دِشے گیر کونین۔
آں اے مھی قوم! ناپ تول پورا پورا کوا انصاف تے، آں خلگائے تھین شیئی کم نہ کوا، آں دھیرین زیت فساد خور کیدے نہ گیئا۔
(کو تھوئے مھی بات مینی دَ خلگا سی حق تھأئے دیؤ ما بعد) اللہ سی دیئل کا بچ دھروُو سے تُھن کأ بہتر تُھو،کو تھو مومن تھیو، آں (کو تھوئے مھی بات نہ مینی) آ تھوزیت څوگیدار مقرر نہ ہودوُ۔
تھیئے بنُو: اے شعیبؑ! کئی چھی نماز تھیئے مے حکم دیدوُ کہ مُھن باپ داد یأ کِسی عبادت کوؤدود تا مھو تھأ چھیئی؟ آں تنُو مال دولت می کا یأ مھو نِمادی دا تیس مھو نہ کیئی؟ واقعی تُو دا گھن ہُوشا آں نیک ماݜ تُھو۔
(شعیبؑ) بنُو: اے مھی قوم! مھیئے بنادا کو آ تنُو پروردگار سی دِشا روخانہ دلیل زیت اِڑی ہوئیل تُھو، آں تی تنُو دِشا مھیئے غورہ رزق دِیدچی (دَ بھی آ تُھن غلط طریقہ زیت کئی چیلی؟)، آں مھی مھال کی اِرادہ نی چھی کہ آ تھو کامے بأت ما کھمَدوُ تھوما بعد بیشتے تے کام أمیدے کیئی، مھی مقصد تنُو طاقت سی حدہ پورے اصلاح ما سیوا کی نی چھی، آں مھیئے کا توفیق میلاؤ ہُودوُ صرف اللہ سی مدد دے ہُودوُ، تِزیت مأ بھروسا کِیژی، آں تِسی دِشکے آ ہرے معاملہ می نُڑدوُ۔
آں اے مھی قوم! مھیسیت یأ تھو کامے ضد سی معاملہ کودی دا سے تھو یئیت مے انجام گے نہ اَوے کہ تھوزیت ہُم تھأل مصیبت نازل ہوئے کامے مصیبت یأ نوحؑ سی قوم زیت یا ھودؑ سی قوم زیت یا صالحؑ سی قوم زیت نازل ہِیشی، آں لوطؑ سی قوم دا تھو ما کی دھوُ نہ تُھو۔
تھو تنُو رَب ما معافی نِما، بھی تِسی دِشکے نڑا، یقین ساتا کہ مھی رَب گھن مہربان، چیر مینہ کوؤ والا تُھو۔
تھیئے بنُو اے شعیبؑ! چھی چیر بأت تا مُھن سمجھ می نہ ییدی، آں مھو پَشدی کہ تُو مھو می اے کمزور ماݜ تُھو، آں کو چھی خاندان نہ ہُوشُوو مھوئے تھأ باڑے دے مانیندے، مھوزیت چھی کی زور نہ چَلدوُ۔
(شعیبؑ) بنُو اے مھی قوم! کئی تھوزیت مھی خاندان سی زور اللہ ما زیات تُھو؟ تیس تا تھوئے بالکل پِیٹ پأشکے تَھلودوُ، یقین کوا کا یأ تھو کودی مھی پروردگار تے ہرکی ما چاپیرا تُھو۔
آں اے مھی قوم! تھو تنُو حال زیت دھیرتے (کا یأ نِمادی) عمل کوا، آ ہُم (تنُو طریقہ سی مطابق) عمل کودو، چیر جلد تھوئے پتہ گھڑنین کہ کیزیت تی عذاب نازل ہونین یأ کیس مختورا کیدے چھونین، آں کآم لووال تُھو، آں تھو ہُم انتظار کوا آں ہُم تھوسیت انتظار کودوُ۔
آں (آخرکار) کے یأ مُھن حکم اَوؤ دَ مھوئے شعیبؑ آں تیسیت یأ کی ایمان اَنوشُو تنُو خاص رحمت سی زریعہ دے بچ کی، آں کامے خلگے یأ ظلم کِشُو تھأ اے چیگأئے گأد، سے تنُو شیرا می موتھأل بژیل دھریئی،
گوأکی ہے تھأ شِیرا می ہاڈو دھرئیشی نأ، بُھویا! مدین والا سی ہُم تھال بربادی أشی کامے بربادی یأ ثمود سی کأ أشی۔
آں مھوئے موسیؑ تنُو نخے سمانے آں روخانہ دلیل سیت پیغمبر سیوأدے پیوؤشُو،
فرعون آں تِسی سردارا سی کأشکے، دَ تھیئے فرعون سی بات مینی، حالانکہ فرعون سی بات ٹیک نہ أشی۔
تی قیامت سی دی تنُو قوم ما مُوش ہونین، آں ہأ بُٹ دیزوخ کے والا بژنین، آں سے چیر لاݜ پوت تُھو والُو سی کأ۔
آں لعنت مے دُونیئی می ہُم ہأ پیش پسی ہی، آں قیامت سی دی ہُم پَسی ہونین، ہے بدترین بدَل تُھو یأ کیس کے دیأ گاو۔
أ ہأ گاما سی دھأک حالات تھی، تھأ مھو تھیئے بیان کودی، ہأ می یام گام سے تھی مھیرے ہُم تنُو پوت می اِڑی ہویل تھی، آں یام گام چھینیل فصل سی شانے بے نَخا سوا گئیدی۔
آں ہأزیت مھوئے کی ظلم نہ کِشُو، بلکہ ہیئے أمینے تنُو اَمن زیت ظلم کِشُو، تِسی نتیجا أ ہی کہ یأ چھی پروردگار سی حکم آپ تا کامے معبودائے ہے اللہ سی مقابلہ می ہاگوؤدود سے ہین کی کام نہ اَئی، آں تھیئے ہأئے تباہی ما علاوہ دوئی کی نہ دِید۔
آں کامے گام یأ ظألم ہودی، چھی پروردگار تھأ گݜوسأدو تِسی گݜُو مھال ہودُو، یقینا تِسی گݜُو سخ تُھو دردناک تُھو۔
ہأ ٹول بأدا می تے ماݜ سی کأ گھین عبرت چھی کآم یأ آخرت سی عذاب ما بھیدوُ، تی مھال دی ہونین تِسی کأ بٹ خلک جمع کوا بژنین، آں تی مھال دی ہونین تیس ٹولے کولاؤ أݜیئے پشنین۔
آں مھوئے تیس اے لکھیل وخا پورے کَھمودوُ (ٹھیلادتُو؟)۔
کے یأ سے دی آبو یی ہُم اللہ سی اجازت ما بغیر بات نہ کو بھانین، بھی تھأمی یی بدبختا ہونین آں یی تالیئی (خوش قسمتا؟) ہونین۔
کآم یأ بدبختا تھی دا تھیئے دیزوخ می ہونین، تِسمی ہیئے اوتھأن دینین آں مئیلانین۔
ہیئے تِسمی ہمیشہ دھرنین کھیدیگا پورے یأ آسمان آں دھیرین قائم تھی، اَسے کو چھی رَب کے دوئی کی منظور آشُوو، یقیناً چھی پروردگار یأ کا ارادہ کودوُ تیزیت عمل کودوُ۔
آں کامے خلک یأ نیک بختا تھی تھیئے جنت می ہونین، تِسمی ہیئے ہمیشہ دھرنین، کھیدگا پورے یأ آسمان آں دھیرین قائم تھی، اَسے کو چھی رَب کے دوُئی کی منظور اَشُوو، ہے مھال ڈالی چھی تی یئیت نہ لَھسنین۔
لہذا (اے پیغمبر) أ مشرک کسی عبادت کودی دا تِسی بارہ می تو اے خس ہُم شک می نہ ہو، ہے دا مھامُو عبادت کودی کھأکأ یأ ہین باپ داد مُوش عبادت کوؤدود، آں یقین کو مھوئے ہأ ٹولائے ہین حصہ پورا پورا دینین، تِسمی کی کمی کوا نہ بژنین۔
آں مھوئے موسی ئے کتاب دِیدوشُو، دَ تِسمی ہُم اختلاف کوا گوشُو، آں کو چھی پروردگار سی دِشا أ بات مُوش ما مقرر نہ أشیو (کہ ہأئے پورا عذاب آخرت می دیا بژنین) ہین فیصلہ (مے دُونیئی می) ہونیندے، آں ہے خلک تِسی بارہ می (مے وخا پورے) سخ شک می تھی۔
آں یقین کو کہ ٹول خلگا سی معاملہ أ چھی کہ چھی پروردگار ہین عملا سی بدل پورا پورا دینین، یقیناً سے ہین ٹول عملے ما غورہ شِد تُھو۔
لہذا (اے پیغمبر) کھأکأ یأ تھیئے حکم دیا گودُو تِسی مطابق تُو ہُم سِدا پَن زیت مضبوط اِڑی ہو، آں سے خلک ہُم کی یأ توبہ کیدے تھیسیت تھی، آں حد ما مُٹھائے نُو نُوخا، یقین کوا کہ کامے عمل تھو کودی سے تیس پَشدُو۔
آں (مسلمانا ہانا) ہأ ظألم خلگا سی دِشکے کیلی نہ ہوا، نأو دیزوخ سی آنگا تھو ہُم گݜنین، آں اللہ ما سیوا کی قسم سأت میلاؤ نہ ہونین، آں تُھن یی ہُم مدد نہ کونین۔
آں (اے پیغمبر) دی سی دُوںئی ݜآ می آں ڙأت سی دھأک حصہ می نماز قائم کوا، یقیناً نیگی دیدے گناہ ختم کودی، أ اے نصیحت چھی تھأ خلگا سی کأ کآم یأ نصیحت منَدی۔
آں صوو ما کام گِھن میلائی اللہ نیگی کوؤ والا سی اَجر ضائع نہ کودُو۔
تھو ما مُوش کامے اُمت لھنگئیدی تھأ می مھال خلک کئی پیدا نہ ہوئی کہ تھأ می کآں پوھہ ہودے کہ سے خلک دھیرین زیت فساد سی کوؤ ما کَھمندے؟ ہاں دھأک شانا خلک اَشِیئی تھأ مھوئے (عذاب ما) بچ کی، آں کامے خلک یأ ظألم اَشِیئی سے کامے عیش و عشرت می اَشیئی دا تیس پیش ݜأدیشی، آں سے مجرم اَشیئی۔
آں چھی رَب مھال نہ تُھو کہ سے گاما زیت ظلم کیدے تھأ تباہ کوئے آں تھیت سے خلک نیکوکار ہون۔
آں کو چھی پروردگار نِمؤدوُدو تمام انسان اے طریقہ سی منُو والا سَوانیندے، (اَسے یس زبردستی اے دین زیت مجبور کوؤ حکمت سی تقاضہ نہ تُھو، کھأئیمو ہأئے تنُو اختیار تے مختلف طریقآ سی موقع دِید) دَ مھیرے ہیئے مختلف پَنا زیت دھرنین۔
البتہ کیزیت یأ چھی پرودگار رحم کی تِسی بات دُوئی چھی (کہ اللہ تیس حق زیت اِڑی ہویل دھرانین) آں مے امتحان سی کأ تی ہأ پیدا کیدی، آں چھی رَب سی تی بأدے پورا ہونین کامیک یأ تی بینیشی کہ: مأ جہنم پیر و انسان دُوںئیدے پُننین۔
آں (اے پیغمبر) مُٹھِک پیغمبرا سی واقعات مھو تھیئے بُھوژادی، تیدے مھو چھی حی مضبوط کودی، آں واقعادا سی ضمن می کامے بات تھیئے أپ چی، سے أمیدے ہُم حق چھی، آں تمام مومنا سی کأ نصیحت آں یاد گیرَنا چھی۔
آں کامے خلک یأ ایمان نہ اَندی تھأئے بَن کہ تھو تنُو پوت می عمل کوا، مھو تنُو پوت می عمل کودی۔
آں تھو ہُم (اللہ سی فیصلہ سی) انتظار کوا، مھو ہُم انتظار کودی۔
آسمانا می آں دھیرین می کھدیک بِیریت بأت تھی سے اللہ سی علم می تھی، آں تِسی دِشکے تمام معاملات واپس کوا بژنین، لہذا (اے پیغمبر) تِسی عبادت کو آں تِیزت بھروسا کو، آں تھو خلک کا کودی دا تُھن پروردگار تِسما بے خبر نہ تُھو۔
الف لام را، أ حق واضح کوؤ والا‌ کتاب سی آیأت تھی
مھوئے مے قرآن عربی جِب می نازل کیدو یرأ تھو جنا
(اے پیغمبرؐ!) مھو مے قرآن سی زریعہ ‌دے کامیک یأ مھوئے چھی دِشکے پیؤدُو دا، تھیئے اے چیر شِیژے قِصہ بُھوژادی، آں تھو اِیزما مُوش یقیناً (اے قصہ ما) بالکل بے خبر اَشئ۔
کے یأ یوسفؑ تُنو بوپ کے بنو: "اے باوا! بیشکہ مأ ڈیڈ (نین می) اگاش تاء و سی و یُن؛ مأ تھأ ڈیڈ سے مھیئے سجدہ ‌کودی"۔
تی (یعقوبؑ) بنو: "پوڙأ! تُنو اے نین‌ تُنو بھیائے‌ نہ ‌بَن، نأو تھیئے چھی خلاف سازش ‌کونین، بے شکہ شیطان‌ انسان سی اخکارہ ‌دشمن ‌تُھو"۔
اَںئی ہامُو چھی پروردگار تھأ خوشانین، آں تھئے نین سی معنی ڇِھڙانین آں تھیزید آں یعقوبؑ سی خاندان زید تُنو نعمت پورا ‌کونین کھأکأ تی مِیما مُوش چھی بوب‌داد ابراہیمؑ آں اسحاقؑ زید پورا ‌کیشی۔ بے شک چھی رب چیر جنُو والا آں حکمت والا تُھو۔
یقینًا یوسفؑ آں تِسی بھیا سی قِصہ می توَس کوؤ والا سی کأ نشانی‌تھی۔
تُھو کے تھیئے بنو یوسفؑ و تِسی بھا مھوئے ما زیات مُھن بوپ سی خوش تھی حالانکہ مھو پورا اے جماعت چھی، یقینًا مُھن باپ اخکارہ غلطی زید ۔
یوسفؑ ما یائی تیس دُھو کآں پوت زید چھوا، بھی تُھن بوپ سی پھِگر تُھن دِش کے ہونین آں اِیما بعد تھوئے نیک ہونین۔
تھیئے ما ایک بنو: "یوسفؑ نہ ما، ایس أنچیگیل کُوئی وا تَھلا، کیئت کآم مسافر ایس اَمن سید نئے، کو تھو خامخا کی کودیو"۔
تھیئے بنو: "باوا، کا بات چھی؟ تو مھوزید یوسفؑ سی بارہ می یقین نہ کودو، حال أ چھی مھو اِسی خیرخواہ تھی"۔
"لولو ایس مھوسید پے، کآں کَھئے (پوئے) آں نڑے، آں بے شکہ مھو اِسی حفاظت کوؤ والا تھی"۔
(یعقوبؑ) بنُو "تُھن اِسی نیو مھأ خپا کودو، آں آ بھیدُو ایس شرمُخ نہ کَھئے آں تھو اِیما لا پرواہ ہُوا"۔
تھیئے بنُو مھو اے طاقتور جماعت چھی کہ مُھن موجودگی م ایس شُرمُخ کھوؤ و بھی دا مھوئے چیر لاربژیل خلق ہونین
دَ کے یأ تھیئے تیس نُو، آں تھیئے اتفاق کی یرأ (یوسفؑ) اے أنچگیل کوئ وا تھیلی (آں تھیئے ہامُو کی) آں مھوئے یوسفؑ کے وحی کی "(اے دی مھال یے نین) تأ ہأئے ہین کم سی خبر دینین، آں ہیئے شید ہُم نہ ہونین یرأ تُو کآم تُھو"۔
(مے حرکت کیدے) سے خُوبتنُو ڙِینگیل تُنو بوپ سی کأشکے اَئی
بندی اے باوا مھو دا ایک دوئی ما دھأئیں می مُٹھائے ہوؤ می مصروف اشیئ، آں مھوئے یوسفؑ تُنو سامان سی کأن چھوؤ دا تیس شرمُخ کھوؤ۔ آں تُو مُھن بأت زید یقین نو کودُو کو مھو سأس ہُم بنَددی و۔
آں تھیئے یوسفؑ سی پأن لَوو آسی ڙات ݜژأدے أںی، یعقوبؑ بنوُ (تیس شُرمُخ نہ کھوؤدُو) بلکہ تھوئے اَمَنا حی می اے بات سیوأدچی، آں بس سوو بہتر تُھو أ کائی تھو بنَدی۔ دَ ایزید صرف اللہ ما مدد نِیمادُو۔
دَ تھیت اے قافلہ أپ، تھیئے تُنو اُو آنوُ والا پیوؤ، تی تُنو اُو سی ڈَوَئی کُوئی وا تَھلُو، دَ بنُو بُومارک، أ دا اے پو تُھو! آں تیس بِگینُو سی شیئی گھیندے اَمن کیش بُورات، آں اللہ تعالٰی یے تِھین ٹول عمل معلوم اَشیئ۔
آں (تِسی بَھئ یے) تیس دھأک قیمت یعنی اَشُوڑ درہما سی بدلہ می بِگینوُ، آں سے اِیما بےزار اَشیئ
مصر می کامے ماݜ ایس مُل گِھن دا تی تُنو ڇھی (زلیخا) ئے بَنو ایس عزت تے سات، ہوبھادُو ہے مھوئے فائدہ دو، یا مھو ایس تُنو پو سَوئی، اَںئی ہامُوڑ مھوئے یوسفؑ کے مے دھیرین می پوت دید، مِسی کأئی یرأ مھو ایس کے نِین سی بأدا سی معنی ڇِھڙئی، آں اللہ تعالٰی تُنو ارادہ می غالب تُھو، اَسے چیر خلک اے بأت ما شید نی تھی۔
آں کے یأ سے (یوسفؑ) تُنو زوأنی ئے آوؤ دَ مھوئے تیس کے حِکمت آں علم دید، اَںئی ہامُو مھو نیک خلگائے بدلہ دیدی۔
آں کامے جَوَئی سی شِیرے (یوسفؑ) اَشُو تی تیس تُنو دِش کے متوجہ کوؤ سی کوشِش کی، آں ٹول درواز بان کی آں بَنژی شِیرتے یے، سے بَندو اللہ سی پناہ، بے شک سے (چھی کھمان) مھی مالک تُھو کی یأ مھأ غورا ساتو، بے شک ظالم کامیاب نہ ہودی۔
آں بے شک تی جَوَئی اِسی ارادہ کی، آں اِی ہُم تِسی ارادہ کونیندے کہ تُنو رب سی دِشا دلیل نی ڈِیڈوشُوو، ایس مھوئے اِسی کأ کی یأ مھو تِما بدکاری آں بے حیائی دُھو سأتی، بے شک سے مُھن مخلص بندآ ما اَشُو۔
آں دُوںئیدے در سی دِش کے دھأںئی دِید آں جَوَئی پأشا تِسی پأن پھألی، آں دُوںئے تِسی کھمان در زید (ایڑی ہویل) پات۔ جَوَئی بَنژی کآم یأ چھی جَوَئی زید لاݜ ارادہ کوئے تِسی سزا بے مِیزا دوئی کا ہو بھائی، یا تیس قید کوا بژے یائی تکلیف دہ سزا دِیا بژے۔
یوسفؑ بَنوُ ای مھأ تُنو دِش کے متوجہ کوؤ نیماد۔ جَوئی سی خاندان ما اے گواہی دیوؤ والا گواہی دید کہ یوسفؑ سی پأن مُوشا پَھلیل چِھی و سے جَوئی سأس بن چھی آں یوسفؑ لووال تُھو۔
آں کو پأن پأشا پَھلیل چِھیو، ہے جوئی لووأل آں یوسفؑ سأس بَن تُھو۔
بھی یأ کَھمن یوسفؑ سی پأن پأشا پَھلیل ڈِیڈتا، تی بَنو ہے تھو جَوَیا سی مُکر تُھو۔ بے شک تُھن مُکر چیر گھن تُھو۔
اے یوسفؑ! اے بات چھو، آں جوئیے! تُو تُنو گناہ سی معافی نیما، بے شکہ تُو گنہگائے ما چھی۔
آں خار می جَوئیئے بأت شروع کی یرأ "عزیز (مصر) سی ڇھی تُنو غلام (چھلے دے) تُنو دِش کے گئیو نِماژی، تِسی (یوسفؑ سی) مینا اِسی حی می پوت گادتو۔ یقینا مھو ہُم ایس اخکارہ غلطی زید پشَدی۔
بھی کے یأ اِی (زلیخا) جَوئیا سی مُکر سی بأت بید تھأئے سوال جواب پیوؤ آں تِھین کأ اے سوبت تیا کی، آں تھیئے ما ہر ایک کے (میوہ سی چھینُو سی کأ) ایک ایک کیرأ دید، آں یوسفؑ کے بنُو ہین مُشکے نوخ، کے یأ تھیئے ایس (یوسفؑ) ڈِیڈتا حان ہوئی آں (حیرانتیا دے) تُنو ہات چِھنیئ، آں بَندی "اللہ سی پناہ، ہے ماݜ انسان نہ تُھو، ہے دا اے معزز فرشتہ تُھو"۔
زلیخا بنُو "ہے سے تُھو کِسی کأ تھو مھأ ملامت کوؤدُود، بے شک مأ ایس تُنو دِش کے ہاگات اَسے تی (تُنو اَمن) ساتُو، آں کا یأ آ بَنژی کہ تیس اِی نی کِیو یقینا اِی قید کوا بژنین آں بے عزت خلگا ما ہونین"۔
یوسفؑ دعا کی "اے مھی پروردگار! کامے کَم سی ڈھأر کے ہے مھأ ہاگادی ایِزما قید ہوؤ غورا گھنڈدُو۔ آں کو تأ مھأ ما ہین مُکر دھوگو نی کِیوو، مأ ہین ڈھأر کے کُوموژنین آں جاہل خلگا ما ہونین"۔
دَ اللہ تعالٰی تیسی دعا قبول کی آں تِیما تِھین مُکر دھوگو کی، بے شک اللہ تعالٰی بُھژدُو آں جنَدو۔
بھی کے یأ تھیئے ٹول نخ پشُو ما بعد ہُم میس سوچ کی یأ یوسفؑ اے وَخا پورے قید کوا بَژے۔
آں (یوسفؑ) سید دُو زوان ہُم جیل گے لھنگئ۔ تھیئے ما ایک بنُو "آ تُنو اَمن (نین می) پَشَدو یأ آ شراب (سی کأ داݜ) چِیودُو، دوئی بنَدوُ "مأ تُنو اَمن (نین می) ڈِیڈ یأ مأ ݜا زید گیل گِھنتی، آں پیݜین تھیئے ما کھادی، مھوئے اِسی معنٰی بَن، بے شک مھو تھأ نیک خلگا ما پشَدی"۔
یوسفؑ بنُو کامے گیل تھوئے (مے جیل می) اَنا بَژژی تی ما مُوش مأ تھوئے مے نین سی معنی بن نین أ تے علم سی حصہ تُھو کامیک مھی پروردگار مھیئے ڇِھیڙادتُو، مأ تھأ خلگا سی مذہب چھوؤدُو کام یأ اللہ تعالٰی زید ایمان نہ آندی آں آخرت سی (دی ما) ہُم انکار کودی۔
آں آ تُنو بوب داد ابراہمؑ، اسحاقؑ آں یعقوبؑ سی مذہب زید عمل کُودو، مُھن کأ أ بات مناسب نی چھی یأ مھو اللہ تعالٰی سید دُوئی یس شریک کیئی، أ اللہ تعالٰی سی مھو زید آں ٹول خلگا زید فضل تُھو اَسے زیاد خلک شکر نہ کودی۔
اے جیل سی سأت ہانا، أ چیر زأن زأنی خُدا غورا کو اے اللہ یأ سے زبردست غالب تُھو۔
تھو اللہ ما علاوہ صرف تھأ نام آ سی عبادت کودی کامیک یأ تھوئے آں بوب دادے اَمَنا تھئی دی۔ آں تِھین (نام آ سی) حق می اللہ کی دلیل نازل نی کِیژی، حکومت صرف اللہ سی چھی، تی (اللہ) حکم کِیدوُ یأ تِیما علاوہ یِسی عبادت نہ کوا۔ أ اے صحیح دین تُھو اَسے چیر خلق نہ جنَدی۔
اے مھی قیدی سأد ہانا تھوے ما ایگے تُنو مالک کے شراب پیانین آں کامیک دُوئی تُھو دا تیس کے پھانسی دِیا بژنین آں پیݜینے تی سی ݜا جِھگیل جِھگیل دے کھانین مے بأت سی فیصلہ ہوا گیئی کسی(بارا) مے تھو تَوس کودی۔
آں دُوںئی ماݜ آ ما ایک، یأ کسی بارہ می تی (یوسفؑ) خیال کیشو یأ اِی آذاد ہونین، ایس کے بَنو: "تُنو مالک سی مُوش مھی ذکر کو" اَسے شیطان تِسی تُنو آقا سی مُوش کے ذکر کوؤ اَموݜا تھلُو، آں سے (یوسفؑ) دھأک کالے پورے قید خانہ می دھرو۔
آں باچا بنو "آ (نین می) پشَدو سات بأر گیئی تھی تھأ سات خوا گیئی کھادی، آں سات نیل ݜیِݜ آں دأل (سات) شوگیل (ݜِیݜ)۔ اے سردارا ہانا! مھیئے مھی نین سی معنا بنا، کو تھو معنا بنو والا تِھیو"۔
تھیئے بنو: "ہأیمو گڈوڈ نین چھی! آں مھو نین آ سی معنا نہ جنَدی"۔
آں تھأ دویںے ما کامیک بچ ہوشُو آں تیسکے اے وخا بعد یاد اَپ بنو "آ تھوئے اِسی معنا بینی مھیئے (جیل خانائے) بژو سی اجازت دا"۔
تھیئے بنو، "اے یوسفؑ! اے چیر سأس بن انسانأ! مھوئے (نین سی) معنا بَن سات شِن بأر گیئی تھأ سات کیمزیر خوا گیئی کھادی، آں سات نیل آں سات شُوگیل ݜِیݜ تھی، دَ آ خلگا سی کأن گے واپس بِیژی آں بَنے تھأئے ہُم پتہ گھڑے"۔
یوسفؑ بَنو تھوئے سات کال اے مُوا بُھوم بونین، بھی کا تھو لُونوسأدو تھأ تِھین گأرا میں چھوا، ہاں دھأک تھأ ما تھو کھا۔
بھی تِما بعد سات کالے سخت یینین، کا یأ تھوئے جمع کیدے چھوؤشُو تیس کھانین، بے تیزا کا یأ دھأک تھوئے بچ کونین۔
بھی تِما بعد اے کال جُخ ہگائے موژنین آں خلگے تِمی رس نِیژوانین۔
دَ باچا بَندوُ تیس (یوسفؑ) مھی کأشکے آنا، بھی کے یأ اے قاصد تِسی کأشکے آپ تا (یوسفؑ) بَندو تُنو مالک سی کأشکے واپس بش، آں تِما تَوس کو یأ تھأ جَوَئیا سی کا حال چھی کامے جَوئیے تُنو ہاتھ چِھنئی شی، بے شک مھی رب تِھین مُکر ما غورا شِت تُھو۔
باچا (تھأ جَویائے) بنوُ کے یأ تھوئے یوسفؑ تِسی نفس (سی حفاظت) ما کُھوگوڑؤ نِیمات تا تُھن کا حال أشی؟ سے بندی اللہ سی پناہ، مھوئے تِمی کی لاݜ نی ڈِیڈتو، عزیز (مصر) سی جَوئی بَنژی مھیرے سأس بات ڈاگا ہی، مأ تیس تِسی نفس سی حفاظت ما کُھوگوڑادُوشُو، آں بے شک سے سأس بَن تُھو۔
(یوسفؑ بنو) ایس مأ مِسی کأ کی یأ (عزیز مصر کے) معلوم ہوئے یرأ تِسی غیرموجودگی می مأ خیانت نہ کیشی، آں بے شک اللہ خیانت کوؤ والا سی مُکر یئد پورا نہ کودو۔
آ تُنو اَمن گے غورا نہ بَندو کئی کے نفس دا لاݜ سی حکم دیدوُ بے تِما کیزید مھی ربے رحم کیدوُ، بے شک مھی رب بوگوشُو والا مہربان تُھو۔
آں باچا بنوُ تیس مھی کأشکے آنا، آ تیس تُنو خاص مشیر سَوئی، بھی کے یأ تی تیسید بات کی دہ بنوُ بے شک تُو آش ما مُھن کأن عزت دار آں امانت دار تُھو۔
(یوسفؑ) بنو: "تو مھأ وطن سی خزان آ ‌زید مقرر کو، بے شکہ آ چَیر حفاظت کوؤ والا آں (مے کم ما چیر) واقف تُھو۔
آں ہامُو مھوئے یوسفؑ کے وطن (مصر) می اختیار دید، سے تِمی کھید ہُم نیموؤسأدو دھرے، مھو کیس کے نیموؤسأدو رحمت آوادی، آں مھو نیگی کوؤ والا سی‌اجر ضائع نو کودی۔
آں آخرت سی اجر تھأ خلگا سی کأ غورا تُھو کی یأ ایمان آنوُ آں تقوی اختیار کی۔
(کے یأ قحط ہُو دا) آں یوسفؑ سی بَھئی اَئی آں اِسی کأشکے حاضر ہوئی، اِی (یوسفؑ) تھأ پأنِئی آں تھیئے ایس نہ پأن بَھوؤ۔
آں کے یأ یوسفؑ تِھین سامان تِھین کأ تِیا کی دَ تھأئے بنُو تونُو بوب سی دیشا ( پیڙأن سی) بھا ہُم مھی کأشکے آنا، کئی تھوئے پتا نی چھی کے آ پورا پورا ناپ کیدے دیدوُ آں غورا میلأݜ توپ کوؤ والا ہم تُھو۔
کہ تھوئے تیس مھی کأشکے نہ اَنوؤ تھوئے مھی کی غلہ میلاؤ نو ہونین، آں نأئی تھو بھی مھی کأشکے یا۔
سے بَندی مھوئے اِسی بارہ می تِسی بوب سید بات کونین، آں مھوئے (اے کام) خامخا کونین۔
آں یوسفؑ تُنو نوکرائے بنوُ ہین مال ہین سامان می (بیرید) تھا، یرأ سے تنو شیرائے واپس گئیو تھأئے معلوم ہوئے (مُھن پیس ہُم واپس میلاؤ ہوئی)، ہوبھادُو سے بھی واپس یَن۔
دَ کے یأ سے تُنو بوب سی کأش کے واپس اَوَئی دَ بَندی اے باوا مھوئے ما بھی سی کأ غلہ کھما گا، دَ تُو مھوسید مُھن بھا پے بَنے مھو غلہ بھی أنی، آں بے شک مھوئے اِسی خیال‌کونین۔
(یعقوبؑ) بنُو کئی آ اِسی‌بارہ‌ می تھوزید مھامُو یقین کیئی کھامُو یأ مأ اِس ما مُوش اِسی بھئی (یوسفؑ) سی بارہ می کیشُو؟ بس اللہ تعالٰی غورا حفاظت کوؤ والا تُھو آں سے ٹولا ما زیات مہربان تُھو۔
آں کے یأ تھیئے تُنو سامان کولاؤ کیدا ڈیڈ کہ تِھین مال ہُم مِیئے واپس کوا گیئی، بَندی اے باوا (اِیزما زیات) مھوئے کا پکار تُھو (بُودا) مُھن مال ہُم مھوئے واپس کوا گأ، آں مھوئے تُنو شِیر والا سی کأ دُوئی ہُم غلہ آنین، آں تُنو بَھئی سی خیال‌ ہُم ساتنین، آں اے اُخ سی غلہ زیات ہُم آننین، می اے اُخ سی غلہ آسانی دے میلاؤ ہونین۔
بنو (یعقوبؑ): "مأ ایس (بنیامن) یئد ہُم تھوسید نہ پے نین کھیدیخانہ پورے تھوئے مھیسید اللہ سی نام سی پخا وعدہ نہ کیژیو، کہ تھوئے ایس مھی کأشکے خامخا واپس‌ اَنین، بے میزا کہ تھو (ٹول) کںئید گݜا گئیو"۔ بھی کے یأ تھیئے تیسکے تنو پوخ وعدہ دیدتا (یعقوبؑ) بنو: "کا مھو بندی دا اللہ اِسی ضمانتی تُھو"۔
آں تی بنُو اے مھی بچئ ہانا! تھو (مصر سی) خار می اے درواز تے داخل نہ ہوا بلکہ جدا جدا دروازیدے لَھنگا، آ تھو اللہ تعالٰی سی کی فیصلہ ما ہم بچ نوکو بھادو، حکم اللہ تعالٰی ما علاوہ دوئی یِسی ہُم نہ چَلَدو، اَنئی تیزید مأ بھروسہ‌کیدو آں توکل کوؤ والائے تیزید بھروسہ کوؤ پکار تُھو۔
آں کے یأ سے لھنگئ (مصر سی خار کے) کھأکأ تھأئے تِھین بوپ حکم کیشو، آں اللہ ‌سی مقابلہ می تِھین کی تدبیر ہُم کام نہ أپ، اَسے یعقوبؑ سی حی می اے خواہش‌ أشی کا یأ تی پُورا کی، آں بے شک سے صاحب علم تُھو کا مھوئے تیسکے ڇِھیڙادوشُو، اَسے اکثر خلک نہ جندی۔
آں کے یأ سے یوسفؑ سی کأشکے اَئی دہ تی تُنو (ساگ) بَھئی (بنیامن) گے تُنو کأن خاص پوت دیت، آں تیسکے بنُو ‌آ چھی (ہژژیل) بھا تُھو، آں تُو تھأ بأدا زید خپا نہ ہو کا یأ أ (پیڙأن سی جَدک) کودی۔
بھی کے یأ (یوسفؑ) تھأئے تِھین سامان تیا کی دَ تُنو بھئی (بنیامن) سی سامان می پیالہ تھات، بھی اے آواز کوؤ والا آواز کی "اے قافلہ‌ والا‌ ہانا تھو دا چو تھی"۔
تھیئے تھأئے پدئیے بُودے توَس کی "تُھن کا شیئی ہڙادتُو؟"
تھیئے بنُو مھوئے باچا سی (اُو پو سی) بھان میلاؤ نُو ہودُو، آں کی تیس آنوؤ (تیسکے انعام می) اے اُخ غلہ سی دیا بژنین، آں تِسی آ ضامن تُھو۔
سے بندی اللہ سی قسم! تھو غورا شیت تھی مھو مِسی کأ نہ اَئیدی کہ تُھن وطن می فساد کیئی آں مھو چو نی تھی۔
دَ سے بندی کہ تھو لوال نیگھأد (چے ثابت ہی) بھی تِسی کأ کا سزا ہونین۔
تھیئے بَنو کسی ہُم سامان ما سے بھان نِگھادو اَںئی تے ماݜ تِسی بَدل می ہِسار کوا بژے، آں مھو ہُم ظلم کوؤ والائے اَںئی ہامُو سزا دیدی۔
تُنو بھئی سی بوژی ما موش ہین بوژی آ ما (تلاشی) شروع کی بھی تے بھان تُنو بھئی سی بوژی ما نِگھلُو، اَںئی ہاموڑ مھوئے یوسفؑ سی کأ تدبیر کی (مِسی کأ) باچا سی قانون سی می سے تُنو بھا تُنو کأن ہِسار نو کو بھوؤدود اَسے کہ اللہ ئے منظور ہوؤ، مھو کِسی ہم نِموؤسأدو درجہ اُچات کودی آں ہر علم والا سی ڙیت اے گھن علم والا تُھو۔
بھئی بَنوُ کہ اِی (بنیامن) چے کِژی و مِما مُوش اِسی بھئیے (یوسفؑ) ہُم چے کِیشی، یوسفؑ مے بات تُنو حی مے تھیئی آں تھأزید ایس اَخکارہ نی کی آں (تُنو حی می) بَندوُ تھو چیر لاݜ خلک تِھی آں کا ہُم تھو بَندی دَ اللہ تعالٰی ایزا غورا شیت تُھو۔
تھیئے بنُو اے عزیز! بے شک اِسی باب چیر ڈَھگ تُھو، اِسی بَدل می مھوئے ما ایک ہِسار کو، مھو پشَدی یأ تو چیر نیک ماݜ تُھو۔
یوسفؑ بَنوُ اللہ ‌سی پناہ! کہ ‌مھوئے تِما ‌علاوہ یِس کیش تنو شیئی (بھان) پادو دُوئی کیس گیݜی، بھی دا یقینًا مھوئے ظالم ہونین۔
بھی کے یأ ہے اِسما بالکل مایوس ہُوئی، بھی مشورہ سی کأ امن گے بھیٹ، تھیے ما گھن (بھا) بندُو کئی تھوئے پتہ نی چھی کہ تُھن بوب تھوئے ما اللہ سی پوخ وعدہ گِھن چی، آں اِما مُوش تھوئے یوسفؑ سی بارہ می لاݜ کیدو، دَ آ دا ییت ہُم مھیدا نہ بژَدوُ کھیدے خانہ پورے مھی باب مھیئے اجازت نو دو یا اللہ مھی کأ کآں فیصلہ کوئے‌، آں سے بُوڑے ما غورا فیصلہ کوؤ والا تُھو۔
تھو تُنو بوب سی کأشکے بَژا آں تیس کے بنا کے اے باوا! چھی پوئے چے کِیژی، آں مھوئے تُنو علم سی مطابق گواہی دیدچی، آں مھوئے غیب سی کی پتا نی چھی۔
آں کامے گام می مھو دھریئشی تھیئے ما تھو توَس کوا، آں تے قافلہ ما ہُم تھو توَس کوا کِمی مھو واپس اَئیدی، آں بیشکہ مھو سأس بَن تھی۔
(یعقوبؑ) بَنو: "نأ بلکہ تھوئے اَمَنا حی می کآں بات سوأدچی، بس صوو غورہ تُھو۔ ہو بھادو اللہ تھأ ٹول مھی کأشکے اَنے، بے شک سے جنوُ والا آں حکمت والا تُھو"۔
آں (یعقوبؑ) تھأئے پِیٹھ کی، آں بنُو ہائے افسوس یوسفؑ زید، آں تِسی أݜی غم سی وجہ دے اُژیلی ہوئی، آں سے چَیرگن خپا آشو۔
جدگے بنوُ اللہ سی قسم، تأ دا ہمیشہ یوسفؑ یاد کوا یینین، مھیدیگا پورے یأ تأ سخت بیمار ہونین یا سا دینین۔
تی بنوُ آ دا صرف تُنو اللہ ‌سی مُوشکے تُنو پریشانی آں تُنو غم بیان کودو، آں مھیئے اللہ تعالٰی سی دِشا سے بأت معلوم تھی یأ تھوئے نی تھی۔
(اے مھی) بچئی ہنا! بژا آں بیشتے یوسفؑ آں تِسی َبھئی سی پتا گھڑا، آں اللہ تعالٰی سی رحمت ما نااُمید نہ ہوا، بے شک اللہ تعالٰی سی رحمت ما کأفرا ما علاوہ دوئی یام مایوس نو ہودوُ۔
بھی کے یأ سے تِسی کأشکے اَئی دَ بَندی اے عزیز (باچا) مھوئے آں مُھن شِیر والائے چَیر تکلیف میلاؤ ہُودو، آں مھوئے چَیر اَشوڑ پیس گِھندے اَئیدی، بس تو مھوئے پورا غلہ دے آں مھو زید صدقہ کو، بے شک اللہ تعالٰی صدقہ کوؤ والائے بدلہ دیدوُ۔
(یوسفؑ توَس کی) آیا تھوئے پتہ چھی کہ جہالت سی وَخ می تھوئے یوسفؑ آں تِسی بھئ سید کا سلوک کِشو؟
تھیئے بنُو کئی تُو یوسف تُھو کو؟ تی بنُو ہاں آ (سے) یوسفؑ تُھو، آں أئی مھی بھا تُھو، بے شک اللہ تعالٰی مھوزید احسان کیدو، یقینًا کامے ماݜ اللہ ما بھیدو آں صوو کودو، بے شک اللہ تعالٰی نیگی کوؤ والا سی اَجر‌ضائع نہ کودُو۔
تھیئے بنُو اللہ سی‌قسم، اللہ تھیئے مھو زید فضیلت دیدچی آں بیشک مھو غلطی کوؤ والا اَشئ۔
ہوسفؑ بنُو آش تھو زید کی الزام نو تُھو اللہ تعالٰی تھو معاف کوئے آں سے بوڑا ما چیر مہربان تُھو۔
تھو مھی مے پأن گِھندے بژا، ایس مھی بوپ سی بوت زید تھلا تیسی أݜیئے صاپ ہونین آں تُنو پُورا کلاݜ گھیندے مھی کأشکے یا۔
آں کے یے قافلہ (مصر ما) روان ہودا تِھین بوپ بنُو کہ تھو مھیئے میس نہ بَندی کہ آ گڑبڑ ہودو مھیئے دا یوسفؑ سی مھاگ ییژی۔
تھیئے بنُو اللہ سی قسم بے شک تُو تُنو پُران وہم می تُھو۔
بھی کے یأ زیرے دیوؤ والا آپ آں تی تے پأن تِسی بوت زید تھیلی دَ تِسی أݜی صاب ہُوئی، دَ بندو کئی مأ تھوئے نہ بنوشُو بے شک مھیئے اللہ تعالٰی سی دِشا سے بأت معلوم تھی کامیک یأ تھوئے معلوم نی تھی۔
تھیئے (جواب می) بنُو "اے باوا! مُھن کأ مُھن گناہ آسی معافی نیِما؛ بے شکہ مھو گناہگا اَشیئ"۔
(یعقوبؑ بنُو) ما چیر جَل تُھن کأ تُنو رب ما تُھن مغفرت نِمانین بے شک سے چیر بوگوشو والا چیر مہربان تُھو۔
کے یأ سے ٹول یوسفؑ سی کأشکے اَئی دَ یوسفؑ تُنو ییئ و بوپ کے تُنو کأن پوت دید، آں بنُو تھو ٹول مصر می داخل ہوا، کہ اللہ تعالٰی نِمادو سکون دے ہوا۔
آں تی تُنو ییئ و باپ تخت زید بَھیأت آں ٹول تِسی مُشکے سِجدہ می گئی، آں یوسفؑ بنُو اے مھی باوا أ مھی نِن سی معنا چھی کامیک‌ یأ مأ مُوش ڈیڈیشی، تیس مھی پروردگار سأس کی، آں بے شک تی مھیزید احسان کی یأ مھأ قید ما نِگھالُو آں تھو ٹول گام ما مھیت کے اَنیئ حالانکہ اِما مُوش شیطان مھأ و مھی بھیا سی حی می فساد تھلُوشُو، بے شک مھی رب شِژو طریقہ دے ہرے کام کودو کا یأ سے کوؤ نیموؤسأدو، بے شک اَںئی سے تُھو کہ تِسی علم ہُم پورا تُھو آں حِکمت ہُم پورا چھی۔
اے مھی پروردگار تأ مھیئے حکومت ہُم دید آں نِن سی معنا سی علم ہُم دید، اے دھیرینو آسمانا سی پیدا کوؤ والا اَںئی تُو دونیئی و آخرت می مھی کَم سوؤ والا تُھو، مھأ دونیئی ما فرمانبرداری سی حالت می بھا کو آں آخرت مے تُنو نیک خلگا سی صف مے شامل کو۔
(اے پیغمبرؐ) أ غیب سی بأت تھی یأ چھی دِش کے مھو وحی کودی، آں تُو تے وخا تھین کأن موجود نہ اَشو کے یأ سے (یوسف سی بَھئی) اتفاق تے سازش کوؤدود۔
آں کو تُو چیر ہُم خوشادوُو اکثر خلک ایمان آنو والا نی تھی۔
آں تُو ایزید (تبلیغ زید) ہیئے ما کی اجر نی نیمادوُ، ہے دا ٹول جہانا سی کأ نصیحت چھی۔
آں دھیرین و آسمان می چیرگن نَخ تھی کہ سے تھأزید لھنگدی خو سے تھئیے ما پِڑ کودی۔
آں تھیئے ما اکثر خلک اللہ تعالٰی زید ایمان نہ آندی بلکہ سے مشرک ہو دی۔
آیا خلک مے بأت ما نے بھئیدی کہ ہأزید اللہ تعالٰی سی عذاب سی مھال اے افت یو کہ ہے ٹولا زید خور ہوئے یا اچانک ہأزید قیامت یو یأ ہے ہاڈو شید ہُم نہ ہون۔
(اے پیغمبرؐ) تُو بن! أ مھی پان چھی، آ پورا علم سمانے اللہ تعالٰی سی دِشکے نیمادو، آں کآم یأ مھی پیروی کودی (سے ہُم نیمادی)، آں اللہ تعالٰی پاک تُھو آں آ مشرکے ما نو تُھو۔
آں مھوئے تھأما مُوش (چیر) گام آ سی خلگائے ماݜ آ ما علاوہ دُوئی ییس نہ پیؤدوُ، کِسی دِشکے یأ مھو وحی پیوؤدود؛ کئی ہے خلک دُونیئی می نہ گئیدی کہ کآم خلک ہیئے ما مُوش لھنگئیدی دا تھین کا انجام ہُو؟ آں البتہ آخرت سی شیر تھأ خلگا سی کأ غورا چھی کی یأ تقوی اختیار کی؛ دَ کئی تھو نہ جَندی؟
مے حدا پورے کہ کے یأ پیغمبرؐ خلگے ما مایوس ہوئی آں (کأفر) مے سوچ کوؤسأت کہ ہأسید لوو بنا گا دَ تھائے (پیغمبرائے) مُھن مدد اَوئی، آں کیس یأ مھو نیموؤدود سے بچ کوا گئی آں مُجرِمے ما مُھن عذاب یئیت ہم دھوگو نو ہودوُ۔
بے شک ہأ خلگا سی حالادا می ہُوشا آ سی کأ چیر عبرت چھی، أ ( قرآن) کی اَمَنا کوئیل بأت نی تھی بلکہ تھأ پیغاما سی تصدیق تُھو کامیک اِزما مُوش (آسمانی کتابا می لِگیل) تھی آں ہر بأت سی تفصیل بیان تُھو، آں ہدایت و رحمت چھی تھأ خلگا سی کأ کآم یأ ایمان آندی۔
الف لام میم را۔ أ کتاب (قرآن) سی آیت تھی، آں کائی چھی رَب سی دِشا تھیزید نازل کوا گودُو دا سے سأس تُھو، اَسے اکثر خلک ایمان نہ اَندی۔
اللہ سے ذات تُھو کی یأ آسمان بے تُھنا اِیڑی کی کیس یأ تھو پَشدی، بھی عرش زید قائم ہُو، آں سی و یُن ہُم کَم زید ݜژأت، آں ہر ایک تنُو مقررہ وَخ زید روان تُھو، اَںئی سے ہر بأت سی انتظام کودُو، سے تنُو آیت کولاؤ کولاؤ کیدے بیان کودُو مِسی کأ تھو تنُو رَب سی مُوشکے حاضر ہوؤ زید یقین کوا۔
آں اللہ سے ذات تُھو کی یأ دھیرین خور کی آں اِیمی کھن و نھیت سیوأت، آں ایمی ہر قسم سی میوہ آ سی جوڑا پیدا کی، آں سے ڙات دی سی لوشے دے بُرادُو، یقینًا ہأ بأدا می پِھگر کوؤ والا سی کأ نَخ تھی۔
آں دھیرین می زأن زأنی ٹوٹا تھی یأ ایک دُوئی سیت مِلیل تھی، آں دَݜ آ سی باغ آں بوئیل بُھوم تھی، آں خُورما آ سی تھام تھی، یام دُوگُن پھانگ والا آں یام ایگُن پھأنگ والا، (حالانکہ) اُو ٹولائے اے شان سی میلاؤ ہودُو، بھی ہُم مھوئے ایک دوِئی ما خوراک می غورا پیدا کیدی، بےشک مھأ ٹول بأدا می نَخ تھی تھأ خلگا سی کأ یأ عقل ما کام گھیندی۔
آں کو تُو تعجب کودُوو اصل تعجب تا ہین أ بات چھی کہ یأ مھو مئیدے سُوم ہُوئیو اَیا مھوئے اول ما دُوآر پیدا ہونین؟ ہے سے خلک تھی یأ تنُو رَب ما مُنکر تھی، ہے سے خلک تھی کہ ہین چونجو وا طوق لھمیل ہونین، اںئی ہے خلک جہنمی تھی، ہیئے ایمی مُوآ ہونین۔
آں ہے خلک غوراتوب ما مُوش تھأ ما لاݜ (عذاب) نِیمادی، حالانکہ اِسما مُوش عذاب اَئیدی، آں بےشک چھی رَب خلگا سی گناہ آ سی باوجود تھأ بوگوشو والا تُھو، آں بےشک چھی رَب سخت سزا دیؤ والا تُھو۔
آں ہے کأفر خلک بندی تِسی رَب سی دِشا ایزید کی نَخ کئی نازل نہ ہُو؟ آں (اے پیغمبرؐ) تُو دَ صرف (لاݜ انجامے ما) بھیؤ والا تُھو، آں ہر قوم سی کأ اے گَھن ہودُو۔
صرف اللہ ئے پتا چھی کہ اے جوَئی کا تنُو ڈھے می گھیندے گیژی، آں کا یأ (جوئی سی) رحم می کمی زیاتئی ہوژی، آں ہر شیئی تِسی نظر می اے خاص مقدار می تُھو۔
سے ہر غیب آں اخکارہ شیئی آ سی بارہ می غورا علم لَرو والا تُھو، بوڑے ما اُوچات آں گھن مرتبہ والا تُھو۔
تِسی کأ اے شان سی تُھو کہ تھوئے ما یام بأت بُرے یا اخکارہ کوئے، کہ یام ڙأت کے بیرت ہوئے کو دیئے اخکارہ گئے۔
ہر ایک سی کأ وأر وأرے دے څوگیئی کوؤ والا (مُلیکہ) مقرر تھی مُشکے ہُم آں پأشکے ہُم، کآم یأ اللہ سی حکم دے اِسی حفاظت کودی، یقینًا اللہ اے قوم سی حالت بدل نو کودُو کھدیخانا پورے تی (قوم) تنُو حالت أمیدے بدَل نی کیژیو، آں کے ہُم اللہ اے قوم زید مصیبت (اَنو) سی ارادہ کیوو یام ہُم تیس واپس نو کو بھادُو، آں یام اللہ ما بغیر ہین مدد نہ کو بھادُو۔
سے اللہ تُھو کآم یأ تھوئے بھیت آں طم سی کأ آسمان سی بریخنا پَشادُو، آں (اُو ما ڈک) اُگو اُگو ہاگا پیدا کودُو۔
آں اَگھا سی گڑزا آں مُلیکہ تِسی بھیت تے تِسی صفت آں پاکی بیان کودی، آں اَںئی سے تَندر پیدُو آں کیزید یأ نِمادُوو (تَندر) والدُو آں (تُو بُو کہ) ہے اللہ سی بارہ می لات کودی، آں اللہ چیر گھین طاقت والا ذات تُھو۔
اَںئی تیسکے ہاگوؤ حق تُھو، آں کآم یأ تِما علاوہ دُوئی یسکے ہاگادی سے ہین کی ہُم نہ بُھوژدی، اَںئی تے ماݜ سی شانے کآم یأ تنُو دُھوںئی ہات اُو سی دِشکے خور کوئے کہ تِسی أںئے اَوے حالانکہ سے تیسکے یئد ہُم نہ آوودُو، آں کأفر آ سی دعا ہاَںئیمو بے اثرا ضائع چھی۔
آں کآم یأ آسمان آ می آں دھیرین می تھی، خوشادی کو نہ خوشادیو، صرف اللہ یے سِجدہ کودی آں ہین چیژول ہُم، ڙات می ہُم آں نیاشاما ہُم۔
(اے نبیؐ!) توَس کو کہ آسمانا سی آں دھیرین سی رَب کآم تُھو؟ تُو بَن کہ صرف اللہ، ہأئے بَن کہ آیا تھوئے تِما علاوہ دأل مھال مدد کوؤ والا گأدتی کے سے تنُو اَمن سی کأ ہُم نأ فائدہ سی آں ناَںئی نقصان سی وَس لَردی؟ ہأئے بَن کہ آیا اَن آں پَشو والا یئت اے شان سی ہو بھادی؟ یا لوش آں أنچیک اے شان سی ہو بھادی؟ آیا سے خلک اللہ سیت کآم یأ شریک سَوادی تھیئے ہُم کی مخلوق اللہ سی مخلوق سی شانے سیوأت چی کہ تِسی وجہ دے پیدائش سی بارہ می کی شک پیدا ہی؟ ہأئے بَن کہ: اللہ ہر شیئی سی خالق تُھو، آں سے ایک تُھو آں ٹولا زید غالب تُھو۔
تی آسمان ما اُو مُوژاد، تیدے کھأر تنُو مقدار سی مطابق ڈلوسأد، بھی یأ کھڙا سی ڙید پھین بھا ہی، مھامُو پھین تھأ شیئی آ سی گرم کوؤیدے ہُم بھا ہوژی کے یأ زیور آں بھانا سی سَوؤ سی کأ آنگا زید دھژؤسأدو، اَںئی ہاموڑ اللہ حق آں باطل سی مثال بیان کودُو، بھی پھین ہأئیمو (گھوش سی شانے) ضائع ہوژی اَسے کا شیئی یأ خلگائے فائدہ دیدُوو سے دُونیئی می باقی دَھردُو، اللہ اَںئی ہال مثال بیان کودُو۔
کی یأ تنُو پروردگار سی بات بیت و تِھن کأ غورا بدَل چھی، آں کی یأ تِسی بات نی بِت کو سے تھأ ٹول شی آ سی مالک ہُم ہوئے کا یأ دھیرین می تھی آں تھأزید ہیدیک دوئی ہُم ہوئن آں سے تنُو فدیہ می دیؤ گے تیا ہوئن، تِھین کأ بدترین قسم سی عذاب ہونین، آ تِھین ٹھکانہ دیزوخ چھی آں سے چیر لاݜ پوت تُھو۔
اَیا سے ماݜ کیس کے یأ أ پتہ چھی کہ کا یأ تھیزید چھی خُدئی سی دِشا نازل ہُودو دا بالکل حق تُھو تے ماݜ سی شانے تُھو کآم یأ اَن تُھو؟ بے شک عقل والا (ہیئے شیئیے ما) جَندی۔
سے خلک کآم یأ اللہ زید کویل وعدہ پُورا کودی آں وعدہ نہ پَھرادی۔
آں سے (تھأ رشتہ) ساتدی کھین ساتُو سی یأ اللہ حُکم کیدُو، آں تنُو خُدئی ما بھیدی، آں سخت حساب کتاب (سی توَس)( ما بھیدی۔
آں کآم خلک یأ اللہ سی رضا سی کأ صوو کودی، آں نماز قائم کودی، آں کا یأ مھوئے تھأئے دیدتُو تِما (نیک کم آ می) بیریت آں ڈاگا خرچ کودی، آں کام یأ نیگیئے دے گناہ ہاژادی، ہے اَںئی سے خلک تھی تھین کأ آخرت می دھرُو سی پوت تُھو ۔
(یعنی) ہمیشہ ہمیشہ دھرُو سی باغ ہونین، تِمی تھیئے أمینے آں تِھین بوپ داد آں تِھین ڇھی آں تِھین اولاد می کآم یأ نیک تھی ٹولے داخل ہونین، آں مُلیگے ہر درواز ما تھین کأن گے ینین،
(آں بننین کہ) تھو زید سلامتی ہوئے مِسی کأ یرأ تھوئے صوو کیدُو، آں آخرت سی شیر کھیدیک شِیژے شیر چھی۔
آں سے خلک کآم یأ اللہ زید پخہ وعدہ کیدے پَھرادی آں کامے رشتہ آ سی اللہ ساتُو سی حکم کِشو تھأ پَھرادی آں دھیرین زید فساد خور کودی تھأ خلگا سی کأ لعنت چھی آں تھأ خلگا سی انجام چیر لاݜ تُھو۔
اللہ کیس کے یأ نیمؤسأدو رزق سیوا کودُو آں کیس کے یأ نیمؤسأدو کَم کودُو، آں خلک تا دُونیئی سی زندگی زید خوشال تھی آں دُونیئی سی زندگی آخرت سی مقابلہ می چیر معمولی سودا تُھو۔
آں کأفر بنَدی تیزید تِسی رَب سی دِشا کی معجزہ کئی نازل نو ہُو؟ ہأئے بَن کہ بے شک اللہ کیس نیمؤسأدو گمراہ کودُو آں تنُو دِش کے اَںئی تیس کے پان پَشادُو کآم یأ (توبہ کیدے) تِسی دِش کے واپس ہودُو۔
أ سے خلک تھی کآم یأ ایمان اَندی آں اللہ سی ذکر زید مطمئن ہودی، یاد سات! اللہ سی یاد تے حی آ ئے اطمنان ہودو۔
سے خلک یأ ایمان اَندی آں نیک کَم کودی تھین کأ خوشألی چھی آں شیژو دھرُو سی پوت تُھو۔
اَںئی ہاموڑ (اے پیغمبرؐ!) مھوئے تھأ مھالے اُمت می پیؤدُو کہ تِما ما مُوش ہُم چیر اُمت لھنگئیدی، کہ تو ہأئے(کتاب) بُھویا کا یأ مھوئے تھیزید نازل کیدُو، آں ہین حال أ چھی کہ ہے رحمان سی انکار کودی، ہأئے بَن: کہ اَںئی سے مھی رَب تُھو تِما علاوہ یام ہُم معبود نُو تُھو، اَںئی تیزید مأ توکل کیدو آں اَںئی تِسی دِشکے بیُو تُھو۔
آں کو یئت مھال اے قرآن ہُوشوو کہ تیدے کھن تیلَندے، یا دھیرین پَھلیدے یا تِسی وجہ دے مئیل بأت کوئندے (بھی ہُم ہیئے ایمان نہ اَننین دے) بلکہ ٹول کَم اللہ سی اختیار می تھی، اَیا سے خلک کھیئے یأ ایمان اَنودُو نہ جَنَدی یرأ کہ اللہ نیمؤدُودو ٹول خلک سیدھا پَن دے اَننین دے؟ آں کآم خلک یأ کأفر تھی تھین تنُو عملا سی وجہ دے تھأزید کآں نہ کآں مصیبت ییایدی یأ تھین شیرا سی کأن نازل ہوا یدی تھیدیخانا پورے کہ اللہ سی وعدہ پورا ہوئے، یاد سات کہ اللہ یئت ہُم وعدہ خلافی نہ کودُو۔
یقیناً تھأ ما مُوش ہُم رسول آ سی پِشاڑے کوا گأشی، بھی مأ کأفرائے مہلت دید، بھی مأ تھأ گأت، بھی (تُو بُو دا) مھی سزا کھیدیک سخت أشی۔
بھی اَیا کامے اللہ یأ ہر ہر ماݜ سی ہر ہر عمل سی نگران تُھو آں (دھوئم دِشکے) تھیئے اللہ سیت شریک گأدتی؟ ہأئے بَن کہ تِھین نام دا بَنا دا، اَیا تھو (اللہ ئے) تے شیئی سی خبر دیدی کا یأ دونیئی می تِسی علم می نُو تُھو؟ یا ہأئیمو أں دے ہامُوڑ بَندی؟ بلکہ کامے خلگے یأ کفر کی تِھین کأ تِھین مُکر آں دوکا شِیژیئی کوا گأ، آں سے (ہدایت سی) پَن ما منع کوا گئی، آں کیس یأ اللہ گمراہ کیو تیسکے یام ہُم ہدایت دیؤ والا نہ تُھو۔
تھین کأ دُونیئی سی زندگی می عذاب تُھو، آں آخرت سی عذاب تا چیرگن سخت تُھو، آں یام ہُم تھأ اللہ (سی عذاب) ما بچ کوؤ والا نُو تُھو۔
کامے جنت سی یأ ہرہیزگارا سید وعدہ کوا گیشی تِسی مثال أ تُھو کہ تِسی ٹین کان بژدی، تِسی میوہ آں چیژول ہمیشہ سی کأ ہونین، اَںئی ہے پرہیزگارا سی انجام تُھو، آں کأفر آ سی انجام (دیزوخ سی) آنگا تُھو۔
آں سے خلک کیسکے یأ مھوئے کتاب دیدتُو سے تھیزید نازل ہویل (کتاب) زید خوشال ہودی، آں ڈلا آ می زینی خلک اِسی یام (بأدے) ما انکار کودی، تُو بَن کہ "مھیئے دا صرف أ حکم ہودُو کہ آ اللہ سی عبادت کیئی، آں تیزید ییس شریک نہ کیئی، آ اَںئی تِسی دِشکے (تھو) نیمادُو، آں تِسی دِشکے مھیئے واپس ہوؤ تُھو۔
آں اَںئی ہامُوڑ مھوئے میس (قرآن) اے حکم عربی می نازل کیدُو، آں کو تُو ہین خواہش آ زید چلُوو باوجود مِسی کہ تھیئے علم ہُم آپ تُو تَھلا بھی اللہ سی مقابلہ می چھی نأ یی مدد کوؤ والا ہونین نأ یی بچ کوؤ والا۔
بے شک تھأما مُوش مھوئے چیر رسول پیئی، آں مھوئے تھأئے ڇھی آں اولاد ہُم دید، آں اے رسول گے ہُم اختیار نہ اَشو کہ سے اللہ سی اجازت ما بغیر کی نخ اَنے، ہر کم سی وَخ لِیگیل تُھو۔
آں اللہ (کامے حُکم یأ نیمؤسأدو) ختم کودُو آں کا یأ نیمؤسأدو ساتدُو، آں اَںئی تیس کیش اصل کتاب تُھو۔
آں کو مھو دھأک عذاب کِسی یأ ہأ خلگا سیت وعدہ چھی تھیئے پشَئ یا تھیئے مئیک دَئی چھی کام اَوؤ تُھو آں مُھن کام حساب سی گھینو تُھو۔
اَیا ہے نہ پَشدی کہ مھو دھیرین اِسی ڈھأرے ما کم کووا ییدی؟ اللہ حُکم کودُو یام ہُم تِسی حُکم لار تھلُو والا نُو تُھو، آں سے چیر شیرتے حساب گھینو والا تُھو۔
آں چیر خلگے ہیئے ما مُوش ہُم تدبیر کیدی، خو ٹول تدبیرا سی مالک صرف اللہ تُھو اَںئی تیس کے پتہ چھی کہ کآم کژَل کودُو، آں کأفر آ ئے چیر شیرتے پتہ گھڑنین کہ آخرت سی شیر کِسی کأ چھی۔
آں کأفر بنَدی کہ تُو رسول نُو تُھو! ہأئے بَن کہ مھأ و تُھن مِیئے اللہ گواہ پُورا تُھو، آں سے (ماݜ گواہ تُھو) کیس کیش (آسمانی) کتاب سی علم تُھو۔
الف لام را، أ کتاب تُھو کامیک یأ مھوئے تھیزیت نازل کِیدو، مِسی کأ تُو خلک (کفر سی) أنچگے ما نِگھیلدے (ایمان سی) لوش کے آن، تِھین خُدئی سی حُکم دے، تے خُدئی سی پَن‌ سی دِشکے کآم یأ غالب آں تعریفآ سی لائق تُھو۔
سے اللہ یأ آسمان آں دھیرینا سی ٹول مخلوق سی مالک تُھو، آں کأفرآ سی کأ سخت عذاب سی برَبادی چھی۔
یعنی سے خلک کآم یأ آخرت سی مقابلہ می دوُنیئی سی زندگی خوشادی، آں (دیأل) خلک اللہ سی پَن ما منع کودی آں اِیمی عیب بیرَڑدی، ہے خلک گمراہی می چیر دھوئے اَوئیدی۔
آں مھوئے ہرے رسول تِھین تُنو قوم سی جِب می پیوؤ، بَنے تِھین کأ احکام کولاؤ کولاؤ بیان کوئے، آں بھی اللہ کیس یأ نِیموؤسأدو گمراہ کودوُ آں کیس کے نیموؤسأدو ہدایت دیدو، آں سے چیر زبردست آں حِکمت والا تُھو۔
آں مھوئے موسیؑ تُنو نَخ ‌دیدے مِسی کأ پیوؤ کہ تُنو قوم (جہالت سی) أنچیگے ما نِگھیلدے (علم سی) لوش کے آنے، آں تھأئے اللہ سی (عبرتناک) دی یاد کو، یقینًا مھأ بأدا می ہر صوو کوؤ والا سی آں شُکر‌کوؤ والا ‌سی کأ نَخ تھی۔
آں کے یأ موسٰیؑ تُنو قوم گے بنوُ کہ اللہ ‌سی تھأ مہربانی یاد کوا کامیک یأ تی تھوزیت کِشی، کے یأ تی تھو فرعون سی قوم ما لھاسِئی، یأ سے تھوئے چیر سخت تکلیف دیؤدُود، آں تُھن جَدک حلال کوؤدود آں تُھن سیرأن جین چھوؤدود، آں اِیمی تُھن رَب سی دِشا گھین اَزمیخ أشی۔
آں (یاد کوا) یأ تُھن پروردگار تھوئے بنو "کو تھو (مھی) شُکر نِگھلوسأدو مأ خامخا تھوئے دُوئی ہُم نعمت دینین، آں کو تھو ناشکری کوؤسأدو بھی بے شک مھی عذاب چیر سخت تُھو"۔
آں موسٰیؑ بنو: "کو تھو ناشکری کوؤسأدو، تھو آں سے بُٹ (ہُم) یأ دھرینے تِھیوو (جنا کہ) دَ بے شکہ اللہ بے پرواہ آں ٹول صفت آ سی قابل تُھو"۔
کئی تھوئے تھأ خلگا سی بأت نہ اَوئیدی کآم یأ تھوئے ما مُوش اَشیئ؟ نوح ؑ، عاد و ثمود سی قوم، آں سے خلک کام یأ تھیئے ما پأش اَئیشی؟ تھأ بے اللہ آ دوئی یام نہ پأنودُود، تِھین کأشکے تِھین رسول معجزا گِھندے اَئی، دَ تھیئے تُنو ہاتھ ہین أں می تھوئی (کہ غلے ‌ہوا) آں بندی کائی تھوئے دیدے پیا گودوُ مھو تیس نہ مَندی، آں کا شئی سی دِش کے تھو مھو ہگادی تِمی مھوئے چیر گھین شک چھی۔
تھین پیغمبرے تھأئے بنُو: اَیا تھوئے اللہ سی بارا می شک چھی کی یأ آسمانو دھیرین پیدا کِیدی؟ سے تھو مِسی کأ ہگادو یرأ تُھن گناہ معاف کوے، آں اے خاص وَخا پورے تھوئے مہلت دو، تھیئے جواب می بنُو تُو دا مُھن شانے اے ماݜ تُھو، تُو میس نِمادُو کہ مھو تِھین (یعنی بُھودا سی) عبادت ما منع ہیئی کِھین یأ مُھن بوب دادے عبادت کِشی؟ تَھلا مھوئے اے اَخکارہ دلیل ‌آن۔
تھین پیغمبرے تھأئے بنُو "بے شک مھو دا صرف تُھن شانے انسان تھی اَسے اللہ تُنو بندآ می کیزیت ہُم نِموؤسأدو احسان کودوُ، آں أ مُھن اختیار می نُو تُھو مھو تُھن مُشکے اللہ سی حُکم ما بغیر کی معجزہ أنی، آں مومنائے پکار تُھو صرف اللہ زیت بھروسہ کوئن"۔
آں مھو کئی اللہ زیت بھروسہ نہ کیئی، تی مھوئے مُھن دین سی طریقہ پَشأت، آں تھو مھوئے کامے تکلیف دیدی دہ مھوئے تیزیت خامخا صوو کونین، آں بھروسہ کوؤ والائے پکار تُھو اللہ زیت بھروسہ کوئن۔
آں کامے خلگے یأ کفر اختیار کِشوُ تھیئے تُنو رسولائے بنو: "مھوئے تھو خامخا تُنو وطن ما نِگھالنین، یأئی تھو مُھن مذہب کے واپس یا"، ‌بَس تھین پروردگار تھین دِشکے وحی پیئی کہ: "مھوئے ہأ ظألم خامخا مانین"۔
آں ہأ ما بعد مھوئے تھو دھرین می آباد کونین، أ (بات) ہر تے ماݜ سی کأ چھی کآم یأ مھی مُشکے اِیڑی ہوؤ ما بھیدوُ، آں مھی عذاب سی اعلان ما بھیدوُ۔
آں تھیئے فیصلہ نیمأت آں ہر سرکش ضدی ماݜ نامراد دھروُ۔
آں (قیامت می) تِسی مُشکے دیزوخ چھی، آں تیزیت نَؤ سی اُو پیا بژنین۔
تیس تی ݲِھگ ݲِھگے پُونین آں مرِیا وائے نوکو بھانین، آں ہرے دِشا تیسکے مئیک مُخاخ ہونین، اَسے تی نو مونین، آں ایک پیش دوئی سخت عذاب سی مُوا ہونین۔
کی یأ تُنو رَب سی انکار کیدوُ تِھین عملا سی مثال تے پونو سی شانے تُھو کے بیلیئی سی دی تیز بیلائی تیس اُچات کوئے، آں کا عمل تھیئے کِیدوُ سے کی پکار نہ یو، آں اَںئی ہے اخکارہ گمراہی چھی۔
« اَیا تھو نہ پشَدی کہ اللہ دھیرینو آسمان برحق مقصد سی کأ پیدا کیدی، آں کے یأ سے نِموؤسأدو تھو ختم کیدے دُوئی اے مخلوق پیدا کوے؟
آں أ کام اللہ ئے کی ہُم بُوکھو نُو تُھو۔
آں ہیئے ٹولے اللہ ئے مُخامخ ہونین، بھی کمزور خلگے مغرور خلگے ما توَس کونین یقینًا مھو تُھن پأش اَشیئ (اتباع کوؤدود)، دَ اَیا تھو مھوئے ما اللہ سی عذاب دھأگ کی کم کوبھادی؟ تھیئے جواب می بننین کو اللہ مھوئے ہدایت کِشیو مھوئے تھوئے ہم ہدایت کونین دے، مھیرے مھو ٹولا سی کأ اے شان‌ سی بات چھی کہ مھو چِیگأ نِگھألی یا صوو کیئی خو مُھن لَھسوُ کی حال می ہم نُو تُھو۔
آں کے یأ ٹول کما سی فیصلہ ہِیو شیطان بننین، بے شک اللہ تھوسیت سأس سی وعدہ کِشی آں مأ ہُم تھوسیت وعدہ کِشی آسے مأ وعدہ خلافی کی آں مھی تھوزیت مِسما پھائے کی زور تا نہ اَشونأ کہ مأ تھوئے ہگات آں تھوئے مھی بات بِت، مھیرے مھأ ملامت نہ کوا، بلکہ تُنو اَمن ملامت کوا، نأ آش آ تُھن فریاد بُھوژ بھادو آں نأئی تھو مھی فریاد بُھوژ بھادی، آش آ أمیدے تھأ بأدے ما بیزار تُھو کہ تھو مُوش مھأ خُدئی سیت شریک کودُود، بے شک ظألما سی کأ دردناک عذاب مقرر تُھو۔
آں سے خلک کی یأ ایمان اَنوشُو آں نیک عمل کِشی تھأ مھال باغ آ می داخل کوا بژنین کِھین ٹین کآن بژنین، تُنو خُدَئ سی حُکم دے تھیئے اِسمی مُوا ہونین، آں تھأسید تھین ملاقات سی (دعا) سلام ہونین۔
کئ تأ نی ڈِیڈ کہ اللہ کھامُو پاک کلیمہ سی مثال بیان کیدوُ، یأ سے اے پاک تھام‌ سی شانے تُھو کسی نأ ( دھیرین می) مضبوط آں شاخ آسمان می تھی۔
سے تُنو رَب سی حُکم دے ہر وَخ میوہ دیدوُ، آں اللہ خلگا سی کأ مثال بیان کودوُ کہ سے نصیحت حاصل کوئن۔
آں اے ناپاک بأت سی مثال اے ناپاک تھام سی تُھو کہ دھرین سی ڙیدا نِگھلا بژدُو اَسے ہاڈو مضبوط نہ ہودوُ۔
اللہ تھأ خلک کآم یأ ایمان اَندی پوخ بأت (کلمہ طیبہ) زیت دُونیئی سی زندگی می آں آخرت می ہُم ثابت قدم‌ کودوُ، آں اللہ ظألِم خلک گمراہ کودوُ، آں اللہ کا ہُم نِمادو تیس کودوُ۔
اَیا تأ تھأ خلک نی ڈِیڈ کی یأ اللہ سی نعمت ناشکری زیت بدل کی آں تُنو قوم ہُم تباہی سی شِیر وا تھلوُ؟
(یعنی) جہنّم کِمی یأ تھیئے دھژا بژَنین آں سے چیر لاݜ پوت تُھو۔
آں تھیئے اللہ سیت شریک‌ سیوأد، بَنے خلک تِسی پَن ما گمراہ ہوئن، تُو بَن کہ دھأگ فائدہ گھینا، بے شک تُھن واپسی دیزوخ سی دِشکے چھی۔
(اے پیغمبرؐ) تُو مھی بَندائے بَن، کی یأ ایمان اَنودوُ سے نماز سی پابندی کوئن آں کا مھوئے دِیدتُو تِسما بیریت آں اَخکارا (نیگی سی پَن دے) خرچ کوئن، مِما مُوش کہ سے دی یو کِمی نأ گِھنُو و بِگنوُ ہونین آں نأئی دوستی پکار ینین۔
اللہ سے پاک‌ ذات تُھو کی یأ آسمان و دھیرین پیدا کی، آں آسمان ما اُو مُوژات، بھی تِسی (اُو سی) زریعہ دے میوائے ما تُھن کأ رزق پیدا کی، آں تُھن کأ کِشتی تابع کی بَنے سے سمندر می تِسی (اللہ سی) حُکم دے روان ہوئے، آں تُھن کأ نھید تابع کی۔
آں تُھن کأ سی و یُن کَم زیت ݜژأد یأ اےمُوا روان تھی، آں تُھن کأ ڙات و دی کَم می اَنِئی۔
آں تھوئے ہر تے شیئی دید کا یأ تھوئے نِماد، کہ تھو اللہ سی نعمت لیکھو نیموؤسأدو تھوئے تھأ نہ لیکھ بھانین، بے شک انسان چیر بے انصافہ آں ناشکرا تُھو۔
آں کے یأ ابراہیم ؑدعا کی کہ: "اے مھی خدایا مے خار (مکہ مکّرمہ) اَمن سی پوت سَوا، آں مھأو مھی اَولاد بُتا سی عبادت ما بچ کو۔"
اے مھی خدایا! بے شک ہیئے (بُھودے) چیر خلک گمراہ کیدی، بس کآم یأ مھے پیش روان ہُوو سے دا مھأ ما تُھو آں کآم‌ یأ مھی نافرمانی کودوو بے شک تو چیر بوگوشُو والا چَیر مہرَبان تُھو۔
اے مُھن پروردگار، بے شک مأ تُنو اولاد چھی محترم شِیر (کعبہ) سی کأن بے اُوو بے گیا آ میدان می آباد کی، اے مُھن پروردگار مِسی کأ کہ سے نماز سی پابندی کوئن، بس تو خلگا سی حی مِھین دِشکے مائل کو، آں ہأئے میوآ ما رزق دے یأ سے چھی شکُر نِگھالن۔
اے مُھن پروردگار، بے شک تھیئے معلوم تُھو کا یأ مھو بُرادی آں کا یأ مھو ڈاگا کودی، آں اللہ ما نأ دا دھیرین می کی شیئی بُریل تُھو آں نأئی آسمان می۔
ٹول صفت اللہ سی کأ تھی، کی مھیئے ڈھگاچا می (دو جدک) اسماعیلؑ آں اسحاقؑ دید، بے شکہ مھی رَب دعا بُھژو والا تُھو۔
اے مھی پروردگار! مھأ آں مھی اَولاد نماز سی پابند کو، اے مُھن پروردگار! مھی دعا قبول کو۔
اے مُھن پروردگار! مھأ آں مھی یئی و باب آں ٹول مومن بوگوش کے یأ حساب کتاب سی دی ہُوو۔
(اے پیغمبرؑ) آں تُو مے گُمان نوکو کہ اللہ ظألما سی کما ما غافل تُھو، تھأئے دا بس تے دیا پورے مہلت دیدچی کے یأ أݜی کولاؤ دھرنین۔
تھیئے تُنو ݜا بھاکیدے دھأںئ دینین، آں تِھین نظر تِھین دِشکے واپس نہ ہونین، آں حی پریشان ہونین۔
(اے پیغمبرؑ) خلک تے دی ما بھیا کے یأ تھأزیت عذاب یے نین، دَ تھیئے خلگے کآم یأ ظألم تھی بننین اے مُھن پروردگار! مھوئے دھأگ وَخ سی کأ مہلت دے کہ مھو چھی دعوت قبول کیئ آں پیغمبرا سی پیروی کیئی، (بنا بژنین) آیا تھو مِما مُوش قسم نہ کھوؤدود کے تھوزیت یئیت ہم زوال نے ینین؟
آں تھو تھأ خلگا سی شِیرا می دھرودُود کی یأ تُنو اَمن زیت ظلم کِشو، آں تھوئے غورا پتہ أشی کہ مھوئے تھأزیت کا سلوک کِشو، آں مھوئے تِھین مثال ہم تھوئے بیان کِشی۔
آں تھیئے تُنو ٹول مُکر پورا کی، آں تھین مُکرا سی جواب اللہ کیش اَشُو، اَسے تھین مُکر مھال اَشُو کہ کھن ہم تھأئے نی ٹینگ بھوؤدُود۔
دَ مے گمان یئیت ہُم نوکو کہ اللہ تُنو پیغمبرا زیت وعدہ خلافی کونین، بے شک اللہ زبردست آں بدل گھینو والا تُھو۔
(ہأ تے دی ما بِھیا) کامے دی یأ دھیرینے دوئی دھرین ہونین آں آسمان ہُم (دوئی آسمان ہونین) آں خلگے (قوَرے ما) نِختے اے واحد آں زروڑ اللہ سی مُشکے پیش ہونین۔
آں تھوئے پشنین تے دی گناہگائے ایک دوئی پورے زنزیرے دے گھنڈیل ہونین۔
تِھین پأن تارکول سی ہونین آں تِھین بودا پورے اَنگا چأپیرا ہونین۔
مِسی کأ یرأ اللہ ہر نفس کے تِسی اعمالا سی بدل دو، بے شک اللہ چیر شیرتے حساب گِھنو والا تُھو۔
أ (قرآن) خلگا سی کأ اے سوال جواب تُھو، یأ سے اِسی زریعہ دے بِھیا بژَن آں سے جنَن کہ حقیقت می اللہ اَمن سیت اے معبود تُھو آں بَنے جنُو والا اِما نصیحت حاصل کوئن۔
اللہ سی حُکم آپ تو لہذا تھو تِسی کأ جلدی نہ کوا، کامے شِرک یأ أ خلک کودی سے اِس ما پاک آں چیر اُچات تھُو۔
سے تُنو حکم دے مُلیک تُنو بنا می کیزید یأ نیمادُو تے جیدون دیؤ والا وحی سیت پیدُو، یأ "خلک بھیا، مھأما علاوہ دوئی یام عبادت سی لائق نہ تُھو، دَ تھلا تھو مھأما بھیا"۔
تی آسمان آں دھیرین برحق مقصد سی کأ پیدا کیدی، کامے شرک یأ أ خلک کودی سے تِسما چیر اُوچات آں برتر تُھو۔
تی انسان اے لیؤ ٹیگیل ما پیدا کیدو، بھی ہم ہے (انسان) لات کے تیا ہُو۔
آں څاروئی تی پیدا کیدی تھأ می تُھن کأ شیدل ما بچ کوؤ سی سامان تُھو، آں اِزما علاوہ دأل ہُم چیر فائدہ تھی، آں ہأ می یاما سی (ماس) تھو کھادی۔
آں ہأمی تُھن کأ شِیژواچا تُھو، کے یأ تھو جھیم می شیر کے آندی آں کے یأ ڙات می ہأ چیؤ گے نئیدی۔
آں ہے تُھن بوج بھا کیدے مھال پودائے آوادی یأ تھیدکے تھو چیر تکلیف آں ٹھمُو ما بغیر نہ آووبھادی۔ حقیقت أ چھی یأ تُھن رب چیر مہربان آں گھن رحم کوؤ والا تُھو۔
آں گھو آں قچر آں گھودو ہُم تی پیدا کیدی مِسی کأئی تھو ہأزید سور ہوا آں (تُھن کأ) شِژواچا سی سامان (ہُم تُھو)، آں (چیر مھال شیئی ہم) پیدا کودُو یأ تھأ سی تھوئے مھیرے علم ہم نہ تُھو۔
آں سِدا پان پشوؤ سی ذمہ واری اللہ سی چھی، آں چیر پَن کیل (ہُم) تھی آں کو سے نیِموؤدود تی تھو سِدا پَن دے آوانین دے۔
اللہ سی ذات تُھو سے آسمان سی دِشا آگھا موژادُو تِسی اُو تھو پُودی آں تِسی زریعہ دے تھام پیدا ہُوئیدی، تھیئدے تھو تُنو څاروئی چیادی۔
تِسی زریعہ دے اللہ تُھن کأ فصل کو سی آں کجُور سی تھام آں داݜ آں ہر قسم سی میوہ جات پیدا کودُو، حقیقت می مھأ ٹول بأدا می تھأ خلگا سی کأ گھن نشانی تھی یأ سے غوروفکر کودی۔
آں تی ڙات و دی، سی و یُون تُھن خدمت می ݜژأدتی آں تا ہُم تِسی حکم دے کم می ݜژیل تھی۔ یقینا مھأ بأدا می تھأ خلگا سی کأ گھین نشانی تھی کآم یأ عقل ما کام گھیندُو۔
آں کامیک یأ تی دھیرین زید مختلف ڙانگا سی شیئی پیدا کیدی تُھن کأ (سے ہُم تِسی حُکم دے کم زید ݜژیل تھی)، یقینا ہأ ٹولا می عبرت سی نشانی تھی تھأ خلگا سی کأ یأ سے نصیحت قبول کوؤ والا تھی۔
آں اللہ سی ذات تُھو تی سمندر کم زید ݜَژادتو، میلائی تھو تِسما تازہ ماس کھا، آں تِسما تُنو لھوؤ سی زیورات (لال) نِگھلا، آں تھو پشَدی کشتی سمندر پھألدے روان ہوژی، مِسی کأئی تھو تُنو رب سی فضل بیرڑا، آں تُنو رب سی شُکر نِگھلا۔
آں تی دھیرین زید مضبوط کھن سَوأت تی مِسی کأئی دھیرین پھرَگے نأ، آں دریاب آں پَن سَوأت تی میلائی تھو تنُو منزل مقصود کے آوا۔
آں پَنا سی پأنُو سی کأ نخ سَوات تی، آں خلک تائے دے ہم پَن معلوم کودی۔
دَ اَیا سے (اللہ) یأ سے پیدا کو بھادُو (ہین تھال معبودا سی) شانے تُھو یأ سے کی پیدا نہ کو بھادی؟ تھو کئی نہ جَندی؟
آں کو تھو اللہ سی نعمت لیکھوسأدو تھو تھأ ییت ہم نہ لیکھ بھادی۔ حقیقت أ چھی یأ اللہ چیر بگوشو والا آں گھن مہربان تُھو۔
آں اللہ تھأ بأت ہم جندُو کامیک یأ تھو بیریت کودی، آں تھأ ہم یأ تھو ڈاگا کودی۔
آں اللہ چھیدے أ خلک کامے خُدئی یے آواز کودی سے کی ہُم پیدا نہ کو بھادی، سے دا أمیدے پیدا ہوئیل تھی۔
دَ سے ٹول بے ساہ تھی، تھأ می جیدون نہ تُھو، آں ہأئے مے بأت سی ہم احساس نہ تُھو یأ ہأ خلک کی جینی کیدے دُووآر اُشانین۔
تُھن معبود دَ بس اے اللہ تُھو، دَ لہذا کامے خلک یأ آخرت زید ایمان نہ لرَدی تھین حیآ می انکار تُھو، آں سے تکبر کودی۔
ظاہر بات چھی یأ اللہ تھأ بأدے ہم جنَدُو کامیک یأ ہے بیریت کودی، آں تھأ بأدے ما ہم یأ ہے ڈاگا کودی، یقینا سے تکبر والا نہ خوشادُو۔
آں کے یأ ہأئے بناگا تُھن ربے کا نازل کیدوُ؟ دَ ہے بنَدی بَئیل خلگا سی قیصہ۔
(ہأ بأدا سی نتیجہ أ چھی) یأ ہیئے قیامت سی دی تنُو گناہ آ سی بوج ہُم تنو اَمن زید بھا کونین، آں تھأ خلگا سی بوج سی اے حصہ ہُم کامے خلگے یأ ہأ جہالت سی وجہ دے گمراہ کیدی، بُودا کھیدیک لاݜ بوج تُھو کامیک یأ ہے تنُو ݜا زید گِھنَدی۔
ہأما مُوش ہم خلگے مُکر سی منصوبہ سَوأدیشی، (آسے مھامُوٹ ہوئی ہے) کامے منصوبہ سَوأدیشی دَ اللہ تِھین نیأ بنیادا ما نِگھالیئ، بھی تِھین شان تِھین ڙیت لار گئی، آں ہأزید مھال پودے ما عذاب آپ یأ ہأئے پتہ ہم نہ گھیڑی۔
بھی قیامت سی دی اللہ ہأ رسوا کونین، آں ہأما توَس کونین: "کھید تھی مھی شریک تِھین ݜا زید تھو (مسلمان آ سید) لات کوؤدوُد؟ دَ کامے خلگائے اللہ علم دیدتُو تھیئے بَننین: "چَیر لأݜ حال آں شوم چھی آش ہأ کأفرا زید"۔
تِھین روح مُلیگے مھال حالت می گِھین، کے یأ ہے تُنو اَمن زید (کفر سی وجہ دے) ظلم کوؤدوُد۔ اے وَخ می خلگے چَیر فرمانبرداری سی بأت کونین یأ "مھو کی لاݜ کام نہ کوؤدوُد"، دَ (ہأئے بنا بژنین) کھأ نہ کوؤدوُد، اللہ یے دَ ہر کام معلوم تُھو یأ تھو کا کا کوؤدُود۔
دَ مھیرے ہمیشہ سی دھرُو سی کأ جہنم سی درواز می داخل ہوا، میلائی تکبر کوؤ والا سی کأ أ جہنم چیر لاݜ پوت تُھو دھرُو سی کأ۔
دُوئی ڈھأر کے متقی یے ما توَس کوا بَژدُو یأ تُھن پروردگار کا نازل کیدوُ؟ دَ تھیئے بَننین خیر آں نیگی سی بأت نازل کیدی۔ مھال نیگی کوؤ والا خلگا سی کأ مے دونیئی می ہم بہتری چھی آں آخرت سی شِیر تہ چیر بہتر چھی، یقینا متقیا سی شِیر بہترین چھی۔
ہمیشہ ہمیشہ دھرُو سی کأ سے باغات تھی، تھأئے ہیئے داخل ہونین، تِھین ٹین گے نہر جاری ہونین آں مھیت یأ ہے کا نِموؤسأدو تی میلاؤ ہونین۔ متقی خلگائے اللہ مھامُو بدلا دیدُو۔
ہے سے خلک تھی یأ تھین روح مُلیگ مھالے حالت می گِھندی یأ سے پاک صاف ہودی، مُلیگے ہأئے بَننین تھوزید سلامتی ہوئے۔ کامے عمل تھو کوؤدُوت تِسی بدلہ می جنت می داخل ہوا۔
أ (کأفر خلک) مھیرے (ایمان آنُو سی کأ) مے بأت ما سیوا دُوئی کا بأت سی انتظار می تھی یأ ہین کأش کے مُلیگ یَن یأ (قیامت یا عذاب سی صورت می) چھی پروردگار سی حُکم یو۔ کامے اُمت ہأما موُش لھنگئی دی تھیئے ہُم مھامُو کِیشُو۔ آں اللہ تھأزید کی ظلم نہ کِیشُو بلکہ سے أمینے تنُو اَمن زید ظلم کوؤدُود۔
مے وجہ دے ہین لاݜ عملا سی بدل تھأئے آوؤ۔ آں کامے شیئی سی ہے مذاق سوؤدُود سے شیئی ہأما گیر ہو۔
آں کامے خلگے یأ شرک اختیار کِیژی سے بَندی کو اللہ نیموؤدُود تِزما سیوا یِسی عبادت نہ کونین دے، نأ مھوئے نأئی مُھن بوب دادے، آں نأ مھوئے تِسی حُکم ما بغیر کی حرام کوننین دے۔ کامے اُمت ہأما مُوش لھنگئی دی تھیئے ہم ہاموٹ کِیشُو، اَسے پیغمبرا سی ذمہ واری مِسما علاوہ کی ہم نی چھی یأ سے صفا صفا اللہ سی پیغام آوَن۔
آں یقینا مھوئے ہر اُمت می کآم نہ کآم پیغمبر مے ہدایت سَمانے پیؤشُو یأ تھو اللہ سی عبادت کوا آں طاغوت (غیراللہ) سی عبادت ما اَون ساتا، بھی ہأمی یام خلک سے اَشیئ یأ تھأئے اللہ ہدایت دید آں یام خلک سے اَشیئ یأ تھأزید گمراہی تھا گأ، دَ تھو دھیرین زید گئی دے بوا (پیغامبر آ سی) لووال گھنڈوُ والا سی انجام کھال ہُو۔
(اے پیغمبر) کو تھیئے أ حرص چھی ہے خلک ہدایت زید یَن دَ حقیقت أ چھی کامے خلک یأ اللہ (ہین بغض سی وجہ دے) گمراہ کودُو دَ ہأ ہدایت کے نہ اَوادُو، آں ہال خلگائے یام مددگار ہُم پیدا نہ ہودُو۔
آں ہیئے خلگے چیر زور ݜژأدے اللہ سی قسم کھوئیدی یأ کامے خلک مُوئیدی اللہ تھأ دُوآر جینی نہ کونین۔ کئی نہ کونین؟ أ دَ اے برحق وعدہ چھی تیس پورا کوؤ سی ذمہ واری اللہ گِھن چی، اَسے زیات خلک نہ جَندی۔
(دُوار جینی کوؤ سی وعدہ اللہ میلا کیِژی) سے خلگا سی مُوشکے تھأ بأت غورا واضحہ کوئے کامے بأدا می یأ ہے خلک اختلاف کوؤدُود، آں مِسی کأ کأفر خلک جَنن ہے لووال اَشی۔
آں کے یأ مھو کی شیئی سی (پیدا کوؤ سی) ارادہ کودی دَ مُھن دِشا صرف مھیدیک بات ہوژی یأ مھو تیس کے بَندی موجود ہو، دَ سے موجود ہودُو۔
آں کامے خلگے دألا سی ظلم برداشت کیدے اللہ سی خاطر تے ہجرت کی دَ یقینا مھوئے ہأ خلک دُونیئی ہُم غورا دھرانین آں آخرت سی اجر دَ یقینا ٹولے ما گھن تُھو۔ کاش کہ ہے خلک جَنن دے۔
ہے سے خلک تھی تھیئے صوو ما کام گِھن آں سے تُنو پروردگار زید بھروسہ کودی۔
آں (اے پیغمبر) مھوئے تھأ ما مُوش دوئی یام نأ بلکہ انسان پیغمبر سوأدے پیئشی، تھأ زید مھو وحی نازل کوؤدوت۔ (اے منکر خلگا ہانا) مھیرے کو تھوئے مے بأت سی علم نہ تُھوو کامے علم والا تھی تھأ ما توَس کوا۔
(تھأ پیغمبر) اخکارہ دلائل آں آسمانی کتاب دیدے پیا گئیشی۔ آں (اے پیغمبر) مھوئے تھیزید ہم قرآن مِسی کأ نازل کیدُو یأ تو خلگائے تھأ بأت واضح بیان کو کامیک یأ ہأ سی کأ نازل کوا گئیدی تاکہ ہے خلک غور و فکر ما کام گھنین۔
دَ کئی سے خلک یأ لاݜ لاݜ منصوبہ سوادی مے بأت ما نہ بھیدی یأ اللہ ہأ دھیرنے وا ڈوب کوئے یا ہأزید مھال پوت ما عذاب یو یأ ہأئے احساس ہم نہ ہوئے۔
یا تِلو تِلو می ہأ (تُنو عذاب می) گݜے، میلائی ہے اللہ عاجزہ نہ کو بھادی۔
یا ہأ (تُنو عذاب می) گݜے ہأ بھأدے، یقینا تُھن رب چیر شفقت کوؤ والا آں چیر زیات مہربان تُھو۔
کئی ہے خلگے نہ ڈیڈتو یأ اللہ کامے شیئی پیدا کیدی؟ تھین چیژول اللہ یے سجدہ کیدے اَوین آں سوین ڈھأر کے کیلی ہودی آں سے ٹول عاجزی سی اظہار کودی؟
آں آسمانا می آں دھیرین زید کھیدیک سا والا شیئی تھی سے بُٹ آں مُلیگ خاص اللہ یے سجدہ کودی آں خَس ہم تکبر نہ کودی۔
سے تُنو پروردگار ما بھیدی کامیک یأ ہین ڙیت تُھو آں تے کام کودی یأ کامیک سی ہأئے حکم دیا بژدُو۔
آں اللہ بندوُ تھو دُو دُو خدا نہ گݜا، سے صرف اے خدا تُھو، دَ مھیکیژا بھیا۔
آں آسمانا می آں دھیرین می یأ کا تُھو تِسی تُھو، آں تِسی تابعداری ہر حال می لازم چھی۔کئی تھو بھی ہم اللہ ما سیوا دألے ما بھیدی؟
آں تھوئے کامے نعمت حاصل تھی اللہ سی دِشا تھی، بھی کے یأ تھوئے تکلیف آوو تھو تیس کے فریاد کودی۔
اِس ما بعد کے یأ سے تھو ما تکلیف دُھو کؤدُود دَ تھو ما اے ڈلا اچانک تُنو پروردگار سیت شرک شروع کوژی۔
تاکہ مھوئے تھأئے کامے نعمت دِدیشی دا تِسی ناشکری کون، دھأک وخ عیش کوا بھی شیرتے تھوئے پتہ گھڈنین۔
آں مھوئے کامے رزق ہأئے دیدتُو تِس می ہے خلک تھأ (بھودا سی) حصہ نِگھالَدی، تھین حقیقت ہأئے أمینے ہم معلوم نی چھی۔ اللہ سی قسم تھوما ضرور توَس ہونین یأ تھو کھأکأ لوو سَوؤدُوت۔
آں اللہ سی کأ ہیئے خلگے سیرأن سوأدتی، سبحان اللہ! آں أمینے تُنو اَمن سی کأ ہے (جدگ نیمادی)، سے ہین خواہش سی مطابق ہون۔
آں کے یأ ہأما یس کے سیرأن سی پیدائیش سی زیرے دیا بژژی دَ تِسی مُو کِݜینی ہودُو، آں سے غمجن ہودُو۔
مے زیرے لاݜ گھنڈودے خلگے ما بیریدے گئیدُو، (آں سوچ کودوُ) یأ مے ذلت برداشت کیدے (مے سیرأن) اَون سیت ڙیݜی یا ایس دھیرین می جأن دیوی، بُوآدا ہیئے کھیدیک لأݜ فیصلہ کِیژی۔
لأݜ لأݜ بأت سے کودی کامے خلگ یأ آخرت زید ایمان نہ لَردی، آں اُوچات صفات صرف اللہ سی کأ تھی، سے زوروَر ہم تُھو آں حکمت والا ہم تُھو۔
آں کو اللہ خلک ہین ظلم سی وجہ دے فورا گݜوُ نیمؤدود دَ دھیرین زید کی سا والا شیئی باقی نہ چھونیندے، اَسے سے ہأئے اے مقررہ وخہ پورے مہلت (نیٹا؟) دیدوُ، بھی کے یأ سے مقرر نیٹہ آبو دَ بھی اے ساعت سی کأ نأ مُٹھادی ہونین نأ پدیدی ہونین۔
آں ہیئے اللہ سی کأ تھأ شیئی مقرر کیدی تھأ ہے اَمن گے نہ خوشادی، بھی ہُم ہین جِب تُنو لوو آ سی صفت کودی یأ ٹول غوراچا ہین حصہ می تُھو۔ لازمی بات چھی ہین حصہ می دیزوخ چھی آں ہأ تیس کے مُوش ما پیا بژنین۔
(اے پیغمبر) اللہ سی قسم! تھأ ما مُوش کھیدک اُمت لھنگئیدی مھوئے تھأئے پیغمبر پیؤئیشی دَ شیطان ہین لاݜ عمل ہین کأ شیژیئی کیدے ہأئے پیش کی، سے شیطان آش ہُم ہین سرپرست تُھو آں (مے وجہ دے) ہین کأ دردناک عذاب تیا تُھو۔
آں مھوئے تھأ زید مے کتاب مِسی کأ نازل کیدُو تاکہ تُو ہأ خلگائے تھأ بأت کولاؤ بیان کوا کامے بأدے می ہے اختلاف کودی، آں تاکہ (أ کتاب) ایمان آنو والا سی کأ ہدایت و رحمت سی سامان ہوئے۔
آں اللہ آسمان سی دِشا آگھا مُوژات آں دھیرین سی شڑ ہوؤ ما بعد ایس دُوآر جینی کی، یقینا اِس می تھأ خلگا سی کأ نخ تھی یأ سے بات بُھوژدی۔
آں تُھن کأ څاروَئیا می ہُم عبرت سی سامان تُھو، ہین ڈھے آ می کامے پاݜ آں ڙات تُھو تِسی درمیان ما مھو تُھن کأ مھال صفا ڇھی پُو سی کأ دیدی سے پُو والا سی کأ چیر مزیدار ہودُو۔
آں کجُورا سی آں دَݜ سی میوا می ہُم، تِس ما تھو شراب ہم سَوادی آں پاکیزہ رزق ہُم، یقینا اِس می تھأ خلگا سی کأ نخہ نشانی تھی یأ سے عقل ما کام گِھندی۔
آں چھی پروردگار مأݜ میݜی سی حی می مے بات تھیلیژی تُو کھنا می آں تھاما می آں خلک کامے چَت سَوادتی تھأ ما شِیر سَوا۔
بھی ہر قسم میوا ما اَمن گے خوراک گھِن، بھی تھأ پَنے دے بش کامے پَن چھی ربے تھیئے آسان کیدی، مھأ میݜی آ سی ڈھے آ ما مختلف ڙانگا سی مشروب (مأݜ) نُوخَژی تِس می خلگا سی کأ شفا تُھو، یقینا مھأ بُٹ بأدا می تھأ خلگا سی کأ نشانی تھی یأ سے سوچ و فکر کودی۔
آں اللہ تھو پیدا کیدی، بھی سے تُھن سا نگھلَدُو، آں تھوئے ما یام خلگ مھال ہودی سے عُمو سی ناکارہ حصہ ئے آوا بژدی، تیس کے أویدے سے ہر کآں جیندے بھی نہ جَندی، یقینا اللہ گھن علم والا گھین قدرت والا تُھو۔
آں اللہ تھو می بعض خلگائے رزق سی معاملہ می دیالا زید برتری دیت چی، دَ مھیرے کامے خلگائے برتری دیا گأئی سے تُنو رزق تُنو غلامائے ہامُوڑ نہ دیدی یأ ٹول برابر ہون، دَ کئی ہے خلک اللہ سی نعمت ما انکار کودی؟
آں اللہ تھوئے ما تُھن کأ جوَئی پیدا کیدی آں تُھن جوَئیے ما تُھن کأ جدَک آں نوسَئی پیدا کیدی، آں تھوئے غورہ غورہ شیئے ما رزق دیدوُ، دَ کئی بھی ہے خلک بے بنیاد بأدا زید ایمان اَندی آں اللہ سی نعمدہ سی ناشکری کودی؟
آں ہے خلک اللہ چھیدے تھأ شیئیا سی عبادت کودی سے آسمانا می آں دھیرین می کی قسم رزق سی دیؤ سی نأ کی اختیار لرَدی آں نأ کی طاقت لرَدی۔
لہذا اللہ سی کأ مثال بیان نہ کوا، بیشک اللہ جَندُو آں تھو نہ جنَدی۔
اللہ مثال دیدُو یأ اے دِشکے اے غلام تُھو سے کیںسی ملکیت می تُھو، ایس کے کی شیئی می کی اختیار نہ تُھو، آں دُوئی دِشکے سے ماݜ تُھو تیس کے مھوئے تُنو دِشا بہترین رزق دیدتُو آں سے تِسما بیریت آں ڈاگا خرچ کودوُ، کئی ہے دُوںئیدے برابر ہو بھادی؟ تمام صفت اللہ سی کأ تھی اَسے ہأ ما اکثر خلک نہ جنَدی۔
آں اللہ اے (دُوئی) مثال دیدوُ، یأ دُو ماݜ تھی ہأ می ایک چار تُھو، سے کی کام ہُم نہ کو بھادُو آں تُنو مالک زید بوج تُھو، ایس کھیت کے پیوؤ ہے کی غورہ کام کیدے نہ آندُو، دَ کئی مھال ماݜ مھال دوئی ماݜ سیت برابر ہوبھادُو یأ سے دألائے ہم انصاف سی حکم دیدُو آں أمیدے ہم سِدا پَن زید اِڑی ہوئیل تُھو؟
آں آسمانا سی آں دھیرین سی تمام غیب سی بأت اللہ سی قبضہ می تھی، آں قیامت سی معاملہ أݜی سی رَپ ما چیر نہ ہونین بلکہ اِسما شَیرتے ہونین، یقینا اللہ ہر شیئی زید پورا قدرت لرَدوُ۔
آں اللہ تھو تُھن ییئی آ سی ڈھے ما مھال حالت می نِگھالِئی یأ تھو کی ہُم نہ جَنوُدوُت، تی تھوئے کَن دیت أݜی دیت حی دیت، میلائی تھو شکر نِگھلا۔
کئی ہیئے خلگے پیݜین نی ڈِیڈتی سے آسمان سی فضا می اللہ سی حکم سی پابند تھی؟ تھأ اللہ ما علادہ دُوئی یی ہُم نہ ٹِنگأت تی، یقینا اِسمی تھأ خلگا سی کأ گھن نَخ تھی یأ سے ایمان والا تھی۔
آں اللہ تُھن کأ تُھن شِیر سکون سی پوت سَوأت تی، آں تُھن کأ څاروَئیا سی چَم ما مھال شِیر (تمبو) سَوأدتی سے تھوئے سفر سی ریوان ہوؤ سی وخ می آں کی پوت می دھرُو سی وخ می اُپھٹ پَشن ہودی، آں ہین پوم ما آں ہین پشم ما آں ہین بالے ما شِیر سی سامان آں مھال شیئی پیدا کیدی سے اے وخہ پورے تھوئے فائدہ آوادی۔
آں اللہ تُنو پیدا کوئیل شیئی می تُھن کأ چیژول پیدا کیدی، آں کھنا می تُھن پناہ سی کأ بَھیل سَوأت تی، آں تُھن کأ مھال کوژو پیدا کیدی سے تھو گیریمی ما پِھگادی، آں مھال لباس سے تُھن لات می تُھن حفاظت کودو، مھامُوڑ سے تُنو نعمت تھوزید مکمل کودوُ، میلائی تھو تِسی فرمانبردار سَوا بژا۔
بھی ہُم کو أ (کأفر) مُو نَرادی دَ (اے پیغمبر) چھی ذمہ واری صرف أ چھی تُو واضح طریقہ دے پیغام آوا۔
أ خلک اللہ سی نعمت پأنَدی بھی ہُم انکار کودی، آں ہأ می اکثر خلک ناشکرا تھی۔
آں تے دی (یاد کوا) کے یأ مھوئے ہر اُمت ما اے گواہ اِڑی کونین، بھی کامے خلگے کفر کِشوُو تھأئے (عُذر سی پیش کوؤ سی) اجازت دیا نہ بژنین، آں نأ ہأئے فرمائش کوا بژنین یأ تھو توبہ کوا۔
آں کے یأ ہیئے ظألم خلگے عذاب (تُنو أݜیئے دے) پشنین دَ نأ ہأما عذاب اِپھیڑی کوا بژنین آں نأ ہأئے مہلت دیا بژنین۔
آں کامے خلگے اللہ سیت شِرک کِشوُ کے یأ تُنو (سَویل) شریک پَشنین دَ ہیئے بننین اے مُھن پروردگار أ مُھن (سَویل) سے شریک تھی تھأئے مھو ہاگوؤدوُد تھأ چھیدے، تے موقع می سے (سَویل) شریک (خدا) ہأئے مے بات تھلنین یأ تھو بالکل لَوو سَوادی۔
آں تھیئے تے دی اللہ سی کأش فرمانبرداری سی بأت کونین، آں کامے بہتان ہے سَوؤدود تِسی ہأئے کی سُراغ (بِلیگا؟) میلاؤ نہ ہونین۔
کامے خلگے کفر کِشوُ آں دأل خلک اللہ سی پَن ما کھمُودُود ہین عذاب زید مھوئے دُوئی عذاب چَیری کونین، میلائی ہے خلک فساد کوؤدُود۔
آں تے دی (یاد کو یأ) ہرے اُمت ما اے گواہ مھوئے ہیئے ما اِڑی کونین، آں (اے پیغمبر) مھوئے تھأ ہأ خلگا سی خلاف گواہی دیوؤ سی کأ آننین، آں مھوئے تھیزید مے کتاب نازل کِیدُو میلائی ہے ہرے بات کولاؤ کولاؤ بیان کوے، آں ہے مسلمانا سی کأ ہدایت، رحمت آں زیرے سی سامان تُھو۔
بیشک اللہ انصاف سی، احسان سی آں رشتہ دارائے تِھین حق دیوؤ سی حکم دیدوُ آں بے حیائی ما لاݜ کمے ما آں ظلم سی کوؤ ما کھمَدُو، سے تھوئے نصیحت کودُو میلائی تھو نصیحت قبول کوا۔
آں اللہ سی کوئیل معاہدہ پورا کوا، آں قسم پیگی کوؤ ما بعد نہ پَھرا، حالانکہ تھوئے اَمن زید اللہ گواہ سَواد تُو، تھو کا کودی دا اللہ تِسما جَندوُ۔
آں تھو تے جوَئی سی چَھلے نہ ہوا کی یأ تُنو پام کڑوُ ما بعد دُوآر تار تار کی، (مھامُو نأ) تھو ہم تُنو قسم پَھرأدے آپس سی فساد سی زریعہ سَوا، صرف مِسی کأ یام خلک دألے ما زیات فائدہ حاصل کون، اللہ اِسی وجہ دے تُھن اَزمیخ کودُو، آں قیامت سی دی تی تھوئے تھأ بأت ضرور کولاؤ کیدے پَشانین کامے بأدا می یأ تھو اختلاف کوؤدُود۔
آں کو اللہ نیموؤدُودو تھو ٹول اے اُمت (اے دین سی پیروکار) سَوانیندے، اَسے سے کیس نِمادُو (تِسی ضد سی وجہ دے) گمراہی می تَھلَدُو آں کیس نِمادُو ہدایت کے آوادُو، آں تھو کا عمل کودی تِسی بارہ می تھوئے ما ضرور توَس کوا بژنین۔
آں تھو تُنو قسم ایکدیئے دوکا سی زریعہ نہ سَوا، مھامُو نأ (دألا سی) کُھو جُخ ہوؤ ما بعد پَݜلن، بھی تھوئے اللہ سی پَن ما کھمُو سی وجہ دے لأݜ سزا چکھا بژنین، آں تھوئے (اے صورت می) گھن عذاب ہونین۔
آں اللہ سیت (کوئیل) وعدہ اَشُوڈ قیمت می نی بیگینا، کو تھو حقیقت ما جَندیو، کامے (اجر) اللہ سیت تُھو سے تُھن کأ چیر بہتر تُھو۔
کا یأ تھوسیت تُھو لھسُو والا تُھو، آں کا یأ اللہ سیت تُھو سے باقی دھرُو والا تُھو، آں کامے خلگے صوو ما کام گِھنوو مھوئے تِھین کما سی مطابق تھین اَجر ضرور دینین۔
کی یأ ایمان سی حالت می نیک عمل کیشُوو کو سے ماݜ آشُو یا ڇھی مھوئے تیس کے پاکیزہ زندگی دینین، آں مھال خلگائے ہین بہترین عملا سی مطابق ضرور اجر دینین۔
کے یأ تُو قرآن بنُوسأدو دَ شیطان مردود ما اللہ سی پناہ نیما۔
اِسی (شیطان سی) مھال خلگا زید وَس نہ چَلژی کی یأ ایمان آنودُو آں تنُو پروردگار زید بھروسہ کودی۔
اِسی وَس تھأ خلگا زید چلدوُ سے تیس دوست سَوادی آں اللہ سیت شِرک کودی۔
آں کے یأ مھو اے آیت دُوئی آیت سیت بدل کودی، آں اللہ بہتر جَندُو سے کا نازل کوے، دَ ہے (کأفر) بندی تو اللہ زید لوو سوؤ والا تُھو، حالانکہ ہأما اکثر خلک حقیقت سی علم نہ لردی۔
تُو بن مے (قرآن) دَ جبریل چھی رب سی دِشا حق زید نازل کیدُو، میلائی ہے ایمان والا مضبوط کوئے، آں مسلمانا سی کأ ہدایت آں زیرے سی سامان تُھو۔
آں (اے پیغمبرؐ!) مھوئے معلوم تُھو أ خلک (چھی بارہ می) مھامُوڑ بنَدی ایس کے اے انسان ڇھیڙادُو، (حالانکہ) کامے ماݜ سی ہے حوالہ دیدی تِسی جِیب عجمی چھی آں مے قرآن سی جِیب صفا عربی چھی۔
کامے خلک اللہ سی آیادا زید ایمان نہ آندی ہأ اللہ ہدایت زید نہ آندُو، آں ہین کأ درناک عذاب تُھو۔
اللہ زید لَوو دَ (پیغمبر نأ) سے خلک سَوادی کام یأ اللہ سی آیادا زید ایمان نہ آندی، آں ہے خلک حقیقت می لووال تھی۔
کامے ماݜ اللہ زید ایمان آنُو ما بعد تیسیت کفر کودُو، سے نأ یأ تیسیت (کفر سی کلمی بنُو سی کأ) زبردستی کواگأ، آں تِسی حی ایمان زید مضبوط آشُو، بلکہ سے ماݜ یأ تی تنُو سینہ کفر سی کأ کولاؤ کی، دَ مھال خلگا زید اللہ سی دِشا غضب نازل ہونین، آں ہین کأ گھن عذاب تیا تُھو۔
ہے مِسی کأ کہ ہیئے خلگے آخرت سی مقابلہ می دُونیئی سی جیدون خوشاد، آں أ (اللہ سی قانون تُھو) کہ اللہ مھال خلگا یے ہدایت نہ دیدوُ۔
ہے مھال خلک تھی یأ اللہ ہین حیا زید کنا زید آں أݜیا زید مہر ݜژادتُو، آں ہے سے خلک تھی یأ (ہے تنُو انجام ما) بالکل بے خبر تھی۔
لازمی بات أ چھی ہے سے خلک تھی ہے آخرت می ٹولے ما زیات نقصان بھا کونین۔
بھی یقین کو چھی پروردگار سی معاملہ أ چھی یأ کامے خلگے فتنہ می مبتلا ہوؤ ما بعد ہجرت کی بھی جہاد کی آں صوو ما کام گھِن، دَ ہیئے بأدے ما بعد چھی پروردگار چیر بوگوشو والا آں گھن مہربان تُھو۔
می ہر کی تے دی ہونین (کامے دی) ہرے ماݜ تنُو دفاع سی بأد کوا یینین، آں ہرے ماݜ کے تِسی ٹول عملا سی پورا پورا بدل دیا بژنین، آں یزید کی ظلم کوا نہ بژنین۔
آں اللہ اے گام سی مثال دیدُو سے چیر پُرامن آں مطمئن آشُو، تِسی رزق ہر پوت ما فراخی دے ییؤدود، بھی تھیئے اللہ سی نعمت آ سی ناشکری شروع کی، دَ اللہ تھِین لاݜ کما سی وجہ دے تھأئے مے مزہ چکھأد کہ بِݜ آں بھِیت ہین کوژو سَوا گئی۔
آں ہین کأشکے ہیئے ما اے پیغمبر آبوشُو، اَسے ہیئے تیس لَوو گھنڈوُ، دَ کے یأ ہیئے ظلم کی ہأ عذاب گأد۔
لہذا، اللہ کامے حلال پاکیزہ شیئی تھوئے رزق سی طور تے دیدتی تھأ کھا آں اللہ سی نعمَدا سی شکر ادا کوا، کو تھو واقعی تِسی بندگی کودیو۔
تی تھوزید مُردا، ڙات، خنزیر سی ماس آں تے زیناور حرام کیدو کیزید یأ اللہ ما علاوہ دوُئی کِسی نام گھِنا گادوُ، اَسے کآم یأ بِݜیدے بے حالا ہُوو آں سے خوند گھِنُو سی کأ نہ کھادُو آں حد ما مُٹھائے نہ بژدُو، دَ اللہ بوگوشو والا آں گھن مہربان تُھو۔
آں کامے شیئیا سی بارہ می تُھن جِب لووآ سی بأت سَوادی تِھین بارہ می میس نہ بنا أ شیئی حلال تُھو آں أ شیئی حرام تُھو، کئی کہ تِسی مطلب می ہونین یأ تھوئے اللہ زید لوو سی بہتان تھانین، یقین کوا کامے خلک اللہ زید لوو آسی بہتان سَوادی سے کامیابی نہ پابھادی۔
دوُنیئی می ہأئے کا عیش حاصل تُھو سے چیر کم تُھو آں ہین کأ دردناک عذاب تُھو۔
آں یہودی آ سی کأ مھوئے تھأ شیئی حرام کِیشی تِسی تذکرہ مھوئے تھوئے مُوش کِژی، آں مھوئے تھأزید کی ظلم نی کِشوُ بلکہ سے تنُو اَمن زید ظلم کوؤدود۔
بھی ہُم چھی رَب مھال تُھو یأ کامے خلگے ناپوہی می لاݜ کم کی آں تِسما بعد توبہ نِگھألی آں تنُو اصلاح کی دَ ہأ بُٹ بأدے ما بعد ہُم چھی پروردگار چیر بوگوشُو والا آں چیر مہربان تُھو۔
بیشک ابراہیمؑ مھال پیشوا اَشُو یأ ہر دِشا یکسوُ ہیدے اللہ سی فرمان برداری اختیار کی، آں سے تھأ خلگا می نہ آشُو یأ سے اللہ زید ییس شریک کودی۔
سے اللہ سی نعمت آ سی شکرگزار آشُو، تی تیس کأرتے خوشادُوشُو آں سِدا پَن دے آوادُوشُو۔
آں مھوئے تیس کے دُونیئی می ہُم شیژو جوند دِیدوشو، آں آخرت می دَ یقینا تِسی شمار نیگا می ہونین۔
بھی (اے پیغمبر) مھوئے تھیئے وحی سی زریعہ دے مے حُکم نازل کِیدُو تُو ابراہیم سی دین سی پیروی کو، تی تنُو رخ صرف اللہ سی دِش کے کِشو، آں سے تھأ خلگا ما نہ آشُو یأ سے شِرک کودی۔
ہفتہ سی دی سی احکام تھأ خلگا زید لازم کوا گئیشی یأ تھیئے اِسی بارہ می اختلاف کِشُو، آں یقین کو چھی ربے قیامت سی دی ہین درمیان میں تھأ ٹول بأدا سی فیصلہ کونین کامے بأدا می یأ ہے اختلاف کوؤدود۔
تنُو رب سی پَن سی دِش کے خلگائے حکمدیدے آں نصیحدیدے دعوت دے آں (کو بحث مباحثہ سی موقع آپ) دَ ہأئے بحث مھال طریقہ دے کو سے بہترین ہوئے، یقینا چھی رب تھأ خلک ہم پأندُو سے سِدا پَن ما گُوئیدی، آں تھأ خلک ہم پأندوُ سے سِدا پَن زید اِڑی ہوئیل تھی۔
آں کو تھو خلک (یِسی ظلم سی) بدَل گِھندی دَ تھدیک بَدل گِھنا کھیدیک یأ تھوسیت زیاتئی کوا گیژی، آں کو صوو کودی دَ ہے صوو کوؤ والا سی کأ چیر بہتر تُھو۔
آں (اے پیغمبر) تُو صوو ما کام گِھن، آں چھی صوو اللہ سی توفیق تے تُھو، آں ہأ کأفرا زید غم نہ کو، آں کامے مکاری یأ ہے کودی تھِین وجہ دے حی تینگی نہ کو۔
آں یقین کو اللہ تھأ خلگا سی سأت تُھو سے تقوای اختیار کودی، آں نیک کم کودی
پاک چھی سے ذات کی یأ تُنو بَن ڙأدو ڙأت مسجد حرام ما مسجد اقصیٰ ئے نوُ، (سے پوت یأ) کسی چاپ چاپیر زیت مھوئے برکت نازل کِدی تاکہ مھو تیس کے تُنو کآں نَخ پَشیٔ، بے شک سے (اللہ) ہر بات بُھویو والا آں ہر ہر شیئ پَشو والا تُھو۔
آں مھوئے موسیٰ (علیہ السلام) گے کتاب دِیدُوشو آں تَیس بنی اسرائیل سی کأ ہدایت سی زریعہ سوادوشُو کہ تھو مھأ چھیدے دوئی یس تُنو کَم سوؤ والا نہ سوا۔
(اے تھأ خلگا سی) اولادی کآم یأ مھوئے نوحؑ سَمانے (کِشتی ئے) اُگھالیشی، بےشک سے چیر شُکر کوؤ والا بَن اَشو۔
مھوئے کتاب می فیصلہ کیدے بنی اسرائیل مے بأت ما شِداد: "تھوئے دھیرین می دو گونا فساد کونین آں چیر سرکشی کونین"۔
دَ کے یأ تھأ دو واقیا می اول واقیا ہی دا، مھوئے تُھن ݜا آزیت تُنو مھال بَن بَھیأت کآم یأ چیر لاتکُوٹ اَشیئی، سے تُھن خارآئے لھینگدے خور ہوئی، آں أ مھال اے وعدہ أشی یأ ایسکے ضرور پورا ہوؤ اَشوُ۔
بھی مھوئے تھوئے موقع دِت کہ تھو نِڑتے تھأزیت غلبہ حاصل کوا، آں تُھن مال و دولت آں اولادی چیری کی، آں تُھن نفری مُش ما چیری کی۔
کہ تھوئے نیک کَم کِیوو تُنو فائدہ سی کأ کونِین، آں کو لاݜ کَم کِیوو تھیئے تُھن کأ لاݜ ہونِین، بس کے یأ دھویم واقعا سی وَخ اَپ تا مھوئے دأل دشمن تھو زیت مسلط کی، تاکہ سے تُھن گُنا نَھن، آں تاکہ سے جُمأت کے تھاموُ لھنگن کھأکأ یأ اول خلک لھنگیئشی، آں کآم کآم شیئی زیت تِھن ہات پیلَدوُو تیس تباہ و برَباد کوئن۔
ہوبھادوُ کہ تُھن پرورگار تھوزیت رحم کوے، اَسے کو تھوئے بھی تھأ کَم کیو مھوئے ہُم دھویم گونا تھأ کَم کونین، آں مھوئے دیزوخ کأفرا سی کأ قیدخانہ سیوأد تی۔
حقیقت أ چھی کہ أ قرآن تے پان پَشادوُ کامیک یا ٹولے ما زیات سِدا چھی، آں کامے خلک یأ (ایِزیت) ایمان أندے نیک عمل کودی تھأئے زیرے دَیدوُ کہ تِھن کأ گَھن اَجر تُھو۔
آں میس بَندوُ کہ کامے خلک یأ آخرت زیت ایمان نہ لَردی تِھن کأ مھوئے اے تکلیف دیؤ والا عذاب تیا کِدو۔
آں انسان لاݜ مھاموُ نِمادو کھأکأ یأ ایسکے خیر نِموؤ پکار تُھو، آں انسان چیر تیأدی گر تُھو۔
آں مھوئے دی و ڙات دو نَخا سی پوت پیدا کِدی، ڙأت سی نَخ أنچیگیل سَوات آں دی سی نَخ روخانا کی، میلائی تھو تُنو رَب سی فضل بِرڑا، آں میلائی تھوئے کالو مآ سی حساب معلوم ہوئے، ہر ہر شیئی جُدا جُدا واضحا کِدو۔
آں مھوئے ہر ماݜ سی (عمل سی) نتیجہ تِسی ماڑ وا تھیل دے چھیئی، آں قیامت سی دِئے مھوئے (تِسی) اعمال نامہ اے لیگیل سی شکل می نِگھال دے تیسکے مُخامُخ تھانین، تی تیس کولاؤ پَشنین۔
(تیس کے بنا بژنین گِھن) تُنو عمل نامہ پڑھاؤ کو! آش تو تُنو حساب سی کأ أمیدے پُورا تُھو۔
کامے ماݜ سِدا پَن دے تِلَدوُ دَ سے تُنو فایدا سی کأ تِلَدوُ، آں کآم گمراہی سی پان اختیار کودوُ دَ گمراہی سی نقصان ہُم تیسکے تُھو، آں ایک ہُم دوُئی سی بوجھ بھا نہ کودوُ، آں مھو یئیت ہُم عذاب نہ دیدی کھیدیخانگے پیغمبر (تِسی کأن گے) نہ پیوؤدُوو۔
آں کے یأ مھوئے اے گام سی تباہ کوؤ سی ارادا کِیو تِسی مالدا خلگائے (ایمان و اطاعت) سی حُکم کودی، بھی سے تھیت نافرمانی کو دی دا تھأزیت (عذاب سی) بات ثابت ہوژی، دَ بھی مھو تیس تباہ و برَباد کودی۔
آں کھیدیک نسل مھوئے نوحؑ ما بعد تباہ کی! آں چھی پروردگار تُنو بَنا سی گُنائے ما شِد تُھو، ہر کی پَشدو۔
کامے ماݜ دُونییٔ سی جلد فائدا نِمادوُ دَ مھو کیس کے کھیدیک نِمادی تیسکے اَںئی مھیت دیدی، بھی تِسی کأ مھوئے دیزوخ تیا کیدے چھیئی کِمی یأ تی رٹیل و کگیل لھنگنین۔
کامے ماݜ آخرت سی فائدہ نِمے آں تِسی کأ تھأل کوشش کوئے کھأکأ یأ پکار چھی آں سے مومن ہُم ہوئے دَ ہال خلگا سی کوشش سی پورا قدر کوا بژنین۔
(اے پیغمبر!) چھی رَب سی عطاء ما (دُونیئی می) مھو مھأئے ہُم دیدی آں مھأئے ہُم، آں (دُونیئی می) چھی پروردگار سی عطاء یِسی کأ بان نی چھی۔
بُودا مھوئے کھأکأ ہأ می ایک کے دُوئی زیت فضیلت دِت چی! آں یقین کو کہ آخرت درجا آسی اعتبار تے چیر گھین چھی، آں فضیلت سی اعتبار تے چیر زیات چھی۔
اللہ زیت دُوئی یَس معبود نہ سَوا، نأؤ تأ رٹیل و بےآسریآ دیھرتے بژنین۔
آں چھی پروردگار مے حکم دِتت تُو کے تِما علاوہ یِسی عبادت نوکو، آں ییئ و بوپ زیت غورا سلوک کو، کو ییئی و بوپ می ایک یا دھوںئیموُ چھی کأش ڈھگاچا ئے اَوئی دَ تھأئے اُف ہُم نوکو، آں نأئی تھأئے قارا بش، بلکہ تھأسیت عزتےدے (عزدیدے؟) بات کو۔
آں تھأسیت مِنا آں نرمی سی سلوک کو، تِھن مُوش اَمن عاجزی دے وا کو، آں مے دعا کو کہ اے مھی پروردگار! تو ہأزیت رحمت سی معاملہ کو کھأکأ یأ ہیئے مھی لیویئی می مھأ ساتُودوُ۔
تُھن رَب کے غورا پتہ چھی کہ تُھن حیا آمی کا تُھو، کو تھو نیک سَواگئی و سے تھأ خلگا سی غلطی چیر بوگوشَدوُ کآم یأ چیر چیر تِسی دِش کے نُڑَدی۔
آں رشتہ دار کے تِسی حق دے آں مسکین و مسأفر کے، آں تُنو مال فضول کما می نہ اَیا۔
یقین کو کآم خلک تُنو مال فضول کَما می اَیادی سے شیطان سی بَھئی تھی، آں شیطان تُنو رَب سی چیر گھن ناشکرا تُھو۔
آں کو یئیت اللہ سی رحمت سی طَما تأ ہأ (تُنو، سَکا آں مسأفِرے) ما مُو نَرادو تھأسیت نرمی دے بات کو۔
آں نأ دا (مھال بخیل ہوکہ) تُنو ہاتھ تُنو چونجو سیت گھن آں نأئی (مھال فضول خرچا ہوکہ) ہاتھ بالکل کولاؤ چھو یأ (أمیدے) ملامتیا سی لائق آں پریشان و شِشکال ہات دَھر۔
بے شک چھی رَب کیس کے نِمؤسأدو رزق چیری کودوُ آں (کیس کے یأ نِمؤسأدو) کمی کودوُ، یقین کو یرأ سے تُنو بَنا سی حال ما غورا شِد تُھو، آں تھأ پورا پورا پَشَدو۔
آں تُنو اولاد غریبی سی بِھت تے نہ مآ، مھوئے تھأئے ہُم رزق دینین آں تھوئے ہُم، یقین کوا ہِن موؤ چیر گھین غلطی چھی۔
آں زنائے نھیئی ہُم نہ ہوا، یقینًا ہے چیر گھین بے حیائی آں چیر لأݜ پان چھی۔
آں تے نفس نہ مآ کیس یأ اللہ محترم کیدوُ، ہاں کو (تھیئے شرعاً تِسی) حق تُھوو، آں کامے ماݜ ظلم دے ما گا و مھوئے تِسی ولی ئے (بدل) سی اختیار دِت تُو، بس تزیت لازم تُھو کہ سے مَوؤ می حد ما نُو نُخے، یقینًا سے مے بأت سی لائق تُھو کہ تِسی مدد کوا بژے۔
آں یتیم سی مال گے نھیئی نہ ہوا اَسے مھالے طریقہ دے یأ (تِسی حق می) غورا ہوئے۔ کھیدیخانا پورے یأ سے پوخ عمُوئے نہ اَوؤدوُو، آں وعدا پورا کوا، یقین کوا یرأ وعدہ سی بارا می (تھوکیژا) توَس کوا بژنین۔
آں کے یأ لیکھوُسأدو پورا لیکھا، آں وزن سی کأ صحی ڇیگے استعمال کوا، اَںئی ہے طریقہ صحی تُھو آں اِسی انجام غورا تُھو۔
آں کامے بأت سی تھیئے پتہ نی ہی و تیس پیش نہ ݜش! یقین کو یرأ کان، أݜی آں حی بُڑا سی بارا می (تھأ ما) توَس ہونین۔
آں دھیرین سی ڙیت لوئی دے نی تِل، نأ تُو دھیرین پھال بھادوُ آں نأئی تو اُڇات والے می کھنائے اَووبھادوُ۔
ہے ٹول لاݜ کَم مھال تھی یرأ چھی پروردگار سی چیر لاݜ ݜَژَدی۔
(اے پیغمبر!) ہے سے حکمت سی بأت تھی یأ چھی پروردگار تھیئے وحی سی زریعہ دے أوأت تی، آں (اے انسانأ!) اللہ سی ڙیت دوئی یَس خدا نہ سَوا، نأؤ تأ ملامت ہوئیل ٹھیلین دیزوخ کے تَھلا بژنین۔
خآ دَ تُھن پروردگار تھو جَدگ دیؤ سی کأ خوشأد، آں تُنو کأئی مُلیکائے ما سریأن سَوأت! حقیقت أچھی کہ تھو چیر گھین (لأݜ) بات بَندی۔
آں مھوئے مے قرآن می قِسم قِسم دے وضاحت کِدی میلائی ہے (خلک) جَنن اَسے سے دا لائی تَرؤ ہودی۔
تُو بن! کو اللہ سیت دأل خُدا ہُم ہوئیشیو کھأکأ یأ ہے بَندی، دَ ہیئے عرش والا (حقیقی خُدئی) سی دِش کے کآں پان نِگھالنین دے۔
پاک آں چیر اُچات چھی تِسی ذات، تھیئے بأدے ما کأم یأ ہے سَوادی۔
سات آسمانو دھیرین آں تِھن اندر سی مخلوقات بُٹ تِسی پاکی بیان کودی، آں اے شیئی مھال نُو تُھو یأ سے تِسی صفت سیت ورسرہ تِسی پاکی بیان نہ کودوُ، اَسے تھو تِسی صفت ما نہ جَندی، بے شک سے چیر برداشت کوؤ والا آں چیر بوگوشُو والا تُھو۔
آں (اے پیغمبر) کے یأ تُو قرآن بندوُو مھو چھی و ہأ خلگا سی می کآم یأ آخرت زیت ایمان نہ اَندی اے نہ پَشو والا پردہ تَھلَدی۔
آں مھو تِھن حیا زیت مھال پردہ تھلَدی یرأ سے تِما نہ جَنن، آں تھِن کن اِگئی کودی، آں کے تُو قرآں می تُنو رَب اَمن سیت ییدادوُ دَ ہے خلک نفردےدے مُو نرأ دے ڈیدی۔
مھوئے غورا پتہ چھی یرأ ہے خلک کے چھی بأت کے کان تھأدے بُھویَدی دا ہے کئی بُھویدی، آں کے ہے ایکدی سی کَنا می ٹُھسٹھسأ کودی، (یعنی) کے ہے ظالم میس بَندی یرا تھو دا بس مھال اے ماݜ سی پأش پأش ریوان ہوئیدی کیزیت یأ جادو ہودوُ۔
بودا! ہیئے چھی بارا می کھال کھال مثال دِتتی، ہے (سِدا) پَن ما گُمراہ ہوئیدی، بس ہے (سِدا) پَن گے نہ یے بھادی۔
آں ہے بَندی "کئی یأ مُھن وجود ہر سَوا بیشتے چورا چورا ہُوئیو مھوئے دُوآر نیمی کیدے بھا کوا بژنین؟"
بن کہ تھو باٹ یا چِمو ہُم سوا بَژا،
یا مھالے مخلوق کسی بارا می تھو حی می مے سوچ کودی کہ (تِسی جینی کوؤ) دوئی ہُم بُکھو تُھو، مھیرے تھیئے بننین "مھو کی دھویم گونا جینی کو نین؟" بَن! اَںئی تی جینی کونین کی یأ تھو اول گونا جینی کِشی، بھی تھیئے چھی مُوش ݜا لَشأ لَشأ دے بننین ہاموڑ کے ہونین؟ تُو بَن "ہو بھادو سے ساعت نھیو تُھو"۔
کامے دی تی تھوئے چاڑ کونین دا تھوئے تِسی صفت کوئن تِسی حکم من نِن، آں تھوئے مے گمان کونین یرأ تھو (دونیئی می) دھأک شانا مُدا دھریئشی۔
آں مھی بَنائے بَن کہ: اَںئی تے بات بنا کامیک یأ ٹولے ما غورا چھی و، حقیقت می شیطان خلگا سی حیآ وا فساد تَھلدوُ ، یقینًا شیطان انسان سی واضحا دشمن تُھو۔
تُھن پروردگار تھو غورا پأنَدو، کو تی نِمادو تھوزیت رحم کوئے، آں کو تی نِمادو تھوئے عذاب دو، آں (اے پیغمبر!) مھوئے تھأ ہِن بأدا سی ذمہ وار سَوادے نہ پیؤدوُ۔
آں چھی پروردگار تھأ ٹول پیانَدوُ کآم یأ آسمانو دھیرین می تھی، آں مھوئے یام پیغمبرائے دأل پیغمبرا زیت فضیلت دِت چی، آں مھوئے داؤد (علیہ السلام) گے زبور دِیدوشوُ۔
بَن کآم یأ تھو اللہ ما سوا عبادت سی لائق گھنَدی تھأئے چاڑ کیدے بُوا، تھیئے نأدا تھوما کی تکلیف دھگو کو بھانین آں نأئی تیس بدل کو بھانین۔
کیس کے یأ ہے چاڑ کودی، سے دا أمیدے تُنو پروردگار کے اَوؤ سی ذریعہ بِھرڑدی، یرأ ہأمی کآم اللہ ئے زیات نھیئی ہوئے، آں سے تِسی رحمت سی اُمید لَردی، آں تِسی عذاب ما بھیدی، یقینًا چھی رَب سی عذاب بِھت سی شیئی تُھو۔
آں اے گام مھال نُو تُھو یا تیس مھو قیامت سی دی ما مُوش تباہ نہ کیئی، یا تیس کے سخت عذاب نہ دَئی، ہے بات (تقدیر سی) کتاب می لگا گیئی۔
آں مھو نخا سی پیؤ ما دوئی کی شیئے نأ بلکہ می بأدے منع کی دی کہ مُشِک خلگے ہال نَخ لوو گھنیئشی، آں مھوئے قوم ثمود کے اُخأن دِدیشی یأ أݜیاَ سی پَدا کوؤ گے پُورا أشی، اَسے تھیئے تیزیت ظلم کی، آں مھو نَخ صرف بھیوؤ سی کأ پیدی۔
آں (اے پیغمبر تے وَخ یاد کو) کے مھوئے تھیئے بنوشُو کہ چھی پروردگار (تُنو علم دے) ٹول خلگا سی احاطہ کیدو، آں مھوئے تھیئے کامے نظارہ پَشادتا تیس (کأفر) خلگا سی کأ اے فتنہ سَوات، آں تے تھام ہُم کامیک زیت قرآن می لعنت کوا گیئی، آں مھو دا تھأ بھیا ییدی، اَسے اِندے تِھن سرکشی سخت چیری ہوژی۔
آں تے ساعت یاد کو کے مھوئے مُلیکآئے بنوشُو یرأ آدمؑ گے سِجدا کوا، دَ تھیئے سِجدہ کی اَسے اِبلیس سِجدا نہ کی، (تی بنُو) "آ تیس کے سِجدہ کیئی کیس یأ تأ سُم ما پیدا کیدو؟"
تی بنُو: "بنادا ہے سے مخلوق چھی یأ کیس کے تأ مھی مقابلہ می عزت دِتچی!"
(اللہ) بنُو: بَش بھی تھیئے (خلگے) ما کآم یأ چھی پأش تِلوو دَ بے شک دیزوخ تُھن سزا ہونین، مکمل آں پورا پورا سزا۔
آں ہأمی کیزیت چھی وَس پیلی و تیس تُنو آواز تے گمرا کو، آں تھأزیت تُنو گھوآ زیت سور آں پیادہ تِلُو والا سی فوج تے حملہ کو، آں تِھن مال و اولاد می تُنو حصہ ݜژا، آں تھأزیت غورا وعدہ کو، آں شیطان تھأزیت کا وعدہ یأ کوؤسیادو سے دوکا ما علاوہ دوئی کی نہ ہوژی۔
یقین کو یرأ کامیک مھی بندا تھی دا تھأئے چھی کی وَس نہ پیلنین، آں چھی پروردگار تھین حفاظت کے پورا تُھو۔
تُھن پروردگار سے تُھو کآم یأ تُھن کأ دریاب می کِشتی چَلادوُ، میلائی تھو تِسی فضل بِرڑا، یقینًا سے تھوزیت چیر رحمت سی معاملہ کوؤ والا تُھو۔
آں کے یأ دریاب می تھوئے کی تکلیف اَوَئی و کامے (خُدئیائے) تھو چأڑ کودی دا سے ٹول ہڙَژدی، بھی کے یأ اللہ تھو بچ کیدے شوگھین گے اَوادوُ دَ تھو مُو نُڑادی، آں انسان چیرگھن نا شُکرا تُھو۔
دَ کئی تھوئے مے بأت سی کی بِھت نی چھی کہ اللہ تھو دھیرین سی اے حصہ سَمانے ڈوُب کوئے؟ یائی تُھن ڙیت باٹ مُوژؤ والا بیلأئی پے، بھی تھوئے سأتویلی سی کأ یام میلاؤ نہ ہوئے؟
آں تھو مے بأت ما ہُم بے فکر ہوئیدی کہ سے تھو دُوآر تیس (دریاب)کے نَئیے؟ بھی تُھن ڙیت بیلیئی سی طوفان پیدے تھو تُھن ناشکری سی سزا می غرَک کوئے؟ بھی تھوئے یام میلاؤ نہ ہوئے یأ اے معاملہ می سے مھو کیژا توَس کوئے؟
آں حقیقت أ چھی کہ مھوئے آدم سی اولاد کے عزت دِت چی، آں تھأئے دریاب و دھیرین زیت سورلی دِت تی، آں تھأئے پاک شیئیے ما رزق دِت چی، آں تھأئے تُنو چیرگن مخلوقا زیت گھینیئی دِت چی۔
تے دی (یاد کو کے) مھوئے تمام انسانائے تِھن اِمامے سَمانے چاڑ کونین، بھی کیس کے تِسی عمل نامہ سُوَن ہات می دیا گأو تی تُنو عمل نامہ پڑھاؤ کونین آں تھأزیت اے خَس ہُم ظلم نہ ہونین۔
آں کامے ماݜ دُونیئی می اَن ہوؤ تی آخرت می ہُم اَن بلکہ دُوئی ہُم (سِدا) پَن ما گمراہ ہونین۔
آں (اے پیغمبرؐ) مھوئے وحی یأ تھیئے پیئی دا ہے (کأفر) خلک تھأ فتنہ وا تھیل دے تِما دھوگو کوؤدوُد، تاکہ تو تِما علاوہ دوئی کآں بات مُھن نام دے سوأدے پیش کو، آں تھلائی ہیئے تھأ تُنو سأت سوانیندے۔
آں کو مھوئے چھی قدم مضبوط نی کِشیو تأ ہُم تِھن دِشکے کآں نا کآں بژنین دے۔
آں کو ہامُوڑ ہُوشوو مھوئے تھیئے دُونیئی می ہُم دُوگن سزا دینین دے آں آخرت می ہُم، بھی تأ مُھن مقابلہ می یام مدد کوؤ والا نہ پانِین دے۔
آں ہے مے فکر می ہُم تھی کہ مے (مکہ سی) دھیرین ما چھی کُھوآ سی دیا بژے، تاکہ تھأ مھیدا بھار کے نکھالَن، آں کو ہامُو ہوؤ ہیئے ہُم تھأ آ بعد چیر ساعت نہ دھربھانین۔
ہےمُھن سے طریقا تُھو کامیک یأ مھوئے تُنو تھأ پیغمبرا سیت کِشو کامیک یأ مھوئے تھأ ما مُوش پیئشی، آں تأ مُھن طریقا می کی بدلوُن نہ پانین۔
(اے پیغمبرؐ!) سی بیو سی وَخ ما ڙأت سی أنچگا پورے نماز گُوزا، آں ڙات سی ساعدا قرآن سی تلاوت پابندی دے کو، بے شک ڙات سی تلاوت سی ساعدا (فرشتا آسی) حاضری ہوژی۔
آں ڙأت سی کآں اے حصہ می تہجد گُوزا، ہے چھی کأ اے خیوا (خیواگڑے؟) عبادت چھی، اُمید تُھو یرأ چھی پروردگار تھأ صفت سی قابل مرتبائے اَوانین۔
آں مے دعا کو کہ: اے رَبأ! مھأ کھأدے لنگھادُوو غوراتوب تے لَھنگا، آں گھیدآئے نِگھالَدُوو غوراتوب تے نِگھال، آں مھیئے خاص تُنو دِشا غلبہ و مدد دے۔
آں بَن کہ حق اَوؤ آں باطل ہڙات، آں یقینًا باطل اَںئی ہال ہاڙیُو والا شیئی تُھو۔
آں مھو تے قرآن نازل کودی کامیک یأ مومن آسی کأ شفا آں رحمت چھی، البتہ ظألِما سی حصہ می نُقصان ما علاوہ دُوئی کی شیئی چیری نہ ہودوُ۔
آں کے یأ مھوئے انسان گے کآں نعمت دِدو سے مُو نرادُو آں ڈھار بدلادُو، آں کو یئت اِیزیت کی مصیت أبو ہے حی ڈیگادُو۔
بن کہ: ہر ماݜ تُن تُنو طریقا دے کام کودوُ، ہے پتہ دا اللہ ئے چھی کہ کآم سِدا پَن زیت تُھو۔
آں (اے پیغمبر!) ہے خلک تھیکیژا روحا سی بارا می توَس کودی، تُو بَن کہ روحا مھی پروردگار سی حکم دے (سویل) چھی، آں تھوئے کامے علم دیا گودو دا سے بس دھأک شانا تُھو۔
آں کو مھوئے نِمادو کامے وحی مھوئے تھیئے پیئیی دا تیس ٹول واپس نیئی، بھی تِسی (واپسی سی) کأ تھیئے مُھن مقابلہ می یام مددگار میلاؤ نہ ہونین۔
اَسے ہے دا چھی رَب سی ڈھأرا اے رحمت چھی، حقیقت أ چھی کہ تِسی کامے فضل یأ تھزیت ہودوُ دا سے چیر گھن تُھو۔
بَن یرأ: کو انسان و پیر ہُم مے کم سی کأ جمع ہُوئیو کہ سے مے قرآن سی شانے دُوئی کلام سیوأدے اَنن و تھیئے یئت ہال نہ اَن بھانین، کو سے ایکدی سی چیر ہُم مدد کوئن۔
آں مھوئے انسانا سی خیگڑا سی کأ مے قرآن می قِسما قِسم حکمت سی بأت واضحا طور تے بیان کِدی، بھی ہُم چیر خلک انکار ما علاوا دُوئی کی بأت کے راضی نی تھی۔
آں سے کئیدا: مھوئے تھیزیت تے وَخا پورے ایمان نہ اَن نین کھیدیخانگے تأ دھیرین پھألدے مھوئے اے اوسو نہ نِگھالودُوو۔
یائی چھی کأ خورما و دَݜا سی اے باغ پیدا ہوئے، آں تُو تِسی می دے دھیرین پھألدے کآن نِگھل۔
یائی آسمان ٹوٹا ٹوٹا کیدے کھأکأ یأ تُو دعوی کودوُ دا ایس مُھن ڙیت وال، یائی بھی اللہ و مُلیک مھوئے مُخامُخ آن۔
یا چھی کأ لگھور زَرسی اے شِیر سَوا بژے، یا تُو آسمان گے اُخ، آں مھوئے چھی اُخو ہُم تے ساعدا پورے نہ مَن نین کھیدیخانگے تأ مھو زیت مھالے کتاب نازل نی کیدوُو یأ تیس مھو پڑھاؤ کیئی، (اے پیغمبر!) بَن کہ: "پاک تُھو مھی پروردگار، آ دا اے انسان تُھو، یأ پیغمبر سیوأدے پیا گودُو"۔
آں کے تھأ خلگائے ہدایت سی پیغام اَپ تہ تھأ ایمان سی اَنو ما اَںئی می بأدےکَھمئی شی کہ سے بنودوُد: "کئی، اللہ اے انسان رسول سیوأ دے پیودُو؟"
بن کہ: کو دھیرین می یئت مُلیکا سُمأدا تِلودوُو مھوئے بے شک کآں مُلیکا آسمان ما رسول سیوأدے ہأزیت والنین دے۔
بن یرأ: اللہ مھی و تُھن میئے گواہ سَوا بیو سی کأ کافی تُھو، بے شک سے تُنو بَنے ما پورا پورا شِد تُھو، ہر کی پَشَدو۔
آں کیس کے اللہ ہدایت دیدُو اںَئی سے سِدا پَن دے ہودوُ، آں کامے خلک یأ تی گمراہی وا تَھلیئیو تِھن کأ تأ تِما علاوہ مددگار نہ پانین، آں مھوئے قیامت سی دِی تھأ مھامُوڑ موتھلأ جمع کونِن، کہ تھیئے اَن بو آں چار ہونِن، تِھن ٹھکانا جہم ہونین، کے ہُم (تِسی آنگا) دھأک شِدیلی ہوؤ مھوئے تیس لائی پووڑانین۔
ہے تِھن سزا چھی کئیکہ تھیئے مُھن آیادا سی اِنکار کِشو، آں میس بنوشُو کہ: "کئی مھو (مئیدے) ہَر سوا گئی آں چورا چوری ہُوئیو مھوئے بھی ہُم دُوآر جینی کیدے بھا کوا بژنین؟"
کئی ہے مھیدیک بأت ما نہ جَنیئی کہ سے اللہ کی یأ بُٹ آسمان و دھیرین پیدا کِدی سے مے بأت زید قادر تُھو کہ سے ہِن چَھلے خلک دُوآر پیدا کوئے، آں تی تِھن کأ اے مھال نیٹا مقرر کِدو یأ تِسی ییوؤ می اے پِھٹ شَک نی چھی، بھی ہُم ہے ظألم انکار ما علاوہ دُوئی کی بأت زیت راضی نی تھی۔
(اے پیغمبر ہأ کأفرائے) بَن: کو مھی پروردگار سی رحمت سی خزان یئت تُھن اختیار می ہوئیشیو تھوئے لَھسُو سی بِھت تے تھأ خامخا کَھم نِندے، آں انسان چیر تانگ حیا آں بخیل تُھو۔
آں مھوئے موسیٰ (علیہ السلام) گے نوم واضحا نَخ دِیدیشی، مھیرے بنی اسرائیل ما توَس کو کہ کے یأ سے تھأ خلگا سی کأن گے گئی دا فرعون تھأئے بنو کہ: "اے موسیٰ! چھی بارا می مھی خیال تُھو کہ کیںئے تھیزیت جادو کِدوُ۔"
(موسیٰ علیہ السلام) بنُو: تھیئے غورا کیدے پتہ چھی کہ مھأ ٹول نَخ دوُئی یی نأ بلکہ دھیرین و آسمانا سی پروردگار جَنَوؤ سی کأ پیدا کی دی، آں اے فرعونأ! چھی بارا می مھی گمان أ تُھو کہ چھی برَبادی ییوؤ والا چھی۔
بھی (فرعون) مے ارادہ کِشی کہ ہأ (بنی اسرائیل) مے دھیرین ما نِگھالی، اَسے مھوئے تیس آں کھیدیک خلک یأ تیسیت اَشیئی دا ٹول غرک کی۔
آں تِما بعد مھوئے بنی اسرائیل گے بنُو: تھو دھیرین می دَھرا، آں کے آخرت سی وعدہ پورا ہیوو مھوئے تھو بُٹ جمع کیدے حاضر کونین۔
آں مھوئے مے قرآن حقے دے نازل کِدو، آں حقے دے ئی ہے نازل ہودُو، آں (اے پیغمبرؐ) مھوئے تھأ دُوئی کی کَم سی کأ نأ بلکہ صرف مِسی کأ پیؤدو کہ تُو (فرمانبردارائے) زیرے دے آں (نافرمان) خبردار کو۔
آں مھوئے قرآن سی جدا جدا ٹوٹا سَوأت، تاکہ تُو ایز شوب شوبے خلگا سی مُوش بَن، آں مھوئے ایز دھأگ دھأگ نازل کِدو۔
(کأفرائے) بَن تھو ایزیت ایمان اَنا یا نہ اَنا، کے یأ ہے (قرآن) تھأ خلگا سی مُوش بنا بژَدوُ یأ تھأئے اِما مُوش علم دیا گشُو، دَ سے ہأریݜ تھأدے سجدہ می بژدی۔
آں سے بندی: "پاک تُھو مُھن پروردگار، بیشک مُھن پروردگار سی وعدہ دا لازمی پورا ہوژی"۔
آں سے ڙینگین ہأریݜ تھأدے لار بَژَدی، آں أ (قرآن) تِھین حِیا سی عاجزی لا چیری کودوُ۔
بَن یرأ: تھو اللہ ئے ڇاڑ کودی کو رحمن گے چاڑ کودی، کامے نام دے ئی اللہ ئے ہاگادیو (اے شیئی تُھو)، کئی کہ بُٹ شیژو نام تِسی تھی، آں تُو تنُو نماز نأدا چیر اُچات آواز تے گُوزا، نأئی چیر غلے آواز تے، بلکہ ہأ دوُںیا سی مئیمو سی پان گَݜ۔
آں بن یرأ! ہیما صفت تے اللہ ئے ثابت تھی کی یأ نأ پو سَوادتُو نأئی تِسی بأچیئی می یام شریک تھی، آں نأئی تیس کے کمزوری ما بچ کوؤ گے یام مددگار پکار تُھو، تِسی گھینیئی مھامُو بیان کو کھأکأ یأ تِسی گھینیئی سی بیان کوؤ سی حق تُھو۔
ٹول صفت اللہ سی کأ تھی، کی یأ تُنو بن زید کتاب نازل کیدو، آں تِس می کی کولا نہ چھوؤدو
سیدا کتاب تُھو میلائی سے خلق بھے سخ عذاب ما اللہ سی دیشا آں زیرے دو مومنائے، تھأ خلگائے یأ نیک عمل کودی، بیشک ہین کأ غورہ بدلہ (جنت) چھی۔
ہیئے تِس میں ہمیشہ سی کأ دھرنین
آں سے تھأ خلگ بھے کام یأ بنہ دی اللہ اے پو گات تُو
تھأ سیت مے بأت سی کی علم نہ تُھو آں نأئی ہین بوپ داد کے (علم) تھو۔ أ چَیر گھین بات چھی یأ ہین أں ما نُوخژی۔ ہے خلگ نہ بنہ دی مگر لوؤ (ہے خلگ لوؤ سَوادی؟)
شاید تأ تنو سا دینین ہأ پیش غم سی وجہ دے کو ہیئے خلگے ایمان نہ آنوؤ مے کلام (قرآن) زید
بیشک مھوئے سَواد تو کا یأ دھیرین زید تُھو شیژواچا مے دھیرین سی، میلائی مھو آزمیخ کیئ مھأ خلگا سی کام ہأ می غورا عمل کوؤ والا تُھو
آں مھوئے سَوانین (قیامت می) کا یأ دھیرین زید تھو صفا میدان
آیا تُو خیال کودو ہے بھیل والا (اصحاب کہف) آں چیویل والا مُھن نیخانا ما تھی؟
کے یأ دھأک زوانے پناہ گھین بھیل می دَ تھیئے بنو اے مُھن ربأ مھوئے تنو دیشا رحمت دے آں مُھن کأ مُھن کم می آسانتیا پیدا کو
دَ مھوئے پردہ تھلو ہین کنا زید بھیل میں دھأک کال (مھوئے ہأئے نین أنی)
بھی مھوئے اُوشأت ہأ میلأئی مھو اخکارہ کیئ کامیک مھأ دُو ڈلہ می شمار کودی تے مُودا ہے دھریئی شی بھیل می۔
مھو بیان کودی تھأئے ہین خبر حقے دے، بیشک ہے دھأک زوآن اَشی ہیئے ایمان آنو تنو رب زید آں چَیری کی مھوئے ہین ہدایت
آں مھوئے ہین حی مضبوط کی یأ ہے اِڑی ہوئی ہیئے بنو مُھن رب سے رب تھو آسمانا سی آں دھیرین سی آں ییت ہُم مھوئے نہ ہاگانین تِس ما علاوہ دُوئی معبود کے۔ بیشک بینی ہونین مھوئے تے وخ می بے زایہ بات۔
أ مُھن قوم تھو ہیئے گأت تی اللہ تعالی ما علاوہ دأل خدا۔ ہے کئی نہ آندی تھأ زید کی واضح دلیل۔ دَ کام تھو گھن ظالم تِس ما یأ سے سَوادو اللہ زید لووو
آں کے یأ تھو تے (مشرک قوم) ما جُدا ہُوئی آں تھأ ما یأ ہے تھین عبادت کودی اللہ ما علاوہ۔ دَ تھو پنا گھینا بھیل می۔ دَ خور کونین تھو زید تُھن ربے تنو رحمت آں پیدا کونین تُھن کما می آسانتیا
آں تأ پشنین سی کے یأ نوخژی دا گژی ہین بھیل ما سُوون دِش کے آں کے یأ ڈوب ہوژی دا ہأ ما بچ ہے دے أبین دِش کے بژژی۔ آں ہے مے بھیل سی آرت پوت می تھی۔ أ اللہ سی قدرت سی نخ تھی۔ کِس کے یأ اللہ تعالی ہدایت کی د سے ہدایت والا تھو، آں کیس یأ گمراہ کی د تأ نہ پانین تِسی کأ یام مددگار پان پشؤ والا
آں تأ گمان کونین تھأ زید پیژیل آسی حالانکہ ہے ہُوویل تھی۔ آں مھو گیادی ہآ سوبین دِش کے آں أبین دِش کے۔ آں ہین کُوژوُے تھأدے تنو ٹھے بھیل سی چوکاٹ زید۔ کہ تو اچانک اخکارہ ہُو و ہأ زید دَ واپس ہونین تأ ڈے دے آں تھین رعب تھیزت خور ہونین۔
آں مھاموٹ مھوئے نین ما پیژأد تھأ میلائی ایگدی ما توَس کون، دَ بنو ہأمی اے بنو والا: "کھیدیک ہیسار ہُوئیدی مھیت؟" دَ ہے بنو مھو ہیسار ہوئیدی اے دی یا اَردی۔ ہیئے بنو تُھن رب غورا جنو والا تھو تِس مائی تھو کھیدیک ہیسار ہوئیدی۔دَ پیا اے جَن تھوئے ما مے پیسے دے (گھیندے؟) خار کے، د بوئے کام پاکیزہ خوراک والا تھو دَ تیس ما دھأک خوراک آنے۔ آں پکار تھو سے نرمی کوئے آں شید نہ کوئے تھو زید یام
بیشک کو ہے خلق شید ہوئی تھو زید ہیے تھو سنگسار کونین یا واپس کونین تنو دین گے آں تے وخ می تھلا تھوئے کامیاب نہ ہونین ہمیشہ سی کأ
آں مھاموڑ مھوئے شید کی خلک ہأزید میلائی ہے جَنن، بیشک اللہ سی وعدہ حق چھی آں قیامت می کی شک نی چھی۔ کے یأ خلک لات کوؤدود ایگدی می ہین (اصحاب کہف سی) بارہ می، دَ ہیئے بنو تھو سَوا ہأزید آبادی، ہین رب غورہ جنو والا تُھو ہین حال زید، بنو تھیئے خلگے کآم یأ زوروڑ آشی تنو کم زید خامخا مھوئے سوانین ہأ زید جُمات
یام خلک بَندی ہے ڇا جَن آشی آں چوٹھم ہین کُوژو آشو۔ آں یام بَندی ہے پانئی آشی ݜوم ہین کُوژو آشو۔ أ ٹول اَٹکل بأت تھی۔ آں یام بَندی ہے سات آشی آں اٹھم ہین کُوژو آشو۔ تو بن مھی رب غورا جنو والا تھو ہین صحیح تعداد ما۔ نہ جَندی ہین تعداد ما مگر چیر کم خلک۔ دَ زیات بحث نہ کو ہین بارہ می مگر سرسری بحث آں نأئی ہین بارہ می یِس ما توَس کو۔
آں (اے پیغمبر) کی کم سی بارہ می مھامُو نہ بن یأ مأ مے کام لَلو (ڙادا) کونین۔
ہاں مھامُوڑ بن یأ کو اللہ تعالی نیمادو (مأ کونین) آں کے چھی آموݜا گا دَ تنو رب یاد کو آں بن مھی اُمید تھو مھی ربے تے بأت سی دِش کے رہنمائی کونین۔ تی ہدایت می ایز ما زیات نھیو ہونین
آں سے (اصحاب کہف) تنُو بھیل می ڇا سو کالے آں مزید نوم کال (قمری حساب تے) ہُوبیل آشیئ
(کو یام اِز می بحث کودو) دَ تُو بن اللہ تعالی بہتر جَندو یأ سے کھیدیک وخ ہُوبیل آشی۔ آسمان آں دھیرین سی ٹول غیب ما سے جَندوُ۔ سے کھیدیک شیژو پَشو والا آں بھُوژو والا تھو۔ تِیز ما علاوہ ہین یام مددگار نُو تھو۔ سے تنو حکومت می یام شریک نہ کودوُ۔
آں (اے پیغمبر) تھأ زید چھی رَب سی دیِشا وحی سی زریعہ دے کامے کتاب پیا گودو تیز بین دے بھُژا۔ یام نُوتھو سے تیسی بأت بدل کوے۔ آں تِیز ما علاوہ ییت ہم تھأئے پنا سی پوت میلاؤ نہ ہونین۔
آں تُو تنو آون کھم تھأ خلگا سیت یأ سے ژاد جھومُو تنو رب کے ہاگادی سے تِسی رضا سی طلب گار تھی۔ آں چھی أݜی دُونیئی سی زندگی سی شیژواچا سی تکل (تلاش) می ہأ خلگا ما دھُو نہ ہون۔ آں تی سے بات نہ بھُوش یأ تِسی حی مھوئے تنو یاد ما غافل کیدو آں تی تنو نفس سی خواہش سی تابعداری اختیار کیژی آں تِسی کام حد ما بھار کے نُخو تُھو۔
آں تُو بن حق تُھن رب سی دیشا آپ تُو۔ مھیرے کام یأ نیمادو سے ایمان آنے آں یأ نیمادُو سے کفر کوئے۔ بیشک مھوئے (مھال) ظالما سی کأ آنگا تیا کیدوُ تِسی دیوالے تھأ گیر کونین آں کو ہیئے فریاد کی دَ ہین فریاد سی جواب مھال اُو دے دیا بژنین تی گلیل گرم تانبا سی شانے ہونین۔ تی مُو دھژانین۔ چیر لاݜ شیئ ہونین پُو سی کأ۔ آں سے جہنم چیر لاݜ پوت تُھو آرام سی کأ۔
البتہ کامے خلگے ایمان آنُودو آں نیک عمل کیدو دَ یقینا مھو مھال خلگا سی اجر ضائع نہ کودی یأ سے غورا عمل کودی۔
ہے سے خلک تھی ہین کأ ہمیشہ سی دھرو سی باغ تھی، تھین ٹیندے کآن روان ہونین؛ ہأ تھید لھگُور زر سی بنگڑئیدے شیژیئی کوا بژنین، ہیئے نِل چنجل آں بار أشیم سی کوژو لَھیل ہونین، ہیئے اُوچات تغا زید ڈھأر تھلیل ہونین، کھیدیک شیژو اَجر آں کھیدیک غورا دَما سی پوت تُھو!
آں (اے پیغمبرؐ) تُو ہأ خلگائے تھأ دُو جنا سی مثال بیان کو، تھأ می ایک کے مھوئے دݜ سی دو باغ دیدیشی، آں تھأما مھوئے کجور آ سی تھام چاپیرا کیشی، آں تھأ سی می مھوئے فصل پیدا کیشو۔
ہے دُو باغ پورا پورا میوہ دیوؤدود آں میوہ سی دیوؤ می کی کمی نہ کوؤدود آں ہأ دو باغا سی درمیان می مھوئے کآن جاری کیشو
دَ تے ماݜ کے چیر دولت ہات کے أپ۔ تی تنو سأت سیت بأت کیدے بنُو مھی مال ہم تھأ ما چیر چھی آں مھی ڈلہ ہم تھأ ما چیر چھی
آں سے تُنو اَمن سید ظلم کویل تنو باغ می داخل ہُو، آں بنُو: "مھی خیال نہ تُھو می باغ یئد ہُم تباہ ہونین دا"۔
آں مھی خیال أ تھو قیامت ییت ہم نہ ینین۔ آں کو آ ییت تنو رب سی کأش کے واپس پیا گا و بھی ہم مھی یقین تھو مھئے ایس ما غورہ پوت میلاؤ ہونین۔
دَ تِسی سأت تیسیت بأت کیدے بنُو تُو تے ذات ما کفر کودو تی تھأ سُوم ما آں بھی نُطفہ ما پیدا کی آں بھی صحیح سالم انسان سَوات
کھیدیگا پورے یأ مھی تعلق تھو د آ مے عقیدہ ساتہ دُو یرأ مھی رب اللہ تعالی تھُو آں تںو رب سیت یام شریک نہ سَوادوُ
آں کے یأ تنو باغ کے لھنگو دا تے وخ تأ کئی نہ بنو "ماشاءاللہ لا قوۃ الہ بااللہ!"(اَںئی سے ہودو کا یأ اللہ نیمادو، اللہ سی توفیق ما بغیر یِسی کی زور نُو تُھو)، کو پشدو مھی مال آں اولاد تھأما کم تھی۔
دَ اُمید تُھو مھی ربے مھیئے چھی باغ ما غورا شیئی دینین، آں چھی باغ زید آسمانی آفت پےنین، تیدے تی صفا مئیدان می بدل ہیدے بژنین۔
یأ تِسی اُو دھیرین می شُوژنین آں بھی تے اُو کی چَھلے ہم حاصل نہ کو بھانین
آں بھی تِسی ٹول دولت عذاب سی گھیرا می أپ آں مے حالت می ڙات ہو۔ یأ تی تُنو باغ زید کا خرچ کیشو سے تیزیت تنو ہات کرمَڑوسأت، آں تِسی باغ تنو چھدا زید لار بژیل آشو آں سے بَنودود کاش کہ مأ تںو رب سیت یام شریک نہ سَوادوشو۔
آں تِسی کأ یام ڈلہ نہ أشی سے اللہ ما بغیر تِسی مدد کوئے دے آں نأ سے مِسی قابل آشوئی سے تنو دفاع کوئیدے۔
مھال موقع زید (ماݜ کے پتہ گھڑژی) یأ مدد سی کوؤ سی تمام اختیار سیال (؟) اللہ ئے حاصل تھی۔ سے اللہ تعالی تھوئے بہتر ثواب دیدو آں بہتر انجام پشادُو
آں ہأ خلگائے دُونئی سی مثال بیان کو سے مھامُوٹ ئی مھو آسمان سی دِیشا آگھا مُوژادی تیدے دھیرین سی گن نیلا نُوخہ دُو بھی سے شیش تے مھال زرے زرے ہودو ئی تیس ہوا بھا کیدے نژَژی، آں اللہ تعالی ہر شیئی زید مکمل قدرت لردُو
مال آں اولاد دُونیئی سی زندگی سی شیوژاچا تھو آں کامیک نیگی ہمیشہ دھُرو سی چھی سے چھی رب سی نیز تے ثواب سی اعتبار تے ہم بہتر چھی آں اُمید کوؤ سی اعتبار تے ہم بہتر چھی
آں تے دی یاد کو کامیک دی مھوئے کَھن ریوان کونین آں تأ دھیرین ڈاگا پشنین آں ہأ ٹول خلک مھوئے جمع کونین آں ہأ می مھوئے یس ہم نہ چھونین
آں ہیئے ٹولے چھی رب سی مُوش کے صفا می پیش کوا بژنین، آخر تھو مُھن کأش کے مھامُوٹ أئی کھاموٹ یأ مھوئے تھو اول پیرا پیدا کیشی۔ تھو دا مے گمان کودی مھوئے تُھن کأ کی نیٹہ مقرر نہ کیدو
آں عمل آ سی کتاب ہین مُخامخ تھابژنین؛ دَ تأ مجرم پشنین ہیئے بھیل ہونین تے شیئی ما یأ کتاب می (لیگیل) تُھو، آں بننین: "وَئی مُھن تباہی! أ کھال کتاب تُھو؟ اِی دا مُھن کی لؤ آں گھن عمل نہ چھوؤدو، اَسے (تیس) محفوظ کیدو"، آں ہیئے ٹول عمل اِیزمی موجود پانین، آں چھی پروردگار یزید ظلم نہ کودُو۔
آں تے وخ یاد کو کے یأ مھوئے مُولیگائے بنو مھوئے سجدہ کوا دَ ٹولے سجدہ کی سیوائے اِبلیس ما، سے پیرا ما آشو دَ تی تنو رب سی حکم سی نافرمانی کی۔ دَ تھو بھی ہم مھأ چھیدے تیس آں تِسی اولاد دوست گھنڈدی حالانکہ سے ٹول تُھن دشمن تھی۔ (اللہ تعالی سے) کھیدیک لاݜ متبادل تھو سے ظالمائے میلاؤ ہودو
مأ ہأ نہ آسمانا سی آں نأئی دھیرین سی پیدا کوؤ سی وخ می حاضر کیشی، نأ ہین تنو پیدا کوؤ سی وخ می، آں آ ہال گمراہ کوؤ والا تنو امدادی نہ سوادو
آں تے وخ یاد کو کے یأ اللہ تعالی (ہأ مشرگائے) بنین تھو ہاگا تھأئے یأ تھو تھأ مھی خُدائی می شریک گھنڈودود، د ہیئے ہاگا نین اَسے تھیئے کی جواب نہ دینین آں مھوئے ہین درمیان می ہلاکت والا پردہ تھل نین
آں مجرم خلگے آنگا پشنین دَ ہیئے یقین کونین دی (؟) اِیز می لار بژو تھو آں تیز ما بچ ہوؤ سی کی پان نہ پانین
آں مھوئے خلگا سی فائدہ سی کأ مے قرآن کریم می بار بار ہر قسم سی مضامین بیان کیدی، آں انسان تھو ہے لات سی کوؤ می ہر شیئی ما زیات تُھو
آں کے یأ خلگائے ہدایت أپ تہ مھیرے ہأ ایمان سی آنو ما آں تنُو رب ما معافی سی نیموؤ ما مے (بأت) ما علاوہ دُوئی کی شیئی منع نہ کودو یأ ہأسید ہم مُشیک خلگا سی کانا ہوئے یا عذاب ہین مُوش کے ییدے اِڑی ہوئے۔
آں مھو پیغمبر صرف مِسی کأ پیدی یأ ہے مومنائے زیرے دَن، آں کأفر عذاب ما بھیئن۔ آں کامے خلگے یأ کفر کیدو سے ناحق سی ڈوئیدے لات کودی، مِسی کأ یرأ تِسی زریعہ دے ہے حق کیمزیری کوئن، آں ہیئے خلگے مھی آیات آں کا شیئیدے یأ ہے بھیا بژدی دا تِسی پشاڑے سَوأد۔
آں تے ماݜ ما گھن ظالم کی ہونین یأ تیس کے تِسی رب سی آیادا سی حوالہ سے نصیحت کوا بژے آں سے تِس ما مو نرے آں تنو ہادا سی کوئیل کرتوت (؟) آموݜا تھلے۔ حقیقت أ چھی یأ مھوئے ہین (بد عملی سی وجہ سے) ہین حیا زید پردہ تھلودُو تِسی وجہ دے ہے می (قرآن) ما نہ جَندی، آں ہین کن اُوگو تھی۔ آں کو تأ ہأ ہدایت سی دیش کے نیمأد دَ ہے صحیح پن سی دیش کے ییت ہم نہ ییدی
آں چھِی پروردگار چیر بوگوشو والا تھُو، گھن رحمت والا تُھو۔ کامے (بدعلمی) کمائی ہیئے کیدی اگر تی تھین وجہ دے ہأ گݜُو سی ارادہ کیشی دَ ہأئے جلد عذاب دینین دے۔ لیکن ہین کأ اے مقرر وخ تھو تیما بچ ہوؤ سی کأ ہأئے کی پناہ سی پوت میلاؤ نہ ہونین۔
أ ٹول گام (چھی موش کے تھی) کے ہأ ہے ظلم سی طریقہ اپناؤ کی دَ مھوئے ہأ ہلاک کی آں ہین ہلاکت سی کأ مھوئے اے وخ مقرر کیشو
آں (تے وخ سی ذکر بھوش) کے یأ موسی تنو شاگڑ کے بنو: "مأ تے وخا پورے تنو سفر مُوا کوا یےنین کھیدیگا پورے یأ دُو سمندر آ سی دُوجنگائے آ نہ اَوؤدوو، نأو مأ کال و کال تِلا یےنین"۔
دَ کے یأ ہے دو (سمندر آ سی) مِیئے دُوجنگائے آوئیدا ہیئے تنو ماش اَموݜا تھلو، دَ تی (ماش) سمندر میں سرنگ سی شانے پان سَوأد۔
دَ بھی ہے دُوںئیدے تھیدا مُٹھائے گئیدا موسیٰؑ تنو شاگڑ کے بنو: "مھیرے مُھن تے ڙات سی گیل آن، بیشکہ تنو مے سفر می مھو چیر ٹھمئی"۔
دَ تی (شاگڑے) بنو سے دَ عجیبہ قصہ ہی شی۔ کے ہأ مھے تے چأل زید ہیسار ہوئیدا ماش سی ذکر مھأما آموݜا گوشو آں شیطان ما علاوہ دوئی یام نہ تھو یأ تی مھأما تِسی ذکر آموݜو۔ آں تی ماش عجیبہ طریقہ دے سمندر می ابن کے پان گأدیشی
(موسیؑ) بنو اے پوت سی دا مھو تلاش می آشیئ دَ ہے دوھیدے تنو قدما سی نشان بوئین واپس ہوئی
دَ ہأئے مُھن بنا می اے بن میلاؤ ہو (حضرت خضر) تیزیت مھوئے تنو خصوصی رحمت کِشی آں تنو دیشا تیس کے خصوصی علم ڇِھڙادوشو
موسیٰؑ تیس کے بنو: "کئی آ تھسید دھیری مے غرضیدے یرأ تھیئے کامے غورہ علم دیا گادو دا تِسی کآں حصہ مھیئے ہُم ڇِھیڙا؟"
تی (خضر) بنو مھی یقین تھو کہ تو مھیسیت صَوو نہ کو بھادو
آں کامے بأت سی یأ تھیئے پورا پورا واقفیت نہ چھی دَ تو تیزیت کھأکأ صوو کو بھادُو
موسی بنو ان شاءاللہ تأ مھأ صوو کوؤ والا پانین آں مأ کی معاملہ می چھی نافرمانی کونین
دَ تی (خضر) بنو ٹیک چھِی کو تو مھسیت بژو نیمادُو دَ کھیدیگا پورے یأ مأ کی بأت سی تذکرہ نہ کی و تأ مھأ ما کی شیئی سی توَس نہ کونین
دَ ہے دوھیدے روان ہوئی مھیدیگا پورے یأ ہے دوھیدے اے کشتی می سور ہوئی۔ دَ تی (خضر) کشتی می ڈونگ تھلو۔ دَ موسی بنو کئی ڈونگ تھلو میلائی ٹول خلک ڈوپ کوؤ نیمادُو میس تہ تأ چیر عجیبہ کام کی
دَ تی (خضرؑ) بنو: "مأ تھیئے نہ بنوشو یأ تُو مھیسید دھیرتے صوو نہ کو بھادُو؟"
دَ (موسی) بنو مھے کیژا کامے بات آموݜا گأئی و تو تیز می مھأ نہ گݜ آں مھی کام زیات بُکھو نہ سَوا
دَ ہے دُوںئیدے بھی ریوان ہوئی تھیدیگا پورے یأ ہین ملاقات اے پو سیت ہو دَ خضر تے پو قتل کی دَ موسی بنو ایس تہ تأ اے بے گناہ موؤ حالانکہ تی کی قتل نہ کیشُو یأ تِسی بدلہ گھینا بژے میس تہ تأ چیر لاݜ کام کی
دَ تی (خضر) بنو مأ تھیئے نہ بنوشو یأ تو مھیسیت دھیرتے صوو نہ کو بھادوُ
موسی بنو کو مھیرے مأ تھأما کی بأت سی توَس کی دَ تو بھی مھأ اوَن سیت نہ دھرا بیشک تو مھی عذر سی حد کے اَوؤدو
دَ ہے دوھیدے بھی ریوان ہوئی تھیدیگا پورے یأ ہے اے گام والا سی کأش کے اَوَئی دَ ہیئے تھیئے ما خوراک نیمات۔ دَ تھیئے خلگے ہین میلأݜتوب ما انکار کی۔ دَ ہأئے تھیت اے دیوال میلاؤ ہو سے لار بژو سی آشو دَ خضر تیس سیدا کی دَ موسی بنو کو تو خوشوؤدودو تأ مے کم سی اُجرت گِھننین دے
دَ تی خضر بنو أ مھأ و چھی جُدائی سی وخ آپ۔ مھیرے آ تھیئے تھأ بأدا سی مقصد بَندُو یأ تھأ زید تھأما صوو نہ ہوبھوؤ
کامیگ یأ کشتی سی معاملہ چھی دا سے دھأک غریب خلگا سی أشی سے دریاب می میزدی کوؤدود دَ مأ نیمات تیس می عیب پیدا کیئی کیئکہ تھأما مُٹھائے اے باچا آشو سے ہر روغ کشتی زبردستی دے قبضہ کوؤدود
آں تے پو سی معاملہ أ چھی یأ تِسی ییئی و باپ مومن آشِئ آں مھوئے مے بأت سی بھید أشی یأ ہے پو ہأ دوھیدے سرکشی آں کفر کے مجبور نہ کوئیدے
دَ مھوئے میس نیماد یأ ہین پروردگار ہأ دُوھائے مے پو سی بدلہ می مھال اولاد دو یأ سے پاکی می ایس ما بہتر ہو آں حسن سلوک می ایس ما زیات ہو
آں دیوال سی معاملہ أ أشی یأ ہے تے خار می دھرو والا دو یتیم جدَگا سی آشو آں ٹین تھین خزان دَویل آشو آں ہأ دوھینا سی باپ نیک ماݜ آشو دَ میسی کأ چھی پروردگار نیمات یأ ہے دوُ یتیم تنو زوأنی گے اوَن آں بھی تنو خزان نیگھالن۔ أ ٹول کم چھی رب سی رحمت سی وجہ سے ہوئی آں مأ کی کام تنو ارادہ سے نہ کیدو۔ أ أشی مقصد تھأ بیادا سی یأ تھأ زید تأ صوو نہ کو بھوؤ
آں ہے خلک تھأ ما ذوالقرنین سی بارہ می توَس کودی۔ تُو بن آ تیسی دھأگ شانہ حال تھوئے بیندے بھُوژا بھادو
واقعہ أ چھی یأ مھوئے تیس کے دھیرین زید اقتدار دیدوشُو آں تیس کے ہر اے کم سی وسائل دیدیشی
تِسی نتیجہ می سے اے مہم پیش ریوان ہو
مھیدیگا پورے یأ سے سی سی ڈوپ ہوؤ سی پوت کے آوؤ دَ تیس کے مھامُو پشا بژوُسأت یأ ہے اے کِݜن اُوس می ڈوپ ہیژی آں تیس کے تھیت اے قوم میلاؤ ہی۔ دَ مھوئے تیس کے بنو اے ذوالقرنین (تھأ سیت دو پَن تھی) یا دَ مھأ خلگائے سزا دے آں یا ہین معاملہ می غورا سلوک اختیار کو
دَ تی بنو ہأ می یأ کی ظلم سی پان اختیار کی دَ تیس کے مھوئے سزا دینین آں بھی تیس تِسی رب سی کأش کے آوا بژنین آں بھی تی ایس کے سخت سزا دینین
البتہ کی یأ ایمان آنو آں نیک عمل کی دَ تی بدلہ سی طور تے بہتر انجام سی مستحق ہونین۔ آں مھوئے ہم تیس کے تنو حکم سی دیؤ سی وخ می آسانی سی بات بننین
ایس ما بعد سے (ذوالقرنین) دوئی پن (مہم) پیش ریوان ہو
مھیدیگا پورے یأ کے یأ سے سی سی نُوخُو سی پوت کے آوؤ دَ تی ڈیڈ یأ ہے سی مھالے قوم زید نُوخژی یأ تھأئے مُھوئے اِسی تان ما بچ ہوؤ سی پردہ نہ سَوادوشو
واقعہ مھامُو أشی آں ذوالقرنین سیت یأ کامیک (سازوسامان) آشو مھوئے تِسی پورا پورا خبر أشی
ایس ما بعد سے اے دوُئی پن (مہم) پیش ریوان ہو۔
مھیدیگا پورے یأ کے سے دُو کھن آ سی مِیئے آوؤ دا تیسکے ہأما مُوش اے قوم میلاؤ ہُو، سے (اِسی) کی بأت ما نہ جَنودُود۔
دَ ہے (ترجمان سی زریعہ دے) بنو اے ذوالقرنین یاجوج ماجوج مے دھیرین زید فساد کوؤ والا تھی۔ دَ مھو تھأئے کا مال سی پیشکش کوبھادی؟ تیسی بدلہ می تو مُھن آں ہین درمیان کآں دیوال سَوا
دَ ذوالقرنین بنو اللہ تعالی مھیئے کامے اقتدار دیت تُو دا سے مھی کأ بہتر تھو لہذا تھو خلک ہات کُھوآ سی طاقت تے مھی مدد کوا دَ مأ تُھن آن ہین درمیان می اے مظبوط دیوال سَوانین
مھیئے چیمو سی څادر آنا مھیدیگا پورے یأ کے یأ تی دُونئی کھنا سی درمیانی پوت پین دے ہین ݜا ایک دی سیت میلاؤ کی۔ دَ بھی بنُو آنگا جالا۔ دَ کے یأ تی دیوال لھیگیری کی دَ بنُو مھیئے گالیل تانبا آنا دَ تیس ایزیت تھلنین
(دَ سے دیوال مھال سَوا گا) کہ یاجوج ماجوج اِسی ڙیت تے ہم نہ اوخ بھوؤدوت آں نأ تیس می کی سُورئ کوبھوؤدوت
ذوالقرنین بنو أ مھی رب سی رحمت چھی (یأ تی مھال دیول سی سوؤ سی توفیق دیت) بھی مھی ربے کامے وخ سی وعدہ کیژی کے یأ سے وخ آپ دَ تی مے دیوال ڈیگأدے دھیرین سیت برابر کونین۔ آں مھی رب سی وعدہ بالکل سأس چھی۔
آں تے دی مھوئے ہین مے حالت کونین کہ ہے ہیئے چپا سی شانے ایکدی سیت ٹکراؤ ہونین آں بیشیل می پھوک دیا بژنین آں بھی مھوئے ہأ بُٹ اے پوت جمع کونین
آں تے دی مھوئے دوزخ ہأ کأفرا سی أݜیا سی مخامخ آن نین
تھین أݜیا زید (دونیئی می) مھی نصیحت سی دِیشا پردہ تھلیل آشی آں سے کی بأت سی بُھوژو گے تیا نہ آشی
کامے خلگے کفر کیدو آیا ہے خلک مے گمان کودی یأ ہیئے مھأ چھیدے مھی بَن تنو کارساز سَوانین؟ یقین کوا مھوئے مھال کأفرا سی میلأݜ توب سی کأ دوزخ تیا کیژی
تُو بن (اے پیغمبر) آیا آ تھوئے بینی یأ کامے خلک تھی سے تنو عملا می ٹولا ما زیات ناکام تھی
ہے سے خلک تھی یأ دُونیئی سی زندگی می ہین ٹول کوشش ضایع ہوئی دی آں ہے مے گمان کودی یأ ہے غورا کم کودی
ہے سے خلک تھی یأ ہے تنو رب سی آیادے ما آں تِسی موش کے پیشی ما انکار کودی۔ مے وجہ دے ہین عمل ضائع ہوئی دی۔ دَ قیامت سی دی مھوئے ہین وزن نہ لیک نین
أ چھی جہنم سی شکل می ہین سزا کئیکہ ہیئے کفر اختیار کیشو آں مھی آیادا سی آں مھی پیغمبرا سی مذاق سَوادوشُو
(دُوئی ڈھأر کے) کامے خلگے ایمان آنودو آں نیک عمل کیدی ہین میلأݜتوب سی کأ فردوس می باغ ہونین
تھأ می ہیئے ہمیشہ سی کأ ہونین آں تھیدا دُوئی یأدے بژو نہ نیمانین
(اے پیغمبر) خلگائے بن یأ مھی رب سی بأدا سی لیگو سی کأ کو سمندر سی سَوا بَژے دے بھی رب سی بأدے ختم نہ ہونین۔ تیما مُوش سمندرے شُوشنین اگرچہ سمندر سی کمی سی پورا کوؤ سی کأ مھوئے مھال سمندر دُوئی ہم آنوو
تُو بن آ تُھن چھلے انسان تھو البتہ مھزیت أ وحی ییژی یأ تُھن ٹولا سی خدا اے خدا تُھو لہذا کیس کے یأ تنو مالک سیت میلاؤ ہوؤ سی امید تھو تیس کے پکار چھی یأ سے نیک عمل کوئے آں تنو مالک سی عبادت می دُوئی یام شریک نہ کوئے
کھیعص
أ ذکر تُھو تے رحمت سی یأ چھی پرودگار تُنو بندہ زکریا (علیہ السلام) زیت کِشی۔
کے یأ تی تُنو پروردگار کے غَلے غَلے آواز تے ڇاڑ کِشی۔
تی بنُو کہ: اے مھی پروردگار! بُودا مھی ہَر کیمزیری ہوئیدی آں مھی ݜا ڈھگاچا دے اُژیلی ہودوُ، آں مأ تھأ ما دُعا نِمأدے ییت نامراد نُو ہودوُ۔
آں مھیئے اَمن ما بعد تُنو تربورا (پڙی سی جدگا) ما بِھت چھی، آں مھی ڇھی شأن چھی، بس تُو خاص تُنو کأن ما مھیئے مھال اے وارث دے۔۔
یأ سے مھی ہُم وارث ہوئے آں یعقوب (علیہ السلام) سی اولادی سی ہُم میراث پَئے۔ آں اے پروردگار تیس مھال سوا یأ چھی تُنو ہم خوش ہوئے۔
(آواز آپ کہ) اے زکریا! مھو تھیئے مھال اے پو سی زیرے دیدی یأ تِسی نام یحییٰ ہونین، تِما مُوش مھوئے اے نام سی ییز ہُم پیدا نہ کِیدوُ۔
زکریا (علیہ السلام) بنُو "اے مھی پروردگار! مھی (شِیرے) پو کھأکأ پیدا ہونِین؟ حالانکہ مھی ڇھی دا شأن چھی، آں آئی ڈھیگی ہیدے مے حال گے اُوَؤدوُ کہ مھی بدن شُک تُو۔"
کیئدا ہاں! اَںئی ہامُو ہونِین، چھی ربے بنُودو کہ ہے دا مھی کأ معمولی بات چھی۔ آں یقینًا اِما مُوش مأ تھأ پیدا کِشوُ کے یأ تُو کی ہُم نہ اَشو۔
زکریا (علیہ السلام) بنُو کیئدا: اے مھی پروردگار! مھی کأ کںآں اے نشأنی مقرر کو۔ تی بنُو: چھی نشأنی أ چھی کہ تأ روغ جوڑ ہوؤ سی باوجود خلگا سیت ڇا ڙأت بأت نہ کو بھانِین۔
بس سے عبادت خانہ ما نِختے تُنو قوم سی کأن گے آپ آں تھأئے اِشارہ دے بنُو کہ تھو ڙادو نیاشاما اللہ سی (نام سی) تیسپے گا۔
(بھی کے یأ یحیٰ علیہ السلام پیدا ہیدے گھینی ہودا مھوئے تیس کے بنُو) اے یحییٰ! کتاب جُخ گݜ، آں مھوئے لیویئی می تیس کے ہُشاتوپ ہُم دِیدوشُو۔
آں خاص تُنو دِشا حی سی نرمی آں پاکی ہُم دِیدیشی، آں سے گھن پرہیزگار اُشو۔
آں سے تُنو ییئی و بوپ سی خذمت گا اَشو، نأ سے ناڑاما اَشو نأئی نافرمان۔
آں (اللہ سی) سلامتیا چھی تیزیت، تے دی ہم کے یأ سے پیدا ہوشُو، آں تے دی ہُم کے یأ تیس کے مئک یینن، آں تے دی ہُم کامیک دئے تیس دھویم گونا جینی کیدے اُشانِین۔
آں مے کتاب (قرآن پاک) می مریم علیھا السلام سی ہم تذکرہ کو، تے ساعت سی تذکرہ کے یأ سے تُنو شیر والآ ما جُدا ہیدے تے پوت کے گأ کامیک یأ مشرق سی دِش کے اَشو۔
بھی تی تنُو آں خلگا سی مِیئے پردہ تھلُو، تھلا مھوئے تنُو روح (فرشتہ) پیئی سے پورا انسان سی شکل میں اخکارا ہی۔
مریم علیھاالسلام بنُو: آ تھأما (تھیکیژا) مہربان خُدئی سی پناہ نِمائی، کو تھأمی خُدئی سے بِھت چھی و (مھیدا دھو ہو)
(مُلیکا) بنُو: آ دا چھی رَب سی پیئل (مُلیگ) تُھو (آ مِسی کأ اپ تُو) یأ تھیئےاے پاکیزہ پو دَئی۔
مریم علیھاالسلام کیئدا: "مھی پو کھأکأ ہونِین؟ حالانکہ نأ ییت کی انسان مھیئے ہات دِت تُو آں نأئی آ بدکار جَوَئی چھی"۔
مُلیگ بنُو: اَںئی ہامُو ہونِین، چھی رب بَندوُ ہے مھی کأ معمولی بات چھی۔ آں مھوئے مے کام کھأئیمو کونِین یأ أ پو (تُنو قدرت سی) نشأنی سَوے، آں تُنو دِݜا رحمت سی مظاہرہ کوے، آں اے بأت سی فیصلہ (مُوش ما) ہویل چھی۔
بھی ہے (لَؤ) مریم علیھاالسلام سی ڈھئے گا (آں کے یأ پیدائش سی ساعت نھیو ہُو دا) تی تیس گِھن دے خلگے ما دُھو اے پوت کے گأ۔
بھی جھال سی شُل تیس کجُور سی اے تھام سی کأن گے نی، تی بنُو! کاش آ مِما مُوش مُوئیشی و (مُوئیشیو) آں اَموݜا تَھلا گیشی و (کھیدیک غورا ہونین دے)۔
بھی (ملیکا) تیس کے تِسی ٹینا اے پوت ما ڇاڑ کی: "غم نہ کو چھی ربے چھی ٹینا اے اوسو نِھگالودوُ۔"
آں کجُور سی تنا تُنو دِش کے پھرَگا، اِما پَژیل تازہ کجُور تھیزیت مُوژنِین۔
مھیرے کھو و پُو آں تُنو أݜی شِدیلی کو، آں خلگے ما کیس تأ ڈِیڈو اِشارہ دے بَن کہ آش مأ خُدئی سی کأ اے ڙوز منودوُ، اِسی وجہ دے مأ اے انسان سیت (ہُم) بأت نہ کونِین۔
بھی سے (مریم علیھاالسلام) تے پوگھِندے تُنو قوم سی کأشکے أپ، تھیئے بنوُ اے مریم! تأ دا چیر لاݜ کام کِیدوُ۔
اے ہارون سی شُوئے! نأ دا چھی باپ کی لاݜ ماݜ اَشُو آں نأئی چھی ییئی کی زناکار أشی۔
(مے بأت زیت مریم علیھاالسلام) تے پوئے اِشارہ کی، خلگے بنُو "تَھلا مھو تیسیت کھأکأ بأت کیئی کآم یأ مُو می گھِنیل اے پو تُھو؟"
لَؤ (بأت شروع کیدے) بنُو:" آ اللہ سی بَن تُھو، تی مھیئے کتاب دِت تُو آں مھأ نبی سَوات تُو۔"
آں مھأ مبارک سَوات تُو کھیدی آ ہُوؤ، آں مھیئے نِماز و ذکواۃ سی حکم کیدوُ، کھیدیک آ جَن تُھوو۔
آں مھأ تُنو ییئی سی فرمابنردار (بیأت منو والا) سَوات تُو، آں مھأ سرکش یا ٹگو حی والا نہ سَوات تُو۔
آں (اللہ سی ڈھأرا) سلامتیا چھی مھیزیت تے دِئے ہُم کے آ پئیدا ہُو، آں تے دی ہُم کامیک دی مأ مونِین آں تے دی ہُم کامے دی مأ دُوئی گونا جَن بھا کوا بژنین۔
ہے تُھو عیسیٰ مریم سی پو! اِسی بارا می سأس بات أ چھی کامیک می یأ خلک شک کودی۔
اللہ سی شان أ نی چھی کہ سے (اَمن گے پو) سَوے، تِسی ذات پاک چھی، کئی سے کائی بأت سی فیصلہ کودوُو سے تیس کے صرف میس بندوُ کہ ہو، سے ہودوُ۔
آں (اے پیغمبر! خلگائے بَن کہ) یقینًا اللہ مھی ہُم پروردگار تُھو آں تُھن ہُم پروردگار تُھو، اِسی وجہ دے تِسی عبادت کوا، اَںئی أ سِدا پان چھی۔
بھی ہُم ہأ می مختلف ڈلائے اختلاف کِدوُ، بس کامیک دِئے ہیئے تے سخت دی سی نظارا کِیو تے دی تِھن کأ تباہی ہونِین کامیک خلگے یأ کفر کِشو۔
کامے دی ہیئے مُھن کأشکے ینین تھیئے کھیدیک پَشو والا آں بُھوژوُ والا ہونیِن! خو ہے ظألم آش واضحا گمرائی می بھئیل تھی۔
آں (اے پیغمبر) ہأ تے پشیمانتیا سی دی ما بِھیا کے یأ ہر بأت سی آخری فیصلہ ہونین، حالانکہ أ خلک غفلت می تھی آں ایمان نہ اَندی۔
یقین کو، دھیرین آں ایزیت ٹول دَھرو والا سی وارث اَںئی مھوئے ہونین، آں ہُم مُھن دِش کے ہأ ٹول واپس اَننین۔
آں مے کتاب می ابراہیم علیہ السلام سی ہُم ذکر کو، بے شک سے چیر سأزبن نبی اشُو۔
(تے ساعت یاد کو) کے یأ تی تُنو بوپ کے بنُوشُو کہ اے باوا! تُو مھال شیئیا سی عبادت کئی کودوُ یأ نأ سے پَشدی آں نأئی بُھوژدی نأئی چھی کی کام کو بھادی؟
اے باوا! مھیئے مھال اے عِلم اَپ تُو یأ تھیئے نہ اَپ تُو، اِسی کأ مھی بات مَن، مأ تھیئے سِدا پان پشانِین۔
اے باوا! شیطان سی عبادت نو کو، یقین کو یرأ شیطان اللہ پاک سی نافرمان تُھو۔
اے باوا! مھیئے أ بِھت چھی یرأ اللہ پاک سی دِشا تھأ کآں عذاب نہ گݜے، آں تِسی نتیجہ می تُو شیطان سی سأت سَوا نہ بش۔
(تسی بوپ بنُو) اے ابراھیم! کئی تُو مھی خُدیئے ما بیزار تُھو؟ یاد سات کو تُو قلار نُو ہُوو مأ تھیزیت باڑ مُژانیِن، آں مھیرے تُو ہمیشہ سی کأ مھأ ما دُھو ہو۔
ابراھیم علیہ السلام بنُو، آ تھیئے (رخصتی سی) سلام کودُو، مأ تُنو پروردگار ما چھی بوگوشُو سی دعا کونین، بے شک سے مھیزیت چیر مہربان تُھو۔
آں آ تھو خلگے ما ہُم دُھو ہودو آں اللہ چھیدے تھو یأ کسی کسی عبادت کو دی تھیئے ما ہُم، آں مأ تُنو پروردگار ما دعا کوا ینین، مھیئے پورا یقین تُھو کہ تُنو رب ما دُعا نِمأدے مأ نامراد نہ ہونین۔
بس کے یأ سے تھیئے ما آں تھأ بُھودے ما جُدا ہُو کامیگائے سے اللہ چھیدے ڇاڑ کوؤدُود، دَ مھوئے تیس کے اسحاق آں یعقوب (سی شانے اولاد) دید، آں تھأ دوںئیمُو نبی سَوأت۔
آں تھأئے تُنو رحمت ما دید، آں تھأئے اُچات درجہ سی نیک نأمی عطا کی۔
آں مے کتاب می موسیٰ علیہ السلام سی ہُم تذکرہ کو، بےشک سے اللہ سی خوشیل بَن اَشُو، آں رسول و نبی اَشُو۔
آں مھوئے تیس کے کوہ طور سی سُوَن ڈھأرا ہاگات، آں تیس تُنو رازدا سَوأدے اَمن گے نھیئی کی۔
آں مھوئے تِسی بھا ہارون نبی سَوأدے تُنو رحمت ما تیس کے (ڈے) دید۔
آں مے کتاب می اسماعیل علیہ السلام سی ہُم تذکرہ کو، بے شک سے وعدہ سی پوخ اَشُو آں رسول او نبی اَشُو۔
سے تُنو شیروالائے ہُم نماز و ذکواۃ سی حُکم دیؤدوُد آں تُنو پروردگار سی نِز می خوشیل اَشُو۔
آں مے کتاب می ادریس علیہ السلام سی ہُم تذکرہ کو، بے شک سے چیر سأزال پیغمبر اَشُو۔
آں مھوئے تیس کے گھینیئی دیدے اے اُچات پوت کے اَوادُوشُو۔
آدم علیہ السلام سی اَولادی می أ سے نبی تھی کیزیت یأ اللہ پاک انعام کِشُو، آں ہأ می یام تھأ خلگا سی اولادی ما تھی کآم یأ مھوئے نوح علیہ السلام زیت کشتی ئے اُگھالیئشی، آں یام ابراھیم آں اسرائیل (یعقوب) علیہ السلام سی اولاد می تھی، آں ہے ٹول تھأ خلگا می تھی کیس کے مھوئے ہدایت دِت، آں (تُنو دین سی کأ) خوشأت، کے ہِن مُوش اللہ پاک سی آیادا سی تلاوت کوا بژژی دَ ہے ڙِنگئین سِجدائے بَژدی۔
بھی تھیئے ما بعد مھال خلک تُھن پوت اَئی کی یأ نماز برباد کی آں تُنو نفس سی خواہشا زیت چَلیئی، بس ہِن گمرائی چیر جلدی ہِن مُشکے یے نِن۔
البتہ کامے خلگے توبہ کی آں ایمان اَنُو آں نیک عمل کی دَ ہال خلگے جنت کے لھنگنین آں ہأزیت اے پِھٹ (ہُم) ظلم نہ ہونِن۔
ہأ مھال ہمیشہ دھروُ والا باغائے لھنگانین کامے باغا سی خُدئی رحمن تُنو بنا سیت تِھن بغیر پَشُوا وعدا کِیژی، یقینًا تِسی وعدا مھال چھی یأ تی ضرور پورا ہونین۔
ہیئے (جنت می) سلامتیا سی بیادے ما علاوہ کی بات نہ بُھوژنین آں تھیت تِھن رزق تھأئے ڙات و نیاشاما میلاؤ ہونِن۔
ہے سے جنت چھی کسی وارث مھوئے تُنو بنا می تیس سَوانین کآم یأ پریزگار ہُوؤ۔
(آں مُلیک تھیئے میس بَندی کہ) مھو چھی رَب سی حُکم ما بغیر نہ وودی، کا یأ مُھن مُوش کے تُھو آں کا یأ مُھن پأشکے آں کا یأ ہِن میئمو (مِیئے) می تُھو، سے ٹول تِسی ملکیت چھی، آں چھی رَب اَموݜا تَھلُو والا نُو تُھو۔
سے آسمان و دھیرین سی ہُم مالک تُھو آں کامے (مخلوق) ہن مئیمو می تھی تِھن ہُم مالک تُھو، بس تُو تِسی عبادت کو آں تِسی عبادت زیت مضبوطیادے اِڑی ہویل ہو، چھی علم می ہال دُوئی یام تُھو یأ ہال صفات لَردوُ؟۔
آں (کأفر) انسان بندوُ "کئی آ مُوو مھأ واقعی جینی کیدے نِگھالنِن؟
کئی انسان گے أ بات یاد نہ یے یی کہ مھوئے تیس شروع ما کا ساعدا پیدا کِیدا سے کی ہُم نہ اُشو؟
دَ قسم چھی رب سی زات زیت! مھوئے ہأ آں ہأزیت ٹول شیطان خامخا سرڑنین، بھی تھأ دیزوخا سی چاپیرا مھامُو گِھن دے ینین یأ تھیئے کُڑا زید لار بژیل ہونین۔
بھی تِھن ہر ڈلا ما تھأ خلک ݲِھکتے نِگھالنین کآم یأ خُدئی رحمن زیت سرکشی سی کوؤ می چیرے سخت اَشیئی۔
بھی مے باُت ما مھو غورا کیدے شِت تھی کہ سے کآم خلک تھی یأ ٹولے ما مُوش دیزوُخا ئے تَھلُو سی حقدا تھی۔
آں تھو می ایگی مھال نُو تُھو یأ دیزوخا سی ڙیتکے تیس کے لَھنگُو نُو تُھو دا، مے بأت سی چھی ربے لازمی ذمہ واری گِھن چی۔
بھی کامے خلگے یأ پرہیزگاری اختیار کِیدا مھوئے تھأ بچ کونین، آں کامیک یأ ظالم تھی تھأ مے حالت می چھونین کہ تھیئے دیزوخا می کُڑا زیت بژیل ہونین۔
آں کے یأ تِھن مُوش مُھن واضحا آیادا سی تلاوت ہیو دَ کأفر خلک ایماندائے بَندی بنا! مھو دوُںئی ڈلآ می کسی حالت چیر غورا چھی، آں کسی مئیلَس زیات غورا چھی؟
آں (ہے میسں نہ بودی کہ) ہیئے ما مُوش مھوئے کھیدیک نسل تباہ کِیدی کآم یأ تُنو سازوسامان آں ظاہری ٹھاٹ باٹ می ہیئے ما چیر غورا اَشئی۔
بَن کہ: کامے خلک گمَرئی می بئیل تھی دَ تِھین کأ مناسب أ تُھو کہ خُدا تھأئے چیر مہلت دو، تھیدیخانا پورے یأ ہے خلک تے شیئی أمینے پَشن کامے شیئی ما ہے بھیا بَژدی، کو سے (مےدوُنیئی سی) عذاب تُھو یا قیامت سی، دَ تے سادا تھأئے پتہ گَھڑنین کہ ٹولے ما لاݜ پوت کِسی اَشو آں کسی لخکر زیات کیمزیر أشی۔
آں کامے خلگے سِدا پان گأت چی تھأئے اللہ ہدایت می ترقی دیدوُ، آں کآم نیک عمل باقی دھروُ والا تھی دا تِھن ہم چھی پروردگار کیش غورا بدل تُھو، آں تِھن انجام ہُم غورا ہونین۔
دَ تأ تے ماݜ ڈِیڈ کی یأ مُھن آیادا سی منُو ما اِنکار کی آں بنُو کہ: مھیئے مال و اولاد آخرت می ہُم میلاؤ ہونین؟
کئی تی عالم غیب ڈیڈتُو، یا تی خُدئی زید کی لوظ کِیدو؟
ہیت ہُم نأ! کا یأ ہے بَندوُ مھوئے ایس ہُم لِکتے تھانِین آں اِسی عذاب می ہم چیری کونین۔
آں کامے (مال و اولاد) سی ہے بأت کودوُ دا ہِن وارث مھوئے ہونین، آں اِی مُھن کأن گے اَمن سیت ینین۔
آں ہیئے خلگے اللہ ما علاوہ دأل خدا کھأئیمُو سَوأدتی تاکہ سے ہِن ڈاگ مضبوط کوئن۔
ہے ٹول غلط بات چھی! تھیئے دا ہن عبادت ما اِنکأری ہونین آں اُلٹا ہیِن مخالف ہونین۔
(اے پیغیمر!) تھیئے ہے بات معلوم نی چھی کہ مھوئے کأفرا زیت شیطان چَھوئیدی، یأ تھأ اے مُوا پوؤڑادی؟۔
دَ تُو ہین بارا می جلدی نہ کو، مھو ہیِن کأ دی لیکھدی۔
تے دی یأ مھوئے ٹول پرہیزگار (خلک) خُدَئی سی کأن گے میلأݜ سیوأدے جمع کونیِن۔
آں گُناگاہ تِݜیل څاروَئیا سی شانے مُوش تھأدے دیزوُخا سی ڈھأر کے نئنین۔
خلگائے یِسی سفارش سی کوؤ سی اختیار نہ ہونین، سوائے تھأ خلگا ما کی یأ خُدئی ما کآں اِجازت گِھن چی۔
آں أ خلک کیئدا خُدئی سی کآں پو تُھوآ۔
حقیقت أ چھی کہ تھوئے چیر لاݜ حرکت کِیژی۔
ممکن تُھو اِسی وجہ دے آسمان ڈزے، دھیرین ڇِگے آں کَھن ٹوٹا ہیدے لار بژن،
کے یأ ہیئے خلگے اللہ پاک سی کأ پو سی دعوی کی،
حالانکہ رحمن خُدئی سی أ شان نی چھی کہ تِسی کی اولاد ہوئے۔
دھیرین و آسمانا می ہال یام نُو تُھو یأ بَن سی حیثیدیدے رحمن خُدئی سی کأن گے حاضر نہ ہوئے۔
یقین کو تیسکے ٹولا سی پتہ چھی آں تھأ غورا کیدے لیکھیئدی۔
آں قیامت سی دی تھأمی ہر ایک تِسی کأن گے ایگال ایگال ینین۔
بے شک کامے خلگے ایمان اَنُودوُ آں تھیئے نیک عمل کِیدی رحمن خُدئی تِھن کأ ہأمی مینا پیدا کونین۔
بس (اے پیغمبر!) مھوئے مے قرآن چھی جِب میں اَسأنی کِدو میلائی تو اِسی زریعا دے پرہیزگارائے زیرے دے آں اِسی زریعا دے تھأ خلک بھیا کآم یأ ضد سی وجہ دے لات کے تیا تھی۔
کھیدیک قوم ہیئے ما مُوش مھوئے تباہ کِیدی دا، تھأمی یِسی ہُم پتہ چھی؟ یا تھأمی یِسی ہُم کی گھنگُوسی تُو بُھوژَدوُ؟۔
طا ہا
مھوئے تھوزید قرآن مِسی کأ نازل نی کیدُو یرأ تو اَمن ٹھما،
ہاں ہے تے ماݜ سی کأ نصیحت چھی کآم ‌یأ اللہ ما ‌بھیددو،
(مے قرآن) ‌تی ذات نازل ‌کیدو کی یأ دھیرین آں اُتھل اُتھل آسمان ‌سوأدتی
(یعنی) رحمٰن (ایز نازل‌کیدو) سے أمیدے عرش سی ڙید قائم تُھو
آسمان ‌آں دھیرین آں کا ہین مِیئے تُھو، آں کا یأ سَتم دھیرین سی ٹین تُھو، سے ٹول اللہ سی تُھو
آں کو تو چیگأئے دے بات کو (یا دما سیت)، سے دا راز سی بأت ہم ‌پأندو، آں دما سیت بأت ہم‌ پأندو
سے اللہ تُھو، تیما علاوہ یام ‌عبادت سی لائق نو تُھو، تِسی چیر شِژو شِژو نام ‌تھی
(اے پیغمبرؐ!) کئی تھئیے موسٰیؑ سی قصہ سی پتہ گھیڑی؟
کے یأ تی آنگا ڈیڈ تا تُنو شیر والائے بنُو: "تھو دھأک ایڑی ہوا، مأ اے آنگا ڈیڈتُو، ہو بھادُو آ ایما دھأک کھور گھیندے یئی، یائی آنگا سی کأن مھیئے کآں دوئی پان میلاو ہوئے"۔
کے یأ موسٰیؑ تھیت کے اَوؤ دا تیسکے اے آواز دیا گا، "اے موسٰیؑ!"
"آ چھی رب تھو، تُنو پئیزار نِگھل، تو وادی طویٰ سی چیر مقدس پوت زید تُھو"۔
"تھأ مأ خوشادتُو (نبوت سی کأ) پس تھئیے کا بنا گاو تیس غور تے بھوش"۔
"بے شک اَںئی آ اللہ تُھو، مھأ ما علاوہ یام معبود نہ تُھو، پس مھی عبادت کو، آں مھی یاد سی کأ نماز گُوزا"۔
یقین کو قیامت ییؤ والا تُھو، (اَسے) آ نیمادو ایس بیرید سأتی، مِسی کأ ہر ماݜ سی لاݜ غورہ سی بدل تیسکے دیا بژے۔
دَ کامے ماݜ یأ (حق پَن) زید ایمان نہ ساتَدو، آں تُنو خواہشات آ سی جیدون تھلَدو، سے تھأ (حق پَن ما) غافل نہ کوئے، مھاموڑ نأئی تو ہلاک ہو۔
"اے موسٰیؑ چھی سُوَن ہات می ہے کا تُھو؟"۔
(موسیؑ) کئیدا: ہے مھی لھأڑ چھی، ایزید آ ڈو تھلَدو، آں ایدے تُنو څاروئ آ ئے پاݜ شیأدُو، آں ایز آ دوئی ہُم چیر کما می پکار کودُو۔
دَ (اللہ) بنُو: "ایز (دھیرین گے) تَھل موسیؑ!"۔
موسیؑ تیس (دھیرین گے) تھیلی دا تیما ایک دم گھین خامار سواگأ، آں سے تِلوسأد۔
(اللہ) کئیدا: ایس گݜ، بھی نأ، مھوئے اِسی اول شکل دُوار بحال کونین۔
آں تُنو ہات تنو کشال می گݜ (دھأک ساعت)، ای اُوجل ڇھیون سوا بژنین، بغیر کی بیماری ما، ہے مُھن اے نَخ دوئی ہو (تھیکیش)
تاکہ مھو تھیئے تُنو گھن گھن نَخ پَشئی۔
"فرعون سی کأشکے بَش، سے چیر زیات باغی ہودُو"
(موسٰیؑ) کئیدا: "اے مھی پروردگار، مھی سینہ کولاؤ کو"۔
مھی کام مھیئے آسان کو۔
مھی جِب ݜَیو سی بیماری ختم کوا۔ (مھی جِب سی گأن کولاؤ کو)
تاکہ أ خلک مھی بات جَنن
آں مھی کلاݜ ما ایک مھیسیت مدد سی کأ مقرر کو۔
مھی بھا ہارون
تاکہ تیدے مھی ڈاک مضبوط ہوئے۔
آں مھی کم می تیس مھیسیت شریک سوا
تاکہ مھو چھی پاکی چیرگن بیان کیئی
آں مھو چھی ذکر ہم چیرگن کیئی۔
یقیناً تو مُھن مے حال پشَدو۔
(اللہ) بنُو: موسٰیؑ چھی دعا قبول کوا گا۔
(اے موسٰیؑ!) مھوئے تھیزید اے پیرا موش ہم احسان کیشو۔
کے یأ مھوئے چھی ییئی یے (تے بات) الہام کی، کا یأ الہام دے کوا بژژی۔
یرأ تو ایس (موسٰیؑ) اے صندوق وا تَھل، بھی مے صندوق نھید وا تَھل، آں نھید ایس گئیگین گے تھلے، تھیدا مھی آں اِسی دشمن ایس بھا کوے، مأ تُنو دیشا تھزید مینہ تھلُو، تاکہ تو مھی نگرانی می گھینی ہو۔
آں کے یأ چھی شُو (فرعون سی کأشکے) گأ دا کئیدا: "آ تھوئے مھال (جوَئی) پشئی کآم یأ ایس ڙݜ بھاژی؟"، دَ مھوئے تھأ چھی ییئی سی کأشکے واپس اَنو، یرأ سے تھأ پیشتے خوشحال ہوئے، آں سے غمجن نہ ہوئے، آں تأ اے ماݜ موؤ دا مھوئے تے غم ما ہم تھأ لھاسُو، آں تھأ مھوئے چیرگن آزماد، آں جھان کال تأ مدین سی خلگا سیت لھنگأد، آں بھی اے موسٰیؑ! تو تھیدا مقرر وخ می واپس آپ۔
آں (اے موسٰیؑ!) مأ تھأ خاص تُنو (خذمت) سی کأ خوشادتُو۔
بس مھیرے تُو و چھی بھا مھی پیغام گھیندے بژا، آں مھی یاد می سستی نہ کوا۔
تھو دُوںئیںدے فرعون سی کأشکے بژا، تی چیر لاݜ ہات تے گھین تُو۔
آں تیسکے مینہ دے بنا، ہوبھادو سے نصیحت حاصل کوئے، یائی سے (اللہ ما) بھیے۔
دَ سے دُوںئیںدے کئیدا: "اے مُھن پروردگار! مھو دا بھیدی، مھاموڑ نأئی سے مھوزید کی زیأتیئی کوے، یائی سے دُوئی ہُم لاݜتوب کوے"۔
(اللہ) بنُو: "تھو نہ بھیا، آ تھوسیت تُھو، آ بھویدُو آں پشَدُو ہُم۔
دَ تھو تِسی (فرعون سی) کأشکے بژا، آں تیسکے بنا "مھو دُوںئیدے چھی رب سی رسول تھی، تُو مھوسیت بنی اسرائیل روان کو، آں ہأئے تکلیف نہ دے، آں مھو چھی رب سی ڈھأرا تھیئے نشأنی گھیندے اَئیدی، آں کامے ماݜ یأ ہدایت قبول کیو تِسی کأ اَمن آں سلامتی چھی"۔
"بےشکہ مھوئے أ بات بنا گیژی، کہ کی یأ (حق بأت) ما پیٹ گیأد، آں اللہ سی بأت لووال گھنڈیئی، تے ماݜ سی کأ سخت عذاب تُھو"۔
فرعون کئیدا: "اے موسٰیؑ، تُھن دُوںئی آ سی رب کآم تُھو؟"۔
موسٰیؑ بنُو: "مُھن رب سے تُھو کی یأ ٹول شیئی پیدا کیدے تھأئے پان پشادچی"۔
(فرعون) بنُو: "موشک تھأ خلگا سی کا ہُو؟"۔
(موسٰیؑ) بنُو: "تھین علم مھی پروردگار کیش اے کتاب می (محفوظ) تُھو؛ مھی پروردگار ما نأ کی غلطی ہوژی، آں نأئی سے کی شیئی اَموݜا تھلَدُو"۔
سے (پروردگار) یأ تُھن کأ دھیرین ما میدان سوأد، آں تِمی تُھن کأ پَن سوأد، آں آسمان ما تی آگھا موژاد، بھی تے آگھا سی اُو دے مھوئے قسم قسم سی لأر آں جِھیل نِگھلیئ۔
(مِسی کأ یرأ) تھو أمیدے ہُم کھا، آں تُنو څاروئی ہُم چیا، بےشکہ (اللہ سی کائنات می) ہُوشا خلگا سی کأ چیرگن نَخ موجود تھی۔
مے (دھیرین) ما مھوئے تھو پیدا کیدی، آں ایسکے مھوئے تھو دُوار واپس کونین، آں اِسی اندرا تھو اے پیرا بھی نِگھالنین۔
دَ مھوئے فرعون گے تُنو ٹول آیات (نشانی) پشأد، اَسے تی تھأ ٹول لووال گھنڈئی، آں تیما انکار کی۔
(فرعون) کئیدا: "اے موسٰیؑ! تُو مُھن کأشکے مِسی کأ آپ تُو یرأ تُو تُنو جادو سی زور تے مھو مُھن وطن ما ݜگا؟"۔
دَ (فرعون کئیدا): مھوئے ہُم چھی مقابلہ می جادو گھیندے ینین، پس تو اے وخ مقرر کو، تے وخ سی مھوئے خلاف ورزی نہ کونین، آں نأئی تأ (خلاف ورزی کونین)، آں اے گھنے میدان می (مقابلہ ہونین)"۔
(موسٰیؑ) بنُو: مُھن وخ میلہ سی دی مقرر ہونین، آں خلگائے پکار تُھو (لولو) څاخ سی وخہ جمع ہون۔
دَ فرعون واپس گا، آں تی تُنو چھل وَل (سی منصوبہ) جمع کی، بھی (مقابلہ سی کأ) آپ۔
موسٰیؑ تھأ (جادوگرائے) بنُو: برباد ہوئل ہانا! تھو اللہ سی بارہ می لوو نہ سوا، نأو تی تھو عذاب تے ہلاک کونین، آں کی ہم لوو سوادو (اللہ سی بارہ می) سے تباہ و برباد ہُو۔
دَ سے ایکدوئی می ݜأد، آں ایکدوئی سیت دما دما سیت بأت کووسأد۔
(جادوگر) کئیدا أ دو دا خاص جادوگر تھی، ہے میس نیمادی یِرأ ہے تنُو جادو سی زور تے تھو تُھن وطن ما نِگھالے آں سے تُھن دین ہم برباد کوے۔
دَ تھو تنُو ٹول منصوبہ تیا کوا، بھی قطار می اِڑی ہوا، یقیناً آش سے ماݜ کامیاب ہوئے کآم یأ چیر تکڑا ہُوو۔
(جادوگر) کئیدا: اے موسٰیؑ! یا دا تو (تُنو لھأڑ) موش (دھیرین گے) تھل، یائی مھو اول تھیلی۔
(دَ موسٰیؑ) کئیدا: اول تھو تھلا، دَ تِھین سے لھأڑ و رسی تِھین جادو سی وجہ دے معلوم ہووسأد یرأ ہے تِلَدی۔
دَ موسٰیؑ حی می دھأک بھید محسوس کی۔
مھوئے بنُو: "(اے موسٰیؑ!) نی بھی تأ ہأزید ڙید ہونین۔
آں چھی سُوَن ہات می کا تُھو دا ایس پھائے تَھل، جادوگر آ سی سویل کا تُھو دا اِی تیس ٹول نُگلنین، ہیئے جادوگرے کا تیا کیدو دا ہے صرف جادو تُھو دوکہ چھی، آں جادوگر آ سی اے طریقہ ہُم کامیاب نہ تُھو"۔
(دَ بُو دا) بُٹ جادوگر سجدہ می بَئیل تھی، کئیدا: "مھوئے ہارونؑ آں موسٰیؑ سی رب زید ایمان اَنو"۔
(فرعون) بنُو: تھوئے مھی اجازت دیؤ ما مُوش ایزید ایمان اَنو؟ بیشکہ ہے (موسٰیؑ) تُھن گھن تُھو، اَںئی ای تھوئے جادو ڇھیڙادتُو، مھیرے بوا، مأ تُھن ہات کُھو اَدل بدل چھیننین، آں خُرما سی تھام وا مأ تھو لھمانین، تھلا تھوئے پتہ گھڑنین کسی سزا سخ آں چیر وخ سی کأ ہوژی۔
دَ سے (جادوگر) کئیدا: کامے ربے یأ مھو پیدا کیدی دا، تِسی واضح دلائل آں نخ پشُو ما بعد مھو چھی سرا پرواہ نہ ساتَدی، تو کژل کودُوو کو، چھی حکم خو صرف مے دونیئی سی جیدون می چلدُو (دوِہ تُو کا کوبھادُو)۔
مھوئے دا تُنو رب زید ایمان اَنودُو یرأ سے مُھن گناہ معاف کوے، آں کامے جادو سی کأ تأ مھو مجبور کیشی دا تِسی گناہ ہم مھوئے معاف کوے، آں اللہ ٹولے ما غورا آں مُدام سی کأ قائم و دائم تُھو۔
(مے بات یاد ساتا!) رب سی کأشکے کآم گناہ کیدے گاو تِسی پوت دیزوخ تُھو، تیمی تأ جَن ہونین نأئی میل ہونین۔
آں کآم یأ ایمان سی حالت می نیک عمل کیدے گاو تِسی کأشکے تِسی کأ چیر اُچات اُچات درجہ تھی۔
مھال جنت یأ تھین مِیئے شِیژو شِیژو کانے روان ہونین، مومن خلگے تیمی مُدام سی کأ دھرنین، ہے تے ماݜ سی بدلہ تُھو کی یأ روحانی پاکیزگی اختیار کیو۔
آں مھوئے موسٰیؑ ئے وحی کی یرأ مھی بندہ گھیندے ڙأدو ڙأت روان ہو، تھین کأ (لھأڑے دے) داک دیدے سمندر می شوگیل پان سوا، دَ نأ (ڈوب ہووُ سی) تھیئے کی خطر ہونین نأئی (فرعون سی گݜو سی) کی بھید۔
دَ فرعون ہُم تھین پأش پأش روان ہُو تُنو فوج گھیندے، دَ سمندر (سی چھابے) تھأ ڈوب کی(آں) غورا ڈوب کی۔
دَ فرعون تُنو قوم گمراہ کی، آں ݜِݜ پان تھأئے نہ پشابھئی۔
اے اسرائیل سی اولاد! مھوئے تھو تُھن دشمن ما لھاسیئ، آں طُور سی کھن سی سُوین دیشا (تورات سی دیؤ سی) وعدہ کی، آں تھوزید مھوئے من و سلویٰ نازل کی۔
مھی دیل پاک رزق ما کھا، آں ایمی حد ما نو نُوخا، نأو مھی عذاب تھوزید نازل ہونین، یقیناً کامے خلگا زید مھی عذاب نازل ہُودو دا سے برباد ہوئیدی۔
آ دا چیرگن بوگوشُو والا تُھو، تے (ماݜ سی) کأ کی یأ توبہ نگھألی آں ایمان اَنو، آں نیک عمل کی، آں بھی سیدا پان گأد۔
آں اے موسیٰؑ! تأ تُنو قوم ما موٹھائے نیختے تأدی کئی کی؟
(دَ موسٰیؑ) کئیدا: "سے اَگا مھی پأش پأش روان تھی، مأ مِسی کأ تأدی کی اے مھی پروردگار! یرأ تو مھأ ما راضی ہو"۔
(دَ اللہ) بنُو: مھوئے تھأ ما بعد چھی قوم اَزمیخ می گاد، آں سامری تھأ گمراہ کی۔
دَ موسی چیر خپا ہُو آں قار می تُنو قوم سی کأشکے واپس آپ، بنُو: اے مھی خلگا ہانا! کئی مھی پروردگار تھوسید اے غورہ وعدہ نی کیشی؟ کئی وعدہ تھوئے ݲِگ معلوم ہی، یائی تھو میس نیمادی یِرأ اللہ سی عذاب تھوزید نازل ہوئے، ایسی کأ تھوئے مھی وعدہ سی خلاف ورزی کی؟
(دَ تی) بنُو: مھوئے قصداً چھی وعدہ سی خلاف ورزی نی کیژی، اَسے مھوئے )فرعون سی( قوم ما کامے لگھور زر اَنوشو دا تیس مھوئے پھائے لار تھلُو، آں سامری ہم لار تھلُو۔
دَ تی تھین کأ باس سی بوٹی سوأد، تیما (گیئی سی) آواز نُخوسأد، دَ خلک کئیدا "اَںئی أ تُھن خدا تُھو، آں موسٰی سی ہُم خدا تُھو، اَسے تیما اَموݜا گودو"۔
کئی أ خلک مے سوچ نہ کودی یرأ ہے باس ہین بأدا سی جواب نہ دے بھادُو، آں نأئی تھأئے کی نقصان اَوابھادُو، نأئی کی فائدہ؟
آں ہارونؑ تھأئے موش ما بنوشو ہُم یرأ: "اے مھی قوم سی خلگ ہانا! مے (باس) تے تھو آزما گئیدی، تُھن رب تا رحمٰن تُھو، بس تھو مھی تابعداری کوا، آں مھی حکم منا"۔
(سے خلک) کئیدا: "کھیدیخانہ پورے موسٰیؑ واپس نہ آپ تُوو مھوئے اِسی موشکے کُڈ تھیلدے ایسی عبادت کونین"۔
(دَ موسٰیؑ واپس ییدے) بنُو: اے ہارونؑ! ہے گمراہ ہوؤدود تا تأ ہأ پیشتے کئی منع نی کی؟
"مھے پیش پأشا کئی نہ آپ تُو؟ کئی تأ مھی نافرمانی کی؟"۔
(دَ ہارون) کئیدا: اے مھی ییئی سی پُوڙأ! مھأ دأ آں ݜا سی بالے ما نہ گݜ، آ دا مے بأت ما بھیودُود یرأ تأ بَننین تأ بنی اسرائیل دو پَدے تقسیم کی، آں مھی بات تأ نے مینی"۔
( دَ موسٰیؑ سامری یے) بنُو: "تھیئے کژل ہیشی سامری؟
(دَ سامری) بنُو: مأ یأ کا ڈیڈوشُو دا تیس یی نی ڈیڈوشُو، مأ مُلیکا آ سی کُھو آ سی ٹینا سُم بھا کیدے (باس وا) تھلُو، اَںئی أ بات مھیئے غورا معلوم ہی۔
(موسٰیؑ کئیدا) "بَش تھلا! تأ پورا زندگی میس بننین یرأ "مھیئے ہات نھیئی نہ کو" آں تھیزید عذاب سی وعدہ ہُم چھی، تی تھأ ما دھوگو نہ ہو بھانین، آں بُو تُنو ہات آ سی سویل خدئی یے! تیسکے یأ تأ کُڈ تھیلدے بھیڑوشُو دا، مھوئے ایس دھژانین، آں بھی پونو سوأدے سمندرے وا تھلنین"۔
بیشکہ تُھن رب دا سے تھو یأ تیما علاوہ سرہ یام رب نو تُھو، ہر شیئی تِسی علم می قابو تُھو۔
(اے پیغمبرؐ!) مھو تھیئے تھأ قصہ بیان کودی کامیک یأ موش لھنگئیدی دا، آں تھیئے مھوئے تُنو ڈھأرا اے نصیحت (یعنی کتاب) دیدتُو۔
کامے ماݜ اے کتاب کے پِیٹ گئیأدو، تی قیامت سی دی (گناہ سی) بوج بھاکونین۔
(آں تھأ گناہ آ سی عذاب می) تھیئے خلگے تیمی ہمیشہ ہونین، چیر لاݜ بوج تُھو گناہ آ سی، قیامت سی دی ہیئے بھا کونین۔
کامے دی یأ بیشل (صور) وا پھوک دیاگأو۔ آں تے دی مھوئے مجرم خلک جمع کونین دا ہین أݜیئے (بھید تے) نیل ہونین۔
دَ ہیئے ایکدوئی سیت دمہ دمہ سیت بأت کونین، آں بننین: "تھوئے دونیئی می صرف دَش دی لھنگأدتی"۔
مھو جنَدی ہین ہأ بأدے ما، ہیئے مے ٹولہ ما سأزبن بننین یرأ تھوئے دا دونیئی می صرف اے دی لھنگادتُو۔
(اے پیغمبرؐ!) آں خلک یأ تھأ ما کھنا سی بارا می توَس کودی دا، بنا (قیامت سی دی) مھی پروردگار ہأ خس خس کیدے ہیئے ما پھزین سوانین۔
آں دھیرین ما ہوار میدان سوانین۔
اے (دھیرین) نأ تأ کیل پشنین، آں نأئی اُوچات وا۔
تے دی ٹول خلگے اے آواز دیؤ والا سی پأشکے مھاموڑ بژنین یرأ تی ݜائی بھا نہ کوبھانین، آں اللہ سی موش ٹول آوازے غلے ہیدے بژنین، دَ گُنگنأئے ما علاوہ تأ کی نہ بُھوشنین
تے دی یسکے سفارش سی کی فائدہ نہ ہونین، سیوائے تے ماݜ سی (سفارش سی) کسی یأ رحمٰن اجازت دیدو، آں کِسی بات یأ تی خوشأدو۔
سے ہین موشک (بأت و کم) ہُم پأنَدو، آں پیشم ہُم، آں ہے (خلک) تِسی علم تُنو خیال می نہ آن بھادی۔
(بُٹ خلگا سی) ݜا جَن آں قائم و دائم ذات سی موشکے نامیل ہونین، آں سے (ماݜ) تباہ ہُو کی یأ نافرمانی و ظلم سی بوج پیٹھے گِھن۔
آں کامے ماݜ یأ نیک عمل کیدُو آں سے ایمان سی حالت می تُھوو تیسکے نأ ظلم سی بھید ہونین نأئی نقصان سی۔
آں مھامُوڑ مھوئے قرآن عربی جِیب می نازل کیدُو، آں ایمی مھوئے دَمکی آ سی ذکر کیدُو، مِسی کأ یرأ خلک پرہیزگأری کوئن، یا أ قرآن تھین کأ نصیحت سَوا بژے
دَ اللہ حقیقی ذات آں گھن شان والا تُھو، (اے پیغمبرؐ!) کھیدیخانہ پورے تھزید پورا پورا وحی نہ وأدچیو، تُو قرآن سی بارہ می تأدی نہ کو، آں دعا کو اے اللہ مھی علم مھیئے چیری کو۔
آں مھوئے مُوش ما آدمؑ ما وعدہ گھینیشی، دَ تیما اَموݜا گا، پس مھوئے تیس (آدمؑ) پوخ ارادہ والا نہ پات۔
(تے وخ یاد کو) کے یأ مھوئے فرشتائے بنُو، تھو آدمؑ گے سجدہ کوا، دَ تھیئے ٹولے سجدہ کی، سیوائے ابلیس ما، سے انکاری ہو۔
دَ مھوئے بنو: "اے آدم! أ چھی آں چھی جَوئی سی دشمن تُھو، خیال کوا یئد تھو دوںئیدے جنت ما نی نِگھلے، نأو تھوئے مصیبت وا بژنین۔
بیشکہ (جنت تا مھال پوت تُھو) مھید تُھن کأ نأ بِݜ ہونین، نأئی کوژو آ سی کی فکر۔
آں تُھن کأ نأ تِݜ ہونین اِسمی آں نأئی سی سی تان (سی پتہ گھڑنین)"۔
دَ شیطان تِسی حی وا وسوسہ تھیلی، کئیدا: (اے آدمؑ!) "آ تھیئے مھال اے تھام پشئی، تیدے مُدأمی (جیدون) ہونین، آں مھال بأچیئی یأ تی یئت پرأنی نہ ہونین؟"۔
دَ تھیئے دُوںئے تے تھام سی میوہ کھوؤ، دَ بو دا تھین ستر تھأئے کولاؤ ہُو، آں سے اَمن جنت سی پاڙے دے بورؤسأد، دَ آدمؑ ما تِسی رب سی حکم می کوتاہی ہی، دَ سے دھأک پَن ما پݜَلو۔
بھی تِسی پروردگار تیس خوشاد، آں تِسی توبہ قبول کی، آں تیسکے سیدا پان پشأد۔
اللہ حکم دید، (یرأ آدمؑ آں شیطان) "تھو دوُںئیدے مے جنت ما نوخا! تھو دوُںئیدے ایکدوئی سی دشمن تھی، بھی کی مھی ڈھأرا ییل ہدایت زیت عمل کی، دَ تی نأ دا گمراہ ہونین نأئی کی بدبخت"۔
"آں کی ہم مھی یاد (سی ڈھأر) کے پیٹ گیأد، دَ تِسی دونیئی سی جیدون ہُم تأنگ ہونین آں قیامت سی دی ہُم تیس مھوئے اَن بھا کونین"۔
دَ تی بننین: "یا اللہ تأ مھأ کئی اَن سیوأدے بھا کی، آ دا پشودوُدا؟"۔
(دَ اللہ) بننین: "چھی کأشکے مُھن نَخ اَئیشی، تأ تھأ اَموݜا تھلیئشی، دَ آش تأ ہُم اَموݜا تھلا بژنین"۔
آں کامے ماݜ یأ حد ما لھنگدُو، آں تُنو پروردگار سی نخا زید ایمان نہ ساتدو، تیسکے مھو اَںئی مھاموڑ سزا دیدی۔ آں آخرت سی عذاب تا چیر زیاد سخ آں ہمیشہ سی کأ تُھو۔
کئی ہیئے مے بأت ما عبرت نی گھین یِرأ ہیئے ما موش مھوئے کھیدیک خلک ہلاک کیدی کھین گام آ می یأ ہے مھیرے گئیدی دا؟ بےشک مے بأت می عقل والا سی کأ نخ تھی۔
(اے پیغمبرؑ!) آں کو چھی رب سی ڈھأرا موش ما فیصلہ نی ہیشِیو، آں اے وخ مقرر نہ ہُوشوو، دَ ہأ (کأفر) خلگا زید مھیرے عذاب یے نِندے۔
دَ (تَھلا) ہے خلک یأ کا بأت کودی دا تیزید تُو صوو کو، آں تُنو رب سی نام سی تسبیح گا، سی سی نُخو ما موش آں سی سی ڈوب ہوؤ ما بعد، آں ڙأد سی وخ می ہُم تِسی تسبیح بیان کو، آں دیے ہُم تیس یاد کو مِسی کأ یرأ تُو خوشحال ہو۔
(اے پیغمبرؐ!) دونیئی سی جیدون سی تے سازوسامان گے ہاڈو بُو ہُم نأ، کامے سازوسامان مھوئے بعض خلگائے مزہ گھینو سی کأ دیدتُو، تاکہ مھو دونیئ سی شیئیےدے ہین اَزمیخ کیئی، آں چھی رب سی دیل رزق تا زیاد غورا آں ہمیشہ سی کأ چھی۔
(اے پیغمبرؐ!) تُنو کلاݜ کے نماز سی حکم کو، آں أمیدے ہُم نماز سی پابند ہو، مھو تھیکیژا رزق نی نیمادی، بلکہ رزق تا مھو تھیئے دیدی، آں بہترین انجام دا پرہیزگاری چھی۔
ہے (کأفر خلک) بنَدی: أ پیغمبرؐ مھوئے کآں نَخ تنُو رب سی دِشا کئی نہ پشادو؟ کئی ہین کأشکے موشک کتاب آ سی مضمون نہ آویدی کھأ؟
آں کو ہأ (کأفر خلک) مھوئے قرآن سی نازل ہوؤ ما موش ہلاک کیشیو، دَ ہیئے بنیندے: اے مُھن پروردگار! تأ مُھن کأشکے پیغمبر کئی نہ پیؤ، تاکہ مے ذلت و خوأری ما موش مھو چھی آیات آ سی پیروی کئیدے؟
(اے پیغمبرؑ!) ہأ خلک (کافرائے) بن: مھو بُٹ کُٹھادی، دَ تھو ہُم کُٹھا، کئیکہ چیر جلد تھوئے پتہ گھڑنین، یرأ ݜِݜ پَن والا کآم تھی، آں ہدایت یافتہ خلک کام تھی۔
خلگا سی کأ حساب سی وخ نھیئی ہُو آں ہے غفلت می مُو کیلی کوئیل تھی۔
ہین کأنگے تھین رب سی دِشا کا ہُم نیم نصیحت ییژیو، دَ سے تیس بُھوژدی، خو مھامُوڑ یأ سے نڑو می اَختا ہُوئیدی،
ہین حی غافل تھی، آں ظالم خلک بیریت بیریت مشورہ کودی کہ أ (نبیؐ) دا تُھن شانے اے انسان تُھو، (آں بندی) اَیا تھو جیندے ہُم جادو سی بأدا پیش بژدی؟
(پیغمبرؐ) بندُو کہ مھی رب دھیرین و آسمان سی ہر بأت ما شید تُھو، آں سے غورا بُھوژو والا جنُو والا تُھو۔
نأ، بلکہ سے بندی: أ (قرآن) گڈوڈ نین چھی، بلکہ ایس (پیغمبرؐے) اَمنا سَوادتو، بلکہ ہے اے شاعر تُھو، ایسکے پکار تُھو مھوئے مھال کآں نَخ اَنے کھأکأ یأ مُوشک پیغمبر (نخے سمانے) پیا گئیشی دا۔
ہیئے ما موش مھوئے کامے گام والا ہُم تباہ کیدا، تھیئے (معجزہ پیشتے ہُم) ایمان نہ اَنوشو، اَیا ہیئے خلگے ایمان اَننین؟
آں (اے پیغمبرؐ!) تھوئے ما موش ہُم مھوئے ماݜ (پیغمبر سیوأدے) پیئشی، کھین دیشکے مھو وحی پیؤدُود، کہ تھو اے بأدا نہ جندیو علم والا آ ما توَس کوا۔
آں مھوئے مھأ پیغمبرا سی مھال بدن نہ سیوأدیشی کہ سے گیل نہ کھئن، آں نأئی سے مُوآ جَن دھرُو والا آشیئ۔
بھی مھوئے تھأسیت تنُو کوئیل وعدہ سأس کیدے پشأد، آں تھأ آں (دأل) کیس یأ مھوئے نیمادو، مھوئے بچ کی، آں زأتیئی کوؤ والا ہلاک کی۔
(اے خلک ہانا!) مھوئے تھوزید اے کتاب نازل کیدو، کیمی یأ تُھن کأ نصیحت چھی، دَ کئی تھو بھی نہ جنَدی؟
آں کھیدیک گام مھوئے تباہ کی (خس خس کی، مئیدہ کیدے چھوئی)، کھین خلک ظالم اَشیئ، آں تیما بعد مھوئے دُوئی قوم پیدا کی۔
بھی کے یأ تھیئے مُھن عذاب ڈیڈتا تھیدا ڈیؤسأد
(تھأئے بناگا) مھیرے نہ ڈیا آں واپس یا، تھأ نعمدا سی دیشکے کآم یأ تھوئے دیا گئیشی، آں تنُو شیرا سی دیشکے، ہوبھادُو تھوئے ما کآں توَس کوا بژے۔
تھیئے بنو: "افسوس مُھن کمختی! اَںئی مھو ظالم اَشیئ"
دَ تھیئے اَںئی ہامو چیگأ نیگھلا اَئی، مھیدا پورے کہ مھوئے تھأ لُونیل فصل آں نشیل آنگا سی شانے کیدے چھوئی۔
آں مھوئے آسمان و دھیرین، آں کا تھین مِیئے تُھو دا، ہأئیمو نڑو سی کأ پیدا نی کیدُو۔
کو مھو ہأئیمو نڑو سوؤ نیمؤدودو مھوئے تنُو دیشا سَوانیندے، کہ مھو خامخا ہامُوڑ کوؤدود۔
بلکہ مھو دا سأس تے لَوو سی گھیندے دیدی، دَ سے تِسی ݜا پھرادُو، تھلا سے (باطل) ہڙہ یدو (ہاڙژدُو)، آں کا لَوو تھو سَوادیدا سے تُھن کأ تباہی چھی۔
آں آسمانا می آں دھیرین می کآم اِی تُھوو تِسی تُھو، آں کآم (مُلیکا) اِی تِسی کأن تھیدا سے نأ دا تِسی عبادت ما انکار کودی آں نأئی ٹھمدی۔
ڙاسودی اللہ سی تسبیح کودی، آں سستی سرا نہ کودی
اَیا ہیئے خلگے دھیرین زیت مھال شیئی معبود سَوادتی کہ سے یس جینی کو بھادی؟
کو آسمان و دھیرین می اللہ ما علاوہ دأل معبود اَشیئو، دَ دُوںئیے تباہ ہونیندے، دَ کامے بأت یأ تِسی بارہ می کودی دا، عرش سی مالک اللہ تھیئے ما پاک تُھو۔
آں کا ہُم یأ سے کودُو دا تیما توَس کوا نہ بژدُو، آں خلگے ما توَس کوا بژنین۔
اَیا تھیئے تیما ما علاوہ (امن گے) دأل معبود سوأدتی؟ (اے پیغمبرؐ!) تھو بنا: "تھو تنُو اے دلیل مُٹھائے کوا!"، أ (قرآن) ہُم موجود تُھو کِسمی تھأ خلگا سی نصیحت چھی کآم یأ مھیسیت تھی، آں سے (کتاب) ہُم موجود تھی کِسمی یأ مھأما موشک خلگا سی کأ نصیحت اَشیئ، اَسے اکثر خلک تا ہأئیما حق ہاڈو پأندی ہُم نأ، دَ کھأئیمو تیما مُو گئادی۔
آں تھوما موش مھوئے یئت ہُم مھال اے پیغمبر نہ پیؤدُو کہ تیزید مھوئے مے وحی نازل نی کیژیو کہ "مھأما علاوہ دُوئی یام عبادت سی لائق نو تُھو، بس (صرف) مھی عبادت کوا"۔
آں ہے بندی کہ رحمٰن اَون گے اولاد گادتُو، حالانکہ ہے ایما پاک تُھو، بلکہ (مُلیکا) دا تِسی عزتمند بَن تھی۔
کآم یأ تِسی موشکے بات ہُم قدرے نہ کوبھادی، آں تِسی حکم زید پورا پورا عمل کودی۔
تیسکے معلوم تُھو کا یأ تھین مُٹھیئے تُھو، آں کا یأ تھیئے ما پأشکے تُھو، آں سے یسی سفارش ہُم نہ کوبھادی، بے تھیئے کِسما یأ اللہ راضی ہُوو، آں سے ٹول اللہ سی ہیبت ما بھیدی۔
آں ہیئے ما یام کو میس بندُو کہ "تیما علاوہ آ عبادت سی لائق تُھو"، دَ تیسکے مھوئے دیزوخ سی سزا دینین، مھو ظالم آئے اَںئی مھامو سزا دیا ییدی۔
اَیا سے خلک کآم یأ کأفر تھی، تھأئے پتہ نی چھی کہ آسمان و دھیرین ایکدی می میلاؤ اَشیئ، بھی مھوئے تھأ جدا جدا کی، آں مھوئے اُو ما ہر جن شیئی پیدا کی، دَ اَیا ہے ایمان نہ اَندی؟
آں مھوئے دھیرین می کھن پیدا کی، مِسی کأ کہ سے ہأزید نہ پھرگے، آں اے (دھیرین) زید مھوئے کولاؤ کولاؤ پَن سَوأد کہ خلک پان پَئن۔
آں مھوئے آسمان اے محفوظ چَت سَواد، آں ایزید ہُم ہے (آسمانی) نخے ما پیٹ گئادی۔
آں (اللہ) سے ذات تُھو کہ تی دی و ڙات آں سی و یُن پیدا کی، ہرایک تنُو مدار (کورگول) می لامو دیدُو (گئیدُو)۔
آں مھوئے تھأما موش ہُم کی انسان گے مُوا سی جیدون نی دیدتُو، بھی کو (اے پیغمبرؐ!) تُو وفات ہُوو، کئی ہیئے خلگے مُوآ دھرنین؟
ہر سا سی شیئیے مئیک سی مزہ چکھو تُھو، آں مھو اَزمیخیدے تھو غورا و لاݜ تے آزمادی، آں (آخر) تھوئے مُھن دیِشکے واپس یینین۔
آں کے یأ ہے کأفر تھأ پشدی و ٹوقے ٹقالے کودی، (آں بنا ییدی کہ) اَیا ہے سے ماݜ تُھو کہ تُھن معبود آ سی ذکر (لاݜتوب تے) کودُو؟ آں حال أ چھی کہ ہے أمیدے رحمٰن سی یاد ما انکار کودی۔
انسان سی پیدائش می تأدی تھا گیژی، مأ چیر شیرتے تھوئے تنُو نشانی پشانین، بس تھو تأدی نہ کوا۔
آں ہے بندی کو تھو سأزبَن تھیو (بَنا کہ) می وعدہ کے پورا ہونین۔
کاش ہأ کأفرآئے سے وَخ معلوم ہُوشوو، کے یأ نأ دا تھیئے تنُو مُوئے ما آنگا پَدا کوبھانین، آں نأئی تنُو پیٹ ما، آں نأئی تھین کی مدد کوا بژنین۔
بلکہ تی آنگا نأڅأبی تھأزید یینین، آں تھأ حیران کونین (حان کیدے چھونین)، بھی نأدا تھیئے تے آنگا دھگو کوبھانین، آں نأئی تھأئے کی مہلت دیا بژنین۔
آں تھأما موش ہُم رسول آ پیش پشاڑے کوا گیژی، دَ کی یأ تھأ پیش ہأز کیدا تھأ پیش ہُم عذاب چاپیرا ہُو، کیس پیش سے ہزودود
(اے پیغمبرؐ!) ہأئے بَن کہ رحمٰن (سی عذاب) ما کآم تُھن ڙأت می آں دی می حفاظت کودُو؟ بلکہ (بات أ چھی کہ) ہے تنُو رب سی یاد ما مُو گئادی۔
اَیا ہأکیش مھوئے ما علاوہ دأل معبود تھی کہ تھین حفاظت کوئن؟ سے دا تنُو أمیدے مدد نہ کوبھادی، آں نأئی مُھن مقابلہ می دُوئی یام ہین سأتویلی کوبھادُو۔
بلکہ مھوئے ہأئے آں ہین بوب داد کے دُونیئی سی نعمت دید، مھیدیگا پورے کہ ہأزید چیر اے مُودا لھنگُو، کئی ہے نہ پشدی کہ مھو (ہین قبضہ سی ٹین) دھیرین ہر دیشا سرڑا ییدی، اَیا مھیرے ہُم ہیئے برئی پانین؟
(اے پیغمبرؐ! تو ہأئے) بَن: کہ آ دا تھو صرف وحی سی زریعہ دے (اللہ سی نافرمانی ما) بھیادُو، آں (کنے) بو کے یأ بھیا بژوسأدو سے دا ہأڈو آواز بُھوژدی ہُم نأ۔
آں کے یأ چھی رَب سی دیشا ہأزید عذاب سی اے چپہ ہُم آبو، بھی سے بندی: "ہائے مُھن بدقسمتی ئے! یقیناً مھو اَمن زید ظلم کوؤدُود"۔
آں مھوئے قیامت سی دی انصاف سی ڇیگے تھانین، دَ یزید اے زرہ سی ہُم ظلم نہ ہونین، آں کو (یسی عمل) چُک شا سی بیش سی کُل سیم برابر ہُم ہُوو مھوئے تیس اِی اَننین، آں حساب سی گھینوئے مھو اَمن سید ہُم پورا تھی۔
آں مھوئے موسٰی و ہارون گے (تورات) دید، (یأ سے) حق و باطل می فرق کوؤ والا، آں لوش، آں پرہیزگار آ سی کأ نصیحت چھی۔
تھأ خلگا سی کأ کآم یأ تنو پروردرگار ما غیبانہ بھیدی، آں سے قیامت ما ہُم بھیت کھادی۔
آں أ (قرآن) برکت والا نصیحت چھی، کامیک یأ مھوئے نازل کیدُو دا، دَ کئی تھو ایما انکأری تھی؟
آں مھوئے ابراہیم گے ایما موش ہدایت دیدیشی، آں مھو تیما غورا شید اَشیئ،
کے یأ تی تنُو بوپ آں تنو قوم گے بنو کہ أ کا بُھوت تھی کھین عبادت سی کأ تھو جُوخ بھیڈتی؟
تھیئے بنُو: مھوئے تنو باپ داد ہین عبادت کوؤ آ ڈیڈیشی۔
(ابراہیمؑ) بنو: تھلا تھو آں تُھن باپ داد اخکارہ گمراہی می اَشیئ۔
تھیئے بنُو: "اَیا تأ مھوئے حق بات أنیژی، کو تُو ہأئیمو گپ دیدُو؟"
(ابراہیمؑ) بنو (گپ نی چھی) بلکہ تُھن پروردگار آسمان آ سی آں دھیرین سی پروردگار تُھو، کی یأ ہأ پیدا کیدی، آں آ مے بأت زید گواہ تُھو۔
آں اللہ سی قسم، مأ تُھن بھوت آ سید چَھل کونین، تُھن (ہین کأنا) بژو ما بعد۔
دَ ابراہیمؑ تھأ بُھت ٹوٹے ٹوٹے کی، خو اے گھن بُھت تھیئے ما روغ چھوؤ، کہ ہوبھادُو خلک تِسی دِشکے واپس یَن۔
تھیئے بنو: "مے کام مُھن معبود آ زید کی کیدُو؟ یقیناً سے گھن ظالم تُھو"۔
تھیئے بنو: مھوئے اے زوان سی أں ما ہین ذکر بُودتُو، کہ تیسکے ابراہیمؑ بندی۔
تھیئے بنو کہ تیس خلگا سی موشکے اَنا، کہ خلک تِسی گواہ ہوئن،
تھیئے توَس کی: "کئی تأ مُھن مھأ معبود آ زید مے کام کیدُو اے ابراہیمؑ؟"
تی بنو: "نأ، بلکہ اے کام ہأمی گھن (بُھودے) کیدُو، کو ہے بأت کودیو ہیئے ما توَس کوا"
کے یأ تھیئے اَمن گے سوچ کیدا، دَ بنو "یقیناً تھو بے انصافہ تھی"۔
بھی تھیئے (لأژیدے) تنُو ݜا وا کی (آں ابراہیمؑ گے بنو) تھیئے دا پتہ چھی ہے بأت نہ کو بھادی۔
(ابراہیمؑ) بنو: دَ کئی تھو اللہ چھیدے تھأ شیئی آ سی عبادت کودی کآم یأ تھوئے کی فائدہ نے دے بھادی، آں نأئی کی نقصان؟
افسوس تُھو تھوزید آں تھأزید کسی یأ تھو اللہ چھیدے عبادت کودی! کئی تھو عقل ما کام نی گھیندی؟
تھیئے (ایکدیئے) بنو: "ایس آنگا وا تھلا آں تنو خدئی آ سی مدد کوا، کو تھو کی کوؤ نیمادیو"
مھوئے حکم کی اے آنگاأ، تُو شیدیلی ہو آں ابراہیم سی کأ راحتہ سَوا بش!
آں تھیئے تیسکے نقصان دیؤ نیماد، خو مھوئے اَںئی تھأ خلک ناکاما کی۔
آں مھوئے تیس و لوطؑ بچ کیدے تے وطن گے اَنیئی کامیک یأ مھوئے ٹول دونیئی سی (خلگا سی) کأ برکتی کیدُو۔
آں مھوئے (ابراہیم گے) اسحٰق دید آں یعقوب خیوہ گڑے(دید)، آں ٹول مھوئے نیک سیوأد۔
آں مھوئے تھأ امام سیوأد، یأ مُھن حکم دے (خلگائے دین سی) پان پشؤدُود، آں مھوئے ہأئے وحی سی زریعہ دے کم کوؤ سی، آں نماز گوزوؤ سی، آں ذکواۃ سی دیؤ سی حکم پیؤ، آں سے مُھن عبادت گزار اَشیئ۔
آں لوطؑ کے مھوئے حکمت آں علم دید، آں تیس مھوئے تھأ گاما ما بچ کیدے نِگھالُو، کامے گاما سی خلک گندہ کما می اَختہ اَشیئ، یقیناً سے خراب آں بدکار قوم (سی خلک) اَشیئ۔
آں تیس مھوئے تنو رحمت می داخل کی، بیشک سے نیک خلگا ما اَشُو۔
آں ایزما موش کے یأ نوحؑ ڇاڑ کیدا، مھوئے تِسی دعا قبول کی، آں مھوئے تیس و تِسی ٹوَر گھین غم ما بچ کی۔
آں مھوئے (نوحؑ) سی بدل گھین تھأ خلگے ما کآم یأ مُھن آیادے ما انکار کوؤدود، بیشک سے چیر لاݜ خلک اَشیئ، دَ مھوئے تھأ ٹول غرک کی۔
آں داؤدؑ و سلیمانؑ (ہُم یاد کوا) کے یأ سے بُھوم سی معاملہ می فیصلہ کوؤدود، کہ اے ڈلہ سی چھأل تیمی ڙأت کے چیا گئیشی، آں مھو تھین فیصلہ څارودود۔
دَ مھوئے تے فیصلہ سی پوہا سلیمانؑ گے دید، آں حکت و علم دا مھوئے دُوںئیائے دیدُوشو، آں مھوئے داؤدؑ سی کأ کھن تابع کیشی، کہ سے کھن مُھن پاکی بیان کوؤدود، آں پیݜین ہُم، آں (ٹول) کوؤ والا (اصل می) مھو اَشیئ۔
آں مھوئے تیسکے زرہ (لات سی کوژو) سَوؤ سی چَھل تُھن (فائدہ سی) کأ ڇھیڙأد، کہ تھو لادا می (نقصانا ما) بچ کوئے، دَ کئی تھو (مُھن) کی شکر نِگھلدی؟
آں مھوئے سلیمانؑ سی کأ تیز بیلأئی تابع کیشی، کہ تِسی حکم دے دھیرین سی دِشکے چلودُود، کیمی یأ مھوئے برکت تھیئشی، آں مھوئے ہر شیئی سی علم تُھو۔
آں یام شیطانا ما مھال ہُم اَشیئ کہ سے سلیمانؑ سی کأ (سمندرا می) غوپہ دیؤدود، آں ایما علادہ دأل کم ہُم کوؤدود، آں مھو تھین حفاظت کوؤدود۔
آں ایوبؑ یاد کو، کے یأ تی تنو پروردگار گے ہاگاد، کہ مھیئے تکلیف اَوؤدُو، آں تُو ٹولے ما زیاد رحم کوؤ والا تُھو۔
دَ مھوئے تِسی دعا قبول کی، آں تِسی تکلیف دھوگو کی کا یأ تیزید اَشودا، آں مھوئے تیسکے تِسی شیر والا ہُم واپس کی، آں تِسی شانے دأل خلک ہُم، تنو رحمدیدے، (مِسی کأ یرأ) عبادت کوؤ والا سی کأ نصیحت ہوئے۔
آں اسماعیلؑ، آں ادریسؑ، آں ذولکفلؑ (ہُم یاد کوا)، ہے ٹول صوو کوؤ والا آ می اَشیئ۔
آں مھوئے ہأ تنو رحمت کے لھنگأت، یقیناً سے (ٹول خلک) نیک اَشیئ۔
آں ماش والا (یونسؑ) یاد کوا، کے یأ سے خفہ قاریل روان ہُو، آں مے خیال کی کہ تیزما مھوئے کی توَس نہ کونین، آخر تی أنچیگا می آواز کی کہ: "(اے پروردگار!) تھأ ما علاوہ دُوئی یام عبادت سی لائق نُو تُھو، تُو پاک تُھو، یقیناً آ زیاتیئی کوؤ والا تُھو"۔
دَ مھوئے تِسی دعا قبول کی، آں تیس غم ما بے غم کی، آں مھو ایمان والا خلگائے اَںئی ہاموڑ نجات دیدی۔
آں زکریا یاد کوا، کے یأ تی تنو پروردگار کے ہاگاد، کہ "اے مھی پروردگار! مھأ اَمن سید (بے اولادا) نہ چھو، آں اَںئی تُو ٹولے ما غورا وارث تُھو"۔
دَ مھوئے تِسی دعا قبول کی، آں تیسکے مھوئے یحیٰیؑ دید، آں تِسی ڇھی مھوئے تِسی (اولاد سی) قابل سَوأد، بیشک ہے خلک نیگی سی کم می ایکدوئی سید سألی کوؤدود، آں مھوئے طمع آں بھیت تے ہاگوؤدود، آں مُھن موش عاجزی کوؤدود۔
آں تے جوَئی (مریمؑ سی ذکر کو کآم یأ) کی یأ تنو عزت محفوظ کیشی، دَ تیمی تنو دیشا روح پھیگی، آں تے جوَئی آں تِسی پو مھوئے ٹول دُونیئی سی کأ اے نَخ سَواد۔
یقیناً تُھن أ اُمت ای اے اُمت چھی، آں آ تُھن رب تُھو، بس تھو صرف مھی عبادت کوا۔
آں ہیئے خلگے تنو دین می اختلاف پیدا کیدو (خو) ہرایک کے مُھن دیشکے واپس ییؤ تُھو۔
دَ کآم یأ نیک کم کودی، آں مومن ہُم ہوئیو، دَ تِسی عمل ضائع کوا نہ بژنین، آں یقیناً مھو تِسی عمل لیگدی۔
آں کامے خار یأ مھوئے تباہ کیو، تِسی دھرو والا سی کأ ناممکن تُھو کہ سے دُونیئی یے بھی واپس بژن۔
تے وخہ پورے، کے یأ یاجوج ماجوج کولاؤ کوا بژنین، آں تھیئے ہر اُوچات پوت ما دھأںئی دیل وائے وونین۔
آں سأس وعدہ نھیئی ہیو ہأ کأفرا سی أݜی کولاؤ دھرنین، (بھی تھیئے بننین کہ) مھوئے افسوس! مھو مے (حقیقت) ما غفلت می دھرئیشی، بلکہ مھو تنو اَمن زید ظلم کوؤدود۔
بے شک تھوئے آں تُھن معبودے، کھین یأ تھو اللہ ما علاوہ عبادت کودی، دیزوخ سی خشاک ہونین، آں تھوئے ٹولے تیمی داخل ہونین۔
آں کو سے (سأس سی) خدا اَشیئو، تھیئے (جہنم می) داخل نہ ہونین دے، آں تھیئے ٹولے تیمی ہمیشہ سی کأ ہونین۔
تھیت تھین چیگأ نُوخنین، آں تیمی تھیئے کی نو بُھوش بھانین۔
بیشک سے خلک کھین کأ غوراچا سی فیصلہ موش ما مُھن دیشا چھیو، تھأ عذاب ما بالکل دُھو ساتا بژنین۔
تھیئے دیزوخ سی کھݜا ہُم نہ بھوشنین، آں تھیئے تنو خوشیل شیئی آ می ہمیشہ سی کأ ہونین۔
تھأئے (قیامت سی) گھین بھیت سی کی خفگان نہ ہونین، آں مُلیکائے تھین موشکے یینین، (آں بننین کہ) أ تُھن سے دی تُھو کسی یأ تھوسید وعدہ کوا گیشی۔
کامے دی آسمان مھامُو پلڑا بژنین، کھامُو یأ لیگیل کاغذ پلڑا بژدُو، کھامُو یأ مھوئے اول پیرا پیدا کیشو، اَںئی ہامُو مھوئے ایس دُوآر پیدا کونین، أ مُھن ذمہ اے وعدہ چھی کیس یأ مھوئے خامخا پورا کونین۔
آں مھوئے نصیحت (یعنی تورات) ما بعد زبور می لیگودُو، دھیرین سی وارث مھی نیک بَنے ہونین۔
یقیناً مِسمی (قرآن می) عبادت کوؤ والا سی کأ زیرے (گھین خبر) چھی۔
آں مھوئے تھأ ٹول جہانا سی کأ رحمت سیوأدے پیؤدُو۔
(اے پیغمبرؑ!) تُو بن کہ مھی دیشکے دا صرف أ وحی ییژی کہ تُھن معبود صرف اے معبود تُھو، دَ کئی تھو مھیرے ہُم منَدی کو نأ؟
بھی ہُم کو ہے مُو گئأدیو، دَ تُو (ہأئے) بَن کہ مأ تھو بُٹ اے شان سی شیدأدتی، آں مھیئے أ پتہ نی چھی کہ کامے وعدہ تھوزید کوا گیژی دا سے نھیو چھی کو دُھو چھی۔
یقیناً اللہ اخکارہ بأدے ہُم جندُو، آں تھیئے ہُم جندُو کا یأ تھو بُورادی۔
آں آ نہ جندُو، ہوبھادُو أ (ہیساریئی) تُھن کأ اَزمیخ ہوئے، آں اے وخہ پورے فائدہ گھینو سی تھوئے مہلت ہوئے۔
(پیغمبرؑے) بنو:"اے مھی پروردگار! حق سی فیصلہ کو، آں مُھن رب مہربان تُھو، مھو تیما مدد نیمادی، تھأ بأدا سی بارا می کا یأ تھو بیان کودی" ،
اے خلک ہانا! تھو تنو رب (سی نافرمانی) ما بھیا، بیشکہ قیامت سی بھومیل چیر گھن شیئی تُھو؛
کامے دی تأ پشنین کہ، ہر ڇھی پیؤ والا جوَئی تنو چیش پُو لؤ اَموݜا تھلنین، آں اُمیدوار جوَئی تنو بین وخ ما موش لار تھلنین، آں تأ خلک گاگیر پشنین، (حالانکہ حقیقت می) تھیئے گاگیر نہ ہونین، اَسے اللہ سی عذاب چیر سخ ہونین۔
آں خلگے ما زینی مھال تھی، کہ سے بغیر علم ما اللہ سی بارا می لات کودی، آں ہر ناڑاما شیطان سی تابعداری کودی۔
(شیطان) سی بارا می لیگا گودُو، کہ تیس کی سأت گادو سے تیس خامخا گمراہ کودو، آں دیزوخ سی عذاب سی دِشکے پان پشادو۔
اے خلک ہانا! کو تھوئے دُووآر (جینی ہیدے) اُوشو سی بارہ می کی شک چھیو د (یاد ساتہ کہ)، مھوئے تھو (اول پیرا) سُم ما پیدا کیشی، بھی نطفہ ما، بھی ڙات سی ٹوٹا ما، بھی ماس سی لوڈ ما، یام سالم یام نیمگڑے، تاکہ تھوزید (مھو تنو قدرت) واضحہ کیئی، آں رحم می کیس نیمادو اے خاص وخہ پورے ساتدی، بھی تھوما لؤ سیوأدے نیگھالدی، بھی (تُھن پرورش کیدے) تاکہ تھو تنو پورا زوأنی یے آوا، بھی تھومی زینی آسی ساء گھینا بژژی آں زینی لأݜ اُومو آپورے جن دھرا بژدی، تاکہ سے ہرکی جیندے بھی ہُم نہ جنن، آں تھو پشدی کہ دھیرین شوگیل ہوژی، بھی یأ کے مھو ایزید اگھا موژادی دا سے پھرگژی آں پھونڈژی آں ہر قسم سی شیژو نِل گیا نِگھالو شروع کوژی۔
أ ٹول مِسی کأ اللہ (سی وجود) برحق تُھو آں سے مئیل جینی کودو، آں سے ہر بأت زید طاقت لردو،
آں یقیناً قیامت ییؤ والا تُھو، تیمی کی شک نی چھی، آں اللہ تھأ ٹول جینی کیدے اُوچات کونین کآم یأ قور آمی تھی۔
آں خلگا می زینی مھال ہُم تھی کہ سے اللہ سی بارہ می لات کودی، بغیر علم ما، بغیر کی ہدایت ما آں بغیر لوشیل کتاب ما،
لوئی دے تنو ڈھار کیلی کودی، مِسی کأ یرأ (خلک) اللہ سی پَن ما گمراہ کیئی، مھال ماݜ سی کأ دُونیئی می (ہُم) مختور ہوؤ تُھو، آں قیامت سی دی ہُم مھوئے تیسکے جلیل آنگا سی عذاب سی مزہ چکھانین۔
أ تھأ اعمال آسی سزا چھی کآم یأ تی موش کیدے پیئیشی، اللہ تنو بن آزید یئت ہُم ظلم نہ کودو۔
آں خلگا می یام سے ہُم تھی کہ اللہ سی عبادت دھیر (سی غاڑے) زید اِڑی ہیدے کودی، دَ کو یأئے دُونیئی می کی فایدہ میلاؤ ہوو تھلا تیزید حی تھادی، آں کو کی مصیبت میلاؤ ہیو بھی تیما مُو نڑادی، ہیئے دُونیئی و آخرت سی نقصان کی، اَںئی ہے اخکارہ نقصان تُھو۔
(ہال ماݜ) اللہ چھیدے تیسکے آواز دیدی کآم یأ ہأئے نأ نقصان آوابھادی آں نأئی فایدہ دے بھادی، ہے چیر دُھو سی گمراہی چھی۔
ہے مھال (لووال خدئی) آئے ہاگادو کہ تِسی نقصان نفع ما چیر نھیو تُھو، کا لاݜ مالک تُھو، کا لاݜ سأت تُھو
اللہ تھأ خلک کی یأ ایمان اَنو آن نیک عمل کی، مھال باغ آئے لھنگانین کامیگا سی ٹین کآن جاری تھی، بیشکہ اللہ کا نیمادوو تیس کودو
کامے ماݜ مے خیال کودو کہ اللہ دُونیئی و آخرت می تنو (پیغمبرؐ) سی مدد نہ کونین، تیسکے پکار تُھو کہ سے آسمان آ پورے اے رسی تھلے، بھی تیس (وحی سی سلسلہ) چھینے، بھی پَشے کہ تِسی چال تے شیئی دھگو کوبھادو کا یأ ایسکے قار اَندو؟
آں اَںئی مھاموڑ مھوئے مے (قرآن) اخکارہ آیادا سی شکل می نازل کیدو، آں کیس کے یأ اللہ نیمادو تیسکے ہدایت دیدو۔
بیشکہ کامے خلگے یأ ایمان اَنودو، آں کآم یأ یہودی تھی آں صابی تھی، آں عیسائی تھی، آں مجوسی تھی آں کآم یأ مشرک تھی، اللہ ہین مِیئے فیصلہ کونین قیامت سی دِیئے، بیشکہ اللہ ہر شیئی زید گواہ تُھو۔
کئی تھو نہ پشدی اللہ سی موشکے (بُٹ) سجدہ کودی، کامے مخلوق یأ آسمان آمی چھی آں کامیک یأ دھیرینے چھی، آں سی و یُن، آں تاء و کھن، آں تھام و څاروئی، آں چیر انسان ہُم (سجدہ کودی)؟ آں چیر مھال تھی تھأزید عذاب سی فیصلہ ہیژی، آں کیس یأ اللہ ذلیل کیو تیسکے کی عزت دینین؟ بیشکہ اللہ کا نیمادوو تیس کودو۔
أ دو مخالف ڈلہ تھی، سے تنو رب سی بارہ می لات کودی، دَ (ہأمی) کی یأ کفر کیدوو تِسی کأ آنگا سی کوژو بأژا گئیدی، ہین ݜا آسی ڙید خوڑوگیل اُو تھلا بژنین۔
(خوڑوگیل اُو دے) ہین ڈھے آسی مِیئے کا تُھوو تی، آں (ہین) چَم گالا بژنین،
آں ہین کأ چیمو سی ماتوڑ ہونین،
کے ہُم تھیئے تے (عذاب سی) تکلیف ما نُخو سی ارادہ کیو، دُوآر تِسمی تھلا بژنین، (آں بنا بژنین کہ) "چکھا جلو سی عذاب سی مزہ!"،
(دُوئی دِشکے) یقیناً اللہ تھأ خلک، کی یأ ایمان اَنودو آں نیک عمل کیدی، مھال باغ آئے لھنگانین کہ، تھین ٹین دے نھید بژنین، تھید تھأ لھگور زر سی بنگڑئی آں غمئی یدے شیژیئی کوا بژنین، آں تھید تھین کوژو أشیمیل ہونین۔
(مھوئے مِسی کأ دُونیئی می) ہأئے پاکیزہ کلام سی ہدایت دیدیشی، آں خدئ سی دِشکے پان ہأئے پشا گیشی۔
بیشکہ سے خلک کی یأ کفر اختیار کی، آں دأل خلک اللہ سی پَن ما آں مسجد حرام ما کھمدی، کامیک یأ مھوئے خلگا سی کأ مھال سوادتو کہ تھید سی دھرو والا آں بھارا ییؤ والا برابر تھی، کآم ہُم اِسمی ظلم کیدے کیل پان نیگھألدوو مھوئے تیس کے دردناک عذاب سی مزہ چکھانین۔
آں کے یأ مھوئے ابراہیمؑ گے شیر (بیت اللہ شریف) سی پوت پشاد، آں (حکم دید) کہ مھوزید یس شریک نہ کو، آں مھی شیر صفا کوا، طواف کوؤ والا سی کأ، قیام کوؤ والا سی کأ، آں رکوع و سجدہ کوؤ والا آ سی کأ۔
آں خلگا می حج سی کأ اعلان کو، خلگے چھی کأشکے پیادہ ہُم ینین، آں خوا اُوخأن آزید ہُم، دُھو دُھو پَن ایدے اَوونین۔
مِسی کأ سے تھأ فایدہ پَشن، کامیک یأ تھین کأ تھی، آں مقرر دی آمی تھأ زیناور آزید اللہ سی نام گھینن، کامیک یأ تی ہأئے دیدتی، "دَ (اے مسلمان ہانا!) تھو أمیدے ہُم کھا آں ہات تانگ مُتاز آزید ہُم کھیا"۔
بھی (احرام نیگھألدے خلک) تنو مَل دھوگو کوئن، تنو نذر پورا کوئن، آں پُرأن شیر (کعبہ شریفہ) سی طواف کوئن۔
أ (اَشی کعبہ سی مقصد) آں کآم یأ اللہ سی پشیل نخ آسی عزت کودو دَ ہے اللہ سی نیز می تِسی کأ غورا تُھو، آں تُھن کأ چارپا حلال کوا گئیدی، سیوائے تھیئے ما یأ کِسی تھوئے بنا گودو، بس بچ کوا اَمن بُھوت آسی گندگی ما، آں بچ کوا اَمن لووأل بأت ما۔
خاص اللہ سی ہوا، تیسید یس شریک نہ کیدے، آں کآم اللہ سید شریک کودوو سے مھاموڑ یابنے آسمان ما لار گا، بھی تیس (یابنے) پیݜینے ٹوگو یا بیلیئی اُوچات کیدے دُھو پوت کے نُو۔
اَںئی أ (بات چھی) آں کی یأ اللہ سی نخ آسی احترام کیو، دَ بیشکہ ہے حی آسی پرہیزگاری چھی۔
تُھن کأ (قربأنی سی زیناور) آمی اے وخہ پورے فائدہ تُھو، بھی تھأ پرأن شیر (کعبہ شریفہ) پورے (ذبح کوؤ سی کأ) اَوؤ تُھو۔
مھوئے ہر اُمت سی کأ قربأنی سی طریقہ مقرر کیدو، مِسی کأ کہ ہے تھأ زیناور څاروئی آزید اللہ سی نام گھینن کآم یأ ہأئے (اللہ) دیدتی، دَ (یاد ساتہ کہ) تُھن معبود صرف اے اللہ تُھو، تھلا تھو اَںئی تِسی فرمان برادری کوا، آں (اے نبیؐ) عاجزی کوؤ والائے زیرے دے۔
سے (خلک) یأ کے تھین موشکے اللہ سی نام گھینو تھین حی بھیدی، آں کا مصیبت ہأزید أبو تیزید صوو کودی، نیماز گوزادی، آں کا رزق مھوئے تھأئے دیدتو دا تیما خرچ کودی۔
آں (قربأنی سی) اُوخ مھوئے تُھن کأ اللہ سی نخ مقرر کیدی، ایمی تُھن کأ خیر تُھو، دَ ہأ اِڑی کیدے ہأزید اللہ سی نام گھینا، آں (قربأنی ما بعد) کے ہین پیٹھ دھیرین گے وأدو، دَ تیما تھو أمیدے ہُم کھا، آں تھأئے ہُم دا کآم یأ صوو کیدے بھیڈتی، آں تھأئے ہُم کآم سوالگر تھی، مھأ زیناور مھوئے تُھن قابو می دیدتی، مِسی کأ کہ تھو شکر نیگھالا۔
اللہ یے نأ ہین ماس اَوودو نأئی ہین ڙات، اَسے تیسکے تُھن پرہیزگأری اَووژی، مھاموڑ مھأ شیئی تُھن کأ تابع کیدی کہ تھو اللہ سی دیل ہدایت زید تِسی گھینیئی بیان کوا، آں (اے پیغمبرؐ!) نیک خلگائے زیرے دے۔
بیشکہ اللہ (دشمنے ما) بچ کودو تھأ خلک کی یأ ایمان اَنودو، بیشکہ اللہ اے خیانتگر ناشکرا نہ خوشادو۔
اجازت چھی (لات سی) تھأ خلگائے کیسیت یأ لات کوا بژژی، کئیکہ تھأسید ظلم ہودو، بیشکہ اللہ تھأسید مدد سی توان لردو،
أ سے خلک تھی، کہ سے تنو شیرے ما ناحق نیگھالا گئیدی، صرف مے بأت سی کأ کہ سے بندی "اللہ مُھن رب تُھو"، آں کو اللہ بچ نی کیشیو، زینی خلک زینی خلگے ما، دَ (راہب آسی) خانقاہ آں (عیسائی آسی) گرجا آں (یہودی آسی) عبادت خانہ آں (مسلمان آسی) جومأدے، کِسمی یأ اللہ سی نام چیر چیر گھینا بژدو، ڈیگا بژنیندے، اللہ ضرور تھأ خلگا سی مدد کودو کآم یأ تِسی (دین سی) مدد کودی، بیشکہ اللہ گھین طاقت والا، گھن اقتدار والا تُھو۔
ہے سے (خلک تھی) یأ مھوئے ہأئے دھیرین زید اقتدار دیدو، ہیئے نیماز قائم کونین، ذکواۃ دینین، نیک کم آسی حکم دینین آں لاݜ کمے ما منع کونین، آں ٹول کم آسی کوؤ سی اختیار تہ اللہ کیش تُھو۔
آں (اے پیغمبرؐ!) کو ہے تھأ لووال گھنڈدیو ہیئے ما موش نوحؑ آں عاد آں ثمود سی قومے ہُم (پیغمبر) لووال گھنڈیئشی،
آں ابراہیمؑ سی قوم آں لوطؑ سی قوم (ہُم پیغمبر لووال گھنڈئیشی)
آں مدین سی خلگے ہُم (پیغمبر لووال گھنڈیئشی)، آں موسٰیؑ ہُم لووال گھنڈا گوشو، دَ ہأ کأفرائے مأ دھأک مہلت دید، بھی تھأ گأد، کھال اَشو مھی عذاب!
دَ کھیدیک گام اَشئ کہ سے ظلم کوؤدود تہ تھأ مھوئے تباہ کیدی، مھیرے سے تنو شان آزید موتھأ بژیل تھی، آں کھیدیک کُوئی بیکارہ بژیل تھی، آں کھیدیک پوخ محل (کنڈر سوا گئیدی)۔
کئی أ خلک دُونیئی می گُوئیدی نأ (ہے عبرت گھینندے)، کہ ہیں مھال حی ہوندے کہ سے جنندے، آں مھال کَن ہوندے کہ سے بُھوژندے؟ حقیقت أ چھی کہ أݜی أن نہ ہودی، بلکہ سے حی اَن ہودی یأ سینہ آسی اندے ہودی۔
آں أ خلک تھأما جلد عذاب نیمادی، آں اللہ یئت ہُم تنو وعدہ می پاتے نے ییدو، آں بیشکہ چھی رب سی نیز می اے دی تُھن حساب سی زر کال آسی برابر تُھو۔
آں کھیدیک گام مھال اَشئ کہ تھأئے مأ مہلت دیدیشی، آں سے ظلم کوا ییؤدود، بھی مأ تھأ گأد، آں ییؤ دا آخر مھی کأنگے تُھو۔
(اے پیغمبرؐ!) بَن کہ: اے خلک ہانا! بیشکہ آ تُھن کأ اے اخکارہ خبردأری دیؤ والا تُھو۔
دَ کآم خلک یأ تھیئے ایمان انو آں نیک عمل کی، تھین کأ بوگوشو تُھو، آں عزت سی رزق چھی۔
آں کآم خلک یأ مُھن آیات عاجز کوؤ سی کوشش کودی، اَںئی سے خلک دیزوخی تھی۔
(اے پیغمبرؐ!) آں مھوئے تھأما موش کی پیغمبر یا نبی مھال نہ پیؤدو یأ تِسی ارمان آمی شیطان تنو وسوسہ شامل نی کیدوو، اَسے اللہ شیطان سی وسوسہ دھوگو کیدے بھی تنو آیات پیگی کیدی، اللہ ہر شیئی ما شید آں گھن حکمت سی کھمان تُھو۔
مِسی کأ کہ شیطان سی تھلیل (وسوسہ) تھأ خلگا سی کأ اَزمیخ سی زریعہ سوا بژے، کسی یأ حی آمی مرض چھی، آں تھین حی سخ تھی، آں بیشکہ ہے ظألم خلک بغض می چیر دُھو گئیدی۔
آں مِسی کأ کہ سے خلک جنن کیسکے یأ علم دیا گودو، کہ بیشکہ أ (کلام) حق تُھو چھی پروردگار سی دِشا، بھی سے ایزید ایمان اَنن، آں تھین حی اِسی موشکے وا ہون، یقیناً اللہ ایماندائے ݜیݜ پَن سی ہدایت دیدو۔
آں کامے خلگے یأ کفر کیدو، تھیئے ہمیشہ سی کأ (قرآن) سی بارہ می شک می بژیل ہونین، تھیدیخانگے یأ تھأزید نأڅأپی قیامت سی ساعدے ینین، یا اے اِسپور دی سی عذاب تھأزید نازل ہونین۔
تے دی بأچیئی صرف اللہ سی ہونین، تی تھین مِیئے فیصلہ کونین، دَ کآم خلگے یأ ایمان اَنو آں نیک عمل کی، تھین کأ نعمدے ما ڈک باغ ہونین۔
آں کآم خلگے یأ کفر کی، آں مُھن آیات لووال گھنئی، دَ ہأ خلگا سی کأ اُوپھڈاچا سی عذاب ہونین۔
آں کآم خلگے یأ ہجرت کی اللہ سی پَن دے، بھی سے ما گئی یا مُوئی، اللہ ہأئے شیژے رزق دینین، آں یقیناً اللہ چیر غورہ رزق دیؤ والا تُھو۔
تی (اللہ) تھأ مھال پوت کے اَوانین، کہ تیدے تھیئے چیر خوشال ہونین، آں بیشکہ اللہ ہر بأت ما جنو والا آں برداشت والا تُھو۔
أ (بات تہ ہیژی) آں کامے ماݜ مھدیک بدل گھین، کھیدیک یأ تیزید زأتیئی کوا گیشی، بھی (دُوآر) تیزید زأتیئی کوا گأو، دَ اللہ ضرور تِسی مدد کونین، یقیناً اللہ معاف کوؤ والا آں بگوشو والا تُھو۔
أ مِسی کأ کہ، اللہ ڙات دی خونا لھنگادو آں دی ڙأت خونا لھنگادو، آں اللہ ہرکی بُھوژو والا، ہرکی پَشو والا تُھو۔
أ مِسی کأ کہ، اَںئی اللہ مُو حق تُھو، آں ہے خلک یأ تیس چھیدے کسی عبادت کودی دا، سے باطل تُھو، آں اللہ بُڈے ما اُوچات، بُڈے ما گھن تُھو۔
کئی تھو پشدی نأ، کہ اللہ آسمان ما اُو والدو، دَ تیدے دھیرین نیلی ہیدے بژژی؟ بیشکہ اللہ گھن مہربان آں ہر شیئی ما شید تُھو۔
ہر کی تِسی تُھو کا یأ آسمان آمی تُھو آں کا یأ دھیرینے تُھو، آں بیشکہ اللہ اَمنا پورا آں ہر صفت سی لائق تُھو۔
کئی تھو نہ پشدی کہ اللہ کا ہُم دُونیئی می تُھو تُھن کأ کم می ݜژادتو، ، آں سے کشتی ہُم یأ سمندر می تِسی حکم دے گئیدی؟ آں آسمان مھاموڑ اُوچات گادتو کہ سے تِسی اجازت ما بغیر دھیرین زید لار بژے، بیشکہ اللہ بَن آسی کأ چیر زیاد رحم کوؤ والا مہربان تُھو۔
آں (اللہ) اَںئی سے تُھو یأ تھوئے جیدون دیدتو، بھی تھوئے مئیک دیدو، بھی (دوآر) تھو جینی کونین، بیشکہ انسان چیر ناشکرا تُھو۔
مھوئے ہرے اُمت سی (خلگا سی) کأ عبادت سے اے طریقہ مقرر کیدو، تیزید سے عمل کودی، دَ (اے پیغمبرؐ!) خلک تھیزید مے بأت می لات نہ کوئن، آں تو تنو پروردگار سی دِشکے (خلگائے) دعوت دے، بیشک تو سیدا پَن زید تُھو۔
آں کو ہے تھیسیت لات کؤسأدو تو بَن: "کا یأ تھو کودیدا اللہ یے تِسی علم تُھو"۔
اللہ قیامت سی دی تُھن مِیئے تھأ بُڈ بأدا سی فیصلہ کونین، کیمی یأ تھو ایکدوئی سید اختلاف کوؤدود۔
کئی تھو نہ جندی کہ آسمان و دھیرین سی بُڈ شیئی اللہ سی علم می تھی؟ ہے بُڈ شیئی اے کتاب (لوح محفوظ) می لیگیل تھی، بیشکہ ہے اللہ سی کأ کی بوکھو نہ تُھو۔
آں ہے خلک اللہ چھیدے تھأ شیئی آسی عبادت کودی، کسی کأ یأ اللہ کی دلیل نازل نی کیدو، آں نأئی ہے خلک أمیدے تِسی بارہ می کی علم لردی، ہأ ظألم آسی کأ (آخرت می) یی مددگار نہ ہونین۔
آں کے ہأئے مُھن آیات کولاؤ کولاؤ بُھوژا بژدی دا، تھو ہأ کأفر آسی بوت آزید خپگان پشدی، مھاموڑ معلوم ہودو ہیئے تھأ خلک آزید حملہ کونین کآم یأ ہأئے مُھن آیات بُھوژادی، ہأئے بَن: "آ تھوئے بینی ایما زیاد لاݜ شیئی کا تُھو؟" آنگا! اللہ کأفر آسید تِسی وعدہ کیژی، آں سے چیر لاݜ پوت تُھو۔
اے خلک ہانا! اے مثال بیان کوا بژدو دَ ایس کان تھأدے بُھوژا! تھو یأ کیسکے ہاگادی دا اللہ چھیدے، سے اے میݜی ہُم پیدا نہ کوبھادی، کو سے بُڈ جمع ہُم ہوئیو تِسی کأ، آں کو میݜی ہأکیژا کی شیئی ڈیادو، دَ سے تیس تیما گھرا بھادی ہُم نأ، (دَ) نیمؤ والا ہُم کمزور آں کیس کیژا نیمادی دا سے ہُم کمزور۔
تھیئے اللہ سی مرتبہ کھأکأ پیانو اَشودا تھاموڑ نہ پیانو، بیشک اللہ زبردست غالب تُھو۔
اللہ مُلیگے ما ہُم پیغام سی اَوؤ سی کأ کاردو آں انسان آما ہُم، بیشک اللہ بُھوژو والا آں پشو والا تُھو۔
سے بُڈ بأت جندو، کا یأ ہین مُوشکے تُھو آں کا یأ ہین پأشکے تُھو، آں بڈ کم اللہ سی دِشکے نرا بژدی۔
اے خلک ہانا کی یأ ایمان اَنودو! رکوع کوا آں سجدہ کوا، آں بندگی کوا تنو پروردگار سی، آں نیگی سی کم کوا، مِسی کأ کہ تھو کامیاب ہوا،
آں اللہ (سی پَن) می جہاد کوا، کھأکأ یأ جہاد سی حق تُھو، تی تھو تنو کم سی کأ خوشأدتی، آں تھوزید دین می کی تنگی نہ تھیئی یی، تنو بوپ ابراہیمؑ سی دین جوخ گݜا، (اللہ) مُوش ہُم تُھن نام "مسلم" تھوؤشو، آں مے (قرآن) می ہُم (تُھن ہے نام تُھو)، مِسی کأ کہ پیغمبرؐ تھوزید گواہ ہوئے آں تھو خلگا زید گواہ ہوا، دَ تھو نماز گوزا آں ذکواۃ دا، آں اللہ (سی دین) جوخ گݜا، اَںئی سے تُھن کام سَوا تُھو، سے کھیدیک غورا کام سَوا تُھو، کھیدیک غورا مددگار تُھو!
بے شکہ مسلمان کامیاب ہوئی۔
کآم یأ تُنو نِماز می عاجزی کوؤ والا تھی۔
آں کآم یأ فالتو بأدے ما مُو نُڑؤ والا تھی۔
آں کآم یأ ذکواۃ دیوؤ والا تھی۔
آں کآم یأ تُنو شرمگاہ آ سی حفاظت کوؤ والا تھی۔
سیوائے تُنو ڇھی آ ما یا گُلأما ما، کئیکہ ہأزیت کی ملامتیا نی چھی۔
دَ کآم ہُم میما علاوہ نیمؤسأدو سے خلک حد ما لھنگو والا تھی۔
آں سے خلک کآم یأ تُنو امانت آ سی آں تُنو لوظ آ سی خیال کوؤ والا تھی۔
آں سے خلک یأ تُنو نماز آ سی حفاظت کوؤ والا تھی۔
ہُم ہے خلک میراث گھینو والا تھی۔
کیس کے یأ میراث می جنت دیا بژنین دا ہیئے تیمی مُوا سی کأ ہونین۔
آں مھوئے انسان پیدا کیدو سرَڑیل سُم ما۔
بھی مھوئے تِسما نطفہ (ٹیگیل) سوأد محفوظ پوت می۔
بھی مھوئے نطفہ ما ڙات سی ٹوٹا سواد، بھی مھوئے ڙات سی ٹوٹا ما ماس سی ٹوٹا سواد، بھی مھوئے ماس سی ٹوٹا ما ہاروک سوأد، بھی مھوئے ہَرا زیت ماس تھلُو، بھی مھوئے اِیزما اے نیمے مخلوق پیدا کی، دَ برکت والا تُھو اللہ ٹولے ما غورہ سوؤ والا۔
بھی بے شکہ تھو میما بعد موؤ والا تھی۔
بھی بےشکہ تھوئے قیامت سی دی اُوشا بژنین۔
آں بےشکہ مھوئے تُھن ڙید سات آسمان پیدا کی، آں مھو تُنو مخلوق ما غافلہ نی تھی۔
آں مھوئے آسمان ما نازل کی اُو اے اندازہ دے، بھی ہیسار کی مھوئے اے اُو دھیرینے، آں بےشکہ مھو اے اُو سی دھگو کوؤ زید ہُم قادر تھی۔
دَ بھی مھوئے اے اُو ما تُھن کأ کجُور آں دݜ سی باغ پیدا کی، تُھن کأ ہأمی چیر میوا تھی، آں ہیئے (میوا آ) ما تھو کھادی۔
آں (مھوئے پیدا کی) اے تھام نُوخودو سے سینا سی کھن ما، سے تھام تیل آں ٹِگون دیدو کھوؤ والا سی کأ۔
آں بےشکہ تُھن کأ څاروئی آ می عبرت چھی، مھو پیادی تھوزید کا یأ تِھن ڈھے آ می تُھو دا، آں تُھن کأ ہأمی چیر فائدہ تھی، آں ہیئے ما زینی تھو کھادی۔
آں ہأزید آں کشتی آ زید تھو سورلی کودی۔
آں بےشکہ مھوئے پیؤشو نوحؑ تِسی قوم گے، دَ تی بنو اے مھی قومأ! عبادت کوا اللہ سی، تُھن کأ دوئی یام معبود نُو تُھو اللہ ما علاوہ، کئی تھو نہ بھیدی؟
دَ اِسی قوم سی گھنے بنو کآم یأ کأفر اَشیئ، "أ (نوحؑ) دا تُھن شانے اے انسان تُھو، ہے تھوزید گھینیئی نیمادو، آں کو اللہ نیمادوشوو (پیغمبرا سی پوت) مُلیک نازل کونیندے، مھوئے تُنو موٹِھک گھنے ما ہال کی بات نی بیدیشی"۔
ہے دُوئی کی نأ خو بس اے لیونئی ماݜ تُھو، دَ تھو دھأک وخا پورے انتظار کوا۔
(نوحؑ) بنو اے مھی ربأ! مھی مدد کو مے بأت زید یأ ہیئے مھأ لوال گھنڈودو۔
تھلا مھوئے وحی کی تیسکے یرأ تو کشتی سَوا مُھن نگرانی می آں مُھن حکم دے، بھی کے یأ مُھن حکم آبو آں تانو جوش کیو دَ اے کشتی می ہر قسم (زناورے) مہ جوڑہ جوڑہ گھیندے تھا، آں تُنو شیر والا ہُم (سور کو)، اَسے تھیئے ما علاوہ کامیگا زید ڈوب ہوؤ سی حکم ہودو، آں مھیسیت تھأ خلگا سی بارہ می بات نو کو کی یأ ظلم کیدو، بےشکہ ہے غرک ہوؤ والا تھی۔
بھی کے یأ تو آں کآم یأ تھیسیت تھیدا کشتی زید غورہ کیدے سور ہوئی دَ تو بَن: "ٹول صفت خاص تے اللہ سی کأ تھی کی یأ مھو ظألم خلگے ما لھاسیئ۔
آں تو بَن اے مھی پروردگار! مھأ وال (کشتی ما) برکت والا پوت زید، آں تو چیر غورہ والو والا تُھو۔
بےشکہ اِیمی (عبرت سی) نخ تھی آں مھو اَزمیخ گھینو والا تھی۔
بھی مھوئے ہیئے ما بعد اے دوئی ڈلہ (قوم) پیدا کی۔
بھی مھوئے ہین کأ اَںئی ہیئے ما اے پیغمبر پیوؤ، (سے پیغمبر بنودود) "تھو اللہ سی عبادت کوا، تُھن کأ تیما علاوہ دوئی یام معبود نہ تُھو، دَ کئی تھو نہ بھیدی؟"۔
آں بنو اِسی قوم سی سردارے کآم یأ کأفر اَشیئ آں لَوو گھنودُود آخرت سی ملاقات آں دیدوشو مھوئے ہأئے دونیئی سی جیدون می عیش و آرام یرأ "ہے دا نو تُھو بس تُھن شانے اے انسان، ہے تھأ شیئیے ما کھادُو کامیگے ما تھو کھادی، آں ہے تھأ شیئیے ما پُودو کامیگے ما تھو پُودی"۔
آں کو تھوئے تُنو شانے انسان سی بات مینیو تھلا دا بےشکہ تھو تاوان کوؤ والا تھی (تأوأنی تھی)۔
"کئی ہے (نوحؑ) تھوسیت وعدہ کودو، یرأ کے تھو مویو، آں تھو سُما سُم آں ہأریک ہوئیو، تھلا تھوئے دُووآر (دھیرین ما) نِگھلا بژنین؟"
"دُھو چھی، دُھو چھی سے بات کِسی یأ تھوسیت وعدہ کوا بَژژی!"۔
"(جیدون دا) دوئی کی نو تُھو اَسے مُھن دونیئی سی جیدون تُھو، مھو مودی آں جینی ہودی آں مھوئے دُوآر (مئیک ما بعد) اُوشا نہ بژنین"۔
نہ تھو مگر ہے اے ماݜ اللہ زید لوو سوادو آں مھو اِسی منو والا نی تھی۔ "ہے ماݜ دُوئی کی نُو تُھو بس اللہ زید لوو سَوادتُو، آں مھو اِسی منُو والا نی تھی"۔
(نوحؑ) بنو، "اے مھی پروردگار! تو مھی مدد کو (مے بأت زید یرأ) ہیئے مھأ لوال گھنودُو"۔
(اللہ) بنُو: دھأک ساعت می ہیئے خامخا پشیمانہ ہونین۔
بھی اے سخ آواز ہأ گأت انصاف تے، دَ مھوئے ہأ خَس خَس کیدے چھوئی، لعنت چھی ظألم خلگا زید!
ہیئے ما بعد بھی مھوئے دأل خلک پیدا کی۔
اے اُمت ہُم نأ تُنو مقرر وخ ما موش ہوبھئی آں نأ پتکے ہوبھئی۔
بھی مھوئے تُنو پیغمبر مُوش پأش پیئ، کے یأ اے اُمت کے تِسی پیغمبر اَوؤ دا تی تے پیغمبر لوال گھنُو، بھی مھوئے ہأ ختم کی ایک پیش دوئی، آں مھوئے ہأما (عبرت سی) قصہ سَوأد، دَ تباہی چھی تھأ خلگا سی کأ کآم یأ ایمان نہ اَندی۔
بھی مھوئے پیؤ موسٰیؑ آں تِسی بھا ہارونؑ تُنو آیادے سمانے آں اَخکارہ ثبوت (سمانے)،
فرعون آں تِسی سردارا سی دِشکے، دَ تھیئے اَمن گھن گھنُو، آں سے قتنگار قوم اَشُو،
دَ ہیئے بنُو: "کئی، مھو ایمان أنی تُنو شانے دو ماݜ آ زید، آں ہین خلک تا مُھن غلام ہُم تھی؟"
بھی ہیئے تھأ دوںئی پیغمبر لووال گھنیئی، بدَ سے تباہ کوئلے ما ہوئی۔
آں مھوئے بےشکہ موسٰیؑ یے کتاب (تورات) دید، مِسی کأ ہأئے صحیح پان پشا بژے؛
آں مھوئے مریمؑ سی پو آں تِسی یئی ما نَخ سوأد، آں مھوئے ہأ دوںیائے پناہ دید اُچات پوت زیت، سے پوت دھرو سی قابل آں اُوس والا اَشو۔
اے پیغمبر ہانا! پاک شیئیے ما کھا، آں نیک عمل کوا، یقیناً آ غورہ جَنو والا تُھو تھأ کمے ما کامیک یأ تھو کودی۔
آں بےشکہ تُھن اُمت اے اُمت چھی، آں آ تُھن رب تُھو، دَ تھو مھأ ما بھیا۔
دَ بھی ہیئے ایکدی می تُنو دین جدا جدا کی، ہرے ڈلہ تُنو بأت زید خوشحال چھی۔
دَ تُو ہأ ہین غفلت می چھو، اے خاص وخا پورے۔
کئی ہے (خلک) مے خیال کودی مھو ہأئے مال و اولاد تے مدد دیا یدی دا،
مھو تأدی کودی ہین کأ نیک کما می؟ نأ، بلکہ ہے نہ جنَدی۔
بےشکہ سے خلک کآم یأ تُنو رَب سی ہیبت ما بِھیدی،
آں سے خلک کآم یأ تُنو رب سی آیادا زید ایمان ساتدی،
آں کآم یأ تُنو رب سیت یام شریک نہ کودی،
آں کآم خلک یأ دیدی کا یأ دیدی (دے بھادی؟)، آں حی ہین بھیل ہودی یرأ بےشکہ ہے تُنو رب سی دِشکے واپس ہوؤ والا تھی۔
اَںئی ہے خلک تھی تأدی (سألی) کودی نیک کما می، آں ہے نیگی آ سی دِشکے مُوش مُوش ہوؤ والا تھی۔
آں مھو یِسکے ہُم تکلیف نہ دیدی خو تِسی وَس سی قابل، آں مھوکیش اے کتاب تُھو، سے ہمشہ حق بات بیان کودو، آں ہأزیت ظلم کوا نہ بژنین۔
اَسے ہین حی غفلت می تھی مے دین ما، آں ہین کأ (غفلت ما) علاوہ دأل کم تھی ہے تھأ کودی۔
مھیدیگاپورے، یأ کے مھوئے ہین مالدا خلک عذاب می گأدو ہیئے چیگأ نِگھلنین۔
(ہأئے بنا بژنین) آش چیگأ نی نِگھلا، بےشکہ مُھن دِشا تُھن مدد کوا نہ بژنین۔
بےشکہ مھی آیادا سی تلاوت کوا بیودُود تھوزید، دَ تھو تُنو کِھینے دے واپس ہؤدود،
لوئی کیدے اِسی (قرآن سی) بارہ می قصا سوؤدود، ڙأت کے منجلس سیوأدے بھروسی بنودُود۔
دَ کئی ہیئے غور نہ کی (اللہ سی) کلام زید؟ یا اَوؤشو ہأئے سے (علم کامیک) یأ ہین موٹھیک بوب دادائے نہ اَوؤشو؟
یائی ہیئے تُنو پیغمبر نہ پأنو دَ ہے تیما انکار کودی؟
یائی ہے بنَدی ایزید لیونتوب تُھو؟ نأ، بلکہ تی ہأئے حق (بات) أنی، اَسے ہائے ما چیر خلک حق بات نہ خوشادی۔
آں کو حق ہین خواہشات آ سی تابع ہوشوو دھیرین و آسمان آں ہین میئے کا تُھوو تی تباہ ہونیندے، بلکہ مھوئے ہأئے نصیحت (قرآن) دیدچی، دَ ہے تُنو نصیحت (قرآن) ما بوت نوڑؤ والا تھی۔
آیا تو نیمادو ہیئے ما کی میزدی؟ دَ میزدی چھی پروردگار سی چیر غورہ چھی، آں سے چیر غورہ رزق دیؤ والا تُھو۔
آں بےشکہ تو (اے نبیؑ) دعوت دیدُو ہأئے سیدا پن سی۔
آں بےشکہ کامے خلک یأ ایمان نہ آندی آخرت زید سے خامخا ڈھأر کے ہوئیدی سیدا پن ما۔
آں کو مھوئے ہأزید رحم کِیو، آں ہأزید کا تکلیف تُھو دا تیس دھوگو کیو، بھی ہُم ہیئے سرگردانہ تنُو نافرمانی زید اِڑی ہویل ہونین۔
آں مھوئے بےشکہ ہأ عذاب می گأد، دَ بھی ہُم ہیئے تُنو رب کے نأ عاجزی کی آں نأئی زأری کی۔
مھیدیگا پورے، کے یأ مھوئے ہأزید سخت عذاب سی درواز کولاؤ کونین دا تھلا ہیئے ایمی ناامید ہونین۔
أ اللہ سی ذات تُھو یأ تی پیدا کی تُھن کأ کَن آں أݜی آں حی، چیر آشوڑ تھو شکر کودی۔
أ اللہ سی ذات تُھو تی تھو خور کیدی دھیرینے آں تِسی دیشکے تھوئے سرڑا بژنین۔
آں أ اللہ سی ذات تُھو سے جینی کودُو، آں سے مادُو، آں تِسی اختیار می تُھو دِی و ڙأت سی بدلؤ، کئی، تھو عقل ما کام نی گھیندی؟
نأ، ہے دا تے بات بندی کامیک یأ موٹِھک خلگے بینیشی۔
ہے بندی: "کئی، مھو مُویو آں مھو سُم آں ہأریک ہوئیو، کئی، مھوئے دُووآر اُوشا بژنین؟
"بےشکہ مھوسیت آں مُھن بوب داد سیت ہُم مے بأت سی میما موش وعدہ کوا گیشی، ہے دُوئی کی نُو تُھو بس پُران خلگا سی قصہ تھی"۔
تو بَن (اے پیغمبرؑ!) کِسی کأ چھی دھیرین، آں کا یأ دھیرینے تُھو دا، کہ تھو جندی؟
سمدستی ہیئے بننین: خاص اللہ سی کأ تھی، بَن (اے پیغمبرؑ) دَ کئی تھو نصیحت قبول نہ کودی؟
تو بَن (اے پیغمبرؑ!) کآم تُھو رب سات آسمان آ سی، آں رب گھن عرش سی؟
ہیئے دستی بَننین: "خاص اللہ تُھو"، بَن تُو (اے پیغمبرؑ!) دَ تھو بھی ہُم نہ بھیدی؟
بَن تُو (اے پیغمبرؑ!) کآم تُھو سے تِسی ہات می ہر شیئی سی بأچیئی چھی؟ آں سے پناہ دیدو آں (تِسی مقابلہ می) پناہ دیا نہ بژبھادُو، کہ تھو جنہ دی؟
ہیئے دستی بَننین: "خاص اللہ تُھو" تو بَن: تھلا کامے پوت ما تھوزید جادو کوا بژدُو؟
بلکہ مھوئے ہأئے حق بات أوأدچی، آں بےشکہ ہے لووال تھی۔
اللہ تُنو کأ یام اولاد نہ گادتُو، آں نأئی تیسیت دوئی یام معبود تُھو، (کہ ہاموڑ اَشُوو) تھلا ہر معبود تُنو مخلوق جدا کونیندے، آں زینیئے زینی آ زید غالب ہونیندے، پاک تُھو اللہ تھأ بأدے ما کامیک یأ ہے بیان کودی۔
اللہ بیریت آں اخکارہ بأدے ما جنو والا تُھو، دَ اُچات تُھو (اللہ) تھأ شیئیے ما کامیک یأ ہے شریک کودی۔
تو دعا کو (اے پیغمبرؐ!) مھی پروردگار! کو تو مھیئے پشادُو تے عذاب کامیک سی یأ ہأسیت وعدہ کوا بژژی،
اے مھی پروردگار! دَ مھأ ظألم خلگا می شامل نہ کو۔
آں بےشکہ مھو مے بأت زید پورا طاقت لرہ دی یرأ کامے وعدا یأ مھو ہأسیت کودی تیس تھیئے ہُم پشئی۔
(اے پیغمبرؑ!) لاݜ سی مقابلہ چیر غورہ طریقہ دے کو، مھو تیما چیر غورہ جنَدی کا یأ ہے بیان کودی۔
آں تو دعا کو (اے پیغمبرؑ!) اے مھی پروردگار! آ پناہ نیمادو چھی شیطان آ سی وسوسائے ما،
آں پروردگار! آ چھی پناہ نیمادو مے بأت ما یرأ سے (شیطان) مھیئے حاضر ہوئن۔
کے یأ ہیئے ما ایک کے مئیک آبو، تھلا تی بَننین: اے مھی پروردگار! مھأ واپس (دونیئی یے) پے۔
مِسی کأ ییرأ آ نیک عمل کیئی تے دونیئی می کامیک یأ مأ چھیئی یی، یئت ہُم نأ! یقیناً أ صرف اے بات چھی یأ ہے بَندُو، آں ہین (مئیل آ سی) موشکے اے پردہ ہونین، تے دِی آ پورے کے یأ ہیئے دُوآر اُوشا بژنین۔
دَ کے یأ بیشیل وا پُھوک دیا گأو تھلا تے دی ہین میئے نأ سکاویلی ہونین، آں نأئی ہیئے ایکدی آ سی توَس کونین۔
دَ کسی (نیک عملا سی) ڇیگے ایگی ہیو تھلا اَںئی سے خلک کامیاب تھی۔
آں کسی (نیک عملا سی) ڇیگے اِپھڑی ہیو تھلا اَںئی سے خلک تھی کی یأ اَمن تاوان وا تھلو، ہیئے دیزوخ می ہمیشہ سی کأ ہونین۔
آنگا ہین بوت دھژانین آں ہیئے ایمی بدشکلہ ہونین۔
کئی مھی آیات تھوزید بنا نہ بیودُود، خو تھو تھأ لوو گھنودود؟
ہیئے بَننین: اے مُھن پروردگار! مھوزید مُھن بدبختی غالب ہی، آں مھو اے گمراہ قوم اَشو۔
اے مُھن پروردگار! مھو مے دیزوخ ما نِگھال، کو مھوئے دُووار (کفر و شرک) کِیو تھلا بےشکہ مھوئے ظلم کوؤ والا ہونین۔
(اللہ) بَننین: دَھوگو ہوا! اَنئی اے (دیزوخ) می ذلیل ہیدے بھئیا، آں مھیسیت بأت نہ کوا۔
بےشکہ مھی بندہ آ می ایک ڈلہ أشی سے بنودود: اے مُھن پروردگار! مھوئے ایمان اَنودو، دَ مھو بوگوش آں مھوزید رحم کو، آں تو ٹولے ما غورہ رحم کوؤ والا تُھو۔
اَسے تھو تھیئے پورے پیشاڑے کوؤدود، (تی پیشاڑے) تھوئے ما مھی ذکر اَموݜا تھلُوشو، آں تھو تھأ پیش ہزودُود۔
یقینا آش مأ تھأئے بدل دید تھین صوو سی وجہ دے، یقیناً سے کامیاب ہوئی۔
(اللہ) تھأئے بَننین: کھیدیک وخ تھو دھرئی دھیرین زید، کالا سی حساب تے؟
تھیئے بَننین: مھو دھرئی اے دی یائی دی سی دھأک حصہ، دَ توَس کو لیگو والا (مُلیگے) ما۔
(اللہ) بَننین: تھو چَیر اَشوڑ وخ سی کأ دھرئیدی، کاش کہ تھو جنأدے۔
آیا تھوئے مے خیال کیشو یرأ مھوئے تھو ہأئیمو پیدا کیدی، آں بےشکہ تھوئے مُھن دِشکے واپس کوا نہ بژنین؟
دَ اُچات تُھو اللہ، سے حقیقی بادشاہ تُھو، تیما علاوہ دوئی یام معبود نو تُھو، عزتمند عرش سی رَب تُھو۔
آں کآم یأ اللہ سیت دوئی معبود کے آواز کودُو، (حالانکہ) ایس کیش مے بأت سی کی دلیل نو تُھو، دَ یقیناً اِسی حساب خامخا تُنو رب سیت ہونین، بےشکہ کأفرے کامیاب نہ ہونین۔
آں تو بَن (اے پیغمبرؑ!) مھی پروردگار! تو مھو بوگوش آں رحم کو، آں تو ٹولے ما غورہ رحم کوؤ والا تُھو۔
طا سین میم
أ روخانہ کتاب سی آیات تھی۔
اَین تأ مے غم می اَمن مانین یرأ أ خلک ایمان (کئی) نہ اَندی۔
کو مھو نیمؤسأدو ہأزید آسمان ما مھالے نَخ نازل کیئی کہ تِسی موشکے ہین چونجو وا ہوئن۔
آں ہأئے کے ہُم رحمٰن سی دِشا نصیحت سی کی نیم بات وأدو ہے تیما مو نُڑادی۔
دَ مھاموڑ ہیئے حق لووال گھنو، دَ ہے کامے بأدا پیش پِشاڑے کوؤدود تا تھین حقیقت ہین کأن گے اَوونین۔
کئی ہے دھیرین گے نہ بودی مھوئے اِسما ہر قسم سی کھیدیک شیژے شیژے (جھیل) نیگھالئیدی؟
بیشکہ اِسمی (خلگا سی کأ) عبرت چھی، اَسے ہأمی اکثر خلک ایمان نہ اَندی۔
آں بیشکہ چھی پروردگار زوروڑ تُھو (آں) مہربان ہُم۔
آں (یاد کو تے وخ) کے یأ چھی پروردگار موسیٰؑ یے حکم کی: "تو ہأ ظألم خلگا سی کأن گے بش!"
فرعون سی قوم سی کأشکے، کئی سے بھیدی نأ؟
(موسیٰؑ) بنو: پروردگار آ بھیدو کہ ہیئے مھأ لووال گھننین۔
آں مھی حی چیوا بژدو آں مھی جیب ݜژئی، دَ ہارون گے نبوت پے،
آں مھیزید تھین اے دعوای ہُم چھی، دَ آ بھیدو تھیئے مھأ مانین۔
(اللہ) بنو: بالکل نأ، تھو دُوںئیدے مُھن نخ گھیندے بژا، بیشکہ مھو تھوزید تھی، ٹول بأت بھوژدی۔
تھو دُوںئیدے فرعون سی کأشکے بژا آں بنا: "بیشکہ مھو بٹ جہان آسی پروردگار سی پیغمبر تھی،
(آں مھو مِسی کأ پیا گئیدی) کہ: تُو بنی اسرائیل مھوسید پے"۔
(فرعون) بنو: "کئی مھوئے تھأ اَمن سید نہ ساتوشو لیویئی می؟ آں تأ تنو عمو سی چیر کال مھوسید دھیرتے نہ لھنگأدیشی؟"
"آں تأ تے کام کی کا یأ تأ کیدا، آں تو چیر ناشکرا تُھو"
(موسیٰؑ) بنو: "تے وخ می تے کام مأ کیدا آ ناپوھہ اَشو"
"دَ آ تھوما بھیت تے ڈیؤ، بھی مھی پروردگار مھیئے پوھہ دید، آں مھأ تنو پیغمبر آمی شامل کی"
"آں أ سے ملازہ تُھو تو مھیزید گئأدو دا، کہ تأ بنی اسرائیل گُلام سیوأدیشی؟"
فرعون بنو: "آں کا تُھو جہان آسی پروردگار؟"
(موسیٰؑ) بنو: "سے (اللہ) پروردگار تُھو آسمان آسی آں دھیرین سی، آں کا یأ ہین میئے تُھو، کو تو یقین کودوو"۔
(فرعون) تنو چاپیرہ خلگائے بنو "تھو میس بُھوژدی؟"
(موسیٰؑ) بنو: "سے تُھن ہُم پروردگار تُھو آں تُھن موٹھیک بوب داد سی ہُم"،
(فرعون) بنو: " تُھن أ پیغمبر یأ تُھن کأشکے پیاگودو دا، ہے بیخی لیونئی تُھو"۔
(موسیٰؑ) بنو: "سے پروردگار تُھو سی نوخین سی آں سی بژین سی، آں کا ہُم ہین میئے تُھو دا، کو تھوئے عقل ما کام گھینو"۔
(فرعون) بنو: کو تأ مھأ ما علاوہ دُوئی یس معبود گھنوو یقیناّ مأ تھأ قیدی آمی شامل کونین"۔
(موسیٰؑ) بنو: "آں کو مأ تھیئے مھال اے روخانہ شیئی پشادو، بھی؟"۔
(فرعون) بنو: "دَ آن تے (شیئی) کو تو سأسبن تُھوو"۔
دَ (کھأکأ اِی موسیٰؑ) تنو ہمسا تھیلی دا سے اے اخکارہ خامار سَوا گأ۔
آں تنو ہات ݲھیک تے (نیگھالو) دا سے ناڅاپا تماشگیر آسی کأ اُژل (بڑقوسأد)۔
(فرعون) تنو چاپیرہ سردارائے بنو: "أ ماݜ بیشکہ اے جنأل جادوگر تُھو"۔
"ہے نیمادو تھو تنو جادو سی زور تے تھو تُھن وطن ما نیگھالے، دَ تُھن کا خیال تُھو؟"
تھیئے بنو: "ایس آں اِسی بھا ہیسار کو، آں خارائے کوڑوال پے،
سے بُٹ ہُوشا جادوگر چھی کأشکے اَنن"
دَ اے مقرر دی سی نیٹائے بُٹ جادوگر جمع کوا گئی،
آں خلگائے بناگا "کئی تھو جمع ہودی (کو نأ)"؟
"ہوبھادو مھو جادوگر آسی پَن دے بِژی کو ہین برئی ہیو"
دَ کے یأ جادوگر اَئیدا تھیئے فرعون گے بنو: "مھوئے انعام دا میلاؤ ہونین نأ، کو مھوئے برئی ہیو؟"
(فرعون) کئیدا: "ہاں، بیشکہ تھوئے مھی نھیو سأدا می شامل ہونین"
موسیٰؑ تھأ (جادوگر) آئے بنو: "تھلا، کا یأ تھوئے تھلو دا"
دَ تھیئے تنو کھے و ہمسا تھلیئ آں بنو: "فرعون سی عزت سی قسم! یقیناً مھوئے برئی ہونین"
دَ بھی موسیٰؑ تنو ہمسا تھیلی، بو دا سے تھأ ٹول نوگلوسأد کا یأ ہیئے سیوأدیشی۔
دَ جادوگر سجدہ می گئی
تھیئے بنو: "مھو جہان آسی پروردگار زید ایمان آندی"
"موسیٰؑ آں ہارون سی پروردگار زید"
(فرعون) بنو: "تھوئے ایزید ایمان اَنو میما موش کہ آ تھوئے اجازت دَئیدے، بیشکہ ہے تُھن گھن تُھو، کی یأ تھوئے ایس (جادو) ڇھیڙادتو، اِسی کأ چیر جلد تھوئے اِسی انجام معلوم ہونین، مأ تُھن ہات آں تھُن کُھو اَدل بدل چِھنانین، آں تُھو بُٹ پھانسی کوانین"۔
تھیئے بنو: "کی بات نی چھی، بیشکہ مھوئے تنو پروردگار سی دِشکے واپس ہوؤ تُھو"۔
مھو مے طم لردی یرأ مُھن پروردگار مُھن گناہ بوگوشنین، کئیکہ مھوئے بٔوڑے ما موش ایمان اَنوشو۔
آں مھوئے موسیٰؑ یے وحی کی کہ مُھن بَن گھیندے ڙأدوڙأد نوخ، بیشکہ (فرعون سی خلگے) تھوپیش پأشا یےنین۔
دَ بھی فرعون (پھوجی جمع کوؤ سی کأ) خارائے ماݜ پیئی۔
(آں تھأئے بنو کہ) بیشکہ أ دھأک شانہ خلگا سی اے ٹولگی چھی،
آں ہیئے مھو چیر سخ خپا کیدی،
آں مھو غورا تکڑا ٹولگی سی خلک تھی،
دَ مھاموڑ مھوئے ہأ (فرعونی) باغ و اوسوئے ما نیگھالئی،
آں خزانے ما آں شیئے شیرے ما،
(تھأسید) مھاموڑ ہو، آں بنی اسرائیل ما مھوئے ہأ شیئی آسی وارث سیوأد،
دَ سے تھأپیش سی نوخین سی وخہ نیگھاد،
دَ کے یأ دُوںئی ڈلہ یے ایکدی ڈیڈ تا موسیٰؑ سی سأدے بنو: "مھو دا گݜا گئی"
(موسیٰؑ) بنو: "بیشکہ مھی پروردگار مھیسیت تُھو، تی مھیئے پان پشانین"۔
دَ مھوئے وحی پیئی موسیٰؑ یے یرأ تنو ہمسادے دریاب سی داک دے، دَ (دریاب) پھلو، آں ہر اے ٹوٹا یأ گھن اے کھان سَوا گا۔
آں مھوئے دأل ہُم تے پوت کے نھیئی کی
آں مھوئے موسیٰؑ آں کآم یأ تیسیت اَشودا بُٹ بچ کی
بھی دأل مھوئے غرک کی
بیشکہ اِسمی (عبرت سی) نشانی چھی، اَسے بھی ہُم ہأمی اکثر خلک ایمان نہ اَندی
آں بیشکہ چھی پروردگار زوروڑ تُھو (آں) مہربان ہُم۔
آں ہأئے ابراہیمؑ سی قصہ بیان کو
کے یأ تی تنو بوپ کے آں تنو قوم گے بنو "تھو کا شیئی سی عبادت کودی؟"
(تھیئے) بنو: "مھو بھودا سی عبادت کودی آں اَںئی تھین موشکے بھژیل ہودی"۔
(ابراہیمؑ) بنو: "کئی ہے تُھن بات بھوژدی کے یأ تھو ہاگادی دا؟"
"یا تھوئے کی فائدہ یا نقصان اَوابھادی؟"
(تھیئے) بنو: "(نأ)، اَسے مھوئے تنو باپ داد مھاموڑ کوؤآ ڈیڈیشی"
(ابراہیمؑ) بنو: "کئی تھوئے یئت ڈیڈتو تھو کسی عبادت کودی،
تھو آں تُھن اُوران پوران باپ داد؟"
بیشک ہے بُٹ مھی دشمن تھی، سوائے دُوںئی جہان آسی پروردگار ما
کی یأ مھأ پیدا کیدو آں اَںئی سے مھیئے پان پشادو
آں کآم یأ مھیزید کھیادو آں پیادو
آں کے یأ آ ناژور ہُوو سے مھیئے روغاچا دیدو
آں سے کی یأ مھیئے مئیک دینین، بھی مھیئے جیدون دینین
آں سے یأ کِس ما آ طم کودو کہ حساب کتاب سی دی مھی خطیئی مھیئے معاف کونین
(بھی ابراہیمؑ دعا کی) اے مھی پروردگار! مھیئے پوھہ دے آں مھأ نیک خلگا می شامل کو!
آں مھی کأ (راتلونکے نسل آمی) تھأ جیب پیدا کو یأ سے مھی سأسبن ہوؤ سی شیدی دَن
آں مھأ تھأ خلگا می شامل کو یأ تھیئے نعمدے (آ ما پونیل) جنت آسی میراثی ہونین
آں مھی باپ بوگوش، بیشکہ سے پان ہڙژیل آمی تُھو
آں تے دی مھی مُو کݜینی نہ کو، کے یأ دُووآر جینی کوا بژنین
کامے دی نأ مال کی فایدہ دینین نأئی اولاد
سیوائے (تے ماݜ ما) کی یأ صفا حی گھیندے اللہ سی موشکے حاضر ہُوو
آں (تے دی) جنت نیک خلگائے نھیئی کوا بژنین
آں دیزوخ کولاؤ گمراہ آئے مُٹھائے کوا بژنین
آں تھأئے بنا بژنین: "کھید تھی سے کسی یأ تھو عبادت کوؤدود،
اللہ چھیدے، کئی تھیئے تُھن کی مدد کونین یا تنو اَمن بچ کونین؟"
دَ موتھالأ تھلا بژنین دیزوخ کے، تھأ آں (دأل) گمراہ
آں ابلیس سی بُٹ لخکر
تھید ہیئے بُوڑے ایکدی سید لات کوئین (تنو معبودائے) بننین
کہ: "اللہ سی قسم مھو دا اخکارہ گمراہی می اَشئ"
"کے یأ مھو تھو بُٹ جہان آسی سی رب سید ایشان سی گھنودود"
آں مھو دُوئی یی نأ، اَںئی ہے مجرمے گمراہ کی
دَ مھیرے مُھن کأ یام سفارشی نوتھو
آں نأئی یام ڈمجھوک سأت
کاش! کو مھوئے اے پیرا بھی دُونیئی یے بژو ہُوشوو، مھوئے ایمان اَننیندے!
بیشکہ اِسمی (خلگا سی کأ) عبرت چھی، اَسے ہأمی اکثر خلک ایمان نہ اَندی۔
آں بیشکہ چھی پروردگار زوروڑ تُھو (آں) مہربان ہُم۔
نوحؑ سی قوم ہُم پیغمبر لووال گھنئی
کے یأ تھأئے تھین بھئی نوحؑ بنو: "کئی تھو (اللہ ما) بھیدی نأ؟"
بیشکہ آ تُھن کأ اے امانتدا رسول تُھو
دَ تھو اللہ ما بھیا آں مھی بات منا
آں آ تھو ما اِسی کأ کی اَجر سی سوال نہ کودو، مھی اَجر تہ بُٹ جہان آسی پروردگار سی ذمہ تُھو،
دَ اللہ ما بھیا آں تھو مھی بات منا
(تھیئے) بنو: "کئی مھو تھیزید ایمان أنی؟ حالانکہ پاتے شینے خلک چھی پأش پأش ریوان تھی؟"
(نوحؑ) بنو: "مھیئے کا پتہ چھی ہے کا کام کودی"
ہین حساب تہ مھی پروردگار سی ذمہ تُھو، کاش کو تھوئے عقل ما کام گھینوشوو!
آ مومن (اَمن ما) ݜگؤ والا نہ تُھو
آ دا صفا صفا خبردار کوؤ والا تُھو
(تھیئے) بنو: "اے نوحؑ! کو تو قلار نہ ہوو تأ چأرمأری کوا بژنین
(نوحؑ) بنو: "اے مھی پروردگار! مھی قوم مھأ لووال گھنو،
دَ مھأ و مھی ہین میِئے اے کولاؤ فیصلہ کو، آں مھأ و مھی مومن سأت بچ کو"
دَ مھوئے تیس آں تِسی سأت اے ڈک کشتی می بچ کی
بھی دھریل خلک مھوئے غرک کی
بیشکہ اِسمی (خلگا سی کأ) عبرت چھی، اَسے ہأمی اکثر خلک ایمان نہ اَندی۔
آں بیشکہ چھی پروردگار زوروڑ تُھو (آں) مہربان ہُم۔
عاد (سی قوم ہُم) پیغمبر لووال گھنئیشی
کے یأ تھأئے تھین بھئی ھودؑ بنوشو: "کئی تھو (اللہ) ما بھیدی نأ؟"
بیشکہ آ تُھن کأ امانتدا رسول تُھو۔
دَ تھو اللہ ما بھیا آں مھی اطاعت کوا
آں آ تھو ما اِسی کأ کی اَجر سی سوال نہ کودو، مھی اَجر تہ بُٹ جہان آسی پروردگار سی ذمہ تُھو،
کئی تھو ہر اُوچات پوت زید ہأئیمو اے یادگار سَوادی؟
آں گھن گھن محل سَوادی، یابنے تھوئے ہمیشہ سی کأ مھید دھرو تُھو
آں کے یأ (کیںزید) ہات تھلدی دا ظألم آسی شانے تھلدی
دَ اللہ ما بھیا آں مھی حکم مَنا
آں تے ذات ما بھیا کی یأ تھوئے تھأ بُٹ شیئی دیدتی، کسی یأ تھوئے پتہ ہُم چھی
تُھن مدد کی تھوئے څاروئی دیدے آں اولاد دیدے
آں باغ دید آں اوسو دید
بیشکہ آ تھوزید اے گھن عذاب سی دی ما بھیدو
(تھیئے) بنو: "تو مھوئے نصیحت کودو یا نہ کودو، مُھن کأ بات ایک چھی"
ہے بأت تہ مُٹھک خلگے ما مھاموڑ اَئیدی
آں مھوزید کی عذاب ییؤ سی نہ تُھو
دَ تھیئے تیس لووال گھنو دا مھوئے تھأ ہلاک کی، بیشکہ اِسمی (خلگا سی کأ) عبرت چھی، اَسے ہأمی اکثر خلک ایمان نہ اَندی۔
آں بیشکہ چھی پروردگار زوروڑ تُھو (آں) مہربان ہُم۔
ثمود (سی قوم ہُم) پیغمبر لووال گھنئیشی
کے یأ تھأئے تھین بھئی صالح بنو: "کئی تھو (اللہ) ما نہ بھیدی؟
بیشکہ آ تُھن کأ اے امانتدا رسول تُھو،
دَ تھو اللہ ما بھیا آں مھی حکم منا،
آں آ تھو ما اِسی کأ کی اَجر سی سوال نہ کودو، مھی اَجر تہ بُٹ جہان آسی پروردگار سی ذمہ تُھو،
کئی تھوئے مھید سی مھأ بُٹ شیئی آ سی مِیئے (مُوآ) آرام دے چھوا بژنین؟
باغ آمی آں اوسو آمی؟
(مھأ) بُھوم آمی آں کجور آسی تھام آمی، کسی کِل یأ ایکدی می ݜژیل تھی؟
آں کھن کھیریݜتے چیر ناز تے ایمی شیر سَوانین؟
دَ اللہ ما بھیا آں مھی حکم مَنا،
آں حد ما نُوخیل خلگا سی حکم نہ منا،
سے خلک یأ دھیرین می فساد خور کودی آں (خلگا سی مِیئے) سَوؤ سی کام نہ کودی"۔
تھیئے بنو: "تھیزید تہ کآں گھن جادو ہودو"
"تو دا دُوئی کی نہ تُھو خو مُھن شانے اے انسان تُھو، دَ کو سأسبن تُھوو کآں نخ آن"
(صالحؑ) بنو: "أ اے اُخأن چھی، اے دی اِسی اُو پو سی وار چھی، آں اے دی تُھن اُو پو سی مقرر تُھو"۔
آں ایسکے لاڙاچا دے ہات نہ دا، نأو اے سخ دی سی عذاب تھو گݜنین،
دَ تھیئے (اُخأن سی جنگا سی) شُب چھینئ آں بھی پشیمان ہوئی،
دَ تھأ عذاب گأد، بیشکہ اِسمی (خلگا سی کأ) عبرت چھی، اَسے ہأمی اکثر خلک ایمان نہ اَندی۔
آں بیشکہ چھی پروردگار زوروڑ تُھو (آں) مہربان ہُم۔
لوط (سی قوم ہُم) پیغمبر لووال گھنیشی،
کے یأ تھأئے تھین بھئی لوطؑ بنو: "کئی تھو (اللہ ما) نہ بھیدی؟"
آ تُھن کأ اے امانتدا رسول تُھو،
دَ اللہ ما بھیا آں مھی حکم منا
آں آ تھو ما اِسی کأ کی اَجر سی سوال نہ کودو، مھی اَجر تہ بُٹ جہان آسی پروردگار سی ذمہ تُھو،
کئی تھو بُٹ دُونیئی (چھیدے صرف) جدگا سی کأشکے بژدی؟
آں تھو تیس چھودی کا یأ تُھن پروردگار تُھن کأ تُھن ڇھی (آ سی شکل) می پیدا کیدو، بلکہ تھو حد ما نُوخیل خلک تھی۔
(تھیئے) بنو: "اے لوطؑ! کو تو قلار نہ ہوو تأ ہُم شڑونکے خلگا می شامل ہونین"
(نوحؑ) بنو: "بیشکہ آ تُھن عملے ما بیزار خلگا می شامل تُھو"
(بھی لوطؑ دعا کی) "اے مھی پروردگار! مھأ و مھی کلاݜ تیما سات، کا عمل یأ ہے کودی دا"
دَ مھوئے تیس آں تِسی کلاݜ بُٹ بچ کی
سیوائے اے ڈھیک ما، کہ سے پأشکے دھرو والا آ می أشی
بھی دأل مھوئے ہلاک کی
آں مھوئے تھأزید آگھا مُوژاد، سے لاݜ اگھا (موش ما) اُوڙیل خلگا زید مُوژا گا۔
بیشکہ اِسمی (خلگا سی کأ) عبرت چھی، اَسے ہأمی اکثر خلک ایمان نہ اَندی۔
آں بیشکہ چھی پروردگار زوروڑ تُھو (آں) مہربان ہُم۔
ائیکہ سی خلگے ہُم پیغمبر لووال گھنئشی
کے یأ تھأئے شعیبؑ بنو: "کئی تھو (اللہ ما) نہ بھیدی؟"
بیشکہ آ تُھن کأ اے امانتدا رسول تُھو
دَ اللہ ما بھیا آں مھی حکم منا
آں آ تھو ما اِسی کأ کی اَجر سی سوال نہ کودو، مھی اَجر تہ بُٹ جہان آسی پروردگار سی ذمہ تُھو،
(تنو) تول پورا کوا، آں تھأ ما نہ ہوا یأ (خلگائے) تاوان دیدی
آں سیدا ڇیگے دے وزن لیکھا
آں خلگائے تھین شیئی أشیڑی نہ کوا، آں نأئی دھیرین زید فساد خور کیدے گئا
آں تیما بھیا کی یأ تھو آں اُوران پورأن نسل پیدا کیدی
تھیئے بنو: "تھیزید تہ کیںئے کوڑے کیدی"
"تو دا دُوئی کی نہ تُھو خو مُھن شانے اے انسان تُھو، آں مُھن گُمان دے تو پاک لووال تُھو"
"دَ مُھن ڙید آسمان ما اے ٹوٹا لار تھل، کو تو سأزأل تُھوو"
(شعیبؑ) بنو: "کا یأ تھو کودی دا تیما مھی پروردگار غورا شید تُھو"
دَ تھیئے تیس لووال گھنو آں چتری والا عذاب سی دِیئے تھأ گأد، بیشکہ سے چیر گھن عذاب سی دی اَشو۔
بیشکہ اِسمی (خلگا سی کأ) عبرت چھی، اَسے ہأمی اکثر خلک ایمان نہ اَندی۔
آں بیشکہ چھی پروردگار زوروڑ تُھو (آں) مہربان ہُم۔
آں بیشکہ أ (قرآن) بُٹ جہان آسی پروردگار سی دِشا نازل کویل تُھو،
امانتدا مُلیک ایس گھیندے وأدتو
(نازل کیدو) چھی حی زید، مِسی کأ تو خبردار کوؤ والا ما ہو
صفا صفا عربی جیب می۔
آں بیشکہ أ (قرآن) مُوشک کتاب آمی ہُم موجود تُھو
کئی أ تھین (مکہ سی خلگا سی) کأ اے نخ نہ اَشو، کہ اِسما بنی اسرائیل سی علماء شید تھی؟
آں کو مھوئے ایس اے غیر عرب زید نازل کیشوو
آں تی ہأئے بُھوژادوشوو، ہیئے ایزید ایمان نہ اَننین دے
اَںئی ہاموڑ مھوئے ایس گناگاہ آسی حی آئے لھنگادوشو
تھیئے ایزید ایمان نہ اَننین، کھیدیخانگے یأ سخ عذاب (تنو أݜیئے) نی ڈیڈو
دَ تی ہأزید (مھاموڑ) نأڅأبی یینین کہ ہیئے شید ہُم نہ ہونین
تھلا ہیئے بننین: "مھوئے لخہ کی مہلت میلاؤ ہوبھانین؟"
دَ کئی ہے مُھن عذاب سی کأ تأدی کودی؟
تأ ڈیڈ؟ کو مھو ہأئے چیر چیر کال (ہُم عیش کوؤ سی کأ) مہلت دَئی
بھی ہُم ہأزید تی شیئیے یینین کسی یأ ہأزید وعدہ کوا گیژی
کا کم یینین ہین، کا شیئی یأ ہأئے عیش سی کأ دیا گئیدی دا؟
آں یئد اے خار مھوئے تباہ نی کی تِسی کأ (موش ما) خبردار کوؤ والا ما بغیر
(مِسی کأ کہ) سے یادگیرنہ کوے، آں مھو ظألم دا نی تھی
آں مے (قرآن) شیطان گھیندے نہ وأدتی
نأ تھین مجال تُھو، آں نأئی سے اِسی طاقت لردی
ہے دا اِسی بھوژو ما ہُم دُھو ساتا گئیدی
دَ (اے پیغمبرؐ!) اللہ سید دأل معبودائے نہ ہاگا، مھامو نأ تھیئے عذاب دیا بژے
آں (اے پیغمبرؐ!) تنو نھیو سَکا (لاݜ انجام ما) بھیا
آں (اے پیغمبرؐ!) مومن آمی کآم یأ چھی تابعداری کودی دا تو تھأسید چیر نرمی کو۔
آں کو سے چھی نافرمانی کوؤسأدو دَ میس بَن: "بیشکہ تھو کا کودی دا تیسیت مھی کی تعلق نو تُھو"۔
آں تے (اللہ) زید توکل کو یأ اقتدار سی کھمان، مہربان تُھو،
سے (اللہ) یأ تھأ پشدو کے یأ تو (عبادت سی کأ) اُوشدو،
آں نمازی آسی مِیئے چھی گئو (ہُم پشدو)
بیشکہ سے ہر بات بُھوژو والا جنو والا تُھو
آ تھوئے بینی شیطان کیزید نازل ہودی؟
سے ہر لووال گناہ گاہ زید نازل ہودی
سے اوپرا بأت بُھوژدی آں ہأمی زیاد لووال ہودی۔
آں شاعر آسی پأشکے دا گمراہ خلک روان ہودی۔
تأ نی ڈیڈ سے ہر کُو (وادی) می ہأئیمو سرگردان گئیدی؟
آں سے مھال بأت بندی یأ تھأزید أمیدے عمل نہ کودی؟
سیوائے تھأ خلگے ما یأ تھیئے ایمان اَنو، آں نیک عمل کی، آں اللہ چیر چیر یاد کی، آں تنو اَمن زید ظلم سی بدل گھین، آں ظألم آئے چیر جلد پتہ گھڑنین کامے انجام سی دِشکے سے نُڑدی۔
طس، أ آیات تھی (مے) قرآن آں اخکارہ کتاب سی،
(ہے تھأ) مومن آ سی کأ ہدایت آں زیرے چھی،
کآم یأ نماز سی پابندی کودی، آں ذکواۃ دیدی، آں آخرت زید پوخ یقین ساتدی۔
یقیناً کآم خلک یأ آخرت زید ایمان نہ آندی مھوئے تھأئے تھین (لاݜ) عمل شیژیئی کیدی، دَ ہے أݜی پویل ترَپدی۔
اَںئی ہے خلک تھی کھین کأ بدترین عذاب تُھو، آں آخرت می اَںئی ہیئے خلگے نقصان می ہونین۔
آں (اے پیغمبرؐ!) تھیئے قرآن مجید حکیم آں علیم ذات سی دِشا دیا بژدُو۔
کے یأ موسٰیؑ تنُو شیر والائے بنُو: "مأ اے آنگا ڈیڈتُو، آں چیر جلد تُھوئے تھیدا (پَن سی) کآں خبر اَننین، یا کآں جَلیل کھور گھیندے یَیئی، بَنے تھو تیما اَمن تیدی کوا"۔
بھی کے یأ موسٰیؑ تھیدکے آوؤ، دَ تیسکے آواز ہُو، کہ: کآم (مُلیکا) یأ آنگا سی اَندرے تھی سے ہُم برکتی تھی، آں کآم یأ اِسی چاپیرا تھی سے ہُم برکتی تھی، پاکی چھی تے اللہ سی کأ یأ سے بُٹ جہان آ سی پروردگار تُھو۔
اے موسٰیؑ! اَںئی آ اصل معبود تُھو، غالب آں حکمت والا۔
"آں تُو تنُو ہمسا وائے تَھل"، بھی کے یأ موسٰیؑ ڈیڈ کہ سے مھامُوڑ پھرَگئی (پھرگژی) یابنے جان چھی، دَ پدکیزأ روان ہُو، آں پأشکے ہُم نُو بُو، (مھوئے آواز کی کہ) "اے موسٰیؑ! نی بھی، مھی کأن پیغمبر نے بھیدی"۔
ہاں کو کی زیأتیئی کیژی، بھی گناہ سی پوت نیک کم کوئے، دَ آ بوگوشُو والا مہربان ذات تُھو۔
آں تنُو ہات تنُو گریوان وا وال، تی بغیر کی عیب ما اُوژیل ڇھیوَن نُوخنین، ہے تھأ نوم معجزہ آ ما تُھو، کامیک یأ فرعون آں تِسی قوم سی کأ تھی، یقیناً سے ہات ما نوخیل قوم تُھو۔
بھی کے یأ تھأئے مُھن کولاؤ نَخ اَوئیدا سے کئیدا أ دا اَخکارہ جادُو تُھو۔
آں تھیئے ظلم آں کِبر سی وجہ دے اِسما انکار کی، حالانکہ ہین حیئے یقین کِشُو، بھی تُو بُو ہأ فسادی آ سی کا انجام ہُو!
آں مھوئے داؤدؑ آں سلیمانؑ گے (چیر گن) علم دیدوشُو، آں تھیئے (دُوںئے ایزید) بنُو کہ تے اللہ سی شکر تُھو کی یأ مھوئے تنُو چیر مومن بندہ آ زید گھینیئی دیدچی۔
آں سلیمانؑ داؤدؑ سی میرأثی ہُو، آں تی بنُو: اے خلگا ہانا! مھوئے پیݜین آ سی جیب ڇھیڙا گئیدی (گیژی؟)، آں مھوئے ہو قسم سی شیئی دیا گئیدی، أ بے شک اے اخکارہ فضل تُھو۔
آں سلیمانؑ سی کأ پَیرا سی، بنیأدم آ سی، آں پیݜین آ سی لخکر جمع کوا گئی، آں ہے (انتظام سی کأ) پود پہ پودے ایڑی کوا گئی۔
تے وخہ پورے، کے یأ سے پیول آ سی وادی یے اَوَئی، دَ اے پیول بنُو: "اے پیول ہانا! تُن تُنو ڈونگے وا لھنگا، سلیمانؑ آں تِسی لخکر تھو کُھو آ سی ٹین نہ چَمگن، آں تھأئے تُھن پتہ ہُم نہ گھڑے!"۔
اِسی اے بأت زید سلیمانؑ مُسکئی ہیدے ہأس کی، آں بنُو اے مھی پروردگار! مھئیے توفیق دے کہ آ چھی مے احسان سی شکر نِگھیلی کامیک یأ تأ مھیزید آں مھی ییئی و بوپ زید کیدُو، آں (توفیق دے کہ) آ نیک عمل کیئی، کہ کامیک تھیئے خوش تھی، آں تنُو رحمت تے مھأ تنُو نیک بندہ آ می شامل کو۔
آں سلیمانؑ پیݜین آ سی حاضری گھین، دَ بھی بنُو: "أ کا وجہ چھی آ ہُدہُد نہ پَشدُو؟ کئی ہے کیںئت ہاڙادتُو؟
(کو ہے بات چھیو) مأ تیسکے سخت عذاب دینین، یا تیس حلال کونین، یائی تی (تنُو غیر حاضری سی) معقول دلیل دینین۔
اَسے تی ہیدیک ݲیگ وخ نہ لھنگاد، دَ تی (ییدے) بنُو: "مھیئے سے بات معلوم چھی کامیک یأ تھیئے معلوم نی چھی، آں مأ تھیئے سَبا (سی وطن) ما اے یقینی بات أنیئی"۔
مأ اے جوَئی ڈیڈ کہ سے تھأزید بأچیئی کوئی، آں تیسکے ہر قسم سی شیئی دیا گئیدی، آں تِسی (بھیُو سی) تخ چیر گھن تُھو۔
مأ تیس آں تِسی قوم اللہ چھیدے سی سی عبادت کوؤ آ ڈیڈ، آں شیطان تھأئے تھین عمل تھین نظرا می شیژیئی کیدی، آں تھأ سیدا پَن ما منع کیدی، آں سے صحیح پَن دے نہ بژدی۔
آں سے تے اللہ یے سجدہ نہ کودی کآم یأ آسمان و دھیرین سی بُوریل شیئی اخکارہ کودُو، آں کا یأ تھو بُرادی آں کا یأ اَخکارہ کودی تیما شِد تُھو۔
(بُھویا!) اللہ سے ذات تُھو تیما علاوہ دُوئی یام معبود نو تُھو، سے گھن عرش سی رب تُھو۔
(سلیمانؑ) بنُو: مھوئے بُونین کہ آیا تو سأز بندُو کو لووال تُھو۔
تُو مھی مے خط گھیندے بَش آں تھین دِشکے تَھل، آں بھی تھیئے ما ڈھأر کو ہو، آں بُو دا سے کا جواب دیدی۔
(کے یأ سَبا سی راجگنہ یے خط اَوؤ) تی بنُو: "اے مھی سردار ہانا! مھیئے أ چیر احترام والا خط تھلا گودُو"۔
ہے سلیمانؑ سی دِشا تُھو آں ہے اللہ یأ سے رحمٰن و رحیم تُھو تِسی نام ما شروع تُھو۔
(لیگودُو) کہ تھو مھی مقابلہ می نافرمانی نہ کوا، آں تابع ہیدے مھی دیشکے حاضر ہوا۔
تی (راجگنہ) بنُو: اے مھی سردارا ہانا! مھیئے مے مسئلہ می مشورہ دا، آ یئت ہُم کی بأت سی فیصلہ نہ کوژی، کھیدیخانگے تھو مھیسیت موجود نہ ہوئیو۔
تھیئے بنُو: "مھو طاقت لَردی آن چیر لاتکُوٹ تھی، مُٹھائے معاملہ چھی ہات می چھی، بُو دا تو کا حُکم دیژی"۔
تی (راجگنہ) بنُو: کے ہُم یأ باچا اے خار کے لھنگئیو سے تے خار تباہ کودی، آں تھید سی عزت دا خلک ذلیل کودی، آں ہیئے خلگے ہُم ہامُوڑ کونین۔
آں آ ہین دِشکے دھأک تحفہ پیئی، بھی بُوئی کہ مھی سفیر کا جواب اَندی۔
بھی کے یأ سے سفیر سلیمانؑ سی کأنگے آپ، سلیمانؑ بنُو: "کئی تھو مال و دولت تے مھی مدد کوؤ نیمادی؟ یاد ساتا! کا یأ اللہ مھیئے دیدتُو سے تیما چیرگن غورہ تُھو کا یأ تی تھوئے دیدتُو، بلکہ اَںئی تھو تنُو تحفہ دے خوشحال ہوا"۔
تُو تنُو خلگا پیش واپس بَش، مھوئے تنُو مھال لخکریدے تھأزید حملہ کونین کہ تِسی مقابلہ سی تھأمی طاقت نہ ہونین، آں مھوئے تھأ تھیدا ذلیل کیدے نِگھالنین آں تھیئے رسوا ہونین۔
(سلیمانؑ) بنُو: "اے سردارا ہانا! کی تھوما مھی کأن گے سَبا سی تخ (بھا کیدے) اَنین، مُوش مِسما کہ سے مھی کأن گے فرمان بردار ہیدے یَن؟"
پَیرے ما اے دیؤ پَیر بنُو: "چھی تنُو پوت زیدا اُشو ما مُوش مأ تیس چھی خدمت می حاضر کونین، آ اے کم سی طاقت لَردُو، آں آ امانت دار ہُم تُھو"۔
کامے ماݜ کِس کیش کتاب سی علم اَشُو تی بنُو: "مأ مے تَخ چھی أݜی سی رَپ کے حاضر کونین"، بھی سلیمانؑ تیس تنُو کأن ڈیڈ تا (تی) بنُو: "أ مھی رب سی فضل سی نتیجہ تُھو کہ سے مھأ اَزوموئے کہ آ شکر کودُو کو ناشکری، آں کآم یأ شکر کودُو سے تنُو کأ کودُو، آں کآم یأ ناشکری کودُوو مھی پروردگار تیما بے پرواہ آں عزت والا تُھو"۔
(سلیمانؑ) بنُو: تیسی تَخ سی شکل تِسی کأ بدل کوا، بُوئیدا سے ایس پأنَئی (پأنژی) کو سے تھأ خلگا ما چھی کآم یأ حقیقت کے نہ اَوودی۔
بھی کے یأ سے (راجگنہ) أپ تا تیسکے بناگا کہ اَیا چھی سے تخ مِیسی شانے تُھو؟ تی بنُو: "أ دا اَںئی سے تُھو"، آں ایما مُوش مھوئے (چھی صداقت سی) علم ہُوشُو، آں مھو فرمان بردار ہوئیدی"۔
آں تے جوَئی اللہ ما علاوہ دأل خُدئی آ سی عباددے (ایمان آنُو ما) منع کیشی، آں سے اے کأفر قوم سی جوَئی أشی۔
تیسکے بناگا کہ مے محل گے لنگ، آں کے یأ تی (دھیرین) څأریدہ تیس ڈوپ اُو گھنُو، (تنُو پول بھا کی) آں تنُو پِن اخکارہ کی، سلیمانؑ بنُو: أ دا اے محل تُھو کامیک یأ شیشہ ما سَویل تُھو، تی بنُو: "اے مھی خدایا! مأ مھیدیخانہ پورے تنُو اَمن زید ظلم کیشو، آں آ آش ما سلیمانؑ سَمانے اللہ سی فرمان بردار ہوژی، کآم یأ جہانا سی پروردگار تُھو"۔
آں یقیناً مھوئے ثمود سی دیشکے تھین بھا صالح پیؤ، (سے بَندُو اے خلگا ہانا!) تھو اللہ سی عبادت کوا، دَ سے دُو ڈلہ ہیدے ایکدوئی سیت پݜژوسأت۔
(صالحؑ) بنُو: اے مھی قومأ! تھو نیگی (یعنی توبہ و ایمان) ما مُوش بدی سی کأ کئی تأدی کودی؟ تھو اللہ ما توبہ کئی نی نِگھلدی یأ تھوزید رحم کوا بژے؟
تھیئے بنُو: مھوئے تو و چھی سأت اِسپور معلوم ہودی، (صالحؑ) بنُو تُھن اِسپوراچا اللہ سی دِشا تُھو، بلکہ تھو سے قوم تُھو یأ سے اَزمیخ می اَختہ تُھو۔
آں تے خار می نوم ماݜ اَشئی کآم یأ وطن می فساد خور کوؤدُود آں اصلاح نہ کوؤدُود۔
تھیئے (ایکدی می) بنُو: اللہ سی قسم کھا کہ ڙأدوڙأت صالحؑ آں تِسی شیر والا مانین، بھی تِسی وارث کے بینی کہ مھو دا تِسی شیر والا آ سی مئیک سی وخا موجود نہ اَشئی، آں یقیناً مھو سأس بندی۔
آں تھیئے بِریت اے تدبیر کی، آں مھوئے ہُم اے بِریت اے تدبیر کی، آں سے ہاڈو جنئی ہُم نأ۔
دَ بوا دا، تھأ خلگا سی مُکر سی کا انجام ہُو؟ مھوئے تھأ آں تھین بُٹ قوم تباہ کی۔
آں مھیرے أ تھین شیر تھی، کہ تھین ظلم سی وجہ دے شڑ بژیل تھی، بے اِسمی جنُو والا خلگا سی کأ عبرت سی نخ تھی۔
آں کآم یأ ایمان والا آں پرہیزگار اَشیئ تھأ مھوئے بچ کی۔
آں مھوئے لوطؑ پیؤ، کے یأ تی تنُو قوم گے بنُو کہ تھو بے حیائی سی کم کودی، باوجود مِسی کہ تھو پشدی (کہ أ بے حیائی سی کام تُھو)۔
آیا تھو تنُو نفس سی خواہش سی کأ ماݜے ما تنُو حاجت پورا کودی؟ حقیقت أ چھی کہ تھو چیر جاہل قوم تُھو۔
تِسی قوم سی جواب صرف أ اَشو کہ لوطؑ سی شیر والا خار ما نِگھلا کہ ہے تنُو اَمن چیر پاک پاکیزہ اخکارہ کودی۔
بھی مھوئے تیس ہُم آں تِسی شیر والا ہُم بچ کی، صرف تِسی ڇھی ما علاوہ، کِسی بارہ می مھوئے مقرر کیشو کہ تی پأشکے دھرُو والا آ می ہونین۔
آں مھوئے تھأزید بھیت سی آگھا مُوژات، کامے خلک یأ عذاب ما بھأدیشی دا تھین کأ أ چیر لاݜ آگھا اَشُو۔
تُو بَن کہ ٹول حمدوثناء صرف اللہ سی کأ تُھو، آں سلام تُھو تِسی تھأ بنا زیت کآم یأ تی خوشأدتی، (تو بُو دا) اَیا اللہ غورہ تُھو کو سے (لووال خدا) کیس یأ سے (اللہ سی) شریک کودی؟
تھلا کی آسمان و دھیرین پیدا کی، آں کی آسمان ما تُھن کأ آگھا مُوژاد، بھی آگھا سی زریعہ دے شیژو شیژو باغ سیوأد، أ تُھن وَس سی کام نہ اَشُو کہ تھو ہین تھام نِگھلادے، اَیا اللہ سیت دُوئی یام عبادت سی لائق تُھو؟ (نأ) بلکہ ہے سے خلک تھی کہ سے (شرک کیدے) پَن ما ڈھأر کے ہوئیدی۔
تھلا کی دھیرین اِڑی ہوؤ سی پوت سَواد، آں ایمی اندرے نھید جاری کی، آں اِسی کأ کھن سَوأد، آں (میٹ و لون گن) دو سمندرا سی مِیئے ڈاپ دید، آیا اللہ سیت دوئی یام عبادت سی لائق تُھو؟ (نأ) بلکہ ہیئے ما اکثر نہ جَندی۔
تھلا کآم تُھو کہ سے پریشان حال (سی فریاد) بُھوژدُو، کے یأ سے تیسکے ہاگؤسأدو، آں تکلیف دھوگو کودُو، (آں کآم) دھیرین زید تھو (مُوٹھیک خلگا سی) نائب مقرر کودُو، اَیا سیت دُوئی یام عبادت سی لائق تُھو؟ (نأ) خو تھو چیر کم نصیحت قبول کودی۔
تھلا کآم تُھو کہ سے شوگین زید آں سمندر زید أنچیک می تھوئے پان پشادُو، آں کآم تُھو کہ سے تنُو رحمت (سی آگھا) ما موش بیلأئی زیرے سی کأ پیدُو، اَیا اللہ سیت دُوئی یام عبادت سی لائق تُھو؟ اللہ تھیئے ما چیر اُوچات تُھو کآم یأ سے شریک کودی۔
تھلا کآم تُھو کہ سے مخلوق اول پیرا پیدا کودُو، آں بھی سردوآر پیدا کونین، آں کآم تُھو کہ سے تھوئے آسمان و دھیرین ما رزق دیدُو، اَیا اللہ سیت دُوئی یام عبادت سی لائق تُھو؟ (اے نبیؑ! تو ہأئے) بَن: تھو کو میس بندیو تنُو دلیل آنا۔
(آں تھأئے) بَن کہ: آسمان آں دھیرین زید کا مخلوق ہُم چھیو، تھأمی غیب سی بأت اللہ ما علاوہ دوئی یسکے ہُم معلوم نی تھی، آں نأئی تھأئے پتہ چھی کہ کے تھیئے دوبارہ جینی کوا بژنین۔
بلکہ آخرت سی بارہ می دا ہین علم ہاڈو تُھوئی نأ، بلکہ ہے خلک تا آخرت سی بارہ می ایمیدے شک می تھی، بلکہ ہیئے اِسی دِشا اَمن أنڈی کیدُو۔
آں ہے کأفر بندی کہ اَیا کے یأ مھو و مُھن گھن (باپ داد) سُم ہُوئیو دَ کئی مھوئے دوبارہ جینی کوا بژنین؟
أ وعدہ مھوسیت آں مھوئے ما مُوش مُھن بوپ داد سیت ہُم کوا گیشی، ہے ہأئیمو مُٹھیک خلگا سی (سَویل) قصہ تھی۔
ہأئے بَن کہ دھیرین می گئیا آں بوا کہ مجرم آ سی کا انجام ہُوشو۔
آں تھو ہین معاملہ می خپا نہ ہوا، آں نأئی ہین سازشیدے تنُو حی تینگی کوا۔
آں ہے بندی کہ می وعدہ کے پورا ہونین، کو تھو سأزبن تھیو؟
(اے پیغمبرؑ!) تو ہأئے بَن کہ کامے عذاب سی کأ تھو تأدی کودی دا ہوبھادُو تِسی کآں حصہ تھوئے اَوودُو ہُم۔
آں بے شک چھی رب خلگا زیت چیر مہربان تُھو، اَسے ہیئے ما اکثر شکر نی نِگھلدی۔
آں یقیناً چھی رب کے ہرکی معلوم تُھو، کا یأ ہے حی آ می بُرادی آں کا کم یأ اخکارہ کودی۔
آں آسمان آں دھیرین می مھال کی شیئی نُو تُھو کہ سے اخکارہ کتاب (لوح محفوظ) می لیگیل نُو تُھو۔
یقیناً أ قرآن بنی اسرائیل آ ئے اکثر تھأ بأت بیان کودُو کھأمی سے (مھیدیخانہ پورے) ایکدی سیت اختلاف کودی۔
آں یقیناً أ قرآن ایمان والا سی کأ ہدایت سی زریعہ آں رحمت تُھو۔
یقیناً چھی پروردگار ہین مِیئے تنُو حکم دے فیصلہ کونین، آں سے ٹول قدرت آ سی کھمان آں ہر شیئی ما جَنیل تُھو۔
بس تُو اللہ زیت بھروسہ کو، بے شکہ تُو اخکارہ حق زید تُھو۔
بے شک مڑئی آئے تُو بأت نُو بُھوژابھادُو، آں نأئی بو آئے تنُو آواز بُھوژابھادُو، (خاص کر) کے یأ سے پیٹ کیدے ریوان ہُوئیو۔
آں تُو اَن آئے یأ سے گُمراہی می اختہ تھی پان نہ پَشابھادُو، تُو دا صرف تھأ خلگائے بُھوژابھادُو کآم یأ مُھن نَخا زید ایمان اَندی، آں سے فرمان بردار تھی۔
آں کے یأ (اللہ سی) وعدہ ہین حق می پورا ہیو، مھوئے دھیرین ما ہین کأ اے څاروَئی نِگھالنین، کی یأ ہأسیت بأت کونین، کہ ہے خلک مُھن آیادا زید یقین نہ کوؤدُود۔
آں کامے دی مھوئے ہر اے امت ما تھأ خلگا سی اے ٹولہ ایپوت کونین کآم یأ مُھن آیت نہ منودُود، آں تھأ ٹولا آ می تقسیم کونین۔
مے حدا پورے کہ کے یأ سے اَووئیو، اللہ تھأ ما توَس کونین، کہ آیا تھو می ایک نہ منودُود؟ حال أ چھی کہ تھوئے اَمن غورہ جَنادوشُو ہُم نأ، یأ (ایما علاوہ) دأل کا (خراب) کم کوؤدُود۔
آں ہین ظلم سی وجہ دے تھین حق می عذاب سی وعدہ پورا ہونین، آں تھیئے بات ہُم نہ کوبھانین
آیا ہیئے نی ڈیڈ کہ مھوئے ڙات سیوأد بنے ہے تیمی آرام کوئن، آں دی لوشیل پیدا کی؟ بیشک ایمی تھأ خلگا سی نخ تھی کآم یأ ایمان آندی۔
آں کامے دی یأ بیشل بھاگأو، کآم یأ آسمانا می تھی آں کآم یأ دھیرینے تھی، تھیئے ٹولے بھینین، بے تھأئے کیس یأ اللہ نیمادو، آں ہر ایک تِسی مُوشکے ݜا واکیدے حاضر ہونین۔
آں تُو مھأ کھن پیشتے مے پِھگر کودُو کہ ہے (اے پوت زید) جُخ اِڑی ہویل تھی، حال أ چھی کہ کھنے لڑے آ سی شانے روان ہونین، ہے اللہ سی کاریگری چھی کہ ہر شیئی چیر مضبوط سَوادتُو، سے تُھن کما ما غورہ شید تُھو۔
آں کآم یأ نیگی گھیندے اَبو تیسکے تیما ہُم غورہ (بدل) میلاؤ ہونین، آں ہیئے خلگے تے دی سی بھیت ما اَمن می ہونین۔
آں کآم یأ بدی گھیندے اَبو، دَ مھال خلک موتھأل دیزوخ وا تھلنین، (آں تھأئے بنا بژنین) کہ کئی تھوئے صرف تھأ عملا سی سزا دیا نہ بژئی کامیک یأ تھو دُونیئی می کوؤدوُود؟
(اے پیغمبرؐ! ہأئے بَن) مھیئے دا صرف أ حکم ہُودو کہ آ مے خار سی مالک سی عبادت کیئی، کی یأ مے خار کے عزت دیدچی، آں ہر شیئی تِسی تُھو، آں مھیئے أ حکم ہودُو کہ (تِسی) فرمان بردار ہیئی،
آں کہ (خلگائے) قرآن بین بیندے بُھوژئی۔ دَ کآم یأ سیدا پان گݜدُوو تنُو اَمن سی کأ گݜدُو، آں کآم یأ گمراہ دھرُوو تیسکے بَن کہ آ دا صرف (اللہ سی نافرمانی سی انجام ما) بھیؤ والا تُھو۔
آں میس بَن کہ ٹول صفت اللہ سی کأ تھی، آں تی چیر شیرتے تھوئے تنُو نَخ پشانین، آں (تے وخہ) تھوئے غورہ پأننین، آں کا کم یأ تھو کودی دا اللہ تھیئے ما غافل نُو تُھو۔
الف، لام، میم۔
خلگے مے گُمان دا نی کیدُو یرأ تھیئے اَںئی ہامُوڑ چھوا بژنین صرف تھین مھاموڑ بنے یرأ: مھوئے ایمان اَنودُو آں ہیئے اَزوما نہ بژنین؟ کئی خلک مے گُمان کودی ہیئے چھوا بژنین (صرف میس) بنُودے یرأ مھوئے ایمان اَنودُو آں ہیئے آزوما نہ بژنین؟
آں حالانکہ مھوئے تھأ (ٹول) اَزُومأدتی کآم یأ ہیئے ما مُوش لھنگئیدی، دَ اللہ تھأ خلک خامخا معلوم کیدے چھونین کآم یأ سأزأل تھی، آں تھأ ہُم معلوم کونین کآم یأ لوال تھی.
کامے خلگے یأ لاݜ کم کیدی، کئی تھیئے مے گمان کیدُو کہ تھیئے مھو کیژا مُوٹھیدی ہونین؟ چیر لأݜ فیصلہ چھی یأ سے کودی۔
کامے ماݜ اللہ سیت ملاقات سی طمع کودُوو سے مے یقین کوئے کہ اللہ سی مقرر کویل نیٹا خامخا یے نن، آں اَںئی سے ہر اے بأت سی بُھویو والا، ہر شیئی ماشِت تُھو۔
آں کآم یأ (اللہ سی پَن می) کوشش کودُوو سے تُنو فائیدا سی کأ کوشش کودُو، یقینًا اللہ تمام دونیئی (جہان سی خلگے) ما بے پروا تُھو۔
آں کامے خلگے یأ ایمان اَنودُو آں نیک عمل کیدی، مھوئے تھین خطیئی خامخا تھیئے ما ٹگانین، آں کامے عمل یأ سے کوا اَئی دی، تھین بہترین بَدل تھأئے خامخا دینین۔
آں مھوئے انسان گے تُنو ییئی و بوپ سیت غورا سلوک سی حکم دِت تُو، آں کو سے تھیئے زورَنا دیدی کہ تُو مھیسیت مھال اے خدا شریک کو یأ تھأکیش تِسی کی دلیل نُو تُھو دَ تھین بات نہ مَن، مھی دِش کے تھوئے ٹولائے واپس ییؤ تُھو، تَھلا مأ تھوئے بننین کہ تھو کا کَم کوا ییؤدُود۔
آں کامے خلگے یأ ایمان اَندُو آں نیک عمل کیدی، تھأ مھوئے خامخا نیک خلگا می شامل کونین۔
آں یام خلک مھال تھی کہ سے کیئدا: "مھوئے اللہ زید ایمان اَندُو"، بھی کے یأ تھأئے اللہ سی پَن می کی تکلیف اَوا گاو سے خلگا سی اَویل تکلیف کے اللہ سی عذاب سی چَھلے بودی، آں کے یأ چھی پروردگار سی ڈھأرا ہین کی امداد کوا گاو ہیئے خامخا بننین کہ: مھو دا تھوسیت اَشیئی، کئی اللہ ئے دُونیئی جہان سی خلگا سی حی آ می بُریل بأدا سی پتہ نی چھی؟۔
آں اللہ خامخا معلوم کونین تھأ خلک کیئے یأ ایمان اَنودُو، آں تی ضرور معلوم کونین کآم یأ منأفق تھی۔
آں کآم خلگے یأ کفر کیدُو سے ایمان والائے بَندی مُھن پَن دے تِلا، مھوئے تُھن خطیئی آ سی بار اُچات کونین، حالانکہ سے تنو خطیئی آ سی اے پِھٹ بار اُچات نہ کوبھادی، آں ہے خلک یقینًا بالکل لووال تھی۔
آں تھیئے تُنو گناہ آ سی بار ہم خامخا اُچات کونین آں تُنو بار سیت دُوئی بار ہُم (اُچات کونین)، آں ہأ خلگے ما قیامت سی دِئے کامے لَوو یأ ہے سَوؤدُود تہ تھین بارا می خامخا توَس کوا بژنین۔
آں مھوئے نوحؑ تِسی قوم سی کأش کے پیؤشُو، دَ ہے دَش و دُوبیش کم زَر کالے تھأسیت دَھرُو، بھی طوفان یے دے تھأ گأت، آں سے ظألِم اَشیئی۔
بھی مھوئے نوحؑ آں کِشتی سی خلک بچ کی، آں مھوئے تِسی دونیئی جہان سی خلگا سی کأ اے عزت سَوأت.
آں مھوئے ابراھم ؑ پیؤ کے یأ تی تُنو قوم گے بنوشو کہ: اللہ سی عبادت کوا، آ تِسما بھیا، اَںئی ہے بات تُھن کأ غورا چھی، کو تھوئے عقل ما کام گھینو۔
تھو دا اللہ چھیدے بُھود آ سی عبادت کودی، آں لوو آ سی بأت سَوادی، یقین کوا یرأ اللہ چھیدے تھو کسی کسی عبادت یأ کودی دا سے تھوئے رزق سی دیؤ سی وارا نہ لَردی، مِسی کأ رزق سی طلب اللہ ما کو، آں تِسی عبادت کو، آں تِسی شکر ادا کو، تِسی دِش کے تھوئے واپس کوا بژنین۔
آں کو تھو (مھأ) لَوو گھنَدی، دَ تھوکیژا مُوش چیر قومے لوو گھنُو سی کام کیدُو، آں رسول زیت علاوہ مے بأت ما دُوئی ذمہ واری نہ ہوئی کہ سے صفا صفا بات اَوے۔
کئی ہے خلک مے بأت کے نہ بودی کہ اللہ کھأکأ مخلوق اول ما پیدا کودو؟ بھی اَںئی تی دُوار تیس پیدا کونین، ہے کام دا اللہ سی کأ چیر آسان تُھو۔
بَن یرأ! دھیرین می پِش تے (گئیدے) بُو دا، اللہ کھأکأ مخلوق اول ما پیدا کی، بھی اللہ آخرت سی تے مخلوق ہُم بھا کونین، یقیناً اللہ ہر شیئی زیت قدرت لرُو والا تُھو.
تی کیس کے نِمادو سزا دینین، آں کیزیت نِمادو رحم کونین، آں تِسی دش کے تھو بُٹ نُڑا بژنین۔
آں نأ تھو دھیرین می اللہ عاجزا کوبھادی نأئی آسمان می، آں اللہ ما علاوا تُھن یام ڙݜُو والا نہ تُھو، نأئی امداد کوؤ والا۔
آں کامے خلگے اللہ سی آیادا سی آں تیسیت میلاؤ ہوؤ ما انکار کیدُو، سے مھی رحمت ما نااُمیدا ہوئیدی، آں تھین کأ تکلیف دیؤ والا عذاب (تیا) تُھو.
بس تِسی (ابراہیمؑ سی) قوم سی جواب دوئی کی نا اَشُو تھیئے بنُو: ایس ما! یأئی دھژا! بھی اللہ تیس (ابراہیمؑ) اَنگا ما بچ کی، یقینًا اِسمی (تھأ) خلگا سی کیا گھین عبرت چھی کآم یأ ایمان انَدی۔
آں تی (ابراہیمؑ) بنُو کہ: تھوئے اللہ چھیدے بُھودائے خدا بنودُو، یأ تِھن زریعہ دے دُونیئی سی جیدُون می تُھن ایک دوئی سیت یأری قائم چھی، بھی قیامت سی دِئے تھوئے ایک دوئی ما انکاری ہونین، آں تھوئے ایک دوئی زیت لعنت بننین، آں تُھن دھرُو سی پوت دیزوخ ھہونین، آں تُھن کأ کی قسم سی مددگار نہ ہونین۔
بھی لوطؑ تیزیت ایمان اَنو، آں (ابراہیم ؑ) بنُو: آ تُنو پروردگار سی دِش کے ہجرت کیدے روان تُھو، آں اَںئی سے کامل قدرت و اقتدار والا تُھو۔
آں مھوئے تھأئے اسحقؑ و یعقوبؑ (سی شانے جدک) دِت، آں تِھن اَولأدی می نبوت و کتاب سی سلسلہ جاری ساتی، آں تِھن اَجر مھوئے تھأئے دُونیئی می (ہُم) دِت، آں یقیناً آخرت می تِھن لیک نیک خلگا می ہونین۔
آں لوطؑ (مھوئے پیؤ) یأ تی تنُو قوم گے بنُو: حقیقت أ چھی کہ تھو مھال بے حیائی سی کام کودی یأ تھوما موش دُونیئی جہان می یی نی کیدُو۔
کئی؟ تھو ماݜا سی کأشکے بژدی، آں پَنا می ڈاکہ تَھلدی، آں ڈک مجلس می لاݜ کم کودی؟ بھی تِسی قوم کیش مِس ما علاوہ دوئی کی جواب نہ اَشُو کہ تھیئے بنُو: کو تُو سأزبَن تُھوو مھوزیت اللہ سی عذاب گھیندے یے!
(لوطؑ) بنُو: اے مھی پروردگار! ہأ فسادی خلگا سی مقابلہ می مھی مدد کو.
آں کے یأ مُھن پئیل مُلیک ابراھیمؑ سی کأن گے (تِسی پو سی ہوؤ سی) زیرے گھن دے گئی دَ تھیئے بنو کہ: مھو مے گام سی خلک تباہ کوؤ والا تھی، حقیقت تہ أ چھی کہ مے گام سی خلک چیر زیاد ظألم تھی۔
ابراھیم بنو: مے گام می دا لوطؑ (ہُم) تُھو، مُلیکائے بنو: مھوئے غورا کیدے معلوم تُھو کہ اِیمی کآم تُھو، مھوئے تِسی و تِسی ٹوَر سی خلک خامخا بچ کونین سیوائے تِسی ڇھی ما، سے پأشکے دھُرو والا آ می چھی۔
آں کے یأ مُھن پَیل مُلیکا لوطؑ سی کأن گے اَوئی دا لوطؑ تِھن وجہ دے چَیر پریشان ہُو، آں تِھن وجہ دے تِسی حی تینگی ہوؤ سأت، تھیئے مُلیکائے بنُو "تُو نی بھی آں نأئی غم کو، مھوئے تھأ و چھی ٹوَر سی خلک بچ کونین سیوائے چھی ڇھی ما، سے پیاشکے دھرُو والا آ می چھی۔
مے گام سی خلک یأ کامے لاݜ کم کوا ییدی دا تِھن وجہ دے مھو ہأزیت آسمان ما عذاب نازل کوؤ والا تھی۔
آں مھوئے تے گام سی کآں واضحا نَخ تھأ خلگا سی کأ چھوئی کآم یأ عقل ما کام گھینَدی۔
آں مَدین سی دِشکے مھوئے تِھن بھا شعیبؑ پیؤ، تی بنو: مھی قوم سی خلگاہانا! اللہ سی عبادت کوا، آں آخرت سی دی سی طم ساتا، آں دھیرین می فساد کوئین نی پِشا.
بھی تھیئے تیس (شعیبؑ) لووال گھنُو، دَ تھأزیت سخ بھومیل أپ، آں سے تنو شیرے موتھلأ بژیل دھرئی۔
آں عاد و ثمود (ہُم مھوئے تباہ کی)، آں تِھن تباہی تھوزیت تِھن شِرے ما واضحا ہیژی (چھی)، آں شیطان تھین عمل تِھن نظر آ می شیژیئی کیدے تھأ سیدا پَن ما منع کیشی، حالانکہ سے ہُوشا آں پشوُ والا اَشیئی۔
آں قارون و فرعون و ہامان (ہُم مھوئے ہلاک کیدی)، موسیٰؑ تِھن کأن گے واضحا دلیل گھندے ابوشُو، اَسے تھیئے دھیرین می لوئی ما کام گِھن، آں سے (مھو کیژا) گھڑو والا نہ اَشیئی۔
مھوئے تھأمی ہر ایک تِسی گناہا سی وجہ دے عذاب می گادُوشو، بس تھأمی یاما زیت مھوئے باڑ موژؤ والا بیلأئی پیئی، یام اے گھین چیگائے گأت، آں یام مھوئے دھیرین وا کُمأت، آں یام مھوئے اُو می ڈوبأت، آں اللہ مھال نُو تُھو یأ تھأ زیت ظلم کویدے اَسے ہے خلک أمیدے اَمن زیت ظلم کوؤدود۔
کآم خلگے اللہ چھیدے دیال ڙݜاندر گأدتی تِھن مثال گھنگاپُور سی تُھو، یأ تی اے شیر سَوأت چی، آں یقینی بات چھی شیرا می ٹولے ما کیمزیر شیر گھنگاپور سی ہوژی، کاش کہ ہأ خلگائے پتہ ہوئیدے۔
اللہ یے غورا کیدے معلوم تھی سے ٹول شیئی یأ تھأئے ہے خلک اللہ چھیدے چأڑ کودی، آں سے اقتدار سی مالک تُھو آں حکمت سی مالک تُھو.
مھو مھأ مثال خلگا سی فائیدا سی کأ دیدی، آں ہیئے ما صرف سے خلک جندی یأ علم والا تھی۔
اللہ دھیرین و آسمان برحق (مقصد سی کأ) پیدا کیدی، حقیقت می ہأمی ایمان والا آ سی کأ گھن نخ تھی۔
(اے پیغمبرؐ!) کامے کتاب یأ تھیئے وحی سی زریعہ دے پیا گودو تِسی تلاوت کو، آں نماز قائم کو، بے شک نماز بے حیائی آں لاݜ کمے ما منع کودو، آں اللہ سی ذکر ٹولے ما گھن شیئی تُھو، آں کائی تھو کودی اللہ یے ٹول کما سی پتہ چھی۔
آں (اے مسلمان ہانا!) اہل کتاب سیت بحث نہ کوا، اَسے مھالے طریقہ دے یأ سے ٹولے ما غورا ہوئے، البتہ تھأمی یأ کآم ظلم کودوو تِھن بات دوئی چھی، آں (تھأئے) میسں بنا کہ مھوئے تے کتاب زیت ہُم ایمان اَنُودو یأ مھوئے نازل کوا گودُو، آں تیزیت ہُم یأ تھوزیت نازل کوا گودو، آں مُھن و تُھن خدا ایک تُھو، آں مھو اَںئی تِسی بات منو والا تھی۔
آں (اے پیغمبرؐ!) اَںئی ہاموڑ مھوئے تھیزیت کتاب نازل کیدو، اسی کأ کامے خلگائے مھوئے کتاب دِت تو دا سے تیزیت ایمان اَندی، آں مھأمی ہُم یام خلک تھی یأ ایزیت ایمان اَندی، آں مُھن آیادے ما اِنکار صرف سے خلک کودی کآم یأ کأفر تھی۔
آں (اے پیغمبرؐ!) تُو اِما مُوش نأ کی کتاب بن بھوؤدود نأئی کی کتاب تنو ہات تے لِک بھؤدُود، آں کو ہاموڑ ہوشُوو ناحق جن خلگے شک کونیندے۔
حقیقت تہ أ چھی کہ ہے قرآن مھال نخا سی مجموعہ تُھو یأ تھأ خلگا سی سینہ آ می بیخی روخانہ تھی کیس کے یأ علم دیا گودو، آں مُھن نخا سی انکاری صرف ظألم خلک تھی۔
آں ہے خلک بندی ایزیت (پیغمبرؐ زیت) اِسی پروردگار سی ڈھأرا نخ کئی نازل کوا نہ گئیدی؟ (اے پیغمبرؐ! ہأئے) بن کہ: نَخ تہ صرف اللہ کیش تھی، آں آ دا اے اخکارہ خبردار کوؤ والا تُھو۔
کئی تھین کأ اے (نخ) پورا نُو تُھو کہ مھوئے تھیزیت کتاب نازل کیدوُ یأ تھأئے بیندے بُھویا بیَدو؟ یقینًا اِسمی خلگا سی کأ گھین رحمت و نصیحت چھی کآم یأ منو والا تھی۔
بَن: مھی و تُھن مِیئے شیدی سی کأ اللہ پورا تُھو، تیس کے تھأ ٹول شیئی آ سی علم تُھو کامیک یأ دھیرین و آسمان آ می تھی، آں کامے خلک باطل زید ایمان اَنُودو آں اللہ سی انکاز کیدو اَںئی سے خلک سخت نفصان بھا کوؤ والا تھی۔
آں ہے خلک تھیزیت عذاب سی اَنو سی تأدی اَندی، کو (عذاب سی) اے مقرر کویل نیٹا نہ ہوشوو ہأزیت خامخا ینیندے، آں تی (عذاب) خامخا ینین، (اَسے) مھیدیک ناڅاپا کہ تھأئے پتہ ہم نہ گھڑنین۔
ہے تھیزیت عذاب سی تأدی اَندی، آں یقینًا دیزوخے کأفرے ما چاپیرا ہونین۔
تے دِیئے کے یأ عذاب تھأزیت تھین ڙیدا ہم یینن آں تھین کھوا سی ٹینا ہُم آں (اللہ) بنین کہ چکھا تھأ کما سی مزا کامیک یا تھو کوؤدود۔
اے مھی بَن ہانا یأ ایمان اَنودو! یقین کوا مھی دھیرین چیر گھین چھی، بس صرف مھی عبادت کوا۔
ہر سا گھینو والا آ ئے مئیک سی مزا چکھو تُھو، بھی مُھن دِش کے تھو بُٹ واپس اَنا بژنین۔
کامے خلگے ایمان اَنودو آں نیک عمل کودی، تھأ مھوئے خامخا جنت سی مھال اُچات کمرا آ می آباد کونین یأ تِھن ٹین نھید ریوان ہونین، تھید تھیئے مدام دھرنین، چیر غورا اَجر تُھو ہأ عمل کوؤ والا سی کأ،.
کی یأ صوو کی آں تنو پروردگار زید بھروسہ کودی۔
آں کھیدیک زیناور تھی یأ تنو رزق گھیندے نہ گئیدی! اللہ تھأئے ہُم رزق دیدو آں تھوئے ہُم، آں اَںئی سے تُھو یأ ہر بات بُھویدو، ہر شیئی پَشدو۔
آں کو تأ تھیئے ما توَس کی کہ: کآم تُھو یأ دھیرین او آسمان پیدا کیدی آں سی و یُن کَم زید ݜیأدتی؟ دَ تھیئے خامخا میس بنین کہ اللہ! بھی ہے خلک کھأدے اَونأ ریوان ہودی؟
اللہ تنو بَنا می کیس کے نِمؤسأدو رزق چیری کودُو آں کیس کے نِمؤسأدو رزق تینگی کودُو، یقیناً اللہ ہر شیئی سی پورا پورا علم لردُو۔
آں کو تو تھیئے ما توَس کو: کآم تُھو یأ آسمانے ما اُو مُژاد، بھی تِسی زریعہ دے مئیل دھیرین گے جیدون دید؟ دَ تھیئے ضرور بننین اللہ! دَ بَن الحمدللہ! خو ہأمی اکثر خلک عقل ما کام نی گِھندی۔
أ دونیئی سی جیدون علاوہ نڑو و تماشا ئے ما کی نو تُھو، آں حقیقت أ چھی کہ اَصل جیدون آخرت سی جیدون تُھو، کو ہأئے پتہ ہیشیو۔
آں کے یأ ہے کِشتی ئے أگھأدو ہے اللہ ئے مھاموڑ چأڑ کودی کہ ہین یقین خالص تیزیت ہودو، بھی کے یأ سے تھأ بچ کیدے شگیل دھیرین گے اَندوو سے سمدستی شرک شورو کودی.
خلک ناشکری کوئن تے نعمت سی یأ مھوئے ہأئے دیدتی، آں کوئن دھأک مزے، بھی سےساعت دُھو نو تُھو کے یأ تھأئے ہر بأت سی پتہ گھڑنین۔
کئی تھیئے میس کے نہ بُو کہ مھوئے (ہین خار) اے اَمن سی حرم سَوادتُو، حالانکہ تھین خوا و شا سی خلگا سی حال أ چھی کہ سے بھا کوا بژدی؟ کئی بھی ہُم ہے خلک باطل زید ایمان اَندی، آں اللہ سی نعمت سی نا شکری کودی؟
آں تے ماݜ ما گھن ظألم دوئی کی ہونین یأ اللہ زید بہتان ݜژادُو، یائی کے یأ تیس کے حق سی بات اَوئی و سے تیس لوو گھنڈدُو؟ کئی دیزوخے (مھال) کأفرا سی دھرو سی پوت نہ ہونین؟
آں کامے خلگے مُھن کأ کوشش کیو مھوئے تھأ خامخا تنو پَنائے آوانین، آں یقینًا اللہ نیگی کوؤ والا سیت تُھو۔
الف لام میم
روم سی خلک مغلوب ہُوئیدی،
نھیو دھیرین می؛ آں تھیئے تنُو مغلوب ہوؤ ما پأش شیرتے غالب ہونین،
دھأک کالا می۔ ٹول اختیار اللہ سی کأ تُھو، مُوش ہُم آں پأش ہُم، آں تے دی ایمان والائےخوشال ہونین،
اللہ سی دیل برئی زید؛ سے یأ کیس کے نِمادُوو بَرئی دیدُو؛ آں سے اقتدار والا ہُم تُھو آں گھن مہربان ہُم۔
أ اللہ سی کوئیل وعدہ چھی، اللہ تنُو وعدہ سی خلاف نہ کودُو، اَسے زیاد خلک نہ جنَدی۔
ہے دُونیئی سی زندگی سی صرف اخکارا ڈھأر ما جَندی، آں آخیرت سی بارا می ہین حال أ چھی یرأ ہے تِسما بالکل غافل تھی۔
کئی ہیئے تنُو حی آ وائے سوچ آں پھگر نی کی؟ اللہ آسمان آں دھیرین آں ہین مِیئے دھروُ والا شیئی بغیر کی برحق مقصدا ما آں کی نیٹا مقرر کوؤ ما بغیر پیدا نی کِیدی، آں چیر خلک مھال تھی سے تنُو پروردگار سیت میلاؤ ہوؤ ما مُنکر تھی۔
کئی ہے خلک دھیرین زیت نہ گئیدی تاکہ ہے پَشن ہأما مُوش کامے خلک اَشیئی دا تھین انجام کھال ہُو؟ سے طاقت می ہأما زیاد مضبوط اَشِئی، آں تھیئے دھیرین بِدیشی آں کھیدیک یأ مھیئے خلگے دھیرین آباد کیژی ہیئے ما زیاد آباد کِشی، آں تھأئے تھین پیغمبرے اَخکارا نخے سَمانے اَئیشی، دَ مھال حالت می اللہ تھأزیت ظلم نی کی بلکہ تھیئے تنُو اَمن زیت ظلم کی۔
بھی کامے خلگے لاݜ کَم کِشی تھین انجام ہُم لاݜ ہُو، کئیکہ تھیئے اللہ سی آیت لوو گھنڈیئشی، آں سے تھین پِشاڑے کوؤدوُد،
اللہ بُٹ مخلوق اول پیرا پیدا کودوُ، آں تی ہأ دُوآر پیدا کونین، بھی تھو ٹول تِسی کأشکے واپس کوا بژنین۔
آں بھی کامے دی یأ قیامت ینین، تے دی مجرم خلگے نااُمید ہونین۔
آں ہیئے کآم یأ اللہ سیت شریک گھنیئشی تھأمی یام ہُم ہین سفارشی نہ ہونین، آں أمینے تنُو سَویل شیریگے ما مُنکر ہونین۔
آں کامے دی یأ قیامت یینین تے دی خلک زأن زأنی ڈلآ می تقسیم ہونین
دَ تَھلا کامے خلگے یأ ایمان اَنوشُو آں نیک عمل کِیشی تھیئے جنت سی باغا می خوشال ہونین
آں کامے خلگے یأ کفر کِشُو آں مُھن آیات آں آخرت سی مُخامخ ہوؤ لوو گھنڈوشُو دَ مھال خلک عذاب می حاضر کوا بژنین۔
لہذا اللہ سی پاکی بیان کوا کے یأ تھوزیت جھیم ہیو آں تَھلا ہُم کے یأ تھوزیت ڙاد نِگھادو۔
آں تِسی صفت بیان ہوژی آسمانا می ہُم آں دھیرین می ہُم، آں سی بژوُ سی وَخ می ہُم تِسی پاکی بیان کوا آں پیشی سی وَخ می ہُم
سے جَن مئیل ما نِگھالَدُو آں مئیل جَن ما نِگھالَدُو آں سے دھیرین تِسی مئک ما پأش دُوآر جینی کودُو، آں مھامُوڑ تھوئے (قوَرر ما) نِگھالا بژنین۔
آں تِسی قدرت سی اے نَخ أ تُھو کہ تی تھو سُم ما پئیدا کی، بھی تھو انسان سَوا بیشتے (دھیرین زیت) خور ہُوئی۔
آں تِسی نخا می اے نَخ أ تُھو کہ تی تُھن کأ تھوئے ما جوَئی پئیدا کی، میلائی تھو تِھن کأشکے بیشتے سکون حاصل کوا، آں تُھن درمیان می محبت آں رحمت سی جذبات تَھئی، یقینا اِسمی تھأ خلگا سی کأ گھین نشانی تھی کآم یأ پِھگر ما کام گِھنَدی۔
آں تِسی نخا می آسمان آں دھیرین سی پیدائیش آں تُھن جِب آں ڙانگا سی اختلاف (ہُم) تُھو، جنأل خلگا سی کأ یقیناً اِسمی نَخ تھی۔
آں تِسی نخا (می اے نَخ) تُھن ڙأت و دی می ہُوبو آں اللہ سی فضل بِرڑو تُھو، یقیناً اِسمی تھأ خلگا سی کأ گھن نَخ تھی کآم یأ بات بُھوژدی۔
آں تِسی نَخے ما ایک أ تُھو کہ سے تھوئے اگھا سی بِریخُو سی پڑق پَشادُو، تیدے بِھت ہُم ییژی آں اُمید ہُم پیدا ہودُو، آں سے آسمان سی دِشا اُو مُوژادُو تِسی زریعہ دے دھیرین تِسی شڑ ہوؤ ما پأش جینی کودُو، یقیناً اِسمی تھأ خلگا سی کأ گھن نخ تھی کآم یأ عقل ما کام گِھندی۔
آں تِسی نَخے ما ایک أ تُھو کہ آسمان آں دھیرین تِسی حُکم دے قائم تھی، بھی کے یأ تی تھو دھیرین ما ہگأدے نِمانین دَ تھوئے فوراً نُوخنین۔
آں آسمانا می آں دھیرین می کا تُھو ٹول تِسی ملکیت می تھی، ٹول تِسی حکم سی تابع تھی۔
آں (اللہ) سے تُھو کی یأ ٹول مخلوقات اول پیرا پئیدا کیدی آں بھی دُوآر پئیدا کونین، آں أ کام تِسی کأ چیر آسان تُھو، آں سے ٹولے ما اُچات شان والا تُھو آسمانا می ہُم آں دھیرین می ہُم، آں سے غالب ہُم تُھو آں حکمت والا ہُم تُھو۔
سے تھوئے تُھن حال سی اے مثال بیان کودُو؛ مھوئے کامے رزق تھوئے دیدچی دا کئی تُھن غلاما می یام تِس می تھوسیت شریک تُھو کہ تے رزق می تُھن درجہ تیسیت برابر تُھو (آں) تھو تھأ غلاما ما مھامُوڑ بھیدی کھأکأ یا تھو ایکدوئی ما بھیدی؟ مھو مھامُوڑ دلائل تھأ خلگا سی کأ بیان کودی کآم یأ عقل ما کام گھیندی۔
اَسے ظألم خلک کی علم ما بغیر تنُو خواہشادا پیش ریوان تھی، دَ مھیرے تے ماݜ کے کام ہدایت دے بھادُو کیس یأ اللہ گمراہ کیدوُ، آں مھال خلگا سی کأ یام مددگار نو تُھو۔
لہذا تُو حی سی صدق تے تنُو مُو دین سی دِشکے اِڑی کو، اللہ سی سویل تے فطرت پیش بَش تیزیت تی تمام خلک پئیدا کیدی، اللہ سی پئیداوُخ می کی بدلُون آنا نہ بژژی، أ بالکل سِدا پان چھی اَسے اکثر خلک نہ جنَدی۔
اللہ سی دِشکے رجوع کیدے تِس ما بھیا آں نیماز قائم کوا، آں تھأ خلگا می شامل نہ ہوا کآم یأ شرک کودی۔
سے خلک کی یأ تنُو دین ٹوٹا ٹوٹا کیدُو آں جُدا جُدا فرقا می تقسیم ہوئیدی، ہر فرقہ تنُو طریقہ زیت خوشال تُھو۔
آں کے یأ خلگائے کی تکلیف آوودُو دَ سے تنُو پروردگار سی دِشکے رجوع کیدے تیسکے ہگادی، بھی کے یأ سے تنُو دِشا ہأزیت رحمت سی ذائقہ چکھادُو دا ہأمی یام خلک اچانک تنُو پروردگار زیت شِرک شروع کودی۔
تاکہ مھوئے یأ ہأئے کا دیدتُو تِسی ناشکری کوئن، ہأں دھأک مزہ گِھینا، بھی سے وَخ دُھو نہ تُھو کے یأ تھوئے ہر کی معلوم ہونین۔
کئی مھوئے ہأزیت مھال کی دلیل نازل کِیدوُ سے ہأئے مے شرک سی کوؤ سی بنَدو کامے شرک یأ ہے اللہ سیت کودی؟
آں کے یأ مھو خلگائے رحمت سی مزہ چکھادی دَ ہے تیدے خوشال ہودی، آں کو ہأئے ہین بدعملی سی وجہ دے کی مصیبت آووژی دَ اَشُوڑ وَخ می ہے مایوس ہودی۔
کئی ہیئے نُو بُودو کہ اللہ کِسی کأ نِمادُو رزق کولاؤ کودُو آں (کِسی کأ نِمادُو) تنگی کودُو؟ اِسمی یقیناً تھأ خلگا سی کأ گھین نشانی تھی کآم یأ ایمان آندی۔
لہذا تُو رشتہ دارائے تھین حق دے، آں مِسکینائے، مُسافرائے؛ کآم خلک یأ اللہ سی رضا نِمادی تھین کأ أ بہتر تُھو، آں ہے خلک کامیابی پوؤ والا تھی۔
آں تھو یأ کامے سُود دیدی تاکہ سے خلگا سی مال می شامل ہیدے چَیری ہوئے دَ سے اللہ سی نیز تے چیری نہ ہودوُ، آں کامے ذکواۃ تھو اللہ سی رضا حاصل کوؤ سی کأ دیدی دَ کامے خلک یأ مھامُوڑ کودی سے تنُو مال (اللہ سیت) چَیر چَیری کوؤ والا تھی۔
اللہ سے تُھو کی تھو پئیدا کی، بھی تی تھوئے رزق دید، بھی سے تھوئے مئک دیدُو، بھی تھو جینی کونین، کآم یأ تھوئے اللہ سیت شیریک گھنڈئیدی کئی تھأ می مھال یام تُھو سے مھال کَم کوبھادُو؟ سے پاک تُھو آں چیر اُوچات آں برتر تُھو تے شرک ما کامیک یأ ہے خلک کودی۔
خلگے تنُو ہادیدے کا کِیدُو تِسی وجہ دے شوگین آں دریاب می فساد خور ہُودو، میلائی ہیئے یأ کامے کام کیدُو تِسمی یاما سی مزہ ہأئے چکھا بژے، شاید ہے واپس ہون۔
(اے پیغمبرؐ) بَن تھو دھیرین می گی دے بُوا کآم خلک مُوش گئیدی دا تھین انجام کھال ہُو، تھأمی زیات خلک مُشرک اَشیئ۔
لہذا تُو تنُو مُو صحیح دین سی دِش کے اِڑی کو تِس ما مُوش کہ سے دی یو تِسی واپس کوؤ سی اللہ سی دِشا کی امکان نُو تُھو، تے دی خلگے جُدا جُدا ہونین۔
کی یأ کفر کیدُو تِسی کفر سی نقصان تیس کے تُھو آں کی یأ نیک عمل کیدی سے تنُو کأ (آرام سی) سامان تیا کودی۔
نتیجہ أ چھی کہ اللہ تھأ خلگائے تنُو مہربانی دے بدلہ دینین کی یأ ایمان اَنودُو آں نیک عمل کیدی، یقنیاً اللہ کأفر خلک نہ خوشادُو۔
آں تے (اللہ سی نخا می) اے نَخ أ تُھو کہ سے بیلأئی پیدُو، سے (ہگا سی) زیرے گِھندے آنَدی، میلائی تھوئے تنُو رحمت سی کآں مزہ چکھے، آں مِسی کأ کہ کشتی تِسی حکم دے اُو زیت چلے، آں میلائی تھو تِسی فضل بِرڑا، آں تِسی شُکر نِگھلا۔
آں (اے پیغمبرؐ) مھوئے تھأ ما مُوش ہُم چیر پیغمبر تھین قوما سی کأشکے پیئشی، دَ سے تھأئے کولاؤ کولاؤ دلائل گھیندے اَئی، بھی کی یأ نافرمانی کی مھوئے تھأ ما بدَل گھین، آں مھوئے مے ذمہ واری گھین چی کہ ایمان والا سی مدد کیئی۔
اللہ پاک سے ذات تُھو کآم یأ ہوا پیدُو، دَ سے لڑے بھا کودی، بھی سے ہأ (لڑے) کھأکأ یأ نِمادُو آسمان می خور کودوُ، بھی تیس کوڑو کوڑو کودُو، بھی تھو بودی کہ تِسی مِیا ہاگا سی پِھݜ نُوخدی، بھی سے تنُو بنے ما کیزیت یأ نِمؤسأدو ہاگا مُوژادُو، دَ سے خوشالا ہودی۔
حالانکہ اِسما مُوش کھیدیگا پورے یأ ہأزیت ہاگا نُو مُودُوشو ہے نااُمید ہوؤدود۔
دَ مھیرے اللہ سی رحمت سی اثرات بُو کہ سے دھیرین تِسی شڑ ہوؤ ما پأش دُوآر جینی کودُو، حقیقت أ چھی کہ سے مئیل جینی کوؤ والا تُھو، آں ہر شیئی زیت پورا پورا طاقت لَردُو۔
آں کو مھو (نقصأنی) ہوا چلئی دَ تِسی نتیجہ می ہے تنُو بُھوم چنیئی ہوئیل پَشن، دَ تِسما بعد ہیئے ناشکری شروع کونین۔
(اے پیغمبرؐ) تو مئیلائے تنُو بات نہ بُھوژا بھادُو، آں نأ بو آ ئے تنُو آواز بُھوژا بھادُو کے یأ سے پیٹ کیدے ریوان ہُوئیو۔
آں نأ تُو اَن تھین گُمراہی ما نِگھألدے ہدایت زیت آن بھادُو، تُو دَ تھأ خلگائے تنُو بات بھوژا بھادُو کآم یأ مُھن آیادا زیت ایمان آندی، آں بھی فرمان بردار سَوا بژدی۔
اللہ سے ذات تُھو کی تُھن پئیدائش سی شروع کمزوری ما کی، بھی کمزوری ما بعد طاقت دید، بھی طاقت ما بعد (دُوآر) کمزوری آں ڈھگاچا دید، سے یأ کا نِمادُو پئیدا کودُو، آں سے تُھو تِسی علم ہُم کامل تُھو آں قدرت ہُم کامل چھی۔
آں کامے دی یأ قیامت ہونین تے دی مجرم خلگے قسم کھانین کہ ہے (برزخ می) اے ساعت ما زیاد نہ دھرئیشی، مھامُوڑ ہے (دُونیئی می ہُم) ہے اُلٹا گئیا بژودُود۔
آں کامے خلگائے علم آں ایمان دیا گودُو تھیئے بننین: تھو اللہ سی لِگیل تقدیر سی مطابق حشر سی دیا پورے (برزخ می) دھریئشی، أ مھیرے حشر سی دی تُھو، اَسے تھو خلک یقین نہ کوؤدود۔
دَ کآم خلگے ظلم سی پان اختیار کِیشی تے دی ہین معذرت کی فائدہ نہ دینین، آں نأ ہأئے مھامُوڑ بنا بژنین کہ تھو اللہ سی ناراضگی دھوگو کوا۔
آں حقیقت أ چھی کہ مھوئے مے قرآن می خلگا سی (جنوؤ سی) ہر قسم مثال بیان کیدی، آں (اے پیغمبرؐ) ہین حال أ چھی تُو ہأئے کی نَخ ہُم آن ہے کأفر خلک بندی تُو ناحق زیت تُھو۔
اللہ مھامُوڑ تھأ خلگا سی حی آ زیت مہر ݜژادُو کآم یأ جنُو ما کام نی گھیندی۔
دَ (اے پیغمبرؐ) تُو صوو ما کام گھین، یقین کو اللہ سی وعدہ سأس چھی آں مھامُوڑ یئت ہُم نہ ہوئے کہ کامے خلک یقین نہ کودی تھین وجہ دے تُو بے صبرا ہو۔
الف، لام، میم
دُوںئی جہانا سی پروردگار سی دِشا أ مھالے کتاب سی نزول ہودُو تِس می کی شک سی بات نی چھی۔
کئی ہے (خلک) میس بنَدی کہ پیغمبرے ایس اَمنا سَوادتُو؟ نأ (اے پیغمبرؐ!) أ دا سے حق تُھو یأ چھی پروردگار سی دِشا مِسی کأ آپ تُو یأ تُو اِسی زریعہ دے تھأ خلک خبردار کو یأ تھأئے تھأ ما مُوش یام خبردار کوؤ والا نہ آبوشُو، میلائی ہے صحیح پَن زیت یَن۔
اللہ سے تُھو کی یأ آسمان آں دھیرین آں ہین مِیئے تمام شیئی ݜو دِیا می پیدا کی، بھی سے عرش زیت قائم ہُو، تیس ما علاوہ نأ یام تُھن مددگار تُھو آں نأ سفارشی، دَ بھی ہُم تھو کی نصیحت کے پِھگر نہ کودی؟
سے آسمان ما گِھندے دھیرینا پورے ہرے کم سی انتظام أمیدے کودُو، بھی سے کام اے دی می تِسی کأشکے بھائے اَوودوُ یأ تے دی سی مقدار لیکھُو سی حساب تے اے زر کالے تُھو۔
سے ہرے بِیریت آں ڈاگا شیئی ما جَندوُ، تِسی اقتدار ہُم کامل تُھو آں تِسی رحمت ہُم کامل چھی۔
تی کا شیئی یأ پیدا کی غورا پیدا کی، آں انسان سی پیدائش سُم ما شروع کی۔
بھی تِسی نسل اے چِیویل خزا اُو ما چلأد۔
بھی ایس برابر کیدے اِسمی تنُو دِشا روح پھیگی، آں تُھن کأ کَن أݜی آں حی پیدا کی، تھو خلک شکر چیر کم نِگھالَدی۔
آں ہے خلک بنَدی کے یأ مھو دھیرین می ہأڙیش تے ختم ہوئیو دَ کئی مھوئے بھی دُوآر نم پیدائشیدے پیئدا ہونین؟ دراصل بات أ چھی کہ ہے خلک تنُو پروردگار سیت میلاؤ ہوؤ ما اِنکأری تھی۔
تُو بَن (اے پیغمبرؐ) تھو مئیک سی تی فرشتہ پورا پورا تنُو قبضہ می گِھننین کامیک یأ تھوزیت مقرر کوا گأ یی، بھی تھو واپس تنُو پرودگار سی کأش کے نیا بژنین۔
آں کاش کہ تُو تے منظر پَش، کے یأ مجرم خلگے تنُو رَب سی کأشکے ݜا وا کیدے اِڑی ہوئیل ہونین، (ہیئے بننین) اے مُھن پروردگار! مُھن أݜی آں کن کولاؤ ہوئیدی، مے وجہ دے مھو دُونیئی گے دُوآر پے، تاکہ مھو نیک عمل کیئی، مھوئے غورہ طریقہ دے یقین آپ تُو۔
آں کو مھو نیمؤدُودو ہرے ماݜ کے مُوش ما تِسی ہدایت دے نیندے، اَسے کامے بات مھی دِشا بنا گأئی سے مقرر ہیژی کہ مأ دیزوخ پَیر و انسان ٹولے ما پُون نین۔
مھیرے (جہنم سی) مزہ چکھا، کئی تھوئے مے دی سی مُخامخ ہوؤ اَموݜوشُو، دَ مھوئے ہُم تھو اَموݜیئدی، کا یأ تھوئے کیدُو دا تِسی بدلہ می مھیرے ہمیشہ سی عذاب سی مزہ چکھا۔
مُھن آیادا زیت تا سے خلک ایمان انَدی کے یأ ہأئے ہأ آیادا سی زریعہ دے نصیحت کوا بڙژی دَ سے سِجدہ می لار بژدی، آں تنُو پروردگار سی حمد سیت تِسی تسبیح کودی، آں سے تکبر نہ کودی۔
ہین ڈھأر (ڙأت می) تنُو بسترائے ما جُدا ہودی، سے تنُو پروردگار کے بِھت آں اُمید سیت ہگادی، آں مھوئے تھأئے کامے رزق دِیدتُو سے تِسما (نیگی سی کما می) خرچ کودی۔
اے انسان گے ہُم پتہ نی چھی کہ ہین أݜیا سی شیدیلی کوؤ سی کأ کا سامان ہین اعمالا سی بدل می بُورأدے تھا گودوُ۔
(تھو بنا دا) کامے ماݜ یأ مومن تُھو کئی (سے) تے ماݜ سی شانے ہو بھادُو کآم یأ نافرمان تُھو؟ ہے برابر نہ ہو بھادی۔
چنانچہ کامے خلگے یأ ایمان اَنُودو آں نیک عمل کیدی ہین کأ مستقل دھرُو سی باغ تھی، تھأ ہأئے اولنی میلأݜ توب سی طور تے دیا بڙنین، تھأ عملا سی بدَل می کامے عمل یأ ہے کوؤدُود۔
آں کامے خلگے یأ نافرمانی کیژی دَ ہین ہمیشہ سی دھرُو سی پوت جہنم تُھو، کے یأ ہیئے تِما نُوخو نِمانین دَ ہأ واپس کوا بڙنین، ہأئے بَنا بڙنین: آنگا سی کامے عذاب تھو لَوو گھنڈودُود مھیرے تِسی مزہ چکھا۔
آں اے گھن عذاب ما مُوش ہُم مھوئے ہأئے کم درجہ سی عذاب سی مزہ ضرور چکھانین، ہوبھادُو ہے واپس ہون۔
آں تِس ما گھن ظالم کی ہونین، یأ تیسکے تِسی پرودگار سی آیادا سی زریعہ دے نصیحت کوا گأ دَ تی تِسما مُو نڑاد؟ مھوئے یقینا مھال مجرمے ما بدل ضرور گھِن نین۔
آں یقینا مھوئے موسیٰ ئے کتاب دِیدُوشو، لہذا (اے پیغمبرؐ) تُو تیسیت میلاؤ ہوؤ سی بارہ می کی شک می نہ ہو، آں مھوئے تے کتاب بنی اسرائیل سی ہدایت سی کأ سَوادوُشو۔
آں مھوئے ہأمی یام خلگائے، کے یأ تھیئے صوو کی، مھال گھینیئی دید سے مُھن حکم دے خلگائے پان پَشؤدُود آں سے مُھن آیادا زیت یقین کوؤدُود۔
یقینا چھی پروردگار قیامت سی دی ہین میئے تھأ بأدا سی فیصلہ کونین کامیک می یأ ہے اختلاف کوؤدُود۔
آں کئی ہأئے (کأفرائے) مے بأت ما کی ہدایت میلاؤ نی ہی کہ ہأما مُوش مھوئے کھیدیک خلک ہلاک کِیدی تھین شِیرا می ہے أمیدے گئیدی؟ یقینا اِسمی ہأ خلگا سی کأ گھین نشانی تھی، دَ کئی ہے خلک بُھوژدی نأ؟
آں کئ ہے خلک نہ پشَدی کہ مھو اُو ݲھیکتے شُوگیل دھیرین سی دِشکے نئیَدی، بھی تِس ما ہے فصل بھا کودی، تِس ما ہین څاروَئی ہُم کھادی آں ہے أمینے ہُم، دَ کئی ہے خلک بودی نأ؟
آں ہے خلک بنَدی: کو تھو سیال تِھیو می فیصلہ کے ہونین؟
تُو بَن (اے پیغمبرؐ) کامے دی یأ فیصلہ ہونین تے دی کأفرائے ہین ایمان سی آنُو کی فائدہ نہ دینین، آں نأ ہأئے کی مہلت دیا بژنین۔
لہذا (اے پیغمبرؐ) تُو ہأ خلگا سی کی پروا نہ کو، آں انتظار کو ہے ہُم انتظار کودی۔
اے نبیؐ! اللہ ما بھیا یے، آں کأفر و منافق خلگا سی تابعداری نہ کو، بیشکہ اللہ گھن جنو والا، حکمت والا تُھو۔
آں تے وحی سی تابعداری کو، کامیک یأ چھی رب سی دِشا تھیئےکوا بژیی، بیشکہ تھو کا یأ کودی دا اللہ تِسما شید تُھو۔
آں اللہ زید اِتبار کوا، آں اللہ کام سوؤ (ذمہ واری) سی کأ پورا تُھو۔
اللہ اے ماݜ سی ہُم ڈم می دو حی پیدا نی کیدی، آں نائی تُھن تھأ ڇھی تُھن ییئی سیوأدتی، کاما ما تھو ظہار کودی (تنو ییئی سی ڈاک زید مثال دیدی)، آں نائی تُھن أں سی بنیل (اولاد) تُھن جدک سیوادتی، أ تُھن أں سی بنیل بأت تھی، آں اللہ حق بات بندو، آں سے ݜِݜ پان پشادو۔
ہأئے ہین بوب آ سی نام دے ہاگا، أ بات اللہ سی در می چیرے انصاف سی چھی، بھی کو تھوئے ہین بوب آ سی پتہ نی ہیو دَ ہے تُھن دینی بھئی تھی، تُھن سأت تھی، آں کا غلطی یأ تھوکیژا ہی دا ایزمی تھوزید کی گناہ نو تُھو، ہاں کا بأت سی یأ تُھن حی ارادہ کیو (تِس می گناہ تُھو)، آں اللہ چیر بوگوشو والا مہربان تُھو۔
پیغمبرؐ ایمان دارائے ہین تنو اَمن ما چیر نھیو تُھو، آں تِسی بی بی ہین یئی تھی، آں ژات سی اخپلوان اللہ سی کتاب می ایکدی آ سی زیاد حقدا تھی عام مسلمان آں مہاجرین آ ما، ہاں کو تھوئے تنو سأدا زیت (کآں وصیت کیدے) غورہ کیو، أ (بات) کتاب می لِگیل چھی۔
(اے پیغمبرؐ!) آں تے ساعت یاد کو، کے یأ مھوئے بوڑ پیغمبرے ما لوظ گھن، آں تھوما آں نوحؐ و ابراہیم و موسٰی آں مریمؑ سی پو عیسٰی ما (ہُم)، آں مھوئے ہأما پوخ لوظ گھن۔
مِسی کأ کہ سأسبن آ ما (اللہ) تِھن سأس سی توَس کوے، آں تی کأفرائے سخ عذاب تیا کیدُو۔
اے ایمان والا ہانا! تنو اَمن زید اللہ سی نعمت یادکوا، کا ساعدا تھوزید لخکرے حملہ کی تھلا مھوئی تھأزید بیلأئی پیئی، آں مھال لخکر ہُم کہ تھوئے تھأ نی ڈیڈ، آں اللہ کائی تھو کؤدود تیز پشودود۔
کا ساعدا یأ سے لخکر تھوزید ڙیت سی دِشا اَئیشی، آں ٹین سی دِشا ہُم، آں کے یأ أشی کیلی ہوئی (ڙیت دھریئی)، آں حی نیختے شانگائے اَوئی، آں تھو اللہ سی بارا می دھأل دھأل گمان کؤسأد،
تے ساعدا ایماندا غورہ آزما گئی، آں سختیدے جھڑقا گئی۔
آں (تے ساعد یاد کوا) کے یأ منأفق آں سے خلک کسی حی می مرض أشی بنودود کہ: "اللہ و تِسی رسولؐ مھوزید کا لوظ کیدو سے دا دوکہ أشی"۔
آں کے یأ ہأمی اے ڈلہ بنو کہ اے یثرب (مدینہ) سی خلک ہانا! "تُھن مھید دھرو سی کی پوت نو تُھو، دَ تھو پدیئے واپس بیا!"، آں ہأمی اے ڈلہ پیغمبر ما دھرُو سی اجازت نیمؤدود، بندی: "مُھن شیر خُوشے تھی"، آں ہین شیر کی خوشے نی اَشیئی، ہے صرف ڈیؤ نیمؤدود۔
آں کو (دشمن) مدینہ سی چؤ دِشے ہازید لخکر گھیندے اندر کے لھنگئیو، بھی ہائے فساد می گاڑ ہوؤ سی بنا گاو ہیئے خامخا تیسکے یینین، آں ہیئے (شیر) آ می اَشوڑ ہُم ہیسار نہ ہونین۔
آں یقیناً ہیئے موش ما اللہ زید لوز کیشو کہ ہیئے پیڑ گئیادے نے ڈینین، آں اللہ زید کوئیل لوز سی توَس کوا بژنین۔
(اے پیغمبرؐ تو ہأئے) بَن! کو تھو مئیک ما یا موؤ ما ڈیدی، اِی ڈیؤ تھوئے کی فائدہ نہ دینین، آں اے ساعدا تھوئے (جیدون) سی خوند گھینو سی موقع دیا نہ بژنین، اَشوڑ خوند ما علاوہ۔
(اے پیغمبرؐ تو ہأئے) بَن! تھو اللہ ما کی لھاسنین، کو تی تھوئے لاݜ سی اَوؤ نیمادو یا تھوزید مہربانی کوؤ نیمادو؟ آں نأئی ہیئے تنو کأ اللہ ما علاوہ ییس سأت آں مددگار پانین۔
اللہ تھومی تھأ خلک غورہ پأندو کآم یأ خلک ( جہاد ما) کھمدی، آں تنو بھئی آئے بندی، "مُھن کأش کے یا"، آں أمیدے لات کے چیر اَشوڑ ییدی۔
(ہے) تھوزید لالچ ساتدی۔ بھی یأ کی بھیت أبو دَ تأ ہأ پشنین، ہیئے تھوئے أݜی پشادے څارنین، تے ماݜ سی شانے کیزید یأ مئیک سی وجہ دے سأدلی أبو، بھی کے یأ بھیت گأو، دَ ہے تُھن مُشکے مال سی غرضیدے ییدے تنو جیب تے چاخ چاخ بأت کودی، ہیئے ہاڈو ایمان نہ اَنودُو، دَ اللہ ہین بوڑ عمل برباد کی، آں أ کام اللہ سی کأ چیر آسان تُھو۔
ہے (منأفق خلک) مے گمان کودی کہ (دشمن آ سی) لخکر لا نہ گئیدی، آں کو سے لخکر دوآر اَئیو دَ ہیئے مے بات خوشانین کہ ہے بانا می ڈھأروش آ سید ہوئن، آں تُھن حالات آ سی خبر گھینایَن، آں کو ہے تھومی ہُوئی ہُم، بھی ہُم چیر اَشوڑ لات کونین۔
بیشکہ تُھن کأ اللہ سی رسولؐ می شیژو نمونہ تُھو، ہر تے ماݜ سی کأ کآم یأ اللہ آں آخرت سی دی زید اُمید ساتدُو، آں اللہ سی چیر چیر ذکر کودُو۔
آں کا ساعدا ایمان دارے (دشمن آ سی) لخکر ڈیڈتا بنو: "أ سے شیئی تُھو کامیک سی اللہ و تِسی رسولؐ مھوزید لوز کیشو، آں اللہ و تِسی رسولؐ سأز بنوشو"، آں می واقعہ ہین ایمان و تابعداری لا لا چیری کی۔
ایمان والا آ می مھال ماݜ ہُم اَشیئی تھیئے سأز کیدے پشأد کا بأت سی یأ اللہ سیت لوز کیشو، دَ یامے تھأمی تنو نذر پورا کی، آں یام تھأمی لا کُوٹھادی، آں تھین (تنو نیت آ می) کی بدلُن نی کی۔
(أ واقعہ مِسی کأ ہی) کہ اللہ سأزبنائے تھین سأز سی بدل دو، آں منافق آئے کا تی نیمادو عذاب دو، یا تھین توبہ قبول کوئے، بیشکہ اللہ گھن بوگوشو والا مہربان تُھو۔
آں اللہ کافر خلک ہین تنو قہر سمانے مھال نُڑأد کہ ہیئے کی فائدہ نی گھین بھوؤ، اللہ مسلمان آ سی دِشا لات کے أمیدے پورا اَشو، آں اللہ طاقتور زوروڑ ذات تُھو۔
آں کامے اہل کتاب ہأ دشمن آ سی مدد کیشی، تھأ اللہ تھین قلائے ما والیئ، آں تھین حی آ می مھال رعب تھلو کہ اے ڈلہ تھو موؤدود آں دھوئم ڈلہ تھو قید کؤدودو۔
آں تی (اللہ) تھو تھین دھرین آ سی، آں تھین شیر آ سی، آں مال آ سی میراثی کی، آں مھال دھیرین سی ہُم کہ تیس لا تُھن کھوئے نہ چمیگیشی، آں اللہ ہر شیئی زید قدرت لردُو۔
اے پیغمبرؐ! تھو تنو بی بی آئے بنا کہ تھو دونیئی سی جیدون آں اِسی شیژواچا نیمادیو تھلا تھو یا، آ تھوئے دھأک سامان دئی، آں شیژواچا دے تھو رخصت کیئی۔
آں کو تھو اللہ و تِسی رسولؐ آں آخرت سی شیر نیمادی، تھلا بیشکہ اللہ تھو می نیک جوئی آئے گھن اَجر تیا کیدو۔
اے پیغمبرؐ سی بی بی ہانا! تھو می کی ہُم اخکارہ بے حیائی سی کام کیو تیسکے دوگُن عذاب دیا بژنین، آں أ کام اللہ یے سوگھا تُھو۔
آں تھومی یام ہم اللہ آں تِسی رسولؐ سی تابعدار دھیری، آں نیک عمل کیو، مھوئے تیسکے تِسی ثواب ہُم دُوگن دینین، مھوئی تِسی کأ عزت سی رزق تیا کیژی۔
اے پیغمبرؐ سی جوَئی ہانا! تھو دأل جَوئی آ سی شانے نی تھی؛ کو تھوئے تقویٰ اختیار کیو، (ناشینا ماݜ آ سیت) نرم نرم بأت نو کوا، لَخہ سے ماݜ یأ تِسی حی می کی قسم سی مرض چھیو کی اُمید پیدا نو کوئے، آں سیدا بات کوا۔
آں تنو شیر آ می دَھرا، آں (دأل ماݜا یے اَمن) مُوشک جاہلیت سی چَھلے سیوأدے نہ پَشا، نیماز گُوزا آں ذکوٰۃ دا، آں اللہ آں تِسی رسولؐ سی بات بُھویا، اے نبیؐ سی شیر والا ہانا! اللہ دا میس نیمادو لَخہ تھو ما گندگی دھگو کوئے، آں تھو ہر طریقہ دے پورا پورا پاک کوے۔
آں تُھن شیر آ می اللہ سی کامے آیات آں حکمت سی کامے بأت بھوژا بژدی دا تھأ یاد کوا، یقیناً اللہ ہر بأت ما شید تُھو۔
یقیناً مسلمان (اللہ سی حکم سی موشکے تنو ݜا وا کوؤ والا) ماݜ، مسلمان ڇھی، مومن ماݜ، مومن ڇھی، عبادت کوؤ والا ماݜ، عبادت کوؤ والا ڇھی، سأزبَن ماݜ، سأزبأن ڇھی صوؤ کوؤ والا ماݜ، صوو کوؤ والا ڇھی، عاجزی کوؤ والا ماݜ، عاجزی کوؤ والا ڇھی، صدقہ کوؤ والا ماݜ، صدقہ کوؤ والا ڇھی، ڙوزدا ماݜ، ڙوزدا ڇھی، تنو شرمگاہ آ سی حفاظت کوؤ والا ماݜ، حفاطت کوؤ والا ڇھی، اللہ سی چیر ذکر کوؤ والا ماݜ، چیر ذکر کوؤ والا ڇھی، ہین کأ اللہ بخانا، غورہ اَجر تیا کیدُو۔
کی مومن ماݜ آں مومن جوئی گے گنجائش نی چھی لخہ کے یأ اللہ آں تِسی رسولؐ کی معاملہ سی فیصلہ کیو دَ بھی تیسکے تے معاملہ می أمینے فیصلہ کوؤ سی کی اختیار باقی دھریدا، آں کی اللہ آں تِسی رسولؐ سی نافرمانی کی دَ سے اخکارہ گمراہی وا گا۔
آں (اے پیغمبرؐ!) یاد کو تو تے ماݜ، کیزید یأ اللہ ہُم احسان کیشو تأ ہُم احسان کیشو، میس بنودو: "تنو ڇھی تنو نکاح می دھرا، اللہ ما بھی"، آں تأ تنو حی می تے بات بورأیدیشی کامیک یأ اللہ اخکارہ کوؤ والا اَشو، تو خلگا ما بھیودود، حالانکہ اللہ مے بأت سی چیر حقدار تُھو یأ تو تِسما بھی، بھی کے یأ زید تنو ڇھی سیت تعلق پھراد دَ مھوئی تیزید چھی نکاح کواد، مِسی کأ یرأ مسلمان آ سی کأ تنو أں سی بنیل جدگا سی ڇھی سی (نکاح) می تے وخ کی تنگی نہ دھرے کے تھین تنو ڇھی آ سیت تعلق لھادو، آں اللہ کا حکم دیدتو دا سے پورا ہیدے دھرے۔
نبیؐ سی کأ تے کم می کی اعتراض سی بات نو ہوژی، کامیک یأ اللہ تِسی کأ مقرر کیدُو، أ اللہ سی سے سنت چھی کامیک یأ تھأ ٹول (انبیاءؑ) آ سی معاملہ می ہُم عمل ہُوشو کآم یأ موش لھنگئیدیو، آں اللہ سی فیصلہ مقرر کویل فیصلہ ہوژی۔
(پیغمبر) سے خلک تھی یأ سے اللہ سی پَیل احکام خلگا پورے اَوادیدی، آں اَںئی تیما بھیدی، اللہ ما علاوہ یما نے بھیدی، آں حساب گھینو سی کأ اللہ پورا تُھو۔
محمدؐ تھو ماژے ما یِسی باپ نو تُھو، خو اللہ سی رسول تُھو آں ٹول نبی ما آخری نبی تُھو، آں اللہ ہر بات غورہ جنو والا تُھو۔
اے ایمان والا ہانا! اللہ سی چیر زیاد ذکر کوا۔
آں ڙات و نأشاما تِسی تسبیح کوا۔
(اللہ) اَںئی سے تُھو یأ سے أمینے ہُم تھوزید رحمت پیدو آں تِسی مُلیک ہُم، لخہ سے تھو أنچک ما نِگھألدے لوش آمی اَنے، آں سے (اللہ) مومن آ زید چیر مہربان تُھو۔
کے سے (مومن) تیسیت میلاؤ ہوسأدو تے دی تھین خیرسیت بنو "سلام" دے ہونین، آں (اللہ) ہین کأ عزت سی انعام تیا کیدُو۔
اے نبیؐ! یقینا ًمھوئے تھأ گواہی دیؤ والا آں زیرے دیؤ والا آں بھیؤ والا سیوأدے پیؤدو،
آں اللہ سی حکم دے خلک اللہ سی دِشکے ہاگؤ والا آں (ہدایت سی) لوش خور کوؤ والا ڈی تُھو۔
آں تُو مومن آئے زیرے دے لخہ ہأزید اللہ سی دِشا گھن فضل ہوؤ والا تُھو۔
آں کأفر و منأفق آ سی بأت نہ من، تھین دِشا کی تکلیف اَوؤو تِسی پرواہ نہ کو، اللہ زید یقین سات، اللہ کام سوؤ سی کأ پورا تُھو۔
اے ایمان والا ہانا! کے تھوئے مومن ڇھی آ سیت نکاح کیو، بھی تھوئے ہات دیؤ ما موش تھأ چھوئیو، دَ تُھن دِشا تھأزید کی عدت واجب نی چھی، یرأ تھو تِسی (دی آ سی) لیک کوا، دَ تھأئے کآں تحفہ دیدے غورا طریقہ دے رخصت کوا۔
اے نبیؐ! مھوئے تُھن کأ تھأ ڇھی حلال کیدی کسی کأ تھوئے تھین مہر دیدتُوو، اَںئی ہاموڑ غنیمت سی کامے مال اللہ تھوئے دیدچی دا تھأمی کامے گُلأم تُھن ملکیت می اَئیدیدا سے ہُم (تُھن کأ حلال تھی)، آں تُھن پِڙی سی سیرأن آں پھأپ سی سیرأن، آں موم سی سیرأن آں مأش سی سیرأن، کامیگے یأ تھوسید ہجرت کیژی دا، اَںئی ہاموڑ سے مسلمان ڇھی یأ مہر ما بغیر اَمن (نکاح سی کأ) پیش کیو، کو نبیؐ تھأسید نکاح نیمؤسأدو، أ ٹول احکام خاص چھی (حضورؐ سی) کأ تھی، دأل مومن چھیدے، مھوئے سے ٹول احکام غورا معلوم تھی کامیک یأ مھوئے ہأزید ہین ڇھی آ سی آں ہین گُلأم آ سی بارا می لازم کیدی (تھوزید لازم نی تھی)، لخہ تھوزید کی تنگی نہ دھرے، اللہ چیر بوگوشو والا آں گھن رحم کوؤ والا تُھو۔
مھأ ڇھی آ می تُو یِسی وار چھوؤ نیمادؤو چھو، آں کامیک نیمادُوو اَمن سید دھرا، آں کامیک تأ جدا کیدیدا کہ ییس واپس کوؤ نیمؤسأدو تھوزید کی گناہ نو تُھو، مے طریقہ می مے بأت سی چیر توقع تُھو لخہ ہین أݜی شِدیلی ہونین، تھیئے خپا نہ ہونین، آں کو تو ہأئے کی دیؤسأدو تیزید ہیئے ٹولے خوشحال دھرنین، اللہ ٹول غورا جندو کا تُھن حی آ می تُھو، اللہ جنو والا بردبار تُھو۔
(اے پیغمبرؐ!) اِسما بعد چھی کأ دأل ڇھی حلال نی تھی، آں نأئی أ جائز تُھو لخہ تُو ہین پوت دأل ڇھی آن، کو تھیئے تھین خوئی خوش ہُم أبچیو، اَسے کآم چھی گُلأم تھیو (سے چھی کأ حلال تھی)، اللہ ہر شیئی سی نگرانی کوؤ والا تُھو۔
اے ایمان والا ہانا! نبیؐ سی شیر آ می (بے اِجازدا) نہ لھنگا، ہاں کو تھوئے کھؤ سی کأ ییؤ سی اجازت دیا گأو، تیس ہُم مھاموڑ یرأ تھو تے گیل آ سی تیا ہوؤ سی انتظار می نہ بَھیا، اَسے کے تھوئے دعوت دیا گأو بیا، بھی کے گیل کھیئیو تھلا خور ہوا، آں بأدا سی کأ حی ݜژأدے نہ بھیا، حقیقت اے چھی مے بأدیدے نبیؐ یے تکلیف اَوودُو، سے تھوئے (بنو می) لاش کودُو، اللہ حق بأت می یسما لاش نہ کودُو۔ آں کے تھو نبیؐ سی ڇھیئے ما کی نیمؤسأدو پردہ سی پأشا نیما۔ أ طریقہ تُھن حی سی کأ آں تھین حی آ سی زیاد پاک ساتو سی ذریعہ تُھو، تُھن کأ جائز نو تُھو یرأ اللہ سی رسول گے تکلیف آوا، نأئی أ جائر تُھو یأ تیما بعد تِسی ڇھی آ می یسیت نکاح کوا، یقیناً ہے اللہ سی نیز می گھین (گناہ سی بات) چھی۔
تھو کی بات اخکارہ کودی یا کی بورادی، اللہ ہرے شیئی سی پورا پورا علم ساتو والا تُھو۔
(نبیؐ سی) ڇھی آ زید کی گناہ نو تُھو تُن تنو بوب آسی (مُشکے بے پردگی می)، نأئی تنو جدگا سی، نأئی تنو بھئی آسی، نأئی تنو بھووݜ آسی، نأئی تنو خورئی آسی، تنو (مسلمان) جوَئی آسی، نأئی تنو گُلأم آسی (مُشکے ییؤ می کی گناہ تُھو) ، (اے جوَئی ہانا!) تھو اللہ مابھیا، یقین کوا اللہ ہر بأت سی پشو والا تُھو۔
یقیناً اللہ آں تِسی مُلیک نبیؐ زید درود پیدی، اے ایمان والا ہانا تھو ہُم تیزید درود پیا، چیر چیر سلام پیا۔
کامے خلک اللہ آں تِسی رسولؐ گے تکلیف اَوادی، اللہ دُونیئی و آخرت می ہأزید لعنت کیژی، آں ہین کأ مھال عذاب تیا کیدو یأ (ہأ) ذلیل کیدے چھونین۔
کامے خلک مومن ماݜ آں مومن ڇھی آئے بےقصور تکلیف دیدی، تھیئے تنو ݜا آ زید بہتان ݜژؤ سی آں اخکارہ گناہ سی بوج تھانین۔
اے نبیؐ! تنو ڇھی آئے آں تنو سیرأن آئے آں مسلمان آسی جوئی آئے بَن، کہ سے تنو څازر آسی پلؤ (تنو بوت) زید تھلن، أ غورا بات چھی یرأ سے پیانا بژن دَ تینگی کوا نہ بژن، اللہ بوگوشو والا، چیر مہربان تُھو۔
کو منأفق آں سے خلک یأ کھین حی آ می نَشن تُھو، آں مے خار (مدینہ) می لاݜ افواہ خور کودی، قلار نو ہُوئیو دَ مھوئے خامخا تھو ہأپیش اُچات کونین، بھی تھیئے مے خار می تھوسیت نہ دھربھانین، خو دھأک دی۔
تسمی تھیئے لعنت کویل ہونین، (بھی) کھید میلأو ہوئیو گݜا بژنین، آں لاݜ طریقہ دے ما بژنین۔
أ اللہ سی طریقہ تُھو، تھأ خلگا سی معاملہ می ہُم (اَشو) کآم یأ موش لھنگئیدی، تھوئے یئت ہُم اللہ سی طریقہ می بدلُن نہ پانین۔
خلک تھأما قیامت سی بارہ می توَس کودی، تُو بَن: اِسی علم دا صرف اللہ یے تُھو، آں تھوئے کا پتہ ہوبھادو قیامت نھیو اَپتُو۔
یقیناً اللہ کأفر آزید لعنت کیژی، آں ہین کأ جلیل اَنگا تیا کیدو،
تِسمی تھیئے مُدام ہاموڑ دھرنین، نأ دا تھیئے سأت پانین نأئی مددگار۔
کامے دی تِھن بوت آنگا می اوَنأ سُونأ گابژنین، تھیئے بنین: افسوس! کو مھوئے اللہ سی اطاعت آں رسول سی حکم منشوو!
آں تھیئے بنین: اے مُھن پروردگار! یقیناً مھوئے تنو سردار آسی آں گھن آسی بات مینی، تھیئے مھو سیدا پَن ما بے پَنا کی۔
اے مُھن پروردگار! تھأئے دوگُن عذاب دے، آں ہأزید گھین لعنت پے۔
اے ایمان والا ہانا! تھأ خلگا سی شانے نہ ہوا کی یأ موسیٰ یے تکلیف آوادوشو، بھی اللہ تیس (موسٰی) تھأ بأدے ما بری کی، کامیک یأ ہیئے خلگے سیوأیدیشی، سے اللہ سی نیز می گھن عزتدا اَشو۔
اے ایمان والا ہانا! اللہ ما بھیا آں سیدا سأس بات کوا۔
تی (اللہ) تُھن اعمال ٹھیک کونین، تُھن گناہ آسی بخانہ کونین، آں کامے ماݜ اللہ آں تِسی رسولؐ سی اطاعت کیو تی تے کامیابی گِھن یأ سے زبردست کامیابی چھی۔
مھوئے مے امانت آسمان آئے آں دھیرین گے آں کھنا سی مُشکے تھیئی دا تھیئے اِسی اُچات کوؤ ما انکار کی، سے اِسما بھیئی، اَسے انسان اِسی پیٹا بھا کی، یقیناً سے گھن ظالم، گھن نہ جنو والا تُھو۔
نتیجہ أ چھی کہ، اللہ منأفق ماݜ آں منأفق ڇھی آئے، (اَںئی ہاموڑ) مشرک ماݜ آئے آں مشرک ڇھی آئے عذاب دینین، مومن ماݜ آں مومن ڇھی آسی توبہ قبول کونین، اللہ بوگوشو والا مہربان تُھو۔
تمام صفت تے اللہ سی کأ تھی تِسی ملکیت می سے ٹول کا یأ آسمانا می تُھو آں کا یأ دھیرین می تُھو، آں آخرت می ہُم تِسی صفت تھی، سے ذات تُھو کآم یأ حکمت سی مالک آں ہر بأت ما شِد تُھو۔
سے تھأ شیئیے ما ہُم جَندوُ کأ یأ دھیرین سی می وا بژدُو، آں تھأ ما ہُم کا یأ دھیرین ما نُوخَدو، آں تِس ما ہُم کا یأ آسمان ما وودُو، آں تِسما ہُم کا یأ آسمان گے اُوخودُو، آں سے گھن مہربان چیر بگوشُو والا تُھو۔
آں کامے خلگے یأ کفر کِیدو سے بَندی: مھو زیت قیامت نہ یینین، تُو بَن: کئی نہ یینین؟ مھی عالم الغیب پروردگار سی قسم! تی ضرور تھو زیت یینین، کی زری سی زرا شیئی تِسی نظر ما دُھو نہ ہودُو، نأ آسمانا می آں نأ دھیرین می، آں نأ اِسما لؤ کی شیئی نأ گھن مھال کی تُھو کہ سے اے کولاؤ کتاب می لِگیل نہ تُھو،
(آں قیامت میلا یینین) تاکہ کامے خلگے ایمان اَندُو آں نیک عمل کِیدی اللہ تھأئے انعام دو، مھال خلگا سی کأ مغفرت چھی آں باعزت رزق چھی۔
آں کامے خلگے مُھن آیادا سی بارہ می مے کوشش کیژی کہ ہأ ناکام سَوے ہین کأ بدترین دردناک عذاب تُھو۔
آں (اے پیغمبرؐ!) کامے خلگائے علم دیا گودُو سے غورا جنَدی کہ تھأزید چھی رَب سی دِشا کا نازل کوا گودُو دا سے حق تُھو، آں سے تے اللہ سی پان پَشادُو کآم یأ اقتدار سی مالک ہُم تُھو صفت سی لیخ ہُم تُھو۔
آں أ کأفر خلک (ایکدویائے) بَندی مھو تھوئے مھالے ماݜ سی پتہ پَشئی سے تھوئے مے خبر دیدُو کہ کے یأ تھو بالکل ریزہ ریزہ ہُوئیو تھوئے دُوآر نیم پئیدائیش می پئیدا ہونین؟
کئی، ای (ماݜ) اللہ زیت لوو سَوات تُو یا ایزیت لیونتوب تھو؟ نأ، بلکہ حقیقت أ چھی کامے خلک یأ آخرت زیت ایمان نہ لَرہ دی سے أمینے عذاب می آں چیر دُھو گمراہی می مبتلا تھی۔
کئی ہیئے خلگے آسمان آں دھیرین نی ڈیڈتی سے ہین مُوش پأش کے خور ہوئیدی؟ کو مھوئے نِمادو ہأ دھیرین وا ڈوب کیئی یا آسمان سی کآں ٹکڑا ہأزیت تھیلی، حقیقت أ چھی کہ اِسمی ہر تے بندہ سی کأ اے نیشانی چھی کآم یأ اللہ سی دِشکے رجوع کوؤ والا تُھو۔
آں یقینا مھوئے داؤد کے خاص تنُو دِیشا فضل دیدوشُو، اے کھنا ہانا! ایسیت تسبیح کوا، آں اے پیݜینا ہانا تھو ہُم، آں مھوئے تِسی کأ چیمو کیمیلی کیشو۔
دَ تُو پورا پورا زرا سَوا، آں کڑا آ سی سَوؤ می اندازہ مقرر کو، آں تھو ٹول نیک عمل کوا، تھو کا عمل یأ کودی آ تیس پَشدُو۔
آں سلیمانؑ سی کأ مھوئے ہوا تابع کیشی، تِسی ڙاد سی سفر ہُم اے ماہ سی اَشُو آں جھیم سی سفر ہُم اے ماہ سی، آں مھوئے تِسی کأ (گلیل؟؟) تامبا سی اوسو جاری کیشُو، آں پیرا می یام سے اَشیئی سے تنُو پروردگار سی حُکم دے تِسی مُوشکے کام کوؤدود، آں (مھوئے تھأ زیت مے بات واضح کِیشی) کہ ہأ می یی مُھن حُکم ما کیل پان اختیار کیو مھوئے تیسکے گرم آنگا سی مزہ چکھانین۔
سے پَیر سلیمانؑ سی کأ کا یأ سے نیموؤدودو سَوؤدُود، اُتھیل اُتھیل شیر، مجسّمہ، تالابا سیم گھن گھن کُوراٹ، اے پوت زیت اِڑی ہوئیل دیگ، اے داؤد سی اولاد! تھو مھال عمل کوا تِسما شکر ظاہر ہوئے، آں مھی بَن آ می مھال خلک کم تھی سے شکر نِیگھالدی۔
بھی کے یأ مھوئے سلیمانؑ سی مئیک سی فیصلہ کی دَ تھأ پَیرائے تِسی مئیک سی خبر دُوئی یی نی دید بلکہ دھیرین سی اے کیمی دید، سے تِسی ہَمسا کھوؤدُود، دَ کے یأ سے لار گا دَ پیر آ ئے معلوم ہُو، کو ہے غیب سی علم جَنودُودو دَ ہیئے مے ذلت سی تکلیف می اَختہ نہ ہونیندے۔
یقیناً سبا سی قوم سی کأ تھین دھرُو سی پوت می اے نیشانی أشی، ہین أوین آں سُوین دُوںئی دِیشائے باغا سی دُو سلسلہ اَشیئی، تنُو پروردگار سی دئیل رزق کھا آں تِسی شکر نِگھالا، وطن غورا تُھو آں پروردگار بگوشُو والا تُھو۔
بھی تھیئے ہدایت ما مُو نرَات، مے وجہ دے مھوئے تھأ زیت بان پھَرؤ والا سیلاب چھوؤ، آں تھأئے تھین دُو باغ مھال دُو باغا می بَدلأت یأ تھأ می بے خوندا میوہ آں غز سی تھام آں دھأک شانہ بیرے اَشیئی۔
مے سزا مھوئے مِسی کأ دید کئیکہ ہیئے ناشکری کِیشی، مھو مھال سزا ناشکرا ما علاوہ دُوئی یس کے نہ دیدی۔
آں مھوئے ہین (علاقہ) آں تھأ خار آ سی درمیان می کِمی یأ مھوئے برکت نازل کیژی (شام سی دھیرین)، مھال خار آباد کِیشی سے دُھو ما نظر ییؤدُود، آں مھوئے تِمی ییؤ بیوُ سی اندازہ مقرر کِیشی، (آں بنُوشُو) ہأ گام آ سی درمیان می دی ہُو کو ڙات امن و آمان دے سفر کوا۔
دَ ہے بنُوسأت اے مُھن پروردگار! مُھن سفر سی منزل آ سی مِیئے دُھو دُھو سی فاصلہ پیدا کو، آں مھامُوڑ ہیئے تنُو اَمن زیت ظلم کی، دَ (تِسی نتیجہ می) مھوئے (ہأ ختم کیدے) ہأ ما قصہ سَوأت، آں مھوئے ہأ ٹوٹا ٹوٹا کیدے خور وور کی، یقیناً اے واقعہ می گھین نِشانی تھی تِسی کأ کآم یأ صوو آں شُکر کودُو۔
آں یقیناً ہأ خلگا سی بارا می ابلیس تنُو خیال سیال کی، دَ ہے خلک تیس پیش ریوان ہُوئی، سیوائے تھأ خلگا ما کآم یأ مومن اَشیئی۔
آں ابلیس سی ہأ زیت کی تسلط نہ اَشُو، البتہ (مھوئے ایس کے گمراہ کوؤ سی صلاحیت مِسی کأ دیدیشی) مھو بُو نیمؤدود کہ کآم تھو می آخرت زیت ایمان اَندُو آں کآم تھو می اِسی بارہ می شک می تُھو، آں چھی پروردگار ہر شیئی زیت نگران تُھو۔
(اے پیغمبرؐ ہأ کأفرائے) بَن! تھو ہگا تھأئے کآم یأ تھوئے اللہ ما سیوا خدا گھنڈیئدی، سے آسمان آں دھیرین می زیری زرا سی شیئی سی مالک نہ تھی، نأ ہأ می آسمان آں دھیرین سی معاملات آ می (اللہ سیت) شراکت چھی آں نأ ہأ می یام اللہ سی مددگار تُھو۔
آں اللہ سی کأش کے کی سفارش کام نہ کوژی سیوائے تے ماݜ سی تِسی کأ أمیدے (اللہ سفارش سی) اجازت دیدو، تھیدیگا پورے کے یأ ہین حی آ می بھیت دھگو کوا بژژی، دَ ہے بَندی: "تُھن ربے کا بنُو؟" سے جواب دیدی کہ "حق بات بینی، آں سے ٹولے ما اُوچات آں چیر گھن تُھو”۔
(اے پیغمبرؐ ہأ ما) توَس کو: سے کآم تُھو سے تھوئے آسمانا ما آں دھیرین ما رزق دیدُو؟ بَن سے اللہ تُھو، آں یقیناً مھو یا تھوئے ما ایک یا دا ہدایت زیت تھی یا کولاؤ گمراہی می مبتلا تھی۔
بَن مھوئے کا جُرم کِیو تِسی بارہ می تھوئے ما توَس نہ ہونین، آں کا یأ تھوئے عمل کِیو تِسی بارہ می مھوئے ما توَس نہ ہونین۔
بَن: مُھن پروردگار مھو ٹول جمع کونین بھی مُھن مِیئے حق تے فیصلہ کونین، آں سے تُھو بہتر فیصلہ کوؤ والا کامل علم والا۔
بَن: مھیئے پَشا دا سے کآم تھی کآم یأ تھوئے اللہ سیت شریک سیوأدے ایپوت کِیدی، یئت ہُم نأ! (تِسی یام ہُم شریک نہ تُھو) بلکہ سے اللہ تُھو تِسی اقتدار ہُم کامل تُھو تِسی حکمت ہُم کامل چھی۔
آں (اے پیغمبرؐ) مھوئے تھأ بُٹ انسان آ سی کأ مھال رسول سیوأدے پیؤدوُ یأ سے زیرے ہُم بُھوژے آں خبردار ہُم کوئے، اَسے زیات خلک نہ جَندی۔
آں ہے خلک (تھیئے) بنَدی: کو تھو سأزال تھیوو قیامت سی وعدہ کے پورا ہونین؟
تُو بَن تُھن کأ مھالے دی سی وعدہ مقرر چھی تِسما اے ساعت سی برابر نأ پیدیدی ہو بھادی آں نأئی مُٹھیدی ہو بھادی۔
آں کامے خلگے یأ کفر کِیدُو سے بنَدی مھو دا نأ مے قرآن زیت یئت ایمان اَنَدی آں نأ (تھأ آسمانی کتابا) زیت کامیک یأ اِسما مُوش اَشیئی، آں کو تُو تے وَخ سی منظر پَشأدے کے یأ ظألم خلگے تنُو پروردگار کے مُخامخ اِڑی کوا بژنین، دَ ہیئے ایکدی آ زیت بات تَھلنین، کامے خلک یأ دُونیئی می کمزور گھنڈا گئی شی تھیئے تھأئے بَننین کآم یأ گھن سَویل اَشیئی: کو تھو نہ اَشیئو مھوئے مومن سَوا بژنیندے۔
کآم یأ گھن سَویل اَشیئی تھیئے تھأئے بَننین کآم یأ کمزور گھنڈا بژودُود: کئی مھوئے تھو ہدایت ما کھمئیشی تِس ما بعد کے یأ ہے تھوئے أپ؟ اَصل بات أ چھی کہ تھو أمینے مجرم اَشیئی۔
آں کآم یأ کمزور گھنڈا بژودُود تھیئے تھأئے بننین کآم یأ گھن سَوا گئیشی: نأ، أ دا تُھن دی و ڙأت سی مُکر اَشُو (تی مھو کھمئیشی) کے یأ تھو مھوئے تاکید کوؤدُود کہ مھو اللہ سیت کفر سی معاملہ کیئی آں تیسیت دأل شریک گھینڈی، آں ہیئے ٹولے کے یأ عذاب پَشنین دا حی می پشیمان ہونین، آں کامے خلگے یأ کفر اختیار کِشُو مھوئے ہین ماڑائے طوق تَھلنین، ہأئے دُوئی کی بأت سی نأ بلکہ تھأ عملا سی بدل دیا بژنین کامیک یأ ہے کوؤدود۔
مھامُو یئت نہ ہُودو یرأ اے گام گے مھوئے خبردار کوؤ والا (پیغمبر) پیؤ دَ تھیت سی مالدا خلگے میس نہ بنُو "تھو یأ کا پیغام سَمانے پیا گئیدی دا تِسی منُو ما مھو انکأری تھی"۔
آں ہیئے بنُو: مھو مال و اولاد می تھأ ما زیات تھی آں مھوئے عذاب دیا نہ بژنین۔
تُو بَن (اے پیغمبرؐ): مھی پروردگار کیس کے یأ نِمادُوو رزق چیری کودُو آں (کیس کے نِمادُو) تینگی کودُو، اَسے زیات خلک نہ جنَدی۔
نأ تُھن مال آں نأئی تُھن اولاد تھو مھوئے نھیئی کودی، ہاں اَسے کی یأ ایمان اَنو آں نیک عمل کی دَ ہال خلگا سی ہین عملا سی دُوچند ثواب میلاؤ ہونین، آں تھیئے جنت سی اُوچات پوت آ می آرام دے دھرنین۔
آں کامے خلک مُھن آیادا سی بارہ می مے کوشش کودی کہ ہأ ناکام کوئن دَ ہأ خلک عذاب می حاضر کوا بژنین۔
تُو بَن (اے پیغمبرؐ): مھی پروردگار تنُو بَنا می کیس کے یأ نِمادُوو رزق چیری کودُو (آں کیس یأ نِمادُوو) تینگی کودُو، آں تھو کا یأ خرچ کودی (اللہ سی پَن می) سے تِسی پوت می دُوئی دیدُو، آں سے ٹولا ما بہتر رزق دیؤ والا تُھو۔
آں تے دی (نہ اَموݜا کے) یأ اللہ بُٹ جمع کونین، بھی مُلیگائے بَننین: کئی أ خلک واقعی تُھن عبادت کوؤدُود؟
تھیئے بننین: مھو چھی پاکی بیان کودی، مُھن تعلق تھیسیت تُھو ہأ خلگا سیت نہ تُھو، دراصل ہے پَیر آ سی عبادت کوؤدُود، ہأ ما زیات خلک تھأ زیت ایمان اَنودُود۔
دَ آش تھوئے می نأ یام یس کے فائدہ اَوؤ سی اختیار لَرہ دُو آں نأ نقصان اَوؤ سی، آں کامے خلگے ظلم کیشُو تھأئے مھوئے بننین: تے آنگا سی مزہ چکھا کامیک یأ تھو لَوو گھنڈودُود۔
آں کے یأ ہأئے مُھن واضحہ آیات بیندے بُھویا بژدی دَ ہے بنَدی: "ہے مھال ماݜ تُھو نِمادُو تھو تھأ معبودے ما کھمے تھین عبادت یأ تُھن بوپ داد کِیژی"، آں ہے بنَدی "أ قرآن کی ہُم نُو تُھو بس اے سَویل لوو تُھو"، آں کے یأ ہأ کأفر آ ئے حق سی پیغام آپ دَ ہیئے تِسی بارہ می بنُو: أ دَ اے کولاؤ جادُو ما علاوہ کی نُو تُھو۔
حالانکہ مھوئے ہأئے مُوش نأ مھال کتاب دیدتی کامیک یأ ہے بَندی، آں نأ تھأما مُوش مھوئے ہین کأشکے یام خبردار کوؤ والا (اے پیغمبر) پیؤدُو۔
آں ہأئے ما مُوش ہُم خلگے (پیغمبر) لوو گھنڈئیشی آں أ (عرب سی مشرک) دَ تے سازوسامان سی دَشم حصہ ئے ہُم نہ آوودی کامیک یأ مھوئے (مُشیم خلگائے) دیدُوشُو، بھی ہُم تھیئے مُھن پیغمبر لوو گھنڈی (دَ تُو بُو) مھی دیل سزا کھیدیک سخت أشی۔
(اے پیغمبرؐ) ہأئے بَن! آ تھوئے صرف اے بأت سی نصیحت کودُو، سے أ چھی کہ تھو دُو دُو میلاؤ ہیدے یا اَمن سیت اللہ سی خاطر تے اِڑی ہوا، بھی (انصاف تے) سوچ کوا کہ تُھن سأت (محمدؐ) می لیونتوب سی کی بات نی چھی، ہے دَ اے سخت عذاب ییؤ ما مُوش تھو خبردار کوؤ والا تُھو۔
(اے پیغمبرؐ) بَن: مأ کو مے بأت زیت تھو ما کی اَجر نِمادتُو سے تُھن ہُو، مھی اَجر تا اللہ ما بغیر یِسی ذمہ زیت نُو تُھو، آں سے ہر شیئی ما شِید تُھو۔
تُو بَن: مھی پروردگار حق با آ پیدُو، سے غیب سی ٹول بأدے ما جَنُو والا تُھو۔
تُو بَن: حق اَپ تُو آں باطل می نأ دا کی شروع کوؤ سی دَم چھی آں نأئی دُوبارہ پیدا کوؤ سی۔
تُو بَن: کو آ پَن ما پݜلیل تُھو دَ مھی پݜلُو سی نقصان مھی ہونین، آں کو مأ سِیدا پان پأدچی دَ ہے تے وحی سی وجہ دے چھی کامیک یأ مھی رَب مھیزیت نازل کودُو، یقیناً سے ہر کی بّھویو والا ہر ایک کے نھیو تُھو۔
(اے پیغمبرؐ تھیئے ہین حالت عجیبہ نظر ینین) کو تُو تے منظر پَشأدے کے یأ ہیئے بھیل بھیل گئینین، آں ڈیؤ سی کی پان نہ ہونین، آں ہیئے نھیو ما گݜا بژنین۔
آں (تے وَخ می) ہیئے بَننین: مھوئے ایزیت ایمان آنودُو، حالانکہ مھیدیک دُھو پوت ما اَوؤ (ایمان گے) کھأکأ ہونین۔
آں مُوش تا ہے تیزما انکار کوؤدود، آں دُھو ما گمان سی تیر (غشے) تَھلودُود۔
آں اے وَخ می ہے کامے (ایمان) سی ارمان کودی دا تِسی آں ہین مِیئے اے پردہ تھلا بژنین، کھأکأ یأ ہین ہال مُشیم خلگا سیت ہُم مھامُوڑ کوا گأئی، حقیقت أ چھی کہ ہے ٹول مھالے شک می بژیل تھی کہ تی ہأ دوکا می تھلیئی دی۔
بوڑ صفت خاص اللہ سی کأ تھی، پیدا کوؤ والا تُھو آسمانا سی آں دھیرین سی، سوأدتی مُلیک سوال جواب اَوؤ والا، پݜأل والا دو ڇا ڇا چَؤ چَؤ، چیری کودو پیدائش می کا یأ سے نیمادو، یقیناً اللہ ہر شیئی زید قادر تُھو۔
کا یأ کولاؤ کودو اللہ خلگا سی کأ تُنو رحمت، دَ یام بان کوؤ والا نہ تُھو تیس، آں کا یأ سے بان کؤسأدو یام کولاؤ کوؤ والا نُو تُھو تیزما بعد، آں سے زوروڑ تُھو حکمت والا
اے خلک ہانا! یاد کوا نعمت اللہ سی اَمن زید، اَیا یام پیدا کوؤ والا تُھو اللہ ما سیوا، روزی دو تھوئے آسمان ما آن دھیرین ما؟ نُو تُھو یام عبادت سی لائق سیوائے اللہ ما، کامے ڈھأر کے گئیل روان تھی؟
آں ہے تھأ لووال گھندی، یقیناً لووال گھنا گئیدی پیغمبر تھأ ما موش، آں اللہ سی دیشکے واپس کوا بژنین بوڑ کم۔
اے خلک ہانا! یقیناً وعدہ اللہ سی سأس چھی، دوکہ وا نہ تھلے تھو جیدون دونیئی سی، آں دوکا وا نہ تھلے تھو اللہ ما، دوکہ باز (شیطان)۔
یقیناً شیطان تُھن دشمن تُھو، تھو ایس دشمن گھنا، یقیناً ہے ہگادو تُنو ڈلہ یے، مِسی کأ یأ ہون ہے دیزوخ والا۔
کامے خلگے یأ کفر کیدو ہین کأ سَخ عذاب تُھو، آں کامے خلگے یأ ایمان اَنو آں نیک عمل کی، تھین کأ بگوشو تُھو آں گھن اَجر تُھو۔
کئی (تے ماݜ سی کا ہونین) کیس کے شیژیئی کواگا تِسی خراب عمل، آں تی ڈیڈ تیس غورہ؟ یقیناً اللہ گمراہ کودو کیس یأ نیمادو، آں ہدایت دیدو کیسکے یأ نیمادوو، دَ نہ بژے چھی سا ہأزیت افسوس تے، یقیناً اللہ جندو کا یأ ہے کودی۔
اللہ سے ذات تُھو پیدو بیلأئی، سے (بیلأئی) بھا کوژی لڑے، مھو روان کودی ایس (لڑے) مئیل خار سی دِشکے، بھی مھو جینی کودی ایدے دھیرین پأش ایسی مئیک ما، اَںئی ہاموڑ تُھو دُوآر بھا ہوؤ۔
کآم نیمادو عزت، دَ خاص اللہ سی کأ چھی بوڑ عزت، اِسی ڈھأر کے اُخودی بأت پاک، آں عمل نیک، بھائے اُوچات کودو ہے، آں کآم خلک یأ تدبیر کودی لاݜ، ہین کأ تُھو عذاب سخ، آں تدبیر ہأ خلگا سی برباد تُھو۔
آں اللہ پیدا کی تھو سُم ما، بھی نطفہ ما، بھی سوأد تھو جوڑا جوڑا، آں حاملہ نہ ہوئی جَوئ، آں نأ جیائی مگر علم می ہودو اِسی، آں نأ ݲِگ اُمو والائے اُمو دیا بژژی چیر، آں نأ کم کوا بژژی اِسی اُمو ما، مگر ہے کتاب می دیل تُھو، ہے کام اللہ ئے آسان تُھو۔
آں نی تھی برابر دو دریاب، ایک میٹ تُھو تِݜ لھاسُو والا، آں دُوئی تُھو لونگن ٹیٹ، آں ہر ایک ما تھو کھادی (ماش آ سی) ماس تازہ، آں نِگھلدی تھو کا یأ لھادی تھو (کالئی)، آں تھو پشدی کشتی اِسمی پھراژی اُو، مِسی کأ یأ تھو لوٹا فضل ایزما (رزق)، آں مِسی کأ تھو شکرگزار سوا بَیا۔
سے داخل کودو ڙات دی می، آں داخل کودو دی ڙأت می، آں کم می ݜژأدتی سی و یُن، ہر ایک روان تُھو اے مقررہ وخ آ پورے، ہے تُھو اللہ، تُھن پروردگار، خاص اِسی بأچیئی چھی، آں کیس کے یأ تھو ہاگادی اللہ ما سیوا، نی تھی سے مالک خورما سی أنی سی پَٹھل سی۔
کو ہاگادی تھو ہأئے، نو بُھوژدی ہے ڇاڑ تُھن، آں کو بودو ہُم جواب نہ دے بھادی تھوئے، آں قیامت سی دِیے انکار کونین تُھن شِرک ما، آں خبر نہ دینین تھوئے باخبر اللہ سی چَھلے۔
اے خلک ہانا! تھو مُتاز تھی اللہ یے، آں اللہ بے پرواہ تُھو، ہر صفت سی أمیدے مستحق تُھو۔
کہ سے نیمؤسأدو ختم کوئے تھو، آں آنے نیم مخلوق،
آں نُو تُھو اللہ یے أ کام بُوکھو
آں اُوچات نو کونین اُوچات کوؤ والا بوج دوئی سی، آں کو ہاگادُو کآم بوج بھا کوؤ والا تُنو بوج سی بھاکوؤ سی کأ، بھا نو کوبھانین اے بوج ما کی ہُم، اگر کہ ہے تُنو اَشو (رشتہ دار نھیو چیر زیات)، (اے پیغمبرؐ!) یقیناً تو بھیادُو تھأ خلک یأ سے بھیدی تُنو رب ما غیبی (بے پشو ما)، آں قایم کودی نماز، آں کآم یأ پاک ہُوؤ یقیناً ہے پاکی اِسی تُنو کأ چھی، آں خاص اللہ یے واپس بژو تُھو۔
آں برابر نہ تھی اَن و پشُو والا،
آں نأ أنچیک و لوش،
آں نأ چیژول و گیریمی
آں برابر نی تھی جَن و مئیل، یقیناً اللہ بھویادو کیس کے یأ نیمادوو، آں نُو تُھو بُھویو والا کآم یأ قوَر آ می تھی۔
نُو تُھو تو مگر بھیؤ والا
یقیناً پیودو مھوئے تھأ حق سمانے، زیرے دیؤ والا آں بھیؤ والا، آں نی چھی اے اُمت کہ لھنگودو تیمی بھیوُ والا۔
آں کو ہیئے لووال گھنُو تھأ، یقیناً لووال گھنیئشی تھین خلگے ہُم ہأما موش، اَئیشی ہأئے پیغمبر ہین اخکارہ نَخے سمانے، آں صحیفہ آسمانی، آں کتاب روخانہ سمانے
بھی گأد مأ تھأ خلک یأ کافر تھی، بھی کھال اَشو مھی عذاب!
کئی تأ نی ڈیڈ، یقیناً اللہ مُوژادو آسمان ما اُو، بھی مھوئے نِگھلیئی تیدے میوہ ڙانگ ڙانگ آ سی؟ آں کھن آ می ڙِنگ تھی اُژیل آں لگھیر، قسما قسم ڙانگ آ سی، آں کݜن کاک تھی دھأک۔
آں یام خلک آں زیناور آں څاروئی آ سی ہُم ڙانگ زأن زأنی تھی، اَںئی ہاموڑ یقیناً بھیدی اللہ ما اِسی بندائے ما علماء، یقیناً اللہ زوروڑ تُھو بوگوشو والا۔
یقیناً کآم خلک تلاوت کودی اللہ سی کتاب سی، آں نماز گوزادی، آں خرچہ کودی تے مال ما کا یأ دیدتُو مھوئے ہأئے، بیرید آں اَخکارہ، ہے اُمید ساتَدی تجارت سی یئت ہُم برباد نہ ہونین،
مِسی کأ پورا دیا بژے ہأئے اَجر ہین، آں زیات دیا بژے ہأئے تُنو فضل ما، یقیناً اللہ بوگوشو والا قدردان تُھو۔
آں کا یأ مھوئے وحی کی چھی ڈھأر کےکتاب (قرآن)، ہے حق تُھو، تصدیق کوؤ والا تِسی یأ موش اِیزما تُھو، یقیناً اللہ تُنو بندہ آ ما شید تُھو، پشو والا۔
بھی مھوئے میرأثی سوأد کتاب سی تھأ خلک، کاریئی مھوئے تُنو بَن آ ما، دھأک ہأمی تُنو اَمن زید ظلم کوؤ والا تھی، آں یام ہأمی درمیانہ تھی، آں یام ہأمی مقابلہ کوؤ والا تھی نیگی آ می اللہ سی حکم دے، اَںئی ہے گھن فضل تُھو ۔
باغ تھی ہأمی دھرُو سی کأ، ہیئے لھنگنین تھأئے، لھیانین ہأزید اِسمی بنگڑئی لھگور زر سی آں ملغلرے، آں کوژو ہین اِسمی ہونین أشیم سی۔
آں بننین ہیئے: بوڑ صفت اللہ سی کأ تھی، سے ذات تُھو کی یأ دُھو کی مھوئے ما غم، یقیناً رب مُھن چیر زیات بوگوشو والا تُھو، قدردان
(اللہ) سے ذات تُھو کی یأ مھوئے شیر ہمیشہ دھرو والا دید تُنو فضل دے، نأ اَوونین اِسمی مھوئے کی تکلیف، آں نأئی اَوونین اِسمی مھوئے کی پشیمانی
آں سے خلک یأ کأفر تھی، تھین کأ آنگا ہونین دیزوخ سی، نأ یے نین ہأزیت کی فیصلہ یأ مئیک یو، آں نأئی کم کوا بژنین ہأما عذاب تھین، اَںئی ہاموڑ مھو سزا دیدی ہر ناشکر کے۔
آں ہیئے چیگأ نیگھلنین اِسمی، اے مُھن پروردگار! نیگھل مھو (دیزوخ ما)، عمل کیئی مھو نیک، بغیر تِسما یأ مھو کوؤدود، (تھأئے جواب دیا بژنین) اَیا مھوئے اُمو نی دیدیشی تھوئے، نصیحت حاصل کونین دے تِسمی، کآم یأ نصیحت حاصل کوؤ نیمؤدوو؟ آں اَوؤشو تھوئے بھیو والا، (مھیرے مزہ) چکھا، نو تُھو ظألما سی کأ یام مدد کوؤ والا۔
یقیناً اللہ جنو والا تُھو آسمان آ سی آں دھیرین سی غیب ما، یقیناً غورہ جنَدو حی سی راز ما
(اللہ) سے ذات تُھو، سوأدتی تھو قائم مقام دھیرین می (مُوشک خلگا سی)، کی یأ کفر کیدوو تِسی کفر (سی نقصان) تیزید تھا بژنین، آں کأفر آ سی کأ تھین کفر چیری نہ کودو مگر تھین رب سی غضب، آں کأفر آ سی کأ تھین کفر چیری نو کودو مگر گھن نقصان۔
(اے پیغمبرؐ!) ہأئے بَن، اَیا تھوئے ڈیڈتی تُنو شریک، کِسکے یأ تھو ہاگادی اللہ ما علاوہ؟ پشا مھیئے کا شیئی پیدا کیدو تھیئے دھیرین می؟ یا ہین کی شرکت چھی آسمان (آ سی پیدائش) می؟ یا دیدتُو مھوئے ہأئے کتاب، یأ تیمی لردی ہے اَخکارہ دلیل؟ بلکہ وعدہ نہ دیدی ظألم ایکدی آ ئے مگر دوکا۔
یقیناً اللہ گأدتی آسمان آں دھیرین یأ ہے نہ پھرگن، آں کو ہے پھرگئیو یام نو تُھو تیما پأش ہین گݜو والا، یقیناً اللہ صوو والا بوگوشو والا تُھو۔
آں ہے قسم کھوؤدود اللہ زید، چیر زیاد تنو پوخ قسم، کو آبو بھیؤ والا (پیغمبر) خامخا ہونین ہیئے زیاد پان پوؤ والا ہر اُمت ما، بھی کے یأ آپ ہأئے بھیؤ والا، دَ چیری نی کی ہأ مگر (ہین) نفرت،
دھیرین می اَمن گھن گھندی، آں تدبیر کی لاݜ، نہ بژدو تدبیر لاݜ مگر اِسی کوؤ والائے، ہے انتظار نہ کودی مگر طریقہ موشوک خلگا سی، دَ یھید ہُم نہ پانین تأ اللہ سی دستور مے کی بدلُن، آں یھید ہُم نہ پانین تأ اللہ سی دستور می کم زیاد والے۔
اَیا ہے نہ گئیدی دھیرین می، ہے پشندے کھأکأ ہُو انجام تھأ خلگا سی یأ موش اَئیشی ہأما؟ آں اَشیئی سے چیر سخ ہأکیژا طاقت می، آں نہ تُھو اللہ ہاموڑ عاجز کوئے تیس کی شیئی آسمان آ می آں دھیرین می، یقیناً اللہ پوھہ تُھو قدرت والا۔
آں کو گأدیشی اللہ خلک ہین عملے دے، نہ چھونیندے دھیرین زید سا سی شیئی، اَسے نیٹہ دیدو اے مقررہ وخا پورے، دَ کے یأ آبو مقرر وخ ہین، یقیناً اللہ تُھو تُنو بندا زید پشو والا۔
یٰس!
حکمت ما ڈک قرآن سی قسم!
یقیناً تو پیغمبرے ما تُھو
بالکل سیدا پَن دے!
أ (قرآن) تے ذات سی دِشا نازل کوا بژدُو کآم یأ کامل اقتدار والا، بے حد مہربان تُھو،
میلائی تو تھأ خلک خبردار کو کِھین بوپ و داد موش بھیا نہ گئیشی، کھأئیمو سے غفلت می بژیل تھی۔
حقیقت أ چھی کہ ہأمی اکثر خلگا سی بارا می (سزا سی) بات ثابت ہیژی، کھأئیمو ہے ایمان نہ اَندی۔
مھوئے تھین ماڑ آئے طوق تھلئیدی یأ تھین ہأریݜ آئے اَوئیدی، دَ تِسی وجہ دے تھین ݜا بھا ہوئیل دھرئیدی۔
آں مھوئے اے ڈاپ تھین موشکے آں اے ڈاپ تھین پأشکے اِڑی کیدُو، دَ تھأ (مھاموڑ) برأدتی یأ سے کی نہ پشدی۔
آں تھین کأ دوںئی بأت برابر تھی، تو تھأ خبردار کو یا خبردار نہ کو، تھیئے ایمان نہ اَننین۔
تو دا صرف مھال ماݜ خبردار کوبھادُو کآم یأ خونہ زید تِلے، آں خدائے رحمٰن ما بے پَشوآ بھیے، دَ تو ہال ماݜ کے بگوشُو سی آں عزت والا اَجر سی زیرے دے۔
یقینًا صرف مھوئے مئیل جینی کونین، آں کامے عمل تھیئے مُوٹھائے پیئیدی مھو تھأ ہُم لِگا ییدی، آں تھین عملا سی کامے اثرات تھی دا تھأ ہُم، آں مھوئے اے واضحا کتاب می ہر ہر شیئی پورا پورا لِگدُو۔
آں (اے پیغمبرؑ!) تُو ہأئے مُوشک اے گام والا آ سی مثال دے، کے یأ تھین کأشکے پیغمبر اَئیشی۔
کے یأ مھوئے تھأپیش دو پیغمبر پیئی، دَ تھیئے تھأ دوںئی پیغمبر لووال گھنیئی، بھی مھوئے اے ڇُوئی (پیغمبر) سی زریعا دے (تھأ) مضبوط کی، آں تھیئے ٹولے بنُو کہ: یقین کوا، مھو تُھن دِشکے پیغمبر سیوأدے پیا گئیدی۔
تھیئے بنو: تُھن حقیقت سیوائے میما دوئی کی ہُم نی چھی کہ تھو مُھن شانے انسان تھی، آں خدائے رحمٰن کی ہُم نازل نہ کیدو، آں تھو سراسر لوو سوادی۔
تھیئے (پیغمبرے) بنو: مُھن پروردگار کے معلوم تُھو کہ مھو واقعی پیغمبر سوأدے تُھن دِشکے پیا گئیدی۔
آں مھوزید تا صرف (رب) سی پیغام صفا صفا اَوؤ تُھو۔
(گام سی خلگے) بنو: مھو دا تُھن اَندرے (کآں) اِسپوراچا پشدی، یقین کوا، کو تھو اے بأت ما قلار نُو ہوئیو مھوئے تھوزید باڑ موژانین، آں مھو ما تھوئے چیر تکلیف والا عذاب میلاؤ ہونین۔
(پیغمبرے) بنو: تُھن اِسپوراچا تھوسید ݜژیل تُھو، اَیا تھو ہأ ہأت کھأئیمو کودی کئیکہ تھوئے نصیحت کوا گیژی؟ اَصل بات أ چھی کہ تھو أمیدے حد ما نُوخیل خلک تھی۔
آں خار سی آخری علاقہ ما اے ماݜ دھأںئی دیل اَپ، تی بنو: اے مھی قوم سی خلگا ہانا! مھأ پیغمبرا سی بات بُھوژا!
تھأ خلگا سی بات بُھوژا کآم یأ تھوکیژا کی دأڑی نی نیمادی، آں سے سیدا پَن دے تھی۔
آں آ کئی تے ذات سی عبادت نہ کیئی کی یأ مھأ پیدا کیدو دا، آں تِسی ڈھأر کے تھو بُوڑائے واپس بژو تُھو؟
کئی آ تیس چھیدے مھال خدا گیݜی کہ خدائے رحمٰن کو مھیئے کی نقصان سی دیؤ سی ارادا کیو نأ تھین سفارشے مھی کی پکار یینین، آں نأئی تھیئے مھأ بچ کو بھانین؟
کو مأ ہاموڑکیو یقینًا مأ واضحا گمراہی وا بژنین۔
مأ دا تُھن پروردگار زید ایمان آنودو، مھیرے مھی بات بُھوژا۔
(گام سی خلگے تیس موؤ، آں اللہ سی ڈھأرا تیس کے) بنا گا کہ جنت کے لھنگ، تی (جنت سی نعمت پیشتے) بنو: کہ افسوس! مھی قوم دے معلوم ہوئے دے،
کہ مھی پروردگار مھأ بگوشودُو، آں مھأ عزت دا خلگا می شامل کیدو۔
آں تے ماݜ ما بعد مھوئے تِسی قوم زید آسمان ما کی لخکر نہ وألی، آں نأئی مھوئے والو سی ضرورت أشی۔
سے دا بس زور سی اے چگا أشی تیندے سے ٹول نِشتے گئی۔
افسوس تُھو ہال بَن آ سی حال زید! ہین کأشکے اے پیغمبر ہُم مھال نہ اَپتو کیس پیش یأ ہیئے پشاڑے نی کیژی۔
کئی تھیئے نی ڈیڈ کہ تھیئے ما موش مھوئے کھیدیک قوم مھاموڑ تباہ کیدی کہ سے تھین دِشکے واپس نہ ییدی؟۔
آں أ کھیدیک خلک تھی دا ہأ ٹول جمع کیدے مُھن موش کے حاضر کوا ہژنین۔
آں ہین کأ اے نخ سے شُگیل دھیرین أشی، مھوئے تیس جینی کی، آں تیما پھیل نگھألی، دَ تیما ہے کھادی،
آں مھوئے تے دھیرین می خورما آں دَݜ سی باغ پیدا کی، آں تیما مھوئے اوسو نِگھالئی۔
تاکہ ہے تِسی پیداوار آں میوائے ما کھئن، حالانکہ ہأ تھین ہادے نہ سوأدیشی، کئی بھی ہُم ہیئے شکر نہ کونین؟۔
پاک چھی سے ذات کی یأ ہر شیئی سی جوڑا پیدا کیدُو، تے پیداوار سی ہُم کامیک یأ دھیرین ما ہودُو، آں انسانا سی ہُم، آں تھأ شیئی آ سی ہُم کامیک یأ ہے خلک (مھیرے) پیأندی ہُم نأ۔
آں تھن کأ اے دوئی نخ ڙات چھی، مھو تیما دی ݲھیگ دیدے نگھالدی، دَ ایک دم سے أنچک دھردی۔
آں سی تنو ٹھکانہ سی دِشکے مُوآ ریوان چھی، ہے بڑ تے ذات سی مقرر کویل نظام تُھو کآم یأ زبردست غلبہ والا کامل علم والا تُھو۔
آں یُن گے ہُم مھوئے منزل مقرر کیدی، مے حدا پورے کہ سے کے یأ (تھأ منزلا سی دورہ ما) واپس أبو سے خورما سی پُرأن لأر سی چَھلے (چینی) ہیدے بژژی۔
نأ دا سی سی وَس می تُھو کہ سے یُن بیشتے گݜے، آں نأئی ڙات دی ما مُٹھیدی ہوبھائی، آں ہے ٹول تُن تُنو دائر آ می پِشدی۔
آں تھین کأ اے نخ أ تُھو کہ مھوئے تھین اولاد اے ڈک کشتی زید سور کیشو۔
آں مھوئے تھین کأ اَںئی تھال دأل شیئی ہُم پیدا کی کسی یأ ہیئے سورلی کودی۔
آں کو مھوئے نِمؤسأدو تھأ غرک کیئی، نأ دا بھی یی تھین فریاد کے اووبھانین نأئی تھیئے بچ ہوبھانین۔
اَسے أ بُٹ مُھن ڈھأرا اے رحمت چھی، آں اے مقرر ساعت آ پورے (جیدون ما) مزا گھینو سی موقع تُھو۔
آں کے یأ تھأئے بنا بژدُو کہ: بچ ہوا اے (عذاب) ما کامیک یأ تُھن مخامخ تُھو، آں کامیک یأ تھوئے (مئیک ما) بعد ہونین تاکہ تھوزید رحم کوا بژے (دَ سے ہاڈو کان نہ تھادی)
آں تھین پروردگار سی نخا می مھال اے نخ نہ ہودُو یأ تیما سے منہ نہ نُڑادی۔
آں کے یأ تھأئے بنا بژدُو کہ: اللہ یأ تھوئے کامے رزق دیدتُو دا تیما خرچ کوا، دَ أ کأفر خلک مسلمانائے بندی کہ: کئی مھو تھأ خلگا زید کھیئی یأ اللہ نیمادُوشوو أمیدے کھیانندے؟ (مسلمان ہانا!) تُھن حقیقت تہ صرف أ چھی کہ تھو کولاؤ گمرائی مے بژیل تھی۔
آں بندی کہ: می (قیامت سی) وعدہ کے پورا ہونین؟ (مسلمان ہانا!) بنا کو تھو سیاز بن تھئیو۔
(اصل می) أ خلک بس اے چگأ سی انتطار کودی، کی یأ اچانک ییدے ہأ گݜنین، کے یأ ہیئے ایکدی سیت پݜژیل ہونین۔
بھی ہیئے نأ کی وصیت کوبھانین نأئی تنو شیر والا سی کأنگے واپس بش بھانین۔
آں بیشل بھاہژنین دا ہیئے ایک دم تُنو قوَرے ما نِختے تُنو پروردگار سی دِش کے تیزی دے دھأںئی دینین۔
(تھیئے) بننین، ہائے مُھن کمبختی! مھو کی مُھن ہُوبو سی پوت ما بھا کیدی؟ (جواب میلاؤ ہونین کہ): أ اَںئی سے شیئی تُھو کسی یأ خدائے رحمٰن وعدہ کیشی، آں پیغمبرے سأس بات بینیشی۔
آں دوئی کی نأ بس اے زور سی چگا ہونین، تیما بعد ہیئے بوڑے مُھن مخامخ حاضر کوا بژنین۔
بس تے دِیئے یزیت کی ظلم نہ ہونین، آں تھوئے دوئی کی شیئی سی نأ بلکہ تھأ کما سی بدل میلاؤ ہونین کامیک یأ تھو کوؤدودتہ۔
جنت والائے یقیناً تے دِیئے مغشولا می خوشحال ہونین۔
تھیئے آں تھین ڇھیئے چیژولا می صوفہ آ زید ڈو دیدے آرام دے بھژیل ہونین۔
تھیت تھین کأ میوائے ہونین، آں تھأئے ہر تی شیئے میلاؤ ہونین کا سے نیمؤسأدو۔
رحمت والا پروردگار سی ڈھأرا تھأئے سلام بَنابژنین۔
آں (کأفرائے بنابژنین کہ) اے مجرم ہانا! آش تھو (مومنا ما) جُدا ہوا!
اے آدمؑ سی اولادی! کئی مأ تھوئے مے بأت سی تاکید نی کیشو کہ تھو شیطان سی عبادت نہ کوا، سے تُھن کولاؤ دشمن تُھو۔
آں مے بات سی کہ تھو مھی عبادت کوا، اَںئی أ سیدا پان چھی۔
آں حقیقت أ چھی کہ تی (شیطان) تھوما چیرگن خلک گمراہ کیدی، دَ کئی تھو جَنَدی نأ؟
أ چھی سے دیزُوخ کِما یأ تھو بھیا بژودُود!
آش ایسکے لھنگا، کئیکہ تھو کفر کوؤدود۔
آش سی دی مھوئے تھین أں آ زید مہر ݜَژانین، آں تھین ہادے مھوزید بأت کونین، آں تھین کُھوئے گواہی دینین تھأ کما سی کامیک یأ سے کوؤدود۔
آں کو مھوئے نمادو (مھیت دُونیئی می) تھین أݜی (آ سی نظر) نَھئی، بھی تھیئے پَن (سی بھرڑو) می دھأںئی دین پِشنین اَسے تھیئے کھیت پان پَشنین؟
آں کو مھوئے نمادو تھین تُنو پوت آ زید (بھژیل بھژیل) تھین شکل آ سی نخ ختم کیئی، بھی تھیئے نأ مُشکے بش بھانین نأئی واپس نُڑبھانین۔
آں مھوئے یسکے چیر عمو دیدو تیسی پیدائش سی اعتبار تیس اُلٹا کودی (یعنی تِسی حالت لَوّ آ سی چھلے کودی) دَ بھی ہُم تھأئے عقل نہ یے یی؟۔
آں مھوئے (تنو پیغمبر) کے شعر و شاعری نی ڇھیڙأد چھی، نأئی سے (شاعری) تِسی شان سی لایٔق چھی، أ دا بس اے نصیحت چھی، آں مھال قرآن یأ حقیقت واضحا واضحا بیان کودُو۔
تاکہ ہر ماݜ بھیے کآم یأ جَن تُھو، آں تاکہ کفر کوؤ والا زید بات پورا ہوئے۔
کئی تھیئے میس کے نہ بودُو کہ مھوئے تُنو ہات سی سویل شیئیے ما تھین کأ څاروئی پیدا کی، آں ہے تھین مالک ہوئیدی؟
آں مھوئے تھأ (څاروئی) تھین قابو می دِیدتی، دَ تھأمی یام دا مھال تھی یأ تھین سورلی چھی آں یام مھال تھی یأ تھأ سے کھادی۔
آں تھأئے تھأ څاروئیے ما دأل ہُم فائیدہ میلاؤ ہودی آں پو سی شیئی میلاؤ ہودی، کئی بھی ہُم ہیئے شکر نہ کونین؟
آں تھیئے اللہ چھیدے مے اُمیدتے دیأل خُدا سیوأدتی کہ ہأئے (تھیئے ما) مدد میلاؤ ہونین۔
(اَسے) سے ہین مدد کوؤ سی وَس نہ لَردی، بلکہ تھیئے ہین کأ مھال اے (مخالف) لخکر سوا بژنین یأ ( قیامت سی دی تھین مُشکے) حاضر کوا بژنین۔
دَ تھلا (اے پیغمبرؑ!) تھین بأت تھأ خپا نہ کوئن، یقین کو مھوئے ہر کی معلوم تُھو کا یأ سے بُرادی آں کا یأ اَخکارا کودی۔
آں کئی انسان میس کے نہ بُو کہ مھوئے تیس نطفہ ما پیدا کیشو؟ بھی سے اچانک پَشژُو والا سَوا گا۔
مُھن بارا می ہے بأت سوادُو آں تُنو پیدائش تی أمیݜیژی، بندو کہ: "مھأ ہَر دوآر کی جینی کونین کے یأ ہے ڇیگی ہیدے ختم ہوئیو؟"۔
بَن کہ: ہأ تی جینی کونین کی یأ اول گونا ہأ پیدا کیشی، آں سے پیدا کوؤ سی ہر کم ما شِید تُھو۔
(اللہ) سے ذات چھی کی یأ تُھن کأ نِل تھامے ما اَنگا پیدا کی، بھی تھو تیما دھأک ساعت می اَنگا جالدی۔
دَ کامے ذات یأ آسمان و دھیرین پیدا کیدی، کئی سے مے بأت زید قادر نُو تُھو کہ تھین تھال (دوآر) پیدا کوے؟ کئی نأ؟ حالانکہ سے ہر کی شیئی سی پیدا کوؤ سی پورا مہارت لَردو۔
تِسی کام دا بس أ تُھو کہ کے یأ تی کی کم سی ارادہ کیو صرف مھیدیک بندُو کہ: ہو، بس سے ہودُو۔
بس پاک چھی سے ذات کسی ہات می یأ ہر شیئی سی حکومت چھی آں اَںئی تِسی دِشکے تھوئے ٹولے واپس کوا بژنین۔
قسم تُھو پرا (صف) سوؤ والا (مُلیکا) آ سی کے یأ سے پرا سوادی۔
بھی تِھین قسم کآم یأ قارا بژدی۔
بھی تِھین (قسم) کآم یأ ذکر (یعنی قرآن) سی تلاوت کودی۔
بےشکہ تُھن معبود بس ایک تُھو۔
کآم یأ بُٹ آسمان آ سی آں دھیرین سی آں تِھین مِیئے ہر شیئی سی مالک تُھو، آں تھأ بُٹ سی نوخین آ سی (مشرق آ سی) مالک (کھیدا یأ تا نُخدی دا)۔
بےشک مھوئے دُونیئی سی آسمان (نھیو آسمان) تا آ سی شیژواچا دے شیژیئی کِیدُو۔
آں ہر ماغیڑ (یاغی/سرکش؟) شیطان ما حفاظت سی زریعا سَوات تُو۔
سے اُوچات ملیکا آ سی بأت نہ بھوش بھادی، آں ہر ڈھأرا ہین دک دیا بژدی۔
(سے) ݜگا بژدی، آں (آخرت می) تھأئے ہمیشہ سی عذاب ہونین۔
ہاں کو یی ایک اَر بات بُرأدو تھأ پیش اے لگھور لام ݜژدُو۔
مھیرے ہأ (کأفرے) ما توَس کو کہ: ہین پیدا کوؤ چیر بُوکھو تُھو یا مُھن پیدا کویل دأل شیئی (مخلوق)؟ مھوئے ہأ (انسان) لیئ والا خٹا (ماٹ سُم؟) ما پیدا کیدی۔
(اے پیغمبرؐ! حقیقت أ چھی کہ ہین بأدا زیت) تُو حان تُھو، آں ہے (آخرت زید) پشاڑے کودی۔
آں کے ہأئے خونہ کوا گاو تیز حی دے نہ مَنَدی۔
آں کے کی نشأنی ڈِیڈو پشاڑے کودی۔
آں بندی کہ: أ اے صفا جادو ما علاوا دُوئی کی نُو تُھو۔
کئی کو مھو مُوئیو، سُما سُم ہوئیو، صرف ہَر دھریو، دوآر جینی کوا بژنین؟
آں مُھن مُٹھک لھنگیل بوپ داد ہُم؟
بن کہ: ہاں! آں تھوئے ذلیل ہُم ہونین۔
بس تی دَ صرف اے تیز آواز ہونین تیما بعد تھیئے (أمیدے تے منظر) پَشنین۔
آں تھیئے بننین: ہائے مُھن (بدبختی)! أ دَ حساب کتاب سی دی تُھو۔
أ اَنئی تے فیصلہ سی دی تُھو کامیک یأ تھو لوو گھنودُوت۔
(ملیکا آئے بنا بژنین) گیݜتے ٹول آنا، کیئے یأ ظلم کیشو، آں تھین سأت، آں تھأ معبود ہُم کِسی یأ ہے عبادت کؤدُود،
اللہ چھیدے، بھی تھأئے دیزوخ سی پان پشا۔
آں ہأ دھأک اِڑی کوا، ہیئے ما توَس ہونین،
تھوئے کژَل ہیژی یأ تھو ایکدوئی سی مدد نہ کودی؟
بلکہ ہے دا آش ݜا وا کیدے اِڑی ہویل تھی،
آں تھیئے ایکدیائے ما مُخامخ ہیدے سوال جواب کونین۔
(ماتحت خلگے تنو گھن آ ئے) بننین: أ تھو اَشیئی یأ مھوزید چیر زورے دے یؤدُود۔
تھیئے بننین: نأ بلکہ تھو أمیدے ایمان اَنو والا نہ اَشیئی۔
آں تھوزید مُھن کی زور نہ اَشُو، (اصل بات أ چھی) کہ تھو أمیدے ناڑاما خلک اَشیئی۔
دَ مُھن پروردگار سی بات مھوزید ثابت ہی، مھو بُڑائے (مھیرے) مے مزا چکھو تُھو۔
کئیکہ مھوئے تھو گمراہ کیشی، مھو أمینے گمراہ اَشیئی۔
دَ تھیئے یقیناً تے دِیئے عذاب می ایکدی سیت شریک ہونین۔
مھو مجرم آ سیت اَںئی ہامُوڑ کودی۔
(ہین حال أ أشی کہ) کے یی ہأئے میس بنا بژودُود کہ اللہ ما سیوا دُوئی یام خُدا نو تُھو دَ ہے مشروٹی کوؤدود۔
آں بنودُود کہ: کئ مھو اے لیونئی شاعر سی وجہ دے تُنو خُدا چھیئی؟
حالانکہ سے (پیغمبرؐ) حق گھیندے اَبوشُو، آں تی دأل پیغمبر آ سی تصدیق کیشُو۔
دَ (ہأئے بنا بژنین کہ) تھو بٔڑائے سَخ تکلیف دیؤ والا عذاب سی مزا چکھو تُھو۔
آں تھوئے دوئی کی (بأت سی) نأ، بلکہ تُھن تُنو عملا سی بدلہ دیا بژنین.
البتہ کامیک یأ اللہ سی بُزروگ و چان کویل بندہ تھی۔
تھین کأ مقرر کویل روزی چھی۔
میوا تھی، آں تِھین کأ پورا پورا عزت ہونین۔
نعمتے ما ڈک باغا می۔
تھیئے اُچات تَخا زید ایکدوئی ئے مُخامخ بھژیل ہونین۔
(پاک شراب سی) اوسو ما جام (پین پین دے) ہین کأ گردش می یینین،
(تی شراب) اُوژل (ژانگ سی آں) پُو والا سی کأ خوندوَر ہونین۔
نأ تیدے ݜا پِشنین، ناَںئی تھین میم نشنین۔
آں تِھین کأن گھین گھین أݜی والا جوئیے ہونین، تِھین نظرے (تنو کھمن آ زید) وائے ہونین۔
تھین (بے داغ وجود) مھاموڑ معلوم ہونین یأ محفوظ کویل آن۔
بھی جنتی خلگے ایکدوئی سیت مُخامخ سوال جواب کونین۔
تھأمی اے بنُو والا بننین (دُونیئی می) مھی اے سأت اَشُو۔
سے (مھیئے) بنودُود: "تُو واقعی تھأ خلگے ما تُھو کآم یأ (آخرت سی جوند) سأس مَندی؟"
"کئی مھو کے یأ مُوئیو آں سُم و ہر سَوا گئیو، مھوئے واقعی (مُھن کما سی) بدَل دیا بژنین؟"
(تی جنّتی) بننین: "کئی تھو (مھی تے سأت) اے نظر پشُو نیمادی؟"
بھی تی څارنین دا تیس دیزوخ سی میئمو می پَشنین۔
تی جنّتی تیس کے بننین: "اللہ سی قسم! تُو دا مھأ برباد کوؤ والا اَشُو۔
کو مھی پروردگار سی فضل نُو ہُوشوو دأل خلگا سیت مأ ہُم گݜا بژنیندے۔
(بھی تی خوشحألی دے بننین) خا دَ مھوئے مھیرے مئیک نہ ہے نین؟
علاوہ مُھن اول (سی اے) مئیک ما؟ آں مھوئے عذاب ہُم نہ ہونین؟
حقیقت أ چھی کہ گھین کامیابی اَںئی ہے چھی۔
اَںئی ہأل کامیابی سی کأ عمل کوؤ والائے عمل کوؤ پکار تُھو۔
کئ ہے میلأݜتوپ غورا تُھو یا زقوم سی تھام؟
مھوئے تے تھام تھأ ظألما سی کأ اے اَزمیخ سوأت چی۔
اصل می أ سے تھام تُھو یأ دیزوخ سی ٹوپ ما نُخدُو۔
تِسی ݜِݜ (بار) مھال تُھو یأ شیطانا سی ݜا،
دَ تھیئے (دیزوخیئے) تیما خوراک گھننین، آں اَںئی تیما تنُو ڈھے پوننین۔
بھی تھأئے تِسی ڙیت خوڑوگیل اُو سی گاڈیرہ میلاؤ ہونین۔
بھی تھین واپسی أںئی تے دیزوخ سی دِش کے ہونین۔
(ہے سے خلک تھی) تھیئے تنو باپ داد گمراہی سی حالت می پأدیشی۔
دَ ہیئے تِھین (کُھوآ سی) نخے دے دھأںئی دید،
آں تھیئے ما مُوش لھنگیل خلک ہُم اکثر گمراہ ہوئی،
آں حقیقت أ چھی کہ مھوئے ہأمی خبردار کوؤ والا (پیغمبر) پیئی شی،
مھیرے بو! کامے خلک خبردار کوا گئیشی دا تِھین انجام کھال ہو،
البتہ کآم یأ اللہ سی بزرگ آں چان کویل بندہ تھی دا (سے محفوظ اَشیئی)
آں نوحؑ مھوئے ہاگادُوشو، دَ (بوُ دا) مھو چأڑ سی کھیدیک غورا جواب دیؤ والا تھی۔
آں مھوئے تھأ آں تھین شیر والا گھین پریشانی ما لھاسیئی۔
آں مھوئے تھین نسل باقی چھیئ،
آں مھوئے دھریل خلگا سی کأ مے طریقہ جاری کی۔
(کہ سے میس بَنن) سلام ہوئے نوحؑ زید دُونیئی جہان سی خلگا می!
یقیناً مھو نیک عمل کوؤ والائے اَںئی ہال بدلہ دیدی،
بےشکہ سے مُھن مومن بندہ آ می أشیئی۔
بھی مھوئے دیأل خلک (دھریل خلک؟) (اُو می) ڈوبأت۔
آں اَںئی تِسی طریقا دے تِلو والا آ می یقیناً اِبراہیمؑ ہُم اَشُو۔
کے یأ سے تُنو پروردگار سی کأن گے پاک صفا حی گھیندے اَپ،
کے یأ سے تُنو بوپ آں تُنو قوم گے بنو: تھو کا شیئی آ سی عبادت کودی؟
کئی تھو اللہ چھیدے لوو آ سی خدا نِیمادی؟
دَ بھی تے ذات سی بارا می کآم یأ بُٹ جہان آ سی رب تُھو، تُھن کیا خیال تُھو؟
بھی تی تا آ زید اے نظر تھیلدے بُو،
آں بنو: "یقیناً آ ناژور تُھو"۔
اَسے سے تیس ما گئی تیسکے پیٹھ کیدے،
بھی سے تھین سویل خدئی آ سی (یعنی بُھود آ سی) کأن گے بِریت لھنگُو، (آں تھأئے) بنُو: تھو کھادی نأ؟
تھوئے کژل ہیژی تھو بأت نہ کودی؟
بھی تی سُووَن ہات تے تھین دک دید۔
دَ (تِسی قوم سی خلک) تِسی کأشکے دھأںئی دین اَںئی،
(ابراہمؑ) بنو: "کئی تُھو تھین عبادت کودی کا یأ تُنو ہات تے سوأدتی؟"
(حالانکہ) اللہ تھو ہُم پیدا کیدی آں کا یأ تھوئے سوأدتی تیز ہُم۔
تھیئے بنُو: اِسی کأ (ابراہیمؑ سی کأ) اے شیر سَوا، آں ایس بلبلأ کویل آنگا وا تھلا۔
اَںئی ہاموڑ تھیئے تِسی خلاف گھین اے منصوبہ سوؤ نیماد اَسے مھوئے تھأ پاتے اَنئی۔
آں تی بنُو: آ تُنو رب سی کأن گے بژدُو تی مھیئے پان پشانین۔
اے مھی پروردگار! مھیئے (مھال اے پو) دے یأ سے نیک خلگے ما ہوئے۔
دَ مھوئے تیس کے اے صوو سی کھمان پو سی زیرے دید۔
بھی کے یأ سے (پو) تیسیت تِلو سی قابل ہُو دا تی بنُو: اے مھی پُوڙو! آ نین می پشَدُو دا تھأ حلال کودُو، مھیرے سوچ کیدے بَن دا چھی کا خیال تُھو؟ پوئے بنُو: باوا! تُو اَںئی تیس کو کِسی یأ تھیئے حکم دیا بژدُو، اِنشاءاللہ تأ مھأ صوو کوؤ والا آ ما پانین۔
آخر، کے یأ دُوںئے (حکم منُو؟) ݜا وا کی آں (بوپ) پو موتھلأ تھلُو۔
آں مھوئے تیس کے آواز دید: اے ابراہیمؑ!
تأ نین سأس کی، یقیناً مھو نیکی کوؤ والائے اَںئی ہال بدَل دیدی۔
یقیناً ہے اے واضحا امتحان اَشُو۔
آں مھوئے اے گھین حلالہ دیدے ایس (پو) بَچ کی۔
آں مھوئے دھریل خلگا سی کأ مے طریقہ جاری کی۔
(کہ سے میس بَنن) "سلامتی ہوئے ابراہیمؑ زید!"
مھو نیگی کوؤ والائے اَںئی ہاموڑ بدل دیدی۔
یقیناً سے مُھن ایماندا بَنا می اَشُو۔
آں مھوئے تیس کے اسحاقؑ سی زیرے دیدکہ تی نیکوکارے ما اے نبی ہونین۔
آں مھوئے تیزید ہُم برکت نازل کی آں اسحاقؑ زید ہُم، آں تھین اولادی می یام خلک نیک عمل کوؤ والا تھی، آں یام تُنو اَمن زید صفا صفا ظلم کوؤ والا۔
آں یقیناً مھوئے موسٰیؑ و ھارونؑ زید ہُم پَیرزو کِشو۔
آں مھوئے تھأ و تھین قوم اے گھین دڑ و مُصیبت ما لھاسِئی۔
آں مھوئے تھین مدد کی، تِسی نتیجا می اَںئی سے بَرئی والا ہُوئی۔
آں مھوئے تھأ دُوںئیائے اے واضحا کتاب دِید۔
آں تھأ دُوںئیائے سیدا پَن سی ہدایت کی۔
آں کامے خلک تھیئے ما بعد اَئی دا تھأمی مے طریقہ جاری کی۔
(کہ سے میس بَنن) "سلامتی ہوئے موسٰیؑ و ھارونؑ زید!"
یقیناً مھو نیگی کوؤ والائے اَںئی مھاموڑ بدَل دیدی۔
بے شکہ سے دُوئیمو مُھن ایماندا بَنا می اَشیئی۔
آں الیاسؑ ہُم یقیناً پیغمبرے ما اَشُو۔
کے یأ تی تُنو قوم گے بنوشُو: "کئی تھو (اللہ) ما نہ بھیدی؟"
تھو بعل (بُت سی نام) سی عبادت کودی، آں تیس چھودی کآم یأ بُڑے ما غورا پیدا کوؤ والا تُھو؟
سے اللہ یأ تُھن پروردگار تُھو آں تُھن بوپ داد سی ہُم کآم یأ موش لھنگئیدی؟۔
اَسے تھیئے الیاسؑ لووال گھنُو (تِسی وجہ دے) تھیئے ضرور گݜا بژنین۔
اَسے اللہ سی بزروگ (چان کویل) بندائے (محفوظ دھرنین)
آں مھوئے دھریل خلگا سی کأ مے طریقہ جاری کی۔
(کہ سے میس بَنن) سلامتی ہوئے الیاسینؑ زید۔
یقیناً مھو نیک عمل کوؤ والائے اَںئی ہال بَدل دیدی،
بے شک سے مُھن بندائے ما اَشُو۔
آں یقیناً لوطؑ ہُم پیغمبرے ما اَشُو۔
کے یأ مھوئے تیس آں تِسی شِیر والا بُٹ (عذاب ما) لھاسِئیشی۔
علاوہ اے ڈھیگ ما کآم یأ پأشکے دھرُو والا آ می أشی۔
بھی مھوئے دأل خلک دَڑے وڑے کی۔
آں (اے مکہ والا ہانا!) تھو تھین (گام آ سی) ڙیت تے لینگدے بژدی (کے یأ) ڙات ہُوو۔
آں (کلا) ڙأت سی سادا، کئی بھی ہُم تھوئے عقل نہ یے یی؟
آں یقیناً یونسؑ ہُم پیغمبرے ما اَشُو۔
کے یأ سے ڈیدے ڈک اے کشتی یے اَوؤ۔
بھی سے تِیلا می شریک ہُو، آں تی بئیلأت۔
بھی ماشے تیس نوگلُو، سے تُنو اَمن ملامت کوؤدود۔
دَ کو سے تیسپے گوؤ والائے ما نُو ہُوشُوو،
دَ تی تے دی آ پورے ماش سی ڈھے مے دھرنیندے کامے دیئے مئیل جینی کوا بژنین۔
بھی مھوئے تیس مے حال می أندے اے کولاؤ میدان می تھلُو کہ سے ناژور اَشُو۔
آں مھوئے تِسی ڙیت اے (گھینیل سی) جھال والا تھام نگھالُو۔
آں مھوئے تیس اے لَک بلکہ تیما ہُم چیر خلگا سی دِش کے پیغمبر سیوأدے پیؤشو۔
بھی تھیئے ایمان اَنو، مھوئے تھأئے اے مُدا آ پورے (جیدن ما فائیدا گھینو سی) موقع دید۔
مھیرے ہأما توَس کو کہ: کئی چھی پروردگار سی حصہ می دَ سیرأن اَئیدی آں تھین حصہ می جدک؟
یائی، مھوئے کے یأ مُلیکا جوَئی سیوأت تا ہے پَشودُود؟
یاد ساتا! ہے تُنو لوو آ سی بأت بَندی،
کہ اللہ سی کأ اولاد چھی، آں ہے خلک بیخی لووال تھی۔
کئی تی جدگا سی پوت سیرأن خوشأدتی؟
تھوئے کژل ہیژی؟ تھو کھال انصاف کودی؟
کئی تھو (ہیدیک ہُم) خیال نہ کودی؟
یائی تھوکیش کی واضحا دلیل تھو؟
دَ آنا تُنو تے کتاب، کو تھو سأزبَن تھیو۔
آں تھیئے اللہ و پیَرا سی میئے ہُم نسب سیوأدچی، حالانکہ أمیدے پیرآئے أ بات معلوم چھی کہ مھیئے خلگے (مُجرم سوا بیشتے اللہ سی مُشکے) پیش ہونین۔
اللہ تھیئے بأدے ما پاک تُھو کا یأ ہے سَوادی دا۔
البتہ اللہ سی بزرگ بَنے (حفاظت می دھرنین)۔
کئیکہ تھو آں کِسی کِسی یأ تھو عبادت کودی دا،
ییس ہُم اللہ سی بارا می گمراہ نہ کوبھادی۔
علاوہ مھال ماݜ ما کآم یأ دیزوُخ می جَلُو والا ہوئے۔
آں (مُلیکا دا میس بندی کہ) مھومی ہر ایک سی اے پوت مقرر تُھو۔
آں مھو دا (اللہ سی اطاعت می) صف سیوأدے اِڑی ہویل ہودی۔
آں مھو دا اللہ سی پاکی بیان کوا یےدی۔
آں ہے (کأفر) خلک موش تا میس بنودُود،
کہ:کو مھوکیش موشُک خلگا سی شانے نصیحت سی کی کتاب ہُوشوو،
دَ مھوئے ہُم خامخا اللہ سی بزرگ (چان کویل) بندا آ می شامل ہونیندے۔
بھی ہُم تھیئے کفر سی پان گأدچی، اِسی کأ تھأئے پتہ گھڑنین۔
آں مھوئے موش ما تُنو پیغمبر بند آ سی بارا می بات کِیژی۔
کہ یقیناً تھین مدد کوا بژنین۔
آں حقیقت أ چھی کہ اَںئی مُھن لخکر سی خلگے غالب یے نین۔
بس (اے پیغمبرؐ!) تُو کآں ساعت سی کأ ہأ خلگے ما بے پروا ہو۔
آں تھائے بوا یے، جلد ہیئے ہُم پشنین۔
کئی ہے مُھن عذاب سی کأ تأدی کودی؟
بس کے یأ سے (عذاب) تھین غولے یے وادو، دَ کامے خلگائے خبر دیا گیشی دا تھین تی ڙات چر لاݜ ہونین۔
آں تو کآں ساعت سی کأ تھیئے ما بے پروا ہو،
آں بوا یے، چیر جلد ہیئے اُمیدے ہُم پَشنین!
چھی پروردگار عزت سی مالک، ہأ بُٹ بأدے ما پاک تُھو کا یأ ہے خلک سوادی!
آں سلام ہوئے پیغامبر آ زید؛
آں بُٹ صفت اللہ سی کأ تھی، کآم یأ بُٹ جہان آ سی پروردگار تُھو۔
صاد، قسم تُھو نصیحت والا قرآن سی (کہ تھو حق زیت تھی)۔
اَسے کأفر خلک تکبر و دشمینی می تھی۔
آں ہأما موش مھوئے کھیدیک قوم ہلاک کی، دَ تھیئے چیگأ نگھالئ (عذاب پیشتے) حالانکہ سے وخ لھسو سی نہ اَشُو۔
آں ہیئے (قریش سی خلگے) مے بأت زیت تعجب کی کہ ہین کأشکے ھأما اے بھیو والا آپ، آں ہیئے کأفرے بنو ہے کوٹگر گھن لوال تُھو۔
کئی اِی بوڑ خدئیے ما اے خدا سواد؟ بیشکہ أ دا گھین تعجب سی بات چھی۔
آں ہأمی ملک میس بیندے گئی کہ تِلا (اِسی کأشا)، آں تنو خدئ آ زیت جختہ ایڑی ہوا، بیشکہ أ خامخا کآں دُوئ غرص سی بات چھی۔
مھوئے مے بات پیشم دین می ہُم نی بِدیشی، بیشکہ أ صرف تنو سَویل بات چھی۔
کئی أ نصیحت (قرآن) مھومی صرف ایزید نازل کوا گأ؟ اصل بات أ چھی کہ ہےخلک مھی نصیحت سی بارہ می شک می مبتلا تھی، بلکہ ہیئے لا مھی عذاب سی مزہ نہ چکھیژی۔
کئی ہأکیش چھی رب سی رحمت سی خزان تھی، سے رب یأ زوروڑ دیؤ والا تُھو؟
کئی آسمانو دھیرین آں تھین مِیئے ہر شیئی سی بأچیئی ہین قبضہ میں چھی؟ تَھلا ہے کھے لھمأدے بھائے اُوخن۔
ہے مخالف لخکرے ما اے کمزورے لخکر تُھو، اِی اَںئی ہیت بئیلانین۔
ہأما موش نوحؑ سی قوم آں قوم عاد آں میخ والا فرعون ہُم پیغمبر لووال گھنئیشی،
آں ثمود آں لوطؑ سی قوم آں زنگل سی خلگے (ہُم لووال گھنئیشی)، ہے (گھن) لخکر اَشیئی۔
تھأمی می ایک ہُم مھال نہ اَشُو کہ تی بوڑ پیغمبر لووال نہ گھنئیشی، تھلا ہأزید مھی عذاب واجب ہُو۔
أ خلک صرف اے چیگأ سی انتظار کودی،کہ تِسمی کی وقفہ نہ ہونین۔
آں ہے بندی اے مُھن پروردگار! مھوئے مُھن ڈے حساب سی دی ما موش دے۔
(اے پیغمبرؐ!) ہے کا بندی ایزیت صوو کو، آں مُھن بَن داؤد یاد کو، سے گھن طاقت آ سی کھمان اَشُو، بیشک سے (اللہ زید) مَیَن اَشُو۔
مھوئے کھن تابع کیشی کہ نأشاما آں ژاد می تیسیت (اللہ سی) پاکی بیان کوئن۔
آں پیݜین ہُم سرڑیل، ہے بوڑ تیسکے تابعدار اَشیئ۔
آں مھوئے تِسی بأچیئی مضبوط کی، آں تیسکے پوھہ دید، آں فیصلہ والا بیان سی صلاحیت دید۔
آں کئی تھوئے تھأ دعوای دار آ سی خبر أبیشی، کآم یأ دیوال زید اِختے عبادت سی پوت کے لھنگئیشی؟
کا وخ یأ سے داؤدؑ سی کأشکے لھنگئی دا داؤدؑ تھأما بِھیُو، تھیئے بنُو: "تو نہ بھی، مھو دو فریق تھی، مھومی ایگے دُوئی زید زیأتیئی کیژی، دَ تو مُھن اَندرے حق سی فیصلہ کو، آں نأانصأفی نہ کو، آں مھوئے صحیح صحیح پان پشا۔
بیشکہ أ مھی بھا تُھو، اِسی ایگا کم پائیں بیش اَئے تھی، آں مھی اے اَئے چھی، دَ ہے مھیرے بندُو ایس ای مھیئے حوالہ کو، آں اِی بأدا می مھأ پُر کودُو۔
(داودؑ) بنُو: بیشکہ اِی ظلم کیدُو، مے بأت می یأ تھیکیژا تنُو اَئے آ سیت چھی اَئے نیمادُو، آں بیشکہ چیر ٹلگر ایکدوئی سیت زیأتیئی کودی، سیوائے تھأما کآم یأ ایماندا تھی، آں نیک عمل کودی، آں سے چیر اَشوڑ تھی، آں داؤدؑ جنُو کہ مھوئے تیسی اَزمیخ کیژی، دَ تی تُنو رب ما معافی نیمأد، آں سجدہ می لار گا، آں تی توبہ نیگھألی۔
دَ مھوئے تیسکے اے بات بیگیشی، آں بیشکہ تِسی مُھن دربار می گھن درجہ اَشُو، آں غورہ پوت۔
اے داؤدؑ! بیشکہ مھوئے تھأ دھیرین زید خلیفہ (باچا) سوادتُو، خلگا می حق زید فیصلہ کو، آں خواہشا سی تابعداری نہ کو، نأو تھلا تأ اللہ سی پَن ما ہڙشنین، بیشکہ کآم خلک یأ اللہ سی پَن ما ہڙژدی، خاص تھین کأ سخ عذاب تُھو، مے وجہ دے کہ (کئیکہ) ہیئے حساب سی دی اَموݜا تھلودُو۔
آں مھوئے آسمانو دھیرین، آں کائی ہأ دوںئی آ سی مِیئے تُھو دا بیکار پیدا نی کیدو، أ دا کأفر آ سی گمان تُھو، تَھلا کأفر آ سی کأ گھین ہلاکت چھی آنگا سی شکل می۔
کئی مھوئے تھأ خلک کی یأ ایمان اَنودُو آں نیک عمل کودی، تھأ خلگا سی شانے کونین کآم یأ دھیرین می فساد کودی، یا پرہیزگار بدکردارا سی شانے کونین؟
(اے پیغمبرؐ!) أ اے برکتی کتاب تُھو، مھوئے تھیزید مے وجہ دے نازل کیدو کہ أ خلک اِسی آیادا می فکر کوئن، آں عقل والا نصیحت گھینن۔
آں مھوئے داؤدؑ کے سلیمانؑ (پو) دیدوشُو، غورہ بَن اَشُو، بیشکہ سے (تنو رب دِشکے) چیر نڑو والا اَشُو۔
(سے اے یادگار وخ اَشُو) کے یأ نیاشاما تِسی موشکے (گھلئی) کَرَا گھو حاضر کوا گئی۔
دَ تی بنو: بیشکہ مأ مال سی مینہ اختیار کی تنو رب سی یاد سی وجہ دے، مھیدیگا پورے کہ سے پردا می أݜیئے ما پنا ہُوئی۔
(سلیمانؑ بنو) ہأ مھی کأنگے واپس اَنا، بھی سے تھین پِن و چونجو آ زیت ہات گوؤ آ شروع ہُو۔
آں بیشکہ مھوئے سلیمانؑ سی اے اَزمیخ کی، آں تِسی تخت زیت اے بوٹی أندے تھیلی، بھی سے (اللہ سی دِشکے) نُڑو۔
تی بنُو: "اے مھی پروردگار! مھأ بوگوش، آں مھیئے مھالے بأچیئی دے، کہ سے مھأما پأش یسکے میلاؤ نہ ہوئے (مناسب نہ ہوئے)، بیشکہ خاص تُو گھن سخی تُھو (دیؤ والا)۔
بھی مھوئے تیسکے ہوا تابع کی، سے تِسی حکم دے دما دما سیت چلودُود کھیت کے یأ سے اَوؤ نیمؤدود۔
آں بوڑ شیطان (ہُم مھوئے تابع کی) تھأمی ہر شانہ مِسری آں لاموجَن اَشیئ۔
آں یام دأل (دیؤ) زنزیر آ می گھنیل اَشیئ۔
أ مُھن ڈالی چھی، کیسکے دیدے غورہ کو یا کھم، تھزیت کی حساب نو تُھو۔
آں بیشکہ تِسی مُھن دلبار می گھن درجہ اَشُو، آں شیژو پوت۔
آں مُھن بندہ ایوبؑ یاد کو، کے یأ تی تنو رب کے ڇاڑ کی کہ: بیشکہ شیطان مھیئے تکلیف آں سختی دید۔
(مھوئے تیسکے بنُو) تنُو کُھویدے دھیرین سی داک دے، (بُودا!) أ شیدل اُو تُھو، لامو سی کأ، آں پُو سی کأ۔
آں مھوئے تیسکے تِسی ٹوَر دُوآر دید، آں تھأسیت تھال دوئی ہُم تنو دیشا (دید) رحم کیدے، آن عقلمنائے یادگار نصیحت کیدے۔
آں (تیسکے میس بنُو کہ) تنو ہات می لینے آ سی داد گھین، بھی تیدے داک دے، آں قسم نہ پھرا، بیشکہ مھوئے تیس صوو کوؤ والا پات، غورہ بَن اَشُو، بیشکہ سے اللہ سی دِشکے چیر نڑو والا اَشُو۔
آں مُھن بَن ابراہیمؑ و اسحقؑ و یعقوبؑ یاد کو، کآم یأ ہادا سی آں أݜی آ سی کھمن اَشیئ۔
بیشکہ مھوئے تھأ خالص آخرت سی شیر سی یاد سی کأ کاریئشی۔
آں بیشکہ سے مُھن دلبار می غورہ کاریل خلگا ما اَشیئ۔
آں اسماعیلؑ و یسعؑ، آں ذوالکفلؑ یاد کو، آں ہے بوڑ غورا خلگا ما اَشیئ۔
أ نصیحت اَشیئ، آں بیشکہ پرہیزگار آ سی کأ خامخا شیژو پوت تُھو۔
مُدام دھرُو سی باغ تھی، ہین کأ بوڑ در کولاؤ کویل ہونین۔
تھیت ہین ڈڈہ دیل (ڈو دیل) ہونین، چیر قسما سی میوہ آں شربت نیما یےنین۔
آں ہین کأشکے تنو کھمن آ سیت أݜی نامیل سیمأڑ حورے ہونین۔
أ سے نعمت تھی کہ ہین حساب سی دیئے تھوریت لوز کوا گودُو۔
بیشکہ أ مُھن دیل رزق چھی، اِسی کی لھسو نہ تُھو۔
أ تُھو (متقی خلگا سی انجام)، آں (دوئی دِشکے) سرکشہ سی کأ خامخا چیر لاݜ پوت تُھو۔
(سے پوت) دیزوخ تُھو، ہیئے تیسکے لھنگنین، آں سے چیر لاݜ بشترہ تُھو۔
أ عذاب تُھو مھیرے ہے ایس چکھے، خوڑوگیل اُو تُھو آں نؤ۔
آں دوئی ہُم مے شکل می جوڑا جوڑا عذاب سی ہونین۔
أ اے (گھن) ٹل تُھو، تُھن سأتویلی می آنگائے لھنگا بیَدو، ہأئے کی خیرسیت نہ ہوئے، ہے بوڑ آنگا می دھژُو والا تھی۔
(تی ٹلے) بننین: نأ، تھوئےکی خیرسیت نہ ہوئے، خاص تھوئے مے مصیبت مُھن کأ موش گھیندے اَئیدی، دَ کھال لاݜ پوت تُھو أ دھرُو سی۔
(بھی تھیئے) بننین: "اے مُھن پروردگار! کی یأ مے مصیبت مُھن کأ موش گھیندے آپ تُو، دَ تیسکے دیزوخ می دوگُن عذاب دے۔
آں ہیئے (کأفرے ایکدیائے) بننین: مھوئے کژل ہیژی کہ مھو یام ماݜ نہ پشَدی، کہ تھأ مھو لاݜ خلگا می لیکھودُود۔
کئی مھوئے تھین ہأئیمو پشاڑے کِشی، یا تھین پشُو می أݜی پَݜلدی؟
بیشکہ أ دیزوخی آ سی ایکدی سیت پݜیُو یقینًا حق تُھو۔
اے (پیغمبرؐ!) تھو بنا بیشکہ آ دا صرف اے بھیؤ والا تُھو، آں یام عبادت سی لائق نو تُھو، بے اے اللہ ما، سے اَمن سیت زوروڑ تُھو۔
سے واگدا تُھو آسمانا سی آں دھیرین سی، آں کا یأ ہین مِیئے تُھو، بوڑا زیت غالب چیر بوگوشو والا تُھو۔
تھو بنا کہ ہے چیر گھین خبر چھی۔
(اَسے) تھو ایزما مُو نڑیل تھی۔
(ہأئے بَن) مھیئے کی پتہ نہ أشی، بھیم جہان سی مُلیکا سی بارہ می، کے یأ سے ایکدی آ سیت بحث کودُود (آدمؑ سی پیدائش سی بارہ می)۔
مھیئے صرف مے وجہ دے وحی کوا بژژی کہ یقیناً آ اے اخکارہ بھیؤ والا تُھو۔
یاد کو کے یأ چھی پروردگار مُلیکائے بنُو کہ بیشکہ آ اے انسان سُم ما پیدا کوؤ والا تُھو۔
دَ کے یأ مأ تیس سَوادو، آں تِسمی تنو سا پِھگیو تھلا تھو تیسکے سجدہ می بژا۔
مُلیکائے سجدہ کی، بُوڑے ایپوت جمع ہیدے۔
اَسے شیطان (سجدہ نی کی) اَمن گھن حساب کی، آں سے کأفرا می ٹل ہُو۔
(اللہ) بنُو اے ابلیسأ! کیس یأ مأ تنُو ہادیدے پیدا کیشو تیسکے سجدہ سی کوؤ ما تھأ کی کھمُو؟ تأ کبر کی یا تو گھن خلگا می اَشُو؟
تی بنُو: "آ ایزما چیر غورہ تُھو، تأ مھأ آنگا ما پیدا کیدُو، آں ایس تأ سُم ما پیدا کیدُو"۔
(اللہ) بنُو: "تھلا تُو ہیدا (جنت ما) نُوخ، کئیکہ یقیناً تو ݜگیل (کگیل) تُھو۔
آں بیشکہ تھزیت بدلہ سی دیا پورے مھی لعنت چھی۔
(شیطان) بنُو اے مھی پروردگار! مھیئے مہلت دے، تے دیا پورے یأ خلگے دوبارہ جینی کوا بژنین۔
(اللہ) بنُو دَ بیشکہ تُو مہلت دئیل آ می ہُو،
تے پأنیل وخ سی دیا پورے۔
(شیطان) بنُو: :چھی عزت سی قسم! مأ ہأ بوڑ خامخا گمراہ کونین۔
سیوائے تھأ خلگا ما کآم یأ چھی کاریل بَن تھی۔
(اللہ) بنُو: تھلا سأز بات أ چھی، آں آ سأز بات بندُو۔
خامخا مأ دیزوخ ڈک کونین تھأئیدے، آں تھأ خلگے دے کآم یأ ہأمی چھی تابعدار تھی، بوڑے دے۔
(اے پیغمبرؐ!) تھو بنا کہ: آ مے (دعوت) زیت تھوما کی بدلہ نی گھیندُو، آں نأئی آ اَمن سَوا آ (بناوٹی خلگا) می تُھو۔
أ دا صرف بوڑ جہان آ سی خلگائے اے نصیحت چھی۔
آں دھاک وخا بعد تھوئے اِسی حال ما غورہ شید ہونین۔
أ کتاب غالب آں حکمت سی کھمان اللہ سی دِشا نازل ہودُو۔
بیشک مھوئے مے کتاب حقیدے تھیزید نازل کیدو، دَ تو اخلاص تے اللہ سی عبادت کو۔
یاد سات! خالص بندگی صرف اللہ سی کأ چھی، آں کھیئے یأ اللہ ما علاوہ دأل معبود سوأدتی، (آں میس بندی) کہ مھو دا ہین عبادت مِسی کأ کودی کہ ہیئے مھو اللہ یے نھیئی کونین، یقیناً (اے دی ینین کہ) یأ اللہ ہین مِیئے تھأ بأدا سی فیصلہ کونین کھأمی یأ ہے لات کودی، یقیناً اللہ تھأ ماڙائے ہدایت نہ دیدو کآم یأ لووال آں نہ منو والا ہودُو۔
آں کو اللہ نیمؤدودو کہ (یس تنو) اَمن گے اولاد گݜیدے، تنو مخلوق ما کیس ہُم نیمؤدودو خوشیدے، (خو) سے پاک تُھو، سے سے اللہ تُھو کہ ایک تُھو، آں زبردست تُھو۔
اَںئی تی آسمان و دھیرین حکمت آدے پیدا کیدی، اَںئی سے ڙات دی زید پلڑدو آں دی ڙأت زید پلڑدو، آں اَںئی تی سی و یُن تابع کیدی، کہ ہریک اے مقررہ وخہ پورے ریوان ہونین، یاد ساتا! کہ سے غالب تُھو آں چیر بوگوشو والا تُھو۔
تی (اللہ) تھو اے تن ما پیدا کی، بھی تیما تِسی جوڑا پیدا کی، آں تھوئے څاروئیے ما آٹ جوڑا پیدا کی، سے تھو تُھن ییئی آ سی ڈھے آ می ڇا أنچیگا می پیدا کودو، اَںئی ہے اللہ تُھن رب تُھو، بأچیئی صرف تِسی چھی، تیما علاوہ دوئی یام معبود نہ تُھو، دَ بھی تھو کامے دِشکے ریوان تھی؟
کو تھو ناشکری و کفر کوؤسأدو (یاد ساتہ کہ) اللہ یے تُھن کی پرواہ نی چھی، آں نأئی سے تنو بندہ آ سی دِشا ناشکری خوشادو، آں کو تھو شکر نیگھالدیو سے تُھن کأ اے بات خوشادو، آں (بُھویا!) یی ہُم بوج بھا کوؤ والا دوئی یسی بوج بھا نہ کونین، بھی تھوئے ٹولے واپس تنو رب سی دِشکے بژنین، بھی تی تھوئے تھأ ٹول پشانین کا یأ تھو کوؤدود، بیشک تیس کے حی آ سی میِئے بیرید بأت ہُم غورا معلوم تھی۔
آں کے یأ انسان گے تکلیف اَوؤو سے تنو رب سی دِشکے رجوع کیدے تیما دعا نیمادو، بھی یأ تی تنو دِشا تیسکے نعمت دیدو، کِسی کأ یأ سے موش ما دعا کوؤدود، دَ بھی تیس اَموݜا تھلدو، آں اللہ سی کأ شریک سوؤ آ شروع ہودو، بنے تِسی پَن ما (دأل ہُم) گمراہ کوے، (اے پیغمبرؐ! تو بَن) کہ تنو کفر ما دھأک دی فائدہ گھین، یقیناً تو دیزوخی تُھو۔
(اَیا سے ماݜ غورا تُھو) کو سے کہ ڙأت سی وخہ عبادت کودو، کلہ سجدہ زید آں کلہ قیام گے اِڑی ہویل، آخرت ما بھیدو، آں تنو رب سی رحمت سی طلبگار ہودو، دَ تو بَن کہ اَیا پوھہ خلک آں نا پوھہ خلک اے شان سی ہوبھادی؟ بات صرف أ چھی کہ نصیحت صرف سے خلک گھیندی کآم یأ ہوشا ہودی۔
بَن کہ: اے مھی مومن بندہ ہانا! تنو رب ما بھیا (یاد ساتہ کہ) کامے خلگے دونیئی می غورا کم کیدیو تھین انجام چیر غورا ہونین، آں اللہ سی دھیرین چیر کولاؤ چھی، (یاد ساتہ کہ) کآم خلک یأ صوو ما کام گھینَدی تھأئے بے حسابہ اجر و ثواب میلاؤ ہونین۔
بَن کہ: مھیئے حکم دیا گُودو کہ آ اخلاص تے اللہ سی عبادت کیئی؛
آں مھیئے أ حکم دیا گودو کہ آ مسلمانا می اول مسلمان ہیئی۔
(اے پیغمبرؐ!) تو بَن کہ مھیئے گھن اے دی سی عذاب سی بھیت چھی، کو مأ تنو رب سی بات نی بیدو۔
بَن کہ: آ دا اللہ سی عبادت اخلاص تے کودو؛
دَ تھو تیما علاوہ کسی یأ نیمادیو تِسی عبادت کوا، بَن کہ: تاوانی دا سے خلک تھی کہ تنو اَمن و تنو شیر والا قیامت سی دی تاوانی کی، یاد ساتہ! اَںئی ہأ خلگائے نقصان تُھو۔
تھین ڙید ہُم آنگا سی لام ہونین آں تھین ٹین ہُم آنگا سی لام ہونین، أ سے عذاب تُھو کیدے اللہ تنو بندہ بھیادُو، "اے مھی بندہ ہانا! اَںئی مھأ ما بھیا"
سے خلک کآم یأ اَمن شیطان سی عبادت ما ساتدی، آں اللہ سی دِشکے رجوع کودی، تھین کأ زیرے چھی، دَ مھی ہأ بندہ یے زیرے بُھوژا۔
کآم یأ بأت کے کان تھادی، آں غورا غورا بأدا زید عمل کودی، اَںئی ہے خلک تھی یأ اللہ ہأئے ہدایت کیژی، آں اَںئی ہے خلک ہُوشا تھی۔
اَیا کیزید یأ عذاب سی بات ثابت ہیژی، دَ کئی تُو تھأ عذاب ما نیگھل بھادُو؟
خو سے خلک کآم یأ تنو رب ما بھیدی، تھین کأ مھال دھرو سی اُوتھل پوت ہونین، کہ تھین ڙید چَت سویل ہونین، تھین ٹین کانے بژنین، ہے اللہ سی وعدہ چھی، اللہ یئت ہُم تنو وعدہ سی خلاف نہ کودو۔
اَیا تأ مے بأت کے نہ بودُو کہ اللہ آسمان ما اگھا مُوژاد، بھی تیس دھیرین سی مِیئے اوسو آ می چلاد، بھی تیما جُدا جُدا ڙانگ آ سی فصل پیدا کی، بھی سے شُوژدی، بھی تھو تیس چونو پشدی، بھی سے تیس چورا چورا کودو، ایمی یقیناً عقل سی کھمن آ سی کأ نصیحت چھی۔
اَیا سے ماݜ کسی یأ سینہ اللہ اسلام سی کأ کولاؤ کیدو، سے تنو رب سی دِشا (ہدایت سی) لوش می ہودو، (سے آں گمراہ ایشانا ہوبھادی؟) دَ سے خلک کھین حی اللہ سی یاد ما اثر نی گھیندیو سے تباہ تھی، اَںئی سے خلک اخکارہ گمرہی می بھژیل تھی۔
اللہ شیژو کلام نازل کیدو، ہے مھال کتاب تُھو کہ کسی بأت ایکدی سید گھڑدی، آں بھی بھی بنا بژدی، کآم یأ تنو پروردگار ما بھیدی تھین بدن کمدی، بھی تھین بدن آں حی اللہ سی ذکر تے کیمیلی ہودی، أ اللہ سی ہدایت چھی کیس کے یأ نیمؤسأدو اِسی زریعہ دے ہدایت دیدو، آں کیس یأ اللہ گمراہ کیو تیس کے یام ہُم ہدایت دیؤ والا نہ تُھو۔
اَیا (تے ماݜ سی کا حال ہونین) کآم یأ قیامت سی دی تنو بوت تے اَمن تے سخ عذاب ما بچ کوؤ نیمانین؟ آں ہال ظألیمائے حکم کوا بژنین کہ "مھیرے تھو تنو عمل سی خوند چکھا"، (اَیا ہے تھأسید ایشانا ہوبھادی کآم یأ ہال نہ ہُوئیو؟)
کآم خلک یأ ہیئے ما موش اَئیشی تھیئے ہُم (پیغمبر آ سی) انکار کیشو، دَ تھأزید مھالے دِشا عذاب آپ کہ تھین خیال ہُم نہ اَشو۔
دَ اللہ تھأزید مے دُونیئی می عذاب سی مزہ چکھأد، آں آخرت سی عذاب یقیناً اِسما ہُم گھن تُھو، کاش کہ ہے جنئیشیو!
آں مھوئے مے قرآن می خلگا سی کأ ہر قسم سی غورا غورا مثال بیان کیدی، کہ ہے نصیحت گھینن۔
أ عربی (جیب می) قرآن تُھو، اے پھٹ ہُم کولاچا نُو تُھو، مِسی کأ ہے (اللہ ما) بھیئن۔
اللہ مھال اے غلام سی مثال بیان کیدو یأ تِسی ملکیت می چیر لات کو (مالک) شریک تھی، آں مھال اے ماݜ سی مثال بیان کیدو کہ سے اے مالک سی ملکیت می تُھو، اَیا دُوںئی آ سی حالت اے شان سی ہوبھاژی؟ ٹول صفت اللہ سی کأ تھی، خو ہأمی اکثر خلک نہ جندی۔
(اے پیغمبرؐ!) تأ ہُم مونین، آں یقیناً ہیئے ہُم ہونین۔
بھی یقیناً تھوئے ٹولے قیامت سی دی تنُو لات اللہ سی مُشکے (فیصلہ سی کآ) تھانین۔
بھی تیما زیاد ظألم کی ہونین کآم یأ اللہ زید لوو سَوے؟ آں بھی کے یأ سأس بات تیسکے اَوئیو تِسی انکار کوے، اَیا ہال کأفر آ سی پوت دیزوخ نو تُھو؟
آں کی یأ سأس بات گھیندے آپ، آں کی یأ تیس سأس مینی، اَںئی سے خلک پرہیزگار تھی۔
تھین کأ تھین رب سی کأن ہر سے شیئی تُھو کا تھیئے نیمادو، نیگی کوؤ والا سی کأ اَںئی ہے بدل تُھو۔
مِسی کأ یرأ اللہ تھین لاݜ کم کا یأ تھیئے کیدیو تھیئے ما دھوگو کوئے، آں تھین نیک عمل آ سی تھأئے غورا بدل دو۔
اَیا اللہ تنو نیک بَن آ سی کأ پورا نو تُھو؟ آں (اے نبیؐ!) ہے تھأ اللہ ما علاوہ دألے ما بھیادی، آں اللہ کیس یأ گمراہ کوؤسأدو تیسکے یام پان (ہدایت) پشؤ والا نہ تُھو۔
آں کیسکے یأ اللہ ہدایت دیدو تیس یام گمراہ کوؤ والا نہ تُھو، اَیا اللہ زبردست (آں کأفرے ما) بدل گھینو والا نُو تُھو؟
آں (اے پیغمبرؐ!) کو تو ہیئے ما توس کو کہ آسمان و دھیرین کی پیدا کیدی، دَ ہیئے خامخا بننین کہ اللہ (پیدا کیدی)، تو بَن کہ خا، مھیئے میس بنا کہ اللہ ما علاوہ کسی یأ تھو عبادت کودی دا، کو اللہ مھیئے کا تکلیف دیؤ نیمؤسأدو اَیا ہے تِسی تکلیف دھوگو کوبھادی؟ یا کو اللہ مھیزید کی مہربانی کوؤ نیمؤسأدو دَ سے تے مہربانی منع کوبھادی؟ تو بَن کہ مھی کأ دا اللہ پورا تُھو، اَںئی تیزید توکل کوؤ والا توکل کودی۔
(اے پیغمبرؐ!) تو بَن کہ اے مھی قومأ! تھو تنو پوت زید تنو کام کوا، آ ہُم (تنو پوت زید) کام کودو، چیر شیرتے تھوئے پتہ گھڑنین،
کہ کیزید تی عذاب یینین کی یأ تیس (دُونیئی می) شومأدے چھونین، آں کیزید (آخرت می ہُم) ایموا سی کأ عذاب ینین۔
مھوئے تھیزید مے کتاب خلگا سی ہدایت سی کأ حق زید نازل کیدو، دَ مھیرے کآم یأ سیدا پَن دے چلدوو سے تنو کأ گٹہ کودو، آں کآم یأ گمراہ ہُوو سے اَمن گے نقصان آوادو، آں (اے پیغمبرؐ!) تو ہین کأ ذمہ وار نو تُھو۔
اللہ بُٹ روح تھین مئیک سی وخہ قبض کودو، آں تھأ (روح) ہُم کیزید مئیک نہ آبو تھین نین می قبض کودو، بھی تھأ ہیسار کودو کیزید مئیک سی حکم کیدوو، آں دأل روح اے مقرر وخہ پورے چھودو، بیشک ایمی تھأ خلگا سی کأ (گھن) نخ تھی کآم یأ غور و فکر کودی۔
کئی ہیئے اللہ ما علادہ دأل خلک اَمن گے سفارشی سیوادتی؟ (اَے پیغمبرؐ! تو ہأئے) بَن، کو ہے سفارشی کو نأ دا کی اختیار لردی آں نأئی کی جندیو (بھی ہُم تھو تھأ سفارشی مندی؟)
بَن کہ سفارش تا بُٹ اللہ سی اختیار می تھی، اَںئی تِسی بأچیئی آسمان و دھیرین می چھی، بھی تھوئے ٹولے تِسی دِشکے واپس بژنین۔
آں (ہأ کأفر آ سی دا أ حال چھی کہ) یأ اے اللہ سی ذکر کوا گاو دَ کآم خلک یأ آخرت زید یقین نہ ساتدیو تھین حی تینگی ہودی، آں کے یأ اللہ ما علادہ دأل آ سی ذکر کوا گاو تے وخہ ہے خوشال ہودی۔
تو بَن کہ اے اللہ! آسمان و دھیرین سی پیدا کوؤ والا، بیریت و اخکارہ ما جنو والا! اَںئی تأ تنو بندہ آ سی مِیئے فیصلہ کونین، کیمی ہے لات کودی۔
آں کو ظالم آ کیش دُونیئی سی ہر کی ہُم موجود ہُوو، آں ہیدیک ایزید دُوئی ہُم، دَ قیامت سی دی سی سخ عذاب ما اَمن لھاسو سی کأ ہر کی دیؤ نیمؤسأدو، (بھی ہُم) ہأزید اللہ سی دِشا تی عذاب نازل ہونین، کسی یأ ہین گُمان ہُم نہ اَشوو۔
آں تھأزید تھین ٹول لاݜ کم اخکارہ ہونین، آں کامے عذاب سی سے پشاڑے کودود تا تی تھأ گیر کونین۔
آں کا وخہ یأ انسان گے کی تکلیف اوؤو سے مھوئے ہاگادُو، بھی کے یأ تیسکے مھوئے تنو دِشا کی نعمت دیدو بندو کہ "أ مھیئے مھی علم سی وجہ دے میلاؤ ہیژی"، نأ!، أ دا اے اَزمیخ چھی، اَسے اکثر خلک نہ جندی۔
مھأ بأت تھیئے خلگے ہُم کیشی کآم یأ پخوا لھنگئیدی، خو تھین کم تھین کی پکار نہ اَئی،
بلکہ تھین لاݜ عمل تھأئے اَوَئی، آں ہیئے (مکہ سی کأفرا) می کآم ہُم ظألم تھیو تھأزید چیر شیرتے تھین لاݜ عملا سی نقصان اَوونین، آں ہے (اللہ تنو تدبیرا دے) عاجز نہ کو بھادی۔
کئی ہأئے معلوم نہ تُھو کہ اللہ کیس کے یأ نیمادوو رزق فراخا کودو آں (کیس کے نیمادوو) تینگی کودو، اِسمی ایمان والا آ سی کأ چیر گھن نخ تھی۔
(اے پیغمبرؐ!) تو بَن اے مھی بَن ہانا! کی یأ تنو اَمن زید زیأتیئی کیو اللہ سی رحمت ما نااُمید نہ ہوا، یقیناً اللہ تُھن گناہ معاف کونین، بیشک اللہ چیر بوگوشو والا (آں) چیر رحم کوؤ والا تُھو۔
آں تھو تنو پروردگار سی دِشکے رجوع کوا آں تِسی حکم مَنا، میس ما موش کہ (تُھن غفلت سی وجہ دے) تھوزید عذاب یو، بھی (تے وخہ) تُھن مدد کوا نہ بژنین۔
آں (اے خلگ ہانا!) تنو رب سی پئیل شیژو حکم مَنا، میما موش کہ تھوزید اچانک عذاب یو، آں بَنے تھوئے پتہ ہُم نہ گھڑے۔
(مِسی کأ) کہ یئت یام میس (نہ) بنے کہ افسوس مھی کوتاہی زید، کامیک یأ اللہ سی حق می کوا ییؤدود، آں آ دا صرف ٹوقے کوؤدود۔
یا یام بنے کہ کو اللہ مھیئے ہدایت کیشو مأ ہُم پرہیزگارا می ہونیندے۔
یا عذاب پیشتے میس بنے کہ "کاش! (دُونیئی گے) بھی اے پیرا واپس ہوؤ نصیب ہویدے دَ آ ہُم نیک خلگا می شامل ہیئی دے"۔
(اللہ بننین) کئی نأ! مھی آیات تھیئے اَوئیشی خو تأ تھأ نہ منئی آں تکبر کی، آں کأفرا سیت دھرُو۔
آں تأ قیامت سی دی ہأ خلگا سی شکل کِݜن کاک پشنین کہ اللہ زید لوو سَوؤدود، اَیا تکبر کوؤ والا سی پوت دیزوخ نو تُھو؟
آں اللہ تھأ خلگائے (دیزوخ ما) خلاصی دینین کآم یأ اللہ ما بھیدی، تھیت نأ دا تھأئے کی تکلیف اَوونین آں نأئی تھیئے غمجن ہونین۔
اَںئی اللہ ہر شیئی سی پیدا کوؤ والا تُھو، آں اَںئی سے ہر شیئی زید نگران تُھو/
آسمانا سی آں دھیرین سی کنجی تیس کیش تھی، آں کآم یأ اللہ سی آیادا سی انکاری ہُوئیو اَںئی تھیئے تاوانی دھرنین۔
(اے پیغمبرؐ!) تو ہائے بَن کہ "اے جاہلا ہانا! کئی تھو مھیئے (ہُم) دُوئی یِسی عبادت کوؤ سی بندی؟"
آں (اے پیغمبرؐ!) تھیزید آں تھأ ما موش کآم (پیغمبر) لھنگئیدیو تھأزید اَںئی اے وحی پیا گیژی کہ (اے انسانأ!) کو تأ شرک کیو چھی ٹول عمل برباد ہونین، آں تأ نقصان بھا کوؤ والا آ می ہونین۔
بلکہ تو دا اللہ سی عبادت کو آں تِسی عبادت گذار آ می شامل ہو۔
خو ہیئے خلگے اللہ سی تھامو قدر نی کی کھامو کوؤ پکار اَشو، حال أ چھی کہ قیامت سی دی ٹول دھیرین تِسی اے مِٹ می ہونین، آں آسمان (کاغذ سی شانے) پلڑیل تِسی سُوون ہات می ہونین، سے پاک تُھو آں ہین شرک ما چیر اُوچات تُھو۔
آں (کے) بیشیل بھا گأو کا یأ آسمانا می آں دھیرین می تُھوو تی بے ہوش ہونین، سیوائے تھیئے کیس اللہ بچ کوؤ نیمادوو، بھی دھوئم پیرا بیشیل بھا گأو ٹولے ایکدم اُوشنین آں (حیران ہیدے) بوا یینین۔
آں (محشر سی دی) دھیرینے تنو پروردگار سی نور تے پلگنین، آں عمل نامہ مخامخ تھا بژنین، آں پیغمبر آں دأل گواہ حاضر کوا بژنین، آں خلگا سی مِیئے انصاف تے فیصلہ کوا بژنین، آں ہأزید کی ظلم کوا نہ بژنین۔
آں ہر ماݜ کے تِسی عملا سی پورا پورا بدل دیا بژنین، آں اللہ یے ہین ٹول کما سی پتہ چھی۔
آں کأفر ٹولی ٹولی آ می دیزوخ سی دِشکے ریوان کوا بژنین، کا وخہ یأ دیزوخ نھیئی ہیو تِسی درواز کولاؤ کوا بژنین، آں تھائے تِسی څوگیدارے بننین: "کئی تُھن کأن گے تھوئے ما پیغمبر نہ اَئیشی، کآم یأ تھوئے تُھن پروردگار سی آیت بُھوژؤدود، آں مے دی سی ییؤ ما بھیؤدود؟"، تھیئے بَننین: "کئی نأ" خو عذاب سی وعدہ کأفرا زید پورا ہیدے گأ۔
ہأئے بنا بژنین کہ: (بیا مھیرے) دیزوخ سی دروازیدے لھنگا، تِسی مِیئے مُوا دھرو سی کأ، بس اَمن گھن گھنڈو والا سی کأ لاݜ پوت تُھو۔
آں کآم یأ تنو پروردگار ما بھئیشی تھأ ٹولی ٹولی آ می جنت سی دِشکے ریوان کوا بژنین، کا وخہ تیس کے نھیئی ہُوئیو تِسی در (موش ما) کولاؤ ہونین، تِسی څوگیدار (مُلیکائے) بننین کہ "تھوزید سلام ہوئے، تھو غورا خلک تھی، بس ایمی مُوا سی کأ لھنگا"
آں تھیئے بننین: "اللہ سی شکر تُھو، کی یأ مھوزید تنو وعدہ سأسکے پورا کی، آں مھو مے دھیرین (جنت) سی وارث سیوأد، کہ مھو جنت می کھیت اِی نیمادیو دھیری، بس غورا عمل کوؤ والا سی کأ بدلہ ہُم غورا تُھو۔
آں (اے پیغمبرؐ!) تأ مُلیک پشنین، عرش سی چاپیرا کورگول سَویل تنو پروردگار سی حمد و ثناء کونین، آں (اَںئی اے دی) خلگا سی مِیئے انصاف تے فیصلہ کوا بژنین، آں بنا بژنین کہ "ٹول صفت تے اللہ سی تھی کآم یأ ٹول جہانا سی رب تُھو"۔
حا میم
أ کتاب (یعنی قرآن) اللہ سی دِشا آپ تُو، (کآم یأ) چیرگن غالب جنو والا تُھو۔
بگوشُو والا گناہ آ سی آں توبہ سی قبول کوؤ والا، سَخ عذاب سی دیؤ والا، چیرگن شان والا، نُو تُھو دُوئی یام عبادت سی لائق اللہ ما علاوہ، ہُم اللہ سی دِشکے واپس بژو تُھو۔
لات نہ کودی اللہ سی آیادا می، اَسے سے خلک کآم یأ کأفر تھی، دَ دوکہ نہ دو تھوئے ہین خار آ می ییؤ بیؤ۔
لوو گھنُوشو میس ما موش قوم نوحؑ، آں دأل ڈلہ یے تیما بعد، آں ارادہ کی ہرے اُمت ے یرأ گیݜی تنو پیغمبر، آں أ لات کؤدود ناحق بأت زید، مِسی کأ ناکام کیئی میدے حق، دَ مأ گأد تھأ، دَ کھال اَشو مھی عذاب؟
آں مھاموڑ ثابت ہی بات چھی رب سی تھأ خلگا زید کآم یأ کأفر تھی، بیشک سے دیزوخی تھی۔
کامے مُلیگے یأ عرش اُوچات کیدو آں کامے مُلیک یأ چاپیرا تھی، سے اللہ سی تسبیح و صفت بیان کودی، آں ایمان ساتدی ایزید آں دعا نیمادی تھأ خلگا سی کأ سے مومن تھی، اے اللہ ہرے شیئی چھی قبضہ می تُھو، تنو رحمت و علم دے بگوش تھأ، کآم یأ بوبہ گاہ ہُو آں چھی پَن دے روان ہُو، آں سات تھأ دیزوخ سی عذاب ما۔
اے مُھن پروردگار! داخل کو ہأ باغ آ می مُوآ دھرُو سی، کِسی یأ تأ ہأسید وعدہ کیژی، آں تھأ (خلک) کآم یأ ہین بوب داد ڇھی آں اولاد می نیک تھی، بیشک تُو زبردست حکمت والا تُھو۔
آں سات ہأ تکلیفے ما، آں کیس تأ ساتو تکلیفے ما تے دی، دَ بیشک تأ تیزید رحم کی، ہُم أ گھین کامیابی چھی۔
بیشک کامے خلک یأ کأفر تھی تھأئے آواز ہونین، کہ ناراضگی (تھوما) اللہ سی چیر گھین چھی تُھن تنو اَمن زید ناراضگی ما، کے یأ تھو نیما بژودود ایمان سی ڈھأر کے، دَ تھو انکار کؤدود۔
(ہیئے) بننین: اے مُھن پروردگار! تأ مھو مَئی دُو پیرائے، تأ مھو جینی کی دُو پیرائے، دَ مھوئے اقرار کی تنو گناہ آ سی، دَ کی پان چھی بھار کے نُخو سی؟
أ تھوزید مِسی کأ یرأ، کے یأ تھوئے اَمن سید اللہ سی دعوت دیا بژودود تھو انکار کوؤدود، آں کے یأ تیسید شریک کوا بژودود تا تھو منودود، دَ (مھیرے) حکم اللہ سی تُھو، چیر گھن اُوچات مقام والا تُھو۔
(اللہ) سے ذات تُھو یأ پشادُو تھوئے تنو نَخ، آں پیدو تھوئے آسمان ما رزق، آں نصیحت تا صرف سے گھیندی کآم یأ تِسی دِشکے نُڑدی۔
دَ یاد کوا اللہ، خالص تِسی بَن ہیدے، آں کو کأفر آئے کھیدیک ہُم خوش نہ ہودُوو۔
سے اُوچات درجہ والا عرش سی مالک، وحی پیدو تنو حکم دے تنو بَن آ ما کیزید یأ نیمؤسأدو، مِسی کأ یرأ ملاقات سی دی ما بھیئے۔
کامے دی ہیئے بھار تے نُخنین، بیریت نہ ہونین ہین کی شیئی اللہ ما، (توَس کوا بژنین) "کسی کأ حکومت چھی اژوک دِیئے؟" (جواب دیا بژنین) "اے اللہ سی یأ سے (ٹولا زید) زوروڑ تُھو"۔
آش بدل میلاؤ ہونین، ہر نفس کے تِسی کأ کا یأ تی کیدوو، آش کی زیأتیئی نہ ہونین، بیشک اللہ جلد حساب گھینو والا تُھو۔
آں ہأ بھیا نھیو ییؤ والا دی ما، کے یأ حی یے غم سی وجہ دے أں یے یے نین، ظالم آ سی کی سأت نہ ہونین، نأئی سفارشی سی بات منا بژنین۔
(اللہ) جندو أشی آ می بوریل بأت ما، آں (تیما ہُم) کا یأ حی آ می بوریل تُھو۔
اللہ فیصلہ کودو انصاف تے، آں سے یأ اللہ ما علاوہ کیسکے ہاگادی دا، سے فیصلہ نہ کوبھادی کی شیئی سی، بیشک اللہ سے تُھو یأ بُھوژدو ہُم پشدو ہُم
کئی، ہیئے دھیرینے گئیدے میس نہ بُو کہ کھأکأ ہُو انجام تھأ خلگا سی کآم یأ اَشیئی ہیئے ما موش؟ اَشیئ سے ہیئے ما چیر سَخ، طاقت می آں دھیرین سی نَخا می، بھی اللہ تھأ گأد تھین گناہ آ سی وجہ دے، نہ اَشو یام تھأ اللہ ما بچ کوؤ والا۔
أ مِسی کأ تھأئے ییؤدود تھین پیغمبر اَخکارہ نشانی آ سمانے، دَ سے انکار کوؤدود تہ تھأ اللہ گأد، بیشک سے طاقت والا سخ عذاب سی دیؤ والا تُھو۔
آں بیشک پیؤشو مھوئے موسیٰؑ تنو نخے سمانے آں اَخکارہ دلیل سمانے،
فرعون آں ہامان آں قارون سی ڈھأر کے، دَ تھیئے بنو (ہے) جادوگر تُھو گھن لووال تُھو۔
بھی کے یأ ہے آپ تھین کأن گے مُھن دِشا حق دین سمانے، تھیئے بنو: "لؤ ما تھأ خلگا سی کی یأ ایمان اَنودو تھیئے سمانے، آں جین چھوا تھین ڇھی، آں نو تُھو چال کأفر آ سی اَسے ناکام"۔
آں فرعون بنو: "مھأ چھوا دا آ موسٰیؑ مادُو، آں ہے نیمے تنو رب، بیشک آ بھیدُو مے بأت ما کہ اِی بدل کونین تُھن دین، یا اخکارہ کونین دھیرین می فساد"۔
آں موسٰیؑ بنو: "مأ پناہ نیمادتُو تنو رب ما آں تُھن رب ما، ہر کبرجَن ما یأ سے ایمان نہ لردُو حساب سی دی زید"۔
بنو اے ماݜ ایماندار فرعون سی قوم ما، سے بُرؤدود تنو ایمان (تی بنو:) "کئی تھو مادی مھال ماݜ کہ سے بندو مھی پروردگار اللہ تُھو؟ آں بیشک تی تھوئے انودو روخانا دلیل، تُھن پرودگار سی دِشا، آں کو سے لووال اَشوو دَ تِسی لوو سی نقصان تیزید تُھو، آں کو سے سأس بَندوو تھوزید وونین دھأک تے عذاب ما کِسی یأ سے تھوزید وعدہ کودو، بیشک اللہ پان نہ پشادُو تیس کے یأ سے حد ما نُوخیل آں لووال ہُوو۔
اے مھی قوم سی خلگ ہانا! آش بأچیئی تُھن چھی، تھو غالب تھی دھیرینے، کو اللہ سی عذاب آپ مھوزید دَ کی مُھن مدد کونین؟ فرعون بنو: "آ تھوئے تے پان پشادو کیس یأ آ صحیح گھندو، آں پان نہ پشادُو مگر پان ہدایت سی"۔
بنو تی ماݜ کی یأ ایمان اَنوشو "اے مھی قوم (سی خلک ہانا!) بیشک آ بھیدو تھوئے ما، مھال دی آ سی شانے (کھال عذاب یأ) موشُک ڈلہ آ زید آبوشو"۔
(تُھن حال ہُم مھاموڑ نہ ہوئے) کھال یأ قوم نوحؑ آں عادؑ آں ثمودؑ (سی شانے ہی شی) آں سے خلک یأ ہیئے ما بعد اَئیشی، اللہ نہ خوشادُو ظلم سی کوؤ تنو بندہ آزید۔
آں اے مھی قوم (سی خلک ہانا!) بیشک آ بھیدو تھوئے ما چیگأ سی دی ما۔
کامے دِیئے تھوئے پدیئے ڈینین، نہ ہونین تُھن کأ یام اللہ ما بچ کوؤ والا، آں کیس یأ بے پَن آ کی اللہ، دَ نو تُھو تِسی کأ پان پشؤ والا۔
بیشک ایما موش تھوئے یوسفؑ ہُم آبوشو اَخکارہ نخے سمانے، دَ ہمیشہ تھو اَشیئ شک می، کے یأ سے وفات ہُو دا تھوئے بنو، اللہ یئت ہُم ایما بعد پیغمبر نہ پےنین، مھاموڑ اللہ ہدایت ما ساتدو کآم یأ حد ما نُخودی، شک کودی۔
کآم خلک یأ لات کودی، اللہ سی آیادا می دلیل ما بغیر، یأ أپچی ہأئے، چیر نہ خوشادُو اللہ، آں تھأ خلگا سی نیز تھیئے ایمان اَنودو، مھاموڑ اللہ مہر ݜژادُو ہر کبرجَن سرکش سی حی زید۔
آں بنو فرعون "اے ہامان! مھیئے اے اُوچات مُنارہ سَوا، مِسی کأ آ تھأ پَن آئے اَووئی،
کآم یأ آسمان آ سی پَن تھی، بھی آ بُوئی موسٰیؑ سی خدا یے، بیشک آ گمان کودو تیزید لووال سی"، آں مھاموڑ غورا معلوم ہُو فرعون گے تِسی خراب عمل، آں (سیدا) پَن ما منع ہُو، نہ اَشو چال فرعون سی مگر تباہی می۔
آں بنو تی ماݜ کی یأ ایمان اَشو "اے مھی قوم! تھو مھپیش یا، آ تھوئے پان پَشئی نیگی سی"۔
اے مھی قوم! أ جیدون عارضی تُھو، آں یقیناً آخرت سی جیدون آرام سی تُھو۔
کی یأ عمل لاݜ کی دَ بدل میلاؤ نہ ہونین تیسکے مگر تِسی برابر، آں کی یأ عمل کی غورا، سے ماݜ تُھو کو ڇھی، آں سے مومن تُھوو، دَ ہُم ہیئے خلگے جنت کے لھنگا بژنین، رزق میلاؤ ہونین ہأئے تیمی بے حسابہ۔
آں اے مھی قوم! کا بات چھی آ دعوت دیدو تھوئے بچ کوؤ سی دِشکے، آں تھوئے مھیئے دعوت دیدی آنگا سی دِشکے؟
تھو مھیئے دعوت دیدی مِسی کأ یرأ آ انکار کیئی اللہ ما، آں شیریک گیݜی تیسید تے شیئی کامیک سی نُو تُھو مھیئے کی علم، آں آ دعوت دیدو تھوئے دِشکے چیر زبردست بگوشو والا سی۔
کی شک نی چھی، بے شک تھو تے شیئی سی دِشکے مھأ نیمادی، تھأئے دعوت دیا نہ بژبھاژی، نأ دُونیئی می نأئی آخرت می، آں مھوئے بژو تُھو اللہ سی دِشکے، آں حد ما نُخو والا دیزوخی تھی۔
دَ جلد تھوئے یاد کونین یأ آ تھوئے بندُو، آں آ تنو معاملہ اللہ یے حوالہ کودُو، بیشک اللہ بندہ آئے بودو۔
دَ ساتُو تیس اللہ شَر ما یأ مُکر تے تھیئے کیشی، آں گیر کی فرعون سی خلک خزا عذاب می۔
آنگا تُھو، تِسی مُشکے مُخامخ کوا بژنین ہیئے ڙاد و نأشاما، آں کامے دی قیامت ہُوو تھأ حکم ہونین کہ تَھلا فرعون سی خلک تے سخ عذاب کے۔
آں کے یأ ہیئے لات کونین آنگا می ایکدوئی سیت، دَ کمزور خلگے تھأئے بننین کآم یأ اَمن گھن گھنودود، بیشک اَشیئ مھو تُھن تابع، دَ تھو مھوئے ما دُھو کوا دھأک حصہ آنگا سی۔
بننین تھیئے خلگے کآم یأ اَمن گھن گھنودُود "بیشک مھو بُٹ ایمی تھی، بیشک اللہ فیصلہ کیژی بَن آ سی مِیئے"۔
آں بننین تھیئے خلگے کآم یأ آنگا می تھی، دیزوخ سی واگدا آئے: "تنو پروردگار کے بنا سے دھأک کم کوے کآں عذاب اے دی سی کأ"۔
بننین (تھیئے واگدا مُلیگے) "کئی نییؤدود تھوئے تُھن پیغمبر اخکارہ نخے سمانے؟" بننین: "کئی نأ" تھیئے بننین: "دَ (مھیرے) تھو دعا کوا" آں نُو تُھو کأفر آ سی دعا مگر بیکارہ۔
بیشک مھو خامخا مدد کودی تنو پیغمبر آسی آں تھأ خلگا سی کی یأ ایمان اَنودُو، دونیئی سی زندگی می، آں کامے دی یأ اِیڑی ہودی گواہ۔
آں کامے دِیئے نفع نہ دینین ظألیمائے تھین عذر، آں تھین کأ لعنت چھی، آں تھین کأ خراب شیر چھی۔
آں بیشک مھوئے موسٰیؑ یے دید ہدایت، آں وارث سیوأد مھوئے بنی اسرائیل کتاب سی،
ہدایت آں نصیحت چھی عقل سی کھمن آ سی کأ۔
دَ صوو کوا، بیشکہ وعدہ اللہ سی سأز چھی، آں معافی نیما تنو گناہ سی، آں پاکی بیان کوا تنو پروردگار سی، نأشاما آں ڙادا۔
بیشکہ کآم خلک لات کودی اللہ سی آیادا می، بغیر کی دلیل تھأئے ییؤ ما، نُو تُھو تھین حی آ می اَسے گھینیئی سی تکبر، یأ تیسکے تھیئے یئت نہ اَوونین، دَ اللہ سی پناہ نیما، یقیناً سے ہر کی بُھویو والا پشُو والا تُھو۔
بیشک پیدائیش آسمانا سی آں دھیرین سی چیر گھین چھی خلگا سی پیدائش ما، اَسے اکثر خلک نہ جندی۔
آں نی تھی برابر اَن آں پشُو والا، آں کامے خلگے ایمان اَنو آں نیک عمل کی، ہے آں بدکار برابر نی تھی، چیر کم تھو نصیحت گھیندی۔
بیشکہ قیامت ییؤ والا تُھو، تیمی کی شک نی چھی، اَسے اکثر خلک یقین نہ ساتدی۔
آں بنو تُھن پروردگار "مھیئے ہگا، آ قبول کودُو تُھن دعا، کامیک خلک اَمن گھینی کودی مھی عبادت ما، چیر جلد لھنگنین دیزوخ کے بے عزتا ہیدے"۔
اللہ سے ذات تُھو تی پیدا کی تُھن کأ ڙات، مِسی کأ کہ تھو آرام کوا اِسمی، آں دی پشُو سی کأ (پیدا کی)، بیشک اللہ مہربان تُھو خلگا زید، اَسے اکثر خلک شکر نی نیگھلدی۔
ہُم اَںئی اللہ تُھو تُھن پروردگار، ہر شیئی سی پیدا کوؤ والا، نُو تُھو یام اِیزما علاوہ عبادت سی لائق مگر ہے تُھو، دَ تھو کامے دِشکے ریوان تھی؟
مھاموڑ سے خلک ہُم روان اَشیئ، کآم یأ اللہ سی آیادے ما انکار کوؤدود۔
اللہ سے ذات تُھو تی سوأدچی تُھن کأ دھیرین آرام سی پوت، آں آسمان تُھن کأ چَت (سواد)، آں تُھن شکل سواد تہ شکل اِی شیژو سواد، آں رزق دید تھوئے پاک شیئیئے ما، ہُم أ اللہ تُھن پروردگار تُھو، دَ چیر برکت والا تُھو اللہ، رب ٹول جہانا سی۔
ہُم ہے (اللہ) ہمیشہ جَن تُھو، نُو تُھو یام عبادت سی لائق تیما علاوہ، دَ تھو عبادت کوا اِسی تنو دین تِسی کأ خالص کیدے، ٹول صفت اللہ سی کأ تھی، سے پروردگار تُھو ٹول جہانا سی۔
تُو بَن (اے محبوبؑ!) بیشک آ منع کوا گودُو، کہ آ عبادت کیئی تھین کامیگا سی یأ عبادت کودی تھو، اللہ ما علاوہ، (میما بعد) کے یأ اَئی مھیئے مھی پروردگار سی دِشا اخکارہ نخ، آں مھیئے حکم ہُودو کہ تابعدار ہیئی پروردگار دُوںئی جہانا سی۔
ہُم سے تُھو کی یأ پیدا کی تھو سُم ما، بھی نطفہ ما، بھی ڙات سی ٹوٹا ما، بھی تھو لؤ نگھلا گئی (ییئی سی ڈھے ما)، بھی تھو (گھینی کودو) کہ تھو پورا تنو زوأنی یے آوا، بھی تھو ڈھیگی ہوا، آں بعض تھومی سے تھی کہ مونین میس ما مُوش، آں مِسی کأ کہ تھو اے مقرر وخ کے آوا، آں مِسی کأ کہ تھو جَنا۔
(اللہ) سے ذات تُھو جینی کودُو آں مادُو، دَ کے ہے فیصلہ کودو کآں اے کم سی، دَ صرف میس بندو تیس تے، "ہو" دَ سے ہودُو۔
اَیا تُو نہ بودو تھأ خلگائے، یأ سے لات کودی اللہ سی آیادا می؟ ہے کامے دِشکے روان تھی؟
سے (خلک تھی) کی یأ لوو گھنو کتاب، آں تیس کا یأ مھوئے پیؤشو تنو پیغمبر زید، دَ چیر جلد ہیئے جَننین،
کے یأ طوق ہونین ہین چونجو آزید آں زنزیرے، ہیئے ݲھگلا بژنین،
خُوروگیل اُو می، بھی آنگائے تھلا بژنین،
بھی تھأئے بنا بژنین، "کھیدتی سے یأ تھو شریک کوؤدود (اللہ سید)،
اللہ ما علاوہ؟" تھیئے بننین: "ہأڙأد مھوئے ما، بلکہ مھوئے عبادت نی کیشی میما موش کی شیئی سی، مھاموڑ بھأویڑی کونین اللہ (تھأ) کأفر۔
(تھأئے بنا بژنین) أ تھوزید مِسی کأ کہ تھو خوشحال اَشیئ دھیرین زید ناحقہ، آں مِسی کأ کہ تھو مشروٹ اَشیئ،
لھنگا دیزوخ سی دروازہ می، تھوئے ہمیشہ ہونین اِسمی، دَ چیر لاݜ پوت تُھو کبرجَن آ سی کأ۔
دَ (اے پیغمبرؑ!) صوو کو، بیشکہ اللہ سی لوظ سأزأل تُھو، کو مھو تھوئے پشَئی بعض (حصہ تے عذاب سی) کسی یأ مھوئے ہأسید وعدہ کیژی، یا مھو روحہ نِگھیلی تُھن، بھی ہُم مُھن دِشکے ہأئے ییؤ تُھو۔
آں پیئشی مھوئے تھأما موش پیغمبر، یام ہیئے ما سے اَشیئی کامیگا سی حال مھوئے تھیئے بیان کیشو، آں زینی سے تھی یأ تھیئے (تھین کی) بیان نی کیشو، نہ اَشُو کی حق اے پیغمبر سی یأ سے اَنے کی معجزہ مگر اللہ سی حکم دے، بھی یأ کے اَپ تا حکم اللہ سی، دَ فیصلہ ہی انصاف تے، آں تاوان والا ہُوئی تے وخ می ناحق سی سأت۔
اللہ سے ذات تُھو پیدا کی تُھن کأ څاروئی، مِسی کأ تھو سورلی کوا زینی تھأما، آں زینی تھو کھا۔
آں تُھن کأ ہأمی (دُوئی ہُم چیر) فائدہ تھی، آں مِسی کأ کہ ہأزید تھو تنو حی آ سی حاجت کے اَوودی، آں ہأزید آں کشتی زید تھو سورلی کوبھادی۔
آں (اللہ) پشادُو تھوئے تنو قدرت، دَ اللہ سی کامے قدرت ما تھو انکار کودی؟
کئی ہے نہ گوئیدی دھیرینے، دَ ہیئے بُونیندے کھال ہُو انجام تھأ خلگا سی کآم یأ ہأما موش اَشیئ؟ سے ہیئے ما چیر اَشیئی، چیر طاقت آں نخ دھرأدے آں دھیرین زید، دَ کم می نہ اَپ سے کامیک یأ ہے کوؤدود۔
دَ کے تھین پیغمبر اَئی تھین کأن گے اَخکارہ نخے سمانے، دَ تیزید خوشحال دھرئی کامے علم تھأکیش اَشُودا، آں تی شیئیے تھأ گیر کی کِسی یأ ہے پشاڑے کوؤدود۔
دَ کے یأ تھیئے ڈیڈ مُھن عذاب، تھیئے بنو: "مھوئے اے اللہ زید ایمان اَنو، آں انکار کی تھأ معبودا سی کآم یأ مھو شریک کوؤدود"۔
کے یأ ہیئے مُھن عذاب ڈیڈ تا ہین ایمان ہین کی کم نہ اَپ؛ أ اللہ سی دستور تُھو، کامیک یأ لھنگودُو تِسی بن آ می، آں تھید کأفرے نقصان بھا کی۔
حا میم (اللہ تعالی غورہ جندو مھأ حروف آسی معنی ما)۔
أ (قرآن تے اللہ) سی ڈھأرا وادتو یأ سے چیر مہربان رحیم تُھو۔
مھال کتاب یأ تِسی آیت تفصیل دے بیان کوا گئیدی، عربی جیب سی قرآن تے قوم سی کأ یأ سے جندی۔
زیرے دیؤ والا بھیؤ والا، خو ہأمی چیرے مُو نوڑاد، آں سے ہاڈو بُھوژدی ہُم نأ۔
آں (پیغمبرؐ کے) بندی مُھن حی آمی پردا تھی، تِس ما یأ کِسی تو مھوئے دعوت دیدو، آں مُھن کن آ می اُگاچا تُھو، آں مُھن و تُھن مِیئے پردہ تُھو، پس تھو تنو کام کوا، مھو تنو کام کیئی۔
بن )اے پیغمبرؐ!) آ ہُم تُھن شانے انسان تُھو، (خو) مھیزید وحی ووژی، کہ تُھن معبود اے معبود تُھو، تھو تِسی دِشکے سیدا ہوا، آں تیما معافی نیما، آں مشرکین آزید افسوس تُھو،
کآم یأ ذکواۃ نے دیدی، آں مِسی کأ کہ سے آخرت سی انکار کوؤ والا تھی۔
بیشکہ سے خلک یأ ایمان اَنودو آں نیک عمل کیدی، ہین کأ مھال اَجر تُھو یأ سے لھسو سی نو تُھو۔
بَن (اے پیغمبرؐ!) کئی تھو تے ذات ما انکأری تھی، یأ تی دھیرین دو دی آ می سوأدچی، آں تھوئے تِسی مقابلہ می دأل شیریک گأدتی؟ اَںئی سے تمام دُونیئی آ سی ڙݜاندر تُھو۔
آں تی اِسی ڙید کھن اِیڑی کی، آں دھیرین می برکت تھیئی، آں سواد ایمی اندازہ دے سامان چؤ دی آ می، سوال کوؤ والا سی کأ اے شان سی۔
بھی سے مخامخ ہُو آسمان سی دِشکے، آں سے دھمی أشی، دَ تی آسمان گے آں دھیرین گے بنو: "تھو یا خوشحألی دے یا ناحیہ"، سے بندی مھو خوشحالی دے یے دی۔
بھی تی دو دی آمی سات آسمان سوأد، آں ہرے آسمان گے تِسی کم سی حکم کی، آں مھوئے دونیئی سی آسمان تاء ئیدے شیژیئی کی آں محفوظ کی، أ نتظام تُھو زبردست غالب آں جنو والا سی۔
بھی یأ کی مُو نوڑاد، دَ بَن (اے پیغمبرؐ!) کہ آ تھو بھیادو تے آواز ما کھأکأ یأ عاد و ثمود آواز ما بھأدیشی دا۔
کے یأ پیغمبر ہین مُوشا اَئی آں پیاشا اَئی، (میس بیندے کہ) اللہ ما سیوا دُوئی یِسی عبادت نہ کوا، دَ تھیئے بنو: "کو مُھن پروردگار نیمادوشوو مُلیک وال نیندے، دَ مھو نہ مَندی کا شیئی سی کأ یأ تھو پیا گئیدی"۔
بھی یأ قوم عاد سی بات چھی دا، تھیئے ناحق دھیرینے اَمن گھن گھنو، آں بنو کہ مھو ما کآم چیر زوروڑ تُھو؟ دَ کئی سے نہ پشدی کہ اللہ کی یأ تھأ پیدا کیدی دا، سے ہیئے ما چیر زیاد زوروڑ تُھو، آں سے مُھن آیادے ما انکار کودی۔
آخر مھوئے دھأک اِسپور دی آمی سخت طوفانی عذاب ہأپیش پیو، کہ مھو ہأئے دونیئی سی جیدون می ذلیل کوؤ والا عذاب دئی، آخرت سی عذاب تا چیرے ذلیل کوؤ والا تُھو، آں ہین کومک ہُم کوا نہ بژنین۔
آں کامے قوم ثمود تُھو دا، مھوئے تھأئے سیدا پان پشأدیشی، دَ ہیئے ہدایت گھینو سی پوت (أݜیئے) اَن ہوؤ خوشاد، دَ تھأ اے ذلیل کوؤ والا عذاب سی آواز گأد، تھأ کما سی وجہ دے یأ سے کوؤدود تا۔
آں مھوئے بچ کی ایمان والا آں کآم یأ (اللہ ما) بھیودود۔
آں (تے دی سی خیال کوا) کامے دی یأ اللہ سی دشمن آنگا سی دِشکے جمع کوا بژنین، دَ تھیئے ٹولی آمی بھوگوا بژنین۔
مھیدا پورے کہ: کے یأ ہیئے (آنگا سی) خوائے اَوونین دا ہین کنے، أشئے، آں چَم ہین خلاف شیدی دےنین، تھأ کم آسی یأ سے کوؤدود۔
آں تھیئے تنو چم آئے بننین: "تھوئے مُھن خلاف کئی شیدی دید؟" تھیئے بننین: "مھوئے تی اللہ اِشبان دید کہ سے ہرے شیئیے اِشبان دیدو، آں تی تھو اول پیرا پیدا کی آں تِسی دِشکے تھوئے واپس نَیا بژنین"۔
آں تھو نی بری بھوؤدود (مے بأت ما) کہ گواہی دَن تُھن خلاف تُھن کن، آں نأئی تُھن أݜی، آں نأئی تُھن چم، خو تھوئے مے گمان کی کہ اللہ تھأ چیر بأدے ما نہ جندو کا یأ تھو کودی دا۔
آں تُھن می گمان، کا یأ تھوئے تنو رب سی بارہ می کی دا، تھو برباد کی، دَ تھو تھأ خلگا ما ہوئی کی یأ خسارہ کی۔
دَ کو ہیئے صوو کیو ہُم آنگا ہین دھرو سی پوت تُھو، آں کو ہیئے معافی نیمأدو سے (ہُم) منو والا نی چھی۔
آں مھوئے ہین کأ (شیطان) سأت مقرر کی، دا تھیئے ہین کأ ہین مُشیم آں پیشیم عمل شیژیئی کی، آں سے (سزا سی) بات ہأزید ہُم پورا ہی کامیک یأ ہیئے ما موش اُمت آزید کوا گیشی دا، پَیر و انسان آمی، یقیناً سے خسارہ می اَشئی۔
آں بنو تھیئے خلگے کی یأ کفر کیدو دا کہ "مے قرآن نُو بُھوژا، آں اِسی میِئے زوگ سَوا کہ تھوئے برئی ہوئے"۔
دَ مھوئے خامخا چکھانین تھأ خلگائے سخت عذاب، کی یأ کفر کیدو، آں مھوئے تھأئے تھین کما سی لأݜ بدل دے نین۔
أ آنگا اللہ سی پدندا آئے بدل چھی، ہین کأ ایمی مُدأمی شیر ہونین، أ تِسی سزا چھی کہ سے مُھن آیادا سی اِنکار کوؤدود۔
آں تھیئے خلگے یأ کفر کیدو بننین: "اے مُھن پروردگار! انسان و پَیر آ می یأ مھو گمراہ کیدی دا تھأ مھوئے پَشا، مھو تھأ تنو کُھو آسی ٹین چغڑا کیئی دا سے غورہ ذلیل ہون"۔
یقیناً سے خلک یأ بندی مُھن رب اللہ تُھو، بھی سے (تیزید) محکم اِیڑی ہوئی، دَ ہأزید مُلیگے وونین کہ تھو نہ بھیا آں نأئی خپا ہوا، آں ہأئے تے جنت سی زیرے دا کامیک سی یأ وعدہ کوا گیشی۔
مھو تُھن سأت اَشئی دُونیئی سی جیدون می ہُم آں آخرت می ہُم، آں تھید کامے نعمت کأئی تُھن حی منوو تُھن کأ ہونین، آں تُھن کأ تِسمی تھیئے شیئیے ہونین یأ تھوسید تھین وعدہ کوا گیشی۔
می ملأݜتوب ہونین بوگوشو والا مہربان سی دِشا۔
آں تے ماݜ ما غورہ بات کسی ہونین، یأ سے اللہ سی دِشکے ہاگادو، آں نیک عمل کودو، آں بندو بےشکہ آ مسلمان آ می (شامل) تُھو؟
آں لاݜ آں غورہ اے شان سی نہ ہوبھادی، (دألا سی) لاݜ سی جواب مھال طریقادے دے یأ سے چیر غورہ ہوے، بھی سے ماݜ کہ تھأمی آں تِسمی دُشمینی أشی، (تی مھاموڑ ہونین) یأ سے چھی پوخ سأد تُھو۔
آں أ بات تھأئے میلاؤ ہوژی کی یأ صوو کیو، آں أ بات تیسکے میلاؤ ہوژی کآم یأ نصیب والا تُھوو۔
آں کو تھیئے شیطان سی دِشا کی وسوسہ پیدا ہیو اللہ سی پناہ نیما، بےشک سے بُھوژو والا جنو والا تُھو۔
آں تِسی نخا می ژات آں دی آں سی و یُن تھی، تھو سجدہ نہ کوا سی یے، آں نأئی یُن گے، آں سجدہ کوا تے اللہ یے یأ تی ہأ پیدا کیدی، کو تھو خاص تِسی عبادت کودیو۔
دَ کو ہیئے لوئی کیو سے (مُلیک) یأ چھی رب سی کأشکے تھی، سے تِسی تسبیح کودی، دی و ژات، آں سے نہ ٹھمدی۔
آں تِسی نخا می (أ ہُم تُھو)، کہ تو دھیرین أمیژیل پشدو، دَ کے یأ مھوئے تیزید ہاگا مُژادو ہے تازہ آں گھینی ہوژی، بےشکہ کامے خدا یأ دھیرین آباد کودو، اَںئی اے شأنے سے مئیل جینی کوؤ والا تُھو، بے شکہ سے ہر شیئی زید قدرت لردو۔
بےشک کآم یأ مُھن آیاد آ سی غلط معنٰی نگھالدی، سے مھو ما بوریل نی تھی، کئی سے ماݜ یأ دیزوخ کے تھلا گاو غورا تُھو، یا سے ماݜ کہ قیامت سی دی تی اَمن سی حالت می یے نین؟ بے شکہ کا یأ تھو کودی دا سے (اللہ) پَشو والا تُھو۔
بے شکہ سے خلک یأ انکار کی نصیحت ما، کے یأ تھأئے أپ تا، حالانکہ سے چیر زبردست کتاب تُھو۔
باطل نأ اِسی موشتے یےبھادو آں نأئی پیأشتے، بےشکہ أ تے ذات سی دِشا نازل کویل تُھو یأ سے حکمت والا صفت آسی قابل تُھو۔
(اے پیغمبرؐ!) تھیئے کامے بأت بنا بژدی دا، سے تھأما موش پیغمبرائے (ہُم) بنا گئیدی، بےشکہ چھی رب معاف کوؤ والا آں دڑ دیؤ والا عذاب سی رب تُھو۔
کو مھوئے مے قرآن عربی ما علاوہ جیب می والوشوو، دَ تھیئےخامخہ بننین دے کہ اِسی آیات گئی واضحہ بیان کوا نہ گئیدی؟ دَ کئی (قرآن) عجمی تُھو آں (مخاطب) عربی؟ بَن کہ: یام ایمان اندیو تھین کأ (أ قرآن) ہدایت آں شفاء چھی، آں یام یأ ایمان نہ اَندیو دَ تھین کن آ می اُوگاچا تُھو، آں أ تِھن حق می نہ پشو تُھو، اَںئی ہے خلک تھی یأ ہأئے دُھو پوت ما آواز دیا بژدو۔
آں یقیناً مھوئے موسٰیؑ یے ہُم کتاب دِیدوشو، دَ تیمی اختلاف کوا گا، کو تُھن پروردگار سی دِشا موش ما بات پوخ نی ہیشیو، دَ ہین مِیئے فیصلہ ہیدے بژنین دے، آں ہے اِسی بارہ می شک آں دوکہ می تھی۔
کآم یأ غورہ عمل کودوو تنو کأ کودو، آں کآم یأ لاݜ عمل کودو دا تِسی نقصان تیزید تُھو، آں چھی رب بندہ آزید ظلم کوؤ والا نو تُھو۔
قیامت سی علم اِسی ڈھأر کے کوا بژدو (صرف اللہ یے پتہ چھی)، آں اللہ سی علم ما بغیر نأ دا میوہ تنو کھوگول ما نوخودو، آں نأئی کی جوَئی سی اُمید سوا بژدو، آں نائی تِسی لؤ پیدا ہودو، آں تے دی ہأئے (مشرک آئے) ہاگا بژنین کھیدتی مھی سے شریک؟ دَ تھیئے بننین کہ: مھیرے مھو تھیئے اَںئی مے عرضی کودی کہ مے بأت سی مھوکیش کی گواہ نو تُھو۔
آں ہاڙئینین تھیئے ما تھین شریگے یأ سے تھأئے ہاگوؤدود میما موش، آں تھیئے یقین کونین کہ ہین کأ خلاصئی نی چھی۔
انسان نہ ٹھمدو خیر سی دعا نیموؤ ما، آں کو ایسکے کی بے خیری أبو دَ بھی حی ڈیگادو آں مایوس ہودو۔
آں کو مھوئے ایزید کی رحمت سی مزا چکھأدو، کی لاݜ ما بعد، دَ یقین دے بندو کہ "أ مھی کأ (اَشو)، آں آ قیامت سی ییؤ سی کی گُمان نہ کودو، آں کو آ تنو رب سی خوائے گاو ہُم دَ مھی کأ تیسیت ہُم خوشحألی ہونین"، پس مھوئے خامخا واضح کونین کأفرائے، کائی سے عمل کودی، آں مھوئے خامخا ہأئے سخ عذاب چکھانین۔
آں یئت مھو انسان گے کی نعمت دیدی دا سے (قتنگأریئے دے) بوت گادو، آں ڈھأر کے بژدو، آں کے یأ ایسکے تکلیف آوؤو، دَ بھی ݲگ ݲگ دعا کودو۔
بن (اے پیغمبرؐ!) تھو بوادا کو أ (قرآن) اللہ سی دِشا تُھو، بھی ہُم تھوئے اِسی انکار کیو، دَ تیما گھن گمراہ کی ہونین، کہ سے اسی مخالفت می دھو سی بدنیتی یے اَوو؟
مھوئے چیر شیرتے ہأئے تنو نخ پورا دونیئی (کائنات) می آں ہین تنو اَمن می پشانین، مھیدا پورے کہ ہأئے واضحہ ہوئے کہ بےشکہ أ (قرآن) حق تُھو، دَ کئی أ چھی رب سی کأ کافی نو تُھو کہ بےشکہ سے ہر شیئی زید گواہ تُھو؟
خبردار! ہے تنو رب سید مخامخ ہوؤ سی بارہ می شک می تھی، غورہ بُھویا بے شکہ سے (اللہ) ہر شیئی سی چاپیرا گھیرا تھلو والا تُھو۔
حآ، میم
عین، سین، قاف
(اے پیغمبرؐ!) اللہ سے زبردست آں حکمت والا تُھو تھیزید آں تھأ ما مُوش کامے (پیغمبر) گئیدی تھأزید مھامُوڑ وحی نازل کودُو۔
کا یأ آسمانا می تُھو آں کا یأ دھیرین می تُھو بُٹ تِسی تُھو، آں اَنئی سے بٔوڑے ما اُچات آں بُوڑے ما گھن تُھو۔
نھیو تُھو کہ آسمان ڙیدا پھلے، آں مُلیکا تنُو پروردگار سی صفت سیت تِسی پاکی بیان کودی، آں دھیرین می کآم تُھو دا تِسی کأ معافی نیمادی، یاد ساتا! اللہ چیر بگوشُو والا گھن مہربان تُھو۔
آں کامے خلگے یأ تِسما علاوہ دأل مددگار سَوأت تی، اللہ تھأزید نگرانی کودُو، آں تُو تھین ذمہ دار نُو تُھو۔
آں مھامُوڑ مھوئے مے عربی قرآن وحی سی زریعہ دے تھیزید پیؤدُو، مِسی کأ تُو مرکزی خار (مکہ) آں اِسی چاپ چاپیر والا خبردار کو، آں تے دی ما بھیا کامے دی ٹول جمع کوا بژنین، تِسی ییؤ می کی شک نی چھی، (تے دی) اے ڈلہ جنت کے بژنین آں اے ڈلہ جالیل آنگائے بژنین۔
آں کو اللہ نیمؤدُودو ہأ ٹول اے ڈلہ سَوانیندے، اَسے سے یأ کیس نیمادُوو تیس تنُو رحمت می داخل کودُو، آں کآم یأ ظألم خلک تھی ہین کأ نأ یام حمایتی ہونین آں نأ یام مددگار۔
کئی ہیئے خلگے تیس چھیدے دأل مددگار سَوأت تی؟ سأس تہ أ چھی کہ مددگار دَ اللہ تُھو، آں سے مئیل جینی کودُو آں سے ہر شیئی زید قدرت لَرُو والا تُھو۔
آں تھو کامے بأت می ہُم اختلاف کودی تِسی فیصلہ اللہ سی حوالہ چھی، سے اللہ تُھو، سے مھی پروردگار تُھو، تیزید مأ بھروسہ کیژی آں تِسی دِش کے آ رجوع کودُو۔
سے آسمانا سی آں دھیرین سی پیدا کوؤ والا تُھو، تی تُھن کأ تُھن جنس ما جوڑا پیدا کیدی، آں څاروَئی آ می ہُم جوڑا پیدا کیدی، مے زریعہ دے تھو چَیری کودُو، تِسی کی مثال نُو تھُو، سے ہر بات بُھوژادُو ہر کی پَشادُو۔
آسمانا سی آں دھیرین سی ٹول کنجی تِسی قبضہ می تھی، سے کیس کے نیمادُو رزق چَیری کودُو، آں (کیس کے نیمادُو) تینگی کودُو، یقینا سے ہر شیئی ما جنُو والا تُھو۔
تی تُھن کأ دین سی تے طریقہ مقرر کیدُو کِسی حُکم یأ تی نوح گے دیدُوشُو، آں تیس (اے پیغمبرؐ!) مھوئے تھیئے وحی سی زریعہ دے پیؤدُو، آں تِسی حُکم مھوئے ابراہیمؑ موسیٰؑ آں عیسیٰؑ گے دیدُوشو کہ تھو دین قائم کوا، آں تِسمی اختلاف نہ تَھلا، مُشرکائے سے بات چَیر بُوکھو پَشن ہوژی کِسی دِش کے یأ تُو ہأئے دعوت دیدُو، اللہ خوش کودُو تنُو دِش کے کیس یأ تی نیمادو، آں ہدایت دیدُو تنُو دیش کے تیس کے کآم یأ تیس کے رجوع کودُو۔
آں خلگے تنُو ایکدی سی دشمنی آ سی وجہ دے (دین می) کامے اختلاف تھلودُو دا تِسما بعد تھلودُو کے یأ ہأئے یقینی علم آبوشُو۔ آں کو چھی پروردگار سی دِشا اے مقرر وخہ پورے اے بات مقرر نہ أشیو دَ ہین مِیئے فیصلہ ہونیندے۔ آں کامے خلک یأ کتاب سی وارث سَوا گئیدی مُوشِک خلگے ما پأش، ہے پوخ شک می تھی۔
دَ (اے پیغمبرؑ!) تُو دین سی دِش کے خلگائے دعوت دیا یے، آں کھأکأ یأ تھیئے حکم دیا گودُو دا (مے دین زید) ٹینگ ہو، آں ہأ خلگا سی خواہشات آ پیش نہ بَش، آں بَن: مأ دا تے کتاب زید ایمان آنودُو کامیک یأ اللہ نازل کیدُو، آں مھیئے حکم دیا گودُو کہ آ تُھن میئے انصاف کیئی، اللہ مُھن ہُم رب تُھو آں تُھن ہُم رب تُھو، مُھن عمل مُھن کأ تھی آں تُھن عمل تُھن کأ تھی، مُھن و تُھن میئے (مھیرے) کی بحث نُو تُھو، اللہ مھو ٹول جمع کونین، آں تِسی دِش کے مھوئے واپس ہوؤ تُھو۔
آں کامے خلک یأ اللہ سی بارہ می لات کودی، اِسما بعد کہ (مسلمانے) تیس منودُو، ہین لات ہین پروردگار سی نیز می باطل چھی، آں ہأزید (اللہ سی) غضب چھی، آں ہین کأ سخت عذاب تُھو۔
اللہ سے تُھو تی حق (سی بأت) سَمانے کتاب آں (انصاف سی) ڇیگے نازل کیژی، آں تھیئے کا پتہ ہوبھادُو (شاید؟) قیامت سی وَخ نھیو تُھو۔
کامے خلک یأ ایزید ایمان نہ لردی سے اِسی ییوؤ سی کأ تأدی کودی، آں کی یأ ایمان اَنودُو سے اِسما بھیدی، آں سے جندی کہ ہے حق زید تُھو، خبردار! کآم خلک یأ قیامت سی بارہ می بحث کودی سے گُمراہی می چَیر دُھو گئیدی۔
اللہ تنُو بَنا زید چَیر مہربان تُھو، سے کیس کے نیمادُو زرق دیدوُ، آں سے طاقت سی ہُم مالک تُھو اقتدار سی ہُم مالک تُھو۔
کآم یأ آخرت سی فصل نیمادُو مھوئے تِسی فصل چیری کونین، آں کآم یأ (صرف) دُونیئی سی فصل نیمادُو مھوئے تیس کے ایزما دینین، آں آخرت می اِسی کی حصہ نہ ہونین۔
کئی ہأ (کأفر آ) سی یام مھال شریک تھی تھیئے ہین کأ مھال اے دین مقرر کیژی یأ تِسی اللہ اجازت نی دیدچی؟ آں کو (اللہ سی دِشا) فیصلہ کن بات مقرر نہ أشیو ہین فیصلہ ہونیندے، آں یقین کوا ہأ ظألم آ سی کأ دردناک عذاب تُھو۔
(تے وَخ می) تأ ہأ ظألم پَشنین، ہیئے یأ کا عمل کیدی دا تِسی (وبال) ما بھیل ہونین، آں تی ہأزید ینین، آں کامے خلگے یأ ایمان اَنودُو آں نیک عمل کیدی، تھیئے جنت سی باغا می ہونین، تھأئے تنُو پروردگار ما تی ہرکی میلاؤ ہونین کا یأ ہے نیمادی، أ چیر گھن فضل تُھو۔
ہے سے (شیئی) تُھو اللہ تِسی زیرے تنُو تھأ بَنائے دیدُو کی یأ ایمان اَنودُو آں نیک عمل کیدی، (اے پیغمبرؐ کأفرائے) بَن! آ تھو ما مے (تبلیغ) زید کی اُجرت نہ نیمادُو سوائے رشتہ داری سی محبت ما، آں کامے ماݜ یأ کی نیکی کودُو مھو تِسی نیکی می مزید خوبی سی اضافہ کودی، یقین کوا اللہ چَیر بوگوشُو والا گھن قدردان تُھو۔
کئی ہے خلک مھامُوڑ بندی کہ أ (پیغمبر) مے کلام أمینے سیوأدے اللہ زید لوو سَوادُو؟ حالانکہ کو اللہ نیمادو چھی حی زید مہر ݜژے، آں اللہ دَ باطل ختم کودُو آں حق تنُو کلمادا سی زریعہ دے ثابت کودُو، یقینا سے سینہ می بُریل بأدے ما جندُو۔
آں اللہ سے تُھو سے تنُو بَنا سی توبہ قبول کودُو آں گناہ معاف کودُو، آں تھو یأ کا کودی تِسی علم پورا پورا لردُو۔
آں کامے خلگے ایمان اَنودُو آں تھیئے نیک عمل کیدی سے ہین دعا بُھوژدُو، آں ہأئے تنُو فضل دے دُوئی زیات دیدُو، آں کأفرا سی کأ سخت عذاب تُھو۔
آں کو اللہ تنُو بُٹ بَنا سی کأ رزق چیری کیشُوو دَ ہیئے دھیرین زید سرکشی کونیندے، اَسے سے اے خاص اندازہ دے کھیدیک نیمادُوو (رزق) نازل کودُو، یقینا سے تنُو بنا ما پورا باخبر ہأزید نظر تھوؤ والا تُھو۔
آں (اللہ) سے ذات تُھو سے خلگا سی نااُمید ہوؤ ما بعد ہاگا مُوژادُو، آں تنُو رحمت خور کودُو، آں سے (ٹولا سی) مددگار (ڙݜاندر؟) صفت سی قابل تُھو۔
آں تِسی نخا می آسمانا سی آں دھیرین سی پیدائیش چھی، آں سے ساء والا شیئی کآم یأ تی ہأ دُوںئیا می خور کیدی، آں سے کے نیمؤسأدو ہین جمع کوؤ زید قدرت لَردُو۔
آں تھوئے یأ کا مصیبت اَووئی سے تُھن ہادا سی کوئیل کما آ سی وجہ دے اَووئی، آں چیر کَم دا سے معاف کودُو۔
آں تُھن مجال نُو تھُو کہ تھو دھیرین می اللہ عاجز کوا، آں اللہ ما سیوا نأ تُھن یام دوست تُھو نأئی مددگار۔
آں تِسی نخا می سمندر می کھنا سی شانے (دریابی) جھاز تھی۔
کو تی نیمادو ہوا ایڑی کوے دَ ہیئے جھازے سمندر سی ڈاگ زید ایڑی ہوئیل دھرنین، یقینا اِسمی گھن نخ تھی چیر صوو کوؤ والا سی کأ آں چیر شکر نیگھالُو والا آ سی کأ۔
یا کو (اللہ نیمادو) مے جھاز سی خلک ہین بعض گناہ آ سی وجہ دے ڈُوب کوے، آں سے چیر گناہ معاف کودُو۔
آں کآم خلک یأ مُھن آیادی می لات کودی تھأئے پتہ گھڑے کہ تھین کأ بچ ہوؤ سی کی پوت نُو تُھو۔
تھوئے کا شیئی یأ دیا گودُو دا سے دُونیئی سی زندگی سی سامان تُھو، آں کا یأ اللہ سیت تُھو دا سے تھأ خلگا سی کأ بہتر آں پائیدار تُھو کی یأ ایمان اَنودُو آں تنُو پروردگار زید بھروسہ کودی۔
آں سے گھن گُنائے ما آں بے حیائی سی کمے ما پرہیز کودی، آں کے یأ ہأئے غصہ یےیژی دا ہے معافی کودی۔
آں سے تنُو پروردگار سی بات مَندی آں نماز گُوزادی، آں ہین معاملات ایکدی سے مشورہ دے مقرر ہودی، آں مھوئے ہأئے کامے رزق دیدتُو دا ہے تیس ما (نیگی سی کما می) خرچ کودی۔
آں کے یأ ہأزید زیأتیئی ہوژی دَ ہے تنُو دفاع کودی۔
آں لاݜ سی بدَل لاݜ تُھو، بھی ہُم کی یأ معاف کی آں اصلاح ما کام گھین دَ تِسی ثواب سی ذمہ اللہ گھین چی، یقینا سے ظألم (خلک) نہ خوشادُو۔
آں کامے ماݜ تنُو اَمن زید ظلم ہوؤ ما بعد (برابر سی) بدَل گھینے دَ مھال خلگا زید کی ملامتیا نی چھی۔
ملامتیا دَ تھأزید تُھو یأ سے خلگا زید ظلم کودی آں دھیرین زید ناحق سرکشی کودی، مھال خلگا سی کأ دردناک عذاب تُھو۔
آں کآم یأ صوو ما کام گھیندُو آں معافی کودُو دَ یقیناً ہے گھین ہمت سی بات چھی۔
آں کیس یأ اللہ گُمراہ کودُو دَ اِسما بعد یام نہ تُھو سے تِسی مددگار سَوا بژے، آں کے یأ ظألیمائے عذاب پَشن ہونین دَ تأ ہأ مھامُوڑ بنیل پشنین کہ: "واپس بژوُ سی کی پان چھی؟"
آں تأ ہأ پشنین، کے یأ ہیئے (دیزوخ کے) مھامُوڑ مخامخ کوا بژنین دَ ذلت سی وجہ دے ہیئے ݜا وا کویل نامیل أݜیئیدے دے بُونین، آں کامے خلگے یأ ایمان اَنودُو تھیئے بننین: واقعی اصل خسارہ می سے خلک تھی تھیئے قیامت سی دی تنُو اَمن آں تنُو شیر والا خسارہ می تھلیئ، یاد ساتہ! ظالم خلگے ہمیشہ سی عذاب می ہونین۔
آں ہین کأ مھال کی مددگار نہ ہونین سے اللہ ما علاوہ ہین کی مدد کوے، آں کیس یأ اللہ گُمراہ کیو تِسی کأ بچ ہوؤ سی کی پان نہ ہوژی۔
(خلگا ہانا!) تنُو پروردگار سی بات مَنا، تے دی سی ییؤ ما مُوش (کامے دی) یأ اللہ سی دیشا واپس نہ ہونین، تے دی تُھن کأ کی پناہ سی پوت نہ ہونین، آں نأ کی انکار فائدہ مند ہونین۔
(اے پیغمبرؐ!) دَ أ خلک کو بھی ہُم مُو نرادی و مھوئے تھأ ہأزید کی نگران سَوأدے نہ پیؤدُو، تھیزید بأت سی اَوؤ ما علاوہ کی ذمہ واری نی چھی، (آں انسان سی حال دا أ چھی) کے یأ مھو انسان زید تنُو دیشا کی رحمت سی مزہ چکھادی دَ ہے تیزید لوئی کودُو، آں کو اِسی ہادا کویل عملا سی وجہ دے ہأ خلگائے کی مصیبت اَووژی دَ ہے انسان ناشکرا سَوا بژدُو۔
بُٹ آسمانا سی آں دھیرین سی بأچیئی اللہ سی کأ چھی، سے کا نیمادُو پیدا کودُو، سے یأ کیس کے نیمادُو سیرأن دیدُو، آں کیس کے نیمادُو جدگ دیدُو۔
یا ہأئے جدک او سیرأن دُوںیئدے جمع دے دیدُو، آں کیس یأ نیمادُو بے اولادا سَوادُو، یقیناً سے علم سی ہُم مالک تُھو آں قدرت سی ہُم مالک تُھو۔
آں اے انسان می ہُم أ طاقت نی چھی کہ سے اللہ سیت (مُخامخ) بات کوے، سیوائے مِس ما کہ سے وحی سی زریعہ دے ہوئے، یا کی پردہ آ پأش ما ہوئے، یا کی پیغام دیؤ والا (مُلیکا) پے، دَ سے تِسی حکم دے کا یأ سے نیمادُو وحی سی پیغام اَوے، یقیناً سے چیر گھن شان والا گھن حکمت والا تُھو۔
آں مھامُوڑ مھوئے تھیئے تنُو حکم دے اے روح (قرآن بطور) وحی نازل کیدُو، تھیئے ایس ما مُوش نأ أ معلوم اَشُو کہ کتاب کا تُھو، آں نأ أ کہ ایمان کا تُھو، اَسے مھوئے مے (قرآن) اے نُور سَوادتُو، تِسی زریعہ دے مھو تنُو بَنا می کیس کے یأ نیمادی ہدایت دیدی، آں مِس می کی شک نی چھی کہ تُو خلگائے سیدا پان پشادُو۔
سے اللہ سی پان چھی، تے اللہ سی تِسی اختیار می تھی سے ٹول کا یأ آسمانا می تُھو، آں سے کا یأ دھیرین می تُھو، یاد ساتہ کہ ٹول کم آخرکار اللہ سی دِشکے واپس ہونین۔
حا میم
قسم تُھو تے کتاب سی کامیک یأ حق واضحا کوؤ والا تُھو۔
کہ مھوئے ایس اے مبارک ژأت می نازل کیدو، (کئیکہ) مھو خلک شیدؤ والا اَشئی۔
اے (ڙأت) کے ہر حکمت والا کم سی فیصلہ کوا بژژی
اے مھالے کام یأ سے مُھن دِشا تُھو، بیشکہ مھو پیغمبر پیؤ والا اَشئ۔
میلائی چھی رب سی ڈھأرا رحمت سی معاملہ ہوئے، یقیناً اَںئی سے ہر بات بُھوژو والا، ہر شیئی ما شید تُھو۔
کآم یأ بُڈ آسمان آسی آں دھیرین سی، آں تھین مِیئے ہر شیئی سی رب تُھو، کو تھو واقعی یقین ساتو والا تھیو۔
تیما علاوہ یام ہُم عبادت سی لائق نو تُھو، سے جیدون ہُم دیدو آں مئیک ہُم، سے تُھن ہُم رب تُھو آں تُھن موٹھک لھنگیل بوب داد آسی ہُم رب تُھو۔
حقیقت أ چھی کہ سے شک می بژیل نڑو کودی۔
دَ تھلا تے دی سی انتظار کوا، کے یأ آسمان اے واضحا دھیمی گھیندے یےنین۔
تی دھیمی خلگا زید سور ہونین، أ اے تکلیف دیؤ والا عذاب تُھو۔
(تے ساعدا خلگے بننین) اے مُھن پروردگار! مھو ما مے عذاب دھوگو کو، مھوئے خامخا ایمان اَننین۔
تھأئے خونا کھیدا ہوئے؟ حالانکہ تھین کأشکے مھال پیغمبرؐ اَپ تو، کی یأ حقیقت کولاؤ کیژی۔
بھی ہُم ہیئے خلگے تیما مُو نوڑاد، آں بنوسأد کہ: "ہے چھڙیل تُھو، لیونئی تُھو"۔
مھو عذاب دھأک مُدا سی کأ دھوگو کودی، یقین تُھو کہ تھوئے دُوار تے حالت کے واپس یےنین۔
کامے دی مُھن دِشا چیر سخ گݜو ہونین، (تے دی) مھوے پورا بدلہ گِھننین۔
آں تھیئے ما موش مھوئے فرعون سی قوم اَزمادوشو، آں تھین کأشکے اے عزت دا پیغمبر اَبوشو۔
(آں تی بنوشو) کہ: اللہ سی بَن مھی حوالہ کوا، آ تُھن کأشکے اے امانت دار پیغمبر پیا گودو۔
آں اللہ سی موش نافرمانی نہ کوا، آ تھوئے اے واضحا دلیل گھیندے اَپتو۔
آں آ مے بأت ما تُنو آں تُھن پروردگار سی پنا نیمادو، کہ تھو مأ سنگسار کوا۔
آں کو تھو مھیزید ایمان نہ اَندیو مھیکیژا جُدا ہوا۔
بھی تی تنو پروردگار کے ہاگاد، کہ أ مجرم خلک تھی۔
(اللہ بنو) کہ: بس تو مھی بن گھیندے ژأدو ژأت ریوان ہو۔
آں تو سمندر اِڑی ہویل چھو، یقیناً می لخکرے ڈوب کوا بژنین۔
کھیدیک باغ و اوسو اَشئی یأ ہیئے (خلگے) چھیدے گئی۔
آں کھیدیک بھوم و غورا شیر۔
آں عیش و عشرت سی کھیدیک سامان، کِمی یأ سے مزے کوؤدود!
(تھین انجام) اَںئی ہامو ہو، آں مھوئے تھأ بُڈ شَیئی آسی وارث دُوئی اے قوم سَواد۔
بھی تِھیزید نأ آسمان ڙینگو نأئی دھیرین ژینگی، نأئی تھیأئے کی مہلت دیا گأ۔
آں بنی اسرائیل گے مھوئے ذلیل کوؤ والا عذاب ما مخلس دید،
فرعون ما، حقیقت أ چھی کہ سے گھن سرکش، حد ما لھنگو والا خلگے ما اَشو۔
آں مھوئے تھأئے (بنی اسرائیل گے) تنو علم سی مطابق دوںئی جہان آسی خلگا زید گھینیئی دیدیشی۔
آں مھوئے تھأئے مھال نخ دِید کہ تھأمی واضحا اَزمیخ أشی۔
یقیناً أ خلک میس بندی
بس دُوئی کی نوتُھو مُھن اَںئی تی اول مئیک ہونین، آں مھوئے دُوآر جینی کوا نہ بژنین۔
کو تھو سأزبن تھیو مُھن بوب داد اُشأدے اَنا!
أ خلک غورا تھی کو تُبغ سی قوم، آں سے خلک کآم یأ ہیئے ما موش اَشئی؟ مھوئے تھأ بڈ ہلاک کی (کئیکہ) سے یقینی طور تے مجرم خلک اَشئی۔
آں مھوئے آسمان و دھیرین، آں کائی ہین مِیئے تُھو، ہأئیمو نڑو سی کأ پیدا نہ کیدی۔
مھوئے تھأ برحق مقصد سی کأ پیدا کیدی، خو تھأمی اکثر خلک نہ جندی۔
حقیقت أ شی کہ فیصلہ سی دی ہین بُڑا سی مقرر کویل میعاد تُھو۔
کامے دیئے اے سأت دوئی سأت سی کی کام نے یےنین، آں تھأمی یسی کی مدد کوا نہ بژنین۔
سیوائے تیما کیزید یأ اللہ رحم کیو، یقیناً سے اقتدار سی کھمان آں چیر مہربان تُھو۔
یقین کو کہ زقوم سی تھام
گناہگا آسی کھوؤ ہونین۔
تیل سی کِھریݜین سی شانے، تی (خلگا سی) ڈھے می مھاموڑ خوڑوگنین،
یأ خوڑوگیل اُو۔
(مُلیکائے بنا بژنین) "ایس گیݜتے دیزوخ سی مئیموئے نیا!"،
"بھی تِسی ݜا زید خوڑوگیل اُو سی عذاب تَھلا!"۔
(بنا بژنین) "چکھ، تو چیر اقتدار والا، گھن عزت دا تُھو"۔
أ اَںئی سے شیئی تُھو کِسی بارا می یأ تھو شک کوؤدود۔
(دوئی ڈھأر کے) پرہیزگار خلگے یقیناً امن و امان والا پوت می ہونین۔
باغ و اُوسو آ می۔
تھئے ایکدیئے مُخامخ چنجل و بار أشیم (استبرق و سندس) سی کوژو لھئیل بھئیل ہونین۔
تھأزید اَںئی مھاموڑ ہونین، آں مھوئے گھین گھین أݜی آسی حور آزید تھین بیوا کونین۔
تھیئے تھید چیر اطمینان دے ہر قسم سی میوا نیما یینین۔
تھید تھیئے اول مئیک ما علاوہ دوئی مئیک سی مزہ نہ چکھنین، آں (اللہ) تھأ دیزوخ سی عذاب ما حفاظت می ساتنین۔
می بُڈ چھی پروردگار سی ڈھأرا فضل ہونین، اَںئی أ زبردست کامیابی چھی۔
بس (اے پیغمبرؐ!) مھوئے مے (قرآن) چھی جیب می أسأنی کیدو، میلائی خلک خونا گھنن۔
مھیرے تو ہُم انتظار کو، أ خلک ہُم انتظار کودی۔
حا میم
أ کتاب اللہ سی دِشا نازل کوا بژدو، کآم یأ گھین عزت سی مالک، گھن حکمت والا تُھو۔
حقیقت أ چھی کہ آسمان و دھیرین می منو والا آ سی کأ چیر نخ تھی۔
آں تُھن پیدا کوؤ می، آں تھأ زیناور آ می، کامیک یأ تی (دھیرینے) خور کیدی، تھأ خلگا سی کأ گھن نخ تھی کآم یأ یقین ساتدی۔
آں ڙأت و دی سی ییؤ بیو می، آں اللہ آسمان ما رزق سی کامیک زریعہ والئ، بھی تیندے دھیرین گے تِسی مئیک ما بعد نم جیدون دید، تیمی آں ہوا آ سی گردش می تھأ خلگا سی کأ گھن نخ تھی، کآم یأ عقل ما کام گھیندی۔
ہے اللہ سی آیت تھی یأ مھو تھوئے صحیح صحیح بین دے بُھوژادی، تھلا اللہ آں تِسی آیادے ما بعد کامے بات چھی یأ تیزید ہیئے ایمان اَننین؟
تباہی چھی ہر تے لووال گناہ گا سی کأ
سے اللہ سی آیت بُھوژدو، کے یأ تیس کے بیندے بُھوژا گئیو، بھی سے لوئی کیدے مھاموڑ (کفر زید) اِڑی ہوئیل ہودو، یأ تی تھأ آیت یئت ہُم نی بیدتی، بس ہال ماݜ کے دڑ دیؤ والا عذاب سی زیرے دے۔
آں کے مُھن آیادے ما کآں اے آیت تے ماݜ سی علم می أبو، سے تیس پیش پشاڑے کودو، اَںئی ہے سے خلک تھی کھین کأ یأ ذلت سی عذاب تُھو۔
تھین مُشکے دیزوخ چھی، آں کائی تھیئے گھڑدوو نأ تی تھین کی پکار ینین، نأئی تھیئے تھین کی پکار ینین کآم یأ تھیئے اللہ چھیدے تنو ساتو والا سیوأدتی، آں تھین کأ اے گھن عذاب تُھو۔
أ (قرآن) سراسر ہدایت چھی، آں کامے خلگے تنو پروردگار سی آیادا سی انکار کیدو، تھین کأ چیر لاݜ قسم سی تکلیف دیؤ والا عذاب تُھو۔
اللہ سے تُھو کی یأ سمندر تُھن کأ کم می ݜژادتُو، مِسی کأ تِمی تِسی حکم دے کشتی چلن، آں مِسی کأ کہ تِمی تھو تِسی حکم دے فضل بیرڑا، آں میلائی کہ تھو تِسی شکر نِگھلا۔
آں آسمان و دھیرین می کائی تُھوو، تیس ٹول تی تنو دِشا تُھن کم می ݜژادتو، یقیناً ایمی تھأ خلگا سی کأ گھن نخ تھی کآم یأ پھگر ما کام گھیندی۔
(اے پیغمبرؐ!) کامے خلگے یأ ایمان آنودو تھأئے بَن کہ، کامے خلک یأ اللہ سی دی آ سی بھیت آں پھگر می نی تھی، تھأ معاف کوا، مِسی کأ اللہ خلگائے تھأ کم آ سی بدل دو کامیک یأ سے کوؤدود۔
کآم ہُم نیک عمل کودوو سے تنو فائدہ سی کأ کودو، آں کآم لاݜ کام کودوو سے تنو نقصان کودو، بھی تھوئے ٹولے تنو پروردگار سی ڈھأرکے آنا بژنین۔
آں مھوئے بنی اسرائیل گے کتاب آں حکمت آں نبوت دیدیشی، آں تھأئے پاک شیئی آ سی رزق دیدیشو، آں تھأئے دُونیئی جہان سی خلگا زید گھینیئی دیدیشی،
آں تھأئے صفا صفا احکام دیدیشی (تورات سی شکل می)، تیما بعد کامے اختلاف تھیئے ایکدی می کیدا، تیس تھین کأشکے علم سی پیؤ ما بعد کیشو، صرف ایکدوئی سید ضد سی وجہ دے، یقیناً چھی پروردگار تھین میئے قیامت سی دِیئے ہأ بأدا سی فیصلہ کونین، کامیگا می ہے اختلاف کوؤدود۔
بھی (اے پیغمبرؐ!) مھوئے تھأ دین سی اے خاص شریعت زید قائم کیدو، بس تُو تِسی پأشکے بش، آں تھأ خلگا سی خواہشات آ پیش نہ بَش کآم یأ حقیقت سی علم نہ ساتدی؛
سے اللہ سی مقابلہ می تُھن اے پِھٹ پکار نہ یے بھادی۔ آں حقیقت أ چھی کہ ظألم خلک ایکدوئی سی سأت تھی، آں اللہ پرہیزگار آ سی سأت تُھو۔
أ قرآن بُڈ خلگا سی أݜی پدا کوؤ سی مجموعہ تُھو، آں کامے خلک یقین کودی تھین کأ سراسر ہدایت و رحمت تُھو۔
کامے خلگے لاݜ لاݜ کم کیدی، کئی تھیئے مے گُمان کیدو کہ مھوئے تھأ تھأ خلگا سی برابر کونین کی یأ ایمان آنودو آں نیک عمل کیدی، تِسی نتیجہ می تُھن جیدون آں مئیک اے شان سی ہونین؟ کھیدیک لأݜ بات چھی یأ ہیئے مقرر ( تِسی دعوای) کیژی!
آں اللہ بُڈ آسمان آں دھیرین حق مقصد سی کأ پیدا کیدی، آں مِسی کأ کیدی کہ ہر ماݜ کے تِسی کویل کم آ سی بدل دیا بژے، آں تھأزید کی ظلم کوا نہ بژے۔
کئی تأ تے (ماݜ) ڈیڈ کی یأ تنو نفس سی خواہش ما تنو کأ خدا سوادتو، آں علم سی باوجود اللہ تیس گمراہی وا تھلو، آں تِسی کن آ زید آں حی زید مہر ݜژاد، آں تِسی أݜی آ زید پردہ تھلُو؟ مھیرے اللہ ما بعد کآم تُھو یأ تیس پَن دے آنے؟ کئی بھی ہُم تھو سوَق نی گھیندی؟
آں ہے (کأفر) خلک بندی کہ: "جیدون کا یأ تُھوو بس مُھن دُونیئی سی أ جیدون تُھو، (ایمی) مھو مودی آں جیدون تھلدی، آں مھو دُوئی یام نأ صرف زُمان مادو"، حالانکہ مے بأت سی تھأئے ہاڈو علم نو تُھو، سے ہأئیمو اٹکل ݜژادی۔
آں کے یأ مُھن آیات صفا صفا تھأئے بُھوژا گئیو، دَ مے بأت ما علاوہ تھأکیش دُوئی کی دلیل ہوژی کہ: "تھو سأزبَن تھیو مُھن باپ داد واپس (جینی کیدے) آنا"۔
(اے پیغمبرؐ!) بَن کہ: أ اللہ تُھو یأ تھوئے جیدون دیدو بھی تھوئے مئیک دیدو، بھی تھو بُڈ قیامت سی دی جمع کونین، یأ تِمی کی شک نی چھی، خو اکثر خلک نہ جندی۔
آں آسمان و دھیرین سی بأچیئی اے اللہ سی چھی۔ آں کامے دِیئے قیامت قائم ہونین دا، تے دی کآم خلک ناحق زید تھیو تھیئے سخ نقصان بھاکونین۔
آں تأ ہر ڈلہ کُڈ آ زید بئیل پشنین، ہر ڈلہ تِسی اعمال نامہ سی دِشکے ہاگا بژنین، (آں ہأئے بنا بژنین کہ) "آش تھوئے تھأ عمل آسی بدل دیا بژنین کامیک یأ تھو کوؤدود،
أ مُھن (لیگیل) کتاب تُھو یأ تُھن بارا می صحیح صحیح بندو، تھو کا یأ کوؤدود مھو تیس بُڈ لیگودود"۔
دَ کامے خلگے یأ ایمان اَنودو آں نیک عمل کیدی، تھأ تھین پروردگار تنو رحمت می داخل کونین، اَںئی ہے واضحہ کامیابی چھی۔
آں کآم خلگے یأ کفر کیشو (تھأئے بنا بژنین)، "کئی تُھن موش مُھن آیت بنا نہ بژودود؟ بھی ہُم تھوئے تکبر ما کام گھین آں مجرم ہیدے دھریئ؟"
آں کے یأ تھوئے بنا بژودود کہ اللہ سی وعدہ حق چھی، تِیمی کی شک نی چھی، دَ تھو بنودود "مھوئے پتہ نی چھی قیامت کا ہودو، اِسی بارا می مھو کا ہُم خیال کودی دا سے اے گُمان شانا ہودو، آں مھوئے بالکل کی یقین نو تُھو"۔
آں (تے موقع یے) تھیئے کا ہُم عمل کیشوو، تھین لاݜ صفا صفا تھین مُوشکے یے نین، آں کا شیئی پیش سے پِشاڑے کوؤدود اَںئی تی تھأ گیر کونین۔
تھأئے بنا بژنین کہ: "آش مھوئے تھو مھاموڑ اَموݜا تھلنین کھأکأ یأ تھوئے مے بات اَموݜا تھیلیشی کہ تھوئے می دِیئے مُخامخ ہونین، آں تُھن دھرو سی پوت آنگا تُھو، آں تُھن کأ کی قسم سی مددگائے نہ ہونین"۔
آں تُھن مے (سزا سی) وجہ می ہونین کہ تھوئے اللہ سی آیادا پیش پشاڑے کیشی، آں دُونیئی سی جیدونے تھو دوکا وا تھلئیشی، بس آش نأدا ہیئے خلگے تھیدا نگھلا بژنین، نأئی تھأئے معافی سی بنا بژنین۔
بس صفت بڈ اللہ سی کأ تھی، یأ بُڈ آسمان آسی ہُم مالک تُھو، دھیرین سی ہُم مالک تُھو آں بُڈ جہان آسی ہُم مالک۔
آں بُڈ گھینیئی صرف تِسی چھی، آسمان آ می ہُم آں دھیرین می ہُم، آں اَںئی سے کامل اقتدار آں حکمت سی مالک تُھو۔
کامے خلگے کفر کی، آں (دأل خلک) کھموئی اللہ سی پَن ما، دَ (اللہ) برباد کی تِھین عمل۔
آں سے خلک یأ ایمان آنودو آں نیک عمل کیدی، آں ایمان آنودو تیزید یأ نازل کوا گودو محمدؐ زید، آں سے حق تُھو تِھین رب سی دِشا، دَ ختم کونین تھیئے ما تِھین لاݜ کم، آں صحیح کونین تِھین حالت۔
مِسی کأ کہ سے خلک یأ کفر کیدو، آں تھیئے باطل سی (بات) مینی، آں سے خلک یأ تھیئے ایمان آنودو، تھیئے حق سی (بات) مینی تُنو رب سی دِشا، مھاموڑ بیان کودو اللہ خلگا سی کأ ہیِن مثال۔
بھی یئت تُھن مقابلہ تھأ خلگا سید ہیو یأ تھیئے انکار کیدوو، دَ تھین چونجوئے پھا دا، مھیدا پورے کہ تھو تھأئے لَرئی دا، دَ پوخ کوا (تھین) بندیوان کوؤ، بھی یا دا تھأ چھیدے ملازہ گئا، آں یا تاوان گھینا، مھیدا پورے کہ لات چھوئن تُنو اوزار تھأدے، اَںئی أ حکم تُھو، کو اللہ نیموؤدودو خامخا بدل گھین نیندے ہیئے ما، خو مِسی کأ کہ تھو ایکدوئی ما آزومے، آں سے خلک یأ اللہ سی پَن دے مُوا گئیو، دَ یئت ہُم تِھین عمل ضائع نہ ہونین،
(اللہ) ہأئے پان پشانین آں تھین حالت غورا کونین۔
آں اللہ لھنگانین ہأ جنت کے، کیس یأ ہأزید پأنأدچی۔
اے ایمان والا ہانا! کو تھوئے اللہ سی مدد کِیو دَ اللہ تُھن مدد کونین، آں تُھن کُھو پیگی کونین۔
آں کامے خلگے کفر کیدو دَ تھین کأ بربادی چھی، آں (اللہ) تھین عمل ہاڙانین۔
أ مِسی کأ کہ ہیئے نوخوشاد تیس یأ اللہ نازل کیشو، دَ (اللہ) تھین عمل ہأئیمو توئے کونین۔
کئی تھیئے سفر نی کیشو دھیرینے، کہ پشندے کا انجام ہُو تھأ خلگا سی یأ ہیئے ما موش لھنگئیشی؟ ہلاک کی ہأ اللہ، آں کأفر آ سی کأ ہاموڑ ہودو۔
أ مِسی کأ کہ اللہ مددگار تُھو تھأ خلگا سی یأ ایمان آنودو، آں کأفر آ سی کأ یام کومکی نوتُھو۔
بیشکہ اللہ تھأ خلک یأ ایمان آنودو آں نیک عمل کیدی، لھنگانین مھال باغائے یأ تھین ٹیندے یَب روان ہونین، آں سے خلک یأ کأفر تھی، سے عارضی فائدہ بھا کودی آں مھاموڑ کھادی کھأکأ یأ څاروئی کھادی، حالانکہ آں آنگا ہین دھرو سی پوت تُھو۔
آں کھیدیک گام اَشئی یأ چیر سخ اَشئی طاقت می چھی (مے) گام ما، یأ تیما تھأ نِگھالو، مھوئے ہأ ہلاک کی دا یام نہ اَشو تھین مددگار۔
کئی سے ماݜ یأ اخکارہ دلیل زید تُھو تُنو رب سی دِشا، تے ماݜ سی شانے ہوبھادو یأ شیژیئی کوا گودو تیس کے تِسی لاݜ عمل، آں تی تُنو خواہشا سی تابعداری کی؟
مثال تے جنت سی یأ پرہیزگار آزید وعدہ کوا گیژی (مھال تُھو کہ)، تِسمی یَب تھی تے اُو سی یأ سے خراب نہ ہودو، آں تے ڇھی سی یب کہ بدل نوہودو تِسی خوند، آں تے شراب سی یب کہ پو والا سی کأ مزیدار ہودو، آں صفا مأݜ سی یَب، آں ہین کأ ایزمی ہر قسم سی میوا تھی، آں معافی چھی ہین رب سی دِشا؛ دَ سے تھأ خلگا سی شانے ہوبھادی یأ سے ہمیشہ سی کأ آنگا می تھی، آں پیا بژدو تھأئے خوڑوگیل اُو، (مھال اُو یأ) سے پھیڑ پھیڑ کودو تھین اَندر؟
آں ہأمی یام سے تھی (یأ ظاہر می) چھی بأت بھوژدی، مھیدا پورے یأ کے سے چھی کأشا نیگھأدو، بھی تھأئے بندی کیس کے یأ علم دِیا گودو دا "اِی مھیرے مھیرے کا بنوشو؟" أ سے خلک تھی یأ تِھین حِی آ زید اللہ مہر ݜژأدتو، آں تھیئے تُنو ارمان آ سی تابعداری کی۔
آں سے خلک یأ سے ہداہت زید تھی، دَ اللہ چیری کودو تِھین ہدایت، آں دیدو تھأئے تِھین تقویٰ۔
دَ کئی سے قیامت سی طمع تھی کہ سے تھأزید نأڅأپی یو؟ دَ تِسی نخ تا (موش ما) اَئیدی، یئت کو سے ہأئے أب ہُم تھلا ہین نصیحت گھینو کھیدا ہونین؟
دَ جنا کہ اللہ ما علاوہ یام عبادت سی لائق نوتُھو، آں تھو معافی نیما تُنو گناہ آ سی، آں ایماندار ماݜ آں ایماندار جَوئی آ سی کأ، آں اللہ جَندو تُھن ییؤ بژو آں تُھن دھرو سی پوت ما۔
آں بنَدی سے خلک کی یأ ایمان آنودو دا کہ کئی نہ وأت (جہاد سی بارا می) سورت؟ بھی کے یأ نازل کوا گأ اے پوخ سورت آں بناگا اسمی لات سی بارہ می، دَ تأ ڈیڈ تھأ خلک یأ تِھین حِی آ می بیماری چھی دا، تھیئے چھی دِشکے مھاموڑ بونین یأ تھأزید مئیک سی بےہوشی چھی، دَ ہِین کأ افسوس تھو۔
بأت سی مَنو آں غورا بأت سی بَنو، بھی یأ بات پخا ہی دا، کو سے اللہ زید سأزبن اَشی و تِھین کأ چیر غورہ ہونیندے۔
دَ کئی تھوئے ما أ امید تُھو کہ، کو تھو واپس ہوئیو تھو فساد کوا دھیرینے، آں تُنو رشتہ پھرا؟ (یئدی نأ!)
أ سے خلک تھی یأ تھأزید اللہ لعنت کیژی، دَ (کنے) بئی کی تھأ آں تھأ أݜیے أنڈی کی۔
کئی تھلا سے قرآن می غور نہ کودی، یأ تھین حِی آ زید جندرہ ݜَژیل تھی؟
بیشکہ سے خلک یأ مرتد ہوئی پیٹھ نرأدے، تیما بعد کہ ہدایت تھأئے اخکارہ ہی، شیطان تھأئے (مے کام) شیژیئی کی، آں تھأئے ݲِگ (جیدون سی) اُمید دید۔
ہے مِسی کأ کہ تھیئے بنو، تھأ خلگائے یأ سے نوخوشادی تے حکم یأ اللہ نازل کیشو کہ: "چیر شیرتے مھوئے دھأک کما می تُھن تابعداری کونین " آں اللہ جنَدو تھین برید بأدے ما۔
دَ بھی کا حال ہونین، کے یأ مُولیگے ہین ساء نِگھیلنین، ہین بودے پھا آں ڈاگے پھا دیدے؟
ہے مِسی کأ کہ ہیئے تابعداری کی، تے بأت سی یأ تی اللہ خفہ کیشو، آں ہیئے اللہ سی رضا نوخوشأد، دَ (اللہ) ہین عمل برباد کی۔
کئی مے گمان کی تھیئے خلگے، یأ تھین حِی آ می بیماری چھی، کہ یئت ہُم اللہ ہین بغض اخکارہ نہ کونین؟
آں کو مھو نیمؤدودو مھوئے پشانین دے تھیئے تھأ خلک، دَ تأ تھأ پأن نیندے تھین نخے ما، آں تأ ضرور پأن نین دے تھأ تھین بأدا سی طریقہ ما، آں اللہ تُھن بٔوڑا سی عمل پأنَدو۔
آں مھوئے خامخا تُھن اَزمیخ کونین، مھیدا پورے کہ مھوئے معلوم کونین تھوئے ما مجاھد آں پوخ اِیڑی ہوؤ والا، آں اَزمیخ کونین تُھن حالادا سی۔
بیشکہ سے خلک یأ کفر کیدو، آں کھمدی سے اللہ سی پَن ما، آں پیغمبرؐ کے تکلیف دیدی، میزما بعد کہ ظاہر ہیشی ہأزید ہدایت، کہ کی صورت ہے اللہ یے کی شیئی سی نقصان نہ آوابھادی، آں (اللہ) چیر شیرتے ہین عمل ضائع کونین۔
اے سے خلک ہانا کی یأ ایمان انودو! اللہ سی منا آں رسولؐ سی منا، آں تنو عمل برباد نہ کوا۔
بیشکہ سے خلک یأ تھیئے کفر کیدو، آں کھمدی اللہ سی پَن ما، بھی سے کفر سی حالت می موئیو، دَ کی صورت تھین بوگوشو نو ہونین۔
دَ تھو تنو حی نہ ڈیگا آں روغہ سی دِشکے نہ ہاگا، آں صرف تھوئے زوروڑ ہونین، آں اللہ تُھن سأت تُھو، آں کی صورت می اللہ تُھن عمل توے نہ تھلنین۔
بیشکہ دونیئی سی جیدون اے نَڑو تماشا تُھو، آں کو تھوئے ایمان آنو آں پرہیزگار ہُوئیو تُھن اَجر دیا بژنین، آں تھوئے ما تُھن مال نیما نہ بژنین۔
کو تی تھوئے ما تُھن (مال) نیمأدو بھی تینگی ہُم کیو، دَ تھوئے شمتوب کونین، آں تیدے تی تُھن بدنیتی اخکارہ کونین ۔
بوآدا! تھو دا سے خلک تھی کہ تھوئے بنا بژدو کہ اللہ سی پَن دے خرچہ کوا، دَ تھومی یام سے تھی کہ سے بخل کودی، آں کآم یأ بخل کودو دا سے صرف تُنو کأ بخل کودو، آں اللہ دا غنی تُھو آں تھو غریب تھی، آں کو تھوئے مُو نڑادو اللہ تُھن پوت اے دُوئی قوم اَننین، بھی تھیئے تُھن شانے نہ ہونین۔
اے ایماندا ہانا! مُٹھائے نہ ہوا اللہ آں تِسی رسول ما، آں اللہ ما بھیا، یقیناً اللہ بُھویو والا جنو والا تُھو۔
اے ایماندا ہانا! تھو اُچات نہ کوا تُنو آواز نبیؐ سی آواز ما، آں نأئی نبیؐ سید مھال طریقہ دے اُچات آواز می بات کوا کھأکأ یأ تھو ایکدوئی سیت بأت کودی، مھاموڑ نأ تُھن اعمال ضائع ہوئن، آں تھوئے معلوم ہم نہ ہوئے۔
بیشکہ کامے خلک تُنو آواز اَسودا کودی اللہ سی رسولؐ سی خوا می، أ سے خلک تھی کسی یأ حی آ سی اللہ امتحان گِھنتو تقویٰ سی کأ، ہین کأ مغفرت آں چیر گھن اَجر تُھو۔
(اے پیغمبرؐ!) بے شکہ کامے خلک یأ تھوئے آواز دیدی دیوال سی بھار ما، تھأ مے چیر خلک نہ جنَدی۔
ہاں کو ہیئے صوو کیشوو تے وخا پورے کھیدیخانگے تھو تھأ سی کأ بھار کے نی نِگھأدیشیو تھین کأ غورہ ہونیندے، آں اللہ بگوشو والا مہربان تُھو۔
اے ایماندا ہانا! کو اے فاسق تھوئے کی خبر أنیو، بھی تھو ضرور تحقیق کوا، مھامو نأ تھو ناپوہی می اے قوم گے نقصان اَوا، (آں) بھی تھو تُنو کویل زید پشیمان ہوا۔
آں تھو غورا اَمن جَنا کہ بےشکہ تھومی اللہ سی رسولؐ موجود تُھو، کو چیر معاملہ آ می سے تُھن بات منے، دَ تھوئے بُکھاچا می گیر ہونین، البتہ اللہ تُھن کأ ایمان خوشادتو، آں تیس شیژیئی کیدو تُھن حی آ می، آں تی کگادتو تُھن کأ کفر آں گناہ آں نافرمانی، اَںئی أ خلک ہدایت گھنیل تھی،
اللہ سی دِشا فضل و انعام دے، آں اللہ جنو والا حکمت والا تُھو۔
آں کو مومن آ ما دو فریق ایکدی آ سیت لات کِیو، بھی تھو ہأ (مومن مسلمان آ) می صلح کوا، بھی کو تھأمی ایگے دوئی سیت زأتی کِیو بھی تھلا تھو لات کوا تیسیت کی یأ زأتی کِیو، تے وخا پورے یأ سے اللہ سی حکم سی دِشکے یو، کو بھی واپس آبو بھی ہأ دُوںئی آ می روغہ سی فیصلہ کوا انصاف سمانے، آں تھو انصاف کوا یقینا اللہ انصاف کوؤ والا خوشادُو۔
یقینا مسلمان (ایکدی آ سی) بھئی تھی، تھو تُنو بھئی آ سی مِیئے روغہ کوا، آں اللہ ما بھیا مِسی کأ کہ تھوزید رحم کوا بژے۔
اے ایماندا ہانا! (تھومی) اے قوم دوئی قوم سی پِشاڑے نہ کوے، ہو بھادو سے غورہ ہوئے ہیئے ما، آں نأئی جَوئی دأل جَوئی آ سی پِشاڑے کوے، ہوبھادو سے غورہ ہوئن ہیئے ما، نأئی ایکدی آئے پیگو دا، آں نأئی ایکدی آئے لاݜ نامیدے ہاگا، ایمان آنو ما بعد لاݜ نام سی تھوؤ گناہ تُھو، آں کی یأ توبہ نی کِیو اَںئی ہے خلک ظألم تھی۔
اے ایماندا ہانا! چیر گُمان کوؤ ما اَمن ساتا، مِسی کأ کہ یام گُمان گناہ ہودی؛ آں ایکدوئی سی لٹون نہ کوا، آں نأئی ایکدوئی سی غیبت کوا، کئی تھومی یام میس خوشادو کہ تنو مئیل بھئی سی ماس کھئے؟ دَ تھو ایس أمیدے (ہُم) نوخوشادی، آں اللہ ما بھیا، یقینا اللہ توبہ قبول کوؤ والا آں چیر مہربان تُھو۔
اے خلک ہانا! مھوئے تھو اے جوَئی و ماݜ ما پیدا کیدی، آں تھو مختلف قوم آ می آں قبیلہ آ می تقسیم کیدی، مِسی کأ تھو ایکدی پأنا، بےشکہ تھومی اللہ سی نظر می عزتدا سے تُھو کآم یأ تھومی چیر پرہیزگار ہُوو، یقینا اللہ ہر کی جنو والا آں ہر شیئی ما شِد تُھو۔
ڈھأر سی (بُدو) خلک بندی "مھوئے ایمان آنودو"۔ (اے پیغمبرؐ!) تھو بنا "تھوئے لا ایمان نہ آنودو، اَسے ہاں تھو بنا کہ مھوئے (ظاہری) اسلام آنودو (ݜا وا کیدو)، آں مھیرے لا ایمان تُھن حِی آئے کھید لھنگودُو، آں کو تھوئے اللہ و تِسی رسولؐ سی اطاعت کِیو اللہ تُھن عملے ما (ثواب) کی ہُم کم نہ کونین، بےشکہ اللہ بوگوشو والا چیر زیاد رحم کوؤ والا تُھو"۔
بےشکہ مومن دا سے خلک تھی یأ کی اللہ و تِسی رسولؐ زید ایمان آنودو، آں بھی کی شک نی کِیو، آں (مومن دا سے تھی) کی یأ تُنو مال و نفس تے اللہ سی پَن می جہاد کیدو۔ اَںئی أ خلک (ایمان می) سأزبَن تھی۔
(اے پیغمبرؐ ہأ ڈھأروش آئے) بَن کہ کئی تھو اللہ یے تنو دین داری سی اطلاع دیدی؟ آں اللہ دا پوھہ تُھو کا ہُم آسمان آمی تُھو آں کا دھرینے تُھو، آں اللہ یے ہر اے شیئی سی علم تُھو۔
(اے پیغمبرؐ!) أ خلک تھوزید احسان کودی کہ ہیئے اسلام انودو، (اے پیغمبرؐ!) تھو بَنا مھزید مُلازہ نہ گئیا تُنو مسلمأنی سی، بلکہ اللہ احسان کیدو تھوزید کہ تھوئے ہدایت دِید ایمان سی، کو تھو سأزبَن تھیو تَھلا۔
بےشکہ اللہ جَندو آسمان آ سی آں دھیرین سی غیب سی بأدے ما، آں اللہ پشو والا تُھو کا ہُم تھو عمل کودی دا۔
ق، قرآن مجید سی قسم! (مھیئے کأفرے پیغبمرؐ کی دلیل دے لووال نہ گھندُو)
بلکہ تھیئے مے بأت زید تعجب کیدو کہ (آخرت ما) بھیو والا اَںئی تھیئے ما (کھأکأ) آپ، دَ ہیئے کأفرے میس بنُو کہ: "ہے دا چیر عجیبہ بات چھی،
کئی، کو مھو موئیو آں سُم سَوا گئیو (تھلا بھی ہُم مھوئے جینی کوا بژنین؟) ہے واپس ہوؤ (دا مُھن عقل ما) دُھو بات چھی"۔
حقیقت أ چھی کہ دھیرین ہین (بدن سی) کامے حصا (کھأدے) کم کوژی دا، مھوئے تھین پورا علم تُھو، آں مھوکیش اے کتاب تُھو، یأ سے ہرکی محفوظ ساتدُو۔
اصل می تھیئےحق تھلا لوو گھنوشُو، کے سے تِھین کأشکے اَبوشو، بس سے اے الجھن او اضطراب می تھی۔
کئی تھیئے تنو ڙیت آسمان گے نہ بودُو یرأ مھوئے تیس کھأکأ سوادتو؟ آں تیس شیئےکیدو، آں تِسمی کی قسم سی ڇِگ نی تھی۔
آں دھیرین مھوئےخور کی، آں بوا مھوئے کھنا سی لنگر (وزن) تھلیئدی، آں تِسمی ہرقسم سی رونق دار شیئی بوئیدی۔
میلائی سے ہر نُڑو والا بَن سی کأ پشُو آں نصیحت سی زریعا ہوئے۔
آں مھوئے آسمان ما برکت والا اُو والو، بھی تیندے باغ و تھأ کُل نگھالئ کامیک یأ لُنا بژدی۔
آں خورما آ سی ݲِگ ݲِگ تھام، کیزید یأ ایکدی آ سی ڙیت خوشا (چود) ہودی۔
میلائی مھو بَن آ ئے رزق دئی، آں (مھاموڑ) مھوئے تے اُو دے اے مئیل خار کے جیدون دید، بس اَںئی ہاموڑ (انسان آ سی قوَرا ما) نُخو ہُم ہونین۔
تھیئے ما موش نوحؑ سی قوم، آں رَس والا آں ثمود سی خلگے ہُم (مے بات) لوو گھینشی۔
آں قوم عاد آں قوم فرعون آں لوطؑ سی بھیئے ہُم،
آں ایکہ والائے، آں تُبع سی قوم ہُم: تھیئے بُڑے پیغمبر لووال گھنیئشی، اِسی وجہ دے مأ کامے عذاب ما بھأدیشی دا سے سأس ہیدے گا۔
کئی مھو اول گونا پیدا کوؤ ما ٹھموئیشی؟ نأ، بلکہ ہے خلک دُوآر پیدا کوؤ سی بارا می دوکا وا گیئدی۔
آں حقیقت أ چھی کہ مھوئے انسان پیدا کیدو، آں تِسی حی می کا خیالات پیدا ہودی دا مھو تھیئے ما ہم جنیل تھی، آں مھو تِسی سا سی ڙگ ما ہُم تیسکے نھیو تھی۔
آں تے سادا ہُم کے یأ (عمل) لیگو والا دُو مُلیکا لیگا ییدی، ایک سُون ڈھأر کے آں دُوئی اَوَن ڈھأر کے۔
کآں ٹگیل لا (انسان أں ما) نی نگھالدو دا اے نگران تیزید مقرر ہودو، ہر سادا (لیگو سی کأ) تیا۔
آں مئیک سی سختا سأس می ییؤ والا چھی، (اے انسان!) ہے سے شیئی تُھو کیما یأ تُو بھیت تے ڈیؤدود۔
آں بیشیل وا پھوک دیا بژنین، أ سے دی تُھو کیما یأ بھیا بژودود۔
آں ہر ماݜ مھاموڑ یے نین کہ تیزید ایک ݜگوؤ والا ہونین آں ایک گوائی دیؤ والا۔
حقیقت أ چھی کہ تو مے واقعہ ما بے غمہ بئیل اَشو، مھیرے مھوئے تھأما پردہ دھگو کیدو کامیک یأ چھی ڙید اَشو دا، (دَ مھوئے کولاؤ کی تھأما چھی پردہ) بس آش چھی نظر چیر تیزی ہودُو۔
آں تِسی سأت بننن: أ سے (عمل نامہ) تُھو کامیک یأ مھے کیش تیا تُھو۔
(حکم دیا بژنین کہ) تھو دوںئیدے ہر تے ماݜ دیزوخ کے تھلا، کآم یأ پوخ کأفر آں حق سی دشمن اَشو۔
کآم یأ دأل غوراتوپ ما کھمو والا، چیرگن زأتیئی کوؤ والا، آں (حق می) شک تھلُو والا اَشو۔
کی یأ اللہ سیت دُوئی کیس خدا سوادوشُو، بس مھیرے تھو دوںئیدے ایس سخ عذاب وا تھلا۔
آں تِسی سأت بَننن: اے مُھن پروردگار! مأ ایس گمراہ نی کِشو، بلکہ ہے أمینے گمرہی می چیر دھی ہوشُو۔
(اللہ) بننین: تھو مھی موش لات نہ کوا، آں مأ دا موش ما تُھن کأشکے عذاب سی دمکی پیئشی۔
مھی موش سے بات بدل نہ ہوبھاژی، آں آ بن آ زید کی ظلم کوؤ والا نو تُھو۔
تے دی (یاد سات) کے یأ مھوئے دیزوخ کے بننین: "کھأ تو ڈک ہی؟" آں تی بننین: "کئی دُوئی کی تُھو؟"
آں پرہیزگار آ سی کأ جنت مھیدیک نھیئی کوا بژنین کہ کی ہُم دُھو نہ دھرنین۔
(بنا بژنین کہ) أ سے شیئی تُھو کسی یأ تھوسیت وعدہ کوا بژدود، أ (جنت) ہر تے ماݜ سی کأ چھی کآم یأ خُدئی سیت حی ݜژؤ والا، تنو خیال ساتُو والا ہوو۔
کآم یأ رحمٰن ما بے تِسی پشُو آ بھیدو، آں تِسی دِشکے نُڑو والا حی گھیندے ییدُو۔
تھو بُڑ اِسمی سلامیتا دے لھنگا، می دِیئے مُدام جیدون سی دی ہونین۔
تھأ (جنتی آ ئے) ہر تی شیئیے میلاؤ ہونین کا یأ تھیئے تھیت نیمادو، آں مھوکیش دوئی ہُم چیر کآں تُھو۔
آں ہأ (مکہ سی کأفرے) ما موش مھوئے کھیدیک قوم ہلاک کیدی، کسی طاقت زید یأ مضبوط والے ہیئے ما سَخ أشی، کھأئمو تھیئے بُڑ خار پلڑئیشی، کئ تھین ڈیؤ سی کی پوت اَشو؟
یقینًا اسمی تے ماݜ سی کأ نصیحت چھی، کِسی حی ہوو، یا کآم میم حاضر کیدے کان تھیئے۔
آں مھوئے بُڑ آسمان و دھیرین، آں تھین مِیئے کا تُھوو، ݜو دی آ می پیدا کیدی، آں مھو اے پِھٹ ہُم نہ ٹَھمئی۔
بس اے (پیغمبرؐ!) کائی أ خلق بندیو، تو تیزید صوو کو، آں تنو پروردگار سی صفت آ سی تیسپے گیئا، سی سی نُخو ما موش ہُم، آں سی سی بیُو ما موش ہُم۔
آں ڙأت سی حصہ می ہُم تِسی (نام سی) تیسپے گئا، آں سجد آ ما بعد ہُم۔
آں غور تے بُھوش! کامے دی یأ اے چأڑ کوؤ والا اے نھیو پوت ما چاڑ کونین۔
کامے دی یأ خلگے سأستے تے چأڑ سی آواز بُھوژنین، آں تی قوَرے ما نُخو سی دی ہونین۔
یقین کوا، أ مھو تھی کآم یأ جیدون دیدُو آں مئیک ہُم، آں آخر بُڑآئے مُھن ڈھأر کے واپس ہوؤ تُھو۔
تے دی کے یأ دھیرینے پھیلدے تھأ مھاموڑ نگھالنین کہ تھیئے جلد جلد نُخنین، ہاموڑ بُڑا سی جمع کوؤ مُھن کأ چیر آسان تُھو۔
کا یأ أ خلق بندی دا مھوئے غورا کیدے معلوم تُھو، آں (اے پیغمبرؐ!) تو ہأزید زبردستی کوؤ والا نو تُھو، بس قرآن سی زریعہ دے ہر تے ماݜ کے نصیحت کوا یے، کآم یأ مھی دَمکی ما بھیدو۔
قسم تُھو (بیلئی آ سی) سے پھزین اُشأدے خور کودی
بھی تھین یأ (ہاگا آ سی) بوج سی اُوچات کوؤ والا تھی،
بھی (تھین کآم) یأ دما دما سیت تلَدی،
بھی (تھین کآم) یأ شیئی تقسیم کودی،
بیشکہ، کا لوظ تھوسیت کوا گودُو دا خامخا سأز تُھو۔
آں بیشکہ عملا سی بدل خامخا ہونین،
قسم تُھو پَن والا آسمان سی،
بیشکہ تھو گڑبڑ بأدا می تھی،
اِیزما سے نُڑا بژدُو کآم یأ (حق ما) نُڑا گادو۔
ما بژن (عقیدہ سی بارہ می) اٹکلی خلک،
کی یأ غفلت می آخرت اَموݜا تھیلیئی،
ہے توَس کودی کہ: "عملا سی بدل سی دی لخا کے ہونین؟"،
تے دی ہونین کے یأ ہے آنگا زید توا بژوسأدو،
چکھا تُنو سزا سی مزہ، أ سے سزا چھی کامیک یأ تھو شیرتے نیمؤدود۔
بیشکہ پرہیزگار خلگے باغ و اوسو آ می ہونین۔
گِھنا یے نین کا یأ ہین پروردگار ہأئے دیدو، بیشکہ ہے اِی ما موش ہُم شیژو عملی اَشیئ۔
ہے ڙأد می اَشوڑ ساعت ہُوبودُود،
آں ژاد سی وخا تنُو گناہ آ سی معافی نیمؤدُود۔
آں ہین مال می حق ہؤدود نیمؤ والا آں محروم خلگا سی کأ۔
آں دھیرین می یقین کوؤ والا سی کأ گن شیئ نَخ تھی۔
آں تُھن تُنو وجود می ہُم، کئی تھو نہ پشدی؟
آں تُھن رزق آسمان می چھی، آں کا شیئی سی یأ تھوزیت لوز کوا بژدُو۔
آسمان و دھیرین سی رب سی قسم! بیشکہ أ بات خامخا مھاموڑ یقینی چھی کھأکأ یأ تھو بأت کودی۔
آں کئی تھیئے ابراہیمؑ سی عزت مند میلاݜ آ سی خبر اَوئیشی؟
کا وخا یأ سے تِسی کأشکے لھنگئی دا تھیئے سلام بنُو، ابراہیمؑ (ہُم) سلام بنُو، (حی می بنو) "کآں ناشینا خلک تھی"۔
بھی بریت تنو شیر والا آ سی کأشکے بیشتے دستی اے شُن شوگُو کھیندے آپ۔
بھی تیس تھأ میلأݜ آ سی مُشکے تھوؤ، بندُو: "کئی تھو نہ کھا دی؟"
د تی ہأما حی می بھیت محسوس کی، تھیئے بنو کہ: تُو بھیت نہ کو، آں تھیئے تیسکے اے پوھہ پو سی زیرے دید۔
دَ تِسی بی بی چیگأ نیگھالین أپ، بھی تنو مُو کُڑو، آں بنو: "اے شأن ڈھأک (لؤ اَن بھاژی؟)"۔
تھیئے بنو: اَںئی ہاموڑ چھی پروردگار بنودُو، بیشکہ صرف سے حکمت والا جنیل تُھو۔
(ابراہیمؑ) بنو: "اے پیئل مُلیکا ہانا! تُھن پیؤ سی مقصد کا چھی؟"
سے بندی: "بیشکہ مھو جرم دار خلگا سی دیشکے پیا گئیدی"۔
تاکہ مھو تھأزید پژیل سُم سی باڑ موژیئی
سے چھی رب سی دِشا نخ ݜژیل اَشیئی، حد ما نُوخو والا سی کأ۔
بھی مھوئے نیگھالیئ کآم سے تے علاقہ می ایمان دا اَشیئی۔
دَ مھوئے تھیت مسلمانا می اے شیر ما علاوہ دوئی کی نہ پات۔
آں مھوئے تھیت (عبرت سی کأ) اے نخ چھؤ، تھأ خلگا سی کأ کآم یأ دردناک عذاب ما بھیؤدُود۔
آں موسیؑ (سی قصہ) می (تھین کأ عبرت چھی)، کا سادا یأ مھوئے تیس فرعون سی کأشکے اَخکارہ دلیل سمانے پیؤشو۔
دَ تی تنو طاقت زید غرا ہیدے مُو نراد، آں بنو کہ ہے جادوگر یا لیونئی تُھو۔
دَ مھوئے تیس آں تِسی لخکر گیݜتے دریاب می ڈوب کی، آں سے ملامتیا سی لائق اَشو۔
آں عاد سی قوم می (ہُم عبرت چھی) کا سادا مھوئے تھأزید خیر ما خالی بیلأئی پیئی،
نہ چھؤدود کی شیئی زید یأ بیُودود (سے بیلأئی)، تیس پیݜیل ہَرا سی شاندے کؤدود۔
آں ثمود می (ہُم عبرت چھی) کا سادا تھائے بناگا کہ مزے کوا اَشُوڑ وخا پورے۔
دَ تھیئے تنو رب سی حکم سی منو ما بغاوت کی، دَ تھأ اے سخ چیگأئے گأد، آں سےڅارودُود۔
نأ سے اِیڑی ہوبھؤدود، آں نائی سے مدد سی گھینو والا اَشیئی۔
آں ہأما موش نوحؑ سی قوم (مھوئے عذاب می گادُوشو)، بیشکہ سے گناہگا خلک اَشیئی۔
آں آسمان مھوئے تنو زور تے سوادتو، آں بیشکہ مھو خامخا فراخی والا تھی۔
آں دھیرین مھوئے بتھیریژی، دَ کھیدیک شیژو بتھرو والا تھی!
آں ہر شیئی سی مھوئے جوڑا پیدا کیدی، ہوبھاژی تھو نصیحت گھینا۔
دَ اللہ سی دِشکے دھأںئی دا، بیشکہ آ تھو تِسی دِیشا اخکارہ بھیو والا تُھو۔
آں اللہ سیت دُوئی خدا نہ سوا، بیشکہ آ تھو تِسی دِیشا اخکارہ بھیو والا تُھو۔
اَںئی ہاموڑ ہأما مُوشک خلگا سی کأشکے ایک ہُم پیغمبر نہ اَپ تو یأ تیسکے مے بات نے بینیژی کہ ہے جادوگر تُھو یا لیونئی۔
کئی ہیئے مے بأت سی ایکدوئیے وصیت کیژی؟ نأ، بلکہ ہے تُھو ناڑاما قوم۔
دَ (اے پیغمبرؑ!) ہأما مُو نَرا، تھیزید کی ملامتیا نی چھی۔
آں نصیحت کوا یے، کئیکہ نصیحت ایماندائے فائدہ دیژی۔
مأ انسان و پیر صرف مے بأت سی کأ پیدا کیدی کہ ہے مھی عبادت کوئن۔
آ ہأما کی روزی نی نیمادُو، آں نأئی میس نیمادُو کہ ہے مھیزید کھیئن۔
بیشکہ صرف اللہ چیر گھن رزق دیؤ والا، طاقت والا زوروڑ تُھو۔
دَ بیشکہ کی یأ ظلم کیدو ہین ہُم (عذاب سی) مھاموڑ وار یے نین کھاموڑ یأ ہین سأدا سی وار أبیشی، تھلا ہے (عذاب سی نیمؤ می) تأدی نہ کوئن۔
دَ کأفرا سی کأ بربادی چھی تے دی سی وجہ دے کامیک سی یأ ہأزید لوظ کوا بژدو۔
قسم تُھو طور (سی کھن) سی۔
آں قسم تُھو لیگیل کتاب سی
سے خور کویل کاغذ می تُھو
آں قسم تُھو آباد کویل شیر سی
آں قسم تُھو اُوچات کوئیل چَت سی
آں قسم تُھو ڈک کویل دریاب سی
یقیناً چھی رب سی عذاب ییؤ والا تُھو
یام نو تُھو تِسی دُھو کوؤ والا
کامے دی یأ پھرگنین آسمان کیم دے
آں ریوان ہونین کھنے اِشتے
پس تے دی لووال گھنڈو والا سی کأ تباہی چھی
کامے خلک ئے فضول بأدا مے لگیا تھی نڑدی
کامے دی یے ہأ دیکا کوا بژنین دیزوخ سی آنگا سی دِشکے
أ سے آنگا تُھو کامیک یأ تھو لووال گھنودُود۔
(مھیرے بنا) اَیا ہے جادو تُھو یا تھو نہ پشَدی؟
لھنگا تھو اے دیزوخ کے، دَ تھو صوو کودی آں کو نہ کودی برابر بات چھی تُھن کأ، بےشکہ تھوئے بدلہ دیا بژنین تھأ عملا سی کامیک یأ تھو کوودُود۔
بےشکہ پرہیزگار خلگے باغا می آں نعمدا می ہونین
خوشحال ہونین ہیئے تھأ شیئی آ زید کامیک یأ ہأئے ہین پروردگار دید، آں ہأ ہین ربے بچ کی دیزوخ سی عذاب ما
(ہأئے بنا بژنین) کھا آں پُوا غورہ مزے دے، تھأ نیک عملا سی بدل می کامیک یأ تھو کودُود
ڈڈا دیل ہونین، برابر خور کویل تخا زید، آں بیوا کونین مھوئے ہین گھین أݜی آ سی حورا سیت
آں کامے خلگے ایمان اَنودو، آں ہین اولاد ہین ایمان سی اَنو می تابعداری کی، تھأ مھوئے اے پوت کونین ہین اولاد سیت (جنت می)، آں کم نو کونین مھوئے ہین عمل ما کی شیئی، ہر ماݜ تُنو عمل می گیر ہونین۔
آں مھوئے ہأ جنتی آئے میوا دینین، آں ماس تے قسم ما کامیک ہیئے نیمانین۔
ہیئے ایکدوئی ما جنت می شراب سی جام گھرا نین، تے (شراب) می نأ فضول بأدے ہونین آں نأ گناہ سی کم۔
آں چاپ چاپیرہ گئی نین ہأزید جدَگے ہین (خدمت سی) کأ، یابنے بیریت ساتیل غمئی سی شانے ہونین
آں ہیئے مخامخ ہیدے ایکدوئی ما توَس کونین
ہیئے بن نین مھو دا موش تُنو شیر آ می چیر بِھیودُود
پس مھوزید اللہ غورا کی، آں مھو بچ کی تأت ہوا سی عذاب ما
بےشکہ مھو میما موش اللہ ما دعا نیمؤدود، بےشکہ سے غورا کوؤ والا مہربان تُھو۔
پس (اےنبیؐ!) تو نصیحت کو، تُنو رب سی فضل دے تو نأ نجومی تُھو آں نأئی لیونئی
اَیا ہے بنَدی یرأ ہے (نبیؐ) شاعر تُھو (آں) مھو اِسی کأ زُمان سی حالات کُوٹھادی؟
بن تو (اے پیغمبرؐ!) تھو کُوٹھا، دَ آ ہُم تھوسیت کُوٹھوؤ والا ما تُھو
اَیا ہأئے ہین عقل مے بات سی زورَنا دیدی، یا ہے (أمیدے) یاغی خلک تھی؟
اَیا ہے بنَدی اِی (پیغمبرؐے مے قرآن) اَمَنا سوادتُو؟ نأ، بلکہ ہے ایمان نہ آنَدی
دَ (تھلا پکار تُھو) ہے اَنن دھأک بأت مے (قرآن) سی شانے، کو ہے سأزبن تھیو (تُنو بأت می)
اَیا ہے پیدا کوآ گئیدی بغیر پیدا کوؤ والا ما، یا ہے أمیدے پیدا کوؤ والا تھی؟
یا پیدا کیدی ہیئے آسمان و دھیرین؟ نأ، بلکہ ہے یقین نہ کودی
اَیا ہأکیش چھی رب سی خزان تھی؟ یا ہے واگدا تھی؟
اَیا ہأکیش شِل چھی تیدے ہے بأت بھوژدی؟ (کو ہاموڑ تُھوو) دَ آنے ہین بھویو والا اے اخکارہ دلیل۔
(ہیئے ما توس کو) اَیا اللہ سی کأ سیرأن تھی، آں تُھن کأ جدگ تھی؟
اَیا تو سوال کودو ہیئے ما کآں اَجر سی، دَ ہے تاوان سی وجہ دے ایگی ہوئیدی؟
اَیا ہأ کیش غیب سی علم تُھو دَ ہے تیس لیگدی؟
اَیا ہے چھل سوادی (چھی کأ)؟ دَ کأفر خلک تُنو چھل می گیر ہوؤ والا تھی۔
اَیا ہین یام معبود تُھو اللہ ما علاوہ؟ پاک تُھو اللہ ہین سَویل شریگے ما
آں کو ہیئے آسمان ما لار بَیوُ والا اے ٹوٹا ڈیڈو (تھلا ہُم) ہیئے بننین اُگو ہاگا تُھو
دَ (اے پیغمبرؐ!) چھو ہأ (ہین حال زیت) ہے میلاؤ ہوئن تُنو تے دی سیت کامیک می یأ ہیئے بےہوش کوا بژنین
تے دی ہین چھل ولے ہین کی فائدہ می نہ ینین، آں نأ ہین کی مدد کوا بژنین۔
آں بےشکہ ظألما سی کأ عذاب مے (دونیئی سی) عذاب ما علاوہ تُھو، اَسے ہیئے ما چیر خلک نہ جنَدی۔
آں (اے نبیؐ) تو تُنو پروردگار سی حکم کُوٹھا، دَ بیشکہ تو مُھن أݜی آ سی ٹین تُھو، آں تو تُنو رب سی تسبیح آں پاکی بیان کو، کا سادا تو اِشیدو (مجلس ما یا نین ما)
آں ڙأت سی ہُم دھأک حصہ می تسبیح بیان کو (اللہ سی)، آں تاء سی غیب ہوؤ ما بعد ہُم (تسبیح بیان کو)۔
قسم تُھو تاء سی کے یأ سے لار بژدُو،
(اے مکہ سی باشندہ ہانا!) تُھن سأت (پیغمبرؐ) نأ دا پان ہڙئیل تُھو، آں نأئی کیل پَندے روان تُھو۔
آں ہے تنُو خواہشیدے کی بات نہ کودُو۔
ہے دا صرف وحی چھی، سے اِسی دِشکے کوا بژژی،
ایسکے اے پوخ طاقت والا (مُلیکا) ڇھیڙأدچی،
(سے جبرائیلؑ) چیر زوروڑ تُھو؛ دَ بھی سے مُوشکے اِڑی ہُو،
آں سے اُوچات آسمان سی جی زید اَشُو،
بھی سے نھیئی ہُو، دَ وا ہُو،
مھیدیگا پورے یرأ دُو باردَن آ سی، یا تیما ہُم نھیو (اَپ)
مھامُوڑ (اللہ) تنُو بَن زید کامے وحی نازل کودُوو تیس نازل کی۔
کا یأ تی ڈیڈ تا حی تیس می کی غلطی نی کی؛
کئی، بھی ہُم تھو تیسیت تے شیئی سی بارہ می مارَزا کودی کا یأ تی ڈیڈتُو؟
آں حقیقت أ چھی کہ تی (تے مُلیکا) اے پیرا دُوئی ہُم ڈیڈتُو
(تے بیرے سی تھام سی) کأشکے تِسی نام سدرۃ المنتہٰی تُھو
تِسی کأشکے جنت الماوٰی چھی،
کامے وَخ می یأ بُورادُوشو بیرے سی تھام، تھیئے شیئیے کی یأ بُرادُوشو؛
(پیغمبرؐ سی) نظر نأ کیلی ہُو؛ آں نأئی حد ما نِیگھاد۔
یقیناً اِی تنُو پروردگار سی گھن نخا می چیر کآں ڈیڈ۔
کئی تھوئے لات آں عزات (سی حقیقت) زید ہُم غور کیدُو
آں تے اے ڇُوئی زید، کہ تِسی نام منات تُھو؟
کئی تُھن کأ دا جدک ہون، آں اللہ سی کأ سیرأن ہون؟
بھی دا أ چیر اوشو تقسیم تُھو!
ہین حقیقت مِسما سیوا کی ہُم نی چھی کہ ہے دھأک نام تھی، تھأ تھوئے آں تُھن بوب دادے تھوئیدی، اللہ ہین حق می کی ثبوت نازل نی کیدُو، حقیقت می أ (کأفر) خلک صرف وہم آں گُمان آں نفسانی خواہشات آ پیش تِیلدی، حالانکہ ہین پروردگار سی دِشا ہأئے ہدایت أپچی۔
کئی انسان گے ہر تے شیئی سی حق آوودُو کِسی یأ ہے آرمان کودُو؟
نأ، کئیکہ آخرت آں دُونیئی دا بُٹ اللہ سی اختیار می تھی۔
آں آسمان آ می کھیدیک مُلیکا تھی، تھین سفارش یِسی ہُم کی کام نہ یے بھائی، البتہ میس ما پأش کام یے بھائی کہ اللہ کِسی کأ نیمادو اجازت دید آں تیزید راضی ہُو۔
کامے خلک یأ آخرت زید ایمان نہ لردی سے مُلیک جوَئی آ سی نام دے یاد کودی۔
حالانکہ ہأئے مے بأت سی پِھٹ ہُم علم نُو تُھو، ہے صرف گُمان پیش روان تھی، آں حقیقت أ چھی کہ گُمان حقیقت سی مقابلہ می بالکل فایدہ نہ دیدوُ۔
دَ (اے پیغمبرؐ!) تُو مُو نرا تیس ما کی یأ مُھن یاد ما مُو نرادتُو، آں دُونیئی سی جیدون ما علاوہ سے دُوئی کی نی نیمادُو.
مھال خلگا سی علم گے پیلُو صرف مھیدیگا پورے تُھو، چھی پروردگار غورہ جنیل تُھو کہ کآم تِسی پَن ما گئیدُو، آں سے غورہ جنیل تُھو کہ کآم ہدایت پادُو۔
آں اللہ سی تُھو کا یأ آسمانا می تُھو آں کا یأ دھیرینے تُھو، نتیجہ أ چھی کہ کی یأ لاݜ کم کیدی تی تھأئے تھین بدل دینین، آں کی یأ غورہ کم کیدی تھأئے غورہ بدل دینین۔
کآم یأ گھن گناہ آں بے حیائی ما بچ ہودی سیوائے لؤ گناہے ما۔ یقین کو چھی پروردگار چیر کولاؤ بگوشُو والا تُھو، سے تھو غورہ پأندُو کے یأ تی تھو دھیرین ما پیدا کی، آں کے یأ تھو تنُو یئی آ سی ڈم آ می لوڑ اَشیئی۔ دَ تھو تنُو اَمن پاک نہ گھنا۔ سے غورا پأندُو یرأ پرہیزگار کآم تُھو۔
(اے پیغمبرؐ!) کئی تأ تے ماݜ ڈیڈ کی یأ (حق ما) مُو نراد؟
آں تی دھأک شانہ دید ( مال حق سی کأ) آں بھی (ہات) کھمُو؟
کئی ایسیت غیب سی علم تُھو کہ ہے پشَدُو؟
کئی ایسکے تھأ بأدا سی خبر دیا نہ گیژی کامیک یأ موسیٰ سی صحیفہ آ می لیگیل اَشئ؟
آں ابراہیمؑ سی )صحیفہ آ می ہُم( سے وفادار اَشُو؟
أ یرأ، اے پیٹہ بھا کوؤ والا دُوئی سی (گناہ آ سی) پیٹہ بھا نہ کونین؟
آں أ یرأ، نو تُھو انسان کأ اَسے سے کا یأ ای کوشش کیژی۔
آں أ یرأ، اِسی کوشش چیر جلد بوا بژنین،
بھی اِسی بدل ایسکے پورا پورا دیا بژنین،
آں أ یرأ، (آخرکار ٹولائے) چھی پروردگار سی کأشکے اَوؤ تُھو،
آں أ یرأ، سے تُھو ہزادُو آں ڙینگادُو،
آں أ یرأ، سے مئیک ہُم دیدُو آں جیدُون ہُم دیدُو،
آں أ یرأ، تی ڇھی و ماݜ جوڑا پیدا کیدی،
(تیس ہُم صرف) اے نطفہ ما، کے یأ تھلا بژژی (رحم می)،
آں أ یرأ، دھویم جیدُون سی ہُم تی ذمہ گھین چی،
آں أ یرأ، سے مالدا سَوادُو آں خزان دیدُو،
آں أ یرأ، سے شعرای (تا) سی پروردگار تُھو،
آں أ یرأ، تی موشیم (قوم) عاد ہلاک کیشُو،
آں ثمود ہُم، ہأمی یس ہُم باقی نہ چھوؤ،
آں اِسما مُوش نوحؑ سی قوم ہُم (ہلاک کی)، بیشک سے بُوڑے ما زیاد ظالم آں سرکش اَشئ
آں (قوم لوطؑ سی) اَونأ کوئیل گام ہُم تی بھا کیدے تھلوشُو
دَ بُوراد تی شیئیے کی یأ بُوراد (یعنی بھی ہأزید باڑا سی ہاگا مُوژا گا)
دَ (اے انسان) تأ تنُو پروردگار سی کامے کامے نعمت آ می شک کونین؟
أ (پیغمبرؑ) ہُم مُوشیم بھیؤ والا آ سی چھلے بھیؤ والا تُھو،
نھیؤ ییٔو والا (قیامت سی ساعت) نھیو آپ تُو،
اللہ ما علاوہ یام نُو تُھو یأ سے تیس دھگو کوے،
دَ کئی تھو مے بأت زید تعجب کودی؟
آں (اِسی پشاڑَ کیدے) ہزدی آں ڙینگدی نأ؟
آں تھو غفلت کوؤ والا تھی،
دَ مھیرے اللہ یے سجدہ کوا آں تِسی بندگی کوا
قیامت نھیئ ہُودو، آں یُن پھیلیژی۔
آں (ہأ خلگا سی حال أ چھی) کو ہے کی نَخ پشدیو مُو نرادی، آں بَندی کہ ہے دا اے جادو تُھو یأ موش ما روان تُھو۔
تھیئے حق لووال گھنو، آں تنو خواہشا پیش نیگھأت، (اَسے) آں ہر کم گے آخر اے انجام گے اَوؤ تُھو۔
آں ہأ خلگائے (موشک قوم آ سی) واقعات آ سی مھیدیک خبر اَوئیدی کہ تھأمی جھان عبرت أشی۔
حی وا وؤ والا حکمت سی بأت اَشیئی، بھی ہُم أ عبرت سی بأت ہأئے کی فائیدا نہ دیدی۔
دَ (اے پیغمبرؑ!) تو ہُم ہین کی پروا نہ کو، کامے دی یأ اے چأڑ کوؤ والا اے ناخوش شیئی سی دِشکے ہاگانین۔
تے دی ہیئے تنو أݜی وا کیدے قورے ما مھاموڑ نُخنین، یأ ہر دِشکے خوروور شلاک۔
دھأںئی دیل روان ہونین تے ہاگوؤ والا سی دِشکے! کأفرے (یأ قیامت سی دی ما منکر اَشیئی) بننین کہ "أ دا چیر سخ دی تُھو"۔
تھیئے ما موش نوحؑ سی قوم ہُم (پیغمبر) لووال گھنو سی طرز اختیار کیشو، تھیئے مُھن بَن لووال گھنو، آں بنو کہ: "ہے لیونئی تھی" آں تھأئے دمکی دیاگئی۔
تھیئے تنو پروردگار گے ہاگاد کہ: "آ بے بس ہودُو، مھیرے تو بدل گھین"۔
دَ مھوئے تیز مُوژو والا اُو دے آسمان سی درواز کولاؤ کی۔
آں دھیرین مھوئے پھألدے اوسو آمی بدل کی، آں مھاموڑ (دُوںئی قِسم آ سی) ٹول اُو تے کم سی کأ میلاؤ ہُو کِسی یأ فیصلہ ہیشی۔
آں نوحؑ مھوئے میخی کویل تختہ آ سی ڙید سور کی۔
سے مُھن نگرانی (أݜی آ سی موش) می ریوان اَشیئی، میلائی تے پیغمبر سی بدل گِھنا بژے، کسی یأ ناقدری کوا گیشی۔
آں حقیقت أ چھی کہ مھوئے تیس (عبرت سی کأ) اے نَخ سواد، تھلا یام تُھو کہ سے نصیحت گھنے؟۔
دَ (مھیرے سوچ کو کہ) مھی عذاب آں بھیؤ سی بأت کھال اَشیئی؟
آں حقیقت أ چھی کہ مھوئے قرآن نصیحت گھنو والا آ سی کأ آسان سوادتُو، مھیرے یام تُھو یأ سے نصحیت گھینے؟
عاد سی قوم ہُم لوو گھنُو سی رویہ اختیار کشو، (بھی بو) کہ مھی عذاب آں مھی بھیؤ والا بأت کھال أشیئی؟
مھوئے اے مُوآ نیستی گن دی می تھأزید تیز طوفانی بیلأئی چھیئی شی۔
سے خلک مھاموڑ بھا کوؤدود یأ سے نأئےما نُخیل خورما آ سی تھام آ سی ٹون اَشیئی۔
دَ (مھیرے سوچ کو کہ) مھی عذاب آں بھیؤ سی بأت کھال اَشیئی؟
آں حقیقت أ چھی کہ مھوئے قرآن نصیحت سی گھینو سی کأ اَسأنی کیدو، دَ یام تُھو کہ سے نصیحت گھینے؟
ثمود سی قوم ہُم (بھیؤ والا) لووال گھنُو۔
دَ تھیئے بنو: "کئی، مھو تُنو آ ما اے ماݜ سی پیأش کے تِلی؟ کو ہاموڑ کیو یقینا مھوئے گھین گمرئی آں لیونتوپ وا بژنین"۔
"کئی مھو بُڑ خلگا می اَںئی ہے اے ماݜ دھروشُو، یأ ایزید نصیحت نازل کوا گأ؟ نأ! بلکہ ہے گھن لووال، اَمن خوشا متکبر تُھو"۔
(مھوئے صالحؑ گے بنو) لولو پتہ گھڑنین کہ کآم گھن لووال اَمن خوشا متکبر اَشو!
مھو تھین کأشکے تھین اَزمیخ سی کأ اُخأن پیدی، اِسی کأ تو تھأئے بُوا یے، آں صوو ما کام گھین۔
آں تھأئے بَن کہ (کوئی سی) اُو تھین مِیئے تقسیم کوا گودو، اُو سی ہر حقدار تنو وأر می یے نِن۔
بھی تھیئے تنو ماݜ کے چاڑ کی، بس تی ہات مُٹھیدی کی آں (اُخأن) مَئی۔
(مھیرے سوچ کو) مھی عذاب آں بھیؤ سی بات کھأل أشی؟
مھوئے تھیزید بس اے چِگا پیئ، تیندے سے مھاموڑ سواگئی یأ کن آ سی چأپی کویل ݜانگ۔
آں حقیقت أ چھی کہ مھوئے قرآن نصیحت گھینو سی کأ آسأنی کیدو، مھیرے یأم تُھو کہ سے نصیحت گھینے؟
لوطؑ سی قوم ہُم بھیؤ والا لووال گھنئی۔
مھوئے تھأزید باڑ آ سی ہاگا مُژاد، سیوائے لوطؑ سی شیر والائے ما، تھأ مھوئے ڙات سی ساعدا بچ کی۔
ہے مُھن ڈھأرا اے نعمت أشی، کآم خلک شکر نیگھالدیو تھأئے مھو اَںئی ہال بدَل دیدی۔
آں تی (لوطؑ) تھأ خلک مُھن گݜو ما بھیأدیشی، اَسے تھیئے بھیؤ سی بُڑ بیأد آ می شک کی۔
آں تھیئے لوطؑ تِسی میلأݜ آ سی بارا می ڇھوؤ سی کوشش کی، تیدے مھوئے تھین أݜی أنڈی کی کہ: "مھی عذاب آں مھی بھیو سی بأدا سی مزا چکھا!"۔
آں ژات سی ساعدا ہأزید مھال عذاب حملہ کی، یأ سے جُخ دھرو۔
کہ: "چکھا مھی عذاب، آں بھیؤ سی مزا"۔
آں حقیقت أ چھی کہ مھوئے قرآن نصیحت سی گھینو سی کأ أسأنی کیدو، مھیرے یام تُھو یأ سے نصیحت گھینے؟
آں فرعون سی خاندان سی کأشکے ہُم خبردأری سی بأت اَئی۔
تھیئے مُھن بُڑ نَخ لوو گھنیئشی، تِسی وجہ دے مھوئے تھأ مھال گأدیشی کھأکأ اے زوروڑ گݜو والا سی گݜو ہودُو۔
تُھن أ کأفر تھیئے خلک ما غورا تھی؟ یا چھی کأ (خدئی سی) کتابا می بےگناہی سی خط لگیل تُھو؟
یا سے میس بندی کہ مھو مھال اے ڈلہ چھی یأ تی تنو حفاظت أمیدےکونین؟
(حقیقت تا أ چھی) کہ چیر جلد اے ڈلہ سی لرئ ہونین، آں ہیئے بُڑے پیٹ گئأدے ڈینین۔
(صرف ہے نأ) بلکہ ہین اصل وعدہ سی وَخ تا قیامت تُھو، آں قیأمدے چیر گھین مصیبت، آں چیر ٹٹ ہونین۔
حقیقت أ چھی کہ أ مجرم خلک گھین گمرئی آں بےعقلی میں بژیل تھی۔
تے دی تھأ موتھلأ اَنگا وا ݲھکتے تھلنین، (آں بنا بژنین) چکھا دیزوخ سی نھیو سی مزا!
مھوئے ہر شیئی ناپ تول دے پیدا کیدُو۔
آں مُھن حکم دا بس اے گونشا أݜی سی رَپ سی چھلے (پورا) ہودُو۔
آں تُھن چھلے چیر خلک مھوئے موش غرک کیدی، مھیرے بَن: یام تُھو یأ نصیحت گھینے؟
آں کا کم یأ تھیئے کیدی دا سے بُڑ عمل نامہ آ می لگیل تھی۔
آں ہر گھین آں لیؤ بات لگیل چھی۔
کآم خلگے پرہیزگاری کیژی تھیئے باغ و نہر آ می ہونین۔
اے سأزال عزت والا پوت می! تے بادشاہ سی کأنگے کسی قبضہ می یأ ٹول قدرت چھی۔
سے رحمٰن تُھو،
کی یأ قرآن ڇھڙاد۔
اَںئی تی انسان پیدا کی،
اَںئی تی تیسکے بأت سی واضح کوؤ پشاد۔
سی و یُن اے مقرر کویل حساب تے چلَدی،
جھیل و تھام بُڑ تیسکے سجدہ کودی۔
آں آسمان تی اُچات کیدُو، آں ہُم تی ڇیگے اِڑی کیژی۔
میلائی تھو ناپ تول می ظلم نہ کوا۔
آں انصاف تے صحیح طریقا دے وزن کوا، آں تول می کمی نہ کوا۔
آں دھیرین تی ٹول مخلوقات سی کأ سیوأدچی۔
تِسمی میوا آں خوشا والا خورما آ سی تھام ہُم تھی،
آں بھو والا کُل آں مھاگیل پُوشو ہُم تھی۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تی انسان کوگو شانے ٹنگٹگا کویل (شوگیل) خٹہ ما پیدا کی۔
آں پَیر آنگا سی لام ما پیدا کی۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
دُوںئی مشرقا سی آں دُوںئی مغربا سی پروردگار اَںئی سے تُھو۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تی دو سمندر مھاموڑ تِلات کہ سے ایکدوئی سیت میلاؤ ہودی۔
(بھی ہُم) تھین مِیئے اے پردہ ہودو یأ سے دُوںئیدے تنو حد ما نہ لھنگدی۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھأ دُوںئی سمندرے ما غمئی و مرجان نُوخودی۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
آں تِسی قبضہ می سے جہاز تھی کآم یأ سمندر می کھنا سی شانے اُچات اِڑی کوا گئیدی۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
مے (دھیرین) زید کآم اِی تُھوو فنا ہوؤ والا تُھو۔
آں (صرف) چھی پروردگار سی جلال والا، فضل و کرم والا ذات باقی دھرنین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
آسمانا می آں دھیرین می کآم یأ تُھوو سے (تنو حاجت) اَںئی تیما نیمادو، سے ہر دی کم می تُھو۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
اے دو اِئگی مخلوقا ہانا! مھو چیر جلد تُھن (حساب سی) کأ اوزگا ہوؤ والا تھی۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
اے پَیر و انسان آ سی ٹولگی ہانا! کو تھومی دھیرین و آسمانا سی حدے ما نُخنو سی طاقت چھیو نُخا، تھو اے گھین طاقت ما بغیر نو نُخ بھادی۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھوزید آنگا سی لام و دھیمی پیا بژنین، بھی تھوئے اَمن بچ نہ کو بھانین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
دَ کے یأ آسمان پھلنین، آں لگُھور چم سی شانے لگُھور گلاب سوا بژنین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
بھی تے دیئے نأ کی انسان ما تِسی گناہ آ سی بارا مے توَس کوا بژنین آں نأئی کی پَیر ما۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
گناہگاہ خلگے تھین بودے ما پیانا بژنین، بھی تھأ ݜا سی بال آں کھوئے ما گݜنین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
أ سے دیزوخ چھی کیس یأ أ گناہگاہ خلک لوو گھنودُود۔
ہیئے تِسی آں خوڑوگیل اُو سی مِیئے پشنین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
آں کامے ماݜ (دونیئی می) تنو پروردگار سی موش کے اِڑِی ہوؤ ما بھیودود تا تِسی کأ دو باغ ہونین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
دُوںئی باغ لأرے ما ڈک،
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھأ دو باغا می دو اوسوئے ڈلنین (بژنین)۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھأ دُوںئیا می ہر میوا سی دو دو جوڑا ہونین،
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھیئے (جنتی خلگے) مھال قالین آ زید بالخ تھأدے بھئیل ہونین، کھین أوین ڈھأر أشیم سی ہونین، آں دُوںئی باغا سی میوائے با آ وائے لشیل ہونین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھأ باغا می تھیئے أݜی وا کویل جوئیے ہونین، یأ تھأئے جنتی یے ما موش یی ہُم ہات نھیئی نہ کیدوو، نأ انسان آں نأئی پَیر۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھیئے مھال (شیژے) ہونین یأ یاقوت آں مرجان۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
کئی غوراتوپ سی بدل غوراتوپ ما علاوہ دوئی ہُم کی ہوبھادو؟
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
آں تھأ دو باغے ما (دھأک کم درجہ سی) دو باغ دأل ہونین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
دُوںئے (نیلا سی چیری ہوؤ سی وجہ دے) کݜن ڙانگ اَننین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھأمی دو اوسوئے خوڑوگنین
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھأمی میوا، خورما، آں انار ہونین
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھأمی شیژے خوئی والا شیژے جوئیے ہونین
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
سے حور کآم یأ تمبو (کولاؤ کمرہ) آ می ساتیل ہونین
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھأئے تھیئے (جنتی یے) ما موش نأ یئت کی انسان نھیئی ہونین نأئی کی پَیر
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
تھیئے(جنتی یے) نل گدی و ناشینا قسم سی شیژو قالین آ زید بالخ تھأ دے بھئیل ہونین۔
دَ (اے انسان و پَیر ہانا!) تھوئے تنو پروردگار سی کآم کآم نعمت لوو گھننین؟
چیر برکت والا نام تُھو چھی پروردگار سی، یا گھینیئ والا اِی تُھو، کرم والا ہُم۔
کے یأ پیخ ہیو پیخ ہوؤ والا،
تیسی پیخ ہوؤ می کی لوو نہ تُھو،
تی وا کونین (زنی خلک) اوچات کونین (زنی خلک)،
کے یأ جھڑقا بژنین دھرینے جھڑَقو دے (سخ بھومیلے دے)
آں ریزہ ریزہ کوا بژنین کھنے،
دَ ہونین تھیئے (کھنے) پھیزین سوا بیشتے خوروور،
آں ہونین تھوئے ڇا قسم خلک،
دَ سووَن ہات والا، کا غورہ تھی سوون ہات والا!
آں اَون ہات والا، کا لاݜ تھی اَون ہات والا!
آں موش ہوؤ والا (ایمان سی دشکے دونیئی می)، موش ہوؤ والا،
اَںئی ہے خلک (اللہ ئے) نھیو تھی،
(ہیئے) جنت آ سی نعمدا می ہونین،
اول سی خلگے ما چیرگن،
آں پیشم خلگے ما اَشوڑ دھأک،
لگُھور زر سی بُونیل تخا زید،
ڈو دیدے ایکدیئے مخامخ بھئیل ہونین،
چاپ چاپیرہ ہأزید گئنین جدَگے ہمیشہ زوان،
گلاس آں جگ سمانے، آں خالص شراب سی ڈک جام سمانے،
نأ ہین ݜا می شُل یینین (تے شراب سی وجہ دے)، آں نأئی ہیئے بے ہوش ہونین،
آں ہیئے میوا آ می ہونین، (تے قسم ما) کامیک یأ ہے خوشادی،
آں پݜین آ سی ماس می (تے قسم ما) کامیک یأ ہے نیمادی،
آں (ہین کأ) حورے ہونین، گھین أݜی والا،
بیریت ساتیل غمئی آ سی شانے،
ہے بدل چھی تھأ عملا سی کامیک یأ ہے کؤدُود،
نہ بُھوژنین ہیئے تے جنت می فضول بات، آں نأئی گناہ سی بات،
اَسے آواز ہونین (ہر دیشا) سلام سلام،
آں سووَن ہات والا، کا غورہ تھی سووَن ہات والا،
ہیئے بغیر کنے بیر آ می ہونین،
آں قط قطے کیلا آ می،
آں ݲِک چِیژول می،
آں روان کویل اُو می،
آں چیر میوہ آ می ہونین،
نأ ختم ہونین (تھیئے میوہ) آں نأ شیئے ما منع کوا بژنین،
آں اُوچات درجہ سی بشترہ آ زید،
بےشکہ مھوئے پیدا کی (مھأ حور) خاص اندازہ دے،
پس سوأد مھوئے ہأ زوان سیرأن
مینہ اخکارہ کوؤ والا سیمأڑ،
سووَن ہات والا سی کأ،
چیر ہونین اول سی خلگے ما،
آں چیر ہونین پیشم خلگے ما،
آں آون ہات والا، کا لاݜ تھی آون ہات والا
تأت ہوا می آں خوڑوگیل اُو می ہونین
آں کِݜین دھیمی سی چیژول می ہونین
نأ شیدل ہونین، آں نأ فائدہ مند
یقیناً ہے (خلک مے قیامت) ما موش خوشحال اَشیئ
آں ہے گھن گناہ زید اِڑی ہوئیل اَشیئ
آں ہے بنودود: اَیا مھو مُویو آں مھو سُم آں ہر ہُویو، اَیا مھوئے دووآر اُوشا بژنین؟
اَیا مُھن موشیک بوپ دادے ہُم (دُوآر جینی کوا بژنین؟)
تُو بَن: (اے نبیؐ!) بےشکہ موشیگے ہُم آں پیشمے ہُم
ضرور جمع کوا بژنین، معلوم دی سی مقرر وخ کے
بھی یقیناً تھوئے اے گمراہ لووال گھنو والا ہانا!
خامخا کھانین تھوئے زقوم سی تھام ما
بھی ڈک کونین تیما ڈھے تُنو
بھی پُونین تِسی ڙید خوڑوگیل اُو ما
بھی پُونین تِݜیل اُوخ سی پُو سی چَھلے
می ہین میلأݜتوب ہونین قیامت سی دی
خاص مھوئے تھو پیدا کیدی، دَ تھو کئی نہ منَدی؟
اَیا سوچ کیدُو تھوئے تے ٹیگیل (نطفہ) گے، کامیک یأ تھو تھلَدی؟
اَیا تھو تیما (بنأدم) پیدا کودی، یا مھو پیدا کوؤ والا تھی؟
مھوئے مقرر کیدُو تُھن مِیئے مئیک، آں نی تھی مھو عاجزہ کویل
مے بأت زید یرأ بدل کیئ مھو شکل تُھن، آں پیدا کیئی تھو تھأ شکل آ می تھوئے نہ پأننین
آں یقیناً جنیل تھی تھو موشیک پیدائش ما، تھلا تھو کئی نصیحت قبول نہ کودی؟
اَیا تھوئے سوچ کیدُو تے بیش زید کامیک یأ تھو بودی دا؟
اَیا تھو زرغون کودی تیس (بیج)، کو مھو زرغون کوؤ والا تھی؟
کہ مھوئے نیمادو تیس (گیاء) ریزہ رہزہ کونین آں تھوئے حان ہیدے بژنین
(تھوئے بننین) یقیناً مھو تاوانی ہوئی
بلکہ مھو بدنصیبہ تھی
اَیا تھوئے سوچ کیدُو تے اُو زید کامیک یأ تھو پُودی دا؟
اَیا تھو والَدی (نازل کودی) تیس (او) ہاگا ما یا مھو والو والا تھی؟
کہ مھوئے نیمادو دَ مھوئے تیس ٹیٹ کونین، دَ (بھی ہُم) تھو شکر نہ نیگھالَدی؟
اَیا تھوئے سوچ کیدُو تے آنگا زید کامیک یأ تھو جالَدی دا؟
اَیا تھوئے پیدا کیدُو تھام (آنگا سی کأ) یا مھو پیدا کوؤ والا تھی؟
خاص مھوئے سوادتُو ایس (تھام)، نصیحت (سی کأ) آں مسأفرا سی فائدہ سی کأ،
پس تُو پاکی بیان کو تُنو رب سی نام سی، سے گھن شان والا تُھو۔
دَ آ قسم کھادُو تاء سی ڈوب ہوؤ سی،
آں بےشکہ ہے قسم چیر گھین چھی، کہ تھو جنَدی،
یقیناً أ قرآن عزت مند تُھو،
محفوظ ساتیل کتاب (لوح محفوظ) می تُھو
ہات نہ گھڑادی ایسکے اَسے پاک خلک،
نازل کوا گودُو ٹول جہان آ سی پروردگار سی دِشا،
اَیا مھال بأدا مے تھو سستی کودی؟
آں سوادی تھو تُنو کام یرأ (مے بات) لووال گھنا؟
دَ مھاموڑ کئی نہ ہودُو کے یأ (کسی) ساء مری یے آوَیو،
آں تھو تے وخا څاردی،
آں مھو زیات نھیؤ ہودی ایسکے تھوما، اَسے تھو نہ پَشدی،
دَ کئی کو تھو کمزور نی تھیو،
دَ واپس کئی نہ کودی مے ساء، کو تھو سأزبن تھی؟
دَ کو ہے (مئیک حال سی ماݜ) اَشو چیر نھیو خلگے ما،
دَ (تِسی کأ) راحتہ چھی، آں روزی چھی، آں نعمت سی باغ تُھو،
آں کو اَشو ہے (روح والا) سُووَن ہات والا ما،
(دَ تیسکے بنا بژنین) سلام تُھو تھیزید، تُو سُووَن ہات والا ما تُھو،
آں کو اَشو سے (روح والا) لووال گھنُو والا گمراہا ما،
دَ تِسی کأ میلأݜتوب تُھو خوڑوگیل اُو دے،
آں لھنگُو تُھو دیزوخ کے،
بےشکہ أ بات پورا یقینی چھی،
پس تُو پاکی بیان کو تُنو رب سی، سے گھن شان والا تُھو۔
پاکی بیان کودی کامے (مخلوق) یأ آسمان و دھیرین می تھی، آں سے غالب تُھو حکمت والا،
خاص تِسی بأچیئی چھی آسمان و دھیرین سی، جینی کودو آں میک آندو، آں ہے (اللہ) ہر شیئی زید وَس لردو۔
خاص سے اول تُھو آں آخر تُھو، اخکارہ تُھو و بیرید تُھو، آں ہے (اللہ) ہر شیئی زید پوھہ تُھو جنہ دو۔
اللہ سے ذات تُھو، پیدا کی آسمان و دھیرین ݜو دی آمی، بھی عرش زید (تنو اقتدار) سمبال کی، جندو کائی داخل ہودو دھیرین می، آں کائی نوخودو ایزما، آں کا وائے وودو آسمان ما، آں کائی بھائے اُخودو ایوا، آں سے تھوسید تُھو کھید اِی تھو تھیو، آں اللہ کا تھو کودی تیما جنددو۔
خاص تِسی بأچیئی چھی آسمان و دھیرین سی، آں خاص تِسی دِشکے واپس کوا بژنین ٹول کمے۔
(سے) لھنگادو ڙات دِی می، آں لھنگادو دی ڙأت می، آں سے جندو حی آسی راز ما۔
ایمان اَنا اللہ زید آں تِسی رسول زید، آں خرچہ کوا تھأ شیئیے ما یأ سیوأدتی تھو خلیفہ تیزمی، دَ کی یأ ایمان اَنو تھوئے ما آں خرچ کی، تھین کأ گھن اَجر تُھو۔
آں کژل ہی تھوئے ایمان نہ اَندی اللہ زید، آں میس پیشتے ہُم یرأ رسولؐ دعوت دیدو تھوئے مِسی کأ یأ تھو ایمان اَنا تنو رب زید، آں یقیناً تی (اللہ) گھینتو پوخ لوظ تھوئے ما، کہ تھی تھو ایمان والا؟
(اللہ) سے ذات تُھو، نازل کودو تنو بندہ زید اخکارہ آیات، مِسی کأ کہ نگھلے تھو أنچک ما لوش کے، آں یقیناً اللہ تھوزید چیر مہربان تُھو رحم کوؤ والا۔
آں کژل ہیژی تھوئے تھو خرچہ نہ کودی اللہ سی پَن دے، (حالانکہ) آں خاص اللہ سی میراث چھی آسمان و دھیرین؟ برابر نی تھی تھوئے ما کی یأ خرچہ کی فتح ما موش آں لات کی، ہے خلک چیر زیاد گھن تھی درجہ می تھأ خلگے ما یأ خرچہ کی بعد می آں جہاد کی، آں ہر ایک زید وعدہ چھی اللہ سی غورا، آں اللہ کائی تھو کودی دا خبر تھو تیزما۔
کآم تُھو سے قرض دو اللہ یے اے شیژو قرض، دَ چیری کونین تیس (اللہ) اِسی کأ، آں اِسی کأ چیر گھن اَجر تُھو؟
کامے دی تأ پشنین مومن ماݜ و مومن جوئی، دھأںئی دےنین ہین لوشے ہین موش موش آں ہین سوین ڈھأر کے، (آں تھأئے بنا بژنین) آش زیرے چھی تُھن کأ، تھأ باغ آسی یأ تھین ٹین نھید بژنین، ہمیشہ سی کأ دھرنین تیزمی تھوئے، ہے گھین کامیابی چھی۔
کامے دیے یأ منأفق ماݜ آں منأفق جوئیے، تھأ خلگائے بننین کی یأ ایمان اَنودو: "اِڑی ہوا دا مھو لوش گھینی تُھن لوش ما"، تھأئے بنا بژنین: "پتکے نُڑا، آں تنو لوش دُوئی کیںئد بیرڑا!"، دَ اے ڈاپ اِڑی کوا بژنین تھین مِیئے، اے در ہونین اندر کے تِسمی رحمت ہونین، آں بھار سی دِشکے عذاب ہونین۔
تھیئے ہأئے آواز کونین: "کئی مھو نہ اَشئ تھوسید؟" ہیئے بنین: "کئی نأ، اَسے تھوئے فتنہ می تھلو تنو اَمن، آں موقع کُوٹھاد، آں شک کی تھوئے، آں ڇھوأد تھو لووال اَرمانے، مھیدا پورے یأ آپ تھوئے حکم اللہ سی، آں دوکہ کی تھو اللہ ما دوکہ باز (شیطان)۔
آش مے دیئے نی گھنین تھوئے ما فدیہ، آں نأئی تھأ خلگے ما یأ انکار کیشو (کأفرے)، پوت تُھن آنگا تُھو، اَںئی ہے تُھن مالک تُھو، آں چیر لاݜ تُھو پوت دھرو سی۔
کئی سے وخ لا نہ اَپتو ایماندا آسی کأ یأ کیمیلی ہون ہین حی اللہ سی ذکر تے، آں تیدے کأ یأ نازل ہودو حق ما؟ آں نہ ہون ہے تھأ خلگا سی شانے یأ دیا گادو کتاب موش ایزما، ݲگی ہُو تھأزید مُودہ، (بھی) سخ ہُوئی ہین حی، آں (آش) چیر ہیئے ما بدکار تھی؟
غورہ اَمن جنا، یقیناً اللہ جینی کودو دھیرین پأش اِسی مئیک ما، یقیناً بیان کودی مھو آیات تھوئے مِسی کأ تھو عقل ما کام گھینا۔
یقیناً صدقہ کوؤ والا ماݜ آں صدقہ کوؤ والا جوئی، آں کی یأ قرض دید اللہ یے شیژو قرض، چیری کونین ہأئے (ہین صدقہ)، آں ہین کأ تُھو گھن اَجر۔
کآم خلگے ایمان اَنو اللہ زید آں پیغمبر آزید، اَںئی ہے خلک سأزبن تھی آں شہید تھی تنو رب سی نیز می، ہین کأ اَجر تُھو آں لوش؛ آں کآم خلک یأ کأفر تھی آں لوو گھنیئ مُھن آیات، ہے خلک دیزوخی تھی۔
غورہ اَمن جنا! یقیناً دونیئی سی جیدون (ہأئیمو) نڑو تماشہ آں (ظاہری) شیژوآچا آں ایکدی آمی گھین گھین بأدا سی کوؤ آں مال و اولاد سی چیری ہوؤ (سی بأت کوؤ) تُھو، (اِسی مثال مھامو تُھو) یابنے ہاگا (سی وجہ دے دھیرین سی) فصل پیشتے دیقان خوشال ہوے، بھی سے أمیژدو دا تو پشدو سے چینیئی ہودو، بھی سے خس خس ہودو۔ آں آخرت می سخ عذاب تُھو، آں بوگوشو تُھو اللہ سی دِشا، آں (تِسی) رضا، آں دُونیئی سی جیدون دُوئی کی نأ خو بس اے دوکہ سی سامان تُھو۔
ایکدی ما موٹھیدی ہوا تنو پروردگار ما بخانہ سی دِشکے، آں تِسی تے جنت سی دِشکے یأ بھزیناچا تِسی آسمان و دھیرین سی بھیزیناچا سی شانے تُھو، تیا کوا گیژی تھأ خلگا سی کأ یأ تھیئے ایمان آنودو اللہ زید آں تِسی پیغمبر آزید؛ ہے فضل تُھو اللہ سی یأ کیسکے نیمادوو دیدو، آں اللہ چیر گھن فضل والا تُھو۔
نہ آووئی کی مصیبت دھیرین گے آں نأئی تھو می، اَسے لیگل ہوژی سے کتاب می، موش مُھن تِسی پیدا کوؤ ما، یقیناً ہے آسان تُھو اللہ سی کأ۔
مِسی کأ کہ غمجن نہ ہوا تھو کا یأ تھوما گاو، آں چیر خوشال نہ ہوا کا یأ تھوئے دیاگاو، آں اللہ نہ خوشادو یام مشروٹ آں قتنگار،
(ہے سے خلک تھی) کآم یأ شُمتوب کودی، آں حکم کودی خلگائے شمتوب سی، آں کی یأ مُو نڑادو دَ یقیناً اللہ پرواہ تُھو، أمیدے صفت آسی قابل۔
بےشکہ مھوئے تنو پیغمبر پیئی اخکارہ نخے سمانے، آں مھوئے نازل کی تھأسید کتاب آں ڇیگے مِسی کأ یرأ خلک انصاف زید اِڑی ہوئن، آں چیمو پیؤ، تیمی (لات سی) سخ طاقت چھی، آں فائدہ تُھو خلگا سی کأ، آں مِسی کأ کہ معلوم کوئے اللہ یأ کآم کودو مدد تِسی آں تِسی پیغمبر آسی بے پَشو آ، یقیناً اللہ چیر زیاد طاقت والا زوروڑ تُھو۔
آں یقیناً مھوئے پیؤ نوحؑ آں ابراہیمؑ، آں مھوئے مقرر کی ہأ دُوںئی آسی اولاد می پیغمبری آں کتاب، دَ ہأمی دھأک ہدایت زید تھی، آں چیر ہأمی نافرمان تھی۔
بھی پیئشی مھوئے ہین پیاش تنو دأل پیغمبر، آں مھوئے پیؤ مریمؑ سی پو عیسیٰؑ، آں دید مھوئے ایسکے انجیل، آں تھیئی مھوئے تھأ خلگا سی حی آمی نرمی آں رحمت، کآم یأ اِسی اتباع کوؤدو، آں رہبانیت ہیئے اَمنا ایجاد کی، مھوئے ایس ہأزید فرض نہ کیشی، اَسے ہے اللہ سی رضا بیرڑودود، خو تِسی تھامو لحاظ نی کی کھأکأ یأ تِسی حق اَشو، مھوئے تھأمی تھأ خلگائے تھین اَجر دید کی یأ ایمان آنوشو، آں زیاد ہأمی فاسق تھی۔
اے ایمان والا ہانا! بھیا اللہ ما، آں ایمان آنا تِسی پیغمبرؐ زید، تی (اللہ) دےنین تھوئے دو ڈے تنو رحمت ما، آں مقرر کونین تُھن کأ اے لوش تِلنین تھوئے تیدے، آں بوگوشنین تھو، آں اللہ بوگوشو والا مہربان تُھو؛
مِسی کأ کہ پوھہ ہون اہل کتاب، یرأ ہے وَس نہ لردی کی شیئی زید اللہ سی فضل ما، آں یقیناً فصل اللہ سی ہات می تُھو، سے دیدو کیسکے یأ نیمادوو، آں اللہ گھن فضل والا تُھو۔
اے ایمان والا ہانا! کو تھو مھی پَن دے لات سی کأ آں مھی رضا سی کأ (مکہ ما) نِگھأتیو، دَ تُنو آں مھی دشمن تُنو سأت نہ سوا۔ تھو تھأئے سأتویلی سی دعوت دیدی، آں سے انکأری تھی (دین) حق ما یأ تھوئے آپ تو، سے نِگھالدی رسول ؐ آں تھو ہُم مِسی کأ کہ تھو ایمان آندی اللہ زید یأ سے تُھن رب تُھو دا۔ تھو تھأئے برید برید سأتویلی سی سوالجواب پیدی، آں کا تھو برید کودی آں ڈاگہ کودی دا آ غورہ جنَدو تیس، آں کی ہُم ہاموڑ کی تھوئے ما دَ خامخا سے سیدا پن ما گمراہ ہُو۔
کو تھیئے تھوزید قابو پادو، دَ تھیئے تُھن دشمن ہونین، آں ݲِگی کونین تُھن دِشکے تُنو ہات آں جِیب لاݜ اَوؤ سی کأ، آں سے نیمادی کہ اَرمان تھو کأفر ہوادے۔
یِد ہُم فائدہ نہ دینین تھوئے تُھن رشتہ داری آں نأ تُھن اولاد قیامت سی دیئے، تی (اللہ) تُھن مِیئے فیصلہ کونین، آں اللہ پشَدو تیس یأ تھو کودی دا۔
تُھن کأ غورہ نمونہ ابراہیمؐ آں تِسی سأدا می تُھو، کے یأ تی تُنو قوم گے بنو کہ: بیشکہ مُھن تھوسید، آں اللہ ما علاوہ تھو کسی عبادت کودی تھأسید، کی تعلق نو تُھو، مھو تُھن (عقیدہ آ ما) انکار کودی، آں مُھن آں تُھن مِیئے دشمنی اخکارہ ہی ہمیشہ سی کأ، کھیدیخانہ پورے تھو ایمان نہ آنا اللہ زید یأ سے ایک تُھو، اَسے ابراہیمؑ تُنو بوب کے میس بنو کہ: "مأ چھی کأ معافی نیمانین، آں مھی کی اختیار نو تُھو چھی کأ اللہ ما کی شیئی سی"، (ابراہیمؐ دعا نیماد) "مھی پروردگار! مھوئے تھزید بھروسہ کی، آں چھی دِشکے مھوئے مُو کی، آں چھی دِشکے مھوئے ییؤ تُھو"۔
"اے مُھن پروردگار! مھوئے کأفر آ سی ہادا عذاب نہ دے، مھو معاف کو مُھن خدایا، بیشکہ تو غالب حکمت والا تُھو"۔
(مسلمانا ہانا!) بیشکہ تُھن کأ ایزمی غورہ نمونہ تُھو، تے ماݜ سی کأ کآم یأ اُمید ساتدو اللہ آں آخرت سی دِی زید، آں کامے ماݜ نافرمانی کیو دَ بیشکہ اللہ غنی آں صفت سی قابل تُھو۔
ہوبھادو اللہ تُھن آں تھأ خلگا سی مِیے مینہ پیدا کوے یأ تھأزید تھو دشمنی کودی، آں اللہ قادر تُھو آں اللہ مہربان معاف کوؤ والا تُھو۔
اللہ تھو منع نوکودو تھأ خلگے ما، یأ سے تھوسید نہ پݜَژدی دین سی بارہ می، آں تھیئے تھو تُھن شیرے ما نی نِگھالئیدی، کہ تھو غورہ کوا تھأسید آں انصاف کوا تھأسید، بیشکہ اللہ خوشادو انصاف کوؤ والا۔
بیشکہ اللہ تھو منع کودو تھأ خلگے ما، یأ سے تھوسید دین سی کأ پݜَژدی، آں تھیئے تھو تُھن شیرے ما نِگھالئیدی، آں تھیئے کومک کی تُھن نِگھالو می، کہ تھو دوستی کوا تھأسید، آں کآم یأ دوستی کودو تھأسید، دَ سے خلک ظألم تھی۔
اے ایمان والا ہانا! یئت اَیو تُھن کأشکے مومن جَوئی ہجرت کیدے، دَ تھین امتحان گھینا، اللہ غورہ جَندو تھین ایمان ما، دَ کو تھوئے تھأ معلوم کی کہ مومن تھی، دَ یئت ہُم تھأ کأفرائے واپس نہ کوا، نأ ہے جَوئی ہین کأ جائز تھی، نأ ہے کأفر ہأ جوئی آ سی کأ جائز تھی، آں ہیئے کأفرے کا یأ ہأزید (مہر سی شکل می) خرچہ کیدو تیس تھأئے دا، آں کی گناہ نو تُھو تھوئے کہ تھو ہأ جوئی آسید نکاح کوا یأ تھوئے ہأئے ہین مہر دیدو، آں کأفر جَوئی آسید نکاح نہ کوا، آں نیما کا یأ تھوئے خرچہ کیدو (ہین نم کھمنے ما)، آں پکار تُھو کہ سے خلک (ہُم خرچہ) نیمن کا خرچہ یأ (تنو مسلمان جوئی آ زید) کیدو، اَںئی ہے اللہ سی حکم تُھو، تُھن مِیئے مے فیصلہ کودو، آں اللہ جَنو والا آں حکمت والا تُھو۔
آں کو تُھن جَوئیے ما اے جَوئی گأ کأفر آ سی دِشکے (آں تِسی مہر سی رقم میلاؤ نو ہُوو)، دَ کأفر آ ما غنیمت گھینا، بھی دا تھأ خلگائے یأ تھین جَوئی گئیدی دا، کھیدیک یأ تھیئے خرچہ کیدو دا (تُنو جَوئی آ زید) آں بِھیا تے اللہ ما یأ تیزید تھوئے ایمان اَنودو۔
اے نبیؐ! یِئت اَئیو چھی کأشکے مومن جَوئی، کہ تھزید بیعت کوئن مے بأت زید کہ تھیئے اللہ سید ییس شریک نہ سوانین، آں نأئی چے کونین، آں نأئی زنا کونین، آں نأئی تُنو اولاد مانین، آں نأئی بہتان ݜَژانین، یأ تھیئے سَوادتُو تُنو ہادیدے آں کھوئے دے، آں نأئی کی نیک کم می چھی نافرمانی کونین، دَ بھی بیعت کو تھأسید آں تِھین کأ معافی نیما اللہ ما، بےشکہ اللہ مہربان معاف کوؤ والا تُھو۔
اے ایمان والا ہانا! دوستی نہ کوا تے قوم سید یأ تھأزید اللہ غضب کیژی، بیشکہ سے ناامید ہوئیدی آخرت ما، کھأکأ یأ ناامید ہوئیدی کأفر قوَر والا (سی دووآر اُشو) ما۔
پاکی بیان کودی اللہ سی، کا یأ آسمان آ می تھی آں کا یأ دھیرین می تھی، آں سے غالب حکمت والا تُھو۔
اے ایمان والا ہانا! تھو کئی بندی تھأ بأت، یأ تھأ کودی نأ؟
چیر لأݜ بات چھی اللہ سی نیز می، کہ تھو بنا تیس یأ بھی کوا نأ۔
بیشکہ اللہ خوشادو تھأ خلک، یأ سے اللہ سی پَن می لات کودی، صف آ می ایڑی ہیدے، مھاموڑ یابنے اے سکہ تھلیل دیوال تُھو۔
آں کے یأ موسیٰؑ تُنو قوم گے بنو: "اے مھی قومأ! تھو کئی مھأ تینگی کودی، حالانکہ تھوئے معلوم تھو آ تُھن کأنگے پَیل اللہ سی رسول تُھو؟ بھی کے یأ ہیئے کولاچا اختیار کیدا اللہ (ہُم) تھین حی کیلی کی، آں اللہ فاسق قوم گے ہدایت نہ دیدو۔
آں کے یأ مریمؑ سی پو عیسیؑ بنو: "اے بنی اسرائیل! بےشکہ آ تُھن دِشکے پَیل اللہ سی رسول تُھو، تے تورات سی تصدیق کوؤ والا تُھو یأ مھأما موش نازل ہودو، آں زیرے دیؤ والا تُھو اے پیغمبر سی، تی ینین مھأما بعد، (آں) تِسی نام احمد ہونین، بھی کے یأ سے تھین خوائے اَپ اخکارہ دلیل آ سمانے، دَ تھیئے بنو "أ دا اَخکارا جادو تُھو"۔
آں تے ماݜ ما گھن ظألم کی ہونین یأ سے اللہ زید لوو سی بہتان ݜژادو، آں تیسکے اسلام سی دِشکے دعوت (ہُم) دیا بژژی؟ آں اللہ ظألم قوم گے ہدایت نہ دیدو۔
سے (کأفر) نیمادی یرأ اللہ سی نور تُنو أں (سی پھوک) تے نیشئ، (حال أ چھی) اللہ پورا کیدے چھوؤ والا تُھو تُنو نور، کو چیر ہُم کأفرائے ناخوش تُھوو۔
(اللہ) سے ذات تُھو، تی پیؤ تُنو رسول ہدایت آں حق دین زید، مِسی کأ کہ ایس غالب کوئے ٹول دین آ زید، کو (چیر ہُم) کأفرائے خوش نہ ہوئے۔
اے ایمان والا ہانا! کئی آ تھوئے پشئی (مھال) اے تجارت یرأ سے تھو لھاسے دردناک عذاب ما؟
(میس یرأ) تھو ایمان آنا اللہ زید، آں تِسی رسول زید، آں جہاد کوا اللہ سی پَن دے تُنو مالیدے آں تُنو نفس تے، اَںئی ہے تُھن کأ غورہ تُھو کو تھو جَندیو۔
تی (اللہ) تُھن کأ تُھن گناہ معاف کونین، آں تھو لھنگانین مھال باغ آ می، یأ تھین ٹیندے یَب روان ہونین، آں پاک شیر ہونین مدأمی باغ آ می، اَںئی ہے گھین کامیابی چھی۔
آں دُوئی بات کہ تیس تھو چیر خوشادی (أ چھی کہ)، اللہ سی دِشا مدد آں نھیو بَرئی چھی، آں ایمان والائے زیرے دے۔
اے ایمان والا ہانا! اللہ سی (دین سی) مدد کوؤ والا ہوا، یأ کھأکأ مریمؑ سی پو عیسیٰؑ تُنو سأدائے بنو: "اللہ سی (دین سی) کأ مھی کومک والا کآم تُھو؟"، سأدے بنو: "مھو اللہ سی (دین سی) کومک کوؤ والا تھی"، دَ بنی اسرائیل سی اے ڈلہ ایمان اَنو، آں اے ڈلہ کفر کی، دَ مھوئے ایمان والا آ سی کومک کی، تھین دشمن آ سی مقابلہ می، دَ تھأئے برئی ہی۔
(ٹول شیئی) اللہ سی صفت بیان کودی، کا یأ آسمان آمی تُھو آں کائی دھیرینے تُھو، سے باچا چیر زیاد پاک (تُھو)، زوروڑ حکمت والا تُھو۔
اَںئی سے ذات تُھو، کی یأ أمی خلگے ما اے رسول پیؤ، سے ہأئے تِسی آیات بین دے بُھویادو، آں ہأ پاک کودو، کتاب آں حکمت ڇھیڙادُو، یقیناً میما موش ہے اخکارہ گمراہی می اَشئ۔
آں (مے رسولؐ سی پیؤ) ہأمی دأل خلگا سی کأ ہُم تُھو، کآم یأ ایسید لا مھیرے ٹل نہ ہوئیدی، آں سے (اللہ) زوروڑ حکمت والا تُھو۔
أ اللہ سی فضل تُھو، کیس کے یأ نیمادو دیدو، آں اللہ چیر گھن فضل والا تُھو۔
سے خلک، کیزید یأ تورات (زید عمل سی) بوج تھلا گوشو، بھی تھیئے تیزید عمل نی کی، تھین مثال تے گھودو سی شانے تُھو، یأ تیزید چیرگن کتاب تھلا گئیدی، چیر لاݜ مثال تُھو تھأ خلگا سی کأ یأ اللہ سی آیت لوو گھنئ، اللہ ظألم خلگائے یئت ہُم ہدایت نہ دیدو۔
(اے پیغمبرؐ!) بَن: "اے سے خلک کآم یأ یہودی تھی!، کو تھو میزید غرا تھی کہ ٹول خلک چھیدے تھو مو اللہ سی سأت تھیو، دَ تھو مئک سی اَرمان کوا، کو تھو سأسبن تھیو۔
آں تھیئے یئت ہُم (مئک سی) ارمان نہ کونین، مے وجہ دے یأ ہیئے تنو ہادیدے کامے عمل موش پیئیدی دا، آں اللہ تھأ ظألم خلک غورا پیاندو۔
(اے پیغمبرؐ!) بَن، کامے مئیک ما یأ تھو ڈےدی دا، سے تھوئے اَوؤ والا تُھو، بھی تھوئے تے (اللہ) سی دِشکے واپس کوا بژنین، کآم یأ ٹول بیرید آں اَخکارہ بأدے ما شید تُھو، بھی تی تھوئے بننین کا یأ تھو کوؤدود تا۔
اے ایماندا ہانا! کے یأ شوگأر سی دی نیماز سی کأ ہاگا گاو تھو اللہ سی یاد سی دِشکے یا، آں گھینو و بگینو چھوا، أ تُھن کأ غورا تُھو کو تھو جنیئو۔
بھی کے یأ نیماز گوزادو دھیرین زید خور ہوا، آں اللہ سی فضل بیرڑا، آں اللہ چیر چیر یاد کوا، ہوبھادو تھو کامیاب ہوا۔
آں کے یأ دھأک خلگے گھینو بگینو یا کآں نڑو ڈیڈتا تے دِشکے دھأںئی دید، آں تھأ اِیڑی ہویل چھوؤ، بَن: کا یأ اللہ کیش تُھو دا سے نڑو ما آں گھینو بگینو ما چیر غورا تُھو، آں اللہ غورا زرق دیؤ والا تُھو۔
اے نبیؐ! یئت تھو جوئی آئے طلاق دیؤسأدو ہین عدت ما موش موش ہأئے طلاق دا، آں عدت (سی دی) لیکھا، آں اللہ ما بھیا سے تُھن رب تُھو، تھو ہأ جوئی ہین شیرے ما نی نھگالا، آں نأئی سے أمیدے نوخن، ہاں کو تھیئے کی آخکارہ بے شرمی سی کام کیو، آں أ اللہ سی (مقرر کویل) سیم تھی، آں کآم یأ اللہ سی سیمے ما موٹھائے نھگادو د خامخہ تی اَمن سید أمیدے ظلم کی، تو نہ جندو کہ ہوبھادو اللہ ایما بعد (بات سوؤ سی) اے نیم پان نگھلے۔
بھی کے یأ تھیئے (جوئیے) تنو وخ پورا کیو، دَ تھأ غورا طریقہ دے (تنو نکاح می) کھما، یا غورا طریقہ دے جدا کوا، آں تنو آما دو ماݜ انصاف والا گواہ سَوا، آں اللہ سی کأ صحیح صحیح گواہی دا، (خلک ہانا!) أ سے بات چھی یأ تِسی نصیحت کوا بژژی تے ماݜ کے یأ سے اللہ آں آخرت سی دی زید ایمان آندو، آں کآم یأ اللہ ما بھیو اللہ تِسی (بُھکات ما نگھالو سی) کأ کآں پان نگھالنین،
آں تیسکے مھال پوت ما روزی دینین یأ تھیدا تِسی کی گمان ہُم نہ ہونین، آں کآم یأ اللہ زیت بھروسہ کودو دَ سے (اللہ) تِسی کأ پورا تُھو، خامخہ اللہ تنو حکم پورا کوؤ والا تُھو، یقیناً اللہ ہر شیئی سی کأ اے اندازہ مقرر کیژی۔
آں تُھن (چھویل) جوئیے ما سے جوئی یأ سے بیماری ما نااُمیدا ہوئیدی، کو تھوئے (تھین عدت سی بارا می) شک چھیو دَ ہین عدت ڇا ما چھی، آں تھأ جوئی آسی ہُم یأ تھأئے لا بیماری نہ أپچی، آں کامیگا سی یأ ڈھے می لَؤ تُھو، دَ تھین (عدت) سی نیٹا أ تُھو کہ سے لَؤ جیئن، آں کآم یأ اللہ ما بھیدو دَ تِسی کأ تِسی کم می (اللہ) أسأنی پیدا کودو۔
أ تُھو اللہ سی حکم کیز یأ تھوزید نازل کیدو، آں کآم یأ اللہ ما بھیدوو اللہ تِسما تِسی بدی دھوگو کودو، آں چیری کودو تِسی اَجر۔
ہأ جوئی دھرا کھید یأ تھو دھردی، تنو وسہ پورے، آں ہأزید سختہ اَنو سی کأ ہأ تینگی نہ کوا، آں کو تھین ڈھے آ می لؤ تھیو تھو ہأزید خرچہ کوا، مھیدا پورے کہ ہے لؤ جیئن، بھی کو سے تُھن لؤ گے ڇھی پیؤسأدو دَ ہأئے ہین بدلہ دا، آں ایکدوئی سیت طریقہ دے مشورہ کوا، آں کو تُھن ایکدوئی سید طبیعت نے گھیڑیو دَ تیسکے دوئی جَوئی ڇھی پیئے۔
خرچہ کوے وَس والا تنو وسہ پورے، آں کامے ماݜ کے روزی کم دیا گیژیو دَ سے تے مال ما خرچہ کوے کا یأ تیسکے اللہ دیدچیو، اللہ اے ماݜ کے تکلیف نے دیدو خو تِسی مطابق کا یأ تیسکے دیدتو دا، چیر شیرتے اللہ تنگی ما بعد راحتہ اَننین۔
آں کھیدیک گام مھال اَشیئی کہ تھیئے تنو رب سی آں تِسی رسولؐ سی حکم سی نافرمانی کی، دَ مھوئے ہیئے ما سخ حساب گھین، آں چیر لاݜ عذاب مھوئے ہأئے دید۔
بھی تھیئے تنو لاݜ عمل آ سی وبال چکھو، آں ہین کم سی انجام تاوانی اَشو۔
ہین کأ اللہ سخ عذاب تیا کیدو، دَ اے عقل سی کھمن ہانا کی یأ ایمان اَنودو، اللہ ما بھیا، یقیناً اللہ تُھن دِشکے (قرآن سی شکل می) نصیحت پیئژی،
اے رسولؐ یأ سے تلاوت کودو تھوئے اللہ سی آیات واضح طریقہ دے، مِسی کأ کہ سے تھأ خلک یأ تھیئے ایمان اَنودو آں نیک عمل کیدی أنچگے ما لوش سی ڈھأر کے نگھالے، آں کی یأ ایمان اَنو اللہ زید آں نیک عمل کی، دَ لھنگانین تھأ مھال باغ آئے تھین ٹیندے کان بژنین، اِیمی ہیئے مُدام دھرنین، یقیناً اللہ تھأئے غورا روزی دیدو۔
اللہ سے ذات تُھو تی پیدا کی سات آسمان، آں دھیرین ہُم تھیدیک، وودو تِسی حکم ہین میئے کہ تھو جنا، یقیناً اللہ ہر شیئی زید طاقت لردو، آں یقیناً اللہ سی علم ہر شیئی سی چاپیرا تُھو۔
اے نبیؐ! تو کئی حرام کودو تے شیئی یأ حلال کیدو اللہ چھی کأ؟ (کئی مِسی کأ کہ) تو تنو ڇھی آسی رضامندی بیرڑدو؟ آں اللہ بوگوشو والا مہربان تُھو۔
یقیناً مقرر کی اللہ تُھن کأ تُھن قسم آسی پھرؤ (سی طریقہ)، آں اللہ تُھن کم سی سوؤ والا تُھو، آں خاص سے پوھہ تُھو حکمت والا۔
آں (یاد کو) کے یأ نبیؑ تنو بی بی آما ایک کے بیرید اے بات بینی، بھی تی (بی بی) تے بات (مُٹھائے دوئی کیںئس کے) بینی، آں ڈاگہ کی اللہ نبیؑ زید (مے بات)، دَ نبیؐ (تے بی بی یے) دھأک بینی دھأک نہ بینی، بھی کے یأ نبیؑ پشأد تیسکے تے بات، تی بنو: "کی خبر دید تھیئے مے بأت سی؟" نبیؐ بنو: "خبر دید مھیئے پوھہ خبردار ذات"۔
کو تھوئے دُوںئی (بی بی یے) توبہ کی اللہ یے (تُھن کأ غورہ ہونین)، یقیناً تُھن حی کیلی ہوئیدی، آں کو تھوئے ایکدی آسی مدد کی (نبیؐ) سی خلاف، دَ یقیناً اللہ خاص تِسی مدد کوو والا تُھو، آں جبرائیلؑ، آں نیک مومن، آں مُلیک پأش ایزما مدد کوؤ والا تھی۔
نھیو تُھو رب اسی (نبیؐ سی) کہ نبیؐ طلاق دیدو تھوئے، بدلہ می دے نین ڇھی غورہ تھوئے ما، فرمانبردار، یقین کوؤ والا، توبہ کوؤ والا، عبادت کوؤ والا، ڙوز سی تھوؤ والا، ڙین آں اودید۔
اے ایمان والا ہانا! بچ کوا تنو اَمن، آں تنو شیر والا دیزوخ سی آنگا ما، یأ تِسی خشاک خلک آں باڑ تھی، مقرر تھی تیزید مُلیک سخ زوروڑ، نافرمانی نہ کودی اللہ سی کائی حکم دیدو تھأئے، آں تے کام کودی کائی حکم دیا گاو تھأئے۔
(تے دی کأفر آئے بنا بژنین) اے کأفر ہانا! آش تھو کی بھان نہ سَوا، یقیناً بدلہ دیا بژنین تھوئے تِسی کائی تھو کوؤدو تہ۔
اے ایمان والا ہانا! توبہ کوا اللہ یے، سأس سی توبہ، ہو بھادو دھوگو کوئے تُھن رب تھوما تُھن گناہ، آں داخل کوئے تھو مھال جنت آمی، یأ تھین ٹین نھید روان تھی، تے دی اللہ تنو نبیؐ آں تھأ خلک یأ تیسیت ایمان اَنودو نہ شومانین، تھین نور تھیئے ما موش موش آں تھین سُوین ڈھأر کے دھأںئی دین روان ہونین، ہیئے بننین: "اے مُھن پروردگار! پورا کو مُھن کأ مُھن نور، آں مھو بوگوش، یقیناً تو ہر شیئی زید وَس لردو"۔
اے نبیؐ! جہاد کو کأفر آسید، آں منافق آسید، آں سختی کو ہأسید، آں ہین پوت دیزوخ تُھو، آں سے چیر لاݜ پوت تُھو،
اللہ مثال بیان کودو کأفر آئے، نوحؑ سی ڇھی آں لوطؐ سی ڇھی سی، سے دُوںئیدے مُھن دو نیک بن آسی نکاح می اَشئ، اَسے تھیئے تنو کھمن آسید خیانت کی، دَ دُوںئیدے اللہ سی مقابلہ می تھین کی مدد نہ کوبھئی، آں تھأ (جوَئیائے) بنا گا "داخل ہوا تھو آنگا می داخل ہوؤ والا سید"۔
آں بیان کودو اللہ اے مثال تھأ خلگائے کہ سے ایمان والا تھی، فرعون سی ڇھی سی (مثال) کے یأ تی بنو: "اے مھی پروردگار! مھی کأ سَوا تنو کأشکے جنت می اے شیر، آں مھیئے نجات دے فرعون آں تِسی عمل ما، آں مھیئے نجات دے ظألم قوم ما"۔
آں مریمؑ، عمران سی سیرأن (سی مثال)، کی یأ بچ ساتو تنو ناموس، مھوئے پھوک دید تیزمی تنو روح، آں تی تصدیق کی تنو پروردگار سی بأت آسی، آں تِسی کتاب آسی، آں سے أشی فرمان بردار آمی۔
چیر گھن شان تُھو تے ذات سی، کسی ہات می بُڑ بأچیئی چھی، آں سے ہر شیئی زید پورا قادر تُھو۔
کی یأ مئیک آں جیدون پیدا کیدی، میلائی سے تھو آزمے کہ تھو می عمل می کآم غورا تُھو، آں اَںئی سے مکمل اقتدار سی مالک، چیر بھوکوشو والا تُھو۔
کی یأ سات آسمان ایکدوئی سی ڙید (ڙیدکُلأل؟) پیدا کی۔ تأ رحمٰن خدئی سی پیدا کوؤ می کی فرق نہ پانین۔ بھی نظر تھیلدے بُو؛ تھیئے کی ڇگ نظر یےئی؟
بھی بھی نظر تَھل، نتیجہ می ہونین کہ نظر ٹھمیل چھی دِش کے ناکام واپس یے نین۔
آں مھوئے نھیو آسمان جلیل ڈِیئے دے شیژیئی کیدو، آں تھأ شیطانا زید باڑ موژؤ سی زریعا ہُم سَوادتُو، آں تِھین کأ بیلبیلأ کوئین آنگا سی عذاب تیا کیدو۔
آں کامے خلگے تنو پروردگار سیت کفر سی معاملہ کی، تھین کأ دیزوخ سی عذاب تُھو، سے چیر لاݜ پوت تُھو دھرو سی کأ۔
کے یأ تھیئے تیوا تَھلا بژنین دا تھیئے تِسی سخ آواز بُھوشنین، آں تی جوش کونین
مھاموڑ معلوم ہونین یأ تی قار تے پھلنین۔ کئے ہُم تیوا کأفرا سی ڈلہ تھلا بژوسأدو تِسی څوگیدارے تھیئے ما توَس کونین کہ: "کئی تُھن کأنگے یام شیدؤ والا نہ اَبوشو؟"
تھیئے بننین: "کئی نأ! مُھن کأنگے شیدؤ والا اَبوشو، خو مھوئے تیس لووال گھنو، آں مھوئے بنو کہ: اللہ دا کی ہُم نازل نہ کیدو، تھو دا چیر گھین اے گمراہی می بژیل تھی"۔
تھیئے بننین کہ: کو مھوئے بُھویو ما آں عقل ما کام گھینوشوو (آش) دیزوخ والا خلگا می شامل نہ ہونیندے۔
مھاموڑ تھیئے تنو گناہ آ سی أمیدے اقرار کونین، بس لعنت چھی دیزوخی آزید!
(دُوئی دِشکے) کامے خلک تنو پروردگار ما بے پشو آ بھیدی، تھین کأ بیشکہ بگوشو تُھو آں گھن اجر تُھو۔
آں تھو تنو بأت بیریت کوا یا اخکارہ کوا ( بُڑ تِسی علم می تُھو، کئی کہ) سے حی آ سی بأدا سی پورا علم لرو والا تُھو۔
کئی، کی پیدا کیدی دا تیس کے پتہ نہ ہوئے؟ حالانکہ سے چیر باریکی دے ہر شیئی پشو والا، ہر بأت ما شِت تُھو۔
اَںئی سے تُھو کی یأ تُھن کأ دھیرین تابع کی، بس تھو تِسی پَن آ زید تِلا و گئآ، آں تِسی رزق کھا، آں کأنگے دوآر جینی ہیدے بژُو تُھو۔
کئی تھو آسمان والا سی مے بأت ما بےبھیت آ (بے فکر/بے غم) بھژیل تھی، کہ تی تھو دھیرین وا کُمانین، دَ (دھیرینے) ایک دم کمُو آ شروع ہونین؟
یا کئی تھو آسمان والا سی مے بأت ما بے خوف (بچ تھی؟) بھژیل تھی کہ تی تھوزید باڑ آ سی ہاگا مُژانین؟ بھی تھوئے پتہ گھڑنین کہ مھی بھیو کھال اَشو؟ متبادل ترجمہ = یا کئی تھو آسمان والا سی مے بأت ما بے غمہ بھژیل تھی کہ سے تھوزید باڑ آ سی ہاگا مُوژے؟ بھی تھوئے پتہ گھڑنین کہ مھی بَھیؤ کھال اَشو؟
آں تھیئے ما موش کامے خلک اَشیئی دا، تھیئے ہُم (پیغمبر) لووال گھنئیشی، بھی (بونأ) مھی عذاب کھال اَشو؟
آں کئی تھیئے تنو ژید پݜین آئے (نظر بھا کیدے) نو بودو، کہ سے پݜأل خور کویل ہودی، آں سرڑدی ہُم؟ خدئی رحمٰن ما علاوہ تھین گݜو والا یام نو تُھو، یقیناً سے ہر شیئی سی غورا خیال ساتو والا تُھو۔
تَھلا خدئی رحمن ما علاوہ کآم تُھو یأ سے تُھن لخکر سوا بیشتے تُھن مدد کوئے؟ کأفر خلک تہ بیخی دوکا می بژیل تھی۔
کو تی تنو رزق بان کیو، تھلا سے کآم تُھو یأ تھوئے رزق دے بھئے؟ اِسی باوجود ہُم سے سرکشی و بے زأری زید اِڑی ہویل تھی۔
تھلا کامے ماݜ موتھلأ تلدو دا تی پوت کے زیاد اَوؤ والا ہونین یا تی ماݜ کآم یأ اے ݜِݜ پَن دے سیدا سیدا تلدو؟
بن کہ: اَںئی سے (اللہ) تُھو کی یأ تھو پیدا کی، آں تُھن کأ کن و أݜی و حی سوأد (خو) تھو خلک چیر کم شکر نگھالدی۔
بن کہ: (اللہ) اَںئی سے تُھو کی یأ تھو دھیرین می خور کی، آں تِسی ڈھأر کے تھو جمع کیدے نیا بژنین۔
آں (أ خلک) بندی کہ: "کو تھو سأس تھیو بَنادا می وعدہ کے پورا ہونین؟"
بن کہ: اِسی علم دا صرف اللہ کیش تُھو، آں آ دا بس صفا صفا طریقا دے خبردار کوؤ والا تُھو۔
بھی کے یأ تھیئے تے (قیامت سی عذاب) نھیئی ہوؤ آ پشنین دا کأفر آ سی شکلے نشنین، آں بنابژنین کہ: "أ تُھو سے شیئی کامیک یأ تھو نمؤدود!"۔
(اے پیغمبرؐ! ہأئے) بن کہ: تھلا میس بنا دا: کو اللہ مھأو مھی سأت ہلاک کوے یا مھوزید رحم کوئے (دُوںئی صورتا می) کأفر تکلیف دیؤ والا عذاب ما کی بچ کونین؟
بَن کہ: سے رحمٰن تُھو، مھوئے تیزید ایمان اَنودو، آں اَںئی تیزید مھوئے بھروسا کیدو، بس چیر جلد تھوئے پتہ گھڑنین کہ کآم تُھو یأ کولاؤ گمرئی می بژیل تُھو۔
بَن کہ: تھوئے خیال کیدُو، کو ڙات می تُھن اُو (دھیرین می) وائے ویدے غیب ہُوو، سے کآم تُھو یأ تھوئے اوسو ما ڈلین اُو گھیندے اَنے؟
نون، قسم قلم سی، آں کا یأ سے (مُلیک) لیگدی دا۔
تھو نی تھی تنو پروردگار سی فضل دے گاگیر،
آں یقیناً تُھن کأ اَجر تُھو کہ سے لھسو سی نو تُھو۔
آں یقیناً تھو چیر گھن اخلاق والا تھی۔
دَ تھوئے ہُم پَشنین آں تھیئے ہُم پشنین،
کہ تھومی کآم گاگیر تُھو۔
یقیناً تُھن رب غورہ جندو، کآم تِسی پَن ما ہاڙژیل تُھو، آں تھأ خلک ہُم کآم سیدا پَن زیت تھی،
دَ تھو اطاعت نہ کوا لوو والا آ سی،
آں سے نیمادی کہ تھو کیمیلی ہوا، دَ سے ہُم کیمیلی ہون،
آں تھو قسم کھوؤ والا اُپھٹ (ماݜ) سی بات نہ مَنا،
(سے یأ) پیگو دیدو، ایک سی بات دُوئیے آوادو،
نیگی ما منع کودو آں حد ما نُخیل گناہ گا تُھو،
لأݜ خُوئی والا، ایما علاوہ بدذاتا،
کئی کہ سے مال آں جدگ لردو،
آں کے یأ ایسکے مُھن آیات بُھوژا گئیو، ہے بندو: "ہے مُٹھک خلک آ سی قیصہ تھی"۔
چیر جلد مھوئے تِسی خڑتم زید تاک تھانین،
یقیناً مھوئے تھأ (مکہ والا) اَزمیخ می تھلئیدی، کھاموڑ یأ مھوئے باغ والا آ سی آزمیخ کیشی، کے تھیئے قسم کھؤشو کہ مھوئے ڙات سی وخہ میوہ چرڑنین،
آں تھیئے انشاء اللہ نہ بنو۔
دَ بھی تے باغ زید چھی رب سی دِشا آفت لینگدے گأ، مے حال می کہ سے ہُوویل اَشیئی۔
دَ ڙات کے (باغ مھال ہُو) یأ لُونیل پَھیل۔
ڙادا تھیئے ایکدیئے ڇأڑ کی،
"ڙاد ڙادا تنو لھأٹ کے بژا، کو تھو پھیل لُونو نیمادیو!"
بھی سے گئی، ایکدیئے غلے غلے بنین،
"آش تُھن کأنگے یام مِسکین مے باغ کے نہ یو!"
آں بھی ژاد می ڇیگا گئی یرأ (تنو ارادہ زید) طاقت لردی۔
بھی کے یأ تھیئے (تنو باغ کے) بُودا بنو: "یقیناً مھو ما پان ہأڙأدچی!"
"بلکہ نأ، مھو دا لُٹ ہُوئیدی!"
تھأمی ٹولے ما غورہ (ماݜ) بنو: "کئی مأ تھوئے نہ بنوشو تھو (تنو پروردگار سی) بزروگی کئی نہ بندی؟"
بھی بنو: "پاک تُھو مُھن پروردگار ، اَسے مھو ظألم اَشئی"۔
بھی ہأما ہر کآم ایکدُوئیے ملامت کؤسأد۔
بنوسأد: "ہئی افسوس! مھو حد ما نُخیل اَشئی"۔
طم تُھو کہ مُھن رب مھوئے غورہ بدل دو مے باغ ما، یقیناً مھو تنو رب سی دِش کے نُوڑو والا تھی۔
ہاموڑ عذاب ہودو، آں آخرت سی عذاب ایما گھن تُھو، کو ہے ایما جنئ شیو۔
یقیناً پرہیزگار آ سی کأ تھین رب کیش نعمت آ سی باغ تھی۔
دَ کئی مھو بأت بُھوش (خلک) نافرمان آ سی شانے کیئی؟
تھوئے کژل ہیژی؟ تھو کھال فیصلہ کودی؟
کئی تھوکیش کی کتاب تُھو تیمی تھو بندی؟
کہ تھوئے تھید تی میلاؤ ہونین کا یأ تھو خوشادی دا؟
یا تُھن مھوسید کی پوخ لوظ تُھو قیامت سی دی آ پورے، کہ تھوئے اَںئی تی میلاؤ ہونین کا یأ تھوئے مقرر کیو؟
(اے پیغمبرؐ!) توَس کو ہیئے ما، کآم تُھو ہأمی سے مِسی ذمہ واری گھیندو؟
کئی (خُدائی می) تھأسید یام تھین شریک تُھو (ذمہ واری گھینو سی کأ؟)، دَ اَنن تنو تھأ شریک کو سأزبن تھیو۔
کامے دی یأ پردہ اُچات کوا گاو پِن ما (یعنی قیامت سی سخ وخ اَنا گاو)، آں ہے (خلک) سجدہ سی دِشکے نیما گئیو، دَ ہیئے سجدہ نہ کوبھانین۔
تھین أݜی نامیل ہونین، ہیئے سخ شومیل ہونین، آں کے یأ ہأ سجدہ یے نیما بژودود تا ہے روغ اَشئی (اَسے ہیئے دُونیئی می سجدہ نی کی)۔
دَ (اے پیغمبرؐ!) مے کتاب لووال گھنو والا مھیئے چھو، چیر جلد مھرئے ہأ مھاموڑ دما دما سید تباہی سی دِشکے نئینین، کہ ہأئے پتہ ہُم نہ گھڑنین۔
آں آ ہأئے مہلت دیا یدو (نیٹا زید نیٹا دیا یدو)، آں مھی تدبیر چیر سخ تُھو۔
(اے پیغمبرؐ!) کئی تھو ہیئے ما کی سوال کودی کہ ہے تِسی تاوان سی بوج سی ٹین ہودی؟
یا ہأکیش کی غیب (سی علم) تُھو کہ ہے تیس لِگا یدی؟
دَ تھو صوو کوا تنو رب سی حکم سی کأ، آں ماش والا (یونسؑ) سی شانے نہ ہوا، کے یأ تی (تنو رب کے) ہاگاد، آں سے غم ما ڈک اَشو۔
کو تیس سمبال نی کیشوو تِسی رب سی فضل، دَ تیس تَھل نیندے ہاوار میدان می، آں تِسی حالت چیر لأݜ ہونیندے۔
اَسے تِسی پروردگار تیس بزرگ کی، دَ تیس غورہ خلگا می شامل کی۔
آں کأفر خلگے تھأ قابو پَݜلانیندے تنو تیز نظریدے، کا وخ سے ذکر (قرآن) بُھویدی دا بندی: "ہے دا بیشکہ لیونئی تُھو!"۔
حالانکہ أ (قرآن) تمام دُونیئی سی کأ اے نصیحت چھی۔
آفت یقینی ییؤ والا
کھیدیک گھین چھی یقینی ییؤ والا آفت؟
آں کا شیئیئے تھأ جناد کہ کا چھی یقینی ییؤ والا آفت؟
ثمود آں عاد سی قومے اے حی آ سی ٹنگؤ والا حقیقت لوو گھینڈیشی۔
آں کامیک یأ ثمود سی خلک اَشئ، سے اے سخ چیگأ دے ہلاک کوا گئی۔
آں کامیک یأ عاد سی خلک اَشئ، سے اے تیز حد ما گئیو والا بیلیئی دے ہلاک کوا گئی۔
تیس (اللہ) ہأزید سات ڙات آں آٹھ دی پرلہ پسی چالُو کیشی، دَ (کو تُو تھید اَشُوو) تأ پشنیندے کہ سے خلک تھید کجُور آ سی ڈاڈ ٹوبا سی شانے بڙیل اَشِئی۔
کئی مھیرے تُو ہأمی یام دھریل پَشدُو۔
آں فرعون آں تیس ما مُوش خلگے آں (لوطؑ سی) اَونأ بژیل گام والائے ہُم مھامُوڑ گناہ کیشو۔
دَ ہیئے تنُو پروردگار سی پیغمبر سی نافرمانی کیشی، میلا اللہ ہأ سخ گݜو دے گأد۔
کے یأ سیلاب سی اُو حد ما گیوُ، دَ مھوئے تھو کِشتی می سور کی،
تاکہ مھو مے واقعہ تُھن کأ نصیحت سَوئی، آں یاد کوؤ والا کَن ایس (بھیشتے) یاد ساتن،
بھی کے یأ اے پیرا بیشل می پُھوک دیا بژنین،
آں دھیرین آں کھن بھا کوا بیشتے اے دَک تے پِھٹ پِھٹ کوا بژنین،
دَ تے دی تی واقعہ (قیامت) ہونین کامیک یأ ہوؤ والا چھی،
آں آسمان پَھلنین آں تی تے دِیئے بالکل کمزور ہونین،
آں مُلیگے اِسی غاڑے زید ہونین، آں چھی پروردگار سی عرش تے دِیئے آٹھ (مُلیگے) بھا کیدے گھیننین،
تے دِیئے تُھن پیشی مھامُوڑ ہونین کہ تُھن کی بیریت شیئی بیریت نہ دھرنین،
بھی کیس کے یأ اعمال نامہ سُون ہات می دیا گأو دَ تی بننین: خلگا ہانا! یا مھی عمل نامہ پڑاؤ کوا،
آ دا یقین کوؤدُود کہ مھیئے تنُو حساب سیت مخامخ ہوؤ تُھو،
دَ تی خوشحالہ جیدون می ہونین،
اُوچات جنت می
تِسی میوا (بوج سی وجہ دے) نھیو ہونین۔
(تھأئے بنا بژنین کہ) تنُو تھأ عملا سی وجہ دے مزہ دے کھوؤ پُو کوا، کامیک یأ تھوئے بژیل دی آ می کیشی۔
آں کامے ماݜ کے تِسی عمل نامہ اَون ہات می دیا گاو، دَ تی بننین: کاش! مھیئے مھی عمل نامہ دیا نہ گاشُوو۔
آں مھیئے خبر ہُم نہ ہوئیدے کہ مھی حساب کا تُھو،
کاش! مھی مئیک سیت مھی کام تمام ہُوشوو،
مھی مال مھی کی کام نہ أپ،
مھی ٹول اقتدار مھأ ما گھینا گا،
(مھال ماݜ سی بارہ می حکم ہونین) ایس گݜا آں اِسی ماڑ کے طوق تَھلا
بھی ایس دیزوخ کے تھلا
بھی ایس مھال اے زنزیر تے گھنڈا کہ تِسی ݲِگاچا دَش ہات و ڇبیش ہونین
ہے نأ دا گھن اللہ زید ایمان اَنودُود،
آں نأئی غریب زید گیل کھوؤ سی ترغیب دیؤدُود
لہذا آش مھید نأ اِسی یام یار آں نأئی مددگار ہونین
آں نأ ایس کے کھوؤ سی کی شیئیے میلاؤ ہونین، سیوائے زخم آ سی ڙات آں نؤ ما
تیس گناہ گاہے ما علاوہ دُوئی یی نہ کھانین
دَ آ قسم کھادُو تِسی ہُم کامیک یأ تھو پشدی،
آں تِسی ہُم کامیک یأ تھو نہ پشدی،
کہ یقیناً أ (قرآن) اے عزتمند رسولؑ سی آنیل کلام تُھو
آں أ کی شاعر سی کلام نُو تُھو، (اَسے) تھو چیر کم ایمان آندی
آں نأ یام نجومی سی کلام تُھو، (اَسے) تھو چیر کم نصیحت گھیندی
أ کلام تمام جہان آ سی پروردگار سی دِشا نازل ہُودو
آں کو أ پیغمبر (لوو آ سی) بأت سیوأدے مُھن دِشکے منسوب کوئیدے
دَ یقیناً مھوئے اِسی سُون ہات گݜنیندے،
بھی مھوئے اِسی مری سی ڙگ چھیننین دے
بھی تھوئے ما یام نہ ہونیندے سے ایس بچ کوئیدے
آں یقین کوا کہ أ (قرآن) پرہیزگارا سی کأ اے نصیحت چھی
آں مھوئے غورہ معلوم تُھو کہ تھوئے ما زینی خلک ایس لوو گھنڈو والا تھی
آں أ (قرآن) کأفرا سی کأ افسوس سی سبب تُھو
آں أ (قرآن) سے یقینی بات چھی کہ سراسر حق چھی
دَ لہذا تُو پاکی بیان کو تنُو پروردگار سی نام سی کہ گھن شان والا تُھو۔
مھوئے نوحؑ تِسی قوم سی دِشکے پیؤ کہ تُو تنُو قوم بھیا، میما مُوش کہ تھأزیت دردناک عذاب یو۔
تی بنُو: اے مھی قوم، آ تُھن کأ اخکارہ بھیؤ والا تُھو۔
کہ اللہ سی بندگی کوا، اَںئی تیما بھیا آں مھی حکم مَنا۔
تی تُھن گناہ معاف کونین آں اے خاص وخہ پورے مہلت دینین، بے شک اللہ سی وخ اَوؤو بھی تیمی کی ہیساریئی نہ ہوژی، اے کاش کو تھو جَنیئی شیو۔
(بھی نوحؑ) بنُو: اے مھی پروردگار! مأ تنُو قوم گے ڙاسو دی ہاگات،
خو مھی ہاگوؤ سیت سے (دین ما) لائی ڈیؤسأت،
آں کے ہُم مأ تھأئے ہاگات کہ تُو تھین گناہ معاف کو، دَ تھیئے تنُو أنگی تنُو کن آ می دید، آں تنُو ڙیت کوژو تَھلیئی، آں سے (تنُو کفر می) ٹینگ ہوئی، آں تنُو اَمن چیر گھن حساب کی،
بھی مأ تھأئے اُوچات آواز تے ہاگات،
بھی مأ تھأ اخکارہ ہُم جنأت آں بیریت ہُم جنأت،
بھی مأ تھأئے بنُو کہ تنُو پروردگار ما تنُو گناہ آ سی معافی نیما، بیشک سے چیر بوگوشُو والا تُھو۔
تی تھوزید آسمان ما چیرگن آگھا موژانین،
آں مال و اولاد سی شکل می تُھن مدد کونین، آں تُھن کأ باغ سوانین، آں تُھن کأ نھید پیدا کونین،
أ تھوئے کژل ہیژی کہ اللہ سی گھینیئی زید یقین نہ کودی؟
حالانکہ تی تھو مختلف مرحلہ آ زید گئیادے پیدا کی،
اَیا تھو نہ پشدی کہ اللہ کھامو سات آسمان ڙیت ٹین پیدا کیدی؟
آں تھأمی (تُھن کأ) یُون پلگو والا آں سی (اے لوشیل) ڈی سوأد،
آں اللہ تھو دھیرین ما اے خاص انداز تے پیدا کیدی،
بھی اَںئی اِسمی تھو دوبارہ واپس کونین، آں (اَںئی ایما) دوبارہ نگھلنین،
آں اللہ تُھن کأ دھیرین فرش سوأد،
بنے تھو اِسی اَرت پنا می گئیا یا،
نوحؑ بنُو: اے مھی پروردگار! ہیئے مھی بات نی بیت، اں تھأ خلگا سی پَن دے گئی کھین مال و اولاد تھأئے نقصان ما علاوہ کی نی دید،
آں تھیئے گھن گھن مُکر کی،
آں تھیئے (ایکدوئیے) بنُو کہ تنُو معبود یئت ہُم نہ چھوا، آں ودّ، آں سواع، آں نأئی یغوث، آں یعوق آں نسر
آں ہیئے (اَمن سیت) چیرگن گمراہ کیدی، (اے اللہ) تُو ہُم (مھیرے مھال) ظالم آ سی گمراہی لائی چیری کو، (کہ ہے مردا ہوئن)
دَ تنُو گناہ آ سی وجہ دے سے غرک کوا گئی، بھی دیزوخ می داخل کوا گئی، بھی تھیئے (دونیئی و آخرت می) اللہ ما علاوہ ییس ہُم تنُو مددگار نہ پات،
نوحؑ دعا کی: اے مھی پروردگار! (مھیرے) تُو دھیرین سی ڙیت کأفرا سی اے شیر ہُم باقی نہ چھو،
کو تأ ہأ چھوئیو، ہیئے چھی بندہ گمراہ کوا یینین، آں تھین اولادی ہُم نافرمان آں کأفر ہونین،
اے مھی پروردگار! مھأ بوگوش آں مھی ییئی و باپ ہُم بوگوش، آں (تھأ ہُم) کآم یأ مھی شیر کے ایمان سی حالت می داخل ہُوو، آں ٹول مومن ماݜ آں مومن جوئی ہُم بوگوش، آں کأفر آ سی تباہی لا ہُم چیری کو۔
اے کمبل می اَمن بُروؤ والا،
ایڑی ہو ڙأت کے (نماز سی کأ) خو اَشوڑ،
اَر ڙات یا ایما ہُم اَشوڑ،
یا ایما زیاد، آں (نماز می) قرآن غورہ صفا صفا بَن،
یقیناً مھو پیدی تھزید اِئگی بات؛
یقیناً ڙأت سی اُوشو نفس چیر زیات برابر کوؤ والا تُھو، آں بات چیر زیاد سیدا کوؤ والا تُھو،
یقیناً چھی کأ دِیے ہُم چیر کام تُھو۔
ذکر کو تو تُنو پروردگار سی نام سی، آں جدا ہو تِسی دِشکے جدائی دے،
سے پروردگار تُھو مشرق آں مغرب سی، یام ہُم عبادت سی لائق نو تُھو تیما علاوہ، دَ تیس گݜ تُنو کما سی ذمہ وار،
آں صوو کو تھأ بأدا زید کامیک یأ ہے بنَدی، آں چھو ہأ شیژو طریقہ دے،
آں چھو مھأ لووال گھنڈو والائے، مال و دولت والا، آں مہلت دے ہأئے اَشوڑ وخ،
یقیناً مھوکیش زنزیر آں دیزوخ چھی،
آں خوراک مری می ݜژو والا، آں شُل اَوؤ والا عذاب تُھو،
آں کامے دیئے جھڑقنین دھرینے آں کھنے، آں کھنے روان ہونین سیگل سی ڈھیری سی شانے،
یقیناً مھوئے پیؤدو اے پیغمبرؐ تھوئے، سے گواہی دیؤ والا تُھو تھوزیت، کھأکأ مھوئے پیؤشو فرعون سی دِشکے اے پیغمبر،
دَ بات نہ مینی فرعون تے پیغمبر سی، دَ مھوئے تیس سخت گاد،
دَ تھوئے کھأکأ بچ ہونین، کہ تھوئے انکار کِیو تے دی ما، (کامے دِیئے) یأ لَوے ما ڈھگ سوانین؟
(تے دی) آسمان پھلنین، اللہ سی وعدہ پورا ہوؤ والا چھی،
بےشکہ أ (قرآن) نصیحت چھی، پس کآم یأ نیمادوو تُنو رب سی دِشکے پان گݜے،
(اے پیغمبرؐ!) یقیناً چھی رب کے معلوم تُھو، یرأ بے شکہ تو اِڑی ہودو ڙأت سی ڇا آ می دو ڈے سی کأ، آں کلہ اَر ڈے سی کأ، آں کلہ ڇُوئی ڈے سی کأ، آں اے ڈلہ ہم تھأ خلگے ما کامیک یأ تھسیت تھی، آں اللہ کیش حساب تُھو ڙأت سی آں دی سی، معلوم تُھو اللہ یے یرأ یئت مے (حساب سی) کام نو کوبھادی تھو، دَ تی رحم کی تھوزید، دَ تلاوت کوا قرآن ما، کھدیک یأ تھوئے آسان تُھو۔ معلوم تُھو اللہ یے یرأ ہونین یامے تھوئے ما ناژور، آں دأل خلک یأ سفر کونین تھیئے دھرینے، بِرڑنین اللہ سی فضل، آں یامے دأل خلگے تھیئے لات کونین اللہ سی پَن می۔ پس تلاوت کوا تھو قرآن ما، کھدیک یأ تھوئے آسان تُھو، آں نماز گوزا آں ذکوٰۃ ادا کوا، آں قرض دا اللہ یے شیژو قرض، آں کا یأ تھو موٹھائے پیدی تُنو کأ نیگی، تیس تھوئے پانین اللہ کیژا، ہُم تی غورا آں چیر گھن اَجر ہونین، آں معافی نیما اللہ ما، بےشکہ اللہ چیر بوگوشو والا مہربان تُھو۔
اے پیلأل تھلُو والا
اُوش آں (کأفر خلک عذاب ما) بِھیا
آں تُنو رب سی گھینیئی بیان کو
آں تنو کوژو پاک سات
آں ناپاکی ما اَمن دُھو سات
آں مے نیت تے احسان نہ کو کہ بھی بدل می چیر نیما
آں تنو رب سی کأ صوو کو
کے یأ بیشیل می پُھوک دیا گأو
تَھلا تی دیے چیر سخ ہونین
آں کأفر آ زید آسان نہ ہونین
تے ماݜ سی معاملہ مھزیت چھو، کیس یأ مأ پیدا کیدو دا
آں مأ تیسکے چیر گن مال دیدیشی
آں جدک دیدیشی یأ (سے ہر وخ اِسی خوائے) موجود ہوؤدُود
آں مھوئے تِسی کأ ہر قسم سی سامان مہیا کی (متبادل) آں تِسی کأ ہر کام سُگھا کی
بھی ہُم ‌سے طم کودو کہ آ دوئی ہُم ‌چیری کیئی
یئت ہُم (زیاد نے دینین) کئیکہ سے مُھن آیادا سی خلاف تُھو
چیر جلد مھوئے تیس سخ چڑئی وا اُوگھلنین
تی پِھگر کی آں اے بات سَوأد
دَ ہے ما بژے، اِی کھال بات سیوأد
بھی ہے ما بژے اِی کھال بات سیوأد
بھی اِی (خلگا سی دیشکے) څارُو
بھی تی تال می گأن تھلیئ، آں بوت سواد
بھی واپس‌ ہُو، آں امَن گھن گھنُو
بھی تی بنُو کہ أ دا موشِک (زُومان ما) کویل جادو تُھو
بھی (بندو أ دا اللہ سی کلام نو تُھو) آں أ دا بلکہ انسان سی کلام تُھو
مھوئے چیر جلد ایس دیزوخ کے لھنگانین
آں تھوئے کا معلوم دیزوخ کا چھی؟
(دیزوخ مھال آنگا تُھو کہ) نأ دا تی یام دھرانین نأئی یام ‌چھونین
سے انسان سی چام دھژؤ والا تُھو (دیزوخ سی آنگا)
تیزید اَمبیش څوگیدار مقرر تھی
آں مھوئے دیزوخ سی واگدا صرف مُلیک مقرر کیدی، آں ہین (مُلیگا سی) لیک کأفر آ سی کأ صرف اے ازمیخ چھی، مِسی کأ یرأ کتاب سی کھمن ایزید یقین کوئن، آں ایماندا آ سی ایمان زیاد ہوئے، آں ایماندا و کتاب سی کھمن شک نہ کوئن، آں حی سی مریض (منافقین) و کأفر بنن کہ مے مثال ما اللہ سی کا مطلب چھی؟ اَںئی مھاموڑ اللہ گمراہ کودُو سے کآم ہُم نیمادُوو، آں اللہ ہدایت دیدُو یأ کیسکے ہُم نیمؤسأدو، آں رب سی لخکر رب ما علاوہ یام ہم نہ پأندو، (آں مے دیزوخ سی ذکر) صرف انسان سی کأ یادگیرنہ چھی
ہاں یُن سی قسم!
آں ڙأت سی قسم کے یأ سے واپس گأو
آں ڙات سی قسم کے یأ تِسی لوش ہُوو
یقینا (دیزوخ) چیر گھین افت چھی
انسانا سی کأ بھید سی زریعہ چھی
تے انسان (سی کأ) کآم یأ تھومی مُٹھائے یا پأش ہوؤ نیمادُو۔
ہر ماݜ تُنو عمل آ ‌سی بدل ‌می بوتا تھا گودُو
سیوائے سُووَن ہات والائے ما (نیک خلگے ما)
تھیئے جنت می توَس کونین
مجرم خلگے ما
کا شیئیے تھو دیزوخ کے لھنگأت؟
تھیئے جواب دینین: مھو نماز نو گوزؤدُود
آں مھو مِسکین آ ئے گیل ‌نہ ‌دیؤدود
آں مھو اوبھام بأت کوؤ والا سیت اوبھام بأت کوؤدود
آں مھو قیامت سی دی لَوو گھنودُود
مھیدا پورے کے سے یقینی بات (مئیک) مھوئے أپ
(قیامت سی دیے) سفارش کوؤ والا سی سفارش یے ہأئے فائدہ نہ دینین
ہأ خلگائے کا ہُودو یأ نصیحت ما مُو نرادی؟
مھاموڑ یأ ہے زنگلی گھودو تھی
کے یأ سے مینگ ما ڈیدی دا
بلکہ ہأمی بریک میس نیمادُو کہ ہأئے کولاؤ کویل‌ پاݜ (صحیفہ) میلاؤ ہوئے
ہاموڑ یئد ‌ہُم‌ نہ ‌ہوبھادُو، بلکہ ہے آخرت ما نہ بھیدی
یقیناً أ (قرآن) یادگیرنا تُھو
کسی ہُم ‌حی نیمادُوو سے نصیحت گھینے
آں نصیحت ہُم‌ تھلا گھینین کے یأ اللہ نیمادو، اللہ مِسی لائق تُھو کہ تِسما بھیا بژے، آں اللہ بوگوشُو تُھو۔
کئی انسان زید زومان می مھال اے وقت ہم یئت لھنگودو یرأ ہے کی شیئی می حساب نہ اَشو؟
بے شکہ مھوئے انسان (ماݜ و چھی سی) اے گاڑکویل ٹیگیل ما پیدا کیدو، مِسی کأ کہ اِسی اَزمیخ کیئی، دَ (کھأئمو) مھوئے ایس بُھویو والا آں پشو والا سوادتو۔
یقیناً مھوے دا ایسکے سیدا پان پشأدچی، دَ (مھیرے) ای شکر نیگھلنین آں یائی ناشکرہ ہونین۔
بےشکہ مھوئے کأفر آ سی کأ زنزیر، ماڑ سی پڑئی آں پووڑیل آنگا تیا کیدو۔
بےشکہ نیک خلگے مھال جام ایدے شربت پونین تیمی کامفور گاڑ کویل ہونین۔
تی مھال اے اوسو (سی شربت) ہونین تِسی اُو اللہ سی بَنے پونین، آں کھیدیگی تھیئے نیمادو تے (اوسو سی) یَب تھیئے اَمن گے نئی نین۔
سے مھال خلک تھی یرأ سے تُنو منیل خیر پورا کودی، آں سے مھال دی ما بھیدی یرأ تِسی لاݜتوب ہر دِش کے خور کویل تُھو۔
(آں سے خلک) یتیم مسکین آں بندیوان آئے صرف (اللہ سی) مینہ سی وجہ دے گیل کھیادی۔
(آں بندی) مھو صرف اللہ سی رضا سی کأ تھوزید گیل کھیادی، مھو تھوئے ما نأ کی بدل نیمادی آں نأئی کی شکریہ سی الفاظ۔
مھو دا اللہ سی ڈھأرا تے دی ما بھیدی کامے دی یأ بھیت تے مُوا سی ڙانگ بدل ہونین۔
دَ اللہ مھال خلک تے دی سی لاݜ ساعت ما ساتنین، آں تھأئے حی آ سی خوشألی آں مُوا سی تازگی دینین۔
آں تھین صوو سی بدل می (اللہ) تھأئے جنت آں أشیم (سی کوژو) دینین۔
تھیئے اوچات تخ آزید ڈو تھیلدے بَھئیل ہونین، نأ تھأئے شیدل ہونین، نأئی گیرمی۔
تھید سی (تھاما) سی اوݜ تھین ڙید ہونین، آں میوائے نھیو نھیو لھمیل ہونین۔
تِھن مُوشکے اُوژل زر سی بھان آں شیشہ سی کآس/جام (ہادا می) گئأ بژنین
شیشہ ہُم مھال یرأ تی اُوژل زر سی ڙانگا ہونین، ڈک کوؤ والائے تھأ اندازہ دے ڈک کونین۔
آں تھائے مھال جام پیا بژنین یأ تیمی ادرک سی خوند ہونین۔
سے (جنت سی) اے اوسو تُھو تِسی نام سلسبیل تُھو۔
ہین چاپ چاپیرا (خذمت سی کأ) مھال لَؤ جدَگے ہونین، تھین جدک والے مُدام سی کأ ہونین، کے یأ تھأ ڈیڈو تھیئے مھاموڑ معلوم ہونین یأ خور کویل ہیرا۔
آں کے یأ تأ تے پود ڈیڈو، تھیئے نعمت آ سی اے دونیئی آں گھین اے بأچیئ معلوم ہونین۔
تھین (بدن آ سی) ڙیت بخمل آں بار أشیمیل کوژو ہونین، آں تھأئے اُوژل زر سی بنگڑئی لھیا بژنین، آں تھین پروردگار تھأزید پاک شراب پیانین۔
بیشکہ أ تُھن بدل أشی، آں تُھن کڑاؤ سی قدر کوا گیژی۔
(اے پیغمبرؐ!) مھوئے تھزید قرآن دھأک دھأک نازل کیدو۔
دَ تو تُنو پروردگار سی حکم سی کأ صوو کو، آں ہأمی نأ اے نافرمان آں نأئی اے کأفر سی بأت کان تھا۔
آں ڙاد و جھیما تُنو پروردگار سی نام سی ذکر کو۔
آں ڙأت کے ہم تیسکے سجدہ کو، آں ڙأت سی ݲِگ وخ می تِسی تسبیح بیان کو۔
بےشکہ ہے خلک دونیئی خوشادی، آں مُٹھائے اے سخ دی سی دِشکے ہاڈو بودی نأ۔
مھوئے ہأ پیدا کیدی، آں ہین بان مضبوط کیدی، آں کے یأ مھوئے خوشادو ہین پوت ہین شانے دأل خلک پیدا کونین۔
بےشکہ أ قرآن اے یادگیرنہ چھی، دَ مھیرے یأ کآم خوشادوو سے تُنو رب سی ڈھأرکے بَژو والا پان گݜے۔
آں تھو اللہ سی خوشیل ما علاوہ سرہ کی نوخوشا بھادی، بےشکہ اللہ ہرکی جنو والا آں ہرشیئی ما شید تُھو۔
تی کیس خوشادو تُنو رحمت می داخل کودو، آں ظألم خلک آ سی کأ دا چیر لاݜ عذاب تیا کیدو۔
قسم تُھو تھأ (نرم ہوا آ) سی یأ ایک پیش دُوئی پیا بژدی
بھی تیز طوفانی ہوا آسی
بھی قسم تُھو تھأ (ہوا آسی کآم یأ ہاگہ) بھا کیدے دُھو دُھو خور کودی
بھی تھأ (ہوا آسی کآم یأ) پھألدے جدا جدا کودی
بھی تھأ (فرشتہ آ سی) کآم یأ وحی آندی
حُجت پورا کوؤ سی کأ یا بھیؤ سی کأ۔
یقیناً تھوسید کامے وعدہ کوا بژژی دہ سے ہوؤ والا چھی۔
(اِی پورا ہونین) کے یأ تا یے نِشنین،
آں کے یأ آسمان پَھلنین،
آں کے یأ کھنے ہوا می بَھلا بژنین
آں کا وخہ یأ پیغمبرے جمع کوا بژنین۔
کا دی آ پورے أ ٹھیلا گئیدی؟
فئیصلہ سی دی سی کأ
آں تھیئے کا پتہ، کا تُھو فئیصلہ سی دی؟
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ
کئی مھوئے تباہ نی کیدی مُوٹھگ خلک؟
بھی تھین پأشکے پیشِم خلگا سید (ہُم اَںئی ہاموڑ) کونین۔
مھاموڑ کام کودی مھو مجرم خلگا سید۔
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ
کئی مھوئے تھو پیدا نکیدی اے بے کارہ اُو ما؟
بھی مھوئے تیس تھوؤ اے محفوظ پود زید۔
اے خاص نیٹہ آ پورے؟
بھی مھوئے اندازہ کی آں مھو غورہ اندازہ کوؤ والا تھی۔
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ
کئی مھوئے نہ سَوأدچی دھیرین سمَڑو والا،
جَن و مئیل ٹولا سی کأ،
آں مھوئے اِسمی گھن گھن کھن کُومأد، آں تھوئے میٹ اُو پیاد؟
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ
(فئیصلہ سی دی کأفرائے بنا بژنین کہ) بژا تے (عذاب سی) دِشکے کیس یأ تھو لوو گھنودود!
تِلا تے (دھیمی سی) چیژول سی دِشکے کسی یأ ڇا پھانگ تھی،
نأ دا شیدل آں نأئی آنگا ما بچ کوؤ والا،
تی آنگا قلعہ آ سی شانے گھن گھن لام تھلنین،
یابنے اُخ تھی چونو ڙانگ سی،
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ!
أ سے دی تُھو کے یأ تھوئے بات نہ کوبھانین۔
آں نأئی ہأئے اجازت ہونین عذر سی۔
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ!
أ فیصلہ سی دی تُھو، مھوئے تھو آں مُوٹھک خلک جمع کونین۔
دَ تھو کیش کو کی چَھل چھیو تیس مھی خلاف استعمال کوا۔
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ
یقیناً پرپیزگار خلگے اوݜ آ می آں اوسو آ می ہونین
آں مھال میوہ، کائی سے خوشادیو۔
(تھأئے بنا بژنین) کھا آں پوا مزہ دے، تھأ کم آسی بدل می کا یأ تھو کوؤدودتا۔
ہاموڑ مھو بدل دیدی نیگی کوؤ والا آئے۔
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ!
کھا آں فائدہ اُوچات کوا دھأک، یقیناً تھو مجرم تھی۔
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ
آں کے یأ ہأئے بنا بژدو کہ رکوع کوا (اللہ سی مُشکے)، دَ ہے رکوع نہ کودی۔
تباہی چھی تے دی (حق) لووال گھنو والا آ سی کأ!
دَ مھیرے کامے بأت زید ہیئے ایمان آننین می مأ بعد؟
قسم تُھو (تھأ مُلیگ آ سی یأ کأفر آ سی ساء) سختی دے ݲھیگدی،
آں تِھین، کآم یأ (مومن آ سی ساء) أسأنی دے نِیگھلَدی،
آں (ہاوا می) تیز لامو دیؤ والا (سی قسم)،
بھی دھأںئی دیدے مُوش ہوؤ والا (سی قسم)،
بھی انتظام کوؤ والا (سی قسم) ہر کم سی،
کامے دی جھڑقنین جھڑقُو والا (دھیرینے)،
ینین تیس پیش دھوئم ییؤ والا (بُھومیلے)۔
حی یے تے دی (بھیت تے) درَزنین،
تھین أݜی یے نامَیل ہونین۔
ہیئے بننین: "کئی، مھوئے واپس کوا بژنین (تُنو) پُرأن حال گے؟
کئی، کے ہُوئیو مھو (پرأنی ہیدے) ہَر پیݜیل؟"
ہے بَنَدی: "اِی واپسی دا تَھلا ہونین خسارہ والا!"
بھی بےشک تی اے چیگا ہونین،
بھی ناڅاپا ہیئے ہونین اے مئیدان می۔
(اے پیغمبرؐ!) کئی تھیئے موسیٰؑ سی بات اَوئیژی؟
کے یأ تیس کے آواز دید تِسی پروردگار پاک پوت طویٰ می،
"بَش فرعون سی دِشکے؛ بیشک تی نافرمانی کی ژی،
بھی بن تیسکے: "کئی، تو خوشادو یرأ تو پاک ہو؛
آں آ تھیئے پان پَشئی چھی رب سی دِشکے میلائی تُو بھیت کو؟"
دَ تی (موسیٰؑ) پشأد تیسکے گھین معجزہ،
دَ تی لوو گھنُو آں مھی نافرمانی کی۔
بھی پتکے نُڑو کوشش کوین،
بھی تی (تنو کھام) ایپود کی آں ڇاڑ کی،
بھی بنُو "آ تُھن پروردگار تُھو بُوڑے ما گَھن"
بھی گاد تیس اللہ دُونیئی و آخرت سی عذاب می۔
بے شک اے (واقعہ) می عبرت چھی تِسی کأ یأ کآم بھیدُو (اللہ ما)۔
کئی، تُھن پئیدا کوؤ بُوکھو تُھو کو آسمان سی، اللہ تیس سَوادتُو؟
اُچات کی چَت تِسی، بھی برابر کی،
آں أنچگیل کی تِسی ڙات، آں نِیگھالو لوش تِسی دی سی؛
آں دھیرین تیما پأش بیتھیری،
آں نِیگھالو تیس ما تِسی اُو آں تِسی گیا،
آں کھن پوخ (ٹیمدے) اِڑی کی،
(مِسی کأ) تھوئے فائدہ ہوئے آں تُھن څاروئی آ یے۔
بھی کے أبو گھین تباہی،
تے دی یاد کونین انسان کا یأ اِی کوشش کیژی دا،
آں اَخکارہ کوا بژنین دیزوخ ہر پَشُو والا یے،
دَ بھی کی یأ نافرمانی کیژیو،
آں غورہ کیدو (اَمن گے) دُونیئ سی جیدون،
دَ بیشکہ دیزوخ تِسی پوت تُھو۔
دَ بھی کآم یأ بھیودود تُنو رب سی مُوش کے اِڑی ہوؤ ما، آں کھمودود تنو نفس خواہشے ما،
دَ بیشکہ جنت تِسی پوت تُھو۔
ہے توَس کودی تھیکیژا (اے پیغمبرؐ!) قیامت سی بارہ می، "کے ہونین تی؟"
کا کام تُھو چھی تِسی ذکر می؟
چھی پروردگار کیش آخری (علم) تُھو تِسی۔
بیشک تُو بھیؤ والا تُھو کآم یأ بھیدی اِسما۔
تے دی یأ ہیئے ایس پَشنین، مھامُوڑ یأ ہے دھریئی (دُونیئی می) اے نیاشام یا څاخ سی وخ سی برابر۔
تال می گأن تھَلئ آں مُو نَراد
مِسی کأ یأ آپ تہ تِسی کأشکے اے اَن (صحابی)
آں (اے پیغمبرؐ!) تھیئے کا پتہ؟ ہوبھادُو سے پاک ہوئیدے (دین ڇھڙتے)،
یا خونا گِھننین دے، دَ خونا تیسکے فائدہ دینین دے؟
اَسے کی یأ یأ بے پروائی کیدا،
دَ تو تیس پیش پَسی ہودو؛
آں تھیزید کی (پُڑانہ) نہ تُھو کو سے پاک نُو ہُوو،
آں اَسے کآم یأ تھیپیش آپ تہ دھأںئی دیئن،
آں سے بھیدُو (اللہ ما)،
دَ تُو تِس ما بے پروا ہودُو۔
سرہ نأ! بیشکہ ہے (آیات) اے خونا تُھو،
دَ کآم یأ خوشادُوو سے تیس قبول کوے۔
(أ آیات) عزتمند صحیفہ می تھی،
اُچات آں پاکیزہ تھی،
مھال لِگو والا (مُلیگا) سی ہات می تھی،
(سے) شریف (آں) نیک تھی۔
بنیادَم تباہ ہُو، کھیدیک ناشکرہ تُھو!
کھال اے شیئی ما (اللہ) ایس پیدا کیدُو؟
اے ٹیگیل ما پیدا کی ایس، بھی اے حساب تے ایس سَواد؛
بھی پان اسأنی کی ایسکے؛
بھی ایس موؤ دَ قوَر کے ایس اَواد۔
بھی کے یأ (اللہ) خوشادو دُووار ایس جَینی کونین۔
سرہ نأ! اِی لا پورا نی کیدو کا یأ حکم دیدوشُو ایسکے۔
دَ بنیادم تُنو خوراک کے بوئے،
یرأ بیشکہ مھوئے غورا اُو مُژاد،
بھی مھوئے دھیرین ڇیگأدے پھألی (تیغ نیگھالو سی کأ)،
دَ تِسما مھوئے پَھیل (اناج) نیگھألی،
آں داݜ و سبزی (شاشلوک)
آں زیتون و خُرما
آں پِڑ (تھام آ سی) باغ
آں میوہ و گھا
تُھن و تُھن څاروَئی آ سی کأ کم سی شیئی تھی۔
دَ کے یأ أبو کَن بَئے کوؤ والا چِیگا،
تے دی ڈینین (ہر اے) ماݜ تُنو بَھئی ما،
آں تُنو ییئی و تنو بوب ما،
آں تُنو ڇھی و تنو اولاد ما،
تھیئے ما ہر ماݜ کے تے دی مھال اے حال ہونین تی ایس غافل کونین (ڇھی و اولاد ما)۔
یام مُوئے تے دِی بڑقاٹ ہونین،
ہزیل ہونین، (زیرے دے) خوشحال ہونین؛
آں یام مُو آ زید تے دی پِھزین ہونین۔
(غم سی) کِݜنائے تھأ بُورانین۔
اَنئی ہے خَلک تھی کأفر، بدعَملا۔
کے یأ سی (أنچیک می) پَلَڑا بژنین،
آں کے یأ تائے شِیدے خور ہونین،
آں کے یأ کَھنے روان کوا بژنین،
آں کے یأ دَش ما آ سی گھیبن اُخأن (ہأئیمو) چھوا بژنین،
آں کے یأ زنگلی زیناوَر ایپود کوا بژنین،
آں کے یأ دریاب (می آنگا) پووڑا بژنین،
آں کے یأ بوٹی یے (تُنو اَرواحان آ سید) اےپود کوا بژنین،
آں کے یأ جین دَویل سیرأن ما توَس کوا بژنین،
ہے کا گناہ می ما گیشی؟
آں کے یأ عمل نامہ پَدا کوا بژنین،
آں کے یأ آسمان سی چام نِگھلا بژنین،
آں کے یأ دیزوخ (سی آنگا) پووڑا بژنین،
آں کے یأ جنت نھیئی کوا بژنین،
(دَ تھلا) پتہ گھڑنین ہر انسان کے کا یأ تی حاضر کیدو۔
دَ نأ! آ قسم کھادُو پدکیزأ ییؤ والا تاء آ سی،
تِلو والا، پَنا ہوؤ والا تاء آ سی
آں قسم کھادُو ڙأت سی، کے یأ رخصت ہیو،
آں قسم کھادُو ڙات سی، کے یأ تی شِش گھینو،
بے شک أ (قرآن) کلام تُھو عزتمند مُلیکا سی (آنیل)،
طاقت والا، عرش والا سی نیز می گھن مرتبہ والا (تُھو)،
تِسی بات تھید منا بژژی، امانتدار تُھو۔
آں تُھن سأت (محمدؐ) کی لیونئی نہ تُھو؛
آں بیشکہ تی (محمدؐے) تیس (جبریلؑ) آسمان سی اخکارہ جی زید ڈِیڈوشُو؛
آں ہے (پیغامبرؐ) غیب سی (بأت آ سی) پشوؤ می شُم نہ تُھو۔
آں نُو تھُو أ (قرآن) رٹیل شیطان سی کلام۔
دَ تھلا تھو کھأدے روان تھی؟
نہ تُھو أ (قرآن) اَسے خونا ٹول جہان آ سی کأ،
تِسی کأ کآم یأ تھوئے ما سیدا (پَن دے) بَژوُ نیمادُو۔
آں نہ نیما بھادی تھو اَسے کا یأ نیمادو اللہ، یأ پروردگار تُھو ٹول جَہان آ سی۔
کے یأ آسمان پھلُوو
آں کے یأ تا شِدو،
آں کے یأ دریاب خوڑوگا گئیو،
آں کے یأ قوَر وڑا گئیو،
پتہ گھڑنین ہر انسان گے کا (یأ تی) مُٹھائے پیؤدو آں کا پَدئے چھوؤدو۔
اے انسانأ! کا شیئیے دوکا دیدچی تھیئے تُنو سخی پروردگار سی بارہ می،
(سے ذات) کی یأ تھأ پئیدا کی، بھی تھأ شیژو سَواد، بھی تھأ غورا برابر کی،
کامے شکل می تی خوشادتا (اَدُوم سیوأدے) ایپود کی تھأ؟
سرہ نأ! اَسے تھو لوو گھنَدی جزا و سزا،
آں بیشکہ تھوزید ساتو والا (مُلیکا) مقرر تھی،
سے عزت دا لِگُو والا تھی،
شید ہودی سے کا یأ تھو کودی دا۔
بیشکہ نیک خلگے خامخا نعمت آ می ہونین،
آں گناگائے خامخا دیزوخ می ہونین۔
تھیئے لھنگنین ایسکے جزا سی دیئے،
آں نہ ہونین ہیئے اے (پوت) ما غیب،
آں تھیئے کا پتہ چھی کا تُھو بدل سی دی؟
بھی تھیئے کا پتہ چھی کا تُھو بدل سی دی؟
تے دی اختیارمند نہ ہونین اے نفسے دوئی نفس سی کأ کی شیئی سی، آں حُکم تے دی صرف اللہ سی ہونین۔
کے یأ آسمان پَھلُوو
آں تُنو پروردگار (سی حُکم) گے کان تھانین، آں سے مِسی قابل تُھو (یرأ حکم منے)
آں کے دھیرین ݲِھیگا گأو
آں کا یأ تِسی اَندرے تُھوو تیس بھار کے تھیلدے خالی ہونین
آں تُنو پروردگار (سی حُکم) گے کان تھانین، آں سے مِسی قابل تُھو (یرأ حکم منے)
اے انسانأ! بیشکہ تو سخ کڑاؤ دے ہات کُھوئے دیدو تُنو پروردگار سی دِشکے، دَ تأ خامخا تیسد مخامخ ہونین۔
دَ کیسکے یأ تِسی عمل نامہ تِسی سُوَن ہات می دیا گأو،
دَ جلد تیزید حساب ہونین آسان حساب
آں تی تنو شیر والا آ سی دِشکے خوشألی دے واپس ہونین۔
آں کیسکے تِسی عمل نامہ تِسی ڈاگ سی پیأشا دیا گأو،
دَ جلد تی مئیک کے ہاگانین،
آں (دیزوخ سی) پووڑیل آنگائے لھنگنین۔
بےشکہ ہے (دونیئی می) تنو شیر والا آ سید چیر خوشال اَشُو؛
بےشکہ ہے گمان کوؤدود یرأ تی (اللہ یے) سَرہ واپس نہ ہونین۔
کئی نأ! بیشکہ اِسی پروردگار ایس غورا کیدے څارودُود۔
دَ آ قسم کھادو نأشام سی لگُھورا سی،
آں ڙأت سی، آں کا شیئی یأ سے سَرڑژی،
آں یُن سی، کے یأ سے پُورا ہیو،
تھوئے خامخا اے درجہ ما دُوئی درجہ یے اُخنین۔
دَ ہأئے کژَل ہیژی ہے ایمان نہ انَدی؟
آں کے یأ ہأئے قرآن بنا گاو ہے سجدہ نہ کودی؟
اَسے نأ، سے خلک کی یأ کفر کیدو دا سے (حق) لَوو گھنَدی،
آں اللہ یے غورا علم تُھو (تِسی)، کا یأ سے بُرادی دا۔
دَ ہأئے سَخ عذاب سی زیرے دے،
اَسے کی یأ ایمان اَنودو آں نیک عمل کیدی دا، تھأئے نہ لَھسو والا اَجر تُھو۔
قسم تُھو گھن گھن تاء والا آسمان سی!
آں تے دی سی، کِسی یأ وعدہ کوا گیژی دا،
آں پشو والا سی، آں پَشا بژو والا سی،
ما گئی کندہ (کھرݜو) والا،
آنگا (سی خلک) چیر خشاک والا،
کے یأ سے تِسی ز(آنگا سی) ڈھأر کے بَھژیل اَشِئی،
آں کا سے مومن آ سید کوؤدود تہ تیس تُنو أݜی ایدے پَشودود،
آں تھیئے بدل نی گھین ہیئے (مومن آ) ما صرف مے بأت سی یرأ ہیئے اللہ زید ایمان اَنوشو، زوروڑ صفت والا (اللہ) زید،
سے ذات یأ تِسی کأ بأچیئی چھی دھیرین و آسمان آ سی، آں اللہ ہر شیئی پشُو والا تُھو۔
بے شک کآم خلگے مومن ماݜ آں مومن جوَئی آ ئے عذاب دید، بھی توبہ نہ نِیگھألی، دَ تِھین کأ دیزوخ سی عذاب تُھو، آں تھین کأ (آنگا می) جلو والا عذاب تُھو۔
بے شک کی یأ ایمان اَنو آں نیک عمل کی، تھین کأ باغ ہونین، تِھین ٹین دے کآن بَژنین۔ أ گھین کامیابی چھی۔
بے شک چھی پروردگار سی گݜو چیر سَخ تُھو۔
بے شک سے اول پیرا ہُم پیدا کودو، آں دُووار ہُم تی پیدا کونین۔
آں اَںئی سے بوگوشو والا مینہ کوؤ والا تُھو،
عرش سی مالک، گھن شان والا تُھو،
کا مرضی مینی و (اَںئی) تیس کودُو۔
کئی تھیئے لخکر آ سی قصہ اَووئی،
فرعون سی آں قوم ثمود سی (لخکرا سی)؟
اَسے کأفر انکار می (غافل) بَھژیل تھی۔
آں اللہ ہأ ہین ہر دِشا گیر کیدی۔
اصل می أ قرآن گھن شان والا تُھو
لوح محفوظ میں سنبھال تُھو۔
آسمان سی آں ڙأت کے ییؤ والا سی قسم،
آں تھیئے کا پتہ (سے) ڙأت کے ییؤ والا کا تُھو؟
(سے) بڈقاٹ تاء (تُھو)۔
مھال اے بَن نہ تُھو یرأ تیزید (اللہ سی ڈھأرا) څوگیئ دیؤ والا مقرر نہ تُھو۔
دَ پکار تُھو بوے انسان (یرأ) ہے کا شیئی ما پیدا کوا گودُو۔
سے ٹوب دیؤ والا اُو (سی اے ٹِیگیل) ما پیدا کوا گودُو۔
سے چُن ڈاگ و تُل آ سی مئیمو ما نُخودُو۔
بےشک سے (اللہ) اِسی واپس (جیدون گے) اَنو سی پورا وَس لرَدُو۔
کامے دی بُوریل بأدا سی اَزمیخ ہونین،
دَ تِسی (انسان سی) نأ أمینے کی زور ہونین، نأئی یی مدد کوؤ والا ہونین۔
قسم تُھو (ہاگا) واپس کوؤ والا آسمان سی،
آں (بیش نُخو سی وخ می) پَھلو والا دھیرین سی،
بےشکہ أ (قرآن) چِھین اَنو والا بات چھی،
ہے کی گَپ (سی بات) نی چھی۔
سے خلک تُنو چَھل آ می ݜژیل تھی،
آں آ (اللہ ہُم) تدبیر کودُو۔
دَ تُو کأفرائے دھأک دوئی ڈھیل دے، دھأک وخ سی کأ ہأ چھو۔
پاکی بیان کو تُنو ٹولے ما اُچات پروردگار سی نام سی،
کی یأ (ہر شیئی) پیدا کی، بھی برابر کیدے چھوؤ،
آں کی یأ (ہر شیئی گے) خاص انداز دید، بھی پان پشأد،
آں کی یأ نِل گیا نِگھلو،
بھی تیس کِݜین (شُگیل) ڇے سَوأد۔
(اے پیغمبرؐ) مھوئے تھیئے بن نین، بھی تأ نہ اَموݜنین،
اَسے کا یأ اللہ نیمادو؛ بے شکہ تیس کے پتہ چھی ہر اَخکارہ (شیئی آ سی) آں کا یأ بُریل تھی دا۔
آں مھوئے تھیئے آسان (شریعت سی پَن دے تِلو) سُگھا کونین۔
دَ تو خونا کوآ یے، کو خونا فائدہ دیدو؛
شیرتے خونا گھیننین کآم یأ (اللہ ما) بھیدو دا۔
آں ڈےنین تیما چیر بدقسمتا،
کی یأ ٹولے ما گَھن آنگائے لھنگنین،
بھی تے آنگا می نأ تی مونین نأئی جَن دھرنین،
سے (انسان) کامیاب ہُو کی یأ پاکی اختیار کی،
آں تُنو پرورگار سی نام گِھین بھی نماز گُوزاد،
اَسے تھو دُونیئی سی جیدون زیاد خوشادی،
حال أ چھی آخرت چیرے غورا آں چیرے ݲِگ دھرو والا چھی۔
بےشکہ أ بات مُوشِک صحیفہ آ می (ہُم لِگیل) چھی،
ابراہیمؑ آں موسٰیؑ سی صحیفہ آ می۔
تھیئے ہر شیئی بُرؤ والا (قیامت سی دی) سی بات اَوئی؟
چیر مُوئے تے دی ذلیل ہونین،
سَخ کڑیل ٹھمیل ہونین۔
پووڑیل آنگا یے لھنگنین،
ہائے اُو پیا بژنین خُوڑوگیل اوسو ما۔
ہأئے کھوؤ سی کأ کَنیل جھیلے ما علاوہ دوئی کی نہ ہونین۔
نأ دا تی (بدن) بأری کونین نأئی بِݜ لھاس نین۔
چیر مُوئے تے دی تازہ ہونین،
تھیئے تنو (دُونیئی سی) کوشش زید خوشحال ہونین
اُچات باغ می ہونین،
تِسمی تھیئے فضول بأت نہ بھوژنین،
تِسمی روان اوسو ہونین،
تِسمی اُچات اُچات تخے ہونین،
آں مُوشکے جامے تھئیل ہونین،
آں نرم بالخے قطار آ می تھئیل ہونین،
آں قالینے خور کویل ہونین۔
دَ کئی ہے اُوخائے نہ بودی، سے کھأکأ پیدا کوا گئیدی؟
آں آسمان گے (نہ بودی)، سے کھأکأ اُچات کوا گودُو؟
آں کَھن آئے، سے کھأکأ اِڑی کوا گئیدی؟
آں دھیرین گے (نہ بودی) سے کھأکأ خور کوا گیژی؟
دَ تو (ہأ) جَنا، بےشکہ تُو صرف جَنوؤ والا تُھو؛
تُو ہأزید کی څوگیدار مقرر نہ تُھو۔
اَسے یی مُو نُوڑاد آں انکار کیو،
دَ دینین اللہ تیسکے چیر گھن عذاب۔
بےشک مُھن کأشکے ہین ٹول آ سی واپس ییؤ تُھو،
بھی بےشک مھوزید ہین حساب (گھینو) تُھو۔
قسم تُھو ڙات سی،
آں دَش ڙأد آ سی،
آں جوت و طاق سی،
آں ڙأت سی کے یأ سے بَژوُسأدو،
کئی، اِیزمی عقل والا آ سی (یقین سی) کأ اے گھن قسم (کافی نہ) تُھو؟
کئی تأ نی ڈِیڈ، کا حال کی چھی پروردگار قوم عاد سی؟
گھین گھین تُھن والا قوم اِرَم سی،
کھین شانے یأ وطن آ می یام پیدا کوا نہ گئیشی؟
آں قوم ثمود سی، کی یأ وادی می ڇَھئ تھرَݜئی شی؟
آں میخ والا فرعون سی؟
(ہے سے خلک اَشئی) کی یأ وطن آ می نافرمانی کیشی،
دَ چَیر زیاد فساد کی تھید۔
دَ چھی پروردگار تھأزید عذاب سی گروز (کوڑے) مُوژأد۔
بے شک چھی پروردگار بُٹ نظر آ می گھین تی۔
اَسے انسان سی حال أ چھی یرأ، کے یأ تِسی پروردگار تیس آزمادُو، آں تیسکے عزت و نعمت دیدُو، دَ سے بندو "مھی پروردگار مھیئے عزت دید"۔
آں دھوئم دِشکے، کے یأ اللہ ایس آزمادُو، آں اِسی رزق تینگی کودُو، دَ سے بَندُو "مھی پروردگار مھأ ذلیل کی"۔
سرہ نأ! اَسے تھو یتیم آ سی عزت نہ کودی،
آں غریب آ زید گیل کھیؤ سی کأ ایکدی نہ پارادی۔
آں میراث سی مال سمیڑ سمیڑ تے کھادی،
آں تھو مال سید چَیر زیاد مینہ کودی۔
سرہ نأ! کے یأ دھیرین کِڈکِڈ تے چُورا کوا بژنین،
آں یینین چھی پروردگار، آں ملیگے صف سوأدے،
آں تے دی دیزوخ آنا بژنین، تے دی انسان گے پوھہ یے نین، خو تے پوھہ سی تیسکے کا فائدہ ہونین؟
تی بَن نین: "ہیئی افسوس! مأ تُنو مے جیدون سی کأ مُوش ما کآں پَیؤشُوو!"۔
دَ تے دی تِسی (اللہ سی) شانے عذاب دیؤ والا یِی نہ ہونین،
آں نأئی تِسی (پوخ) گھنڈو سی شانے یی گھن بھانین۔
(نیک خلک آ ئے بنا بژنین) "اے اطمنان پوؤ والا نفس!
تُو بَش تُنو رب سی دِشکے (مے حال می یرأ) تُو تِیما راضی سے یی تھأ ما راضی،
دَ بَش تُو شامل ہو مھی نیک بندہ آ می،
آں لھنگ تُو مھی جنت کے"۔
آ قسم کھادُو مے (مکّہ سی) خار سی،
آں (حال أ چھی) تُو مے خار می دَھردو؛
آں (قسم کھادُو) بوپ سی آں تِسی اولأدی سی،
یقیناً مھوئے انسان بُکھاچا می پیدا کیدُو،
کئی ہے مے خیال کودُو یرأ ایزید یئد ہُم یِسی وَس نہ پیلنین؟
ہے بندُو: "مأ چَیر مال اَیأدچی"،
کئی ہے مے خیال کودُو ایز یی ہُم نی ڈیڈتُو؟
کئی مھوئے نہ دیدتی ایسکے دُو أݜی،
آں جِیب و دُو دُھوت،
آں (نہ) پشأدتی مھوئے ایسکے دُو پَن؟
دَ سے نہ لھنگ بھوؤ بُوکھو پَن دے،
تھیئے کا پتہ بُکھے پان کا چھی؟
(سے اے) غلام سی اَذاد کوؤ تُھو،
یا گیل سی کھیوؤ تُھو، سخ بِݜ سی دی،
تُنو اے یتیم زید،
یا اے خڑپڑ غریب زید،
بھی سے شامل ہُو تھأ خلگا می کی یأ ایمان اَنو، آں تھیئے ایگدُوئی گے وصیت کی صوو سی، آں وصیت کی رحم سی (کوؤ سی)۔
اَںئی أ خلک تھی سُوین دِش والا۔
آں کآم خلک یأ منکر ہُوئی مُھن آیادے ما، اَںئی ہے خلک تھی أوین دِش والا،
ہأزید ہونین آنگا چاپ چاپیرا۔
قسم تُھو سِی سی آں تِسی لوش سی؛
آں یُن سی، کے یأ سے تِسی پأش پأش نیگھأدو؛
آں دی سی، کے یأ تی (سی) اَخکارہ کیو،
آں ڙأت سی، کے یأ سے تیس بوراژی،
آں آسمان سی، آں تِسی کی (اللہ) یأ ایس سَوادتُو،
آں دھیرین سی، آں تِسی کی یأ تیس خور کیژی،
آں انسان سی، آں تِسی کی یأ ایس برابر سَوادتُو،
بھی تِسی حی وا تھلیئ تِسی بدی و نیگی (سی بأت)؛
کامیاب ہُو سے، کی یأ ایس (نفس) پاک کی،
آں ناکامہ ہُو سے، کی یأ تیس (گناہ آ می) ڈوباد،
(قوم) ثمود تُنو نافرمانی سی وجہ دے (صالحؑ) لوال گھنُو،
کے یأ اِشید ہأ ٹولے ما بدبخت،
دَ اللہ سی رسول (صالحؑ) تھأئے بنو: "(خبردار!) اللہ سی اُخأن (آں تِسی) اُو پُو سی خیال کوا!"۔
اَسے تھیئے پیغمبر (صالحؑ) لووال گھنُو آں اُخأن مَئی۔ دَ تھین پروردگار تھین گناہ آ سی وجہ سے تھأزید گھین تباہی أنی، آں ٹول ہاوار کیدے چھوئی۔
آں اللہ یے تھین لاݜ انجام سی کی بھید نی چھی۔
قسم تُھو ڙأت سی، کے یأ سے خور ہیو،
آں دی سی، کے یأ تی لوش کیو،
آں تے ذات سی، کی یأ میش و جوَئی پیدا کیدیو،
یقیناً تُھن کوشش زأن زأنی تھی۔
بات أ چھی یرأ کی ہم (اللہ سی نامہ مال) دید آں پرہیزگاری کی
آں سأس مینی بوڑے ما غورا بات،
دَ چیر شیرتے مھوئے تِسی کأ سُگھا کونین سُگھاچا۔
آں کی بُخل کی آں بے پرواہی کی،
آں لوو گھینی غورا بات،
دَ چیر شیرتے مھوئے تِسی کأ سُگھا کونین بُکھاچا۔
آں کی کم نہ یےنین تیسکے تِسی مال، کے یأ سے لار گاو (دیزوخ سی کندہ می)۔
بیشکہ مُھن ذمہ تُھو خامخا پان پشؤ۔
آں بیشکہ مُھن (ہات می) تھی دونیئی و آخرت۔
دَ مأ بھأدتی تھو تے پووڑیل آنگا ما۔
تیسکے نہ لھنگنین اَسے (تی) گھن بدبختہ،
کی یأ لوو گھنُوشُو (حق) آں مُو نرادُوشُو۔
آں شیرتے تیما بچ ساتا بژنین (تی) پرہیزگار ماݜ،
کآم یأ دیدو تُنو مال یرأ سے پاک ہوئے،
آں نہ تُھو ایزید کی مُلازہ یرأ تِسی بدَل دیا بژے،
اَسے سے صرف نیمادو تُنو گھن پروردگار سی رضا؛
آں یقیناً تی چیر جلد راضی ہونین۔
قسم تُھو بھدشکال سی لوش سی،
آں ڙأت سی کے یأ سے خور ہیو،
(اے پیغمبرؐ!) نہ چھؤدُو تھأ چھی پروردگار، آں نأئی تھیکیژا خپا ہُودو۔
آں پیشم (وخ) چھی کأ غورہ تُھو اول ما۔
آں چیر جلد چھی پروردگار تھیئے مھیدیک دینین یرأ تأ خوشحال ہونین۔
کئی تی (اللہ) تھأ نہ پادُوشو اے یتیم، بھی (تھیئے دھرو سی) پوت دِید؟
آں تی تھأ (نہ) پادُوشو ہڙژیل، بھی تھیئے پان پشأد؟
آں تی تھأ (نہ) پادُوشو ضرورت مند، دَ مالدا کی تھأ؟
دَ کآم یأ یتیم تُھو دا تیزید سختی نہ کو۔
آں کآم یأ سوالگر تُھو دا تیس نہ رَٹ۔
آں کامے نعمت چھی پروردگار سی چھی دا تیس بیان کو۔
(اے پیغمبرؐ!) کئی مھوئے تھیئے چھی سینہ کولاؤ نی کی؟
آں مھوئے تھأما چھی تے بَھئی دھوگو کی،
کامیک یأ چھی ڈاگ پَھرادوشُو،
آں مھوئے چھی کأ چھی نام (سی مرتبہ) بھا کی،
دَ یقیناً ہر سختہ سید اسأنی (ہُم) ہوژی۔
یقیناً ہر سختہ سید اسأنی ہوژی۔
دَ کے یأ تُو اوزگا ہُوو تُو (عبادت می) اَمن کڑا،
آں تُنو پروردگار سی دِشکے پِھگر کو۔
قسم تُھو پھأگ سی آں قسم تُھو زیتون (کو) سی،
آں قسم تُھو سینا سی کَھن طور سی،
آں قسم تُھو مے اَمن والا خار (مکہ مکرمہ) سی!
بےشکہ مھوئے انسان چَیر شِیژو شکل می پیدا کیدُو؛
بھی مھو تیس واپس کودی ٹین ما ٹین سی مرتبہ یے،
اَسے سے خلک، کیئے یأ ایمان اَنودو آں نیک عمل کودی، ہین کأ نہ لھسُو والا اَجر تُھو۔
تھلا کا شیئی تھأ تیا کودو چھی لوو گھنو یے بدلہ سی دی سی؟
کئی اللہ گھن باچا نو تُھو بُٹ باچا آ ما ڙید؟
بَن (اے پیغمبرؐ!) تُنو پروردگار سی نام دے، سے (ذات) کی یأ پیدا کی (ہر کی)؛
پیدا کی انسان پینل ڙات ما۔
بَن! آں پروردگار چھی تہ چَیر زیاد سخی تُھو؛
سے (ذات) کی یأ ڇھیڙاد قلمے دے،
ڇِھیڙاد انسان گے کا یأ سے نہ جَنودُود۔
سرہ نأ! یقیناً انسان ناڑامتوب کودُو،
مِسی کأ یرأ ہے گھندو اَمن بے پروا۔
یقیناً چھی پروردگار سی دِشکے نُڑو تُھو۔
کئی ڈیڈ تأ تے (ماݜ) یأ سے کھمدُو،
اے بَن، کے یأ سے نیماز گُوزادو؟
دَ تو بن دا کو سے (نمازگوزا ماݜ) ہدایت زید اَشوو،
یا حُکم کؤدود سے پرہیزگاری سی؟
کئی تأ ڈِیڈ یرأ سے لوو گھنودُود آں مُو نرؤدود؟
کئی تیسکے معلوم نہ تُھو یرأ اللہ بودُو؟
سرہ نأ! کو ہے قلار نہ ہُوو خامخا (تیس) ݲِھگنین تال سی بالے ما گیݜتے،
(سے) تال (کامیک یأ تُھو) لووال، گناہ گاہ۔
مھیرے نیمے ہے تُنو منجلس سی سأت!
مھوئے ہُم نیمانین دیزوخ سی مُلیک۔
سرہ نأ! نہ مَن بات اِسی۔ آں سجدہ کو آں نھیئی ہو (اللہ یے)۔
کأفر، اہل کتاب آں مشرک بُٹ (تُنو باطل دین ما) جُدا ہوؤ والا نہ اَشِئی کھیدیخانہ پورے تھأئے واضح دلیل نہ أپ،
(یعنی) اللہ سی دِشا اے رسول تھأئے پاک صحیفہ بنے،
یرأ تھأمی صحیح دین سی لیک ہون۔
آں اہل کتاب تِس ما بعد تھیئے ما جُدا ہُوئیشی، کھیدیخانہ پورے تھأئے اخکارہ دلیل نہ آبوشو۔
آں ہأئے صرف أ حُکم ہُوشو یرأ اللہ سی عبادت کوا، صرف تِسی دین مَنا، باطل ما حق سی دِشکے مُو گیا، آں نیماز گُوزا آں ذکواۃ دا۔ آں ہُم أ سَم دین چھی۔
بے شک کی انکار کِیدوو، کو سے اہل کتاب تھی یا مشرک تھی، دیزوخ سی آنگا سی اَندرے ہمیشہ ہونین؛ آں ہے ٹولے ما لاݜ خلک تھی۔
بے شک کی ایمان آنودُوو، آں نیک عمل کیو، اَںئی ہے ٹولہ ما غورا خلک تھی۔
تِھین بدل تِھین پروردگار کیش ہمیشہ سی باغ تھی، تھأسی ٹین دے نھید ڈلَدی، تھید (تھیئے) دھرنین ہمیشہ ہمیشہ سی کأ، اللہ تھأ ما راضی ہونین آں تھیئے اللہ ما راضی ہونین، أ مرتبہ تھین کأ تُھو کآم یأ تُنو پروردگار ما بھیدی۔
کے یأ دھیرنے بُھومیلیدے جَھڑقا بژنین،
آں دھیرینے تُنو بوج بھار کے نیگھال نین،
آں انسان بن نین "مے (دھیرین) گے کَژل ہی؟"
تے دی دھیرنے تُنو ٹول حال بن نین،
مِسی کأ یرأ چھی پروردگار سی دِشا حُکم کوئل ہونین۔
تے دی خلگے ڈلہ ڈلہ ئے دے بھار کے نُوخنین یرأ ہین عمل ہأئے پَشا بژے۔
دَ کی ہُم اے زرہ سی برابر نیگی کیژی، اِی تیس پش نین،
آں کی ہُم اے زرہ سی برابر گناہ کیدُو ای تیس پش نین۔
گھین چڑقا!
کا چھی سے گھین چڑقا؟
آں تھیئے کا پتہ کا چھی سے گھین چڑقا؟
کامے دِئے خلگے ہونین خور ور پتھانگ آ سی شانے،
آں کَھنے ہونین ڙانگیل دُھوگیل پوم سی شانے،
دَ کامے ماݜ سی ڇیگے اِئگی ہیو،
تی تُنو خوشیل جَیدُون می ہونین۔
آں کِسی ڇیگے اِپھٹ ہیو،
دَ تِسی دھرو سی پوت اے (ڈیگی) کندا ہونین۔
آں تھیئے کا پتہ سے (ڈیگی) کندا کا شیئی تُھو؟
بیلبیلأ کوؤ والا آنگا تُھو۔
(مال سی) چَیری کوؤ سی سألی تھو غافل کِیدی،
مے حدہ پورے کہ تھوئے قوَر ڈیڈ۔
سرہ نأ! چیر جلد تھوئے پتہ گھڑنین۔
بھی سرہ نأ! تھوئے پتہ گھڑنین۔
اَرمان! کو تُھن (مے بأت سی) معلوم ہوؤ یقین سی درجہ یے اَوؤشُوو،
تھوئے خامخا پشنین دیزوخ۔
بھی تھوئے تیس خامخا یقین سی أݜی ایدے پَشنین۔
بھی تے دی تھوما نعمت آ سی بارا میں توَس ہونین۔
زُمان سی قسم،
بےشکہ انسان خسارہ می تُھو،
علاوہ تھیئے ما کیئے یأ ایمان انُودو آں نیک عمل کی، آں ایکدیئے حق بأت سی خونہ کی، آں ایکدیئے صوو سی خونہ کی۔
تباہی چھی ہر پیگو دیؤ والا یے، غیبت کوؤ والا یے،
کی یأ جمع کی مال آں تیس لیکھا ییدُو،
سے مے خیال کودُو یتِسی مال ہمیش ساتنین تیس،
سرہ نأ! تی دا خامخا تَھلا بژنین خَس خَس کوؤ والا پوت کے۔
آں تھیئے کا پتہ کا تُھو سے خَس خَس کوؤ والا پوت؟
(سے) اللہ سی آنگا تُھو پووڑیل،
کامیک یأ اَوونین حی آ ئے،
یقین کو تی (آنگا) تھأزید بان کوا بژنین،
ݲِگ ݲِگ تُھنا می۔
کئی تأ نی ڈِیڈ (اے پیغمبرؐ!) چھی خُدئ ہأتی والا سید کژل کی؟
کئی تی تھین (بُٹ) چال بےکارہ نی کی؟
آں تھأزید دھن دھنے پیݜین پیئی،
کآم یأ تھأزید پژیل سُم سی باٹ موژؤدود،
دَ تھأ مھال کی یأ کھئیل بُھو۔
مِسی کأ یرأ قریش (سی خلک) عادت تھی،
(یعنی) سے ہیمان و بَݜا سی سفر کوؤ سی عادت تھی،
تَھلا تھأئے پکار تُھو سے مے شیر سی مالک سی عبادت کوئن
کی یأ بِݜ می تھأئے کھوؤ گے دید آں بِھیت ما تھأ بچ کی۔
کئی تأ تیس ڈیڈ کآم یأ جزا و سزا نہ مَندُو دا؟
ہے سے (بدبختہ) تُھو کآم یأ شوروٹ سی ٹھیل دیدُو
آں غریب کے گیل دیؤ سی ڇھیڙا نہ دیدُو۔
دَ چَیر تباہی چھی تھأ نیماز گوزا آ سی کأ
کآم یأ تُنو نیماز آ ما بےغمہ تھی
کآم یأ (عبادت می) اَمن پَشؤ کودی
آں (دألائے) معمولی شیئی سی دیؤ ما ہم انکار کودی۔
(اے پیغمبرؐ!) یقین سات مھوئے تھیئے کوثر دید؛
دَ تُو تُنو پروردگار سی (رضا سی) کأ نیماز گُوزا آں قربأنی کو۔
یقین سات چھی دشمن ہُم سے تُھو کسی یأ نأ نُوخیل چھی۔
بَن (اے پیغمبر!ؐ) "اے حق سی انکار کوؤ والا ہانا!
آ عبادت نہ کودو تھأ شیئی آ سی کسی یأ تھو عبادت کودی۔
آں تھو عبادت نہ کودی کسی یأ آ عبادت کودو۔
آں نأئی آ (آئندہ) تھین عبادت کوؤ والا تھو کسی یأ تھو عبادت کودی۔
آں نأئی تھو تِسی عبادت کوؤ والا تھی کسی یأ آ عبادت کودُو۔
تُھن کأ تُھن دین تُھو، آں مھی کأ مھی دین"۔
کے یأ اللہ سی مدد آں بَرئی أبو،
آں تو خلک پَش سے جورما جورمائے اللہ سی دین گے لھنگدی۔
دَ تُو تُنو پروردگار ییدا صفت کیدے، آں تیما معافی نیما؛ بے شک سے چیر بوگوشو والا تُھو۔
ہات پھورَن ابو لہب سی، آں سے أمیدے ہُم برباد ہُو!
تِسی مال آں کا تی گھڑوشُو، سے تِسی کی کم می نہ آپ۔
چیر جلد تی لام آ سی آنگا ئے لھنگنین،
آں تِسی جوئی (ہُم) شَلا گھینیل،
تِسی چونجو می بُھو سی رسی گھنیل۔
بَن: "اللہ ہر لحاظ تے ایک تُھو"،
اللہ بے نیازہ تُھو (بُٹ تِسی مُتاز تھی، سے یسکے مُتاز نُو تُھو)
نأ تِسی کی اولاد تُھو، نأئی سے یِسی اولاد تُھو،
آں تِسی جوڑ سی یام ہُم نُو تُھو"۔
تو بَن: "آ ڙات سی مالک سی پناہ نیمادُو
ہر تے شیئی سی شر ما، کامیک تی پیدا کیدُو
آں أنچیگیل ڙأت سی شر ما، کے یأ سے خور ہیو
آں تھأ خلگا سی شر ما، کآم یأ (کوڑے سی) گأنا می پُھوک دیدی
آں حسد کوؤ والا سی شر ما، کے یأ سے حسد کودو"۔
